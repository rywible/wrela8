module field

pub struct Vec2:
    pub x: f32
    pub y: f32

pub struct Vec3:
    pub x: f32
    pub y: f32
    pub z: f32

    pub fn add(read self, right: Vec3) -> Vec3:
        return Vec3(x=self.x + right.x, y=self.y + right.y, z=self.z + right.z)

    pub fn subtract(read self, right: Vec3) -> Vec3:
        return Vec3(x=self.x - right.x, y=self.y - right.y, z=self.z - right.z)

pub struct Vec4:
    pub x: f32
    pub y: f32
    pub z: f32
    pub w: f32

pub struct Rgb:
    pub r: f32
    pub g: f32
    pub b: f32

pub struct Aabb:
    pub min: Vec3
    pub max: Vec3

pub struct Field:
    value: f32

    pub fn union(read self, right: Field) -> Field:
        return union(self, right)

fn abs_scalar(x: f32) -> f32:
    if x < 0.0:
        return -x
    return x

fn min_scalar(a: f32, b: f32) -> f32:
    if a < b:
        return a
    return b

fn max_scalar(a: f32, b: f32) -> f32:
    if a > b:
        return a
    return b

fn clamp_scalar(x: f32, lo: f32, hi: f32) -> f32:
    return min_scalar(max_scalar(x, lo), hi)

pub fn sqrt_scalar(x: f32) -> f32:
    if x <= 0.0:
        return 0.0
    max_finite: f32 = 340282346638528859811704183484516925440.0
    if x > max_finite:
        return x
    guess = x
    if guess < 1.0:
        guess = 1.0
    i: u32 = 0
    # Starting at x (or one for subunit inputs), 128 halvings cover the full
    # finite f32 exponent range before Newton convergence reaches its fixed
    # point. This is intentionally simple source semantics, not a fast kernel.
    @budget(bound=128)
    while i < 128:
        guess = 0.5 * (guess + x / guess)
        i = i + 1
    return guess

pub fn rsqrt_scalar(x: f32) -> f32:
    root = sqrt_scalar(x)
    if root <= 0.0:
        return 0.0
    return 1.0 / root

pub fn length2(v: Vec2) -> f32:
    return sqrt_scalar(v.x * v.x + v.y * v.y)

pub fn length3(v: Vec3) -> f32:
    return sqrt_scalar(v.x * v.x + v.y * v.y + v.z * v.z)

pub fn dot3(a: Vec3, b: Vec3) -> f32:
    return a.x * b.x + a.y * b.y + a.z * b.z

pub fn cross3(a: Vec3, b: Vec3) -> Vec3:
    return Vec3(
        x=a.y * b.z - a.z * b.y,
        y=a.z * b.x - a.x * b.z,
        z=a.x * b.y - a.y * b.x,
    )

pub fn normalize3(v: Vec3) -> Vec3:
    length = length3(v)
    if length <= 0.0:
        return Vec3(x=0.0, y=0.0, z=0.0)
    return Vec3(x=v.x / length, y=v.y / length, z=v.z / length)

pub fn plane(p: Vec3, normal: Vec3, offset: f32) -> Field:
    return Field(value=dot3(p, normal) + offset)

pub fn sphere(p: Vec3, center: Vec3, radius: f32) -> Field:
    q = Vec3(x=p.x - center.x, y=p.y - center.y, z=p.z - center.z)
    return Field(value=length3(q) - radius)

pub fn box(p: Vec3, half: Vec3) -> Field:
    qx = abs_scalar(p.x) - half.x
    qy = abs_scalar(p.y) - half.y
    qz = abs_scalar(p.z) - half.z
    outside = Vec3(
        x=max_scalar(qx, 0.0),
        y=max_scalar(qy, 0.0),
        z=max_scalar(qz, 0.0),
    )
    inside = min_scalar(max_scalar(qx, max_scalar(qy, qz)), 0.0)
    return Field(value=length3(outside) + inside)

pub fn round_box(p: Vec3, half: Vec3, radius: f32) -> Field:
    base = box(p, half)
    return Field(value=base.value - radius)

pub fn capsule(p: Vec3, a: Vec3, b: Vec3, radius: f32) -> Field:
    pax = p.x - a.x
    pay = p.y - a.y
    paz = p.z - a.z
    bax = b.x - a.x
    bay = b.y - a.y
    baz = b.z - a.z
    denom = bax * bax + bay * bay + baz * baz
    h: f32 = 0.0
    if denom > 0.0:
        h = clamp_scalar((pax * bax + pay * bay + paz * baz) / denom, 0.0, 1.0)
    q = Vec3(x=pax - bax * h, y=pay - bay * h, z=paz - baz * h)
    return Field(value=length3(q) - radius)

pub fn finite_cylinder(p: Vec3, radius: f32, half_height: f32) -> Field:
    radial = length2(Vec2(x=p.x, y=p.z)) - radius
    axial = abs_scalar(p.y) - half_height
    outside = length2(Vec2(x=max_scalar(radial, 0.0), y=max_scalar(axial, 0.0)))
    return Field(value=outside + min_scalar(max_scalar(radial, axial), 0.0))

pub fn finite_cone(p: Vec3, radius: f32, half_height: f32) -> Field:
    y = clamp_scalar(p.y + half_height, 0.0, half_height + half_height)
    allowed = radius * (1.0 - y / (half_height + half_height))
    radial = length2(Vec2(x=p.x, y=p.z)) - allowed
    axial = abs_scalar(p.y) - half_height
    return Field(value=max_scalar(radial, axial))

pub fn torus(p: Vec3, major_radius: f32, minor_radius: f32) -> Field:
    radial = length2(Vec2(x=p.x, y=p.z)) - major_radius
    return Field(value=length2(Vec2(x=radial, y=p.y)) - minor_radius)

pub fn translate(p: Vec3, by: Vec3) -> Vec3:
    return Vec3(x=p.x - by.x, y=p.y - by.y, z=p.z - by.z)

pub fn rotate(p: Vec3, row_x: Vec3, row_y: Vec3, row_z: Vec3) -> Vec3:
    return Vec3(x=dot3(row_x, p), y=dot3(row_y, p), z=dot3(row_z, p))

pub fn rigid_transform(p: Vec3, translation: Vec3, row_x: Vec3, row_y: Vec3, row_z: Vec3) -> Vec3:
    return rotate(translate(p, translation), row_x, row_y, row_z)

pub fn uniform_scale(field: Field, scale: f32) -> Field:
    return Field(value=field.value * scale)

fn finite_repeat_axis(value: f32, first: i32, count: u32, period: f32) -> f32:
    best = value - first.to[f32]() * period
    i: u32 = 1
    @budget(bound=1000000)
    while i < count:
        candidate = value - (first.to[f32]() + i.to[f32]()) * period
        if abs_scalar(candidate) < abs_scalar(best):
            best = candidate
        i = i + 1
    return best

pub fn finite_repeat_x(p: Vec3, first: i32, count: u32, period: f32) -> Vec3:
    return Vec3(x=finite_repeat_axis(p.x, first, count, period), y=p.y, z=p.z)

pub fn finite_repeat_y(p: Vec3, first: i32, count: u32, period: f32) -> Vec3:
    return Vec3(x=p.x, y=finite_repeat_axis(p.y, first, count, period), z=p.z)

pub fn finite_repeat_z(p: Vec3, first: i32, count: u32, period: f32) -> Vec3:
    return Vec3(x=p.x, y=p.y, z=finite_repeat_axis(p.z, first, count, period))

pub fn union(a: Field, b: Field) -> Field:
    return Field(value=min_scalar(a.value, b.value))

pub fn intersection(a: Field, b: Field) -> Field:
    return Field(value=max_scalar(a.value, b.value))

pub fn subtract(a: Field, b: Field) -> Field:
    return Field(value=max_scalar(a.value, -b.value))

pub fn smooth_union(a: Field, b: Field, k: f32) -> Field:
    if a.value <= b.value - k:
        return a
    if b.value <= a.value - k:
        return b
    h = 0.5 + 0.5 * (b.value - a.value) / k
    return Field(value=b.value + (a.value - b.value) * h - k * h * (1.0 - h))

pub fn smooth_intersection(a: Field, b: Field, k: f32) -> Field:
    na = Field(value=-a.value)
    nb = Field(value=-b.value)
    n = smooth_union(na, nb, k)
    return Field(value=-n.value)

pub fn smooth_subtract(a: Field, b: Field, k: f32) -> Field:
    return smooth_intersection(a, Field(value=-b.value), k)

pub fn mark[O, M](field: Field, object: O, material: M) -> Field:
    return field

pub fn sin_scalar(angle: f32) -> f32:
    # Deterministic range reduction followed by the odd degree-11 Taylor
    # polynomial. The compiler recognizes sinusoidal_displace structurally,
    # but this body remains the source-level scalar meaning.
    two_pi: f32 = 6.283185307179586
    pi: f32 = 3.141592653589793
    half_pi: f32 = 1.5707963267948966
    x = angle % two_pi
    if x > pi:
        x = x - two_pi
    if x < -pi:
        x = x + two_pi
    if x > half_pi:
        x = pi - x
    if x < -half_pi:
        x = -pi - x
    x2 = x * x
    c3: f32 = -0.16666666666666666
    c5: f32 = 0.008333333333333333
    c7: f32 = -0.0001984126984126984
    c9: f32 = 0.0000027557319223985893
    c11: f32 = -0.00000002505210838544172
    return x * (
        1.0
        + x2 * (
            c3
            + x2 * (
                c5
                + x2 * (
                    c7
                    + x2 * (
                        c9
                        + x2 * c11
                    )
                )
            )
        )
    )

pub fn cos_scalar(angle: f32) -> f32:
    half_pi: f32 = 1.5707963267948966
    return sin_scalar(angle + half_pi)

# The compiler lowers this closed form and derives amplitude, gradient,
# Hessian, and third-derivative bounds. Authors never provide those bounds.
pub fn sinusoidal_displace(
    field: Field,
    p: Vec3,
    amplitude: f32,
    frequency: f32,
    phase: f32,
) -> Field:
    wave = sin_scalar(frequency * p.x + phase)
    return Field(value=field.value + amplitude * wave)

@test
fn scalar_length_semantics_cover_large_exact_radius():
    assert sqrt_scalar(16384.0) == 128.0, "sqrt converges across large f32 exponents"
    center = Vec3(x=0.0, y=0.0, z=0.0)
    surface = sphere(
        Vec3(x=128.0, y=0.0, z=0.0),
        center=center,
        radius=128.0,
    )
    assert surface.value == 0.0, "large exact radius remains on the sphere surface"

@test
fn scalar_vector_intrinsic_source_semantics_are_pinned():
    x = Vec3(x=1.0, y=0.0, z=0.0)
    y = Vec3(x=0.0, y=1.0, z=0.0)
    cross = cross3(x, y)
    normalized = normalize3(Vec3(x=4.0, y=0.0, z=0.0))
    assert dot3(x, y) == 0.0, "orthogonal dot product must be exact"
    assert cross.x == 0.0 and cross.y == 0.0 and cross.z == 1.0, "cross order is normative"
    assert length2(Vec2(x=3.0, y=4.0)) == 5.0, "length2 uses source sqrt semantics"
    assert length3(Vec3(x=0.0, y=0.0, z=4.0)) == 4.0, "length3 stays fused"
    assert normalized.x == 1.0 and normalized.y == 0.0 and normalized.z == 0.0, "normalize guard and division order are normative"
    assert rsqrt_scalar(16.0) == 0.25, "rsqrt source guard is normative"
    assert sin_scalar(0.0) == 0.0, "sin zero is exact"
    assert cos_scalar(0.0) == sin_scalar(1.5707963267948966), "cos is the pinned shifted sin"
