                            event.x.to[u32]() >= width
                            or event.front_run.value >= 2
                            or event.back_run.value >= 2
                            or event.front_run.value == event.back_run.value
                            or event.event_ids.count == 0
                            or not referenced_events_ok
                            or event.coverage.lower() < 0
                            or event.coverage.upper() > 256
                            or event_coverage != a
                            or not __wrela_pixels_p8_raster_evidence_store(
                                job.renderer_index,
                                (y * width + event.x.to[u32]()).to[usize](),
                                event_coverage.to[u64](),
                                event_references,
                                event_id_bounds,
                                2,
                            )
                            or not __wrela_pixels_p8_write(
                                job.renderer_index,
                                job.worker_index,
                                y * width + event.x.to[u32](),
                                event_front,
                                event_alpha,
                                event_back,
                            )
                            or not __wrela_pixels_p7_workspace_charge(
                            job.renderer_index,
                            job.worker_index,
                            3,
                            1,
