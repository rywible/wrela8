                evidence_aux_lo = y.to[i64]()
                evidence_aux_hi: i64 = 0
                evidence_point_witness: i64 = 0
                normal: [f32; 4] = [0.0; 4]
                raster_derivatives: [i64; 4] = [0; 4]
                if sample.hit and not sample.event:
                    center_x = x.to[f32]() + (end - x).to[f32]() * 0.5
                    center_u = (
                        ((center_x / width.to[f32]()) * 2.0 - 1.0)
                        * width.to[f32]() / height.to[f32]()
                    )
                    center_v = 1.0 - (
                        (y.to[f32]() + 0.5) / height.to[f32]()
                    ) * 2.0
                    if telemetry_enabled:
                        point_sample = __wrela_pixels_p7_pixel_visibility_from_candidates(
                            renderer=job.renderer_index,
                            worker=job.worker_index,
                            tile=tile,
                            span=x | (end << 16),
                            y=y,
                            filter=[center_u, center_v, 0.0, 0.0],
                            candidates=candidates,
                            snapshot=snapshot,
                        )
                        if (
                            point_sample.ok and point_sample.hit
                            and point_sample.identity == sample.identity
                            and point_sample.q_hi >= sample.q_lo
                            and point_sample.q_lo <= sample.q_hi
                        ):
                            evidence_point_witness = 1
                    normal = __wrela_pixels_p7_feature_normal(
                        job.renderer_index,
                        sample.root_count >> 16,
                        center_u,
                        center_v,
                        __wrela_pixels_p7_raw_to_f32(
                            sample.q_lo + (
                                sample.q_hi - sample.q_lo
                            ) / 2,
                            config[3].to[i32](),
                        ),
                        snapshot.params,
                        snapshot.camera,
                    )
                    # `__wrela_pixels_p7_feature_normal` only has a closed form
                    # for a feature that *is* an unmodified root primitive. A
                    # feature reached through a bounded deformation has no such
                    # form: the displaced surface normal is grad(f_base) + grad(d),
                    # not the primitive's. Status 0 therefore means "no normal
                    # claim", not "corrupt state" — `normal_bounds` keeps its
                    # full-range (vacuous) enclosure and the auxiliary evidence
                    # remains non-authoritative. Substituting the
                    # primitive normal here would seal a false point enclosure.
                    if normal[0] == 1.0:
                        nx = (normal[1] * 32767.0).to[i64]()
                        ny = (normal[2] * 32767.0).to[i64]()
                        nz = (normal[3] * 32767.0).to[i64]()
                        if nx < -32767 or nx > 32767 or ny < -32767 or ny > 32767 or nz < -32767 or nz > 32767:
                            return __wrela_pixels_p7_worker_error(12, tile)
                        if sample.composition_shape == 1:
                            normal_bounds = [nx, nx, ny, ny, nz, nz]
                        evidence_aux_lo = y.to[i64]() | ((nx & 65535) << 16)
                        evidence_aux_hi = (ny & 65535) | ((nz & 65535) << 16)
                        derivative_bounds = __wrela_pixels_p8_derivative_bounds(
                            sample.q_lo,
                            sample.q_hi,
                            normal,
                            center_u,
                            center_v,
                            snapshot.camera,
                        )
                        if derivative_bounds[0] != 1:
                            return __wrela_pixels_p7_worker_error(12, tile)
                        raster_derivatives = [
                            derivative_bounds[1], derivative_bounds[2],
                            derivative_bounds[3], derivative_bounds[4],
                        ]
                    else:
                        # Deformed/composed roots deliberately carry a
                        # vacuous normal cone. Keep their compact derivatives
                        # finite and conservative instead of inventing a
                        # primitive normal: the P8 debug summary reconstructs
                        # the lane but does not request normalized direction.
                        derivative_envelope = sample.q_lo.to[i64]()
                        if derivative_envelope < 0:
                            derivative_envelope = -derivative_envelope
                        q_hi_magnitude = sample.q_hi.to[i64]()
                        if q_hi_magnitude < 0:
                            q_hi_magnitude = -q_hi_magnitude
                        if q_hi_magnitude > derivative_envelope:
                            derivative_envelope = q_hi_magnitude
                        derivative_envelope = derivative_envelope * height.to[i64]()
                        if derivative_envelope > 2147483647:
                            return __wrela_pixels_p7_worker_error(12, tile)
                        raster_derivatives = [
                            0 - derivative_envelope, derivative_envelope,
                            0 - derivative_envelope, derivative_envelope,
                        ]
                evidence_meta = (
                    sample.root_count.to[i64]()
                    | (sample.proof_method.to[i64]() << 32)
                    | (sample.composition_shape.to[i64]() << 40)
                    | (sample.coverage.to[i64]() << 48)
                    | (evidence_point_witness << 57)
                )
                if sample.event:
                    evidence_meta = evidence_meta | (1 << 56)
                slacks: [i64; 2] = [2147483647, 2147483647]
                if sample.hit and not sample.event:
                    if sample.proof_margin <= 0:
                        return __wrela_pixels_p7_worker_error(12, tile)
                    slacks = [
                        sample.proof_margin.to[i64](),
                        sample.proof_margin.to[i64](),
                    ]
                if telemetry_enabled:
                    if not __wrela_pixels_p7_workspace_store_certified_run(
                        job.renderer_index,
                        job.worker_index,
                        record,
                        [
                            row.starts[index.to[usize]()].to[i64](),
                            row.ends[index.to[usize]()].to[i64](),
                            sample.object.to[i64](),
                            sample.identity.to[i64](),
                            sample.q_lo.to[i64](),
                            sample.q_hi.to[i64](),
                            evidence_aux_lo,
                            evidence_aux_hi,
                        ],
                        model,
                        normal_bounds,
                        slacks,
                        evidence_meta,
                    ):
                        return __wrela_pixels_p7_worker_error(12, tile)
                    _ = __wrela_pixels_p7_charge_run_telemetry(
                        job.renderer_index,
                        job.worker_index,
                        sample,
                        end - x,
                    )
                if sample.event:
                    corridor_record = corridor_record + 1
                else:
                    run_record = run_record + 1
                if sample.hit and sample.q_hi.to[i64]() < sample.q_lo.to[i64]():
                    return __wrela_pixels_p7_worker_error(13, tile)
                debug_r: u8 = 0
                debug_g: u8 = 0
                debug_b: u8 = 0
                debug_back: u32 = 0
                if sample.hit:
                    debug_r = ((sample.identity >> 8) & 255).to[u8]()
                    debug_g = (sample.identity & 255).to[u8]()
                    width_class = sample.q_hi.to[i64]() - sample.q_lo.to[i64]()
                    if width_class < 0:
                        return __wrela_pixels_p7_worker_error(13, tile)
                    if width_class > 126:
                        width_class = 126
                    debug_b = (129 + width_class).to[u8]()
                    if sample.event:
                        debug_b = 255
                        if sample.proof_method & 128 != 0:
                            secondary = sample.root_count >> 16
                            debug_back = (
                                ((secondary >> 8) & 255)
                                | ((secondary & 255) << 8)
                                | (debug_b.to[u32]() << 16)
                            )
                debug_front = (
                    debug_r.to[u32]()
                    | (debug_g.to[u32]() << 8)
                    | (debug_b.to[u32]() << 16)
                )
                light_kinds = __wrela_pixels_p7_frame_snapshot_light_kinds(job.renderer_index)
                light_values = __wrela_pixels_p7_frame_snapshot_light_scalars(job.renderer_index)
                a: u8 = 255
                shade_normal: [f32; 3] = [
                    0.0 - snapshot.camera[3],
                    0.0 - snapshot.camera[4],
                    0.0 - snapshot.camera[5],
                ]
                if sample.hit:
                    shade_x = x.to[f32]() + (end - x).to[f32]() * 0.5
                    shade_u = (((shade_x / width.to[f32]()) * 2.0 - 1.0) * width.to[f32]() / height.to[f32]())
                    shade_v = 1.0 - ((y.to[f32]() + 0.5) / height.to[f32]()) * 2.0
                    shade_q_raw = (
                        sample.q_lo.to[i64]()
                        + (sample.q_hi.to[i64]() - sample.q_lo.to[i64]()) / 2
                    )
                    shade_q = __wrela_pixels_p7_raw_to_f32(
                        shade_q_raw.to[i32](), config[3].to[i32](),
                    )
                    if normal[0] == 1.0:
                        shade_normal = [normal[1], normal[2], normal[3]]
                    if sample.event:
                        a = sample.coverage
                if sample.event:
                    event_start = x
                    @budget(bound=16)
                    while x < end:
                        event_color: u32 = 0
                        if not __wrela_pixels_p9_debug_visibility():
                            certified = __wrela_pixels_p9_event_color(
                                job.renderer_index,
                                job.worker_index,
                                tile,
                                [x, y, width, height],
                                candidates,
                                snapshot,
                                sample,
                            )
                            if certified[0] != 1:
                                diagnostic_tile = tile
                                if certified[1] != 0:
                                    diagnostic_tile = certified[1].to[u32]()
                                return __wrela_pixels_p7_worker_error(91, diagnostic_tile)
                            event_color = certified[1].to[u32]()
                        # Materialize the compact event record against real,
                        # per-pixel side-run and sealed-event arenas. Run IDs
                        # 0 and 1 name the selected front and certified
                        # secondary/background colors respectively; event_ids
