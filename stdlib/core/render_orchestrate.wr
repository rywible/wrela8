                        event_side_runs: [u32; 2] = [event_color, 0]
                        if __wrela_pixels_p9_debug_visibility():
                            event_side_runs = [debug_front, debug_back]
                        # The sealed tile-event table is capped at 256 records.
                        # The filtered view can legitimately retain more than
                        # the analytic arrangement's crossing-curve limit: its
                        # reset, ownership, and composite records remain real
                        # event references and must not be discarded.
                        # The arena is the deterministic filtered view of the
                        # sealed tile-event table produced by the scan below.
                        # IdSlice offsets index that view, so no second local
                        # copy of the IDs is needed before immediate raster
                        # consumption. Preserve its endpoint IDs in evidence.
                        event_first_id: u16 = 0
                        event_last_id: u16 = 0
                        event_count = __wrela_pixels_tile_event_count(
                            job.renderer_index,
                            tile,
