                            if sealed_event[0] != 1 or sealed_event[1] > 65535:
                                return __wrela_pixels_p7_worker_error(13, tile)
                            sealed_event_id = sealed_event[1].to[u32]()
                            sealed_span = __wrela_pixels_p7_event_pixel_span(
                                job.renderer_index,
                                sealed_event_id,
                                x,
                                y,
                            )
                            if sealed_span[0] != 1:
                                return __wrela_pixels_p7_worker_error(13, tile)
                            if sealed_span[1] == 1:
                                if event_arena_count >= 256:
                                    return __wrela_pixels_p7_worker_error(13, tile)
                                if event_arena_count == 0:
                                    event_first_id = sealed_event_id.to[u16]()
                                event_last_id = sealed_event_id.to[u16]()
                                event_arena_digest = (
