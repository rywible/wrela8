                model: [i64; 8] = [
                    sample.q_lo.to[i64](),
                    sample.q_hi.to[i64](),
                    0,
                    0,
                    0,
                    0,
                    0,
                    0,
                ]
                if row.modeled and row.count == 1:
                    model = [
                        row.model[0].to[i64](),
                        row.model[1].to[i64](),
                        row.model[2].to[i64](),
                        row.model[3].to[i64](),
                        row.model[4].to[i64](),
                        row.model[5].to[i64](),
                        row.model[6].to[i64](),
                        row.model[7].to[i64](),
                    ]
                normal_bounds: [i64; 6] = [
                    -32767, 32767,
                    -32767, 32767,
                    -32767, 32767,
                ]
                # Evidence word 3 always carries the row coordinate. Normal
