                else:
                    setup = __wrela_pixels_p8_raster_setup(
                        sample,
                        model,
                        row.modeled and row.count == 1,
                        x,
                        end,
                        config[3].to[i32](),
                        height,
                        raster_derivatives,
                    )
                    if not setup.ok:
                        return __wrela_pixels_p7_worker_error(13, tile)
                    raster = setup.raster
                    raster_written = __wrela_pixels_p8_raster_regular(
                        P8RasterContext(
                            renderer=job.renderer_index,
                            worker=job.worker_index,
                            y=y,
                            width=width,
                            height=height,
                            camera=snapshot.camera,
                            scale=__wrela_pixels_p7_raw_to_f32(1, config[3].to[i32]()),
                            identity=sample.identity,
                            feature=sample.root_count >> 16,
                            hit=sample.hit,
                            normal=[shade_normal[0], shade_normal[1], shade_normal[2]],
                            params=snapshot.params,
                            light_kinds=light_kinds,
                            light_values=light_values,
                            exposure=post[0],
                            environment=[
                                post[1], post[2], post[3],
                            ],
                            debug_color=debug_front,
                            candidates=candidates,
                            snapshot=snapshot,
                        ),
                        raster,
                    )
                    if raster_written == 18446744073709551615:
                        return __wrela_pixels_p7_worker_error(90, tile)
                    __wrela_pixels_p8_charge_raster_run(
                        job.renderer_index,
                        job.worker_index,
                        telemetry_enabled,
                        y * width + x,
                        end - x,
                        raster.proof_code.bits & 8 != 0,
                    )
                    written = written +% raster_written
                    if written < raster_written:
                        return __wrela_pixels_p7_worker_error(13, tile)
                    x = end
                    coverage_x = x
                    index = index + 1
                    continue
                coverage_x = x
                index = index + 1
            if coverage_x != x1:
                return __wrela_pixels_p7_worker_error(14, tile)
            if run_record != row.run_count.to[u32]() or corridor_record != row.corridor_count.to[u32]():
                return __wrela_pixels_p7_worker_error(14, tile)
            previous_candidates = structural_candidates
            previous_row = row
            y = y + 1
        tile = tile + 1
    return written

pub fn __wrela_pixels_p7_job_value(take result: Result[u64, CallError[never]]) -> u64:
    match result:
        case .Ok(value):
            return value
        case .Err(call_error):
            match call_error:
                case .Cancelled:
                    return __wrela_pixels_p7_worker_error(8, 0)
                case .DeadlineExceeded:
                    return __wrela_pixels_p7_worker_error(9, 0)
                case .NotAdmitted(_, _):
                    return __wrela_pixels_p7_worker_error(10, 0)
                case .Op(_):
                    return __wrela_pixels_p7_worker_error(12, 0)
