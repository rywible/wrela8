                        if event_count == 4294967295 or event_count > 256:
                            return __wrela_pixels_p7_worker_error(13, tile)
                        event_arena_count: u16 = 0
                        event_arena_digest: u32 = 2166136261
                        event_ordinal: u32 = 0
                        @budget(bound=256)
                        while event_ordinal < event_count:
                            sealed_event = __wrela_pixels_tile_event(
                                job.renderer_index,
                                tile,
                                event_ordinal,
