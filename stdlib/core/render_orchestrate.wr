                    1,
                )
                _ = __wrela_pixels_p7_telemetry_charge(
                    job.renderer_index,
                    job.worker_index,
                    79,
                    row.root_count.to[u64](),
                )
            if not __wrela_pixels_p7_workspace_charge(
                job.renderer_index,
                job.worker_index,
                1,
                row.root_count.to[u64](),
            ) or not __wrela_pixels_p7_workspace_charge(
                job.renderer_index,
                job.worker_index,
                4,
                row.run_count.to[u64](),
            ) or not __wrela_pixels_p7_workspace_charge(
                job.renderer_index,
                job.worker_index,
                6,
                row.corridor_count.to[u64](),
