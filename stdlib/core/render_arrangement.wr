    # ambiguous but geometrically uniform — out of the subpixel walk.
    if (
        result[1] == 0
        and classified_curves > 0
        and crossing_curves == 0
        and not unclassified_boundary
        and center_sample.ok
        and not center_sample.event
    ):
        if center_sample.hit:
            return [1, 1, 255, 0]
        return [1, 1, 0, 0]
    if result[1] == 0:
        result[3] = crossing_curves.to[i64]()
    return result

pub fn __wrela_pixels_p7_event_coverage(
    renderer: usize,
    tile: u32,
    x: u32,
    y: u32,
    read sample: P7VisibilitySample,
    read snapshot: FrameInputSnapshot,
) -> [i64; 3]:
    if not sample.ok:
        return [0; 3]
    config = __wrela_pixels_p7_numeric_config(renderer)
    if config[0] != 1:
        return [0; 3]
    if sample.event and sample.proof_method & 127 == 3 and sample.composition_shape == 4:
        return [1, 1, sample.coverage.to[i64]()]
    q_raw = sample.q_lo.to[i64]() + (
        sample.q_hi.to[i64]() - sample.q_lo.to[i64]()
    ) / 2
    q = __wrela_pixels_p7_raw_to_f32(q_raw.to[i32](), config[3].to[i32]())
    integrated = __wrela_pixels_p7_material_event_coverage(
        renderer,
        x,
        y,
        q,
        sample.hit,
        snapshot.params,
        snapshot.camera,
    )
    if integrated[0] != 1:
        return [0; 3]
    if integrated[1] == 1:
        return integrated
    if sample.event and sample.coverage == 0:
        return [1, 1, 0]
    if sample.event:
        return [0; 3]
    return [1, 0, 255]

# `span` packs the half-open pixel range as x0 | (x1 << 16); the packing
# keeps the call inside the backend's eight-argument ceiling.
pub fn __wrela_pixels_p7_pixel_visibility_from_candidates(
    renderer: usize,
    worker: u32,
    tile: u32,
    span: u32,
    y: u32,
    read filter: [f32; 4],
    read candidates: P7RowCandidates,
    read snapshot: FrameInputSnapshot,
) -> P7VisibilitySample:
    x0 = span & 65535
    x1 = span >> 16
    # Collection is box-complete: every candidate feature is either walked to
    # certified roots, proven root-free over the box, or enclosed in a
    # corridor record — so the selected sample needs no second certification
    # pass and no per-feature exclusion back-check.
    roots = __wrela_pixels_p7_collect_roots_box(
        renderer,
        worker,
        x0,
        x1,
        y,
        filter,
        candidates,
        snapshot,
    )
    if not roots.ok:
        return P7VisibilitySample.failure_with(roots.error)
    sample = __wrela_pixels_p7_select_visibility(renderer, roots)
    sample.root_count = (sample.root_count & 4294901760) | roots.count
    return sample

pub fn __wrela_pixels_p7_resolve_silhouette_owner(
    renderer: usize,
    worker_tile: u64,
    xy: u64,
    read pixel_filter: [f32; 4],
    read candidates: P7RowCandidates,
    read snapshot: FrameInputSnapshot,
    read initial: P7VisibilitySample,
    read curve: [i64; 4],
) -> P7VisibilitySample:
    if curve[2] <= 0 or initial.hit:
        return initial
    worker = (worker_tile & 4294967295).to[u32]()
    tile = (worker_tile >> 32).to[u32]()
    x = (xy & 4294967295).to[u32]()
    y = (xy >> 32).to[u32]()
    selected = initial
    owner = curve[3]
    owner_kind = owner >> 32
    owner_value = (owner & 4294967295).to[u32]()
    if owner_kind == 1:
        owner_identity = __wrela_pixels_program_operand(renderer, 4, owner_value, 3)
        owner_object = __wrela_pixels_program_operand(renderer, 4, owner_value, 0)
        if owner_identity[0] == 1 and owner_object[0] == 1 and owner_identity[1] <= 65535 and owner_object[1] < 64:
            selected = P7VisibilitySample.background()
            selected.hit = true
            selected.object = owner_object[1].to[u32]()
            selected.identity = owner_identity[1].to[u32]()
            return selected
    elif owner_kind == 2:
        owner_identity = __wrela_pixels_program_operand(renderer, 3, owner_value, 3)
        if owner_identity[0] == 1 and owner_identity[1] <= 65535 and owner_value < 64:
            selected = P7VisibilitySample.background()
            selected.hit = true
            selected.object = owner_value
            selected.identity = owner_identity[1].to[u32]()
            return selected
    corner: u8 = 0
    @budget(bound=4)
    while corner < 4:
        corner_u = pixel_filter[0] - pixel_filter[2]
        if corner & 1 == 1:
            corner_u = pixel_filter[0] + pixel_filter[2]
        corner_v = pixel_filter[1] - pixel_filter[3]
        if corner & 2 == 2:
            corner_v = pixel_filter[1] + pixel_filter[3]
        corner_sample = __wrela_pixels_p7_pixel_visibility_from_candidates(
            renderer=renderer,
            worker=worker,
            tile=tile,
            span=x | ((x + 1) << 16),
            y=y,
            filter=[corner_u, corner_v, 0.0, 0.0],
            candidates=candidates,
            snapshot=snapshot,
        )
        if corner_sample.ok and corner_sample.hit and not corner_sample.event:
            return corner_sample
        corner = corner + 1
    return P7VisibilitySample.failure_with(50)

pub fn __wrela_pixels_p7_choose_arrangement_axis(
    renderer: usize,
    worker_tile: u64,
    xy: u64,
    read cell: [f32; 4],
    read minimum: [f32; 2],
    read candidates: P7RowCandidates,
    read snapshot: FrameInputSnapshot,
) -> [i64; 3]:
    worker = (worker_tile & 4294967295).to[u32]()
    tile = (worker_tile >> 32).to[u32]()
    x = (xy & 4294967295).to[u32]()
    y = (xy >> 32).to[u32]()
    center_u = cell[0]
    center_v = cell[1]
    radius_u = cell[2]
    radius_v = cell[3]
    can_split_u = radius_u > minimum[0]
    can_split_v = radius_v > minimum[1]
    evaluations: i64 = 0
    if can_split_u:
        half_ru = radius_u * 0.5
        left = __wrela_pixels_p7_pixel_visibility_from_candidates(
            renderer, worker, tile, x | ((x + 1) << 16), y,
            [center_u - half_ru, center_v, half_ru, radius_v],
            candidates, snapshot,
        )
        right = __wrela_pixels_p7_pixel_visibility_from_candidates(
            renderer, worker, tile, x | ((x + 1) << 16), y,
            [center_u + half_ru, center_v, half_ru, radius_v],
            candidates, snapshot,
        )
        evaluations = evaluations + 2
        if (left.ok and not left.event) or (right.ok and not right.event):
            return [1, 1, evaluations]
    if can_split_v:
        half_rv = radius_v * 0.5
        low = __wrela_pixels_p7_pixel_visibility_from_candidates(
            renderer, worker, tile, x | ((x + 1) << 16), y,
            [center_u, center_v - half_rv, radius_u, half_rv],
            candidates, snapshot,
        )
        high = __wrela_pixels_p7_pixel_visibility_from_candidates(
            renderer, worker, tile, x | ((x + 1) << 16), y,
            [center_u, center_v + half_rv, radius_u, half_rv],
            candidates, snapshot,
        )
        evaluations = evaluations + 2
        if (low.ok and not low.event) or (high.ok and not high.event):
            return [1, 2, evaluations]
    v_pointlike = __wrela_pixels_p7_pixel_visibility_from_candidates(
        renderer, worker, tile, x | ((x + 1) << 16), y,
        [center_u, center_v, radius_u, 0.0], candidates, snapshot,
    )
    u_pointlike = __wrela_pixels_p7_pixel_visibility_from_candidates(
        renderer, worker, tile, x | ((x + 1) << 16), y,
        [center_u, center_v, 0.0, radius_v], candidates, snapshot,
    )
    evaluations = evaluations + 2
    u_alone_ambiguous = not v_pointlike.ok or v_pointlike.event
    v_alone_ambiguous = not u_pointlike.ok or u_pointlike.event
    if can_split_u and not v_alone_ambiguous and u_alone_ambiguous:
        return [1, 1, evaluations]
    if can_split_v and not u_alone_ambiguous and v_alone_ambiguous:
        return [1, 2, evaluations]
    if can_split_u and (not can_split_v or radius_u >= radius_v):
        return [1, 1, evaluations]
    if can_split_v:
        return [1, 2, evaluations]
    return [0, 0, evaluations]

fn __wrela_pixels_p7_resolve_pixel_arrangement_tier(
    renderer: usize,
    worker_tile: u64,
    xy: u64,
    read pixel_filter: [f32; 4],
    read candidates: P7RowCandidates,
    read snapshot: FrameInputSnapshot,
    read initial: P7VisibilitySample,
    integrated_coverage: i64,
) -> P7PixelArrangement:
    high_precision = integrated_coverage == -2
    effective_coverage = integrated_coverage
    if high_precision:
        effective_coverage = -1
    worker = (worker_tile & 4294967295).to[u32]()
    tile = (worker_tile >> 32).to[u32]()
    x = (xy & 4294967295).to[u32]()
    y = (xy >> 32).to[u32]()
    selected = initial
    selected_hit = selected.hit
    background_seen = false
    secondary_hit = false
    secondary_identity: u32 = 0
    selected_units: u64 = 0
    resolved_units: u64 = 0
    unresolved_units: u64 = 0
    maximum_roots: u32 = 0
    # Ordinary event pixels use thirteen bisections per axis. A caller may
    # deterministically request the fourteen-per-axis tier after this one ends
    # specifically at an unresolved byte boundary; both ledgers stay well
    # inside u64 for every product below.
    coverage_units: u64 = 67108864
    coverage_half: u64 = 33554432
    if high_precision:
        coverage_units = 268435456
        coverage_half = 134217728
    # Anisotropic adaptive event arrangement (the P7.10 pixel-cell tier).
    # Binary splits keep a bounded frontier while half-decidability probes
    # choose the productive axis; every pushed half is re-certified on pop.
    empty_subdivision_cell = RendererWorkerP8RSubdivisionCell(
        center_u=0.0, center_v=0.0, radius_u=0.0, radius_v=0.0,
        depth_and_proof=0, charge_weight=0,
    )
    subdivision_cells: [RendererWorkerP8RSubdivisionCell; 72] = [empty_subdivision_cell; 72]
    subdivision_cells[0] = RendererWorkerP8RSubdivisionCell(
        center_u=pixel_filter[0], center_v=pixel_filter[1],
        radius_u=pixel_filter[2], radius_v=pixel_filter[3],
        depth_and_proof=0, charge_weight=coverage_units,
    )
    stack = RendererWorkerP8RSubdivisionStack(
        cells=subdivision_cells, count=1, capacity=72, depth_limit=255,
        event_owner=4294967295, failure_code=43, visit_limit=200000,
    )
    if effective_coverage >= 0:
        stack.clear()
        resolved_units = coverage_units
        maximum_roots = selected.root_count & 65535
    minimum_scale: f32 = 0.0001220703125
    if high_precision:
        minimum_scale = 0.00006103515625
    minimum_ru = pixel_filter[2] * minimum_scale
    minimum_rv = pixel_filter[3] * minimum_scale
    undecided_units: u64 = coverage_units
    if effective_coverage >= 0:
        undecided_units = 0
    deformation_arrangement = false
    deformation_root = __wrela_pixels_p7_deformation_veto_objects(
        renderer,
        tile,
        x.to[u64]() | (y.to[u64]() << 32),
        pixel_filter,
        snapshot.params,
        snapshot.camera,
    )
    if deformation_root[0] != 1:
        return P7PixelArrangement.failure(13)
    if deformation_root[1] != 0:
        deformation_arrangement = true
    cell_limit: u32 = 262144
    processed_cells: u32 = 0
    @budget(bound=2097152)
    while stack.length() > 0:
        pinned_low = (selected_units * 255 + coverage_half) / coverage_units
        pinned_high = (
            (selected_units + unresolved_units + undecided_units) * 255
            + coverage_half
        ) / coverage_units
        if pinned_low == pinned_high:
            unresolved_units = unresolved_units + undecided_units
            undecided_units = 0
            stack.clear()
            continue
        cell = stack.pop_prioritized(
            deformation_arrangement, pixel_filter[0], pixel_filter[1],
        )
        center_u = cell.center_u
        center_v = cell.center_v
        radius_u = cell.radius_u
        radius_v = cell.radius_v
        weight = cell.charge()
        processed_cells = processed_cells + 1
        if processed_cells > cell_limit:
            exhausted = P7PixelArrangement.failure(42)
            exhausted.model[0] = processed_cells.to[i32]()
            exhausted.model[1] = (__wrela_pixels_f32_to_bits(center_u) >> 1).to[i32]()
            exhausted.model[2] = (__wrela_pixels_f32_to_bits(center_v) >> 1).to[i32]()
            exhausted.model[3] = (__wrela_pixels_f32_to_bits(radius_u) >> 1).to[i32]()
            exhausted.model[4] = (__wrela_pixels_f32_to_bits(radius_v) >> 1).to[i32]()
            exhausted.model[5] = undecided_units.to[i32]()
            exhausted.model[6] = selected_units.to[i32]()
            exhausted.model[7] = unresolved_units.to[i32]()
            return exhausted
        cell_filter: [f32; 4] = [center_u, center_v, radius_u, radius_v]
        cell_candidates = candidates
        cell_sample = __wrela_pixels_p7_pixel_visibility_from_candidates(
            renderer=renderer,
            worker=worker,
            tile=tile,
            span=x | ((x + 1) << 16),
            y=y,
            filter=cell_filter,
            candidates=cell_candidates,
            snapshot=snapshot,
        )
        # A predictor event still belongs to the undeformed surface. If the
        # sealed exterior proof covers this complete refinement cell, remove
        # the proved-absent object before interpreting either the hit or event
        # verdict. The localized proof itself carries a backend-independent
        # strict-separation envelope, so this is deterministic for event cells
        # as well as ordinary hits.
        deformation_objects: u64 = 0
        veto: u64 = 0
        proved_hits: u64 = 0
        if deformation_arrangement:
            deformation = __wrela_pixels_p7_deformation_veto_objects(
                renderer,
                tile,
                x.to[u64]() | (y.to[u64]() << 32),
                cell_filter,
                snapshot.params,
                snapshot.camera,
            )
            if deformation[0] != 1:
                return P7PixelArrangement.failure(13)
            deformation_objects = deformation[1]
            veto = deformation[2]
            proved_hits = deformation[3]
            if veto != 0:
                cell_candidates = P7RowCandidates(ok=true, error=0, ids=[0; 256], count=0)
                candidate: u16 = 0
                @budget(bound=256)
                while candidate < candidates.count:
                    feature = candidates.ids[candidate.to[usize]()]
                    candidate = candidate + 1
                    owner = __wrela_pixels_program_operand(renderer, 4, feature, 0)
                    if owner[0] != 1 or owner[1] >= 64:
                        return P7PixelArrangement.failure(13)
                    if (veto >> owner[1]) & 1 != 0:
                        continue
                    cell_candidates.ids[cell_candidates.count.to[usize]()] = feature
                    cell_candidates.count = cell_candidates.count + 1
                cell_sample = __wrela_pixels_p7_pixel_visibility_from_candidates(
                    renderer=renderer,
                    worker=worker,
                    tile=tile,
                    span=x | ((x + 1) << 16),
                    y=y,
                    filter=cell_filter,
                    candidates=cell_candidates,
                    snapshot=snapshot,
                )
            if proved_hits != 0 and deformation_objects & (veto | proved_hits) == deformation_objects:
                # A whole-cell authored hit may retire the predictor's own
                # silhouette event only when every remaining row candidate
                # names that one proved-hit object and one identity. This is
                # an existence-and-ownership proof for the authored surface;
                # any competing object or identity leaves the cell ambiguous.
                authored_owner: u64 = 64
                authored_identity: u64 = 65536
                authored_hit = cell_candidates.count > 0
                identity_candidate: u16 = 0
                @budget(bound=256)
                while identity_candidate < cell_candidates.count:
                    feature = cell_candidates.ids[identity_candidate.to[usize]()]
                    identity_candidate = identity_candidate + 1
                    owner = __wrela_pixels_program_operand(renderer, 4, feature, 0)
                    identity = __wrela_pixels_program_operand(renderer, 4, feature, 3)
                    if (
                        owner[0] != 1 or owner[1] >= 64
                        or identity[0] != 1 or identity[1] > 65535
                        or (proved_hits >> owner[1]) & 1 == 0
                    ):
                        authored_hit = false
                        continue
                    if authored_owner == 64:
                        authored_owner = owner[1]
                        authored_identity = identity[1]
                    elif owner[1] != authored_owner or identity[1] != authored_identity:
                        authored_hit = false
                if authored_hit:
                    cell_sample.ok = true
                    cell_sample.error = 0
                    cell_sample.hit = true
                    cell_sample.event = false
                    cell_sample.object = authored_owner.to[u32]()
                    cell_sample.identity = authored_identity.to[u32]()
            if cell_sample.ok and deformation_objects & (veto | proved_hits) != deformation_objects:
                # An ordinary predictor result is not an authored-surface
                # proof, including background beyond an outward displacement.
                # Keep refining until the displaced sphere is proved wholly
                # hit/miss or the byte ledger can absorb the boundary cells.
                cell_sample.event = true
        ambiguous = not cell_sample.ok or cell_sample.event
        if not cell_sample.ok and cell_sample.error != 4 and cell_sample.error != 6:
            if cell_sample.error == 5:
                return P7PixelArrangement.failure(13)
            return P7PixelArrangement.failure(cell_sample.error)
        can_split_u = radius_u > minimum_ru
        can_split_v = radius_v > minimum_rv
        if ambiguous and weight >= 2 and (can_split_u or can_split_v):
            if stack.length() > 69:
                return P7PixelArrangement.failure(43)
            axis: [i64; 3] = [1, 2, 0]
            if deformation_objects == 0:
                axis = __wrela_pixels_p7_choose_arrangement_axis(
                    renderer,
                    worker_tile,
                    xy,
                    [center_u, center_v, radius_u, radius_v],
                    [minimum_ru, minimum_rv],
                    candidates,
                    snapshot,
                )
            else:
                # Predictor half-probes describe the undeformed primitive and
                # cannot identify a productive authored-boundary split. The
                # direct sphere's first-order screen variation scales as
                # radius*|coordinate|; radius^2 retains curvature at an axis,
                # and the x-only displacement adds a fixed u-gradient scale.
                # This heuristic changes only traversal order: both children
                # are still re-certified and every verdict is unchanged.
                u_score = (
                    radius_u * (__wrela_pixels_p7_abs(center_u) + 0.0625)
                    + radius_u * radius_u
                )
                v_score = (
                    radius_v * __wrela_pixels_p7_abs(center_v)
                    + radius_v * radius_v
                )
                if can_split_u and (not can_split_v or u_score >= v_score):
                    axis[1] = 1
            if axis[0] != 1 or axis[2] < 0 or axis[2] > 6:
                return P7PixelArrangement.failure(43)
            processed_cells = processed_cells + axis[2].to[u32]()
            split_u = axis[1] == 1
            if not stack.push_binary(cell, split_u):
                return P7PixelArrangement.failure(43)
        else:
            undecided_units = undecided_units - weight
            if ambiguous:
                unresolved_units = unresolved_units + weight
            else:
                resolved_units = resolved_units + weight
                cell_roots = cell_sample.root_count & 65535
                if cell_roots > maximum_roots:
                    maximum_roots = cell_roots
                if not cell_sample.hit:
                    background_seen = true
                else:
                    if not selected_hit:
                        selected = cell_sample
                        selected_hit = true
                    if cell_sample.identity == selected.identity:
                        selected_units = selected_units + weight
                        if cell_sample.q_lo < selected.q_lo:
                            selected.q_lo = cell_sample.q_lo
                        if cell_sample.q_hi > selected.q_hi:
                            selected.q_hi = cell_sample.q_hi
                    elif not secondary_hit:
                        secondary_hit = true
                        secondary_identity = cell_sample.identity
                    elif cell_sample.identity != secondary_identity:
                        return P7PixelArrangement.failure(44)
    if resolved_units + unresolved_units != coverage_units:
        if __wrela_pixels_p7_telemetry_counter(renderer, worker, 0)[0] == 1:
            _ = __wrela_pixels_p7_telemetry_charge(renderer, worker, 128, 1)
        return P7PixelArrangement.failure(10)
    if secondary_hit and background_seen:
        return P7PixelArrangement.failure(45)
    if not selected_hit:
        selected = P7VisibilitySample.background()
    selected.ok = true
    selected.error = 0
    selected.event = true
    selected.proof_method = 3
    selected.composition_shape = 4
    if secondary_hit:
        if secondary_identity > 65535:
            return P7PixelArrangement.failure(46)
        selected.proof_method = 131
    selected.root_count = (
        (secondary_identity << 16) | (maximum_roots & 65535)
    )
    coverage_lo = (
        (selected_units * 255 + coverage_half) / coverage_units
    ).to[u8]()
    coverage_hi = (
        ((selected_units + unresolved_units) * 255 + coverage_half) / coverage_units
    ).to[u8]()
    if effective_coverage >= 0:
        coverage_lo = effective_coverage.to[u8]()
        coverage_hi = effective_coverage.to[u8]()
    if coverage_lo != coverage_hi:
        failure = P7PixelArrangement.failure(47)
        failure.model[0] = selected_units.to[i32]()
        failure.model[1] = unresolved_units.to[i32]()
        failure.model[2] = resolved_units.to[i32]()
        failure.model[3] = coverage_lo.to[i32]()
        failure.model[4] = coverage_hi.to[i32]()
        failure.model[5] = processed_cells.to[i32]()
        return failure
    selected.proof_margin = (
        coverage_lo.to[i32]() | (coverage_hi.to[i32]() << 8)
    )
    selected.coverage = coverage_hi
    return P7PixelArrangement.success(selected)

pub fn __wrela_pixels_p7_resolve_pixel_arrangement(
    renderer: usize,
    worker_tile: u64,
    xy: u64,
    read pixel_filter: [f32; 4],
    read candidates: P7RowCandidates,
    read snapshot: FrameInputSnapshot,
    read initial: P7VisibilitySample,
    integrated_coverage: i64,
) -> P7PixelArrangement:
    ordinary = __wrela_pixels_p7_resolve_pixel_arrangement_tier(
        renderer,
        worker_tile,
        xy,
        pixel_filter,
        candidates,
        snapshot,
        initial,
        integrated_coverage,
    )
    if ordinary.error != 47 or integrated_coverage >= 0:
        return ordinary
    return __wrela_pixels_p7_resolve_pixel_arrangement_tier(
        renderer,
        worker_tile,
        xy,
        pixel_filter,
        candidates,
        snapshot,
        initial,
        -2,
    )
