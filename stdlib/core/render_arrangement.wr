# One fixed-capacity LIFO engine owns subdivision geometry and visit order for
# the arrangement handlers below. Handler-specific proof payloads remain in
# their sealed context, while this interface carries proof handoff, event
# ownership, charge weight, and failure mapping across a split.
pub struct RendererWorkerP8RSubdivisionCell:
    center_u: f32
    center_v: f32
    radius_u: f32
    radius_v: f32
    # Depth uses the low byte and proof state the next nibble. The general
    # walkers stop at depth 12, while the binary arrangement may make 28
    # successive axis splits; a u16 keeps both contracts in the same slot.
    depth_and_proof: u16
    charge_weight: u64

    pub fn depth(read self) -> u8:
        return (self.depth_and_proof & 255).to[u8]()

    pub fn proof_state(read self) -> u8:
        return (self.depth_and_proof >> 8 & 15).to[u8]()

    pub fn charge(read self) -> u64:
        return self.charge_weight

pub struct RendererWorkerP8RSubdivisionStack:
    cells: [RendererWorkerP8RSubdivisionCell; 72]
    count: u8
    capacity: u8
    depth_limit: u8
    event_owner: u32
    failure_code: u8
    visit_limit: u32

    pub fn length(read self) -> u8:
        return self.count

    pub fn can_push(read self, amount: u8) -> bool:
        return amount <= self.capacity and self.count <= self.capacity - amount

    pub fn at_depth_limit(read self, read cell: RendererWorkerP8RSubdivisionCell) -> bool:
        return cell.depth() >= self.depth_limit

    pub fn can_split(read self, read cell: RendererWorkerP8RSubdivisionCell) -> bool:
        return not self.at_depth_limit(cell) and self.can_push(4)

    pub fn owner(read self) -> u32:
        return self.event_owner

    pub fn failure(read self) -> i64:
        return self.failure_code.to[i64]()

    pub fn within_visit_limit(read self, visits: u32) -> bool:
        return visits <= self.visit_limit

    pub fn pop(mut self) -> RendererWorkerP8RSubdivisionCell:
        assert self.count > 0
        self.count = self.count - 1
        return self.cells[self.count.to[usize]()]

    pub fn push(mut self, read cell: RendererWorkerP8RSubdivisionCell):
        assert self.count < self.capacity and self.capacity <= 72
        self.cells[self.count.to[usize]()] = cell
        self.count = self.count + 1

    pub fn clear(mut self):
        self.count = 0

    # The general arrangement tier preserves its old weighted-frontier policy:
    # drain the lightest cell above the 40-cell watermark, otherwise take the
    # latest heaviest cell. Deformation ties take the cell furthest from the
    # pixel-center radius. Selection swaps with the tail before returning, so
    # no secondary array can diverge from the engine's authoritative state.
    pub fn pop_prioritized(
        mut self,
        deformation: bool,
        pixel_center_u: f32,
        pixel_center_v: f32,
    ) -> RendererWorkerP8RSubdivisionCell:
        assert self.count > 0
        drain_light = self.count > 40
        selected: u8 = 0
        scan: u8 = 1
        @budget(bound=72)
        while scan < self.count:
            current = self.cells[scan.to[usize]()]
            chosen = self.cells[selected.to[usize]()]
            lighter = current.charge() < chosen.charge()
            choose = (drain_light and lighter) or (not drain_light and not lighter)
            if deformation and current.charge() == chosen.charge():
                pixel_radius_squared = (
                    pixel_center_u * pixel_center_u
                    + pixel_center_v * pixel_center_v
                )
                current_radius_squared = (
                    current.center_u * current.center_u
                    + current.center_v * current.center_v
                )
                chosen_radius_squared = (
                    chosen.center_u * chosen.center_u
                    + chosen.center_v * chosen.center_v
                )
                current_margin = __wrela_pixels_p7_abs(
                    current_radius_squared - pixel_radius_squared
                )
                chosen_margin = __wrela_pixels_p7_abs(
                    chosen_radius_squared - pixel_radius_squared
                )
                choose = current_margin > chosen_margin
            if choose:
                selected = scan
            scan = scan + 1
        self.count = self.count - 1
        tail = self.count.to[usize]()
        selected_index = selected.to[usize]()
        result = self.cells[selected_index]
        if selected_index != tail:
            self.cells[selected_index] = self.cells[tail]
        return result

    pub fn push_binary(
        mut self,
        read parent: RendererWorkerP8RSubdivisionCell,
        split_u: bool,
    ) -> bool:
        if not self.can_push(2):
            return false
        child_weight = parent.charge() / 2
        child_depth_and_proof = (parent.depth_and_proof & 65280) | (parent.depth() + 1).to[u16]()
        if split_u:
            child_radius = parent.radius_u * 0.5
            self.push(RendererWorkerP8RSubdivisionCell(
                center_u=parent.center_u - child_radius,
                center_v=parent.center_v,
                radius_u=child_radius,
                radius_v=parent.radius_v,
                depth_and_proof=child_depth_and_proof,
                charge_weight=child_weight,
            ))
            self.push(RendererWorkerP8RSubdivisionCell(
                center_u=parent.center_u + child_radius,
                center_v=parent.center_v,
                radius_u=child_radius,
                radius_v=parent.radius_v,
                depth_and_proof=child_depth_and_proof,
                charge_weight=child_weight,
            ))
        else:
            child_radius = parent.radius_v * 0.5
            self.push(RendererWorkerP8RSubdivisionCell(
                center_u=parent.center_u,
                center_v=parent.center_v - child_radius,
                radius_u=parent.radius_u,
                radius_v=child_radius,
                depth_and_proof=child_depth_and_proof,
                charge_weight=child_weight,
            ))
            self.push(RendererWorkerP8RSubdivisionCell(
                center_u=parent.center_u,
                center_v=parent.center_v + child_radius,
                radius_u=parent.radius_u,
                radius_v=child_radius,
                depth_and_proof=child_depth_and_proof,
                charge_weight=child_weight,
            ))
        return true

    pub fn push_children(mut self, read parent: RendererWorkerP8RSubdivisionCell) -> bool:
        if not self.can_split(parent):
            return false
        child_ru = parent.radius_u * 0.5
        child_rv = parent.radius_v * 0.5
        child: u8 = 0
        @budget(bound=4)
        while child < 4:
            offset_u = -child_ru
            offset_v = -child_rv
            if child & 1 == 1:
                offset_u = child_ru
            if child & 2 == 2:
                offset_v = child_rv
            self.push(RendererWorkerP8RSubdivisionCell(
                center_u=parent.center_u + offset_u,
                center_v=parent.center_v + offset_v,
                radius_u=child_ru,
                radius_v=child_rv,
                depth_and_proof=(parent.depth_and_proof & 65280)
                    | (parent.depth() + 1).to[u16](),
                charge_weight=parent.charge() / 4,
            ))
            child = child + 1
        return true

@test
fn p8r_subdivision_engine_pins_order_capacity_charge_and_handoff():
    empty = RendererWorkerP8RSubdivisionCell(
        center_u=0.0, center_v=0.0, radius_u=0.0, radius_v=0.0,
        depth_and_proof=0, charge_weight=0,
    )
    cells: [RendererWorkerP8RSubdivisionCell; 72] = [empty; 72]
    cells[0] = RendererWorkerP8RSubdivisionCell(
        center_u=0.5, center_v=0.5, radius_u=0.5, radius_v=0.5,
        depth_and_proof=512, charge_weight=16,
    )
    stack = RendererWorkerP8RSubdivisionStack(
        cells=cells, count=1, capacity=40, depth_limit=2,
        event_owner=7, failure_code=9, visit_limit=200000,
    )
    root = stack.pop()
    assert root.depth() == 0 and root.proof_state() == 2
    assert root.charge() == 16
    assert stack.owner() == 7 and stack.failure() == 9
    assert stack.within_visit_limit(200000) and not stack.within_visit_limit(200001)
    assert stack.push_children(root)
    assert stack.length() == 4
    child_3 = stack.pop()
    child_2 = stack.pop()
    child_1 = stack.pop()
    child_0 = stack.pop()
    assert child_3.center_u == 0.75 and child_3.center_v == 0.75
    assert child_2.center_u == 0.25 and child_2.center_v == 0.75
    assert child_1.center_u == 0.75 and child_1.center_v == 0.25
    assert child_0.center_u == 0.25 and child_0.center_v == 0.25
    assert child_3.depth() == 1 and child_3.proof_state() == 2
    assert child_3.charge() == 4
    assert stack.push_children(child_3)
    grandchild = stack.pop()
    assert stack.at_depth_limit(grandchild)
    assert not stack.can_split(grandchild)

    full_cells: [RendererWorkerP8RSubdivisionCell; 72] = [empty; 72]
    full = RendererWorkerP8RSubdivisionStack(
        cells=full_cells, count=37, capacity=40, depth_limit=12,
        event_owner=11, failure_code=13, visit_limit=200000,
    )
    assert not full.can_split(root)
    assert full.owner() == 11 and full.failure() == 13

    binary_cells: [RendererWorkerP8RSubdivisionCell; 72] = [empty; 72]
    binary_cells[0] = root
    binary = RendererWorkerP8RSubdivisionStack(
        cells=binary_cells, count=1, capacity=72, depth_limit=255,
        event_owner=17, failure_code=43, visit_limit=200000,
    )
    binary_root = binary.pop_prioritized(false, 0.0, 0.0)
    assert binary.push_binary(binary_root, true)
    binary_right = binary.pop_prioritized(false, 0.0, 0.0)
    binary_left = binary.pop_prioritized(false, 0.0, 0.0)
    assert binary_right.center_u == 0.75 and binary_left.center_u == 0.25
    assert binary_right.charge() == 8 and binary_left.charge() == 8
    assert binary_right.depth() == 1 and binary_right.proof_state() == 2
    assert binary.failure() == 43 and binary.owner() == 17

    # Fourteen bisections on each axis are the high-precision product bound.
    # Keep one deterministic child per split and prove the shared cell does
    # not wrap depth into the proof payload at the old four-bit boundary.
    binary_cell = binary_right
    binary_depth: u8 = 1
    @budget(bound=27)
    while binary_depth < 28:
        assert binary.push_binary(binary_cell, binary_depth % 2 == 0)
        binary_cell = binary.pop_prioritized(false, 0.0, 0.0)
        sibling = binary.pop_prioritized(false, 0.0, 0.0)
        binary_depth = binary_depth + 1
        assert binary_cell.depth() == binary_depth
        assert binary_cell.proof_state() == 2
        assert sibling.depth() == binary_depth and sibling.proof_state() == 2

pub fn __wrela_pixels_p7_structural_corridor_pixel(
    renderer: usize,
    tile: u32,
    x: u32,
    y: u32,
) -> [i64; 2]:
    count = __wrela_pixels_tile_event_count(renderer, tile)
    if count == 4294967295 or count > 256:
        return [0, 0]
    ordinal: u32 = 0
    @budget(bound=256)
    while ordinal < count:
        event = __wrela_pixels_tile_event(renderer, tile, ordinal)
        if event[0] != 1 or event[1] > 4294967295:
            return [0, 0]
        event_id = event[1].to[u32]()
        span = __wrela_pixels_p7_event_pixel_span(renderer, event_id, x, y)
        if span[0] != 1:
            return [0, 0]
        # Every pixel in the compiler-proved conservative span is eligible
        # for the bounded local arrangement. Eligibility does not pick a
        # value: the subpixel interval partition below must still certify it.
        if span[1] == 1 and span[2] & 1024 != 0:
            return [1, 1]
        ordinal = ordinal + 1
    return [1, 0]

# Read one sealed event record's kind, representation and half-open pixel
# span, and say whether the pixel lies inside it.
#
# The record layout (frame-program table 7: operand 0 kind, 3..6 the pixel
# span) was previously spelled out at four separate call sites, so the wire
# format lived as a magic ordinal repeated across the file. Returns
# `[ok, covers, class, representation]`, with `class` the single-source event
# classification so callers never restate the kind vocabulary either.
pub fn __wrela_pixels_p7_event_pixel_span(
    renderer: usize,
    event_id: u32,
    x: u32,
    y: u32,
) -> [i64; 4]:
    record = __wrela_pixels_program_record(renderer, 7, event_id)
    kind = __wrela_pixels_program_operand(renderer, 7, event_id, 0)
    x0 = __wrela_pixels_program_operand(renderer, 7, event_id, 3)
    x1 = __wrela_pixels_program_operand(renderer, 7, event_id, 4)
    y0 = __wrela_pixels_program_operand(renderer, 7, event_id, 5)
    y1 = __wrela_pixels_program_operand(renderer, 7, event_id, 6)
    if (
        record[0] != 1 or kind[0] != 1 or x0[0] != 1
        or x1[0] != 1 or y0[0] != 1 or y1[0] != 1
    ):
        return [0, 0, 0, 0]
    covers: i64 = 0
    if (
        x.to[u64]() >= x0[1] and x.to[u64]() < x1[1]
        and y.to[u64]() >= y0[1] and y.to[u64]() < y1[1]
    ):
        covers = 1
    return [
        1,
        covers,
        __wrela_pixels_p7_event_class(record[2], kind[1]).to[i64](),
        record[2].to[i64](),
    ]

pub fn __wrela_pixels_p7_event_polynomial_at_q(
    read polynomial: [f32; 11],
    q: f32,
) -> [f32; 2]:
    if polynomial[0] != 1.0:
        return [0.0, 0.0]
    degree = polynomial[1].to[usize]()
    if degree > 8:
        return [0.0, 0.0]
    value = polynomial[degree + 2]
    coefficient = degree
    @budget(bound=8)
    while coefficient > 0:
        coefficient = coefficient - 1
        value = value * q + polynomial[coefficient + 2]
    if value != value:
        return [0.0, 0.0]
    return [1.0, value]

# Does a near/far clip level set provably not cross this cell?
#
# A clip carries no curve of its own: it is the owning feature's ray
# polynomial levelled at the sealed clip `q` (plan deviation 19). Evaluating
# that polynomial at three corners gives an affine model whose sealed
# second-derivative residual bounds the fourth, so a model that stays strictly
# on one side of zero over the cell proves the clip cuts nothing inside it.
#
# This replaces asking whether the feature's *sealed* q span sits inside the
# clip window, which can never succeed: `projection_bounds` intersects that
# span with the window before sealing it, so the answer is definitionally
# "touches both planes" for every feature in every scene.
#
# Every unproven case answers `false`, so the caller only ever loses
# precision, never soundness.
fn __wrela_pixels_p7_clip_curve_misses_cell(
    renderer: usize,
    event_id: u32,
    u0: f32,
    v0: f32,
    u1: f32,
    v1: f32,
    read snapshot: FrameInputSnapshot,
) -> bool:
    clip = __wrela_pixels_p7_event_clip_q(renderer, event_id)
    if clip[0] != 1.0:
        return false
    clip_q = clip[1]
    p00 = __wrela_pixels_p7_event_polynomial(
        renderer, event_id, u0, v0, snapshot.params, snapshot.camera,
    )
    p10 = __wrela_pixels_p7_event_polynomial(
        renderer, event_id, u1, v0, snapshot.params, snapshot.camera,
    )
    p01 = __wrela_pixels_p7_event_polynomial(
        renderer, event_id, u0, v1, snapshot.params, snapshot.camera,
    )
    if p00[0] != 1.0 or p10[0] != 1.0 or p01[0] != 1.0:
        return false
    f00 = __wrela_pixels_p7_event_polynomial_at_q(p00, clip_q)
    f10 = __wrela_pixels_p7_event_polynomial_at_q(p10, clip_q)
    f01 = __wrela_pixels_p7_event_polynomial_at_q(p01, clip_q)
    if f00[0] != 1.0 or f10[0] != 1.0 or f01[0] != 1.0:
        return false
    bounds = __wrela_pixels_p7_event_polynomial_uv2_bounds(
        renderer, event_id,
        (u0 + u1) * 0.5, (v0 + v1) * 0.5,
        __wrela_pixels_p7_abs(u1 - u0) * 0.5,
        __wrela_pixels_p7_abs(v1 - v0) * 0.5,
        [0.0; 65],
    )
    if bounds[0] != 1.0:
        return false
    du = __wrela_pixels_p7_abs(u1 - u0)
    dv = __wrela_pixels_p7_abs(v1 - v0)
    residual = (
        bounds[1] * du * du * 0.125
        + bounds[2] * du * dv
        + bounds[3] * dv * dv * 0.125
    )
    f11 = f10[1] + f01[1] - f00[1]
    low = f00[1]
    high = f00[1]
    if f10[1] < low:
        low = f10[1]
    if f01[1] < low:
        low = f01[1]
    if f11 < low:
        low = f11
    if f10[1] > high:
        high = f10[1]
    if f01[1] > high:
        high = f01[1]
    if f11 > high:
        high = f11
    if not __wrela_pixels_p5_finite(residual):
        return false
    return low > residual or high < 0.0 - residual

# Sealed arrangement-handler classes. The classifier is the single static
# interface between compiler-owned event bits and the per-class functions
# below. The dispatcher uses direct calls only; an unknown or unsupported
# class declines the optional union tier and leaves the authoritative general
# arrangement walk in charge.
fn __wrela_pixels_p8r_handler_class(event_class: u64, representation: u8) -> u8:
    if event_class & 128 != 0:
        if representation == 5:
            return 2 # canonical-torus candidate
        return 1 # polynomial silhouette
    if event_class & 2048 != 0:
        return 4 # smooth band
    if event_class & 8 != 0:
        return 3 # clip level set
    if event_class & 64 != 0:
        return 5 # bounded deformation
    if event_class & 32 != 0:
        return 6 # validity predicate
    return 0

pub fn __wrela_pixels_p8r_polynomial_handler(
    renderer: usize,
    event_id: u32,
    u0: f32,
    v0: f32,
    u1: f32,
    v1: f32,
    read snapshot: FrameInputSnapshot,
) -> [i64; 2]:
    p00 = __wrela_pixels_p7_event_polynomial(
        renderer, event_id, u0, v0, snapshot.params, snapshot.camera,
    )
    p10 = __wrela_pixels_p7_event_polynomial(
        renderer, event_id, u1, v0, snapshot.params, snapshot.camera,
    )
    p01 = __wrela_pixels_p7_event_polynomial(
        renderer, event_id, u0, v1, snapshot.params, snapshot.camera,
    )
    if p00[0] != 1.0 or p10[0] != 1.0 or p01[0] != 1.0:
        return [0, 0]
    return [1, 1]

pub fn __wrela_pixels_p8r_torus_handler(
    renderer: usize,
    event_id: u32,
    u0: f32,
    v0: f32,
    u1: f32,
    v1: f32,
    read snapshot: FrameInputSnapshot,
) -> [i64; 2]:
    coefficients = __wrela_pixels_p7_standard_torus_coefficients(
        renderer, event_id, snapshot.camera,
    )
    if coefficients[0] != 1.0:
        return [0, 0]
    bounds = __wrela_pixels_p7_standard_torus_pixel_bounds(
        coefficients,
        (u0 + u1) * 0.5,
        (v0 + v1) * 0.5,
        __wrela_pixels_p7_abs(u1 - u0) * 0.5,
        __wrela_pixels_p7_abs(v1 - v0) * 0.5,
    )
    if bounds[0] != 1.0:
        return [0, 0]
    return [1, 2]

pub fn __wrela_pixels_p8r_smooth_band_handler(
    renderer: usize,
    event_id: u32,
) -> [i64; 2]:
    event = __wrela_pixels_program_record(renderer, 7, event_id)
    if event[0] != 1:
        return [0, 0]
    return [1, 3]

pub fn __wrela_pixels_p8r_clip_handler(
    renderer: usize,
    event_id: u32,
    u0: f32,
    v0: f32,
    u1: f32,
    v1: f32,
    read snapshot: FrameInputSnapshot,
) -> [i64; 2]:
    if __wrela_pixels_p7_clip_curve_misses_cell(
        renderer, event_id, u0, v0, u1, v1, snapshot,
    ):
        return [1, 4]
    return [0, 0]

pub fn __wrela_pixels_p8r_deformation_handler(
    renderer: usize,
    event_id: u32,
    u0: f32,
    v0: f32,
    u1: f32,
    v1: f32,
    read snapshot: FrameInputSnapshot,
) -> [i64; 2]:
    if __wrela_pixels_p7_deformation_silhouette_misses(
        renderer, event_id | 2147483648, u0, v0, u1, v1,
        snapshot.params, snapshot.camera,
    ):
        return [1, 4]
    return [0, 0]

pub fn __wrela_pixels_p8r_predicate_handler(
    renderer: usize,
    event_id: u32,
    u0: f32,
    v0: f32,
    read snapshot: FrameInputSnapshot,
) -> [i64; 2]:
    # Predicate records are integrated jointly by the authoritative
    # predicate-region coverage path. This union-only dispatcher must decline
    # without evaluating a per-event descriptor whose result cannot prove a
    # sibling intersection.
    return [0, 0]

pub fn __wrela_pixels_p8r_dispatch_handler(
    handler_class: u8,
    renderer: usize,
    event_id: u32,
    u0: f32,
    v0: f32,
    u1: f32,
    v1: f32,
    read snapshot: FrameInputSnapshot,
) -> [i64; 2]:
    match handler_class:
        case 1:
            return __wrela_pixels_p8r_polynomial_handler(
                renderer, event_id, u0, v0, u1, v1, snapshot,
            )
        case 2:
            return __wrela_pixels_p8r_torus_handler(
                renderer, event_id, u0, v0, u1, v1, snapshot,
            )
        case 3:
            return __wrela_pixels_p8r_clip_handler(
                renderer, event_id, u0, v0, u1, v1, snapshot,
            )
        case 4:
            return __wrela_pixels_p8r_smooth_band_handler(renderer, event_id)
        case 5:
            return __wrela_pixels_p8r_deformation_handler(
                renderer, event_id, u0, v0, u1, v1, snapshot,
            )
        case 6:
            return __wrela_pixels_p8r_predicate_handler(
                renderer, event_id, u0, v0, snapshot,
            )
        case _:
            return [0, 0]

@test
fn p8r_handler_interface_is_sealed_and_static():
    assert __wrela_pixels_p8r_handler_class(128, 2) == 1
    assert __wrela_pixels_p8r_handler_class(128, 5) == 2
    assert __wrela_pixels_p8r_handler_class(8, 1) == 3
    assert __wrela_pixels_p8r_handler_class(2048, 1) == 4
    assert __wrela_pixels_p8r_handler_class(64, 4) == 5
    assert __wrela_pixels_p8r_handler_class(32, 1) == 6
    assert __wrela_pixels_p8r_handler_class(1, 1) == 0

fn __wrela_pixels_p7_point_union_occupancy(
    renderer: usize,
    worker: u32,
    x: u32,
    y: u32,
    u: f32,
    v: f32,
    read candidates: P7RowCandidates,
    read snapshot: FrameInputSnapshot,
) -> [i64; 3]:
    roots = __wrela_pixels_p7_collect_roots_box(
        renderer, worker, x, x + 1, y, [u, v, 0.0, 0.0], candidates, snapshot,
    )
    if not roots.ok:
        return [0, roots.error.to[i64](), 0]
    visibility = __wrela_pixels_p7_select_visibility(renderer, roots)
    if visibility.ok:
        hit: i64 = 0
        if visibility.hit:
            hit = 1
        return [1, 0, hit]
    if visibility.error != 4:
        return [0, visibility.error.to[i64](), 0]
    initial = __wrela_pixels_p7_csg_evaluate(renderer, roots.initial_inside)
    if not initial.ok:
        return [0, 5, 0]
    hit = initial.value or roots.count > 0
    if hit:
        return [1, 0, 1]
    return [1, 0, 0]

# Resolve the identity owner of an event generator from its sealed
# participant list: the first Feature participant wins, else the first
# Object participant. Encoded as (kind << 32) | id with kind 1 = feature,
# 2 = object; 0 means no resolvable owner.
fn __wrela_pixels_p7_event_owner(renderer: usize, event_id: u32) -> i64:
    count = __wrela_pixels_program_operand(renderer, 7, event_id, 11)
    if count[0] != 1 or count[1] > 16:
        return 0
    pair: u64 = 0
    object_owner: i64 = 0
    @budget(bound=16)
    while pair < count[1]:
        tag = __wrela_pixels_program_operand(renderer, 7, event_id, (13 + pair * 2).to[u16]())
        value = __wrela_pixels_program_operand(renderer, 7, event_id, (14 + pair * 2).to[u16]())
        if tag[0] != 1 or value[0] != 1 or value[1] > 4294967295:
            return 0
        if tag[1] == 1:
            return 4294967296 + value[1].to[i64]()
        if tag[1] == 2 and object_owner == 0:
            object_owner = 8589934592 + value[1].to[i64]()
        pair = pair + 1
    return object_owner

pub fn __wrela_pixels_p7_union_silhouette_coverage_at_slack(
    renderer: usize,
    worker_tile: u64,
    x: u32,
    y: u32,
    read candidates: P7RowCandidates,
    read center_sample: P7VisibilitySample,
    read snapshot: FrameInputSnapshot,
    torus_slack: u64,
) -> [i64; 4]:
    pixels_census_region(PIXELS_REGION_COVERAGE_ENTRY)
    worker = (worker_tile & 4294967295).to[u32]()
    tile = (worker_tile >> 32).to[u32]()
    if __wrela_pixels_p7_projected_union_mode(renderer) != 1:
        return [0; 4]
    config = __wrela_pixels_p7_numeric_config(renderer)
    count = __wrela_pixels_tile_event_count(renderer, tile)
    if config[0] != 1 or count == 4294967295 or count > 256:
        return [0; 4]
    width = config[1].to[f32]()
    height = config[2].to[f32]()
    aspect = width / height
    pixel_u0 = ((x.to[f32]() / width) * 2.0 - 1.0) * aspect
    pixel_u1 = (((x + 1).to[f32]() / width) * 2.0 - 1.0) * aspect
    pixel_v0 = 1.0 - (y.to[f32]() / height) * 2.0
    pixel_v1 = 1.0 - ((y + 1).to[f32]() / height) * 2.0
    # The tile event table and event span operands are invariant across every
    # refinement cell of this pixel. Collect the small relevant set once so a
    # depth-12 walk does not re-read up to 256 table records per cell. More
    # than eight relevant curves is a valid scene but beyond this optional
    # analytic tier; decline and let the general arrangement walk own it.
    relevant_events: [u32; 8] = [0; 8]
    relevant_representations: [u8; 8] = [0; 8]
    relevant_handlers: [u8; 8] = [0; 8]
    relevant_count: u8 = 0
    band_influence = false
    owner_event: i64 = -1
    tile_ordinal: u32 = 0
    @budget(bound=256)
    while tile_ordinal < count:
        event = __wrela_pixels_tile_event(renderer, tile, tile_ordinal)
        if event[0] != 1 or event[1] > 4294967295:
            return [0; 4]
        event_id = event[1].to[u32]()
        span = __wrela_pixels_p7_event_pixel_span(renderer, event_id, x, y)
        if span[0] != 1:
            return [0; 4]
        pixel_in_event = span[1] == 1
        event_class = span[2].to[u64]()
        polynomial_silhouette = event_class & 128 != 0
        smooth_band = event_class & 2048 != 0
        routed_boundary = (
            polynomial_silhouette or smooth_band
            or (
                event_class & 1 != 0
                and event_class & 16 == 0 and event_class & 512 == 0
            )
        )
        if pixel_in_event and routed_boundary:
            handler_class = __wrela_pixels_p8r_handler_class(
                event_class, span[3].to[u8](),
            )
            handled = __wrela_pixels_p8r_dispatch_handler(
                handler_class,
                renderer,
                event_id,
                pixel_u0,
                pixel_v0,
                pixel_u1,
                pixel_v1,
                snapshot,
            )
            if handled[0] != 1:
                return [0; 4]
            if handled[1] == 1 or handled[1] == 2:
                if relevant_count == 8:
                    return [0; 4]
                slot = relevant_count.to[usize]()
                relevant_events[slot] = event_id
                relevant_representations[slot] = span[3].to[u8]()
                relevant_handlers[slot] = handled[1].to[u8]()
                relevant_count = relevant_count + 1
                owner_event = event_id.to[i64]()
            elif handled[1] == 3:
                # Smooth-band occupancy is corroborated inside the shared
                # cell walk rather than treated as a standalone curve.
                band_influence = true
        tile_ordinal = tile_ordinal + 1
    if relevant_count == 0:
        return [0; 4]
    # Preflight the narrow algebraic side classifier once per pixel. With one
    # sealed feature/object the only inside bit is bit zero; the canonical
    # torus Hessian check below still gates every actual use, so this preflight
    # makes no claim about non-canonical torus events.
    torus_standalone = false
    torus_eye = 0.0 - snapshot.camera[2]
    if config[9] == 1 and config[11] == 1 and candidates.count == 1:
        outside = __wrela_pixels_p7_csg_evaluate(renderer, 0)
        inside = __wrela_pixels_p7_csg_evaluate(renderer, 1)
        q_far = __wrela_pixels_p7_raw_to_f32(config[4].to[i32](), config[3].to[i32]())
        q_near = __wrela_pixels_p7_raw_to_f32(config[5].to[i32](), config[3].to[i32]())
        if (
            outside.ok and inside.ok and not outside.value and inside.value
            and torus_eye > 3.0 and q_far > 0.0 and q_near > q_far
            and q_far * (torus_eye + 3.0) < 1.0
            and q_near * (torus_eye - 3.0) > 1.0
        ):
            torus_standalone = true
    root_center_u = (pixel_u0 + pixel_u1) * 0.5
    root_center_v = (pixel_v0 + pixel_v1) * 0.5
    root_radius_u = __wrela_pixels_p7_abs(pixel_u1 - pixel_u0) * 0.5
    root_radius_v = __wrela_pixels_p7_abs(pixel_v1 - pixel_v0) * 0.5
    empty_subdivision_cell = RendererWorkerP8RSubdivisionCell(
        center_u=0.0, center_v=0.0, radius_u=0.0, radius_v=0.0,
        depth_and_proof=0, charge_weight=0,
    )
    subdivision_cells: [RendererWorkerP8RSubdivisionCell; 72] = [empty_subdivision_cell; 72]
    subdivision_cells[0] = RendererWorkerP8RSubdivisionCell(
        center_u=root_center_u, center_v=root_center_v,
        radius_u=root_radius_u, radius_v=root_radius_v,
        depth_and_proof=0, charge_weight=16777216,
    )
    stack = RendererWorkerP8RSubdivisionStack(
        cells=subdivision_cells, count=1, capacity=40,
        depth_limit=12, event_owner=owner_event.to[u32](), failure_code=0,
        visit_limit=200000,
    )
    # The affine sign proof uses three independent corner values; its fourth
    # affine corner is derived from those three and enclosed by the Hessian
    # residual. Cache exactly that minimal basis plus its maximum evaluator
    # error. Five midpoint evaluations then seed all four children.
    cell_torus_f00: [f32; 40] = [0.0; 40]
    cell_torus_e00: [f32; 40] = [0.0; 40]
    cell_torus_f10: [f32; 40] = [0.0; 40]
    cell_torus_e10: [f32; 40] = [0.0; 40]
    cell_torus_f01: [f32; 40] = [0.0; 40]
    cell_torus_e01: [f32; 40] = [0.0; 40]
    # A canonical torus's camera-dependent 28 bivariate coefficients and its
    # derivative maxima over this pixel do not change across child cells.
    # Cache both once; per-child work is then an outward-rounded interval
    # Horner evaluation plus the cached pixel-wide Hessian bounds. The
    # generated helper validates the exact canonical event/camera contract
    # before setting its status word.
    standard_torus_event: u32 = 4294967295
    standard_torus_coefficients: [f32; 57] = [0.0; 57]
    standard_torus_pixel_bounds: [f32; 8] = [0.0; 8]
    if relevant_count == 1 and relevant_handlers[0] == 2:
        standard_torus_coefficients = __wrela_pixels_p7_standard_torus_coefficients(
            renderer, relevant_events[0], snapshot.camera,
        )
        if standard_torus_coefficients[0] == 1.0:
            standard_torus_pixel_bounds = __wrela_pixels_p7_standard_torus_pixel_bounds(
                standard_torus_coefficients,
                root_center_u, root_center_v, root_radius_u, root_radius_v,
            )
            if standard_torus_pixel_bounds[0] == 1.0:
                standard_torus_event = relevant_events[0]
    if standard_torus_event != 4294967295:
        root_cu0 = root_center_u - root_radius_u
        root_cu1 = root_center_u + root_radius_u
        root_cv0 = root_center_v - root_radius_v
        root_cv1 = root_center_v + root_radius_v
        root_p00 = __wrela_pixels_p7_standard_torus_value(
            standard_torus_coefficients, root_cu0, root_cv0,
        )
        root_p10 = __wrela_pixels_p7_standard_torus_value(
            standard_torus_coefficients, root_cu1, root_cv0,
        )
        root_p01 = __wrela_pixels_p7_standard_torus_value(
            standard_torus_coefficients, root_cu0, root_cv1,
        )
        if root_p00[0] != 1.0 or root_p10[0] != 1.0 or root_p01[0] != 1.0:
            return [0; 4]
        cell_torus_f00[0] = root_p00[1]
        cell_torus_e00[0] = root_p00[2]
        cell_torus_f10[0] = root_p10[1]
        cell_torus_e10[0] = root_p10[2]
        cell_torus_f01[0] = root_p01[1]
        cell_torus_e01[0] = root_p01[2]
    lower_area_units: u64 = 0
    upper_area_units: u64 = 0
    # Magnitude bounds are event-specific. Caching one row per relevant event
    # prevents a second torus from inheriting the first torus's bounds.
    torus_magnitude_cache: [[f32; 65]; 8] = [[0.0; 65]; 8]
    processed: u32 = 0
    pixels_census_region(PIXELS_REGION_COVERAGE_CELL_WALK)
    @budget(bound=262144)
    while stack.length() > 0:
        stack_index = (stack.length() - 1).to[usize]()
        cell = stack.pop()
        center_u = cell.center_u
        center_v = cell.center_v
        radius_u = cell.radius_u
        radius_v = cell.radius_v
        depth = cell.depth()
        inherited_torus_positive_class = cell.proof_state()
        inherited_torus_f00 = cell_torus_f00[stack_index]
        inherited_torus_e00 = cell_torus_e00[stack_index]
        inherited_torus_f10 = cell_torus_f10[stack_index]
        inherited_torus_e10 = cell_torus_e10[stack_index]
        inherited_torus_f01 = cell_torus_f01[stack_index]
        inherited_torus_e01 = cell_torus_e01[stack_index]
        current_torus_f00: f32 = 0.0
        current_torus_e00: f32 = 0.0
        current_torus_f10: f32 = 0.0
        current_torus_e10: f32 = 0.0
        current_torus_f01: f32 = 0.0
        current_torus_e01: f32 = 0.0
        processed = processed + 1
        if processed > 200000:
            return [0; 4]
        cu0 = center_u - radius_u
        cu1 = center_u + radius_u
        cv0 = center_v - radius_v
        cv1 = center_v + radius_v
        any_inside = false
        all_outside = true
        ambiguous_count: u32 = 0
        # A whole-cell occupancy conclusion drawn from a *sample* reads the
        # union's visibility at one point. That equals the cell's occupancy
        # only when no tracked member's boundary crosses the cell: otherwise
        # the sample can be answered by a member whose own boundary runs
        # through the cell, and claiming the full cell from it would bulldoze
        # the partial coverage that member actually has. Sampling is therefore
        # deferred until every member's sign over this cell is known.
        sampled_pending = false
        sampled_u: f32 = 0.0
        sampled_v: f32 = 0.0
        line_a: i32 = 0
        line_b: i32 = 0
        line_c: i32 = 0
        line_error: i32 = 0
        line_torus = false
        line_standard_torus = false
        line_standard_positive_known = false
        line_standard_positive_hit = false
        line_positive_u: f32 = 0.0
        line_positive_v: f32 = 0.0
        line_has_positive = false
        line_negative_u: f32 = 0.0
        line_negative_v: f32 = 0.0
        line_has_negative = false
        ordinal: u8 = 0
        @budget(bound=8)
        while ordinal < relevant_count:
            event_slot = ordinal.to[usize]()
            event_id = relevant_events[event_slot]
            representation = relevant_representations[event_slot]
            event_magnitudes = torus_magnitude_cache[event_slot]
            standard_torus = false
            if representation == 2 or representation == 5:
                bounds: [f32; 4] = [0.0; 4]
                value_error: f32 = 0.0
                f00: f32 = 0.0
                f10: f32 = 0.0
                f01: f32 = 0.0
                f11: f32 = 0.0
                cached_standard_value = (
                    representation == 5 and event_id == standard_torus_event
                )
                standard_positive_known = inherited_torus_positive_class != 0
                standard_positive_hit = inherited_torus_positive_class == 2
                if cached_standard_value:
                    f00 = inherited_torus_f00
                    f10 = inherited_torus_f10
                    f01 = inherited_torus_f01
                    f11 = f10 + f01 - f00
                    value_error = inherited_torus_e00
                    if inherited_torus_e10 > value_error:
                        value_error = inherited_torus_e10
                    if inherited_torus_e01 > value_error:
                        value_error = inherited_torus_e01
                    current_torus_f00 = f00
                    current_torus_e00 = inherited_torus_e00
                    current_torus_f10 = f10
                    current_torus_e10 = inherited_torus_e10
                    current_torus_f01 = f01
                    current_torus_e01 = inherited_torus_e01
                    standard_bounds = __wrela_pixels_p7_standard_torus_discriminant(
                        standard_torus_coefficients,
                        standard_torus_pixel_bounds,
                        center_u, center_v, radius_u, radius_v,
                    )
                    if standard_bounds[0] != 1.0:
                        return [0; 4]
                    standard_torus = true
                    bounds = [1.0, standard_bounds[2], standard_bounds[3], standard_bounds[4]]
                else:
                    p00: [f32; 11] = [0.0; 11]
                    p10: [f32; 11] = [0.0; 11]
                    p01: [f32; 11] = [0.0; 11]
                    p11: [f32; 11] = [0.0; 11]
                    p00 = __wrela_pixels_p7_event_polynomial(
                        renderer, event_id, cu0, cv0,
                        snapshot.params, snapshot.camera,
                    )
                    p10 = __wrela_pixels_p7_event_polynomial(
                        renderer, event_id, cu1, cv0,
                        snapshot.params, snapshot.camera,
                    )
                    p01 = __wrela_pixels_p7_event_polynomial(
                        renderer, event_id, cu0, cv1,
                        snapshot.params, snapshot.camera,
                    )
                    p11 = __wrela_pixels_p7_event_polynomial(
                        renderer, event_id, cu1, cv1,
                        snapshot.params, snapshot.camera,
                    )
                    if representation == 5:
                        p00 = __wrela_pixels_p7_quartic_discriminant(p00)
                        p10 = __wrela_pixels_p7_quartic_discriminant(p10)
                        p01 = __wrela_pixels_p7_quartic_discriminant(p01)
                        p11 = __wrela_pixels_p7_quartic_discriminant(p11)
                        value_error = p00[3]
                        if p10[3] > value_error:
                            value_error = p10[3]
                        if p01[3] > value_error:
                            value_error = p01[3]
                        if p11[3] > value_error:
                            value_error = p11[3]
                        if event_magnitudes[0] != 1.0:
                            event_magnitudes = __wrela_pixels_p7_torus_event_magnitudes(
                                renderer, event_id,
                                snapshot.params, snapshot.camera,
                            )
                            if event_magnitudes[0] != 1.0:
                                return [0; 4]
                            torus_magnitude_cache[event_slot] = event_magnitudes
                        bounds = __wrela_pixels_p7_event_polynomial_uv2_bounds(
                            renderer, event_id,
                            center_u, center_v, radius_u, radius_v,
                            event_magnitudes,
                        )
                    else:
                        bounds = __wrela_pixels_p7_event_polynomial_uv2_bounds(
                            renderer, event_id,
                            center_u, center_v, radius_u, radius_v,
                            event_magnitudes,
                        )
                    if (
                        p00[0] != 1.0 or p00[1] != 0.0
                        or p10[0] != 1.0 or p10[1] != 0.0
                        or p01[0] != 1.0 or p01[1] != 0.0
                        or p11[0] != 1.0 or p11[1] != 0.0
                    ):
                        return [0; 4]
                    f00 = p00[2]
                    f10 = p10[2]
                    f01 = p01[2]
                    f11 = p11[2]
                if bounds[0] != 1.0:
                    return [0; 4]
                affine11 = f10 + f01 - f00
                du = radius_u * 2.0
                dv = radius_v * 2.0
                residual = (
                    bounds[1] * du * du * 0.125
                    + bounds[2] * du * dv
                    + bounds[3] * dv * dv * 0.125
                )
                if representation == 5:
                    # `affine11` combines three rounded corner values. Three
                    # times the worst per-corner discriminant error encloses
                    # every sign decision made from that affine model.
                    residual = residual + value_error * 3.0
                affine_min = f00
                affine_max = f00
                if f10 < affine_min:
                    affine_min = f10
                if f01 < affine_min:
                    affine_min = f01
                if affine11 < affine_min:
                    affine_min = affine11
                if f10 > affine_max:
                    affine_max = f10
                if f01 > affine_max:
                    affine_max = f01
                if affine11 > affine_max:
                    affine_max = affine11
                a_value = f10 - f00
                b_value = f01 - f00
                fixed_positive = affine_min > residual
                fixed_negative = affine_max < 0.0 - residual
                if (
                    representation == 5 and standard_torus and torus_standalone
                    and not fixed_positive and not fixed_negative
                ):
                    cell_class = __wrela_pixels_p7_standard_torus_cell_positive_hit(
                        center_u, center_v, radius_u, radius_v, torus_eye,
                    )
                    if cell_class[0] == 1:
                        standard_positive_known = true
                        standard_positive_hit = cell_class[1] == 1
                        inherited_torus_positive_class = 1
                        if standard_positive_hit:
                            inherited_torus_positive_class = 2
                if representation == 5 and (fixed_positive or fixed_negative):
                    point_hit = false
                    point_known = false
                    # The standalone torus preflight proves this member is the
                    # scene's only occupancy source *and* that both of its
                    # roots lie inside the sealed clip window, so these two
                    # verdicts are structural: they read the member's own root
                    # count, not the union's visibility at a point.
                    if torus_standalone and standard_torus:
                        if fixed_negative:
                            point_known = true
                            point_hit = true
                        elif standard_positive_known:
                            point_known = true
                            point_hit = standard_positive_hit
                        else:
                            fast_point = __wrela_pixels_p7_standard_torus_positive_hit(
                                center_u, center_v, torus_eye,
                            )
                            if fast_point[0] == 1:
                                point_known = true
                                point_hit = fast_point[1] == 1
                    if point_known:
                        if point_hit:
                            any_inside = true
                    else:
                        # Everything else — including reusing the pixel's own
                        # centre sample at depth zero — is a union visibility
                        # reading, so it waits for the ambiguity verdict.
                        sampled_pending = true
                        sampled_u = center_u
                        sampled_v = center_v
                elif (
                    representation == 5
                    and standard_positive_known and standard_positive_hit
                ):
                    # P < 0 and Q < 0 over the complete cell proves four roots
                    # on D > 0; D < 0 has two roots structurally. Both sides are
                    # occupied, so this discriminant branch is internal and
                    # contributes a full cell without geometric refinement.
                    any_inside = true
                elif representation == 2 and fixed_positive:
                    # A strictly positive quadratic discriminant proves two
                    # distinct real roots of this member's ray polynomial for
                    # every ray in the cell. The composite is a pure union
                    # (`projected_union_mode`), and union occupancy is
                    # monotone in its members, so one member being hit
                    # throughout the cell fills the cell whatever the other
                    # members do — this conclusion is about *this* member and
                    # is not weakened by another member's boundary crossing
                    # here, which is what separates it from the sample path.
                    any_inside = true
                elif not fixed_negative:
                    all_outside = false
                    ambiguous_count = ambiguous_count + 1
                    magnitude = (
                        __wrela_pixels_p7_abs(f00)
                        + __wrela_pixels_p7_abs(a_value)
                        + __wrela_pixels_p7_abs(b_value)
                        + residual
                    )
                    if magnitude > 0.0:
                        scale = 999000.0 / magnitude
                        line_a = (a_value * scale).to[i32]()
                        line_b = (b_value * scale).to[i32]()
                        line_c = (f00 * scale).to[i32]()
                        line_error = (residual * scale).to[i32]() + 4
                        if representation == 5:
                            line_torus = true
                            line_standard_torus = standard_torus
                            line_standard_positive_known = standard_positive_known
                            line_standard_positive_hit = standard_positive_hit
                            # Keep the extreme corner on *each* side of the
                            # curve, not just the largest by magnitude: for a
                            # torus the two sides have to be resolved
                            # independently (see the accumulation below).
                            highest = f00
                            lowest = f00
                            line_positive_u = cu0
                            line_positive_v = cv0
                            line_negative_u = cu0
                            line_negative_v = cv0
                            if f10 > highest:
                                highest = f10
                                line_positive_u = cu1
                                line_positive_v = cv0
                            if f01 > highest:
                                highest = f01
                                line_positive_u = cu0
                                line_positive_v = cv1
                            if f11 > highest:
                                highest = f11
                                line_positive_u = cu1
                                line_positive_v = cv1
                            if f10 < lowest:
                                lowest = f10
                                line_negative_u = cu1
                                line_negative_v = cv0
                            if f01 < lowest:
                                lowest = f01
                                line_negative_u = cu0
                                line_negative_v = cv1
                            if f11 < lowest:
                                lowest = f11
                                line_negative_u = cu1
                                line_negative_v = cv1
                            # A side sample is reusable only when its sign is
                            # separated from the curve by the same evaluator
                            # residual used for every other cell decision.
                            line_has_positive = highest > residual
                            line_has_negative = lowest < 0.0 - residual
            ordinal = ordinal + 1
        # Resolve any deferred union sample now that every member's sign over
        # this cell is known. With no member ambiguous here, occupancy is
        # constant across the cell in a *pure* union and one reading decides
        # it in both directions — a hit fills the cell, a miss empties it.
        # (Inside a smooth band that constancy fails; the corroboration block
        # below re-derives any such cell from composite occupancy.) With a
        # member ambiguous, no point reading can be attributed to a
        # particular member, so the cell keeps its full area as uncertainty
        # instead.
        cell_contaminated = false
        if sampled_pending:
            if ambiguous_count == 0:
                point = __wrela_pixels_p7_point_union_occupancy(
                    renderer, worker, x, y,
                    sampled_u, sampled_v, candidates, snapshot,
                )
                if point[0] != 1:
                    return [0; 4]
                if point[2] == 1:
                    any_inside = true
            else:
                cell_contaminated = true
                all_outside = false
        # Inside a smooth band, "every member discriminant is negative" no
        # longer proves emptiness and one occupancy reading no longer proves
        # fullness: the composite bridge occupies member-root-free cells and
        # its own silhouette crosses them. Any cell about to be decided
        # without a member-ambiguity witness is instead refined to the
        # corroboration floor and then decided by composite occupancy itself:
        # five agreeing readings decide the cell exactly as one reading
        # decides an unambiguous cell of a pure union, and a disagreement is
        # the blend silhouette crossing this cell, which only refinement can
        # apportion. Measured on `check-pixels-smooth-csg`: the four
        # neck-saddle pixels displayed the member-union coverage 218 where
        # the blended surface truly covers 237.
        if (
            band_influence and not any_inside
            and not cell_contaminated and ambiguous_count == 0
        ):
            if depth < 5:
                all_outside = false
            else:
                occupied_readings: u8 = 0
                probe_index: u8 = 0
                @budget(bound=5)
                while probe_index < 5:
                    probe_u = center_u
                    probe_v = center_v
                    if probe_index == 1:
                        probe_u = cu0
                        probe_v = cv0
                    elif probe_index == 2:
                        probe_u = cu1
                        probe_v = cv0
                    elif probe_index == 3:
                        probe_u = cu0
                        probe_v = cv1
                    elif probe_index == 4:
                        probe_u = cu1
                        probe_v = cv1
                    point = __wrela_pixels_p7_point_union_occupancy(
                        renderer, worker, x, y,
                        probe_u, probe_v, candidates, snapshot,
                    )
                    if point[0] != 1:
                        return [0; 4]
                    if point[2] == 1:
                        occupied_readings = occupied_readings + 1
                    probe_index = probe_index + 1
                if occupied_readings == 5:
                    any_inside = true
                elif occupied_readings == 0:
                    all_outside = true
                else:
                    all_outside = false
        weight = cell.charge()
        if any_inside:
            lower_area_units = lower_area_units + 512 * weight
            upper_area_units = upper_area_units + 512 * weight
        elif all_outside:
            pass
        elif cell_contaminated:
            # Unknown between empty and full: a sound enclosure still, just an
            # uninformative one. Refining is pointless because the ambiguity is
            # about which member answered, not about resolution, so this cell
            # simply carries its whole weight into the upper bound.
            upper_area_units = upper_area_units + 512 * weight
        else:
            # Enclose this cell's own contribution *before* deciding whether to
            # subdivide it. The stopping rule is a pure cost/precision knob —
            # stopping earlier or later never changes the fact that what is
            # accumulated is a valid enclosure — so it is allowed to look at the
            # interval it is about to commit and keep refining while that
            # interval alone could still move the output byte.
            line_clean = (
                ambiguous_count == 1
                and line_error > 0
                and (line_a != 0 or line_b != 0)
            )
            cell_known = false
            cell_lower: u64 = 0
            cell_upper: u64 = 512
            if ambiguous_count == 1 and line_error > 0:
                low = coverage_line_twice_area(
                    line_a, line_b, line_c - line_error,
                )
                high = coverage_line_twice_area(
                    line_a, line_b, line_c + line_error,
                )
                match low:
                    case .Value(low_area):
                        match high:
                            case .Value(high_area):
                                cell_known = true
                                cell_lower = low_area.lower().to[u64]()
                                other_lower = high_area.lower().to[u64]()
                                if other_lower < cell_lower:
                                    cell_lower = other_lower
                                cell_upper = low_area.upper().to[u64]()
                                other_upper = high_area.upper().to[u64]()
                                if other_upper > cell_upper:
                                    cell_upper = other_upper
                            case .Error:
                                pass
                    case .Error:
                        pass
            # `cell_lower`/`cell_upper` enclose the area of the `D >= 0` side of
            # the cell. For an ordinary polynomial silhouette that side *is* the
            # occupied side. For a torus it is not: the sealed curve is the
            # quartic's discriminant, and `D < 0` means exactly two real roots —
            # always a hit — while `D > 0` means four roots or none. A branch of
            # `D = 0` crossing the cell can therefore be an internal 4<->2
            # transition across which occupancy does not change at all, and
            # orienting the cell from a single reference point silently reports
            # the area of one side as the coverage. Resolve both sides instead.
            #
            # The occupancy oracle is only consulted on the accumulate path, so
            # the refinement estimate below reuses the per-pixel cache when it is
            # already populated and otherwise falls back to the raw width.
            slack = 512 * weight
            if cell_known:
                slack = (cell_upper - cell_lower) * weight
            refine = false
            if not stack.at_depth_limit(cell):
                if not line_clean or not cell_known:
                    refine = true
                elif not line_torus and depth < 8:
                    refine = true
                elif line_torus and cell_known and slack > torus_slack:
                    refine = true
            if refine:
                if not stack.can_split(cell):
                    return [0; 4]
                split_bottom: [f32; 3] = [0.0; 3]
                split_top: [f32; 3] = [0.0; 3]
                split_left: [f32; 3] = [0.0; 3]
                split_right: [f32; 3] = [0.0; 3]
                split_center: [f32; 3] = [0.0; 3]
                if standard_torus_event != 4294967295:
                    split_bottom = __wrela_pixels_p7_standard_torus_value(
                        standard_torus_coefficients, center_u, cv0,
                    )
                    split_top = __wrela_pixels_p7_standard_torus_value(
                        standard_torus_coefficients, center_u, cv1,
                    )
                    split_left = __wrela_pixels_p7_standard_torus_value(
                        standard_torus_coefficients, cu0, center_v,
                    )
                    split_right = __wrela_pixels_p7_standard_torus_value(
                        standard_torus_coefficients, cu1, center_v,
                    )
                    split_center = __wrela_pixels_p7_standard_torus_value(
                        standard_torus_coefficients, center_u, center_v,
                    )
                    if (
                        split_bottom[0] != 1.0 or split_top[0] != 1.0
                        or split_left[0] != 1.0 or split_right[0] != 1.0
                        or split_center[0] != 1.0
                    ):
                        return [0; 4]
                child_ru = radius_u * 0.5
                child_rv = radius_v * 0.5
                child_depth = depth + 1
                child: u8 = 0
                @budget(bound=4)
                while child < 4:
                    destination = stack.length().to[usize]()
                    offset_u = 0.0 - child_ru
                    offset_v = 0.0 - child_rv
                    if child & 1 == 1:
                        offset_u = child_ru
                    if child & 2 == 2:
                        offset_v = child_rv
                    stack.push(RendererWorkerP8RSubdivisionCell(
                        center_u=center_u + offset_u,
                        center_v=center_v + offset_v,
                        radius_u=child_ru,
                        radius_v=child_rv,
                        depth_and_proof=child_depth.to[u16]()
                            | (inherited_torus_positive_class.to[u16]() << 8),
                        charge_weight=weight / 4,
                    ))
                    if standard_torus_event != 4294967295:
                        child_f00: f32 = 0.0
                        child_e00: f32 = 0.0
                        child_f10: f32 = 0.0
                        child_e10: f32 = 0.0
                        child_f01: f32 = 0.0
                        child_e01: f32 = 0.0
                        if child == 0:
                            child_f00 = current_torus_f00
                            child_e00 = current_torus_e00
                            child_f10 = split_bottom[1]
                            child_e10 = split_bottom[2]
                            child_f01 = split_left[1]
                            child_e01 = split_left[2]
                        elif child == 1:
                            child_f00 = split_bottom[1]
                            child_e00 = split_bottom[2]
                            child_f10 = current_torus_f10
                            child_e10 = current_torus_e10
                            child_f01 = split_center[1]
                            child_e01 = split_center[2]
                        elif child == 2:
                            child_f00 = split_left[1]
                            child_e00 = split_left[2]
                            child_f10 = split_center[1]
                            child_e10 = split_center[2]
                            child_f01 = current_torus_f01
                            child_e01 = current_torus_e01
                        else:
                            child_f00 = split_center[1]
                            child_e00 = split_center[2]
                            child_f10 = split_right[1]
                            child_e10 = split_right[2]
                            child_f01 = split_top[1]
                            child_e01 = split_top[2]
                        cell_torus_f00[destination] = child_f00
                        cell_torus_e00[destination] = child_e00
                        cell_torus_f10[destination] = child_f10
                        cell_torus_e10[destination] = child_e10
                        cell_torus_f01[destination] = child_f01
                        cell_torus_e01[destination] = child_e01
                    child = child + 1
            elif cell_known and line_torus:
                positive_side = false
                positive_side_known = false
                negative_side = false
                negative_side_known = false
                if line_standard_positive_known:
                    positive_side = line_standard_positive_hit
                    positive_side_known = true
                elif line_has_positive:
                    if torus_standalone and line_standard_torus:
                        fast_point = __wrela_pixels_p7_standard_torus_positive_hit(
                            line_positive_u, line_positive_v, torus_eye,
                        )
                        if fast_point[0] == 1:
                            positive_side = fast_point[1] == 1
                            positive_side_known = true
                    if not positive_side_known:
                        point = __wrela_pixels_p7_point_union_occupancy(
                            renderer, worker, x, y,
                            line_positive_u, line_positive_v,
                            candidates, snapshot,
                        )
                        if point[0] != 1:
                            return [0; 4]
                        positive_side = point[2] == 1
                        positive_side_known = true
                if torus_standalone and line_standard_torus:
                    # For a real quartic, D < 0 means exactly two real roots.
                    # The standalone preflight proves both roots lie inside the
                    # sealed q interval and that CSG accepts the feature, so the
                    # negative side is occupied even when every sampled corner
                    # lies within the curve residual.
                    negative_side = true
                    negative_side_known = true
                elif line_has_negative:
                    point = __wrela_pixels_p7_point_union_occupancy(
                        renderer, worker, x, y,
                        line_negative_u, line_negative_v,
                        candidates, snapshot,
                    )
                    if point[0] != 1:
                        return [0; 4]
                    negative_side = point[2] == 1
                    negative_side_known = true
                # An unresolved side contributes nothing to the lower bound and
                # its whole area to the upper bound.
                side_lower: u64 = 0
                side_upper: u64 = 0
                if positive_side_known:
                    if positive_side:
                        side_lower = side_lower + cell_lower
                        side_upper = side_upper + cell_upper
                else:
                    side_upper = side_upper + cell_upper
                if negative_side_known:
                    if negative_side:
                        side_lower = side_lower + 512 - cell_upper
                        side_upper = side_upper + 512 - cell_lower
                else:
                    side_upper = side_upper + 512 - cell_lower
                if side_upper > 512:
                    side_upper = 512
                lower_area_units = lower_area_units + side_lower * weight
                upper_area_units = upper_area_units + side_upper * weight
            elif cell_known:
                lower_area_units = lower_area_units + cell_lower * weight
                upper_area_units = upper_area_units + cell_upper * weight
            else:
                upper_area_units = upper_area_units + 512 * weight
    denominator: u64 = 512
    denominator_depth: u8 = 0
    @budget(bound=12)
    while denominator_depth < 12:
        denominator = denominator * 4
        denominator_depth = denominator_depth + 1
    coverage_lo = (
        lower_area_units * 255 + denominator / 2
    ) / denominator
    coverage_hi = (
        upper_area_units * 255 + denominator / 2
    ) / denominator
    if coverage_lo != coverage_hi:
        return [0; 4]
    owner: i64 = 0
    if owner_event >= 0:
        owner = __wrela_pixels_p7_event_owner(renderer, owner_event.to[u32]())
    return [1, 1, coverage_lo.to[i64](), owner]

fn __wrela_pixels_p7_union_silhouette_coverage(
    renderer: usize,
    worker: u32,
    tile: u32,
    x: u32,
    y: u32,
    read candidates: P7RowCandidates,
    read center_sample: P7VisibilitySample,
    read snapshot: FrameInputSnapshot,
) -> [i64; 4]:
    # Precision ladder: every pass computes an independently sound enclosure.
    # Most pixels pin with the coarse pass; only a shrinking boundary set pays
    # for tighter subdivision. A declined pass contributes no display value.
    result = __wrela_pixels_p7_union_silhouette_coverage_at_slack(
        renderer, worker.to[u64]() | (tile.to[u64]() << 32),
        x, y, candidates, center_sample, snapshot,
        1048576,
    )
    if result[0] == 1:
        return result
    result = __wrela_pixels_p7_union_silhouette_coverage_at_slack(
        renderer, worker.to[u64]() | (tile.to[u64]() << 32),
        x, y, candidates, center_sample, snapshot,
        64000,
    )
    if result[0] == 1:
        return result
    return __wrela_pixels_p7_union_silhouette_coverage_at_slack(
        renderer, worker.to[u64]() | (tile.to[u64]() << 32),
        x, y, candidates, center_sample, snapshot,
        4000,
    )

# Conservative *miss* proof for a bounded-displacement silhouette.
#
# The displaced silhouette has no closed form this tier can integrate, and the
# event's `predictor` polynomial is the undisplaced primitive, not the curve —
# emitting it as the curve would silently misplace the boundary. This answers
# only the one-sided question "is this pixel provably free of that silhouette",
# and every unproven case answers `false`, which is exactly today's behaviour.
#
# The sealed model supplies `B` and `B_T` for a sphere carrying one bounded
# displacement (see `pixels::glue::deformation_sphere_miss_model`). Writing the
# feature's ray quadratic as `H(t) = a t^2 + b t + c` — which is the predictor's
# q-coefficients read in order, because the predictor is `q^2 H(1/q)` — with
# `D = b^2 - 4 a c` and `a = |ray direction|^2 > 0`:
#
#   * `D + 4 a B < 0` puts the whole ray strictly outside the displaced
#     surface: `min_t H = -D / (4a) > B`, and every surface point obeys
#     `|H| <= B`.
#   * `D - 4 a B_T > 0` rules out a tangency anywhere on the ray line, outer or
#     self-occluding: at a tangency `|dH/dt| <= 2 (r + A) G |w|`, while on
#     `|H| <= B` the quadratic forces `(dH/dt)^2 >= D - 4 a B`.
#
# Both are evaluated as certified enclosures over the whole pixel cell, using
# the sealed global uv-Lipschitz bounds for the coefficients plus the sealed
# f32 evaluation allowance, so a proof covers every ray through the pixel.
# Outward-rounded enclosure of `sin` over `[lo, hi]`.
#
# Endpoints plus every extremum `pi/2 + k pi` inside the range: that is the
# complete candidate set for a sine's extrema on an interval, so the hull of
# their values encloses it. A range at least a full period wide is `[-1, 1]`
# outright. The pad is applied outward, so the result is only ever wider than
# the truth, which is the direction that keeps every caller sound.
fn __wrela_pixels_p7_interval_sin(lo: f32, hi: f32) -> [f32; 2]:
    if not (hi >= lo):
        return [-1.0, 1.0]
    if not __wrela_pixels_p5_finite(lo) or not __wrela_pixels_p5_finite(hi):
        return [-1.0, 1.0]
    two_pi: f32 = 6.2831854820251465
    if hi - lo >= two_pi:
        return [-1.0, 1.0]
    at_lo = sin_scalar(lo)
    at_hi = sin_scalar(hi)
    low = at_lo
    high = at_lo
    if at_hi < low:
        low = at_hi
    if at_hi > high:
        high = at_hi
    half_pi: f32 = 1.5707963705062866
    pi: f32 = 3.1415927410125732
    # Start below the first candidate at or under `lo` and walk past `hi`; a
    # window under one period holds at most two extrema, so six steps covers it.
    index = ((lo - half_pi) / pi).to[i32]() - 2
    step: i32 = 0
    @budget(bound=8)
    while step < 6:
        candidate = half_pi + index.to[f32]() * pi
        if candidate >= lo and candidate <= hi:
            value = sin_scalar(candidate)
            if value < low:
                low = value
            if value > high:
                high = value
        index = index + 1
        step = step + 1
    # Range reduction and the odd degree-11 polynomial use fewer than 32
    # dependent rounded binary32 operations. This is the next f32 above
    # gamma_40, leaving eight operations of headroom without a fixed 1/8192
    # geometric skin that adaptive coverage can never refine.
    pad: f32 = 0.0000023841917027311865
    low = low - pad
    high = high + pad
    if low < -1.0:
        low = -1.0
    if high > 1.0:
        high = 1.0
    return [low, high]

# Prove a bounded-displacement silhouette misses one complete screen cell.
# Screen subdivision belongs to the caller's arrangement ladder; this helper
# answers only the certified per-cell question and otherwise declines.

pub fn __wrela_pixels_p7_deformation_silhouette_misses(
    renderer: usize,
    event: u32,
    u0: f32,
    v0: f32,
    u1: f32,
    v1: f32,
    read params: [f32; 16],
    read camera: [f32; 12],
) -> bool:
    return __wrela_pixels_p7_deformation_misses_cell(
        renderer, event, u0, v0, u1, v1, params, camera,
    )

# Bit 31 of `event` selects which of the two sealed proofs may conclude (the
# packing keeps the call at the 8-argument codegen limit): with it set, only
# the exterior test — no ray point lies on the displaced surface, an absence —
# may answer, while the transversal test proves only that no tangency exists
# and the surface may still be crossed. A caller asking "is the surface
# absent?" must not accept the transversal answer. Event ids are sealed table
# indices far below the bit, so the packing is unambiguous.
pub fn __wrela_pixels_p7_deformation_polynomial(
    renderer: usize,
    event: u32,
    u: f32,
    v: f32,
    read params: [f32; 16],
    read camera: [f32; 12],
) -> [f32; 8]:
    model = __wrela_pixels_p7_deformation_miss_model(renderer, event)
    if model[0] != 1.0 or model[1] < 0.0 or model[1] > 4294967295.0:
        return [0.0; 8]
    if model[21] == 1.0:
        ex = camera[0] - model[22]
        ey = camera[1] - model[23]
        ez = camera[2] - model[24]
        dx = camera[3] + u * camera[6] + v * camera[9]
        dy = camera[4] + u * camera[7] + v * camera[10]
        dz = camera[5] + u * camera[8] + v * camera[11]
        ax = dx * dx
        ay = dy * dy
        az = dz * dz
        bx = dx * ex
        by = dy * ey
        bz = dz * ez
        cx = ex * ex
        cy = ey * ey
        cz = ez * ez
        rr = model[18] * model[18]
        a = ax + ay + az
        b = 2.0 * (bx + by + bz)
        c = cx + cy + cz - rr
        # No coefficient dependency path has more than seven rounded binary32
        # operations from exact stored inputs. This scale is the next f32
        # above gamma_8 = 8u/(1-8u), so multiplying the local magnitude sum is
        # an outward standard forward-error bound. A zero expression is
        # computed exactly from zero products, so no unrelated absolute floor
        # belongs here; such a floor would leave a fixed subpixel skin.
        error_scale: f32 = 0.0000004768376129504759
        a_error = (
            __wrela_pixels_p7_abs(ax) + __wrela_pixels_p7_abs(ay)
            + __wrela_pixels_p7_abs(az)
        ) * error_scale
        b_error = 2.0 * (
            __wrela_pixels_p7_abs(bx) + __wrela_pixels_p7_abs(by)
            + __wrela_pixels_p7_abs(bz)
        ) * error_scale
        c_error = (
            __wrela_pixels_p7_abs(cx) + __wrela_pixels_p7_abs(cy)
            + __wrela_pixels_p7_abs(cz) + __wrela_pixels_p7_abs(rr)
        ) * error_scale
        if not __wrela_pixels_p5_finite(a) or not __wrela_pixels_p5_finite(b):
            return [0.0; 8]
        if not __wrela_pixels_p5_finite(c) or not a_error >= 0.0:
            return [0.0; 8]
        return [1.0, 2.0, a, b, c, a_error, b_error, c_error]
    polynomial = __wrela_pixels_p7_feature_polynomial(
        renderer, model[1].to[u32](), u, v, params, camera,
    )
    if polynomial[0] != 1.0 or polynomial[1] != 2.0:
        return [0.0; 8]
    return [
        1.0, 2.0, polynomial[2], polynomial[3], polynomial[4],
        model[4], model[5], model[6],
    ]

fn __wrela_pixels_p7_deformation_misses_cell(
    renderer: usize,
    event: u32,
    u0: f32,
    v0: f32,
    u1: f32,
    v1: f32,
    read params: [f32; 16],
    read camera: [f32; 12],
) -> bool:
    exterior_only = event & 2147483648 != 0
    event_id = event & 2147483647
    model = __wrela_pixels_p7_deformation_miss_model(renderer, event_id)
    if model[0] != 1.0:
        return false
    if model[1] < 0.0 or model[1] > 4294967295.0:
        return false
    feature = model[1].to[u32]()
    band = model[2]
    band_t = model[3]
    if band < 0.0 or band_t < 0.0 or model[7] < 0.0:
        return false
    p00 = __wrela_pixels_p7_deformation_polynomial(renderer, event_id, u0, v0, params, camera)
    p10 = __wrela_pixels_p7_deformation_polynomial(renderer, event_id, u1, v0, params, camera)
    p01 = __wrela_pixels_p7_deformation_polynomial(renderer, event_id, u0, v1, params, camera)
    p11 = __wrela_pixels_p7_deformation_polynomial(renderer, event_id, u1, v1, params, camera)
    if p00[0] != 1.0 or p10[0] != 1.0 or p01[0] != 1.0 or p11[0] != 1.0:
        return false
    # The sealed model is derived only for a degree-two ray quadratic; any
    # other degree means the coefficient reading below is not the one the
    # proof was written against.
    if p00[1] != 2.0 or p10[1] != 2.0 or p01[1] != 2.0 or p11[1] != 2.0:
        return false
    width_u = __wrela_pixels_p7_abs(u1 - u0)
    width_v = __wrela_pixels_p7_abs(v1 - v0)
    # Every summand below is non-negative, so the f32 additions can only round
    # an enclosure radius down, by a few ulps. Widening by 1.0001 is orders of
    # magnitude more than that, and a wider enclosure only weakens the test.
    widen: f32 = 1.0001
    lower: [f32; 3] = [0.0; 3]
    upper: [f32; 3] = [0.0; 3]
    index: usize = 0
    @budget(bound=3)
    while index < 3:
        f00 = p00[index + 2]
        f10 = p10[index + 2]
        f01 = p01[index + 2]
        f11 = p11[index + 2]
        low = f00
        high = f00
        if f10 < low:
            low = f10
        if f01 < low:
            low = f01
        if f11 < low:
            low = f11
        if f10 > high:
            high = f10
        if f01 > high:
            high = f01
        if f11 > high:
            high = f11
        coefficient_error = p00[index + 5]
        if p10[index + 5] > coefficient_error:
            coefficient_error = p10[index + 5]
        if p01[index + 5] > coefficient_error:
            coefficient_error = p01[index + 5]
        if p11[index + 5] > coefficient_error:
            coefficient_error = p11[index + 5]
        residual = (
            model[index * 3 + 8] * width_u * width_u * 0.125
            + model[index * 3 + 9] * width_u * width_v
            + model[index * 3 + 10] * width_v * width_v * 0.125
            + coefficient_error
        ) * widen
        if not residual >= 0.0:
            return false
        lower[index] = low - residual
        upper[index] = high + residual
        index = index + 1
    a_lo = lower[0]
    a_hi = upper[0]
    b_lo = lower[1]
    b_hi = upper[1]
    c_lo = lower[2]
    c_hi = upper[2]
    # `a` is the squared length of the ray direction, so it is positive by
    # construction; an enclosure that cannot show that is degenerate input.
    if not a_lo > 0.0:
        return false
    if not __wrela_pixels_p5_finite(a_hi) or not __wrela_pixels_p5_finite(b_hi):
        return false
    if not __wrela_pixels_p5_finite(b_lo) or not __wrela_pixels_p5_finite(c_hi):
        return false
    if not __wrela_pixels_p5_finite(c_lo):
        return false
    square_lo = b_lo * b_lo
    square_hi = b_hi * b_hi
    if b_lo >= 0.0:
        square_lo = b_lo * b_lo
        square_hi = b_hi * b_hi
    elif b_hi <= 0.0:
        square_lo = b_hi * b_hi
        square_hi = b_lo * b_lo
    else:
        square_lo = 0.0
        square_hi = b_lo * b_lo
        if b_hi * b_hi > square_hi:
            square_hi = b_hi * b_hi
    product_lo = a_lo * c_lo
    product_hi = product_lo
    corner: u8 = 1
    @budget(bound=4)
    while corner < 4:
        left = a_lo
        if corner % 2 == 1:
            left = a_hi
        right = c_lo
        if corner >= 2:
            right = c_hi
        candidate = left * right
        if candidate < product_lo:
            product_lo = candidate
        if candidate > product_hi:
            product_hi = candidate
        corner = corner + 1
    discriminant_lo = square_lo - 4.0 * product_hi
    discriminant_hi = square_hi - 4.0 * product_lo
    # One slack term covers every f32 rounding in the handful of operations
    # above: the sealed magnitude bounds the largest intermediate over the
    # whole domain, and this scale is a power of two far above the accumulated
    # relative error, so applying it is exact and strictly weakening.
    #
    # Localizing this to the cell's own coefficient hulls was measured and
    # changed nothing (`frame_phantom` stayed at 12), so the domain bound is
    # not what blocks the remaining pixels; it is left alone.
    slack_scale: f32 = 0.0000152587890625
    slack = model[7] * slack_scale
    if not __wrela_pixels_p5_finite(discriminant_lo):
        return false
    if not __wrela_pixels_p5_finite(discriminant_hi) or not __wrela_pixels_p5_finite(slack):
        return false
    if discriminant_hi + 4.0 * a_hi * band + slack < 0.0:
        return true
    if not exterior_only and discriminant_lo - 4.0 * a_hi * band_t - slack > 0.0:
        return true
    # Localize the amplitude before giving up.
    #
    # `band` is built from `A`, the displacement amplitude anywhere on the
    # feature. Near a silhouette that is hopelessly pessimistic: a ray clearing
    # a radius-1 sphere by 0.007 cannot be excluded by a wave 0.125 tall
    # *somewhere*, even when the wave at this spot points inward. Since the
    # displacement is `A sin(f x + phase)` in world `x`, evaluating the sine
    # over the `x` range this cell can actually reach gives a local amplitude,
    # and `B = A (2r + A)` rebuilt from it can be far smaller.
    #
    # Window and amplitude are mutually dependent — a smaller band admits a
    # shorter stretch of ray, which admits a narrower sine range — so this
    # iterates. Each round starts from the previous, larger band, whose window
    # is a superset of the true one; that is what keeps it from being circular.
    # A round that fails to shrink stops the loop, and no round can widen the
    # band, so the worst case is exactly the verdict above.
    frequency = model[19]
    phase_slot = model[20]
    if frequency == 0.0 or phase_slot < 0.0 or phase_slot > 15.0:
        return false
    amplitude = model[17]
    if model[21] == 1.0 and model[25] > 0.0:
        amplitude = model[25]
    radius = model[18]
    if not amplitude > 0.0 or not radius > 0.0:
        return false
    phase = params[phase_slot.to[usize]()]
    if not __wrela_pixels_p5_finite(phase):
        return false
    aligned_direct = (
        model[21] == 1.0
        and camera[0] == model[22] and camera[1] == model[23]
        and camera[3] == 0.0 and camera[4] == 0.0 and camera[5] == 1.0
        and camera[6] == 1.0 and camera[7] == 0.0 and camera[8] == 0.0
        and camera[9] == 0.0 and camera[10] == 1.0 and camera[11] == 0.0
    )
    if aligned_direct and width_u <= 0.00002 and width_v <= 0.00002:
        # On the authored surface, distance = r - d and |d| <= A, hence the
        # canonical ray's z coordinate must lie within r+A of the centre.
        # This is a complete possible-root window independent of the looser
        # quadratic coefficient box used by the generic proof below.
        direct_z = model[24] - camera[2]
        direct_extent = radius + amplitude
        direct_t_lo = direct_z - direct_extent
        if direct_t_lo < 0.0:
            direct_t_lo = 0.0
        direct_t_hi = direct_z + direct_extent
        if __wrela_pixels_p7_aligned_deformation_depth_miss(
            [u0, v0, u1, v1], direct_t_lo, direct_t_hi, phase, model, camera,
        ):
            return true
    # Rate of world x along the ray, hulled over the whole uv cell:
    # dir.x = forward.x + u right.x + v up.x.
    rate_lo = camera[3] + u0 * camera[6] + v0 * camera[9]
    rate_hi = rate_lo
    corner_index: u8 = 1
    @budget(bound=4)
    while corner_index < 4:
        corner_u = u0
        if corner_index % 2 == 1:
            corner_u = u1
        corner_v = v0
        if corner_index >= 2:
            corner_v = v1
        corner_rate = camera[3] + corner_u * camera[6] + corner_v * camera[9]
        if corner_rate < rate_lo:
            rate_lo = corner_rate
        if corner_rate > rate_hi:
            rate_hi = corner_rate
        corner_index = corner_index + 1
    local_band = band
    round_index: u8 = 0
    @budget(bound=18)
    while round_index < 16:
        # Closest approach, and the half-width of the stretch where the base
        # quadratic stays inside the current band. `a_lo > 0` is guarded above.
        #
        # `min H = -D / (4a)`, and its infimum over the coefficient box divides
        # by `a_lo` only while `D_hi` is positive; once `D_hi` goes negative the
        # quotient is positive and the smallest denominator gives the *largest*
        # value, so the infimum is at `a_hi`. Taking `a_lo` there would report a
        # closest approach further out than some ray in the cell achieves and
        # size the window short.
        minimum_denominator = a_lo
        if discriminant_hi <= 0.0:
            minimum_denominator = a_hi
        minimum_lo = 0.0 - discriminant_hi / (4.0 * minimum_denominator)
        excess = local_band - minimum_lo
        if not excess > 0.0:
            round_index = 16
            continue
        half_width = sqrt_scalar(excess / a_lo)
        centre_lo = 0.0 - b_hi / (2.0 * a_lo)
        centre_hi = 0.0 - b_lo / (2.0 * a_lo)
        if not __wrela_pixels_p5_finite(half_width):
            round_index = 16
            continue
        if not __wrela_pixels_p5_finite(centre_lo) or not __wrela_pixels_p5_finite(centre_hi):
            round_index = 16
            continue
        # A second miss proof avoids ranging sine across the whole possible-
        # root window. Let t0 be a ray's closest base-sphere approach and
        # s=t-t0. Inside that window the radial distance has curvature at
        # least k, while Taylor's theorem gives
        #
        #   d(t) >= d(t0) + d'(t0)s - M s^2/2.
        #
        # Therefore the authored field is bounded below by a quadratic whose
        # minimum is F(t0)-|d'(t0)|^2/(2(k-M)). All inputs below are outward
        # cell hulls. Outside the window, H exceeds the already-sound
                # `local_band`, so a positive quadratic minimum proves the whole ray
        # root-free. Sign-indefinite b declines this optional proof.
        if model[21] == 1.0 and b_hi < 0.0:
            closest_lo = (0.0 - b_hi) / (2.0 * a_hi)
            closest_hi = (0.0 - b_lo) / (2.0 * a_lo)
            if closest_lo >= 0.0 and closest_hi >= closest_lo:
                closest_x_lo = camera[0] + rate_lo * closest_lo
                closest_x_hi = closest_x_lo
                closest_product: u8 = 1
                @budget(bound=4)
                while closest_product < 4:
                    closest_rate = rate_lo
                    if closest_product % 2 == 1:
                        closest_rate = rate_hi
                    closest_t = closest_lo
                    if closest_product >= 2:
                        closest_t = closest_hi
                    closest_x = camera[0] + closest_rate * closest_t
                    if closest_x < closest_x_lo:
                        closest_x_lo = closest_x
                    if closest_x > closest_x_hi:
                        closest_x_hi = closest_x
                    closest_product = closest_product + 1
                proof_a_lo = a_lo
                proof_rho_squared_lo = radius * radius + minimum_lo
                # For an axis-aligned canonical camera looking through a
                # sphere centre on its z axis, retain the exact correlation
                # discarded by a generic (a,b,c) coefficient box:
                # rho0^2 = z^2 s/(1+s), s=u^2+v^2, and
                # x(t0)=cx+u z/(1+s). The strict guards make this an optional
                # specialization; every other camera keeps the enclosure
                # above. Each formula has at most six dependent rounded
                # operations; upward gamma_8 pads leave two operations of
                # headroom.
                aligned = (
                    camera[0] == model[22] and camera[1] == model[23]
                    and camera[3] == 0.0 and camera[4] == 0.0 and camera[5] == 1.0
                    and camera[6] == 1.0 and camera[7] == 0.0 and camera[8] == 0.0
                    and camera[9] == 0.0 and camera[10] == 1.0 and camera[11] == 0.0
                    and __wrela_pixels_p7_abs(u0) < 1.0
                    and __wrela_pixels_p7_abs(u1) < 1.0
                )
                if aligned:
                    u_abs_min = __wrela_pixels_p7_abs(u0)
                    if __wrela_pixels_p7_abs(u1) < u_abs_min:
                        u_abs_min = __wrela_pixels_p7_abs(u1)
                    if u0 <= 0.0 and u1 >= 0.0:
                        u_abs_min = 0.0
                    v_abs_min = __wrela_pixels_p7_abs(v0)
                    if __wrela_pixels_p7_abs(v1) < v_abs_min:
                        v_abs_min = __wrela_pixels_p7_abs(v1)
                    if v0 <= 0.0 and v1 >= 0.0:
                        v_abs_min = 0.0
                    direct_s_lo = u_abs_min * u_abs_min + v_abs_min * v_abs_min
                    direct_z = model[24] - camera[2]
                    direct_z_squared = direct_z * direct_z
                    proof_a_lo = (1.0 + direct_s_lo) * 0.9999995231623870495241
                    proof_rho_squared_lo = (
                        direct_z_squared * direct_s_lo / (1.0 + direct_s_lo)
                    )
                    proof_rho_squared_lo = proof_rho_squared_lo - (
                        (__wrela_pixels_p7_abs(proof_rho_squared_lo) + direct_z_squared)
                        * 0.0000004768376129504759
                    )
                    direct_corner: u8 = 0
                    @budget(bound=4)
                    while direct_corner < 4:
                        direct_u = u0
                        if direct_corner % 2 == 1:
                            direct_u = u1
                        direct_v = v0
                        if direct_corner >= 2:
                            direct_v = v1
                        direct_s = direct_u * direct_u + direct_v * direct_v
                        direct_x = model[22] + direct_u * direct_z / (1.0 + direct_s)
                        if direct_corner == 0 or direct_x < closest_x_lo:
                            closest_x_lo = direct_x
                        if direct_corner == 0 or direct_x > closest_x_hi:
                            closest_x_hi = direct_x
                        direct_corner = direct_corner + 1
                    direct_x_pad = (
                        __wrela_pixels_p7_abs(closest_x_lo)
                        + __wrela_pixels_p7_abs(closest_x_hi)
                        + __wrela_pixels_p7_abs(model[22])
                        + __wrela_pixels_p7_abs(direct_z)
                    ) * 0.0000004768376129504759
                    closest_x_lo = closest_x_lo - direct_x_pad
                    closest_x_hi = closest_x_hi + direct_x_pad
                closest_sine = __wrela_pixels_p7_interval_sin(
                    frequency * closest_x_lo + phase,
                    frequency * closest_x_hi + phase,
                )
                closest_cosine = __wrela_pixels_p7_interval_sin(
                    frequency * closest_x_lo + phase + 1.5707963705062866,
                    frequency * closest_x_hi + phase + 1.5707963705062866,
                )
                closest_displacement_lo = amplitude * closest_sine[0]
                rate_abs = __wrela_pixels_p7_abs(rate_lo)
                if __wrela_pixels_p7_abs(rate_hi) > rate_abs:
                    rate_abs = __wrela_pixels_p7_abs(rate_hi)
                cosine_abs = __wrela_pixels_p7_abs(closest_cosine[0])
                if __wrela_pixels_p7_abs(closest_cosine[1]) > cosine_abs:
                    cosine_abs = __wrela_pixels_p7_abs(closest_cosine[1])
                slope = amplitude * __wrela_pixels_p7_abs(frequency) * rate_abs * cosine_abs
                second = (
                    amplitude * frequency * frequency * rate_abs * rate_abs
                )
                slope = slope * 1.000003814697265625
                second = second * 1.000003814697265625
                rho_squared_lo = proof_rho_squared_lo
                distance_squared_hi = radius * radius + local_band
                if rho_squared_lo > 0.0 and distance_squared_hi > 0.0:
                    distance_hi = sqrt_scalar(distance_squared_hi)
                    curvature = (
                        proof_a_lo * rho_squared_lo
                        / (distance_squared_hi * distance_hi)
                    ) * 0.999996185302734375
                    radial_lo = sqrt_scalar(rho_squared_lo)
                    field_lo = radial_lo - radius + closest_displacement_lo
                    correction: f32 = 0.0
                    if curvature > second:
                        correction = slope * slope / (2.0 * (curvature - second))
                        field_lo = field_lo - correction
                    field_magnitude = (
                        __wrela_pixels_p7_abs(radial_lo) + radius
                        + __wrela_pixels_p7_abs(closest_displacement_lo)
                        + correction
                    )
                    # Inputs above are already outward enclosures. Fewer than
                    # twenty further rounded operations feed this comparison;
                    # this is the next f32 above gamma_24.
                    field_slack = field_magnitude * 0.0000014305136346592917
                    if curvature > second and field_lo - field_slack > 0.0:
                        return true
        t_lo = centre_lo - half_width
        t_hi = centre_hi + half_width
        if t_lo < 0.0:
            t_lo = 0.0
        # World-x hull of the ray over that stretch, then the sine argument.
        x_lo = camera[0] + rate_lo * t_lo
        x_hi = x_lo
        product_index: u8 = 1
        @budget(bound=4)
        while product_index < 4:
            product_rate = rate_lo
            if product_index % 2 == 1:
                product_rate = rate_hi
            product_t = t_lo
            if product_index >= 2:
                product_t = t_hi
            product = camera[0] + product_rate * product_t
            if product < x_lo:
                x_lo = product
            if product > x_hi:
                x_hi = product
            product_index = product_index + 1
        sine = __wrela_pixels_p7_interval_sin(
            frequency * x_lo + phase, frequency * x_hi + phase,
        )
        # `sinusoidal_displace` adds `d` to the *field*, so the surface solves
        # `|p - c| - r + d = 0` and sits at radius `r - d`: positive `d` pulls
        # it inward. Hence `H = (r - d)^2 - r^2 = -d (2r - d)`, which is
        # strictly decreasing in `d` for `d < r`, and the furthest out the
        # surface gets over this window is at the *smallest* `d`.
        #
        # So the exterior test wants the signed bound `-d_lo (2r - d_lo)`, and
        # the sine's lower end is what carries it — not `|d|` and not the upper
        # end. That distinction is the whole point of localizing: where the
        # wave runs positive across the window the surface is pulled in to
        # ~0.875 while the ray passes at 1.007, the band goes negative, and the
        # miss falls straight out. A magnitude bound throws the sign away and
        # can never see it. At the symmetric extreme `sin in [-1, 1]` this
        # reproduces the sealed `A (2r + A)` exactly, so the localization can
        # only ever tighten the sealed band, never contradict it.
        displacement_lo = amplitude * sine[0]
        signed_band = 0.0 - displacement_lo * (2.0 * radius - displacement_lo)
        # The test below is monotone increasing in `signed_band`, so rounding
        # it *up* is the weakening direction. The expression uses fewer than
        # 32 binary32 operations, so a 32-epsilon relative nudge encloses it
        # without leaving a non-refinable 1e-4 silhouette skin.
        if signed_band >= 0.0:
            signed_band = signed_band * 1.000003814697265625
        else:
            signed_band = signed_band * 0.999996185302734375
        if not __wrela_pixels_p5_finite(signed_band):
            round_index = 16
            continue
        # `sup (D + 4 a B)` over the coefficient box takes `a`'s upper end only
        # when `B >= 0`; with `B` negative — the case this whole loop exists to
        # reach — the supremum is at `a_lo`, and using `a_hi` there would make
        # the product more negative than any real ray can justify.
        band_a = a_hi
        if signed_band < 0.0:
            band_a = a_lo
        # The coefficient construction above already includes its sealed
        # approximation errors. Bound only the arithmetic performed by this
        # localized expression from the magnitudes of its actual terms. The
        # expression has seven rounded operations; the scale below is the
        # next f32 above gamma_16 and therefore also covers construction of
        # this local magnitude with more than a twofold operation margin.
        # Adding it is the weakening direction.
        product_magnitude = __wrela_pixels_p7_abs(product_lo)
        if __wrela_pixels_p7_abs(product_hi) > product_magnitude:
            product_magnitude = __wrela_pixels_p7_abs(product_hi)
        localized_magnitude = (
            __wrela_pixels_p7_abs(square_hi)
            + 4.0 * product_magnitude
            + 4.0 * band_a * __wrela_pixels_p7_abs(signed_band)
        )
        localized_slack = localized_magnitude * 0.0000009536753395877895
        if discriminant_hi + 4.0 * band_a * signed_band + localized_slack < 0.0:
            return true
        # Localizing the *tangency* proof alongside this one was measured and
        # proves nothing extra: its sealed `(r + A)^2 G^2` term does not
        # localize, and on this scene it alone already exceeds what a grazing
        # ray's discriminant can clear, so wherever it could fire the exterior
        # test above has fired first. It is left out rather than carried as
        # unreachable code in a soundness-critical walk.
        # The window is exactly the stretch the surface could be reached on:
        # every surface point over this window has `H <= -d_lo (2r - d_lo)`, so
        # a ray can only meet it where `H(t)` is at most that. Sizing the next
        # window with that signed bound rather than the symmetric one is what
        # makes the iteration contract, and it stays sound because the bound is
        # a true supremum of `H` over the window it was measured on: the next
        # window is a subset, so re-measuring there can only lower it again.
        # `sine[1]` takes no part — the wave's inward half moves the surface
        # away from the ray, which the supremum at `d_lo` already covers.
        contracts = signed_band < local_band
        if not contracts:
            round_index = 16
            continue
        local_band = signed_band
        round_index = round_index + 1
    return false

# Prove every ray in one cell crosses the authored sinusoidally displaced
# sphere. A common depth is enough: if all rays are inside the surface there
# and the sealed far seed is outside, continuity supplies a root for each ray.
# At fixed positive depth the sphere quadratic is convex in (u,v), so its
# maximum over the cell is attained at a corner.
pub fn __wrela_pixels_p7_deformation_hits_cell(
    renderer: usize,
    event: u32,
    u0: f32,
    v0: f32,
    u1: f32,
    v1: f32,
    read params: [f32; 16],
    read camera: [f32; 12],
) -> bool:
    model = __wrela_pixels_p7_deformation_miss_model(renderer, event)
    if model[0] != 1.0 or model[1] < 0.0 or model[1] > 4294967295.0:
        return false
    amplitude = model[25]
    if model[21] != 1.0 or not amplitude > 0.0 or not model[18] > amplitude:
        return false
    if model[19] == 0.0 or model[20] < 0.0 or model[20] > 15.0:
        return false
    phase = params[model[20].to[usize]()]
    if not __wrela_pixels_p5_finite(phase):
        return false
    center_u = (u0 + u1) * 0.5
    center_v = (v0 + v1) * 0.5
    aligned = (
        camera[0] == model[22] and camera[1] == model[23]
        and camera[3] == 0.0 and camera[4] == 0.0 and camera[5] == 1.0
        and camera[6] == 1.0 and camera[7] == 0.0 and camera[8] == 0.0
        and camera[9] == 0.0 and camera[10] == 1.0 and camera[11] == 0.0
        and __wrela_pixels_p7_abs(u0) < 1.0
        and __wrela_pixels_p7_abs(u1) < 1.0
    )
    depth: f32 = 0.0
    if aligned:
        center_s = center_u * center_u + center_v * center_v
        direct_z = model[24] - camera[2]
        depth = direct_z / (1.0 + center_s)
        newton: u8 = 0
        @budget(bound=2)
        while newton < 2:
            center_x = center_u * depth
            center_y = center_v * depth
            center_z = depth - direct_z
            center_rho_squared = (
                center_x * center_x + center_y * center_y + center_z * center_z
            )
            if not center_rho_squared > 0.0:
                newton = 2
                continue
            center_rho = sqrt_scalar(center_rho_squared)
            argument = model[19] * (model[22] + center_x) + phase
            center_sine = sin_scalar(argument)
            center_cosine = sin_scalar(argument + 1.5707963705062866)
            radial_numerator = (1.0 + center_s) * depth - direct_z
            derivative = (
                radial_numerator / center_rho
                + amplitude * model[19] * center_u * center_cosine
            )
            hessian = (
                (1.0 + center_s) / center_rho
                - radial_numerator * radial_numerator
                    / (center_rho_squared * center_rho)
                - amplitude * model[19] * model[19]
                    * center_u * center_u * center_sine
            )
            if not hessian > 0.0 or not __wrela_pixels_p5_finite(hessian):
                newton = 2
                continue
            depth = depth - derivative / hessian
            newton = newton + 1
    else:
        center = __wrela_pixels_p7_deformation_polynomial(
            renderer, event, center_u, center_v, params, camera,
        )
        if center[0] != 1.0 or center[1] != 2.0 or not center[2] > 0.0:
            return false
        depth = (0.0 - center[3]) / (2.0 * center[2])
    if not depth > 0.0 or not __wrela_pixels_p5_finite(depth):
        return false

    h_hi: f32 = 0.0
    h_error: f32 = 0.0
    x_error: f32 = 0.0
    direct_distance_squared_hi: f32 = 0.0
    direct_distance_error: f32 = 0.0
    x_lo: f32 = 0.0
    x_hi: f32 = 0.0
    corner: u8 = 0
    @budget(bound=4)
    while corner < 4:
        u = u0
        if corner % 2 == 1:
            u = u1
        v = v0
        if corner >= 2:
            v = v1
        h: f32 = 0.0
        corner_error: f32 = 0.0
        x: f32 = 0.0
        corner_x_error: f32 = 0.0
        distance_squared: f32 = 0.0
        distance_error: f32 = 0.0
        if aligned:
            direct_z = model[24] - camera[2]
            point_x = u * depth
            point_y = v * depth
            point_z = depth - direct_z
            point_x_squared = point_x * point_x
            point_y_squared = point_y * point_y
            point_z_squared = point_z * point_z
            distance_squared = point_x_squared + point_y_squared + point_z_squared
            distance_error = (
                point_x_squared + point_y_squared + point_z_squared
            ) * 0.0000004768376129504759
            h = distance_squared - model[18] * model[18]
            corner_error = distance_error + (
                model[18] * model[18] * 0.0000004768376129504759
            )
            x = model[22] + u * depth
            corner_x_error = (
                __wrela_pixels_p7_abs(model[22])
                + __wrela_pixels_p7_abs(u * depth)
            ) * 0.0000004768376129504759
        else:
            polynomial = __wrela_pixels_p7_deformation_polynomial(
                renderer, event, u, v, params, camera,
            )
            if polynomial[0] != 1.0 or polynomial[1] != 2.0:
                return false
            h = polynomial[2] * depth * depth + polynomial[3] * depth + polynomial[4]
            corner_error = polynomial[5] * depth * depth + polynomial[6] * depth + polynomial[7]
            x = camera[0] + (camera[3] + u * camera[6] + v * camera[9]) * depth
        if not __wrela_pixels_p5_finite(h) or not __wrela_pixels_p5_finite(x):
            return false
        if corner == 0 or h > h_hi:
            h_hi = h
        if corner == 0 or corner_error > h_error:
            h_error = corner_error
        if corner == 0 or corner_x_error > x_error:
            x_error = corner_x_error
        if aligned and (corner == 0 or distance_squared > direct_distance_squared_hi):
            direct_distance_squared_hi = distance_squared
        if aligned and (corner == 0 or distance_error > direct_distance_error):
            direct_distance_error = distance_error
        if corner == 0 or x < x_lo:
            x_lo = x
        if corner == 0 or x > x_hi:
            x_hi = x
        corner = corner + 1
    if not h_error >= 0.0 or not __wrela_pixels_p5_finite(h_error):
        return false
    h_hi = h_hi + h_error
    x_lo = x_lo - x_error
    x_hi = x_hi + x_error
    if h_hi >= 0.0:
        h_hi = h_hi * 1.000003814697265625
    else:
        h_hi = h_hi * 0.999996185302734375

    sine = __wrela_pixels_p7_interval_sin(
        model[19] * x_lo + phase,
        model[19] * x_hi + phase,
    )
    displacement_hi = amplitude * sine[1]
    if aligned:
        distance_squared_hi = direct_distance_squared_hi + direct_distance_error
        if distance_squared_hi > 0.0:
            distance_hi = (
                sqrt_scalar(distance_squared_hi) * 1.000000476837385576751
            )
            direct_displacement_hi = displacement_hi + (
                __wrela_pixels_p7_abs(displacement_hi) + amplitude
            ) * 0.0000002384186360672588
            field_hi = distance_hi - model[18] + direct_displacement_hi
            field_magnitude = (
                __wrela_pixels_p7_abs(distance_hi) + model[18]
                + __wrela_pixels_p7_abs(direct_displacement_hi)
            )
            # The squared distance and x hulls already carry their own gamma
            # bounds. The explicit sqrt and displacement nudges above leave
            # only the final two additions, covered upward by gamma_4.
            field_slack = field_magnitude * 0.000000476837385576751
            if field_hi + field_slack < 0.0:
                return true
    band_lo = 0.0 - displacement_hi * (2.0 * model[18] - displacement_hi)
    if not __wrela_pixels_p5_finite(band_lo):
        return false
    if band_lo >= 0.0:
        band_lo = band_lo * 0.999996185302734375
    else:
        band_lo = band_lo * 1.000003814697265625
    return h_hi < band_lo

# Return the set of single-feature bounded-displacement objects whose sealed
# exterior proof covers one complete pixel/refinement cell. The projective root
# program for such an object is deliberately the undeformed predictor; callers
# remove only the named objects before running ordinary visibility. Keeping
# row candidates and frame snapshots out of this helper preserves their normal
# caller-local representation across source evaluation and emitted guest code.
pub fn __wrela_pixels_p7_deformation_veto_objects(
    renderer: usize,
    tile: u32,
    xy: u64,
    read filter: [f32; 4],
    read params: [f32; 16],
    read camera: [f32; 12],
) -> [u64; 4]:
    x = (xy & 4294967295).to[u32]()
    y = (xy >> 32).to[u32]()
    event_count = __wrela_pixels_tile_event_count(renderer, tile)
    if event_count == 4294967295 or event_count > 256:
        return [0; 4]
    u0 = filter[0] - filter[2]
    u1 = filter[0] + filter[2]
    v0 = filter[1] - filter[3]
    v1 = filter[1] + filter[3]
    if filter[2] < 0.0 or filter[3] < 0.0:
        return [0; 4]
    deformation_objects: u64 = 0
    veto_objects: u64 = 0
    hit_objects: u64 = 0
    ordinal: u32 = 0
    @budget(bound=256)
    while ordinal < event_count:
        event = __wrela_pixels_tile_event(renderer, tile, ordinal)
        ordinal = ordinal + 1
        if event[0] != 1 or event[1] > 4294967295:
            return [0; 4]
        event_id = event[1].to[u32]()
        span = __wrela_pixels_p7_event_pixel_span(renderer, event_id, x, y)
        if span[0] != 1:
            return [0; 4]
        if span[1] != 1:
            continue
        model = __wrela_pixels_p7_deformation_miss_model(renderer, event_id)
        if model[0] != 1.0 or model[1] < 0.0 or model[1] > 4294967295.0:
            continue
        feature = model[1].to[u32]()
        object = __wrela_pixels_program_operand(renderer, 4, feature, 0)
        if object[0] != 1 or object[1] >= 64:
            return [0; 4]
        # The proof names one feature. Removing its complete object is valid
        # only when that feature is the object's sole leaf.
        leaves = __wrela_pixels_program_operand(renderer, 3, object[1].to[u32](), 4)
        if leaves[0] != 1 or leaves[1] != 1:
            continue
        deformation_objects = deformation_objects | (1.to[u64]() << object[1])
        config = __wrela_pixels_p7_numeric_config(renderer)
        if config[0] != 1:
            return [0; 4]
        seed = __wrela_pixels_p7_initial_inside(
            renderer,
            filter[0],
            filter[1],
            __wrela_pixels_p7_raw_to_f32(
                config[5].to[i32](),
                config[3].to[i32](),
            ),
            params,
            camera,
        )
        if seed[0] != 1:
            return [0; 4]
        if (seed[1] >> object[1]) & 1 != 0:
            continue
        if __wrela_pixels_p7_deformation_silhouette_misses(
            renderer,
            event_id | 2147483648,
            u0,
            v0,
            u1,
            v1,
            params,
            camera,
        ):
            veto_objects = veto_objects | (1.to[u64]() << object[1])
        elif __wrela_pixels_p7_deformation_hits_cell(
            renderer, event_id, u0, v0, u1, v1, params, camera,
        ):
            hit_objects = hit_objects | (1.to[u64]() << object[1])
    return [1, deformation_objects, veto_objects, hit_objects]

# Exact enclosure of the area of `a*s + b*t + c >= 0` over the unit square, in
# 1048576ths: the same rational as `__wrela_pixels_p7_half_plane_byte`, floored
# and ceiled instead of rounded. The finer unit is what lets an area assembled
# from several sub-cells still pin a byte - a 512th of a whole pixel is already
# half a byte, so accumulating 512th-scale enclosures could never resolve one.
fn __wrela_pixels_p7_half_plane_units(a: i32, b: i32, c: i32) -> [i64; 3]:
    if a < -1000000 or a > 1000000 or b < -1000000 or b > 1000000 or c < -1000000 or c > 1000000:
        return [0, 0, 0]
    aa = a.to[i64]()
    bb = b.to[i64]()
    cc = c.to[i64]()
    if aa < 0:
        cc = cc + aa
        aa = -aa
    if bb < 0:
        cc = cc + bb
        bb = -bb
    threshold = -cc
    if threshold <= 0:
        return [1, 1048576, 1048576]
    if threshold >= aa + bb:
        return [1, 0, 0]
    numerator: i64 = 0
    denominator: i64 = 0
    if aa == 0:
        numerator = (bb - threshold) * 1048576
        denominator = bb
    elif bb == 0:
        numerator = (aa - threshold) * 1048576
        denominator = aa
    else:
        h0 = threshold * threshold
        h1: i64 = 0
        h2: i64 = 0
        if threshold > aa:
            h1 = (threshold - aa) * (threshold - aa)
        if threshold > bb:
            h2 = (threshold - bb) * (threshold - bb)
        denominator = 2 * aa * bb
        foreground = denominator - (h0 - h1 - h2)
        if foreground < 0:
            foreground = 0
        if foreground > denominator:
            foreground = denominator
        numerator = foreground * 1048576
    if not denominator > 0:
        return [0, 0, 0]
    quotient = numerator / denominator
    if numerator - quotient * denominator > 0:
        return [1, quotient, quotient + 1]
    return [1, quotient, quotient]

# Affine model of one validity-predicate eliminant curve over a pixel cell.
#
# See `__wrela_pixels_p7_event_predicate_curve` (generated): for a feature whose
# ray polynomial is affine in `q` — `R = A_f q + S_f(u,v)` — the closed-form
# root `q* = -S_f / A_f`
# substituted into a validity predicate `P = A_p q + S_p(u,v)` clears `q`:
#
#     P(q*) = (A_f S_p - A_p S_f) / A_f    so   sign P(q*) = sign(G) sign(A_f)
#
# with `G = A_f S_p - A_p S_f` a polynomial in `(u, v)` alone. The compiler
# orients `G` by the locally proved `sign(A_f)` and by the predicate's sense into a curve `C` whose
# non-negative side is exactly "this predicate holds", and seals a second
# witness `Q = -sign(A_f) S_f` whose positive side is exactly `q* > 0`. Both
# come with sealed second uv derivative bounds; for a constant `A_f` and affine
# `S_f`, `S_p` — every box face — those are identically zero, so the affine
# model below is exact.
#
# Returns `[ok, c00, c10, c01, curve residual, witness low, witness high]`,
# where the witness bounds already carry their own residual.
fn __wrela_pixels_p7_predicate_curve_cell(
    renderer: usize,
    event_id: u32,
    u0: f32,
    v0: f32,
    u1: f32,
    v1: f32,
    read snapshot: FrameInputSnapshot,
) -> [f32; 8]:
    d00 = __wrela_pixels_p7_event_predicate_curve(
        renderer, event_id, u0, v0, snapshot.params, snapshot.camera,
    )
    d10 = __wrela_pixels_p7_event_predicate_curve(
        renderer, event_id, u1, v0, snapshot.params, snapshot.camera,
    )
    d01 = __wrela_pixels_p7_event_predicate_curve(
        renderer, event_id, u0, v1, snapshot.params, snapshot.camera,
    )
    d11 = __wrela_pixels_p7_event_predicate_curve(
        renderer, event_id, u1, v1, snapshot.params, snapshot.camera,
    )
    if d00[0] != 1.0 or d10[0] != 1.0 or d01[0] != 1.0 or d11[0] != 1.0:
        return [0.0; 8]
    # A globally unsealed A_f is admitted only when it is affine in `(u,v)`.
    # Equal strict signs at all four corners therefore prove the same strict
    # sign throughout this cell; mixed signs or a zero corner decline.
    if (
        d00[17] != d10[17] or d00[17] != d01[17]
        or d00[17] != d11[17]
        or (d00[17] != 1.0 and d00[17] != -1.0)
    ):
        return [0.0; 8]
    du = __wrela_pixels_p7_abs(u1 - u0)
    dv = __wrela_pixels_p7_abs(v1 - v0)
    curve_residual = (
        d00[3] * du * du * 0.125 + d00[4] * du * dv + d00[5] * dv * dv * 0.125
    )
    witness_residual = (
        d00[6] * du * du * 0.125 + d00[7] * du * dv + d00[8] * dv * dv * 0.125
    )
    q00 = d00[2]
    q10 = d10[2]
    q01 = d01[2]
    q11 = d11[2]
    witness_min = q00
    witness_max = q00
    if q10 < witness_min:
        witness_min = q10
    if q01 < witness_min:
        witness_min = q01
    if q11 < witness_min:
        witness_min = q11
    if q10 > witness_max:
        witness_max = q10
    if q01 > witness_max:
        witness_max = q01
    if q11 > witness_max:
        witness_max = q11
    if (
        not __wrela_pixels_p5_finite(curve_residual)
        or not __wrela_pixels_p5_finite(witness_residual)
    ):
        return [0.0; 8]
    return [
        1.0,
        d00[1],
        d10[1],
        d01[1],
        curve_residual,
        witness_min - witness_residual,
        witness_max + witness_residual,
        0.0,
    ]

# Integrate a feature's validity region over a pixel cell in closed form.
#
# Returns `[status, byte]`:
#   0  declined - nothing was established, the caller keeps today's behaviour
#      and the pixel goes to the subpixel walk
#   1  this event bounds nothing inside the cell: either the feature's validity
#      holds over the whole cell, or the feature is provably absent there
#   2  integrated - `byte` is the pixel's coverage
#
# Three things have to hold before a predicate curve may be treated as an
# occupancy boundary, and each has its own gate here.
#
# 1. A single predicate is not an occupancy boundary. The feature is present
#    only where *every* one of its validity predicates holds, so what is
#    integrated is the intersection of all of them - the whole region
#    `C_1 >= 0 and ... and C_n >= 0` - and never one half plane on its own.
#    Reading a single predicate as the boundary would credit an entirely
#    invalid feature with a half plane of area, and would miss the corner
#    where two of a box face's own edges cross one pixel.
# 2. The tests are non-strict. The senses reduced here are `NonNegative` and
#    `NonPositive`, so `lower_bound >= 0` over the closed cell is the correct
#    test - and it has to be: a box's left face lands exactly on a pixel
#    boundary, where a strict test would decline the pixel it should own.
# 3. The root has to be a forward ray root. `q* > 0` is exactly `Q > 0`, and a
#    cell where the sealed witness is provably non-positive carries no root of
#    this feature at all.
#
# The occupied side is never assumed from the region's sign: it is measured at
# every cell corner. Every corner inside the region must see a hit whose
# certified q encloses this feature's own sealed root - so the feature is what
# the ray actually saw, not a face hiding behind the one that does bound the
# pixel - and every corner outside it must see a miss. Anything else is handed
# back to the walk rather than credited with an area it does not own.
fn __wrela_pixels_p7_predicate_region_coverage(
    renderer: usize,
    worker: u32,
    tile: u32,
    pixel: u32,
    event_id: u32,
    read cell_uv: [f32; 4],
    read candidates: P7RowCandidates,
    read snapshot: FrameInputSnapshot,
) -> [i64; 2]:
    x = pixel & 65535
    y = pixel >> 16
    u0 = cell_uv[0]
    v0 = cell_uv[1]
    u1 = cell_uv[2]
    v1 = cell_uv[3]
    descriptor = __wrela_pixels_p7_event_predicate_curve(
        renderer, event_id, u0, v0, snapshot.params, snapshot.camera,
    )
    if descriptor[0] != 1.0:
        return [0, 0]
    sibling_count = descriptor[9]
    if not sibling_count >= 0.0 or sibling_count > 6.0:
        return [0, 0]
    curve_count = sibling_count.to[i32]() + 1
    # Affine model of every validity curve of this feature over the cell, in the
    # cell's own `(s, t)` coordinates: `C(s, t) = base + a s + b t`, exact up to
    # the sealed second-derivative residual.
    curve_base: [f32; 8] = [0.0; 8]
    curve_a: [f32; 8] = [0.0; 8]
    curve_b: [f32; 8] = [0.0; 8]
    curve_residual: [f32; 8] = [0.0; 8]
    witness_low: f32 = 0.0
    witness_high: f32 = 0.0
    index: i32 = 0
    @budget(bound=8)
    while index < curve_count:
        curve_id = event_id
        if index > 0:
            slot = descriptor[(10 + index).to[usize]()]
            if not slot >= 0.0 or slot > 16777216.0:
                return [0, 0]
            curve_id = slot.to[u32]()
        cell = __wrela_pixels_p7_predicate_curve_cell(
            renderer, curve_id, u0, v0, u1, v1, snapshot,
        )
        if cell[0] != 1.0:
            return [0, 0]
        slot_index = index.to[usize]()
        curve_base[slot_index] = cell[1]
        curve_a[slot_index] = cell[2] - cell[1]
        curve_b[slot_index] = cell[3] - cell[1]
        curve_residual[slot_index] = cell[4]
        if index == 0:
            witness_low = cell[5]
            witness_high = cell[6]
        index = index + 1
    # Gate 3: the affine root has to sit at positive q across the whole cell.
    if witness_high <= 0.0:
        return [1, 0]
    if not witness_low > 0.0:
        return [0, 0]
    # Whole-cell classification. A provably violated predicate puts the feature
    # outside the cell entirely; all of them provably satisfied means the
    # feature covers the cell and no validity boundary crosses it.
    root_crossing: i32 = 0
    index = 0
    @budget(bound=8)
    while index < curve_count:
        slot_index = index.to[usize]()
        spread = (
            __wrela_pixels_p7_abs(curve_a[slot_index]) * 0.5
            + __wrela_pixels_p7_abs(curve_b[slot_index]) * 0.5
        )
        centre = (
            curve_base[slot_index]
            + curve_a[slot_index] * 0.5
            + curve_b[slot_index] * 0.5
        )
        if centre + spread < 0.0 - curve_residual[slot_index]:
            return [1, 0]
        if not centre - spread >= curve_residual[slot_index]:
            root_crossing = root_crossing + 1
        index = index + 1
    if root_crossing == 0:
        return [1, 0]
    area = __wrela_pixels_p7_predicate_region_area(
        curve_count, curve_base, curve_a, curve_b, curve_residual,
    )
    if area[0] != 1:
        return [0, 0]
    # Measure the occupied side at every cell corner, each pulled a quarter of
    # the way back toward the centre so a sample never lands on the cell's own
    # edge - where a neighbouring face seen exactly edge-on would make it an
    # event pixel. Corners inside the region must agree with each other, corners
    # outside it must agree with each other, and the two must differ.
    inside_known = false
    outside_known = false
    exponent = __wrela_pixels_p7_numeric_config(renderer)[3].to[i32]()
    corner: u8 = 0
    @budget(bound=4)
    while corner < 4:
        corner_s: f32 = 0.125
        corner_t: f32 = 0.125
        if corner & 1 == 1:
            corner_s = 0.875
        if corner & 2 == 2:
            corner_t = 0.875
        corner_inside = true
        corner_outside = false
        index = 0
        @budget(bound=8)
        while index < curve_count:
            slot_index = index.to[usize]()
            value = (
                curve_base[slot_index]
                + curve_a[slot_index] * corner_s
                + curve_b[slot_index] * corner_t
            )
            if value < 0.0 - curve_residual[slot_index]:
                corner_outside = true
            elif not value > curve_residual[slot_index]:
                corner_inside = false
            index = index + 1
        if corner_inside or corner_outside:
            corner_u = u0 + (u1 - u0) * corner_s
            corner_v = v0 + (v1 - v0) * corner_t
            corner_filter: [f32; 4] = [corner_u, corner_v, 0.0, 0.0]
            corner_sample = __wrela_pixels_p7_pixel_visibility_from_candidates(
                renderer=renderer,
                worker=worker,
                tile=tile,
                span=x | ((x + 1) << 16),
                y=y,
                filter=corner_filter,
                candidates=candidates,
                snapshot=snapshot,
            )
            if not corner_sample.ok or corner_sample.event:
                return [0, 0]
            if corner_outside:
                if corner_sample.hit:
                    return [0, 0]
                outside_known = true
            else:
                if not corner_sample.hit:
                    return [0, 0]
                # The region is this *feature's* validity, and a feature that is
                # valid here can still be hidden behind another one - the far
                # face of a box is valid over exactly the region the near face
                # covers. Its area is then not this pixel's coverage even though
                # occupancy does flip across it. So require that what the ray
                # actually saw is this feature's own root: the sealed q* has to
                # land inside the certified q enclosure of the visible sample.
                corner_descriptor = __wrela_pixels_p7_event_predicate_curve(
                    renderer,
                    event_id,
                    corner_u,
                    corner_v,
                    snapshot.params,
                    snapshot.camera,
                )
                if corner_descriptor[0] != 1.0:
                    return [0, 0]
                root_q = corner_descriptor[10]
                sample_lo = __wrela_pixels_p7_raw_to_f32(corner_sample.q_lo, exponent)
                sample_hi = __wrela_pixels_p7_raw_to_f32(corner_sample.q_hi, exponent)
                tolerance = __wrela_pixels_p7_abs(root_q) * 0.0009765625
                if root_q < sample_lo - tolerance or root_q > sample_hi + tolerance:
                    return [0, 0]
                inside_known = true
        corner = corner + 1
    if not inside_known or not outside_known:
        return [0, 0]
    return [2, area[1]]

# Coverage byte of the intersection of `count` affine half planes
# `base + a s + b t >= 0` with the unit square, as `[ok, byte]`.
#
# One crossing half plane is the closed form the tier already uses, evaluated
# as an exact rational so the byte is pinned outright rather than quantized to
# a 512th. Two or more crossing half planes make a corner, which no single half
# plane area expresses, so the square is refined: a sub-cell where some plane is
# provably violated contributes nothing, one where all are provably satisfied
# contributes its whole weight, one crossed by exactly one plane contributes
# that plane's enclosed area, and only sub-cells still holding a corner are
# split further. A corner occupies one sub-cell per level, so the refinement
# converges in a handful of levels and stops as soon as the accumulated bounds
# round to the same byte.
fn __wrela_pixels_p7_predicate_region_area(
    count: i32,
    read curve_base: [f32; 8],
    read curve_a: [f32; 8],
    read curve_b: [f32; 8],
    read curve_residual: [f32; 8],
) -> [i64; 2]:
    empty_subdivision_cell = RendererWorkerP8RSubdivisionCell(
        center_u=0.0, center_v=0.0, radius_u=0.0, radius_v=0.0,
        depth_and_proof=0, charge_weight=0,
    )
    subdivision_cells: [RendererWorkerP8RSubdivisionCell; 72] = [empty_subdivision_cell; 72]
    subdivision_cells[0] = RendererWorkerP8RSubdivisionCell(
        center_u=0.5, center_v=0.5, radius_u=0.5, radius_v=0.5,
        depth_and_proof=0, charge_weight=16777216,
    )
    stack = RendererWorkerP8RSubdivisionStack(
        cells=subdivision_cells, count=1, capacity=40,
        depth_limit=12, event_owner=4294967295, failure_code=0,
        visit_limit=200000,
    )
    lower_units: u64 = 0
    upper_units: u64 = 0
    accounted_units: u64 = 0
    processed: u32 = 0
    @budget(bound=16384)
    while stack.length() > 0:
        processed = processed + 1
        if processed > 8192:
            return [0, 0]
        cell = stack.pop()
        centre_s = cell.center_u
        centre_t = cell.center_v
        radius_s = cell.radius_u
        radius_t = cell.radius_v
        depth = cell.depth()
        weight = cell.charge()
        outside = false
        crossing: i32 = 0
        crossing_index: usize = 0
        index: i32 = 0
        @budget(bound=8)
        while index < count:
            curve_slot = index.to[usize]()
            centre = (
                curve_base[curve_slot]
                + curve_a[curve_slot] * centre_s
                + curve_b[curve_slot] * centre_t
            )
            spread = (
                __wrela_pixels_p7_abs(curve_a[curve_slot]) * radius_s
                + __wrela_pixels_p7_abs(curve_b[curve_slot]) * radius_t
            )
            if centre + spread < 0.0 - curve_residual[curve_slot]:
                outside = true
            elif not centre - spread >= curve_residual[curve_slot]:
                crossing = crossing + 1
                crossing_index = curve_slot
            index = index + 1
        if outside:
            accounted_units = accounted_units + 1048576 * weight
        elif crossing == 0:
            accounted_units = accounted_units + 1048576 * weight
            lower_units = lower_units + 1048576 * weight
            upper_units = upper_units + 1048576 * weight
        elif crossing == 1:
            accounted_units = accounted_units + 1048576 * weight
            local_base = (
                curve_base[crossing_index]
                + curve_a[crossing_index] * (centre_s - radius_s)
                + curve_b[crossing_index] * (centre_t - radius_t)
            )
            local_a = curve_a[crossing_index] * radius_s * 2.0
            local_b = curve_b[crossing_index] * radius_t * 2.0
            magnitude = (
                __wrela_pixels_p7_abs(local_base)
                + __wrela_pixels_p7_abs(local_a)
                + __wrela_pixels_p7_abs(local_b)
                + curve_residual[crossing_index]
            )
            if not magnitude > 0.0:
                return [0, 0]
            scale = 999000.0 / magnitude
            scaled_a = (local_a * scale).to[i32]()
            scaled_b = (local_b * scale).to[i32]()
            scaled_c = (local_base * scale).to[i32]()
            scaled_error = (curve_residual[crossing_index] * scale).to[i32]() + 4
            low = __wrela_pixels_p7_half_plane_units(
                scaled_a, scaled_b, scaled_c - scaled_error,
            )
            high = __wrela_pixels_p7_half_plane_units(
                scaled_a, scaled_b, scaled_c + scaled_error,
            )
            if low[0] != 1 or high[0] != 1:
                return [0, 0]
            lower_units = lower_units + low[1].to[u64]() * weight
            upper_units = upper_units + high[2].to[u64]() * weight
        elif not stack.at_depth_limit(cell):
            if not stack.push_children(cell):
                return [0, stack.failure()]
        else:
            accounted_units = accounted_units + 1048576 * weight
            upper_units = upper_units + 1048576 * weight
        # Everything still on the stack can move the total by at most its own
        # weight, so once the two bounds round to the same byte no further
        # refinement can change the answer.
        pending_units = 17592186044416 - accounted_units
        early_low = (lower_units * 255 + 8796093022208) / 17592186044416
        early_high = (
            (upper_units + pending_units) * 255 + 8796093022208
        ) / 17592186044416
        if early_low == early_high:
            upper_units = upper_units + pending_units
            accounted_units = 17592186044416
            stack.clear()
    low_byte = (lower_units * 255 + 8796093022208) / 17592186044416
    high_byte = (upper_units * 255 + 8796093022208) / 17592186044416
    if low_byte != high_byte:
        return [0, 0]
    return [1, low_byte.to[i64]()]

# Prove whether one sealed arrangement boundary can cross a sub-cell.
# `kind == 1` is a complete feature-validity region (the intersection of the
# representative predicate and all of its siblings); `kind == 2` is an event
# polynomial levelled at `curve_q`. A negative answer is useful only as a
# partition proof. It never assigns occupancy by itself.
fn __wrela_pixels_p7_arrangement_boundary_crosses(
    renderer: usize,
    event_id: u32,
    kind: u8,
    curve_q: f32,
    read cell_uv: [f32; 4],
    read snapshot: FrameInputSnapshot,
) -> [i64; 2]:
    u0 = cell_uv[0]
    v0 = cell_uv[1]
    u1 = cell_uv[2]
    v1 = cell_uv[3]
    if kind == 1:
        descriptor = __wrela_pixels_p7_event_predicate_curve(
            renderer, event_id, u0, v0, snapshot.params, snapshot.camera,
        )
        sibling_count: f32 = descriptor[9]
        if descriptor[0] != 1.0 or not sibling_count >= 0.0 or sibling_count > 6.0:
            return [0, 0]
        curve_count = sibling_count.to[i32]() + 1
        crossing = false
        index: i32 = 0
        @budget(bound=8)
        while index < curve_count:
            curve_id = event_id
            if index > 0:
                slot = descriptor[(10 + index).to[usize]()]
                if not slot >= 0.0 or slot > 16777216.0:
                    return [0, 0]
                curve_id = slot.to[u32]()
            oriented_cell = __wrela_pixels_p7_predicate_curve_cell(
                renderer, curve_id, u0, v0, u1, v1, snapshot,
            )
            cell: [f32; 5] = [
                oriented_cell[0], oriented_cell[1], oriented_cell[2],
                oriented_cell[3], oriented_cell[4],
            ]
            if cell[0] != 1.0:
                return [0, 0]
            affine11 = cell[2] + cell[3] - cell[1]
            lowest = cell[1]
            highest = cell[1]
            if cell[2] < lowest:
                lowest = cell[2]
            if cell[3] < lowest:
                lowest = cell[3]
            if affine11 < lowest:
                lowest = affine11
            if cell[2] > highest:
                highest = cell[2]
            if cell[3] > highest:
                highest = cell[3]
            if affine11 > highest:
                highest = affine11
            # One predicate false everywhere makes the complete validity
            # region empty, hence its boundary cannot change occupancy here.
            if highest < 0.0 - cell[4]:
                return [1, 1]
            if not lowest >= cell[4]:
                crossing = true
            index = index + 1
        if crossing:
            return [1, 0]
        return [1, 2]
    if kind != 2:
        return [0, 0]
    p00 = __wrela_pixels_p7_event_polynomial(
        renderer, event_id, u0, v0, snapshot.params, snapshot.camera,
    )
    p10 = __wrela_pixels_p7_event_polynomial(
        renderer, event_id, u1, v0, snapshot.params, snapshot.camera,
    )
    p01 = __wrela_pixels_p7_event_polynomial(
        renderer, event_id, u0, v1, snapshot.params, snapshot.camera,
    )
    bounds = __wrela_pixels_p7_event_polynomial_uv2_bounds(
        renderer,
        event_id,
        (u0 + u1) * 0.5,
        (v0 + v1) * 0.5,
        __wrela_pixels_p7_abs(u1 - u0) * 0.5,
        __wrela_pixels_p7_abs(v1 - v0) * 0.5,
        [0.0; 65],
    )
    f00 = __wrela_pixels_p7_event_polynomial_at_q(p00, curve_q)
    f10 = __wrela_pixels_p7_event_polynomial_at_q(p10, curve_q)
    f01 = __wrela_pixels_p7_event_polynomial_at_q(p01, curve_q)
    if (
        p00[0] != 1.0 or p10[0] != 1.0 or p01[0] != 1.0
        or bounds[0] != 1.0 or f00[0] != 1.0 or f10[0] != 1.0
        or f01[0] != 1.0
    ):
        return [0, 0]
    du = __wrela_pixels_p7_abs(u1 - u0)
    dv = __wrela_pixels_p7_abs(v1 - v0)
    residual = (
        bounds[1] * du * du * 0.125
        + bounds[2] * du * dv
        + bounds[3] * dv * dv * 0.125
    )
    f11 = f10[1] + f01[1] - f00[1]
    lowest = f00[1]
    highest = f00[1]
    if f10[1] < lowest:
        lowest = f10[1]
    if f01[1] < lowest:
        lowest = f01[1]
    if f11 < lowest:
        lowest = f11
    if f10[1] > highest:
        highest = f10[1]
    if f01[1] > highest:
        highest = f01[1]
    if f11 > highest:
        highest = f11
    if lowest > residual or highest < 0.0 - residual:
        if lowest > residual:
            return [1, 2]
        return [1, 1]
    return [1, 0]

fn __wrela_pixels_p7_combined_arrangement_coverage(
    renderer: usize,
    worker: u32,
    tile: u32,
    pixel: u32,
    read arrangement: P7ArrangementSet,
    read candidates: P7RowCandidates,
    read snapshot: FrameInputSnapshot,
) -> [i64; 2]:
    count = arrangement.count
    if count < 2 or count > 8:
        return [0, 1]
    x = pixel & 65535
    y = pixel >> 16
    u0 = arrangement.cell_uv[0]
    v0 = arrangement.cell_uv[1]
    u1 = arrangement.cell_uv[2]
    v1 = arrangement.cell_uv[3]
    empty_subdivision_cell = RendererWorkerP8RSubdivisionCell(
        center_u=0.0, center_v=0.0, radius_u=0.0, radius_v=0.0,
        depth_and_proof=0, charge_weight=0,
    )
    subdivision_cells: [RendererWorkerP8RSubdivisionCell; 72] = [empty_subdivision_cell; 72]
    subdivision_cells[0] = RendererWorkerP8RSubdivisionCell(
        center_u=(u0 + u1) * 0.5,
        center_v=(v0 + v1) * 0.5,
        radius_u=__wrela_pixels_p7_abs(u1 - u0) * 0.5,
        radius_v=__wrela_pixels_p7_abs(v1 - v0) * 0.5,
        depth_and_proof=0, charge_weight=16777216,
    )
    stack = RendererWorkerP8RSubdivisionStack(
        cells=subdivision_cells, count=1, capacity=40,
        depth_limit=12, event_owner=arrangement.event_ids[0], failure_code=10,
        visit_limit=200000,
    )
    region_known: [bool; 256] = [false; 256]
    region_covered: [bool; 256] = [false; 256]
    # Learn the CSG occupancy of sealed boundary-side vectors on an 8x8 inset
    # grid. Curve-sign evaluation is cheap; full root collection runs only for
    # a side vector not already known (at most 2^count times), so the dense grid
    # can find a small interior region without paying 64 visibility samples.
    # Corridor samples are skipped and a later point with the same vector may
    # still establish it.
    sample_index: u8 = 0
    @budget(bound=64)
    while sample_index < 64:
        sample_s = (sample_index & 7).to[f32]() * 0.125 + 0.0625
        sample_t = (sample_index >> 3).to[f32]() * 0.125 + 0.0625
        sample_u = u0 + (u1 - u0) * sample_s
        sample_v = v0 + (v1 - v0) * sample_t
        region: u8 = 0
        region_ok = true
        event_index: u8 = 0
        @budget(bound=8)
        while event_index < count:
            event_slot = event_index.to[usize]()
            boundary = __wrela_pixels_p7_arrangement_boundary_crosses(
                renderer,
                arrangement.event_ids[event_slot],
                arrangement.event_kinds[event_slot],
                arrangement.event_qs[event_slot],
                [sample_u, sample_v, sample_u, sample_v],
                snapshot,
            )
            if boundary[0] != 1 or boundary[1] == 0:
                region_ok = false
            elif boundary[1] == 2:
                region = region | (1.to[u8]() << event_index)
            event_index = event_index + 1
        if region_ok and not region_known[region.to[usize]()]:
            sample = __wrela_pixels_p7_pixel_visibility_from_candidates(
                renderer=renderer,
                worker=worker,
                tile=tile,
                span=x | ((x + 1) << 16),
                y=y,
                filter=[sample_u, sample_v, 0.0, 0.0],
                candidates=candidates,
                snapshot=snapshot,
            )
            region_slot = region.to[usize]()
            if sample.ok and not sample.event:
                region_known[region_slot] = true
                region_covered[region_slot] = sample.hit
        sample_index = sample_index + 1
    lower_units: u64 = 0
    upper_units: u64 = 0
    accounted_units: u64 = 0
    processed: u32 = 0
    @budget(bound=131072)
    while stack.length() > 0:
        processed = processed + 1
        if processed > 65536:
            return [0, 11]
        cell = stack.pop()
        center_u = cell.center_u
        center_v = cell.center_v
        radius_u = cell.radius_u
        radius_v = cell.radius_v
        depth = cell.depth()
        weight = cell.charge()
        ambiguous = false
        region: u8 = 0
        event_index: u8 = 0
        @budget(bound=8)
        while event_index < count:
            event_slot = event_index.to[usize]()
            boundary = __wrela_pixels_p7_arrangement_boundary_crosses(
                renderer,
                arrangement.event_ids[event_slot],
                arrangement.event_kinds[event_slot],
                arrangement.event_qs[event_slot],
                [
                    center_u - radius_u,
                    center_v - radius_v,
                    center_u + radius_u,
                    center_v + radius_v,
                ],
                snapshot,
            )
            if boundary[0] != 1:
                return [0, 5]
            if boundary[1] == 0:
                ambiguous = true
            elif boundary[1] == 2:
                region = region | (1.to[u8]() << event_index)
            event_index = event_index + 1
        covered = false
        unresolved_region = false
        if not ambiguous:
            region_slot = region.to[usize]()
            if region_known[region_slot]:
                covered = region_covered[region_slot]
            else:
                # Every sealed boundary has a strict side, so this side vector
                # is constant over the complete cell. Subdivision cannot make
                # an unobserved truth-table entry known; retain its area as an
                # upper bound immediately instead of refining the full region.
                unresolved_region = true
        if not ambiguous:
            accounted_units = accounted_units + weight
            if covered:
                lower_units = lower_units + weight
                upper_units = upper_units + weight
            elif unresolved_region:
                upper_units = upper_units + weight
        elif not stack.at_depth_limit(cell):
            if not stack.push_children(cell):
                return [0, stack.failure()]
        else:
            accounted_units = accounted_units + weight
            upper_units = upper_units + weight
        pending_units = 16777216 - accounted_units
        early_low = (lower_units * 255 + 8388608) / 16777216
        early_high = (
            (upper_units + pending_units) * 255 + 8388608
        ) / 16777216
        if early_low == early_high:
            upper_units = upper_units + pending_units
            accounted_units = 16777216
            stack.clear()
    low_byte = (lower_units * 255 + 8388608) / 16777216
    high_byte = (upper_units * 255 + 8388608) / 16777216
    if low_byte != high_byte:
        return [0, 12]
    return [1, low_byte.to[i64]()]

pub fn __wrela_pixels_p7_silhouette_coverage(
    renderer: usize,
    worker: u32,
    tile: u32,
    x: u32,
    y: u32,
    read candidates: P7RowCandidates,
    read center_sample: P7VisibilitySample,
    read snapshot: FrameInputSnapshot,
) -> [i64; 4]:
    axis_box = __wrela_pixels_p8_axis_box_coverage(renderer, x, y, snapshot.camera)
    if axis_box[0] == 1:
        return axis_box
    q: f32 = 1.0
    union_coverage = __wrela_pixels_p7_union_silhouette_coverage(
        renderer, worker, tile, x, y, candidates, center_sample, snapshot,
    )
    if union_coverage[0] == 1:
        return [
            union_coverage[0],
            union_coverage[1],
            union_coverage[2],
            union_coverage[3],
        ]
    config = __wrela_pixels_p7_numeric_config(renderer)
    count = __wrela_pixels_tile_event_count(renderer, tile)
    if config[0] != 1 or count == 4294967295 or count > 256:
        return [0, 1, 0, 0]
    width = config[1].to[f32]()
    height = config[2].to[f32]()
    aspect = width / height
    u0 = ((x.to[f32]() / width) * 2.0 - 1.0) * aspect
    u1 = (((x + 1).to[f32]() / width) * 2.0 - 1.0) * aspect
    v0 = 1.0 - (y.to[f32]() / height) * 2.0
    v1 = 1.0 - ((y + 1).to[f32]() / height) * 2.0
    result: [i64; 4] = [1, 0, 255, 0]
    # Curves that were evaluated over this pixel, how many of them could
    # actually cross it, and whether some occupancy-bearing event covered
    # the pixel without being reducible to a curve. Together they decide
    # whether "no boundary crosses" is a conclusion or just ignorance.
    classified_curves: u32 = 0
    crossing_curves: u32 = 0
    unclassified_boundary = false
    integration_conflict = false
    arrangement_ids: [u32; 8] = [0; 8]
    arrangement_kinds: [u8; 8] = [0; 8]
    arrangement_qs: [f32; 8] = [0.0; 8]
    arrangement_count: u8 = 0
    arrangement_overflow = false
    # Each sparse-predicate event names all sibling predicates of the same
    # feature, and `predicate_region_coverage` integrates their intersection
    # jointly. Once one member succeeds, the sibling event records are the
    # same region, not additional crossing curves. Remember the sealed group
    # IDs so multiplicity below counts distinct integrated boundaries.
    classified_predicate_events: [u32; 256] = [0; 256]
    classified_predicate_count: u16 = 0
    zero_measure_features: [u32; 8] = [0; 8]
    zero_measure_feature_count: u8 = 0
    ordinal: u32 = 0
    @budget(bound=256)
    while ordinal < count:
        event = __wrela_pixels_tile_event(renderer, tile, ordinal)
        if event[0] != 1 or event[1] > 4294967295:
            return [0, 2, 0, 0]
        event_id = event[1].to[u32]()
        span = __wrela_pixels_p7_event_pixel_span(renderer, event_id, x, y)
        if span[0] != 1:
            return [0, 3, 0, 0]
        pixel_in_event = span[1] == 1
        event_class = span[2].to[u64]()
        handler_class = __wrela_pixels_p8r_handler_class(
            event_class, span[3].to[u8](),
        )
        # The sealed (representation, kind) pairing is classified by the
        # compiler's single-source event taxonomy, not by literals restated
        # here: a new occupancy-bearing kind added to the Rust vocabulary must
        # not be able to slip past the "every boundary provably misses" rule
        # below just because this file was not edited with it.
        #
        #   bit 0 occupancy       bit 4 projected boundary
        #   bit 1 curve           bit 5 validity predicate
        #   bit 2 oriented        bit 6 bounded displacement
        #   bit 3 clip level set  bit 7 union-integrable polynomial
        #   bit 8 linear leading coefficient
        # A linear-leading-coefficient silhouette is the same integrand shape
        # as a quadratic discriminant: a pure uv polynomial whose zero set is
        # the event curve.
        linear_silhouette = event_class & 256 != 0
        # A near or far clip edge is not a curve of its own — it is the owning
        # feature's ray polynomial levelled at the sealed clip q. Evaluating it
        # there turns the clip into an ordinary curve, which is what lets a
        # pixel straddling the far plane be integrated in closed form instead
        # of being ground down by the subpixel walk.
        clip_curve = handler_class == 3
        # Whichever side of a discriminant is positive is the occupied one by
        # construction. A leading coefficient or a clip level set carries no
        # such convention, so those need their side resolved from occupancy.
        oriented_curve = event_class & 4 != 0
        curve_event = event_class & 2 != 0
        # Kinds that can bound where a surface is visible. If one of these
        # covers the pixel but is not reducible to a curve here, no conclusion
        # may be drawn from the remaining curves missing the pixel.
        occupancy_event = event_class & 1 != 0
        # Projected-boundary coordinates are sealed integer pixel edges. They
        # can change the conservative feature candidate span, but cross no
        # pixel interior and have zero coverage measure. Classify them here so
        # they do not masquerade as an unknown curve in a combined arrangement.
        projected_boundary = event_class & 16 != 0
        if pixel_in_event and projected_boundary:
            classified_curves = classified_curves + 1
        # A bounded-displacement silhouette (representation 4) has no closed
        # form here, so it lands in the unclassified bucket and drags every
        # pixel of its span into the subpixel walk. It can still be *excluded*
        # from a pixel by proof: when the ray cell provably carries no point of
        # the displaced surface, or provably no tangency with it, this event
        # bounds nothing inside the pixel and the remaining curves decide it.
        # A proof is strictly a removal of pessimism — every other outcome is
        # `false` and leaves the pixel exactly where it is today.
        deformation_missed = false
        if pixel_in_event and handler_class == 5:
            deformation_result = __wrela_pixels_p8r_dispatch_handler(
                handler_class, renderer, event_id, u0, v0, u1, v1, snapshot,
            )
            deformation_missed = deformation_result[0] == 1
        if deformation_missed:
            classified_curves = classified_curves + 1
        # A feature-validity predicate of an affine-seeded feature reduces to an
        # exact curve in (u, v) once the feature's closed-form root is
        # substituted into it. That is the only boundary the box faces of a hard
        # CSG have: their silhouettes are globally excluded, so without this the
        # face edges are handed whole to the subpixel walk, which cannot pin
        # them — near a face's own edge the two ray roots pinch together and stay
        # ambiguous at every cell size, scale independently.
        predicate_curve = handler_class == 6
        predicate_classified = false
        if pixel_in_event and handler_class == 6:
            group_seen = false
            group_index: u16 = 0
            @budget(bound=256)
