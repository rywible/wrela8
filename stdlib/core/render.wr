                zero_index: u8 = 0
                @budget(bound=8)
                while zero_index < zero_measure_feature_count:
                    if zero_measure_features[zero_index.to[usize]()] == predicate_feature:
                        group_seen = true
                    zero_index = zero_index + 1
            if group_seen:
                predicate_classified = true
                classified_curves = classified_curves + 1
            else:
                predicate_cell: [f32; 4] = [u0, v0, u1, v1]
                predicate = __wrela_pixels_p7_predicate_region_coverage(
                    renderer,
                    worker,
                    tile,
                    x | (y << 16),
                    event_id,
                    predicate_cell,
                    candidates,
                    snapshot,
                )
                group = __wrela_pixels_p7_event_predicate_curve(
                    renderer, event_id, u0, v0,
                    snapshot.params, snapshot.camera,
