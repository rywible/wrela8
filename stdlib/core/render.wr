module render

from core.field import Rgb, Vec3, Vec4, cross3, dot3, length3, sqrt_scalar

pub struct RenderPath:
    pub component: u32

pub struct TileId:
    pub value: u32

pub struct RenderCapacity:
    pub kind: u32

pub struct RenderInvariant:
    pub kind: u32

pub struct DisplayError:
    pub code: u32

pub enum CameraError:
    DegenerateForward
    DegenerateUp
    DegenerateQuaternion
    InvalidBasis

pub struct Camera:
    eye: Vec3
    forward: Vec3
    right: Vec3
    up: Vec3

    # Authored forms are closed constructors. Successful construction always
    # produces the same canonical eye/right/up/forward representation.
    pub fn canonical(eye: Vec3) -> Camera:
        return Camera(
            eye=eye,
            forward=Vec3(x=0.0, y=0.0, z=1.0),
            right=Vec3(x=1.0, y=0.0, z=0.0),
            up=Vec3(x=0.0, y=1.0, z=0.0),
        )

    pub fn look_at(eye: Vec3, target: Vec3, authored_up: Vec3) -> Result[Camera, CameraError]:
        forward_seed = target.subtract(eye)
        forward_length = length3(forward_seed)
        if not forward_length > 0.0:
            return Err(CameraError.DegenerateForward)
        forward = Vec3(
            x=forward_seed.x / forward_length,
            y=forward_seed.y / forward_length,
            z=forward_seed.z / forward_length,
        )
        right_seed = cross3(authored_up, forward)
        right_length = length3(right_seed)
        if not right_length > 0.0:
            return Err(CameraError.DegenerateUp)
        right = Vec3(
            x=right_seed.x / right_length,
            y=right_seed.y / right_length,
            z=right_seed.z / right_length,
        )
        up = cross3(forward, right)
        return Ok(Camera(eye=eye, forward=forward, right=right, up=up))

    pub fn quaternion(eye: Vec3, rotation: Vec4) -> Result[Camera, CameraError]:
        ax = rotation.x
        if ax < 0.0:
            ax = -ax
        ay = rotation.y
        if ay < 0.0:
            ay = -ay
        az = rotation.z
        if az < 0.0:
            az = -az
        aw = rotation.w
        if aw < 0.0:
            aw = -aw
        max_finite: f32 = 340282346638528859811704183484516925440.0
        if not ax <= max_finite or not ay <= max_finite or not az <= max_finite or not aw <= max_finite:
            return Err(CameraError.DegenerateQuaternion)
        scale = ax
        if ay > scale:
            scale = ay
        if az > scale:
            scale = az
        if aw > scale:
            scale = aw
        if not scale > 0.0:
            return Err(CameraError.DegenerateQuaternion)
        scaled_x = rotation.x / scale
        scaled_y = rotation.y / scale
        scaled_z = rotation.z / scale
        scaled_w = rotation.w / scale
        norm_squared = scaled_x * scaled_x + scaled_y * scaled_y + scaled_z * scaled_z + scaled_w * scaled_w
        if not norm_squared > 0.0:
            return Err(CameraError.DegenerateQuaternion)
        inverse_norm = 1.0 / sqrt_scalar(norm_squared)
        x = scaled_x * inverse_norm
        y = scaled_y * inverse_norm
        z = scaled_z * inverse_norm
        w = scaled_w * inverse_norm
        right = Vec3(
            x=1.0 - 2.0 * (y * y + z * z),
            y=2.0 * (x * y + w * z),
            z=2.0 * (x * z - w * y),
        )
        up = Vec3(
            x=2.0 * (x * y - w * z),
            y=1.0 - 2.0 * (x * x + z * z),
            z=2.0 * (y * z + w * x),
        )
        forward = Vec3(
            x=2.0 * (x * z + w * y),
            y=2.0 * (y * z - w * x),
            z=1.0 - 2.0 * (x * x + y * y),
        )
        return Ok(Camera(eye=eye, forward=forward, right=right, up=up))

    pub fn explicit(eye: Vec3, authored_forward: Vec3, authored_right: Vec3, authored_up: Vec3) -> Result[Camera, CameraError]:
        forward_length = length3(authored_forward)
        if not forward_length > 0.0:
            return Err(CameraError.DegenerateForward)
        forward = Vec3(
            x=authored_forward.x / forward_length,
            y=authored_forward.y / forward_length,
            z=authored_forward.z / forward_length,
        )
        projection = dot3(authored_right, forward)
        right_seed = Vec3(
            x=authored_right.x - projection * forward.x,
            y=authored_right.y - projection * forward.y,
            z=authored_right.z - projection * forward.z,
        )
        right_length = length3(right_seed)
        if not right_length > 0.0:
            return Err(CameraError.InvalidBasis)
        right = Vec3(
            x=right_seed.x / right_length,
            y=right_seed.y / right_length,
            z=right_seed.z / right_length,
        )
        up = cross3(forward, right)
        authored_up_length = length3(authored_up)
        if not authored_up_length > 0.0:
            return Err(CameraError.DegenerateUp)
        authored_up_direction = Vec3(
            x=authored_up.x / authored_up_length,
            y=authored_up.y / authored_up_length,
            z=authored_up.z / authored_up_length,
        )
        if not dot3(up, authored_up_direction) > 0.0:
            return Err(CameraError.InvalidBasis)
        return Ok(Camera(eye=eye, forward=forward, right=right, up=up))

pub enum LightKind:
    Disabled
    Point
    Directional
    Rectangle
    Disk

pub struct Light:
    position: Vec3
    direction: Vec3
    axis_u: Vec3
    axis_v: Vec3
    radiance: Rgb

    pub fn zero() -> Light:
        zero = Vec3(x=0.0, y=0.0, z=0.0)
        black = Rgb(r=0.0, g=0.0, b=0.0)
        return Light(
            position=zero,
            direction=zero,
            axis_u=zero,
            axis_v=zero,
            radiance=black,
        )

    pub fn point(position: Vec3, radiance: Rgb) -> Light:
        zero = Vec3(x=0.0, y=0.0, z=0.0)
        return Light(
            position=position,
            direction=zero,
            axis_u=zero,
            axis_v=zero,
            radiance=radiance,
        )

    pub fn directional(direction: Vec3, radiance: Rgb) -> Light:
        zero = Vec3(x=0.0, y=0.0, z=0.0)
        return Light(
            position=zero,
            direction=direction,
            axis_u=zero,
            axis_v=zero,
            radiance=radiance,
        )

    pub fn rectangle(center: Vec3, axis_u: Vec3, axis_v: Vec3, radiance: Rgb) -> Light:
        zero = Vec3(x=0.0, y=0.0, z=0.0)
        return Light(
            position=center,
            direction=zero,
            axis_u=axis_u,
            axis_v=axis_v,
            radiance=radiance,
        )

    pub fn disk(center: Vec3, axis_u: Vec3, axis_v: Vec3, radiance: Rgb) -> Light:
        zero = Vec3(x=0.0, y=0.0, z=0.0)
        return Light(
            position=center,
            direction=zero,
            axis_u=axis_u,
            axis_v=axis_v,
            radiance=radiance,
        )

pub struct LightFrame:
    lights: [Light; 8]

    pub fn empty() -> LightFrame:
        return LightFrame(lights=[
            Light.zero(),
            Light.zero(),
            Light.zero(),
            Light.zero(),
            Light.zero(),
            Light.zero(),
            Light.zero(),
            Light.zero(),
        ])

    pub fn fixed(lights: [Light; 8]) -> LightFrame:
        return LightFrame(lights=lights)

pub struct ScalarRange:
    pub min: f32
    pub max: f32

pub struct RgbRange:
    pub min: Rgb
    pub max: Rgb

    pub fn black_to_hdr_white() -> RgbRange:
        return RgbRange(
            min=Rgb(r=0.0, g=0.0, b=0.0),
            max=Rgb(r=16.0, g=16.0, b=16.0),
        )

pub struct CameraBounds:
    # Version 1 seals a world-relative pose box. The renderer declaration
    # centers eye x/y on the world AABB, places eye z behind its minimum-z
    # face, bounds basis-component displacement from the canonical
    # forward-facing pose, and uses a 90-degree vertical field of view.
    max_motion: f32

    # max_motion is the absolute eye/basis component radius about the
    # canonical pose and the maximum accepted inter-frame component change.
    # A camera authored with look_at/quaternion/explicit must fit this box;
    # turns up to a component delta of 1 require bounded(1.0).
    pub fn bounded(max_motion: f32) -> CameraBounds:
        return CameraBounds(max_motion=max_motion)

    pub fn gameplay_default() -> CameraBounds:
        return CameraBounds(max_motion=0.25)

pub struct LightConfig:
    capacity: u32
    kinds: [LightKind; 8]

    pub fn fixed(capacity: u32) -> LightConfig:
        return LightConfig(
            capacity=capacity,
            kinds=[
                LightKind.Point,
                LightKind.Point,
                LightKind.Point,
                LightKind.Point,
                LightKind.Point,
                LightKind.Point,
                LightKind.Point,
                LightKind.Point,
            ],
        )

    pub fn declared(capacity: u32, kinds: [LightKind; 8]) -> LightConfig:
        return LightConfig(capacity=capacity, kinds=kinds)

    pub fn gameplay_default() -> LightConfig:
        return LightConfig.fixed(capacity=8)

pub struct AoConfig:
    enabled: bool

    pub fn fixed(enabled: bool) -> AoConfig:
        return AoConfig(enabled=enabled)

    pub fn deterministic_v1() -> AoConfig:
        return AoConfig(enabled=true)

pub struct ProbeConfig:
    enabled: bool
    initialization_worst_case_ms: u32

    pub fn fixed(enabled: bool) -> ProbeConfig:
        if enabled:
            return ProbeConfig(enabled=true, initialization_worst_case_ms=250)
        return ProbeConfig(enabled=false, initialization_worst_case_ms=0)

    pub fn disabled() -> ProbeConfig:
        return ProbeConfig(enabled=false, initialization_worst_case_ms=0)

pub enum RenderProfile:
    AaaByteExact

pub enum ToneCurve:
    Linear
    FilmicV1

pub enum RenderError:
    ParameterOutOfRange(RenderPath)
    NonFiniteInput(RenderPath)
    FrameContractMismatch(RenderPath)
    RootIsolationExhausted(TileId)
    EventIsolationExhausted(TileId)
    CertificateExhausted(TileId)
    CapacityExceeded(RenderCapacity)
    FixedPointRangeExceeded(TileId)
    Display(DisplayError)
    InternalInvariant(RenderInvariant)

pub struct SurfaceContext[M]:
    pub material: M
    pub position: Vec3
    pub normal: Vec3

pub enum TextureFilter:
    Nearest
    Bilinear

pub struct MaterialSample:
    color: Rgb
    roughness: f32

    pub fn standard(color: Rgb, roughness: f32) -> MaterialSample:
        max_finite: f32 = 340282346638528859811704183484516925440.0
        safe_r = color.r
        safe_g = color.g
        safe_b = color.b
        if safe_r != safe_r:
            safe_r = 0.0
        if safe_g != safe_g:
            safe_g = 0.0
        if safe_b != safe_b:
            safe_b = 0.0
        if safe_r > max_finite:
            safe_r = max_finite
        if safe_r < -max_finite:
            safe_r = -max_finite
        if safe_g > max_finite:
            safe_g = max_finite
        if safe_g < -max_finite:
            safe_g = -max_finite
        if safe_b > max_finite:
            safe_b = max_finite
        if safe_b < -max_finite:
            safe_b = -max_finite
        clamped = roughness
        if clamped != clamped:
            clamped = 0.0
        if clamped < 0.0:
            clamped = 0.0
        if clamped > 1.0:
            clamped = 1.0
        safe_color = Rgb(r=safe_r, g=safe_g, b=safe_b)
        return MaterialSample(color=safe_color, roughness=clamped)

    pub fn clay(color: Rgb, roughness: f32) -> MaterialSample:
        return MaterialSample.standard(color=color, roughness=roughness)

    pub fn porcelain(color: Rgb, roughness: f32) -> MaterialSample:
        return MaterialSample.standard(color=color, roughness=roughness)

    pub fn textured(
        color: Rgb,
        roughness: f32,
        texture_id: u32,
        width: u32,
        height: u32,
        filter: TextureFilter,
    ) -> MaterialSample:
        # The Pixels compiler intercepts this closed constructor and records
        # the immutable texture descriptor. P9 supplies filtered sampling.
        return MaterialSample.standard(color=color, roughness=roughness)

    pub fn sample_color(read self) -> Rgb:
        return self.color

    pub fn sample_roughness(read self) -> f32:
        return self.roughness

pub struct RenderFrame[P]:
    pub params: P
    pub camera: Camera
    pub lights: LightFrame
    pub exposure: f32
    pub environment: Rgb
    pub frame_index: u64

pub struct RenderedFrame[P]:
    pub params: P
    pub frame_index: u64
    pub displayed_digest: [u8; 32]
    pub rebuilt_tiles: u32
    pub reused_tiles: u32

@actor
pub struct Renderer[P]:
    generated_state: u64

    pub async fn render(mut self, take frame: RenderFrame[P])
        -> Result[RenderedFrame[P], RenderError]:
        return Err(RenderError.InternalInvariant(RenderInvariant(kind=1)))
