                        p00[0] != 1.0 or p00[1] != 0.0
                        or p10[0] != 1.0 or p10[1] != 0.0
                        or p01[0] != 1.0 or p01[1] != 0.0
                        or p11[0] != 1.0 or p11[1] != 0.0
