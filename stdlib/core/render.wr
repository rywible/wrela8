                if f01 < affine_min:
                    affine_min = f01
                if affine11 < affine_min:
                    affine_min = affine11
                if f10 > affine_max:
                    affine_max = f10
                if f01 > affine_max:
                    affine_max = f01
                if affine11 > affine_max:
                    affine_max = affine11
                a_value = f10 - f00
                b_value = f01 - f00
