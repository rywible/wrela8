pub struct FrameInputSnapshot:
    # Every validated frame-controlled value is captured even when P7
    # visibility uses only the packed parameter and camera coefficient subset.
    pub params: [f32; 16]
    pub param_count: u16
    pub camera: [f32; 12]
    pub lights: LightFrame
    pub exposure: f32
    pub environment: Rgb
    pub frame_index: u64

    pub fn zero() -> FrameInputSnapshot:
        return FrameInputSnapshot(
            params=[0.0; 16],
            param_count=0,
            camera=[0.0; 12],
            lights=LightFrame.empty(),
            exposure=0.0,
            environment=Rgb(r=0.0, g=0.0, b=0.0),
            frame_index=0,
        )

    pub fn from_packed(
        params: [f32; 16],
        param_count: u16,
        camera: [f32; 12],
        frame_index: u64,
    ) -> FrameInputSnapshot:
        return FrameInputSnapshot(
            params=params,
            param_count=param_count,
            camera=camera,
            lights=LightFrame.empty(),
            exposure=0.0,
            environment=Rgb(r=0.0, g=0.0, b=0.0),
            frame_index=frame_index,
        )

    pub fn make(
        params: [f32; 16],
        param_count: u16,
        read camera: Camera,
        frame_index: u64,
    ) -> FrameInputSnapshot:
        camera_values: [f32; 12] = [
            camera.eye.x,
            camera.eye.y,
            camera.eye.z,
            camera.forward.x,
            camera.forward.y,
            camera.forward.z,
            camera.right.x,
            camera.right.y,
            camera.right.z,
            camera.up.x,
            camera.up.y,
            camera.up.z,
        ]
        return FrameInputSnapshot(
            params=params,
            param_count=param_count,
            camera=camera_values,
            lights=LightFrame.empty(),
            exposure=0.0,
            environment=Rgb(r=0.0, g=0.0, b=0.0),
            frame_index=frame_index,
        )

    pub fn make_frame(
        params: [f32; 16],
        param_count: u16,
        read camera: Camera,
        read lights: LightFrame,
        exposure: f32,
        environment: Rgb,
        frame_index: u64,
    ) -> FrameInputSnapshot:
        camera_values: [f32; 12] = [
            camera.eye.x,
            camera.eye.y,
            camera.eye.z,
            camera.forward.x,
            camera.forward.y,
            camera.forward.z,
            camera.right.x,
            camera.right.y,
            camera.right.z,
            camera.up.x,
            camera.up.y,
            camera.up.z,
        ]
        return FrameInputSnapshot(
            params=params,
            param_count=param_count,
            camera=camera_values,
            lights=lights,
            exposure=exposure,
            environment=environment,
            frame_index=frame_index,
        )

    pub fn post_values(read self) -> [f32; 4]:
        return [
            self.exposure,
            self.environment.r,
            self.environment.g,
            self.environment.b,
        ]

pub struct RendererWorkerAssignment:
    word: u64

pub struct RendererWorkerJob:
    pub renderer_index: usize
    pub worker_index: u32
    pub tiles_start: u32
    pub tiles_end: u32

pub struct P7VisibilitySample:
    pub ok: bool
    pub error: u8
    pub hit: bool
    pub event: bool
    pub object: u32
    pub identity: u32
    pub q_lo: i32
    pub q_hi: i32
    pub root_count: u32
    pub proof_method: u8
    pub composition_shape: u8
    pub proof_margin: i32

    pub coverage: u8

    pub fn debug_values(read self) -> [i64; 12]:
        ok: i64 = 0
        hit: i64 = 0
        event: i64 = 0
        if self.ok:
            ok = 1
        if self.hit:
            hit = 1
        if self.event:
            event = 1
        return [
            ok,
            hit,
            event,
            self.object.to[i64](),
            self.identity.to[i64](),
            self.q_lo.to[i64](),
            self.q_hi.to[i64](),
            (self.root_count & 65535).to[i64](),
            (self.root_count >> 16).to[i64](),
            self.error.to[i64](),
            self.coverage.to[i64](),
            self.proof_method.to[i64](),
        ]

    pub fn is_certified(read self) -> bool:
        return self.ok

    pub fn failure() -> P7VisibilitySample:
        return P7VisibilitySample.failure_with(4)

    pub fn failure_with(error: u8) -> P7VisibilitySample:
        return P7VisibilitySample(
            ok=false,
            error=error,
            hit=false,
            event=false,
            object=0,
            identity=0,
            q_lo=0,
            q_hi=0,
            root_count=0,
            proof_method=0,
            composition_shape=0,
            proof_margin=0,
            coverage=0,
        )

    pub fn background() -> P7VisibilitySample:
        return P7VisibilitySample(
            ok=true,
            error=0,
            hit=false,
            event=false,
            object=0,
            identity=0,
            q_lo=0,
            q_hi=0,
            root_count=0,
            proof_method=0,
            composition_shape=0,
            proof_margin=0,
            coverage=0,
        )

    pub fn event_pixel(read self) -> bool:
        return self.event

pub struct P7PixelArrangement:
    pub ok: bool
    pub error: u8
    pub sample: P7VisibilitySample
    pub model: [i32; 8]

    pub fn failure(error: u8) -> P7PixelArrangement:
        return P7PixelArrangement(
            ok=false,
            error=error,
            sample=P7VisibilitySample.background(),
            model=[0; 8],
        )

    pub fn success(read sample: P7VisibilitySample) -> P7PixelArrangement:
        return P7PixelArrangement(ok=true, error=0, sample=sample, model=[0; 8])

pub struct P7WalkTarget:
    pub object: u32
    pub identity: u32
    pub feature: u32
    pub q_lo: i32
    pub q_hi: i32
    # The unpadded support span. `q_lo`/`q_hi` may reach past it so the walk
    # has sign-definite faces to work with, but the feature's surface is
    # proven to lie inside `[support_lo, support_hi]`, so nothing outside it
    # may be recorded as a crossing or hold the walk open as a corridor.
    pub support_lo: i32
    pub support_hi: i32
    pub degree: u8

pub struct P7RowCandidates:
    pub ok: bool
    # Meaningful only when ok is false: 1 = candidate capacity exceeded,
    # 5 = invariant/contract failure.
    pub error: u8
    pub ids: [u32; 256]
    pub count: u16

    pub fn debug_count(read self) -> u16:
        return self.count

pub struct P7RootList:
    pub ok: bool
    pub error: u8
    pub renderer: usize
    pub worker: u32
    pub temporary: bool
    pub count: u32
    pub initial_inside: u64

    pub fn debug_count(read self) -> u32:
        return self.count

pub struct P7StoredRoot:
    pub ok: bool
    pub lo: i32
    pub hi: i32
    pub object: u32
    pub identity: u32
    pub feature: u32
    pub crossing: bool
    pub method: u8
    pub margin: i32

    pub fn failure() -> P7StoredRoot:
        return P7StoredRoot(
            ok=false,
            lo=0,
            hi=0,
            object=0,
            identity=0,
            feature=0,
            crossing=false,
            method=0,
            margin=0,
        )

pub struct P7BoolResult:
    pub ok: bool
    pub value: bool

pub struct P7RootContext:
    pub renderer: usize
    pub u: f32
    pub v: f32
    pub ru: f32
    pub rv: f32
    pub exponent: i32
    # Bisection depth for the q walks. Primary samples certify at full
    # depth; strict-subpixel arrangement cells stay shallow — an unresolved
    # cell there subdivides in uv instead, which is what actually separates
    # degenerate line coverage, and a shallower walk is strictly more
    # conservative.
    pub depth_cap: u8
    pub candidates: P7RowCandidates
    pub snapshot: FrameInputSnapshot

# Integrate the occupancy arrangement of several distinct event boundaries.
# A sub-cell is sampled only after every sealed boundary is proved not to cross
# it. Cells still touching any boundary are refined, and the unresolved area is
# retained as an upper bound. Acceptance therefore proves one combined byte;
# equal bytes from independent single-curve integrations are never conflated.
pub struct P7ArrangementSet:
    pub count: u8
    pub event_ids: [u32; 8]
    pub event_kinds: [u8; 8]
    pub event_qs: [f32; 8]
    pub cell_uv: [f32; 4]

fn __wrela_pixels_p8_geometry_valid(
    q_raw: i32,
    q_u_raw: i32,
    q_v_raw: i32,
    lane_u: f32,
    lane_v: f32,
    read camera: [f32; 12],
    scale: f32,
) -> bool:
    q = q_raw.to[f32]() * scale
    q_u = q_u_raw.to[f32]() * scale
    q_v = q_v_raw.to[f32]() * scale
    camera_z = q - lane_u * q_u - lane_v * q_v
    normal_x = camera[6] * q_u + camera[9] * q_v + camera[3] * camera_z
    normal_y = camera[7] * q_u + camera[10] * q_v + camera[4] * camera_z
    normal_z = camera[8] * q_u + camera[11] * q_v + camera[5] * camera_z
    return (normal_x + normal_y + normal_z) * 0.0 == 0.0

pub fn __wrela_pixels_p8_derivative_bounds(
    q_lo: i32,
    q_hi: i32,
    read normal: [f32; 4],
    center_u: f32,
    center_v: f32,
    read camera: [f32; 12],
) -> [i64; 5]:
    camera_nu = camera[6] * normal[1] + camera[7] * normal[2] + camera[8] * normal[3]
    camera_nv = camera[9] * normal[1] + camera[10] * normal[2] + camera[11] * normal[3]
    camera_nz = camera[3] * normal[1] + camera[4] * normal[2] + camera[5] * normal[3]
    normal_scale = camera_nz + center_u * camera_nu + center_v * camera_nv
    if normal_scale > -0.00000095367431640625 and normal_scale < 0.00000095367431640625:
        return [0; 5]
    # q and its two derivatives share one fixed domain, so the common dyadic
    # scale cancels in q*n/normal_scale. A fixed 2^16-raw-unit guard exceeds
    # the accumulated f32 endpoint-conversion, multiply-add, division, and
    # truncation error throughout the accepted i32 result range. The caller
    # turns these outward endpoints into compact affine centers and radii.
    q_u_factor = camera_nu / normal_scale
    q_v_factor = camera_nv / normal_scale
    q_u_a = q_lo.to[f32]() * q_u_factor
    q_u_b = q_hi.to[f32]() * q_u_factor
    q_v_a = q_lo.to[f32]() * q_v_factor
    q_v_b = q_hi.to[f32]() * q_v_factor
    if q_u_b < q_u_a:
        swap = q_u_a
        q_u_a = q_u_b
        q_u_b = swap
    if q_v_b < q_v_a:
        swap = q_v_a
        q_v_a = q_v_b
        q_v_b = swap
    # Ordered range comparisons also reject NaNs, so non-finite endpoints fail
    # closed without a second set of floating-point predicates.
    if not (
        q_u_a >= -2147352576.0
        and q_u_b <= 2147352576.0
        and q_v_a >= -2147352576.0
        and q_v_b <= 2147352576.0
    ):
        return [0; 5]
    return [
        1,
        q_u_a.to[i64]() - 65536,
        q_u_b.to[i64]() + 65536,
        q_v_a.to[i64]() - 65536,
        q_v_b.to[i64]() + 65536,
    ]

pub fn __wrela_pixels_p8_charge_raster_run(
    renderer: usize,
    worker: u32,
    telemetry_enabled: bool,
    first_pixel: u32,
    length: u32,
    background: bool,
) -> unit:
    if not telemetry_enabled:
        return unit
    scalar: u32 = 0
    remaining = length
    scalar_prefix = (4 - first_pixel % 4) % 4
    if scalar_prefix > remaining:
        scalar_prefix = remaining
    scalar = scalar_prefix
    remaining = remaining - scalar_prefix
    packets = remaining / 4
    scalar = scalar + remaining % 4
    _ = __wrela_pixels_p7_telemetry_charge(renderer, worker, 142, packets.to[u64]())
    _ = __wrela_pixels_p7_telemetry_charge(renderer, worker, 143, scalar.to[u64]())
    if background:
        _ = __wrela_pixels_p7_telemetry_charge(renderer, worker, 147, length.to[u64]())
    else:
        _ = __wrela_pixels_p7_telemetry_charge(renderer, worker, 144, length.to[u64]())
        _ = __wrela_pixels_p7_telemetry_charge(renderer, worker, 145, length.to[u64]())
    return unit

pub struct P8RasterContext:
    pub renderer: usize
    pub worker: u32
    pub y: u32
    pub width: u32
    pub height: u32
    pub camera: [f32; 12]
    pub scale: f32
    pub color: u32

struct P8RasterSetupOutcome:
    pub ok: bool
    pub raster: RasterRun

fn __wrela_pixels_p8_i64_magnitude(value: i64) -> i64:
    if value < 0:
        return 0 - value
    return value

fn __wrela_pixels_p8_i32_fits(value: i64) -> bool:
    return value >= -2147483648 and value <= 2147483647

fn __wrela_pixels_p8_recurrence_valid(q: i64, dq: i64, ddq: i64, error: i64, width: u32) -> bool:
    if error < 0:
        return false
    proof_q = q
    proof_dq = dq
    step: u32 = 0
    @budget(bound=16)
    while step < width:
        if (
            not __wrela_pixels_p8_i32_fits(proof_q)
            or not __wrela_pixels_p8_i32_fits(proof_q - error)
            or not __wrela_pixels_p8_i32_fits(proof_q + error)
            or not __wrela_pixels_p8_i32_fits(proof_dq)
        ):
            return false
        proof_q = proof_q + proof_dq
        proof_dq = proof_dq + ddq
        step = step + 1
    # Runs are sealed to at most sixteen pixels. Proving every scalar
    # recurrence state also proves every packet lane: the ASIMD additions use
    # wrapping i32 arithmetic, and each mathematically resulting lane was just
    # shown to lie in i32, so its modular representation is identical.
    return true

pub fn __wrela_pixels_p8_raster_setup(
    read sample: P7VisibilitySample,
    read model: [i64; 8],
    modeled: bool,
    x: u32,
    x1: u32,
    exponent: i32,
    height: u32,
    read derivatives: [i64; 4],
) -> P8RasterSetupOutcome:
    q0_lo = sample.q_lo.to[i64]()
    q0_hi = sample.q_hi.to[i64]()
    dq_lo: i64 = 0
    dq_hi: i64 = 0
    ddq_lo: i64 = 0
    ddq_hi: i64 = 0
    q_error_lo: i64 = sample.q_lo.to[i64]() - q0_hi
    q_error_hi: i64 = sample.q_hi.to[i64]() - q0_lo
    if modeled:
        q0_lo = model[0]
        q0_hi = model[1]
        dq_lo = model[2]
        dq_hi = model[3]
        ddq_lo = model[4]
        ddq_hi = model[5]
        q_error_lo = model[6]
        q_error_hi = model[7]
    packet_q64 = q0_lo + (q0_hi - q0_lo) / 2
    packet_dq64 = dq_lo + (dq_hi - dq_lo) / 2
    packet_ddq64 = ddq_lo + (ddq_hi - ddq_lo) / 2
    q_error64 = q0_hi - packet_q64
    if packet_q64 - q0_lo > q_error64:
        q_error64 = packet_q64 - q0_lo
    q_error_lo = __wrela_pixels_p8_i64_magnitude(q_error_lo)
    q_error_hi = __wrela_pixels_p8_i64_magnitude(q_error_hi)
    if q_error_lo > q_error64:
        q_error64 = q_error_lo
    if q_error_hi > q_error64:
        q_error64 = q_error_hi
    q_u_lo64 = derivatives[0]
    q_u_hi64 = derivatives[1]
    q_u_delta_lo64: i64 = 0
    q_u_delta_hi64: i64 = 0
    if modeled:
        q_u_lo64 = interval_floor_div(model[2] * height.to[i64](), 2)
        q_u_hi64 = interval_ceil_div(model[3] * height.to[i64](), 2)
        q_u_delta_lo64 = interval_floor_div(model[4] * height.to[i64](), 2)
        q_u_delta_hi64 = interval_ceil_div(model[5] * height.to[i64](), 2)
    q_v_lo64 = derivatives[2]
    q_v_hi64 = derivatives[3]
    q_u64 = q_u_lo64 + (q_u_hi64 - q_u_lo64) / 2
    q_u_delta64 = q_u_delta_lo64 + (q_u_delta_hi64 - q_u_delta_lo64) / 2
    q_v64 = q_v_lo64 + (q_v_hi64 - q_v_lo64) / 2
    q_u_error64 = __wrela_pixels_p8_i64_magnitude(q_u_hi64 - q_u64)
    q_u_low_error64 = __wrela_pixels_p8_i64_magnitude(q_u64 - q_u_lo64)
    if q_u_low_error64 > q_u_error64:
        q_u_error64 = q_u_low_error64
    q_u_delta_error64 = __wrela_pixels_p8_i64_magnitude(q_u_delta_hi64 - q_u_delta64)
    q_u_delta_low_error64 = __wrela_pixels_p8_i64_magnitude(q_u_delta64 - q_u_delta_lo64)
    if q_u_delta_low_error64 > q_u_delta_error64:
        q_u_delta_error64 = q_u_delta_low_error64
    q_u_error64 = q_u_error64 + (x1 - x).to[i64]() * q_u_delta_error64
    q_v_error64 = __wrela_pixels_p8_i64_magnitude(q_v_hi64 - q_v64)
    q_v_low_error64 = __wrela_pixels_p8_i64_magnitude(q_v64 - q_v_lo64)
    if q_v_low_error64 > q_v_error64:
        q_v_error64 = q_v_low_error64
    # Every center is the midpoint of i32 endpoints and therefore remains in
    # i32.  Only the enclosing radius can exceed the compact record domain.
    ok = (
        q_error64 >= 0 and q_error64 <= 2147483647
        and q_u_error64 >= 0 and q_u_error64 <= 2147483647
        and q_v_error64 >= 0 and q_v_error64 <= 2147483647
        and __wrela_pixels_p8_i32_fits(q_u64)
        and __wrela_pixels_p8_i32_fits(q_u_delta64)
        and __wrela_pixels_p8_i32_fits(q_v64)
        and __wrela_pixels_p8_recurrence_valid(
            q_u64,
            q_u_delta64,
            0,
            q_u_error64,
            x1 - x,
        )
        and __wrela_pixels_p8_recurrence_valid(q_v64, 0, 0, q_v_error64, x1 - x)
        and __wrela_pixels_p8_recurrence_valid(
            packet_q64,
            packet_dq64,
            packet_ddq64,
            q_error64,
            x1 - x,
        )
    )
    proof_bits: u8 = 7
    if not sample.hit:
        proof_bits = proof_bits | 8
    return P8RasterSetupOutcome(
        ok=ok,
        raster=RasterRun(
            x0=x.to[u16](),
            x1=x1.to[u16](),
            q=QRunScalar.certified(
                packet_q64.to[i32](),
                packet_dq64.to[i32](),
                packet_ddq64.to[i32](),
                FixedDomain.full(exponent),
                q_error64.to[i32](),
                (x1 - x).to[u8](),
            ),
            q_u=AffineRunSetup(
                value=q_u64.to[i32](),
                delta=q_u_delta64.to[i32](),
                error_radius=q_u_error64.to[i32](),
            ),
            q_v=AffineRunSetup(
                value=q_v64.to[i32](),
                delta=0,
                error_radius=q_v_error64.to[i32](),
            ),
            identity=IdentitySetId(value=sample.identity),
            material_summary=MaterialSummaryId(value=0),
            light_summary=LightSummaryId(value=0),
            proof_code=OutputProofCode(bits=proof_bits),
        ),
    )

# Execute the compact regular-run record outside the proof-rich sweep worker.
# Besides keeping the hot loop auditable, this sharply limits spill traffic:
# the sweep worker's live certificate state is intentionally much larger than
# the raster state and must not be carried through every packet operation.
fn __wrela_pixels_p8_geometry_lane_valid(
    read context: P8RasterContext,
    read raster: RasterRun,
    raster_x: u32,
    q_raw: i32,
    geometry_required: bool,
) -> bool:
    scalar_offset = (raster_x - raster.x0.to[u32]()).to[i64]()
    q_u_raw64 = raster.q_u.value.to[i64]() + scalar_offset * raster.q_u.delta.to[i64]()
    q_v_raw64 = raster.q_v.value.to[i64]() + scalar_offset * raster.q_v.delta.to[i64]()
    if not __wrela_pixels_p8_i32_fits(q_u_raw64) or not __wrela_pixels_p8_i32_fits(q_v_raw64):
        return false
    scalar_u = (
        2 * raster_x.to[i64]() + 1 - context.width.to[i64]()
    ).to[f32]() / context.height.to[f32]()
    scalar_v = (
        context.height.to[i64]() - 2 * context.y.to[i64]() - 1
    ).to[f32]() / context.height.to[f32]()
    if geometry_required and not __wrela_pixels_p8_geometry_valid(
            q_raw,
            q_u_raw64.to[i32](),
            q_v_raw64.to[i32](),
            scalar_u,
            scalar_v,
            context.camera,
            context.scale,
        ):
        return false
    evidence_class: u8 = 3
    if geometry_required:
        evidence_class = 1
    evidence_q = (
        (q_raw.to[i64]().to[u64]() & 4294967295)
        | (raster.q.error().to[u64]() << 32)
    )
    evidence_derivatives = (
        (q_u_raw64 & 4294967295).to[u64]()
        | ((q_v_raw64 & 4294967295).to[u64]() << 32)
    )
    evidence_bounds = (
        raster.q_u.error_radius.to[u64]()
        | (raster.q_v.error_radius.to[u64]() << 31)
    )
    return __wrela_pixels_p8_raster_evidence_store(
        context.renderer,
        (context.y *% context.width +% raster_x).to[usize](),
        evidence_q,
        evidence_derivatives,
        evidence_bounds,
        evidence_class,
    )

fn __wrela_pixels_p8_geometry_packet_valid(
    read context: P8RasterContext,
    read raster: RasterRun,
    raster_x: u32,
    read q_packet: I32x4,
    geometry_required: bool,
) -> bool:
    geometry_lane: usize = 0
    @budget(bound=4)
    while geometry_lane < 4:
        if not __wrela_pixels_p8_geometry_lane_valid(
            context,
            raster,
            raster_x + geometry_lane.to[u32](),
            q_packet.lane(geometry_lane),
            geometry_required,
        ):
            return false
        geometry_lane = geometry_lane + 1
    return true

pub fn __wrela_pixels_p8_raster_regular(read context: P8RasterContext, read raster: RasterRun) -> u64:
    start = raster.x0.to[u32]()
    end = raster.x1.to[u32]()
    if end < start or end > context.width:
        return 18446744073709551615
    geometry_required = raster.proof_code.bits & 8 == 0
    r = (context.color & 255).to[u8]()
    g = ((context.color >> 8) & 255).to[u8]()
    b = ((context.color >> 16) & 255).to[u8]()
    pixels_census_region(PIXELS_REGION_RASTER_SCALAR_PREFIX)
    raster_x = start
    raster_q = raster.q.value().to[i64]()
    raster_dq = raster.q.delta().to[i64]()
    raster_ddq = raster.q.second_delta().to[i64]()
    @budget(bound=3)
    while raster_x < end and raster_x % 4 != 0:
        if not __wrela_pixels_p8_geometry_lane_valid(
            context,
            raster,
            raster_x,
            raster_q.to[i32](),
            geometry_required,
        ):
            return 18446744073709551615
        if not __wrela_pixels_p8_write(
            context.renderer,
            context.worker,
            context.y *% context.width +% raster_x,
            context.color,
            255,
            0,
        ):
            return 18446744073709551615
        raster_q = raster_q +% raster_dq
        raster_dq = raster_dq +% raster_ddq
        raster_x = raster_x +% 1
    pixels_census_region(PIXELS_REGION_RASTER_PACKET_LOOP)
    if end -% raster_x >= 4:
        advance_delta = 16 *% raster_ddq
        q_packet = I32x4.from_lanes([
            raster_q.to[i32](),
            (raster_q +% raster_dq).to[i32](),
            (raster_q +% 2 *% raster_dq +% raster_ddq).to[i32](),
            (raster_q +% 3 *% raster_dq +% 3 *% raster_ddq).to[i32](),
        ])
        q_advance = I32x4.from_lanes([
            (4 *% raster_dq +% 6 *% raster_ddq).to[i32](),
            (4 *% raster_dq +% 10 *% raster_ddq).to[i32](),
            (4 *% raster_dq +% 14 *% raster_ddq).to[i32](),
            (4 *% raster_dq +% 18 *% raster_ddq).to[i32](),
        ])
        q_advance_delta = I32x4.from_lanes([advance_delta.to[i32](); 4])
        @budget(bound=16)
        while end -% raster_x >= 4:
            if not __wrela_pixels_p8_geometry_packet_valid(
                context,
                raster,
                raster_x,
                q_packet,
                geometry_required,
            ):
                return 18446744073709551615
            if not __wrela_pixels_p8_write4(
                context.renderer,
                context.worker,
                context.y *% context.width +% raster_x,
                r,
                g,
                b,
            ):
                return 18446744073709551615
            raster_x = raster_x +% 4
            raster_q = raster_q +% 4 *% raster_dq +% 6 *% raster_ddq
            raster_dq = raster_dq +% 4 *% raster_ddq
            if end -% raster_x >= 4:
                q_packet = pixels_i32x4_backend_add(q_packet, q_advance)
                q_advance = pixels_i32x4_backend_add(q_advance, q_advance_delta)
    pixels_census_region(PIXELS_REGION_RASTER_SCALAR_SUFFIX)
    @budget(bound=3)
    while raster_x < end:
        if not __wrela_pixels_p8_geometry_lane_valid(
            context,
            raster,
            raster_x,
            raster_q.to[i32](),
            geometry_required,
        ):
            return 18446744073709551615
        if not __wrela_pixels_p8_write(
            context.renderer,
            context.worker,
            context.y *% context.width +% raster_x,
            context.color,
            255,
            0,
        ):
            return 18446744073709551615
        raster_q = raster_q +% raster_dq
        raster_dq = raster_dq +% raster_ddq
        raster_x = raster_x +% 1
    pixels_census_region(PIXELS_REGION_RASTER_CHARGE)
    span = (end -% start).to[u64]()
    if not __wrela_pixels_p7_workspace_charge(
            context.renderer,
            context.worker,
            2,
            span,
        ):
        return 18446744073709551615
    return span

pub fn __wrela_pixels_p7_run_worker_with_proposals(
    renderer_index: usize,
    worker_index: usize,
    proposals_enabled: bool,
) -> u64:
    if worker_index > 3:
        return 18446744073709551615
    worker = worker_index.to[u32]()
    assignment = __wrela_pixels_p7_worker_assignment(renderer_index, worker)
    if assignment[0] != 1:
        return 18446744073709551615
    config = __wrela_pixels_p7_numeric_config(renderer_index)
    if config[0] != 1 or config[6] < 0 or config[6] > 16:
        return 18446744073709551615
    if not proposals_enabled:
        tile_columns = (config[1].to[u32]() + 63) / 64
        tile_rows = (config[2].to[u32]() + 31) / 32
        tile_count = tile_columns.to[u64]() * tile_rows.to[u64]()
        if assignment[4] != 0 or assignment[5] != tile_count:
            return 18446744073709551615
        if not __wrela_pixels_p8_initialize(renderer_index):
            return 18446744073709551615
        _ = __wrela_pixels_p8_cancel(renderer_index)
        if __wrela_pixels_p8_begin(renderer_index)[0] != 1:
            return 18446744073709551615
    job = RendererWorkerJob(
        renderer_index=renderer_index,
        worker_index=worker,
        tiles_start=assignment[4].to[u32](),
        tiles_end=assignment[5].to[u32](),
    )
    return __wrela_pixels_p7_run_job(job, proposals_enabled)

