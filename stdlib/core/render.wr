        sampled_pending = false
        sampled_u: f32 = 0.0
        sampled_v: f32 = 0.0
        line_a: i32 = 0
        line_b: i32 = 0
        line_c: i32 = 0
        line_error: i32 = 0
        line_torus = false
        line_standard_torus = false
        line_standard_positive_known = false
        line_standard_positive_hit = false
        line_positive_u: f32 = 0.0
        line_positive_v: f32 = 0.0
        line_has_positive = false
        line_negative_u: f32 = 0.0
        line_negative_v: f32 = 0.0
        line_has_negative = false
        ordinal: u8 = 0
        @budget(bound=8)
        while ordinal < relevant_count:
            event_slot = ordinal.to[usize]()
