        root_p10 = __wrela_pixels_p7_standard_torus_value(
            standard_torus_coefficients, root_cu1, root_cv0,
        )
        root_p01 = __wrela_pixels_p7_standard_torus_value(
            standard_torus_coefficients, root_cu0, root_cv1,
