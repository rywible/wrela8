        config = __wrela_pixels_p7_numeric_config(renderer_index.to[usize]())
        if config[0] != 1:
            return self.__internal_error(take frame, 4106)
        if config[6] < 0:
            return self.__internal_error(take frame, 4106)
        if config[6] > 16:
            return self.__internal_error(take frame, 4106)
        snapshot_eye_finite = __wrela_pixels_p5_finite(snapshot.camera[0])
        if snapshot_eye_finite == false:
            return self.__internal_error(take frame, 4106)
        frame_post = __wrela_pixels_p9_post_values(
            frame.exposure,
            frame.environment.r,
            frame.environment.g,
            frame.environment.b,
        )
        snapshot_stored = __wrela_pixels_p7_frame_snapshot_store(
            renderer_index.to[usize](),
            snapshot.params,
            config[6].to[u16](),
            snapshot.camera,
