pub struct RenderedFrame[P]:
    pub params: P
    pub frame_index: u64
    pub displayed_digest: [u8; 32]
    pub displayed_raw_tile_digest: [u64; 4]
    pub displayed_tile_descriptor_digest: [u64; 4]
    pub rebuilt_tiles: u32
    pub reused_tiles: u32
    pub certificate_runs: u64
    pub event_corridors: u64
    pub revalidated_proposals: u64
    pub certificate_telemetry_digest: [u64; 4]

pub struct RenderFailure[P]:
