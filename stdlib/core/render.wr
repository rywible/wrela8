    return __wrela_pixels_bootstrap_dispatch(11, tag)

pub fn __wrela_pixels_present_placeholder() -> Result[unit, RenderError]:
    # P5 deliberately has no sweep result to present. Keeping this bounded
    # entry point rooted proves the coordinator's failure path cannot touch
    # the display doorbell.
    return Err(RenderError.FrameContractMismatch(RenderPath.renderer_unavailable()))
