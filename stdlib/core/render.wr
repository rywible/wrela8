        predicate_classified = false
        if pixel_in_event and predicate_curve:
            group_seen = false
            group_index: u16 = 0
            @budget(bound=256)
            while group_index < classified_predicate_count:
                if classified_predicate_events[group_index.to[usize]()] == event_id:
                    group_seen = true
                group_index = group_index + 1
            predicate_owner = __wrela_pixels_p7_event_owner(renderer, event_id)
            if predicate_owner >> 32 == 1:
