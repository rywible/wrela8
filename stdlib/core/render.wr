            b = (b_value * scale).to[i32]()
            c = (f00[1] * scale).to[i32]()
            error = (residual * scale).to[i32]() + 4
            low = coverage_line_twice_area(a, b, c - error)
            high = coverage_line_twice_area(a, b, c + error)
            match low:
