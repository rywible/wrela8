    Nearest
    Bilinear
    Trilinear
    Anisotropic4

pub enum UvSource:
    Plane
    Sphere
    Cylinder
    Torus
    BoxFeature
    RoundBoxFeature
    ObjectTriplanar
    WorldTriplanar

pub enum NormalDetail:
    Geometric
    AnalyticSlope(sx: f32, sy: f32)
    TextureSlope(texture_id: u32, width: u32, height: u32, filter: TextureFilter)
    TextureSlopeUv(texture_id: u32, width: u32, height: u32, filter: TextureFilter, uv_source: UvSource)
    ObjectSlope(sx: f32, sy: f32)

pub struct MaterialSample:
    color: Rgb
    metallic: f32
    roughness: f32
    specular: f32
    emissive: Rgb
    opacity: f32
    normal_detail: NormalDetail

    pub fn standard(
        color: Rgb,
        roughness: f32,
        metallic: f32 = 0.0,
        specular: f32 = 0.5,
        emissive: Rgb = Rgb(r=0.0, g=0.0, b=0.0),
        opacity: f32 = 1.0,
        normal_detail: NormalDetail = NormalDetail.Geometric,
    ) -> MaterialSample:
        max_finite: f32 = 340282346638528859811704183484516925440.0
        safe_r = color.r
        safe_g = color.g
        safe_b = color.b
        if safe_r != safe_r:
            safe_r = 0.0
        if safe_g != safe_g:
            safe_g = 0.0
        if safe_b != safe_b:
            safe_b = 0.0
        if safe_r > max_finite:
            safe_r = max_finite
        if safe_r < -max_finite:
            safe_r = -max_finite
        if safe_g > max_finite:
            safe_g = max_finite
        if safe_g < -max_finite:
            safe_g = -max_finite
        if safe_b > max_finite:
            safe_b = max_finite
        if safe_b < -max_finite:
            safe_b = -max_finite
        if safe_r < 0.0:
            safe_r = 0.0
        if safe_r > 1.0:
            safe_r = 1.0
        if safe_g < 0.0:
            safe_g = 0.0
        if safe_g > 1.0:
            safe_g = 1.0
        if safe_b < 0.0:
            safe_b = 0.0
        if safe_b > 1.0:
            safe_b = 1.0
        clamped = roughness
        if clamped != clamped:
            clamped = 0.0
        if clamped < 0.02:
            clamped = 0.02
        if clamped > 1.0:
            clamped = 1.0
        safe_metallic = metallic
        if safe_metallic != safe_metallic:
            safe_metallic = 0.0
        if safe_metallic < 0.0:
            safe_metallic = 0.0
        if safe_metallic > 1.0:
            safe_metallic = 1.0
        safe_specular = specular
        if safe_specular != safe_specular:
            safe_specular = 0.0
        if safe_specular < 0.0:
            safe_specular = 0.0
        if safe_specular > 1.0:
            safe_specular = 1.0
        safe_opacity = opacity
        if safe_opacity != safe_opacity:
            safe_opacity = 0.0
        if safe_opacity < 0.0:
            safe_opacity = 0.0
        if safe_opacity > 1.0:
            safe_opacity = 1.0
        safe_emissive = emissive
        if safe_emissive.r != safe_emissive.r or safe_emissive.r < 0.0:
            safe_emissive.r = 0.0
        if safe_emissive.g != safe_emissive.g or safe_emissive.g < 0.0:
            safe_emissive.g = 0.0
        if safe_emissive.b != safe_emissive.b or safe_emissive.b < 0.0:
            safe_emissive.b = 0.0
        safe_color = Rgb(r=safe_r, g=safe_g, b=safe_b)
        return MaterialSample(
            color=safe_color,
            metallic=safe_metallic,
            roughness=clamped,
            specular=safe_specular,
            emissive=safe_emissive,
            opacity=safe_opacity,
            normal_detail=normal_detail,
        )

    pub fn clay(color: Rgb, roughness: f32) -> MaterialSample:
        return MaterialSample.standard(color=color, roughness=roughness)

    pub fn porcelain(color: Rgb, roughness: f32) -> MaterialSample:
        return MaterialSample.standard(color=color, roughness=roughness)

    pub fn textured(
        color: Rgb,
        roughness: f32,
        texture_id: u32,
        width: u32,
        height: u32,
        filter: TextureFilter,
        uv_source: UvSource = UvSource.WorldTriplanar,
    ) -> MaterialSample:
        # The Pixels compiler intercepts this closed constructor and records
        # the immutable texture descriptor. P9 supplies filtered sampling.
        return MaterialSample.standard(color=color, roughness=roughness)

    pub fn sample_color(read self) -> Rgb:
        return self.color

    pub fn sample_roughness(read self) -> f32:
        return self.roughness

    pub fn sample_metallic(read self) -> f32:
        return self.metallic

    pub fn sample_specular(read self) -> f32:
        return self.specular

    pub fn sample_emissive(read self) -> Rgb:
        return self.emissive

    pub fn sample_opacity(read self) -> f32:
        return self.opacity

