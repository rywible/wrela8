            if ambiguous_count == 0:
                point = __wrela_pixels_p7_point_union_occupancy(
                    renderer, worker, x, y,
                    sampled_u, sampled_v, candidates, snapshot,
                )
                if point[0] != 1:
                    return [0; 4]
                if point[2] == 1:
                    any_inside = true
            else:
                cell_contaminated = true
                all_outside = false
