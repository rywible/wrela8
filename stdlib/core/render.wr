pub enum CameraError:
    DegenerateForward
    DegenerateUp
    DegenerateQuaternion
    InvalidBasis

pub struct Camera:
    eye: Vec3
    forward: Vec3
    right: Vec3
    up: Vec3

    # Authored forms are closed constructors. Successful construction always
    # produces the same canonical eye/right/up/forward representation.
    pub fn canonical(eye: Vec3) -> Camera:
        return Camera(
            eye=eye,
            forward=Vec3(x=0.0, y=0.0, z=1.0),
            right=Vec3(x=1.0, y=0.0, z=0.0),
            up=Vec3(x=0.0, y=1.0, z=0.0),
        )

    pub fn look_at(eye: Vec3, target: Vec3, authored_up: Vec3) -> Result[Camera, CameraError]:
        forward_seed = target.subtract(eye)
        forward_length = length3(forward_seed)
        if not forward_length > 0.0:
            return Err(CameraError.DegenerateForward)
        forward = Vec3(
            x=forward_seed.x / forward_length,
            y=forward_seed.y / forward_length,
            z=forward_seed.z / forward_length,
        )
        right_seed = cross3(authored_up, forward)
        right_length = length3(right_seed)
        if not right_length > 0.0:
            return Err(CameraError.DegenerateUp)
        right = Vec3(
            x=right_seed.x / right_length,
            y=right_seed.y / right_length,
            z=right_seed.z / right_length,
        )
        up = cross3(forward, right)
        return Ok(Camera(eye=eye, forward=forward, right=right, up=up))

    pub fn quaternion(eye: Vec3, rotation: Vec4) -> Result[Camera, CameraError]:
        ax = rotation.x
        if ax < 0.0:
            ax = -ax
        ay = rotation.y
        if ay < 0.0:
            ay = -ay
        az = rotation.z
        if az < 0.0:
            az = -az
        aw = rotation.w
        if aw < 0.0:
            aw = -aw
        max_finite: f32 = 340282346638528859811704183484516925440.0
        if not ax <= max_finite or not ay <= max_finite or not az <= max_finite or not aw <= max_finite:
            return Err(CameraError.DegenerateQuaternion)
        scale = ax
        if ay > scale:
            scale = ay
        if az > scale:
            scale = az
        if aw > scale:
            scale = aw
        if not scale > 0.0:
            return Err(CameraError.DegenerateQuaternion)
        scaled_x = rotation.x / scale
        scaled_y = rotation.y / scale
        scaled_z = rotation.z / scale
        scaled_w = rotation.w / scale
        norm_squared = scaled_x * scaled_x + scaled_y * scaled_y + scaled_z * scaled_z + scaled_w * scaled_w
        if not norm_squared > 0.0:
            return Err(CameraError.DegenerateQuaternion)
        inverse_norm = 1.0 / sqrt_scalar(norm_squared)
        x = scaled_x * inverse_norm
        y = scaled_y * inverse_norm
        z = scaled_z * inverse_norm
        w = scaled_w * inverse_norm
        right = Vec3(
            x=1.0 - 2.0 * (y * y + z * z),
            y=2.0 * (x * y + w * z),
            z=2.0 * (x * z - w * y),
        )
        up = Vec3(
            x=2.0 * (x * y - w * z),
            y=1.0 - 2.0 * (x * x + z * z),
            z=2.0 * (y * z + w * x),
        )
        forward = Vec3(
            x=2.0 * (x * z + w * y),
            y=2.0 * (y * z - w * x),
            z=1.0 - 2.0 * (x * x + y * y),
        )
        return Ok(Camera(eye=eye, forward=forward, right=right, up=up))

    pub fn explicit(eye: Vec3, authored_forward: Vec3, authored_right: Vec3, authored_up: Vec3) -> Result[Camera, CameraError]:
        forward_length = length3(authored_forward)
        if not forward_length > 0.0:
            return Err(CameraError.DegenerateForward)
        forward = Vec3(
            x=authored_forward.x / forward_length,
            y=authored_forward.y / forward_length,
            z=authored_forward.z / forward_length,
        )
        projection = dot3(authored_right, forward)
        right_seed = Vec3(
            x=authored_right.x - projection * forward.x,
            y=authored_right.y - projection * forward.y,
            z=authored_right.z - projection * forward.z,
        )
        right_length = length3(right_seed)
        if not right_length > 0.0:
            return Err(CameraError.InvalidBasis)
        right = Vec3(
            x=right_seed.x / right_length,
            y=right_seed.y / right_length,
            z=right_seed.z / right_length,
        )
        up = cross3(forward, right)
        authored_up_length = length3(authored_up)
        if not authored_up_length > 0.0:
            return Err(CameraError.DegenerateUp)
        authored_up_direction = Vec3(
            x=authored_up.x / authored_up_length,
            y=authored_up.y / authored_up_length,
            z=authored_up.z / authored_up_length,
        )
        if not dot3(up, authored_up_direction) > 0.0:
            return Err(CameraError.InvalidBasis)
        return Ok(Camera(eye=eye, forward=forward, right=right, up=up))

    fn __wrela_p5_finite(read self) -> bool:
        return (
            __wrela_pixels_p5_finite(self.eye.x)
            and __wrela_pixels_p5_finite(self.eye.y)
            and __wrela_pixels_p5_finite(self.eye.z)
            and __wrela_pixels_p5_finite(self.forward.x)
            and __wrela_pixels_p5_finite(self.forward.y)
            and __wrela_pixels_p5_finite(self.forward.z)
            and __wrela_pixels_p5_finite(self.right.x)
            and __wrela_pixels_p5_finite(self.right.y)
            and __wrela_pixels_p5_finite(self.right.z)
            and __wrela_pixels_p5_finite(self.up.x)
            and __wrela_pixels_p5_finite(self.up.y)
            and __wrela_pixels_p5_finite(self.up.z)
        )

pub enum LightKind:
    Disabled
    Point
    Directional
    Rectangle
    Disk

pub struct Light:
    kind: usize
    position: Vec3
    direction: Vec3
    axis_u: Vec3
    axis_v: Vec3
    radiance: Rgb

    pub fn zero() -> Light:
        zero = Vec3(x=0.0, y=0.0, z=0.0)
        black = Rgb(r=0.0, g=0.0, b=0.0)
        return Light(
            kind=0,
            position=zero,
            direction=zero,
            axis_u=zero,
            axis_v=zero,
            radiance=black,
        )

    pub fn point(position: Vec3, radiance: Rgb) -> Light:
        radius = Vec3(x=0.05, y=0.0, z=0.0)
        zero = Vec3(x=0.0, y=0.0, z=0.0)
        return Light(
            kind=1,
            position=position,
            direction=zero,
            axis_u=radius,
            axis_v=zero,
            radiance=radiance,
        )

    pub fn point_radius(position: Vec3, radius: f32, radiance: Rgb) -> Light:
        zero = Vec3(x=0.0, y=0.0, z=0.0)
        return Light(
            kind=1,
            position=position,
            direction=zero,
            axis_u=Vec3(x=radius, y=0.0, z=0.0),
            axis_v=zero,
            radiance=radiance,
        )

    pub fn directional(direction: Vec3, radiance: Rgb) -> Light:
        zero = Vec3(x=0.0, y=0.0, z=0.0)
        return Light(
            kind=2,
            position=zero,
            direction=direction,
            axis_u=zero,
            axis_v=zero,
            radiance=radiance,
        )

    pub fn rectangle(center: Vec3, axis_u: Vec3, axis_v: Vec3, radiance: Rgb) -> Light:
        zero = Vec3(x=0.0, y=0.0, z=0.0)
        return Light(
            kind=3,
            position=center,
            direction=zero,
            axis_u=axis_u,
            axis_v=axis_v,
            radiance=radiance,
        )

    pub fn disk(center: Vec3, normal: Vec3, radius: f32, radiance: Rgb) -> Light:
        zero = Vec3(x=0.0, y=0.0, z=0.0)
        if (
            not __wrela_pixels_p5_finite(normal.x)
            or not __wrela_pixels_p5_finite(normal.y)
            or not __wrela_pixels_p5_finite(normal.z)
            or not __wrela_pixels_p5_finite(radius)
            or not radius > 0.0
        ):
            return Light(
                kind=4,
                position=center,
                direction=zero,
                axis_u=zero,
                axis_v=zero,
                radiance=radiance,
            )
        normal_length = length3(normal)
        if not normal_length > 0.0:
            return Light(
                kind=4,
                position=center,
                direction=zero,
                axis_u=zero,
                axis_v=zero,
                radiance=radiance,
            )
        unit_normal = Vec3(
            x=normal.x / normal_length,
            y=normal.y / normal_length,
            z=normal.z / normal_length,
        )
        abs_x = unit_normal.x
        if abs_x < 0.0:
            abs_x = 0.0 - abs_x
        abs_y = unit_normal.y
        if abs_y < 0.0:
            abs_y = 0.0 - abs_y
        abs_z = unit_normal.z
        if abs_z < 0.0:
            abs_z = 0.0 - abs_z
        helper = Vec3(x=0.0, y=0.0, z=1.0)
        if abs_x <= abs_y and abs_x <= abs_z:
            helper = Vec3(x=1.0, y=0.0, z=0.0)
        elif abs_y <= abs_z:
            helper = Vec3(x=0.0, y=1.0, z=0.0)
        axis_u_seed = cross3(helper, unit_normal)
        axis_u_length = length3(axis_u_seed)
        if not axis_u_length > 0.0:
            return Light(
                kind=4,
                position=center,
                direction=zero,
                axis_u=zero,
                axis_v=zero,
                radiance=radiance,
            )
        axis_u_unit = Vec3(
            x=axis_u_seed.x / axis_u_length,
            y=axis_u_seed.y / axis_u_length,
            z=axis_u_seed.z / axis_u_length,
        )
        axis_v_seed = cross3(unit_normal, axis_u_unit)
        axis_v_length = length3(axis_v_seed)
        if not axis_v_length > 0.0:
            return Light(
                kind=4,
                position=center,
                direction=zero,
                axis_u=zero,
                axis_v=zero,
                radiance=radiance,
            )
        return Light(
            kind=4,
            position=center,
            direction=zero,
            axis_u=Vec3(
                x=axis_u_unit.x * radius,
                y=axis_u_unit.y * radius,
                z=axis_u_unit.z * radius,
            ),
            axis_v=Vec3(
                x=axis_v_seed.x / axis_v_length * radius,
                y=axis_v_seed.y / axis_v_length * radius,
                z=axis_v_seed.z / axis_v_length * radius,
            ),
            radiance=radiance,
        )

    pub fn __wrela_p5_matches_kind(read self, expected: usize) -> bool:
        return self.kind == expected

    pub fn __wrela_p5_finite(read self) -> bool:
        return (
            __wrela_pixels_p5_finite(self.position.x)
            and __wrela_pixels_p5_finite(self.position.y)
            and __wrela_pixels_p5_finite(self.position.z)
            and __wrela_pixels_p5_finite(self.direction.x)
            and __wrela_pixels_p5_finite(self.direction.y)
            and __wrela_pixels_p5_finite(self.direction.z)
            and __wrela_pixels_p5_finite(self.axis_u.x)
            and __wrela_pixels_p5_finite(self.axis_u.y)
            and __wrela_pixels_p5_finite(self.axis_u.z)
            and __wrela_pixels_p5_finite(self.axis_v.x)
            and __wrela_pixels_p5_finite(self.axis_v.y)
            and __wrela_pixels_p5_finite(self.axis_v.z)
            and __wrela_pixels_p5_finite(self.radiance.r)
            and __wrela_pixels_p5_finite(self.radiance.g)
            and __wrela_pixels_p5_finite(self.radiance.b)
        )

    fn __wrela_p9_in_world(read self, read bounds: RendererFrameBounds) -> bool:
        return (
            self.position.x >= bounds.world_min_x and self.position.x <= bounds.world_max_x
            and self.position.y >= bounds.world_min_y and self.position.y <= bounds.world_max_y
            and self.position.z >= bounds.world_min_z and self.position.z <= bounds.world_max_z
        )

    fn __wrela_p9_area_axes_valid(read self) -> bool:
        # Rescale each axis by its own largest component. The resulting
        # squared-cosine test is scale invariant, cannot overflow, and needs
        # no helper declaration outside Light's imported signature.
        u_scale = self.axis_u.x
        if u_scale < 0.0:
            u_scale = 0.0 - u_scale
        u_y = self.axis_u.y
        if u_y < 0.0:
            u_y = 0.0 - u_y
        if u_y > u_scale:
            u_scale = u_y
        u_z = self.axis_u.z
        if u_z < 0.0:
            u_z = 0.0 - u_z
        if u_z > u_scale:
            u_scale = u_z
        v_scale = self.axis_v.x
        if v_scale < 0.0:
            v_scale = 0.0 - v_scale
        v_y = self.axis_v.y
        if v_y < 0.0:
            v_y = 0.0 - v_y
        if v_y > v_scale:
            v_scale = v_y
        v_z = self.axis_v.z
        if v_z < 0.0:
            v_z = 0.0 - v_z
        if v_z > v_scale:
            v_scale = v_z
        if not u_scale > 0.0 or not v_scale > 0.0:
            return false
        ux = self.axis_u.x / u_scale
        uy = self.axis_u.y / u_scale
        uz = self.axis_u.z / u_scale
        vx = self.axis_v.x / v_scale
        vy = self.axis_v.y / v_scale
        vz = self.axis_v.z / v_scale
        u2 = ux * ux + uy * uy + uz * uz
        v2 = vx * vx + vy * vy + vz * vz
        axis_dot = ux * vx + uy * vy + uz * vz
        return axis_dot * axis_dot <= 0.00000001 * u2 * v2

    fn __wrela_p9_disk_axes_valid(read self) -> bool:
        if not self.__wrela_p9_area_axes_valid():
            return false
        u2 = (
            self.axis_u.x * self.axis_u.x
            + self.axis_u.y * self.axis_u.y
            + self.axis_u.z * self.axis_u.z
        )
        v2 = (
            self.axis_v.x * self.axis_v.x
            + self.axis_v.y * self.axis_v.y
            + self.axis_v.z * self.axis_v.z
        )
        largest = u2
        if v2 > largest:
            largest = v2
        difference = u2 - v2
        if difference < 0.0:
            difference = 0.0 - difference
        return difference <= largest * 0.0001

    pub fn __wrela_p9_valid(
        read self,
        read bounds: RendererFrameBounds,
        read range: [f32; 12],
    ) -> bool:
        if range[0] != 1.0:
            return false
        if (
            self.radiance.r < 0.0 or self.radiance.r > range[8]
            or self.radiance.g < 0.0 or self.radiance.g > range[9]
            or self.radiance.b < 0.0 or self.radiance.b > range[10]
        ):
            return false
        if self.kind == 0:
            return (
                self.position.x == 0.0 and self.position.y == 0.0 and self.position.z == 0.0
                and self.direction.x == 0.0 and self.direction.y == 0.0 and self.direction.z == 0.0
                and self.axis_u.x == 0.0 and self.axis_u.y == 0.0 and self.axis_u.z == 0.0
                and self.axis_v.x == 0.0 and self.axis_v.y == 0.0 and self.axis_v.z == 0.0
                and self.radiance.r == 0.0 and self.radiance.g == 0.0 and self.radiance.b == 0.0
            )
        in_slot_position = (
            self.position.x >= range[1] and self.position.x <= range[4]
            and self.position.y >= range[2] and self.position.y <= range[5]
            and self.position.z >= range[3] and self.position.z <= range[6]
        )
        axis_max = range[7]
        axes_bounded = (
            self.direction.x >= 0.0 - axis_max and self.direction.x <= axis_max
            and self.direction.y >= 0.0 - axis_max and self.direction.y <= axis_max
            and self.direction.z >= 0.0 - axis_max and self.direction.z <= axis_max
            and self.axis_u.x >= 0.0 - axis_max and self.axis_u.x <= axis_max
            and self.axis_u.y >= 0.0 - axis_max and self.axis_u.y <= axis_max
            and self.axis_u.z >= 0.0 - axis_max and self.axis_u.z <= axis_max
            and self.axis_v.x >= 0.0 - axis_max and self.axis_v.x <= axis_max
            and self.axis_v.y >= 0.0 - axis_max and self.axis_v.y <= axis_max
            and self.axis_v.z >= 0.0 - axis_max and self.axis_v.z <= axis_max
        )
        if not axes_bounded:
            return false
        if self.kind == 1:
            return in_slot_position and self.axis_u.x >= 0.000244140625 and self.axis_u.x <= axis_max
        if self.kind == 2:
            direction_length_squared = (
                self.direction.x * self.direction.x
                + self.direction.y * self.direction.y
                + self.direction.z * self.direction.z
            )
            return direction_length_squared >= 0.9999 and direction_length_squared <= 1.0001
        if self.kind == 3:
            return (
                in_slot_position
                and self.__wrela_p9_area_axes_valid()
            )
        if self.kind == 4:
            return in_slot_position and self.__wrela_p9_disk_axes_valid()
        return false

@test
fn p9_disk_constructor_uses_normal_and_equal_radius_axes():
    disk = Light.disk(
        Vec3(x=1.0, y=2.0, z=3.0),
        Vec3(x=0.0, y=0.0, z=2.0),
        3.0,
        Rgb(r=4.0, g=5.0, b=6.0),
    )
    assert disk.kind == 4, "disk constructor retains the sealed disk kind"
    assert disk.axis_u.x == 0.0 and disk.axis_u.y == -3.0 and disk.axis_u.z == 0.0, "disk first half axis is deterministic"
    assert disk.axis_v.x == 3.0 and disk.axis_v.y == 0.0 and disk.axis_v.z == 0.0, "disk second half axis uses the same radius"
    assert disk.__wrela_p9_disk_axes_valid(), "disk axes preserve the one source radius"
    invalid = Light.disk(
        Vec3(x=0.0, y=0.0, z=0.0),
        Vec3(x=0.0, y=0.0, z=0.0),
        1.0,
        Rgb(r=1.0, g=1.0, b=1.0),
    )
    assert not invalid.__wrela_p9_area_axes_valid(), "a zero disk normal fails closed"

pub struct LightFrame:
    lights: [Light; 8]

    pub fn empty() -> LightFrame:
        return LightFrame(lights=[
            Light.zero(),
            Light.zero(),
            Light.zero(),
            Light.zero(),
            Light.zero(),
            Light.zero(),
            Light.zero(),
            Light.zero(),
        ])

    pub fn fixed(lights: [Light; 8]) -> LightFrame:
        return LightFrame(lights=lights)

    pub fn snapshot_kinds(read self) -> [u64; 8]:
        kinds: [u64; 8] = [0; 8]
        index: usize = 0
        @budget(bound=8)
        while index < 8:
            kinds[index] = self.lights[index].kind.to[u64]()
            index = index + 1
        return kinds

    pub fn snapshot_scalars(read self) -> [f32; 120]:
        values: [f32; 120] = [0.0; 120]
        index: usize = 0
        @budget(bound=8)
        while index < 8:
            light = self.lights[index]
            base = index * 15
            values[base] = light.position.x
            values[base + 1] = light.position.y
            values[base + 2] = light.position.z
            values[base + 3] = light.direction.x
            values[base + 4] = light.direction.y
            values[base + 5] = light.direction.z
            values[base + 6] = light.axis_u.x
            values[base + 7] = light.axis_u.y
            values[base + 8] = light.axis_u.z
            values[base + 9] = light.axis_v.x
            values[base + 10] = light.axis_v.y
            values[base + 11] = light.axis_v.z
            values[base + 12] = light.radiance.r
            values[base + 13] = light.radiance.g
            values[base + 14] = light.radiance.b
            index = index + 1
        return values

    fn from_snapshot(read kinds: [u64; 8], read values: [f32; 120]) -> LightFrame:
        lights: [Light; 8] = [
            Light.zero(),
            Light.zero(),
            Light.zero(),
            Light.zero(),
            Light.zero(),
            Light.zero(),
            Light.zero(),
            Light.zero(),
        ]
        index: usize = 0
        @budget(bound=8)
        while index < 8:
            base = index * 15
            lights[index] = Light(
                kind=kinds[index].to[usize](),
                position=Vec3(x=values[base], y=values[base + 1], z=values[base + 2]),
                direction=Vec3(x=values[base + 3], y=values[base + 4], z=values[base + 5]),
                axis_u=Vec3(x=values[base + 6], y=values[base + 7], z=values[base + 8]),
                axis_v=Vec3(x=values[base + 9], y=values[base + 10], z=values[base + 11]),
                radiance=Rgb(r=values[base + 12], g=values[base + 13], b=values[base + 14]),
            )
            index = index + 1
        return LightFrame(lights=lights)

pub struct ScalarRange:
    pub min: f32
    pub max: f32

pub struct RgbRange:
    pub min: Rgb
    pub max: Rgb

    pub fn black_to_hdr_white() -> RgbRange:
        return RgbRange(
            min=Rgb(r=0.0, g=0.0, b=0.0),
            max=Rgb(r=16.0, g=16.0, b=16.0),
        )

pub struct CameraBounds:
    # Version 1 seals a world-relative pose box. The renderer declaration
    # centers eye x/y on the world AABB, places eye z behind its minimum-z
    # face, bounds basis-component displacement from the canonical
    # forward-facing pose, and uses a 90-degree vertical field of view.
    max_motion: f32

    # max_motion is the absolute eye/basis component radius about the
    # canonical pose and the maximum accepted inter-frame component change.
    # A camera authored with look_at/quaternion/explicit must fit this box;
    # turns up to a component delta of 1 require bounded(1.0).
    pub fn bounded(max_motion: f32) -> CameraBounds:
        return CameraBounds(max_motion=max_motion)

    pub fn gameplay_default() -> CameraBounds:
        return CameraBounds(max_motion=0.25)

pub struct LightRange:
    # A range is attached to one sealed light slot. Position applies to point
    # and area emitters; axis_component_max covers point radius, directional
    # direction, and both area-light half-axis vectors. `max_delta` is the
    # finite per-component frame-to-frame rate premise used by kinetic reuse.
    position_min: Vec3
    position_max: Vec3
    axis_component_max: f32
    radiance_max: Rgb
    max_delta: f32

    pub fn bounded(
        position_min: Vec3,
        position_max: Vec3,
        axis_component_max: f32,
        radiance_max: Rgb,
        max_delta: f32,
    ) -> LightRange:
        return LightRange(
            position_min=position_min,
            position_max=position_max,
            axis_component_max=axis_component_max,
            radiance_max=radiance_max,
            max_delta=max_delta,
        )

    pub fn gameplay_default() -> LightRange:
        return LightRange.bounded(
            position_min=Vec3(x=-65504.0, y=-65504.0, z=-65504.0),
            position_max=Vec3(x=65504.0, y=65504.0, z=65504.0),
            axis_component_max=65504.0,
            radiance_max=Rgb(r=65504.0, g=65504.0, b=65504.0),
            max_delta=65504.0,
        )

pub struct LightConfig:
    capacity: u32
    kinds: [LightKind; 8]
    ranges: [LightRange; 8]

    pub fn fixed(capacity: u32) -> LightConfig:
        return LightConfig(
            capacity=capacity,
            kinds=[
                LightKind.Point,
                LightKind.Point,
                LightKind.Point,
                LightKind.Point,
                LightKind.Point,
                LightKind.Point,
                LightKind.Point,
                LightKind.Point,
            ],
            ranges=[
                LightRange.gameplay_default(),
                LightRange.gameplay_default(),
                LightRange.gameplay_default(),
                LightRange.gameplay_default(),
                LightRange.gameplay_default(),
                LightRange.gameplay_default(),
                LightRange.gameplay_default(),
                LightRange.gameplay_default(),
            ],
        )

    pub fn declared(
        capacity: u32,
        kinds: [LightKind; 8],
        ranges: [LightRange; 8] = [
            LightRange.gameplay_default(),
            LightRange.gameplay_default(),
            LightRange.gameplay_default(),
            LightRange.gameplay_default(),
            LightRange.gameplay_default(),
            LightRange.gameplay_default(),
            LightRange.gameplay_default(),
            LightRange.gameplay_default(),
        ],
    ) -> LightConfig:
        return LightConfig(capacity=capacity, kinds=kinds, ranges=ranges)

    pub fn gameplay_default() -> LightConfig:
        return LightConfig.fixed(capacity=8)

pub struct AoConfig:
    enabled: bool
    radius: f32
    strength: f32

    pub fn fixed(enabled: bool) -> AoConfig:
        return AoConfig(enabled=enabled, radius=1.0, strength=1.0)

    pub fn configured(radius: f32, strength: f32) -> AoConfig:
        return AoConfig(enabled=true, radius=radius, strength=strength)

    pub fn deterministic_v1() -> AoConfig:
        return AoConfig(enabled=true, radius=1.0, strength=1.0)

pub struct ProbeConfig:
    enabled: bool
    static_preinitialized: bool
    levels: u32
    dim_x: u32
    dim_y: u32
    dim_z: u32
    base_spacing: f32
    initialization_worst_case_ms: u32

    pub fn fixed(enabled: bool) -> ProbeConfig:
        if enabled:
            return ProbeConfig(
                enabled=true,
                static_preinitialized=false,
                levels=3,
                dim_x=16,
                dim_y=8,
                dim_z=16,
                base_spacing=1.0,
                initialization_worst_case_ms=250,
            )
        return ProbeConfig(
            enabled=false,
            static_preinitialized=false,
            levels=0,
            dim_x=0,
            dim_y=0,
            dim_z=0,
            base_spacing=1.0,
            initialization_worst_case_ms=0,
        )

    pub fn dynamic_v1(
        base_spacing: f32,
        levels: u32,
        dim_x: u32,
        dim_y: u32,
        dim_z: u32,
        initialization_worst_case_ms: u32,
    ) -> ProbeConfig:
        return ProbeConfig(
            enabled=true,
            static_preinitialized=false,
            levels=levels,
            dim_x=dim_x,
            dim_y=dim_y,
            dim_z=dim_z,
            base_spacing=base_spacing,
            initialization_worst_case_ms=initialization_worst_case_ms,
        )

    pub fn static_v1(
        base_spacing: f32,
        levels: u32,
        dim_x: u32,
        dim_y: u32,
        dim_z: u32,
    ) -> ProbeConfig:
        # Reserved for the source-level embedded-blob extension. The compiler
        # rejects this constructor fail-closed until such a blob is part of
        # the sealed renderer declaration; it must never silently run the
        # dynamic initializer under a static contract.
        return ProbeConfig(
            enabled=true,
            static_preinitialized=true,
            levels=levels,
            dim_x=dim_x,
            dim_y=dim_y,
            dim_z=dim_z,
            base_spacing=base_spacing,
            initialization_worst_case_ms=0,
        )

    pub fn disabled() -> ProbeConfig:
        return ProbeConfig.fixed(enabled=false)

pub enum RenderProfile:
    AaaByteExact

pub enum ToneCurve:
    Linear
    FilmicV1
    # Repository-owned diagnostics use this reserved variant to exercise the
    # fail-closed P018 path. Ordinary source cannot name compiler-reserved
    # `__wrela_` identifiers.
    __wrela_NonMonotoneFixture

pub enum RenderError:
    ParameterOutOfRange(RenderPath)
    NonFiniteInput(RenderPath)
    FrameContractMismatch(RenderPath)
    RootIsolationExhausted(TileId)
    EventIsolationExhausted(TileId)
    CertificateExhausted(TileId)
    CapacityExceeded(RenderCapacity)
    FixedPointRangeExceeded(TileId)
    Display(DisplayError)
    InternalInvariant(RenderInvariant)

