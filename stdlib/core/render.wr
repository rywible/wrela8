                        line_b = (b_value * scale).to[i32]()
                        line_c = (f00 * scale).to[i32]()
                        line_error = (residual * scale).to[i32]() + 4
                        if representation == 5:
                            line_torus = true
                            line_standard_torus = standard_torus
                            line_standard_positive_known = standard_positive_known
                            line_standard_positive_hit = standard_positive_hit
