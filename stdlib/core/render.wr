    pixel_u1 = (((x + 1).to[f32]() / width) * 2.0 - 1.0) * aspect
    pixel_v0 = 1.0 - (y.to[f32]() / height) * 2.0
    pixel_v1 = 1.0 - ((y + 1).to[f32]() / height) * 2.0
    # The tile event table and event span operands are invariant across every
    # refinement cell of this pixel. Collect the small relevant set once so a
    # depth-12 walk does not re-read up to 256 table records per cell. More
    # than eight relevant curves is a valid scene but beyond this optional
    # analytic tier; decline and let the general arrangement walk own it.
    relevant_events: [u32; 8] = [0; 8]
    relevant_representations: [u8; 8] = [0; 8]
    relevant_count: u8 = 0
    owner_event: i64 = -1
    tile_ordinal: u32 = 0
