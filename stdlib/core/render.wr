pub struct P7CertifiedRow:
    pub ok: bool
    pub error: u8
    pub x0: u16
    pub x1: u16
    pub samples: [P7VisibilitySample; 16]
    pub starts: [u16; 16]
    pub ends: [u16; 16]
    pub count: u8
    pub run_count: u8
    pub corridor_count: u8
    pub root_count: u32
    # The implicit-jet transport model of a single-span row (decision-inert
    # P7.8 evidence). Kept on the row rather than every sample so the
    # sample struct stays small enough to copy cheaply.
    pub modeled: bool
    pub model: [i32; 8]

    pub fn failure() -> P7CertifiedRow:
        return P7CertifiedRow.failure_with(4)

    pub fn failure_with(error: u8) -> P7CertifiedRow:
        return P7CertifiedRow(
            ok=false,
            error=error,
            x0=0,
            x1=0,
            samples=[P7VisibilitySample.background(); 16],
            starts=[0; 16],
            ends=[0; 16],
            count=0,
            run_count=0,
            corridor_count=0,
            root_count=0,
            modeled=false,
            model=[0; 8],
        )

pub struct P7RowCertificationContext:
    pub renderer: usize
    pub worker: u32
    pub tile: u32
    pub y: u32
    pub x0: u32
    pub x1: u32
    pub proposal: P7CertifiedRow
    pub proposals_enabled: bool

pub fn __wrela_pixels_p7_debug_probe(
    renderer: usize,
    tile: u32,
    x: u32,
    y: u32,
    read params: [f32; 16],
    read camera: [f32; 12],
) -> [i64; 15]:
    snapshot = FrameInputSnapshot.from_packed(
        params,
        __wrela_pixels_p7_numeric_config(renderer)[6].to[u16](),
        camera,
    )
    candidates = __wrela_pixels_p7_row_candidates(renderer, tile, y, snapshot)
    roots = __wrela_pixels_p7_collect_roots(renderer, 0, x, y, candidates, snapshot)
    config = __wrela_pixels_p7_numeric_config(renderer)
    width = config[1].to[u32]()
    height = config[2].to[u32]()
    u = (((x.to[f32]() + 0.5) / width.to[f32]()) * 2.0 - 1.0) * width.to[f32]() / height.to[f32]()
    v = 1.0 - ((y.to[f32]() + 0.5) / height.to[f32]()) * 2.0
    sample = __wrela_pixels_p7_select_visibility(renderer, roots)
    values = sample.debug_values()
    normal: [f32; 4] = [0.0; 4]
    if values[1] == 1 and values[2] == 0:
        normal = __wrela_pixels_p7_feature_normal(
            renderer,
            values[8].to[u32](),
            u,
            v,
            __wrela_pixels_p7_raw_to_f32(
                (values[5] + (values[6] - values[5]) / 2).to[i32](),
                __wrela_pixels_p7_numeric_config(renderer)[3].to[i32](),
            ),
            params,
            camera,
        )
    return [
        values[0],
        values[1],
        values[2],
        values[3],
        values[4],
        values[5],
        values[6],
        roots.debug_count().to[i64](),
        candidates.debug_count().to[i64](),
        values[9],
        normal[0].to[i64](),
        (normal[1] * 1000000.0).to[i64](),
        (normal[2] * 1000000.0).to[i64](),
        (normal[3] * 1000000.0).to[i64](),
        values[10],
    ]

pub fn __wrela_pixels_p7_debug_probe_at_u(
    renderer: usize,
    worker: u32,
    tile: u32,
    x: u32,
    y: u32,
    u: f32,
    read params: [f32; 16],
    read camera: [f32; 12],
) -> [i64; 10]:
    if not __wrela_pixels_p7_frame_snapshot_store(
        renderer,
        params,
        __wrela_pixels_p7_numeric_config(renderer)[6].to[u16](),
        camera,
        [0; 8],
        [0.0; 120],
        [0.0; 4],
        0,
    ):
        return [0; 10]
    snapshot = FrameInputSnapshot.from_packed(
        params,
        __wrela_pixels_p7_numeric_config(renderer)[6].to[u16](),
        camera,
    )
    candidates = __wrela_pixels_p7_row_candidates(renderer, tile, y, snapshot)
    roots = __wrela_pixels_p7_collect_roots_box(
        renderer,
        worker,
        x,
        x + 1,
        y,
        [
            u,
            1.0 - ((y.to[f32]() + 0.5) / __wrela_pixels_p7_numeric_config(renderer)[2].to[f32]()) * 2.0,
            0.0,
            0.0,
        ],
        candidates,
        snapshot,
    )
    sample = __wrela_pixels_p7_select_visibility(renderer, roots)
    values = sample.debug_values()
    return [
        values[0],
        values[1],
        0,
        values[3],
        values[4],
        values[5],
        values[6],
        roots.debug_count().to[i64](),
        candidates.debug_count().to[i64](),
        values[9],
    ]

pub fn __wrela_pixels_p7_debug_frame_digest(renderer: usize) -> [u64; 5]:
    return __wrela_pixels_p8_digest(renderer)

pub fn __wrela_pixels_p7_debug_alpha_samples(renderer: usize) -> u64:
    config = __wrela_pixels_p7_numeric_config(renderer)
    if config[0] != 1:
        return 18446744073709551615
    samples: [u64; 3] = [
        ((16 * config[1] + 31) * 4 + 3).to[u64](),
        ((16 * config[1] + 32) * 4 + 3).to[u64](),
        ((16 * config[1] + 40) * 4 + 3).to[u64](),
    ]
    packed: u64 = 0
    sample: usize = 0
    @budget(bound=3)
    while sample < 3:
        loaded = __wrela_pixels_p8_visible_byte(renderer, samples[sample].to[usize]())
        if loaded[0] != 1:
            return 18446744073709551615
        packed = packed | (loaded[1] << (sample * 8).to[u64]())
        sample = sample + 1
    return packed

pub fn __wrela_pixels_p7_debug_certified_run_word(
    renderer: usize,
    worker: u32,
    record: u32,
    word: usize,
) -> [u64; 2]:
    return __wrela_pixels_p7_workspace_load_certified_run_word(
        renderer,
        worker,
        record,
        word,
    )

async fn pixels_p7_worker_job_4_0(worker: Actor[RendererWorker0], word: u64) -> u64:
    result = await worker.run_job(word=word)
    return __wrela_pixels_p7_job_value(take result)

async fn pixels_p7_worker_job_4_1(worker: Actor[RendererWorker1], word: u64) -> u64:
    result = await worker.run_job(word=word)
    return __wrela_pixels_p7_job_value(take result)

async fn pixels_p7_worker_job_4_2(worker: Actor[RendererWorker2], word: u64) -> u64:
    result = await worker.run_job(word=word)
    return __wrela_pixels_p7_job_value(take result)

async fn pixels_p7_worker_job_4_3(worker: Actor[RendererWorker3], word: u64) -> u64:
    result = await worker.run_job(word=word)
    return __wrela_pixels_p7_job_value(take result)

pub struct RendererWorkers:
    worker_0: Actor[RendererWorker0]
    worker_1: Actor[RendererWorker1]
    worker_2: Actor[RendererWorker2]
    worker_3: Actor[RendererWorker3]

pub struct RendererPlacementState:
    frameprog_base: usize
    state_base: usize
    state_bytes: usize
    worker_assignment_0: RendererWorkerAssignment
    worker_assignment_1: RendererWorkerAssignment
    worker_assignment_2: RendererWorkerAssignment
    worker_assignment_3: RendererWorkerAssignment

pub struct RendererDigestState:
    pub ok: bool
    pub digest: u64
    pub error: u8
    pub tile: u32

pub fn __wrela_pixels_p7_digest_result(state: RendererDigestState, take result: Result[u64, CallError[never]]) -> RendererDigestState:
    @discard(reason="worker call failure becomes an explicit failed digest state")
    match result:
        case .Ok(value):
            error = __wrela_pixels_p7_worker_error_code(value)
            if not state.ok:
                return state
            if error != 0:
                return RendererDigestState(
                    ok=false,
                    digest=0,
                    error=error,
                    tile=__wrela_pixels_p7_worker_error_tile(value),
                )
            if value == 0:
                return state
            return RendererDigestState(
                ok=true,
                digest=state.digest +% value,
                error=0,
                tile=0,
            )
        case .Err(call_error):
            match call_error:
                case .Cancelled:
                    return RendererDigestState(ok=false, digest=0, error=8, tile=0)
                case .DeadlineExceeded:
                    return RendererDigestState(ok=false, digest=0, error=9, tile=0)
                case .NotAdmitted(_, _):
                    return RendererDigestState(ok=false, digest=0, error=10, tile=0)
                case .Op(_):
                    return RendererDigestState(ok=false, digest=0, error=12, tile=0)

pub struct RendererFrameBounds:
    exposure_min: f32
    exposure_max: f32
    environment_min_r: f32
    environment_min_g: f32
    environment_min_b: f32
    environment_max_r: f32
    environment_max_g: f32
    environment_max_b: f32
    camera_eye_x_min: f32
    camera_eye_x_max: f32
    camera_eye_y_min: f32
    camera_eye_y_max: f32
    camera_eye_z_min: f32
    camera_eye_z_max: f32
    camera_forward_x_min: f32
    camera_forward_x_max: f32
    camera_forward_y_min: f32
    camera_forward_y_max: f32
    camera_forward_z_min: f32
    camera_forward_z_max: f32
    camera_right_x_min: f32
    camera_right_x_max: f32
    camera_right_y_min: f32
    camera_right_y_max: f32
    camera_right_z_min: f32
    camera_right_z_max: f32
    camera_up_x_min: f32
    camera_up_x_max: f32
    camera_up_y_min: f32
    camera_up_y_max: f32
    camera_up_z_min: f32
    camera_up_z_max: f32
    world_min_x: f32
    world_min_y: f32
    world_min_z: f32
    world_max_x: f32
    world_max_y: f32
    world_max_z: f32
    light_capacity: usize
    light_kind_0: usize
    light_kind_1: usize
    light_kind_2: usize
    light_kind_3: usize
    light_kind_4: usize
    light_kind_5: usize
    light_kind_6: usize
    light_kind_7: usize

    pub fn __wrela_p5_accepts_camera(read self, read camera: Camera) -> bool:
        return (
            camera.eye.x >= self.camera_eye_x_min
            and camera.eye.x <= self.camera_eye_x_max
            and camera.eye.y >= self.camera_eye_y_min
            and camera.eye.y <= self.camera_eye_y_max
            and camera.eye.z >= self.camera_eye_z_min
            and camera.eye.z <= self.camera_eye_z_max
            and camera.forward.x >= self.camera_forward_x_min
            and camera.forward.x <= self.camera_forward_x_max
            and camera.forward.y >= self.camera_forward_y_min
            and camera.forward.y <= self.camera_forward_y_max
            and camera.forward.z >= self.camera_forward_z_min
            and camera.forward.z <= self.camera_forward_z_max
            and camera.right.x >= self.camera_right_x_min
            and camera.right.x <= self.camera_right_x_max
            and camera.right.y >= self.camera_right_y_min
            and camera.right.y <= self.camera_right_y_max
            and camera.right.z >= self.camera_right_z_min
            and camera.right.z <= self.camera_right_z_max
            and camera.up.x >= self.camera_up_x_min
            and camera.up.x <= self.camera_up_x_max
            and camera.up.y >= self.camera_up_y_min
            and camera.up.y <= self.camera_up_y_max
            and camera.up.z >= self.camera_up_z_min
            and camera.up.z <= self.camera_up_z_max
        )

@actor
pub struct Renderer[P]:
    workers: RendererWorkers
    worker_count: u32
    display: usize
    renderer_index: u32
    frameprog_base: usize
    state_base: usize
    state_bytes: usize
    worker_assignment_0: RendererWorkerAssignment
    worker_assignment_1: RendererWorkerAssignment
    worker_assignment_2: RendererWorkerAssignment
    worker_assignment_3: RendererWorkerAssignment
    bounds: RendererFrameBounds
    program_valid: bool

    init(
        mut self,
        workers: RendererWorkers,
        worker_count: u32,
        display: usize,
        renderer_index: u32,
        placement: RendererPlacementState,
        bounds: RendererFrameBounds,
    ):
        self.workers = workers
        self.worker_count = worker_count
        self.display = display
        self.renderer_index = renderer_index
        self.frameprog_base = placement.frameprog_base
        self.state_base = placement.state_base
        self.state_bytes = placement.state_bytes
        self.worker_assignment_0 = placement.worker_assignment_0
        self.worker_assignment_1 = placement.worker_assignment_1
        self.worker_assignment_2 = placement.worker_assignment_2
        self.worker_assignment_3 = placement.worker_assignment_3
        self.bounds = bounds
        # Header, directory, digest, revision, flags, and reserved fields are
        # checked once at actor initialization. Per-frame turns only use the
        # checked, compiler-generated accessors.
        self.program_valid = (
            __wrela_pixels_program_validate(renderer_index.to[usize]())
            and __wrela_pixels_p8_initialize(renderer_index.to[usize]())
        )

    fn __validate_fixed_frame(read self, read frame: RenderFrame[P])
        -> Result[unit, RenderError]:
        if not __wrela_pixels_p5_finite(frame.exposure):
            return Err(RenderError.NonFiniteInput(RenderPath(component=2)))
        if frame.exposure < self.bounds.exposure_min or frame.exposure > self.bounds.exposure_max:
            return Err(RenderError.ParameterOutOfRange(RenderPath(component=2)))
        # FilmicV1's deterministic multiplier table is defined on an exact
        # 1/256-stop lattice. Values between lattice points are unsupported,
        # not silently rounded with an unbudgeted post-processing error.
        exposure_code = frame.exposure * 256.0
        if exposure_code.to[i32]().to[f32]() != exposure_code:
            return Err(RenderError.FrameContractMismatch(RenderPath(component=2)))
        if (
            not __wrela_pixels_p5_finite(frame.environment.r)
            or not __wrela_pixels_p5_finite(frame.environment.g)
            or not __wrela_pixels_p5_finite(frame.environment.b)
        ):
            return Err(RenderError.NonFiniteInput(RenderPath(component=3)))
        if (
            frame.environment.r < self.bounds.environment_min_r
            or frame.environment.r > self.bounds.environment_max_r
            or frame.environment.g < self.bounds.environment_min_g
            or frame.environment.g > self.bounds.environment_max_g
            or frame.environment.b < self.bounds.environment_min_b
            or frame.environment.b > self.bounds.environment_max_b
        ):
            return Err(RenderError.ParameterOutOfRange(RenderPath(component=3)))
        if not frame.camera.__wrela_p5_finite():
            return Err(RenderError.NonFiniteInput(RenderPath(component=4)))
        if not self.bounds.__wrela_p5_accepts_camera(frame.camera):
            return Err(RenderError.FrameContractMismatch(RenderPath(component=4)))
        # Frame indices and motion limits guide cross-frame proof reuse. This
        # renderer rebuilds each frame, so neither is a legal-input boundary.
        index: usize = 0
        @budget(bound=8)
        while index < 8:
            light = frame.lights.lights[index]
            light_range = __wrela_pixels_p9_light_range(
                self.renderer_index.to[usize](), index,
            )
            if not light.__wrela_p5_finite():
                return Err(RenderError.NonFiniteInput(RenderPath(component=5)))
            if not light.__wrela_p9_valid(self.bounds, light_range):
                return Err(RenderError.ParameterOutOfRange(RenderPath(component=5)))
            # light_range[11] is a soft cross-frame reuse premise, not a hard
            # legal-input bound. This renderer rebuilds its per-frame proof
            # state, so exceeding the motion budget remains valid and
            # byte-equivalent to an explicit from-scratch render.
            expected_kind: usize = 0
            if index == 0:
                expected_kind = self.bounds.light_kind_0
            if index == 1:
                expected_kind = self.bounds.light_kind_1
            if index == 2:
                expected_kind = self.bounds.light_kind_2
            if index == 3:
                expected_kind = self.bounds.light_kind_3
            if index == 4:
                expected_kind = self.bounds.light_kind_4
            if index == 5:
                expected_kind = self.bounds.light_kind_5
            if index == 6:
                expected_kind = self.bounds.light_kind_6
            if index == 7:
                expected_kind = self.bounds.light_kind_7
            if index >= self.bounds.light_capacity:
                expected_kind = 0
            if not light.__wrela_p5_matches_kind(expected_kind):
                return Err(RenderError.FrameContractMismatch(RenderPath(component=5)))
            index = index + 1
        return Ok(unit)

    fn __validate_frame(read self, frame: RenderFrame[P]) -> Result[unit, RenderError]:
        fixed = self.__validate_fixed_frame(frame)
        match fixed:
            case .Err(error):
                return Err(take error)
            case .Ok(_):
                pass
        # A renderer may pin its camera to one exact pose (`camera_pose=` on
        # the declaration). Enforcing it here is what converts the analytic
        # coverage tiers' pose precondition from a per-frame runtime test into
        # a compile-time fact: a pinned renderer either renders at the sealed
        # pose or refuses the frame, so the tier is never silently unavailable.
        pinned = __wrela_pixels_p7_pinned_camera(self.renderer_index.to[usize]())
        if pinned[0] == 1.0:
            if (
                frame.camera.eye.x != pinned[1] or frame.camera.eye.y != pinned[2]
                or frame.camera.eye.z != pinned[3]
                or frame.camera.forward.x != pinned[4]
                or frame.camera.forward.y != pinned[5]
                or frame.camera.forward.z != pinned[6]
                or frame.camera.right.x != pinned[7]
                or frame.camera.right.y != pinned[8]
                or frame.camera.right.z != pinned[9]
                or frame.camera.up.x != pinned[10]
                or frame.camera.up.y != pinned[11]
                or frame.camera.up.z != pinned[12]
            ):
                return Err(RenderError.ParameterOutOfRange(RenderPath(component=6)))
        return Ok(unit)

    fn __snapshot_frame(read self, read frame: RenderFrame[P]) -> FrameInputSnapshot:
        values: [f32; 16] = [0.0; 16]
        return FrameInputSnapshot.make_frame(
            params=values,
            param_count=0,
            camera=frame.camera,
        )

    fn __construct_final_frame(
        read self,
        take frame: RenderFrame[P],
        worker_digest: u64,
        renderer_index_value: u32,
    )
        -> Result[RenderedFrame[P], RenderFailure[P]]:
        renderer_index = renderer_index_value.to[usize]()
        config = __wrela_pixels_p7_numeric_config(renderer_index)
        if config[0] != 1:
            return self.__internal_error(take frame, 4099)
        expected_pixels = config[1].to[u64]() *% config[2].to[u64]()
        if worker_digest != expected_pixels:
            _ = __wrela_pixels_p8_cancel(renderer_index)
            return self.__worker_error(take frame, 4, 0)
        exact = __wrela_pixels_p7_debug_frame_digest(renderer_index)
        if exact[0] != 1:
            _ = __wrela_pixels_p8_cancel(renderer_index)
            return self.__internal_error(take frame, 4100)
        digest: [u8; 32] = [0; 32]
        word: usize = 0
        @budget(bound=4)
        while word < 4:
            value = exact[word + 1]
            octet: usize = 0
            @budget(bound=8)
            while octet < 8:
                digest[word * 8 + octet] = ((value >> (octet * 8).to[u64]()) & 255).to[u8]()
                octet = octet + 1
            word = word + 1
        certificate_runs: u64 = 0
        event_corridors: u64 = 0
        revalidated_proposals: u64 = 0
        worker: u32 = 0
        @budget(bound=4)
        while worker < self.worker_count:
            runs = __wrela_pixels_p7_workspace_counter(renderer_index, worker, 4)
            proposals = __wrela_pixels_p7_workspace_counter(renderer_index, worker, 5)
            corridors = __wrela_pixels_p7_workspace_counter(renderer_index, worker, 6)
            if runs[0] != 1 or proposals[0] != 1 or corridors[0] != 1:
                _ = __wrela_pixels_p8_cancel(renderer_index)
                return self.__internal_error(take frame, 4101)
            next_runs = certificate_runs +% runs[1]
            next_proposals = revalidated_proposals +% proposals[1]
            next_corridors = event_corridors +% corridors[1]
            if next_runs < certificate_runs or next_proposals < revalidated_proposals or next_corridors < event_corridors:
                _ = __wrela_pixels_p8_cancel(renderer_index)
                return self.__internal_error(take frame, 4102)
            certificate_runs = next_runs
            revalidated_proposals = next_proposals
            event_corridors = next_corridors
            worker = worker + 1
        telemetry_digest: [u64; 4] = [
            1469598103934665603,
            1099511628211,
            7809847782465536322,
            1609587929392839161,
        ]
        telemetry_present = __wrela_pixels_p7_telemetry_counter(
            renderer_index,
            0,
            0,
        )[0] == 1
        counter: usize = 0
        @budget(bound=162)
        while telemetry_present and counter < 162:
            merged: u64 = 0
            worker = 0
            @budget(bound=4)
            while worker < self.worker_count:
                value = __wrela_pixels_p7_telemetry_counter(
                    renderer_index,
                    worker,
                    counter,
                )
                if value[0] != 1:
                    _ = __wrela_pixels_p8_cancel(renderer_index)
                    return self.__internal_error(take frame, 4104)
                next = merged +% value[1]
                if next < merged:
                    _ = __wrela_pixels_p8_cancel(renderer_index)
                    return self.__internal_error(take frame, 4105)
                merged = next
                worker = worker + 1
            telemetry_digest[0] = (telemetry_digest[0] ^ merged) *% 1099511628211
            telemetry_digest[1] = (telemetry_digest[1] +% merged +% counter.to[u64]()) *% 14029467366897019727
            telemetry_digest[2] = (telemetry_digest[2] ^ (merged << (counter % 8).to[u64]())) *% 11400714785074694791
            telemetry_digest[3] = (telemetry_digest[3] +% (merged ^ counter.to[u64]())) *% 9650029242287828579
            counter = counter + 1
        if not telemetry_present:
            telemetry_digest = [0; 4]
        probe_status = __wrela_pixels_p10_probe_status(renderer_index)
        if probe_status[0] != 1:
            _ = __wrela_pixels_p10_probe_invalidate(renderer_index)
            _ = __wrela_pixels_p8_cancel(renderer_index)
            return self.__internal_error(take frame, 4110)
        submission = __wrela_pixels_p8_present(renderer_index, frame.frame_index)
        if submission[0] != 2:
            _ = __wrela_pixels_p8_cancel(renderer_index)
            return self.__internal_error(take frame, 4107)
        raw_digest = __wrela_pixels_p8_raw_digest(renderer_index)
        descriptor_digest = __wrela_pixels_p8_descriptor_digest(renderer_index)
        if raw_digest[0] != 1 or descriptor_digest[0] != 1:
            _ = __wrela_pixels_p8_cancel(renderer_index)
            return self.__internal_error(take frame, 4109)
        doorbell = __wrela_pixels_p8_display_doorbell(renderer_index)
        if doorbell[0] != 1:
            _ = __wrela_pixels_p8_cancel(renderer_index)
            return self.__internal_error(take frame, 4109)
        __wrela_pixels_p8_submit(doorbell[1], submission[1])
        present = __wrela_pixels_p8_complete(renderer_index)
        if present[0] != 1:
            display_error = RenderError.Display(DisplayError(code=present[1].to[u32]()))
            return self.__render_error(
                take frame,
                take display_error,
            )
        frame_index = present[1]
        rendered = RenderedFrame[P](
            params=take frame.params,
            frame_index=frame_index,
            displayed_digest=digest,
            displayed_raw_tile_digest=[raw_digest[1], raw_digest[2], raw_digest[3], raw_digest[4]],
            displayed_tile_descriptor_digest=[descriptor_digest[1], descriptor_digest[2], descriptor_digest[3], descriptor_digest[4]],
            rebuilt_tiles=0,
            reused_tiles=0,
            certificate_runs=certificate_runs,
            event_corridors=event_corridors,
            revalidated_proposals=revalidated_proposals,
            certificate_telemetry_digest=telemetry_digest,
        )
        return Ok(take rendered)

    fn __render_error(
        read self,
        take frame: RenderFrame[P],
        take error: RenderError,
    ) -> Result[RenderedFrame[P], RenderFailure[P]]:
        return Err(RenderFailure[P](params=take frame.params, error=take error))

    fn __internal_error(
        read self,
        take frame: RenderFrame[P],
        kind: u32,
    ) -> Result[RenderedFrame[P], RenderFailure[P]]:
        return Err(RenderFailure[P](
            params=take frame.params,
            error=RenderError.InternalInvariant(RenderInvariant(kind=kind)),
        ))

    fn __worker_error(
        read self,
        take frame: RenderFrame[P],
        error: u8,
        tile: u32,
    ) -> Result[RenderedFrame[P], RenderFailure[P]]:
        # The code-to-class mapping is generated from the single-source
        # worker error table (`pixels::worker_errors` in the compiler); the
        # classifier is regenerated with the image, so this dispatch cannot
        # drift from the table. §2.6: bounded refinement running out of
        # budget is an *expected* fail-closed outcome and carries its own
        # variant; `InternalInvariant` is reserved for corrupt
        # compiler-generated state, and any unregistered code lands there.
        error_class = __wrela_pixels_p7_worker_error_class(error)
        if error_class == 1:
            # Capacity charges are proven ceilings, not corrupt state; the
            # kind equals the worker error code so traces stay
            # self-describing.
            return Err(RenderFailure[P](
                params=take frame.params,
                error=RenderError.CapacityExceeded(RenderCapacity(kind=error.to[u32]())),
            ))
        if error_class == 2:
            return Err(RenderFailure[P](
                params=take frame.params,
                error=RenderError.EventIsolationExhausted(TileId(value=tile)),
            ))
        if error_class == 3:
            # CertificateExhausted reports the worker sub-code in the high
            # half of its tile word, so red traces name their cause.
            return Err(RenderFailure[P](
                params=take frame.params,
                error=RenderError.CertificateExhausted(TileId(
                    value=(tile & 65535) | (error.to[u32]() << 16),
                )),
            ))
        if error_class == 4:
            return Err(RenderFailure[P](
                params=take frame.params,
                error=RenderError.RootIsolationExhausted(TileId(value=tile)),
            ))
        if error_class == 5:
            return Err(RenderFailure[P](
                params=take frame.params,
                error=RenderError.FixedPointRangeExceeded(TileId(value=tile)),
            ))
        return self.__internal_error(
            take frame,
            2147483648 | (error.to[u32]() << 24) | (tile & 16777215),
        )

    pub async fn render(mut self, take frame: RenderFrame[P])
        -> Result[RenderedFrame[P], RenderFailure[P]]:
        # Primary visibility remains P7-certified; P9 consumes it to produce
        # opaque, filmic, byte-certified output from the owned frame snapshot.
        validated = self.__validate_frame(frame)
        match validated:
            case .Err(error):
