                omit = false
                zero_index: u8 = 0
                @budget(bound=8)
                while zero_index < zero_measure_feature_count:
                    if zero_measure_features[zero_index.to[usize]()] == feature_id:
                        omit = true
                    zero_index = zero_index + 1
                if not omit:
                    arrangement_candidates.ids[arrangement_candidates.count.to[usize]()] = feature_id
                    arrangement_candidates.count = arrangement_candidates.count + 1
                candidate_index = candidate_index + 1
            arrangement = __wrela_pixels_p7_combined_arrangement_coverage(
                renderer,
                worker,
                tile,
                x | (y << 16),
                P7ArrangementSet(
                    count=arrangement_count,
                    event_ids=arrangement_ids,
                    event_kinds=arrangement_kinds,
                    event_qs=arrangement_qs,
                    cell_uv=[u0, v0, u1, v1],
                ),
                arrangement_candidates,
                snapshot,
            )
            if arrangement[0] == 1:
                return [1, 1, arrangement[1], 0]
            return [0, arrangement[1], 0, 0]
    # Every occupancy-bearing event covering this pixel reduced to a curve, and
    # every one of those curves provably misses the pixel. The sealed event set
    # is the complete set of visibility boundaries, so occupancy cannot change
    # anywhere inside the pixel and the centre ray names it for the whole area.
    # This is what keeps the rows just off a horizon — conservatively box
    # ambiguous but geometrically uniform — out of the subpixel walk.
    if (
        result[1] == 0
        and classified_curves > 0
        and crossing_curves == 0
        and not unclassified_boundary
        and center_sample.ok
        and not center_sample.event
    ):
        if center_sample.hit:
            return [1, 1, 255, 0]
        return [1, 1, 0, 0]
    if result[1] == 0:
        result[3] = crossing_curves.to[i64]()
    return result

pub fn __wrela_pixels_p7_event_coverage(
    renderer: usize,
    tile: u32,
    x: u32,
    y: u32,
    read sample: P7VisibilitySample,
    read snapshot: FrameInputSnapshot,
) -> [i64; 3]:
    if not sample.ok:
        return [0; 3]
    config = __wrela_pixels_p7_numeric_config(renderer)
    if config[0] != 1:
        return [0; 3]
    if sample.event and sample.proof_method & 127 == 3 and sample.composition_shape == 4:
        return [1, 1, sample.coverage.to[i64]()]
    q_raw = sample.q_lo.to[i64]() + (
        sample.q_hi.to[i64]() - sample.q_lo.to[i64]()
    ) / 2
    q = __wrela_pixels_p7_raw_to_f32(q_raw.to[i32](), config[3].to[i32]())
    integrated = __wrela_pixels_p7_material_event_coverage(
        renderer,
        x,
        y,
        q,
        sample.hit,
        snapshot.params,
        snapshot.camera,
    )
    if integrated[0] != 1:
        return [0; 3]
    if integrated[1] == 1:
        return integrated
    if sample.event and sample.coverage == 0:
        return [1, 1, 0]
    if sample.event:
        return [0; 3]
    return [1, 0, 255]

# `span` packs the half-open pixel range as x0 | (x1 << 16); the packing
# keeps the call inside the backend's eight-argument ceiling.
pub fn __wrela_pixels_p7_pixel_visibility_from_candidates(
    renderer: usize,
    worker: u32,
    tile: u32,
    span: u32,
    y: u32,
    read filter: [f32; 4],
    read candidates: P7RowCandidates,
    read snapshot: FrameInputSnapshot,
) -> P7VisibilitySample:
    x0 = span & 65535
    x1 = span >> 16
    # Collection is box-complete: every candidate feature is either walked to
    # certified roots, proven root-free over the box, or enclosed in a
    # corridor record — so the selected sample needs no second certification
    # pass and no per-feature exclusion back-check.
    roots = __wrela_pixels_p7_collect_roots_box(
        renderer,
        worker,
        x0,
        x1,
        y,
        filter,
        candidates,
        snapshot,
    )
    if not roots.ok:
        return P7VisibilitySample.failure_with(roots.error)
    sample = __wrela_pixels_p7_select_visibility(renderer, roots)
    sample.root_count = (sample.root_count & 4294901760) | roots.count
    return sample

fn __wrela_pixels_p7_density_bin(count: u32) -> usize:
    if count == 0:
        return 0
    if count == 1:
        return 1
    if count == 2:
        return 2
    if count <= 4:
        return 3
    if count <= 8:
        return 4
    if count <= 16:
        return 5
    if count <= 32:
        return 6
    return 7

fn __wrela_pixels_p7_run_length_bin(length: u32) -> usize:
    if length <= 1:
        return 0
    if length == 2:
        return 1
    if length <= 4:
        return 2
    if length <= 8:
        return 3
    if length <= 16:
        return 4
    if length <= 32:
        return 5
    if length <= 64:
        return 6
    return 7

fn __wrela_pixels_p7_charge_run_telemetry(
    renderer: usize,
    worker: u32,
    read sample: P7VisibilitySample,
    length: u32,
) -> unit:
    if sample.event:
        _ = __wrela_pixels_p7_telemetry_charge(renderer, worker, 138, length.to[u64]())
        _ = __wrela_pixels_p7_telemetry_charge(renderer, worker, 22, 1)
        _ = __wrela_pixels_p7_telemetry_charge(renderer, worker, 30, 1)
        return unit
    method = sample.proof_method.to[usize]()
    shape = sample.composition_shape.to[usize]()
    if method >= 3 or shape >= 4:
        return unit
    _ = __wrela_pixels_p7_telemetry_charge(
        renderer,
        worker,
        __wrela_pixels_p7_run_length_bin(length),
        1,
    )
    _ = __wrela_pixels_p7_telemetry_charge(renderer, worker, 8.to[usize]() + method, 1)
    _ = __wrela_pixels_p7_telemetry_charge(renderer, worker, 11.to[usize]() + shape, 1)
    _ = __wrela_pixels_p7_telemetry_charge(renderer, worker, 15, 1)
    _ = __wrela_pixels_p7_telemetry_charge(renderer, worker, 23, 1)
    _ = __wrela_pixels_p7_telemetry_charge(renderer, worker, 137, length.to[u64]())
    return unit

pub fn __wrela_pixels_p7_revalidated_proposal_count(
    read previous: P7RowCandidates,
    read current: P7RowCandidates,
) -> u16:
    if not previous.ok or not current.ok:
        return 0
    proposed: u16 = 0
    before: u16 = 0
    now: u16 = 0
    @budget(bound=512)
    while before < previous.count and now < current.count:
        old_id = previous.ids[before.to[usize]()]
        new_id = current.ids[now.to[usize]()]
        if old_id == new_id:
            proposed = proposed + 1
            before = before + 1
            now = now + 1
        elif old_id < new_id:
            before = before + 1
        else:
            now = now + 1
    return proposed

pub fn __wrela_pixels_p7_row_candidates_with_proposal(
    read previous: P7RowCandidates,
    read current: P7RowCandidates,
    enabled: bool,
) -> P7RowCandidates:
    if not current.ok:
        return P7RowCandidates(ok=false, error=5, ids=[0; 256], count=0)
    if not enabled or not previous.ok:
        return current
    # Both lists are sealed, strictly increasing structural IDs. The linear
    # merge above is the ordinary revalidation: proposed IDs absent from the
    # new row are discarded, while `current` retains every newly indexed ID.
    # Returning the complete current list makes the proposal decision-inert.
    checked = __wrela_pixels_p7_revalidated_proposal_count(previous, current)
    if checked <= current.count:
        return current
    return P7RowCandidates(ok=false, error=5, ids=[0; 256], count=0)

pub fn __wrela_pixels_p7_run_worker_with_proposals(
    renderer_index: usize,
    worker_index: usize,
    proposals_enabled: bool,
) -> u64:
    if worker_index > 3:
        return 18446744073709551615
    worker = worker_index.to[u32]()
    assignment = __wrela_pixels_p7_worker_assignment(renderer_index, worker)
    if assignment[0] != 1:
        return 18446744073709551615
    config = __wrela_pixels_p7_numeric_config(renderer_index)
    if config[0] != 1 or config[6] < 0 or config[6] > 16:
        return 18446744073709551615
    if not proposals_enabled:
        tile_columns = (config[1].to[u32]() + 15) / 16
        tile_rows = (config[2].to[u32]() + 15) / 16
        tile_count = tile_columns.to[u64]() * tile_rows.to[u64]()
        if assignment[4] != 0 or assignment[5] != tile_count:
            return 18446744073709551615
        if not __wrela_pixels_p7_framebuffer_reset(renderer_index):
            return 18446744073709551615
    job = RendererWorkerJob(
        renderer_index=renderer_index,
        worker_index=worker,
        tiles_start=assignment[4].to[u32](),
        tiles_end=assignment[5].to[u32](),
    )
    return __wrela_pixels_p7_run_job(job, proposals_enabled)

@actor
pub struct RendererWorker0:
    init(mut self):
        pass

    pub fn run_job(read self, word: u64) -> u64:
        return __wrela_pixels_p7_run_job(RendererWorkerJob(renderer_index=((word >> 48) & 15).to[usize](), worker_index=((word >> 52) & 3).to[u32](), tiles_start=(word & 16777215).to[u32](), tiles_end=((word >> 24) & 16777215).to[u32]()), true)

@actor
pub struct RendererWorker1:
    init(mut self):
        pass

    pub fn run_job(read self, word: u64) -> u64:
        return __wrela_pixels_p7_run_job(RendererWorkerJob(renderer_index=((word >> 48) & 15).to[usize](), worker_index=((word >> 52) & 3).to[u32](), tiles_start=(word & 16777215).to[u32](), tiles_end=((word >> 24) & 16777215).to[u32]()), true)

@actor
pub struct RendererWorker2:
    init(mut self):
        pass

    pub fn run_job(read self, word: u64) -> u64:
        return __wrela_pixels_p7_run_job(RendererWorkerJob(renderer_index=((word >> 48) & 15).to[usize](), worker_index=((word >> 52) & 3).to[u32](), tiles_start=(word & 16777215).to[u32](), tiles_end=((word >> 24) & 16777215).to[u32]()), true)

@actor
pub struct RendererWorker3:
    init(mut self):
        pass

    pub fn run_job(read self, word: u64) -> u64:
        return __wrela_pixels_p7_run_job(RendererWorkerJob(renderer_index=((word >> 48) & 15).to[usize](), worker_index=((word >> 52) & 3).to[u32](), tiles_start=(word & 16777215).to[u32](), tiles_end=((word >> 24) & 16777215).to[u32]()), true)

pub struct P7CertifiedRow:
    ok: bool
    error: u8
    x0: u16
    x1: u16
    samples: [P7VisibilitySample; 16]
    starts: [u16; 16]
    ends: [u16; 16]
    count: u8
    run_count: u8
    corridor_count: u8
    root_count: u32
    # The implicit-jet transport model of a single-span row (decision-inert
    # P7.8 evidence). Kept on the row rather than every sample so the
    # sample struct stays small enough to copy cheaply.
    modeled: bool
    model: [i32; 8]

    pub fn failure() -> P7CertifiedRow:
        return P7CertifiedRow.failure_with(4)

    pub fn failure_with(error: u8) -> P7CertifiedRow:
        return P7CertifiedRow(
            ok=false,
            error=error,
            x0=0,
            x1=0,
            samples=[P7VisibilitySample.background(); 16],
            starts=[0; 16],
            ends=[0; 16],
            count=0,
            run_count=0,
            corridor_count=0,
            root_count=0,
            modeled=false,
            model=[0; 8],
        )

pub struct P7RowCertificationContext:
    renderer: usize
    worker: u32
    tile: u32
    y: u32
    x0: u32
    x1: u32
    proposal: P7CertifiedRow
    proposals_enabled: bool

pub fn __wrela_pixels_p7_proposal_matches(
    read proposal: P7CertifiedRow,
    read certified: P7CertifiedRow,
) -> bool:
    if not proposal.ok or not certified.ok:
        return false
    current: u8 = 0
    @budget(bound=16)
    while current < certified.count:
        start = certified.starts[current.to[usize]()]
        end = certified.ends[current.to[usize]()]
        sample = certified.samples[current.to[usize]()]
        matched = false
        previous: u8 = 0
        @budget(bound=16)
        while previous < proposal.count:
            if proposal.starts[previous.to[usize]()] <= start and proposal.ends[previous.to[usize]()] >= end:
                prior = proposal.samples[previous.to[usize]()]
                q_overlaps = not sample.hit or (
                    prior.hit
                    and prior.q_lo <= sample.q_hi
                    and sample.q_lo <= prior.q_hi
                )
                if prior.hit == sample.hit and prior.object == sample.object and prior.identity == sample.identity and prior.event == sample.event and q_overlaps:
                    matched = true
            previous = previous + 1
        if not matched:
            return false
        current = current + 1
    return true

pub fn __wrela_pixels_p7_resolve_silhouette_owner(
    renderer: usize,
    worker_tile: u64,
    xy: u64,
    read pixel_filter: [f32; 4],
    read candidates: P7RowCandidates,
    read snapshot: FrameInputSnapshot,
    read initial: P7VisibilitySample,
    read curve: [i64; 4],
) -> P7VisibilitySample:
    if curve[2] <= 0 or initial.hit:
        return initial
    worker = (worker_tile & 4294967295).to[u32]()
    tile = (worker_tile >> 32).to[u32]()
    x = (xy & 4294967295).to[u32]()
    y = (xy >> 32).to[u32]()
    selected = initial
    owner = curve[3]
    owner_kind = owner >> 32
    owner_value = (owner & 4294967295).to[u32]()
    if owner_kind == 1:
        owner_identity = __wrela_pixels_program_operand(renderer, 4, owner_value, 3)
        owner_object = __wrela_pixels_program_operand(renderer, 4, owner_value, 0)
        if owner_identity[0] == 1 and owner_object[0] == 1 and owner_identity[1] <= 65535 and owner_object[1] < 64:
            selected = P7VisibilitySample.background()
            selected.hit = true
            selected.object = owner_object[1].to[u32]()
            selected.identity = owner_identity[1].to[u32]()
            return selected
    elif owner_kind == 2:
        owner_identity = __wrela_pixels_program_operand(renderer, 3, owner_value, 3)
        if owner_identity[0] == 1 and owner_identity[1] <= 65535 and owner_value < 64:
            selected = P7VisibilitySample.background()
            selected.hit = true
            selected.object = owner_value
            selected.identity = owner_identity[1].to[u32]()
            return selected
    corner: u8 = 0
    @budget(bound=4)
    while corner < 4:
        corner_u = pixel_filter[0] - pixel_filter[2]
        if corner & 1 == 1:
            corner_u = pixel_filter[0] + pixel_filter[2]
        corner_v = pixel_filter[1] - pixel_filter[3]
        if corner & 2 == 2:
            corner_v = pixel_filter[1] + pixel_filter[3]
        corner_sample = __wrela_pixels_p7_pixel_visibility_from_candidates(
            renderer=renderer,
            worker=worker,
            tile=tile,
            span=x | ((x + 1) << 16),
            y=y,
            filter=[corner_u, corner_v, 0.0, 0.0],
            candidates=candidates,
            snapshot=snapshot,
        )
        if corner_sample.ok and corner_sample.hit and not corner_sample.event:
            return corner_sample
        corner = corner + 1
    return P7VisibilitySample.failure_with(50)

pub fn __wrela_pixels_p7_choose_arrangement_axis(
    renderer: usize,
    worker_tile: u64,
    xy: u64,
    read cell: [f32; 4],
    read minimum: [f32; 2],
    read candidates: P7RowCandidates,
    read snapshot: FrameInputSnapshot,
) -> [i64; 3]:
    worker = (worker_tile & 4294967295).to[u32]()
    tile = (worker_tile >> 32).to[u32]()
    x = (xy & 4294967295).to[u32]()
    y = (xy >> 32).to[u32]()
    center_u = cell[0]
    center_v = cell[1]
    radius_u = cell[2]
    radius_v = cell[3]
    can_split_u = radius_u > minimum[0]
    can_split_v = radius_v > minimum[1]
    evaluations: i64 = 0
    if can_split_u:
        half_ru = radius_u * 0.5
        left = __wrela_pixels_p7_pixel_visibility_from_candidates(
            renderer, worker, tile, x | ((x + 1) << 16), y,
            [center_u - half_ru, center_v, half_ru, radius_v],
            candidates, snapshot,
        )
        right = __wrela_pixels_p7_pixel_visibility_from_candidates(
            renderer, worker, tile, x | ((x + 1) << 16), y,
            [center_u + half_ru, center_v, half_ru, radius_v],
            candidates, snapshot,
        )
        evaluations = evaluations + 2
        if (left.ok and not left.event) or (right.ok and not right.event):
            return [1, 1, evaluations]
    if can_split_v:
        half_rv = radius_v * 0.5
        low = __wrela_pixels_p7_pixel_visibility_from_candidates(
            renderer, worker, tile, x | ((x + 1) << 16), y,
            [center_u, center_v - half_rv, radius_u, half_rv],
            candidates, snapshot,
        )
        high = __wrela_pixels_p7_pixel_visibility_from_candidates(
            renderer, worker, tile, x | ((x + 1) << 16), y,
            [center_u, center_v + half_rv, radius_u, half_rv],
            candidates, snapshot,
        )
        evaluations = evaluations + 2
        if (low.ok and not low.event) or (high.ok and not high.event):
            return [1, 2, evaluations]
    v_pointlike = __wrela_pixels_p7_pixel_visibility_from_candidates(
        renderer, worker, tile, x | ((x + 1) << 16), y,
        [center_u, center_v, radius_u, 0.0], candidates, snapshot,
    )
    u_pointlike = __wrela_pixels_p7_pixel_visibility_from_candidates(
        renderer, worker, tile, x | ((x + 1) << 16), y,
        [center_u, center_v, 0.0, radius_v], candidates, snapshot,
    )
    evaluations = evaluations + 2
    u_alone_ambiguous = not v_pointlike.ok or v_pointlike.event
    v_alone_ambiguous = not u_pointlike.ok or u_pointlike.event
    if can_split_u and not v_alone_ambiguous and u_alone_ambiguous:
        return [1, 1, evaluations]
    if can_split_v and not u_alone_ambiguous and v_alone_ambiguous:
        return [1, 2, evaluations]
    if can_split_u and (not can_split_v or radius_u >= radius_v):
        return [1, 1, evaluations]
    if can_split_v:
        return [1, 2, evaluations]
    return [0, 0, evaluations]

pub fn __wrela_pixels_p7_resolve_pixel_arrangement(
    renderer: usize,
    worker_tile: u64,
    xy: u64,
    read pixel_filter: [f32; 4],
    read candidates: P7RowCandidates,
    read snapshot: FrameInputSnapshot,
    read initial: P7VisibilitySample,
    integrated_coverage: i64,
) -> P7PixelArrangement:
    worker = (worker_tile & 4294967295).to[u32]()
    tile = (worker_tile >> 32).to[u32]()
    x = (xy & 4294967295).to[u32]()
    y = (xy >> 32).to[u32]()
    selected = initial
    selected_hit = selected.hit
    background_seen = false
    secondary_hit = false
    secondary_identity: u32 = 0
    selected_units: u64 = 0
    resolved_units: u64 = 0
    unresolved_units: u64 = 0
    maximum_roots: u32 = 0
    # A 2^24 binary area ledger gives the adaptive splitter a stable integer
    # measure while keeping every coverage product comfortably inside u64.
    coverage_units: u64 = 16777216
    coverage_half: u64 = 8388608
    # Anisotropic adaptive event arrangement (the P7.10 pixel-cell tier).
    # Binary splits keep a bounded frontier while half-decidability probes
    # choose the productive axis; every pushed half is re-certified on pop.
    cell_u: [f32; 72] = [0.0; 72]
    cell_v: [f32; 72] = [0.0; 72]
    cell_ru: [f32; 72] = [0.0; 72]
    cell_rv: [f32; 72] = [0.0; 72]
    cell_weight: [u64; 72] = [0; 72]
    stack_count: u8 = 1
    if integrated_coverage >= 0:
        stack_count = 0
        resolved_units = coverage_units
        maximum_roots = selected.root_count & 65535
    cell_u[0] = pixel_filter[0]
    cell_v[0] = pixel_filter[1]
    cell_ru[0] = pixel_filter[2]
    cell_rv[0] = pixel_filter[3]
    cell_weight[0] = coverage_units
    minimum_ru = pixel_filter[2] * 0.000244140625
    minimum_rv = pixel_filter[3] * 0.000244140625
    undecided_units: u64 = coverage_units
    if integrated_coverage >= 0:
        undecided_units = 0
    processed_cells: u32 = 0
    @budget(bound=2097152)
    while stack_count > 0:
        pinned_low = (selected_units * 255 + coverage_half) / coverage_units
        pinned_high = (
            (selected_units + unresolved_units + undecided_units) * 255
            + coverage_half
        ) / coverage_units
        if pinned_low == pinned_high:
            unresolved_units = unresolved_units + undecided_units
            undecided_units = 0
            stack_count = 0
            continue
        drain_light = stack_count > 40
        heaviest: u8 = 0
        scan: u8 = 1
        @budget(bound=72)
        while scan < stack_count:
            lighter = cell_weight[scan.to[usize]()] < cell_weight[heaviest.to[usize]()]
            if (drain_light and lighter) or (not drain_light and not lighter):
                heaviest = scan
            scan = scan + 1
        stack_index = heaviest.to[usize]()
        center_u = cell_u[stack_index]
        center_v = cell_v[stack_index]
        radius_u = cell_ru[stack_index]
        radius_v = cell_rv[stack_index]
        weight = cell_weight[stack_index]
        stack_count = stack_count - 1
        tail = stack_count.to[usize]()
        if stack_index != tail:
            cell_u[stack_index] = cell_u[tail]
            cell_v[stack_index] = cell_v[tail]
            cell_ru[stack_index] = cell_ru[tail]
            cell_rv[stack_index] = cell_rv[tail]
            cell_weight[stack_index] = cell_weight[tail]
        processed_cells = processed_cells + 1
        if processed_cells > 262144:
            exhausted = P7PixelArrangement.failure(42)
            exhausted.model[0] = processed_cells.to[i32]()
            exhausted.model[1] = (__wrela_pixels_f32_to_bits(center_u) >> 1).to[i32]()
            exhausted.model[2] = (__wrela_pixels_f32_to_bits(center_v) >> 1).to[i32]()
            exhausted.model[3] = (__wrela_pixels_f32_to_bits(radius_u) >> 1).to[i32]()
            exhausted.model[4] = (__wrela_pixels_f32_to_bits(radius_v) >> 1).to[i32]()
            exhausted.model[5] = undecided_units.to[i32]()
            exhausted.model[6] = selected_units.to[i32]()
            exhausted.model[7] = unresolved_units.to[i32]()
            return exhausted
        cell_sample = __wrela_pixels_p7_pixel_visibility_from_candidates(
            renderer=renderer,
            worker=worker,
            tile=tile,
            span=x | ((x + 1) << 16),
            y=y,
            filter=[center_u, center_v, radius_u, radius_v],
            candidates=candidates,
            snapshot=snapshot,
        )
        ambiguous = not cell_sample.ok or cell_sample.event
        if not cell_sample.ok and cell_sample.error != 4 and cell_sample.error != 6:
            if cell_sample.error == 5:
                return P7PixelArrangement.failure(13)
            return P7PixelArrangement.failure(cell_sample.error)
        can_split_u = radius_u > minimum_ru
        can_split_v = radius_v > minimum_rv
        if ambiguous and weight >= 2 and (can_split_u or can_split_v):
            if stack_count > 69:
                return P7PixelArrangement.failure(43)
            axis = __wrela_pixels_p7_choose_arrangement_axis(
                renderer,
                worker_tile,
                xy,
                [center_u, center_v, radius_u, radius_v],
                [minimum_ru, minimum_rv],
                candidates,
                snapshot,
            )
            if axis[0] != 1 or axis[2] < 0 or axis[2] > 6:
                return P7PixelArrangement.failure(43)
            processed_cells = processed_cells + axis[2].to[u32]()
            split_u = axis[1] == 1
            half_weight = weight / 2
            destination = stack_count.to[usize]()
            second = (stack_count + 1).to[usize]()
            if split_u:
                child_ru = radius_u * 0.5
                cell_u[destination] = center_u - child_ru
                cell_v[destination] = center_v
                cell_ru[destination] = child_ru
                cell_rv[destination] = radius_v
                cell_weight[destination] = half_weight
                cell_u[second] = center_u + child_ru
                cell_v[second] = center_v
                cell_ru[second] = child_ru
                cell_rv[second] = radius_v
                cell_weight[second] = half_weight
            else:
                child_rv = radius_v * 0.5
                cell_u[destination] = center_u
                cell_v[destination] = center_v - child_rv
                cell_ru[destination] = radius_u
                cell_rv[destination] = child_rv
                cell_weight[destination] = half_weight
                cell_u[second] = center_u
                cell_v[second] = center_v + child_rv
                cell_ru[second] = radius_u
                cell_rv[second] = child_rv
                cell_weight[second] = half_weight
            stack_count = stack_count + 2
        else:
            undecided_units = undecided_units - weight
            if ambiguous:
                unresolved_units = unresolved_units + weight
            else:
                resolved_units = resolved_units + weight
                cell_roots = cell_sample.root_count & 65535
                if cell_roots > maximum_roots:
                    maximum_roots = cell_roots
                if not cell_sample.hit:
                    background_seen = true
                else:
                    if not selected_hit:
                        selected = cell_sample
                        selected_hit = true
                    if cell_sample.identity == selected.identity:
                        selected_units = selected_units + weight
                        if cell_sample.q_lo < selected.q_lo:
                            selected.q_lo = cell_sample.q_lo
                        if cell_sample.q_hi > selected.q_hi:
                            selected.q_hi = cell_sample.q_hi
                    elif not secondary_hit:
                        secondary_hit = true
                        secondary_identity = cell_sample.identity
                    elif cell_sample.identity != secondary_identity:
                        return P7PixelArrangement.failure(44)
    if resolved_units + unresolved_units != coverage_units:
        if __wrela_pixels_p7_telemetry_counter(renderer, worker, 0)[0] == 1:
            _ = __wrela_pixels_p7_telemetry_charge(renderer, worker, 128, 1)
        return P7PixelArrangement.failure(10)
    if secondary_hit and background_seen:
        return P7PixelArrangement.failure(45)
    if not selected_hit:
        selected = P7VisibilitySample.background()
    selected.ok = true
    selected.error = 0
    selected.event = true
    selected.proof_method = 3
    selected.composition_shape = 4
    if secondary_hit:
        if secondary_identity > 65535:
            return P7PixelArrangement.failure(46)
        selected.proof_method = 131
    selected.root_count = (
        (secondary_identity << 16) | (maximum_roots & 65535)
    )
    coverage_lo = (
        (selected_units * 255 + coverage_half) / coverage_units
    ).to[u8]()
    coverage_hi = (
        ((selected_units + unresolved_units) * 255 + coverage_half) / coverage_units
    ).to[u8]()
    if integrated_coverage >= 0:
        coverage_lo = integrated_coverage.to[u8]()
        coverage_hi = integrated_coverage.to[u8]()
    if coverage_lo != coverage_hi:
        failure = P7PixelArrangement.failure(47)
        failure.model[0] = selected_units.to[i32]()
        failure.model[1] = unresolved_units.to[i32]()
        failure.model[2] = resolved_units.to[i32]()
        failure.model[3] = coverage_lo.to[i32]()
        failure.model[4] = coverage_hi.to[i32]()
        failure.model[5] = processed_cells.to[i32]()
        return failure
    selected.proof_margin = (
        coverage_lo.to[i32]() | (coverage_hi.to[i32]() << 8)
    )
    selected.coverage = coverage_hi
    return P7PixelArrangement.success(selected)

pub fn __wrela_pixels_p7_certify_pixel_row(
    renderer: usize,
    worker: u32,
    tile: u32,
    y: u32,
    x0: u32,
    x1: u32,
    read candidates: P7RowCandidates,
    read snapshot: FrameInputSnapshot,
) -> P7CertifiedRow:
    if not candidates.ok or x0 >= x1 or x1 - x0 > 16 or x1 > 65535:
        return P7CertifiedRow.failure()
    row = P7CertifiedRow(
        ok=true,
        error=0,
        x0=x0.to[u16](),
        x1=x1.to[u16](),
        samples=[P7VisibilitySample.background(); 16],
        starts=[0; 16],
        ends=[0; 16],
        count=0,
        run_count=0,
        corridor_count=0,
        root_count=0,
        modeled=false,
        model=[0; 8],
    )
    config = __wrela_pixels_p7_numeric_config(renderer)
    if config[0] != 1 or config[1] <= 0 or config[2] <= 0:
        return P7CertifiedRow.failure_with(8)
    width_pixels = config[1].to[u32]()
    height_pixels = config[2].to[u32]()
    x = x0
    telemetry_enabled = __wrela_pixels_p7_telemetry_counter(
        renderer,
        worker,
        0,
    )[0] == 1
    @budget(bound=16)
    while x < x1:
        if telemetry_enabled:
            _ = __wrela_pixels_p7_telemetry_charge(renderer, worker, 117, 1)
        pixel_filter: [f32; 4] = [
            (((x.to[f32]() + 0.5) / width_pixels.to[f32]()) * 2.0 - 1.0) * width_pixels.to[f32]() / height_pixels.to[f32](),
            1.0 - ((y.to[f32]() + 0.5) / height_pixels.to[f32]()) * 2.0,
            1.0 / height_pixels.to[f32](),
            1.0 / height_pixels.to[f32](),
        ]
        sample = __wrela_pixels_p7_pixel_visibility_from_candidates(
            renderer=renderer,
            worker=worker,
            tile=tile,
            span=x | ((x + 1) << 16),
            y=y,
            filter=pixel_filter,
            candidates=candidates,
            snapshot=snapshot,
        )
        # A certified point hit can still be wrong for a bounded-displacement
        # object: root isolation certifies crossings of the sealed predictor,
        # which is the *undisplaced* primitive ray equation, and at a grazing
        # pixel the base surface is crossed while the displaced surface —
        # pulled inward by the wave — is not. The exterior half of the
        # deformation miss proof answers exactly that question: no point of
        # the displaced surface lies on any ray of this pixel. When it proves
        # absence (and every corroborating guard agrees), the object cannot
        # contribute occupancy here, so its features are removed and
        # visibility is re-selected from the remaining candidates; a scene
        # whose only object it was resolves to background. Interior pixels
        # cannot prove absence — the surface really is there — so their point
        # hits are untouched, and every guard below fails closed to today's
        # sample.
        if sample.ok and sample.hit and not sample.event:
            veto_owner: i64 = -1
            veto_count = __wrela_pixels_tile_event_count(renderer, tile)
            if veto_count != 4294967295 and veto_count <= 256:
                veto_aspect = width_pixels.to[f32]() / height_pixels.to[f32]()
                veto_u0 = ((x.to[f32]() / width_pixels.to[f32]()) * 2.0 - 1.0) * veto_aspect
                veto_u1 = (((x + 1).to[f32]() / width_pixels.to[f32]()) * 2.0 - 1.0) * veto_aspect
                veto_v0 = 1.0 - (y.to[f32]() / height_pixels.to[f32]()) * 2.0
                veto_v1 = 1.0 - ((y + 1).to[f32]() / height_pixels.to[f32]()) * 2.0
                veto_ordinal: u32 = 0
                @budget(bound=256)
                while veto_ordinal < veto_count:
                    veto_event = __wrela_pixels_tile_event(renderer, tile, veto_ordinal)
                    veto_ordinal = veto_ordinal + 1
                    if veto_event[0] != 1 or veto_event[1] > 4294967295:
                        continue
                    veto_event_id = veto_event[1].to[u32]()
                    # Only a bounded-displacement event carries a sealed miss
                    # model; everything else is skipped without cost.
                    veto_model = __wrela_pixels_p7_deformation_miss_model(
                        renderer,
                        veto_event_id,
                    )
                    if veto_model[0] != 1.0:
                        continue
                    # Span gate: a false predictor crossing needs the base
                    # surface met while the displaced one is not, which is the
                    # silhouette band the event was sealed over. Pixels outside
                    # the span keep the fast path.
                    veto_x0 = __wrela_pixels_program_operand(renderer, 7, veto_event_id, 3)
                    veto_x1 = __wrela_pixels_program_operand(renderer, 7, veto_event_id, 4)
                    veto_y0 = __wrela_pixels_program_operand(renderer, 7, veto_event_id, 5)
                    veto_y1 = __wrela_pixels_program_operand(renderer, 7, veto_event_id, 6)
                    if veto_x0[0] != 1 or veto_x1[0] != 1 or veto_y0[0] != 1 or veto_y1[0] != 1:
                        continue
                    if x.to[u64]() < veto_x0[1] or x.to[u64]() >= veto_x1[1]:
                        continue
                    if y.to[u64]() < veto_y0[1] or y.to[u64]() >= veto_y1[1]:
                        continue
                    if veto_model[1] < 0.0 or veto_model[1] > 4294967295.0:
                        continue
                    veto_feature = veto_model[1].to[u32]()
                    veto_object = __wrela_pixels_program_operand(renderer, 4, veto_feature, 0)
                    if veto_object[0] != 1 or veto_object[1] >= 64:
                        continue
                    # The veto can only change the answer when the suspicious
                    # hit belongs to this object.
                    if sample.object.to[u64]() != veto_object[1]:
                        continue
                    # The proof speaks for this one feature; only an object that
                    # is exactly this feature is absent when the feature is.
                    veto_leaves = __wrela_pixels_program_operand(
                        renderer,
                        3,
                        veto_object[1].to[u32](),
                        4,
                    )
                    if veto_leaves[0] != 1 or veto_leaves[1] != 1:
                        continue
                    # Absence means the ray is outside the surface everywhere,
                    # so the sealed start-inside verdict must agree; a set bit
                    # is a contradiction and the veto stands down.
                    veto_seed = __wrela_pixels_p7_initial_inside(
                        renderer,
                        (veto_u0 + veto_u1) * 0.5,
                        (veto_v0 + veto_v1) * 0.5,
                        __wrela_pixels_p7_raw_to_f32(
                            config[5].to[i32](),
                            config[3].to[i32](),
                        ),
                        snapshot.params,
                        snapshot.camera,
                    )
                    if veto_seed[0] != 1:
                        continue
                    if (veto_seed[1] >> veto_object[1]) & 1 != 0:
                        continue
                    if __wrela_pixels_p7_deformation_silhouette_misses(
                        renderer,
                        veto_event_id | 2147483648,
                        veto_u0,
                        veto_v0,
                        veto_u1,
                        veto_v1,
                        snapshot.params,
                        snapshot.camera,
                    ):
                        veto_owner = veto_object[1].to[i64]()
                        veto_ordinal = veto_count
            if veto_owner >= 0:
                if telemetry_enabled:
                    _ = __wrela_pixels_p7_telemetry_charge(renderer, worker, 140, 1)
                veto_filtered = P7RowCandidates(
                    ok=true,
                    error=0,
                    ids=[0; 256],
                    count=0,
                )
                veto_copy: u16 = 0
                @budget(bound=256)
                while veto_copy < candidates.count:
                    veto_keep = candidates.ids[veto_copy.to[usize]()]
                    veto_keep_owner = __wrela_pixels_program_operand(renderer, 4, veto_keep, 0)
                    veto_copy = veto_copy + 1
                    if veto_keep_owner[0] == 1 and veto_keep_owner[1].to[i64]() == veto_owner:
                        continue
                    veto_filtered.ids[veto_filtered.count.to[usize]()] = veto_keep
                    veto_filtered.count = veto_filtered.count + 1
                revised = __wrela_pixels_p7_pixel_visibility_from_candidates(
                    renderer=renderer,
                    worker=worker,
                    tile=tile,
                    span=x | ((x + 1) << 16),
                    y=y,
                    filter=pixel_filter,
                    candidates=veto_filtered,
                    snapshot=snapshot,
                )
                if revised.ok:
                    sample = revised
        if not sample.ok or sample.event:
            structural = __wrela_pixels_p7_structural_corridor_pixel(
                renderer,
                tile,
                x,
                y,
            )
            if structural[0] != 1:
                return P7CertifiedRow.failure_with(9)
            if structural[1] != 1:
                if telemetry_enabled:
                    _ = __wrela_pixels_p7_telemetry_charge(renderer, worker, 128, 1)
                if sample.ok:
                    return P7CertifiedRow.failure_with(41)
                if sample.error == 5:
                    return P7CertifiedRow.failure_with(12)
                return P7CertifiedRow.failure_with(sample.error)
            if telemetry_enabled:
                _ = __wrela_pixels_p7_telemetry_charge(renderer, worker, 113, 1)
                _ = __wrela_pixels_p7_telemetry_charge(renderer, worker, 118, 1)
            selected = P7VisibilitySample.background()
            selected_hit = false
            background_seen = false
            secondary_hit = false
            secondary_identity: u32 = 0
            if sample.ok and sample.hit:
                selected = sample
                selected_hit = true
            point_filter: [f32; 4] = [
                pixel_filter[0],
                pixel_filter[1],
                0.0,
                0.0,
            ]
            side_sample = __wrela_pixels_p7_pixel_visibility_from_candidates(
                renderer=renderer,
                worker=worker,
                tile=tile,
                span=x | ((x + 1) << 16),
                y=y,
                filter=point_filter,
                candidates=candidates,
                snapshot=snapshot,
            )
            if side_sample.ok and side_sample.hit:
                selected = side_sample
                selected_hit = true
            integrated_coverage: i64 = -1
            curve = __wrela_pixels_p7_silhouette_coverage(
                renderer,
                worker,
                tile,
                x,
                y,
                candidates,
                side_sample,
                snapshot,
            )
            if curve[0] == 1 and curve[1] == 1:
                integrated_coverage = curve[2]
            elif curve[0] == 1:
                # No analytic integrator applied (an eligible event family
                # without a closed-form representation) or the integrator
                # could not pin a unique byte. Fall through to the adaptive
                # subpixel arrangement below — the fixed-ladder tier the plan
                # names for exactly this case. Box-complete collection with
                # corridor pruning keeps that tier inside its cell budget.
                pass
            else:
                return P7CertifiedRow.failure_with(60 + curve[1].to[u8]())
            if integrated_coverage > 0 and not selected_hit:
                selected = __wrela_pixels_p7_resolve_silhouette_owner(
                    renderer,
                    worker.to[u64]() | (tile.to[u64]() << 32),
                    x.to[u64]() | (y.to[u64]() << 32),
                    pixel_filter,
                    candidates,
                    snapshot,
                    selected,
                    curve,
                )
                if not selected.ok:
                    return P7CertifiedRow.failure_with(selected.error)
                selected_hit = selected.hit
            arrangement = __wrela_pixels_p7_resolve_pixel_arrangement(
                renderer,
                worker.to[u64]() | (tile.to[u64]() << 32),
                x.to[u64]() | (y.to[u64]() << 32),
                pixel_filter,
                candidates,
                snapshot,
                selected,
                integrated_coverage,
            )
            if not arrangement.ok:
                failure = P7CertifiedRow.failure_with(arrangement.error)
                failure.model = arrangement.model
                return failure
            sample = arrangement.sample
        if row.count >= 16:
            if telemetry_enabled:
                _ = __wrela_pixels_p7_telemetry_charge(renderer, worker, 128, 1)
            return P7CertifiedRow.failure_with(1)
        event_coverage = __wrela_pixels_p7_event_coverage(
            renderer,
            tile,
            x,
            y,
            sample,
            snapshot,
        )
        if event_coverage[0] != 1:
            if telemetry_enabled:
                _ = __wrela_pixels_p7_telemetry_charge(renderer, worker, 128, 1)
            return P7CertifiedRow.failure_with(48)
        if event_coverage[1] == 1:
            sample.event = true
            sample.coverage = event_coverage[2].to[u8]()
            if sample.proof_method & 127 != 3 or sample.composition_shape != 4:
                sample.proof_margin = (
                    sample.coverage.to[i32]() | (
                        sample.coverage.to[i32]() << 8
                    )
                )
        elif sample.event:
            if telemetry_enabled:
                _ = __wrela_pixels_p7_telemetry_charge(renderer, worker, 128, 1)
            return P7CertifiedRow.failure_with(49)
        else:
            structural = __wrela_pixels_p7_structural_corridor_pixel(
                renderer,
                tile,
                x,
                y,
            )
            if structural[0] != 1:
                if telemetry_enabled:
                    _ = __wrela_pixels_p7_telemetry_charge(renderer, worker, 128, 1)
                return P7CertifiedRow.failure_with(11)
            # Structural endpoints delimit regular domains but do not by
            # themselves prove a visibility event. Event records are emitted
            # only by a certified local arrangement/coverage calculation.
        if telemetry_enabled:
            terminal: usize = 126
            if sample.event:
                _ = __wrela_pixels_p7_telemetry_charge(renderer, worker, 118, 1)
                terminal = 127
            _ = __wrela_pixels_p7_telemetry_charge(renderer, worker, terminal, 1)
        index = row.count.to[usize]()
        row.samples[index] = sample
        row.starts[index] = x.to[u16]()
        row.ends[index] = (x + 1).to[u16]()
        sample_roots = sample.root_count & 65535
        if sample_roots > row.root_count:
            row.root_count = sample_roots
        if sample.event:
            row.corridor_count = row.corridor_count + 1
        else:
            row.run_count = row.run_count + 1
        row.count = row.count + 1
        x = x + 1
    return row

pub fn __wrela_pixels_p7_try_certify_regular_row(
    renderer: usize,
    worker: u32,
    tile: u32,
    y: u32,
    x0: u32,
    x1: u32,
    read candidates: P7RowCandidates,
    read snapshot: FrameInputSnapshot,
) -> P7CertifiedRow:
    if not candidates.ok or x0 >= x1 or x1 - x0 > 16 or x1 > 65535:
        return P7CertifiedRow.failure()
    config = __wrela_pixels_p7_numeric_config(renderer)
    if config[0] != 1 or config[1] <= 0 or config[2] <= 0:
        return P7CertifiedRow.failure_with(14)
    width = config[1].to[u32]()
    height = config[2].to[u32]()
    # A sealed material-boundary event does not delimit visibility, but its
    # pixels owe their displayed byte to event coverage: a span overlapping
    # its conservative region resolves per pixel so the material integrator
    # can charge the corridor. Nothing else pushes those pixels off the
    # regular-span path, because the material edge is invisible to the
    # occupancy sweep.
    material_events = __wrela_pixels_tile_event_count(renderer, tile)
    if material_events == 4294967295 or material_events > 256:
        return P7CertifiedRow.failure_with(14)
    material_ordinal: u32 = 0
    @budget(bound=256)
    while material_ordinal < material_events:
        material_event = __wrela_pixels_tile_event(renderer, tile, material_ordinal)
        if material_event[0] != 1 or material_event[1] > 4294967295:
            return P7CertifiedRow.failure_with(14)
        material_id = material_event[1].to[u32]()
        material_kind = __wrela_pixels_program_operand(renderer, 7, material_id, 0)
        if material_kind[0] != 1:
            return P7CertifiedRow.failure_with(14)
        if material_kind[1] == 8:
            material_x0 = __wrela_pixels_program_operand(renderer, 7, material_id, 3)
            material_x1 = __wrela_pixels_program_operand(renderer, 7, material_id, 4)
            material_y0 = __wrela_pixels_program_operand(renderer, 7, material_id, 5)
            material_y1 = __wrela_pixels_program_operand(renderer, 7, material_id, 6)
            if material_x0[0] != 1 or material_x1[0] != 1 or material_y0[0] != 1 or material_y1[0] != 1:
                return P7CertifiedRow.failure_with(14)
            if y.to[u64]() >= material_y0[1] and y.to[u64]() < material_y1[1] and x1.to[u64]() > material_x0[1] and x0.to[u64]() < material_x1[1]:
                return P7CertifiedRow.failure()
        material_ordinal = material_ordinal + 1
    center_x = x0.to[f32]() + (x1 - x0).to[f32]() * 0.5
    filter: [f32; 4] = [
        ((center_x / width.to[f32]()) * 2.0 - 1.0) * width.to[f32]() / height.to[f32](),
        1.0 - ((y.to[f32]() + 0.5) / height.to[f32]()) * 2.0,
        (x1 - x0).to[f32]() / height.to[f32](),
        1.0 / height.to[f32](),
    ]
    sample = __wrela_pixels_p7_pixel_visibility_from_candidates(
        renderer,
        worker,
        tile,
        x0 | (x1 << 16),
        y,
        filter,
        candidates,
        snapshot,
    )
    if not sample.ok:
        if sample.error == 5:
            return P7CertifiedRow.failure_with(15)
        return P7CertifiedRow.failure_with(sample.error)
    if sample.event:
        return P7CertifiedRow.failure()
    span_modeled = false
    span_model: [i32; 8] = [0; 8]
    # P7.8 candidate construction is decision-inert: the complete interval
    # certificate above remains authoritative. Three certified point anchors
    # provide an implicit quadratic transport model, while q_error encloses
    # the already-certified whole-domain tube.
    if sample.hit:
        left_filter: [f32; 4] = [
            filter[0] - filter[2],
            filter[1],
            0.0,
            0.0,
        ]
        center_filter: [f32; 4] = [
            filter[0],
            filter[1],
            0.0,
            0.0,
        ]
        right_filter: [f32; 4] = [
            filter[0] + filter[2],
            filter[1],
            0.0,
            0.0,
        ]
        left = __wrela_pixels_p7_pixel_visibility_from_candidates(
            renderer,
            worker,
            tile,
            x0 | ((x0 + 1) << 16),
            y,
            left_filter,
            candidates,
            snapshot,
        )
        center = __wrela_pixels_p7_pixel_visibility_from_candidates(
            renderer,
            worker,
            tile,
            x0 | ((x0 + 1) << 16),
            y,
            center_filter,
            candidates,
            snapshot,
        )
        right = __wrela_pixels_p7_pixel_visibility_from_candidates(
            renderer,
            worker,
            tile,
            (x1 - 1) | (x1 << 16),
            y,
            right_filter,
            candidates,
            snapshot,
        )
        if (
            left.ok and center.ok and right.ok
            and left.hit and center.hit and right.hit
            and not left.event and not center.event and not right.event
            and left.identity == sample.identity
            and center.identity == sample.identity
            and right.identity == sample.identity
        ):
            span = (x1 - x0).to[i64]()
            first_lo = left.q_lo.to[i64]()
            first_hi = left.q_hi.to[i64]()
            center_lo = center.q_lo.to[i64]()
            center_hi = center.q_hi.to[i64]()
            last_lo = right.q_lo.to[i64]()
            last_hi = right.q_hi.to[i64]()
            qx_lo = (last_lo - first_hi) / span - 1
            qx_hi = (last_hi - first_lo) / span + 1
            half_span = span / 2
            if half_span < 1:
                half_span = 1
            curvature_scale = half_span * half_span
            qxx_lo = (
                first_lo - center_hi * 2 + last_lo
            ) / curvature_scale - 2
            qxx_hi = (
                first_hi - center_lo * 2 + last_hi
            ) / curvature_scale + 2
            q_error_lo = sample.q_lo.to[i64]() - center.q_hi.to[i64]()
            q_error_hi = sample.q_hi.to[i64]() - center.q_lo.to[i64]()
            if (
                qx_lo >= -2147483648 and qx_hi <= 2147483647
                and qxx_lo >= -2147483648 and qxx_hi <= 2147483647
                and q_error_lo >= -2147483648 and q_error_hi <= 2147483647
            ):
                span_modeled = true
                span_model = [
                    center.q_lo,
                    center.q_hi,
                    qx_lo.to[i32](),
                    qx_hi.to[i32](),
                    qxx_lo.to[i32](),
                    qxx_hi.to[i32](),
                    q_error_lo.to[i32](),
                    q_error_hi.to[i32](),
                ]
    row = P7CertifiedRow(
        ok=true,
        error=0,
        x0=x0.to[u16](),
        x1=x1.to[u16](),
        samples=[P7VisibilitySample.background(); 16],
        starts=[0; 16],
        ends=[0; 16],
        count=1,
        run_count=1,
        corridor_count=0,
        root_count=sample.root_count & 65535,
        modeled=span_modeled,
        model=span_model,
    )
    row.samples[0] = sample
    row.starts[0] = x0.to[u16]()
    row.ends[0] = x1.to[u16]()
    return row

pub fn __wrela_pixels_p7_certify_row(
    read context: P7RowCertificationContext,
    read candidates: P7RowCandidates,
    read snapshot: FrameInputSnapshot,
) -> P7CertifiedRow:
    renderer = context.renderer
    worker = context.worker
    tile = context.tile
    y = context.y
    x0 = context.x0
    x1 = context.x1
    proposal = context.proposal
    proposals_enabled = context.proposals_enabled
    if not candidates.ok or x0 >= x1 or x1 - x0 > 16 or x1 > 65535:
        return P7CertifiedRow.failure()
    row = P7CertifiedRow(
        ok=true,
        error=0,
        x0=x0.to[u16](),
        x1=x1.to[u16](),
        samples=[P7VisibilitySample.background(); 16],
        starts=[0; 16],
        ends=[0; 16],
        count=0,
        run_count=0,
        corridor_count=0,
        root_count=0,
        modeled=false,
        model=[0; 8],
    )
    cursor = x0
    width = x1 - x0
    telemetry_enabled = __wrela_pixels_p7_telemetry_counter(
        renderer,
        worker,
        0,
    )[0] == 1
    # At most sixteen emitted spans, with up to seven deterministic retry
    # tiers (proposal, x split, q split, feature, branch, event, terminal).
    @budget(bound=128)
    while cursor < x1:
        retrying = width < x1 - cursor
        domain_end = x1
        if domain_end <= cursor or domain_end > x1:
            return P7CertifiedRow.failure_with(2)
        proposed_end = cursor
        if not retrying and proposals_enabled and proposal.ok:
            proposal_index: u8 = 0
            @budget(bound=16)
            while proposal_index < proposal.count:
                proposed_start = proposal.starts[proposal_index.to[usize]()].to[u32]()
                candidate_end = proposal.ends[proposal_index.to[usize]()].to[u32]()
                if proposed_start <= cursor and candidate_end > cursor and candidate_end <= x1:
                    proposed_end = candidate_end
                proposal_index = proposal_index + 1
            # P7.11: the proposal must not narrow the *first* attempt. Seeding
            # the attempted width from the previous row's partition changes the
            # emitted spans whenever consecutive rows partition differently
            # (any silhouette), and the debug alpha encodes the span-wide q
            # interval width — so enabling proposals would change frame bytes.
            # `proposed_end` is still computed above so revalidation matching
            # and its telemetry stay live; it just no longer decides `width`.
        if width > domain_end - cursor:
            width = domain_end - cursor
        candidate = P7CertifiedRow.failure()
        if width > 1:
            candidate = __wrela_pixels_p7_try_certify_regular_row(
                renderer,
                worker,
                tile,
                y,
                cursor,
                cursor + width,
                candidates,
                snapshot,
            )
        else:
            candidate = __wrela_pixels_p7_certify_pixel_row(
                renderer,
                worker,
                tile,
                y,
                cursor,
                cursor + 1,
                candidates,
                snapshot,
        )
        if not candidate.ok:
            if candidate.error != 4:
                failure = P7CertifiedRow.failure_with(candidate.error)
                failure.model = candidate.model
                return failure
            if width <= 1:
                failure = P7CertifiedRow.failure_with(candidate.error)
                failure.model = candidate.model
                return failure
            if telemetry_enabled:
                _ = __wrela_pixels_p7_telemetry_charge(renderer, worker, 112, 1)
            # Fixed P7.10 x-split tier. q, feature, and branch refinement are
            # performed by the complete root collector within each child;
            # only a one-pixel child may enter the terminal corridor tier.
            width = (width + 1) / 2
            continue
        if proposed_end > cursor and not __wrela_pixels_p7_proposal_matches(
            proposal,
            candidate,
        ):
            # q, identity, and event state are transported from the previous
            # row only when the new row's complete certificate revalidates
            # them. On mismatch the fresh certificate remains authoritative and
            # no later span in this row consults the stale seed. Clearing
            # `proposal.ok` is decision-inert: it cannot change which spans are
            # emitted, only whether revalidation is attempted again.
            proposal.ok = false
        if row.count.to[u16]() + candidate.count.to[u16]() > 16:
            return P7CertifiedRow.failure()
        index: u8 = 0
        @budget(bound=16)
        while index < candidate.count:
            destination = row.count.to[usize]()
            source = index.to[usize]()
            row.samples[destination] = candidate.samples[source]
            row.starts[destination] = candidate.starts[source]
            row.ends[destination] = candidate.ends[source]
            row.count = row.count + 1
            index = index + 1
        if candidate.root_count > row.root_count:
            row.root_count = candidate.root_count
        row.run_count = row.run_count + candidate.run_count
        row.corridor_count = row.corridor_count + candidate.corridor_count
        cursor = candidate.x1.to[u32]()
        width = x1 - cursor
    return row

fn __wrela_pixels_p7_worker_error(error: u8, tile: u32) -> u64:
    code = error
    if error == 0:
        code = 15
    return (
        9223372036854775808
        | (code.to[u64]() << 32)
        | tile.to[u64]()
    )

fn __wrela_pixels_p7_worker_error_code(value: u64) -> u8:
    if (value & 9223372036854775808) != 0:
        error = ((value >> 32) & 255).to[u8]()
        if error > 0:
            return error
    if value == 18446744073709551615:
        return 15
    return 0

fn __wrela_pixels_p7_worker_error_tile(value: u64) -> u32:
    if (value & 9223372036854775808) != 0:
        return (value & 4294967295).to[u32]()
    return 0

pub fn __wrela_pixels_p7_run_job(job: RendererWorkerJob, proposals_enabled: bool) -> u64:
    if job.tiles_start > job.tiles_end:
        return __wrela_pixels_p7_worker_error(5, 0)
    config = __wrela_pixels_p7_numeric_config(job.renderer_index)
    meta = __wrela_pixels_p7_frame_snapshot_meta(job.renderer_index)
    if config[0] != 1 or config[1] <= 0 or config[2] <= 0 or config[6] < 0 or config[6] > 16 or meta[0] != 1 or meta[2].to[i64]() != config[6]:
        return __wrela_pixels_p7_worker_error(8, 0)
    post = __wrela_pixels_p7_frame_snapshot_post(job.renderer_index)
    snapshot = FrameInputSnapshot(
        params=__wrela_pixels_p7_frame_snapshot_params(job.renderer_index),
        param_count=meta[2].to[u16](),
        camera=__wrela_pixels_p7_frame_snapshot_camera(job.renderer_index),
        lights=LightFrame.from_snapshot(
            __wrela_pixels_p7_frame_snapshot_light_kinds(job.renderer_index),
            __wrela_pixels_p7_frame_snapshot_light_scalars(job.renderer_index),
        ),
        exposure=post[0],
        environment=Rgb(r=post[1], g=post[2], b=post[3]),
        frame_index=meta[1],
    )
    width = config[1].to[u32]()
    height = config[2].to[u32]()
    tiles_x = (width + 15) / 16
    tiles_y = (height + 15) / 16
    tile_count = tiles_x * tiles_y
    if tiles_x == 0 or tiles_y == 0 or job.tiles_end > tile_count:
        return __wrela_pixels_p7_worker_error(9, 0)
    if not __wrela_pixels_p7_workspace_reset(
        job.renderer_index,
        job.worker_index,
        snapshot.frame_index +% 1,
    ):
        return __wrela_pixels_p7_worker_error(11, 0)
    telemetry_enabled = __wrela_pixels_p7_telemetry_reset(
        job.renderer_index,
        job.worker_index,
    )
    written: u64 = 0
    tile = job.tiles_start
    @budget(bound=16777216)
    while tile < job.tiles_end:
        tile_x = tile % tiles_x
        tile_y = tile / tiles_x
        x0 = tile_x * 16
        y0 = tile_y * 16
        x1 = x0 + 16
        y1 = y0 + 16
        if x1 > width:
            x1 = width
        if y1 > height:
            y1 = height
        y = y0
        previous_candidates = P7RowCandidates(ok=false, error=5, ids=[0; 256], count=0)
        previous_row = P7CertifiedRow.failure()
        @budget(bound=16)
        while y < y1:
            structural_candidates = __wrela_pixels_p7_row_candidates(
                job.renderer_index,
                tile,
                y,
                snapshot,
            )
            if not structural_candidates.ok:
                if structural_candidates.error == 1:
                    return __wrela_pixels_p7_worker_error(16, tile)
                return __wrela_pixels_p7_worker_error(8, tile)
            proposed: u16 = 0
            if proposals_enabled:
                proposed = __wrela_pixels_p7_revalidated_proposal_count(
                    previous_candidates,
                    structural_candidates,
                )
            candidates = __wrela_pixels_p7_row_candidates_with_proposal(
                previous_candidates,
                structural_candidates,
                proposals_enabled,
            )
            if not candidates.ok:
                if candidates.error == 1:
                    return __wrela_pixels_p7_worker_error(16, tile)
                return __wrela_pixels_p7_worker_error(8, tile)
            if not __wrela_pixels_p7_workspace_charge(
                job.renderer_index,
                job.worker_index,
                0,
                candidates.count.to[u64](),
            ):
                return __wrela_pixels_p7_worker_error(16, tile)
            if proposed > 0 and not __wrela_pixels_p7_workspace_charge(
                job.renderer_index,
                job.worker_index,
                5,
                proposed.to[u64](),
            ):
                return __wrela_pixels_p7_worker_error(16, tile)
            if telemetry_enabled:
                # P7.11 requires these three to be distinguishable. `offered`
                # is every record the previous row put forward, `proposed` is
                # the subset the structural index still lists for this row —
                # the guest's revalidation is exactly that membership test —
                # and `new_records` is what this row discovered on its own.
                # Charging one value to two bins, as this did, made the
                # proposal path unmeasurable.
                offered: u16 = 0
                if previous_candidates.ok:
                    offered = previous_candidates.count
                new_records = candidates.count - proposed
                event_count = __wrela_pixels_tile_event_count(job.renderer_index, tile)
                if event_count != 4294967295:
                    _ = __wrela_pixels_p7_telemetry_charge(
                        job.renderer_index,
                        job.worker_index,
                        31.to[usize]() + __wrela_pixels_p7_density_bin(candidates.count.to[u32]()),
                        1,
                    )
                    _ = __wrela_pixels_p7_telemetry_charge(
                        job.renderer_index,
                        job.worker_index,
                        47.to[usize]() + __wrela_pixels_p7_density_bin(event_count),
                        1,
                    )
                    _ = __wrela_pixels_p7_telemetry_charge(
                        job.renderer_index,
                        job.worker_index,
                        139,
                        offered.to[u64](),
                    )
                    _ = __wrela_pixels_p7_telemetry_charge(
                        job.renderer_index,
                        job.worker_index,
                        140,
                        proposed.to[u64](),
                    )
                    _ = __wrela_pixels_p7_telemetry_charge(
                        job.renderer_index,
                        job.worker_index,
                        141,
                        new_records.to[u64](),
                    )
            row = __wrela_pixels_p7_certify_row(
                context=P7RowCertificationContext(
                    renderer=job.renderer_index,
                    worker=job.worker_index,
                    tile=tile,
                    y=y,
                    x0=x0,
                    x1=x1,
                    proposal=previous_row,
                    proposals_enabled=proposals_enabled,
                ),
                candidates=candidates,
                snapshot=snapshot,
            )
            if not row.ok:
                return __wrela_pixels_p7_worker_error(row.error, tile)
            if telemetry_enabled:
                _ = __wrela_pixels_p7_telemetry_charge(
                    job.renderer_index,
                    job.worker_index,
                    39.to[usize]() + __wrela_pixels_p7_density_bin(row.root_count),
                    1,
                )
                _ = __wrela_pixels_p7_telemetry_charge(
                    job.renderer_index,
                    job.worker_index,
                    55.to[usize]() + __wrela_pixels_p7_density_bin(candidates.count.to[u32]()),
                    1,
                )
                _ = __wrela_pixels_p7_telemetry_charge(
                    job.renderer_index,
                    job.worker_index,
                    63.to[usize]() + __wrela_pixels_p7_density_bin(candidates.count.to[u32]()),
                    1,
                )
                _ = __wrela_pixels_p7_telemetry_charge(
                    job.renderer_index,
                    job.worker_index,
                    79,
                    row.root_count.to[u64](),
                )
            if not __wrela_pixels_p7_workspace_charge(
                job.renderer_index,
                job.worker_index,
                1,
                row.root_count.to[u64](),
            ) or not __wrela_pixels_p7_workspace_charge(
                job.renderer_index,
                job.worker_index,
                4,
                row.run_count.to[u64](),
            ) or not __wrela_pixels_p7_workspace_charge(
                job.renderer_index,
                job.worker_index,
                6,
                row.corridor_count.to[u64](),
            ):
                return __wrela_pixels_p7_worker_error(17, tile)
            index: u8 = 0
            run_record: u32 = 0
            corridor_record: u32 = 0
            coverage_x = x0
            @budget(bound=16)
            while index < row.count:
                sample = row.samples[index.to[usize]()]
                x = row.starts[index.to[usize]()].to[u32]()
                end = row.ends[index.to[usize]()].to[u32]()
                if x != coverage_x or end <= x or end > x1:
                    return __wrela_pixels_p7_worker_error(10, tile)
                record = run_record
                if sample.event:
                    record = corridor_record
                if not sample.ok:
                    return __wrela_pixels_p7_worker_error(10, tile)
                root_margin = sample.proof_margin
                if sample.event:
                    root_margin = 1
                if root_margin < 0:
                    root_margin = 0
                if root_margin > 65535:
                    root_margin = 65535
                order_margin = sample.proof_margin
                if sample.event:
                    order_margin = 1
                if order_margin < 0:
                    order_margin = 0
                if order_margin > 255:
                    order_margin = 255
                packed_proof = (
                    sample.proof_method.to[u64]()
                    | (sample.composition_shape.to[u64]() << 4)
                    | (root_margin.to[u64]() << 8)
                    | (order_margin.to[u64]() << 24)
                )
                model: [i64; 8] = [
                    sample.q_lo.to[i64](),
                    sample.q_hi.to[i64](),
                    0,
                    0,
                    0,
                    0,
                    0,
                    0,
                ]
                if row.modeled and row.count == 1:
                    model = [
                        row.model[0].to[i64](),
                        row.model[1].to[i64](),
                        row.model[2].to[i64](),
                        row.model[3].to[i64](),
                        row.model[4].to[i64](),
                        row.model[5].to[i64](),
                        row.model[6].to[i64](),
                        row.model[7].to[i64](),
                    ]
                normal_bounds: [i64; 6] = [
                    -32767, 32767,
                    -32767, 32767,
                    -32767, 32767,
                ]
                # Evidence word 3 always carries the row coordinate. Normal
                # components are meaningful only when `normal_bounds` is an
                # exact point model; otherwise they remain zero.
                evidence_aux_lo = y.to[i64]()
                evidence_aux_hi: i64 = 0
                evidence_point_witness: i64 = 0
                if sample.hit and not sample.event:
                    center_x = x.to[f32]() + (end - x).to[f32]() * 0.5
                    center_u = (
                        ((center_x / width.to[f32]()) * 2.0 - 1.0)
                        * width.to[f32]() / height.to[f32]()
                    )
                    center_v = 1.0 - (
                        (y.to[f32]() + 0.5) / height.to[f32]()
                    ) * 2.0
                    if telemetry_enabled:
                        point_sample = __wrela_pixels_p7_pixel_visibility_from_candidates(
                            renderer=job.renderer_index,
                            worker=job.worker_index,
                            tile=tile,
                            span=x | (end << 16),
                            y=y,
                            filter=[center_u, center_v, 0.0, 0.0],
                            candidates=candidates,
                            snapshot=snapshot,
                        )
                        if (
                            point_sample.ok and point_sample.hit
                            and point_sample.identity == sample.identity
                            and point_sample.q_hi >= sample.q_lo
                            and point_sample.q_lo <= sample.q_hi
                        ):
                            evidence_point_witness = 1
                    normal = __wrela_pixels_p7_feature_normal(
                        job.renderer_index,
                        sample.root_count >> 16,
                        center_u,
                        center_v,
                        __wrela_pixels_p7_raw_to_f32(
                            sample.q_lo + (
                                sample.q_hi - sample.q_lo
                            ) / 2,
                            config[3].to[i32](),
                        ),
                        snapshot.params,
                        snapshot.camera,
                    )
                    # `__wrela_pixels_p7_feature_normal` only has a closed form
                    # for a feature that *is* an unmodified root primitive. A
                    # feature reached through a bounded deformation has no such
                    # form: the displaced surface normal is grad(f_base) + grad(d),
                    # not the primitive's. Status 0 therefore means "no normal
                    # claim", not "corrupt state" — `normal_bounds` keeps its
                    # full-range (vacuous) enclosure and the auxiliary evidence
                    # remains non-authoritative. Substituting the
                    # primitive normal here would seal a false point enclosure.
                    if normal[0] == 1.0:
                        nx = (normal[1] * 32767.0).to[i64]()
                        ny = (normal[2] * 32767.0).to[i64]()
                        nz = (normal[3] * 32767.0).to[i64]()
                        if nx < -32767 or nx > 32767 or ny < -32767 or ny > 32767 or nz < -32767 or nz > 32767:
                            return __wrela_pixels_p7_worker_error(12, tile)
                        if sample.composition_shape == 1:
                            normal_bounds = [nx, nx, ny, ny, nz, nz]
                        evidence_aux_lo = y.to[i64]() | ((nx & 65535) << 16)
                        evidence_aux_hi = (ny & 65535) | ((nz & 65535) << 16)
                evidence_meta = (
                    sample.root_count.to[i64]()
                    | (sample.proof_method.to[i64]() << 32)
                    | (sample.composition_shape.to[i64]() << 40)
                    | (sample.coverage.to[i64]() << 48)
                    | (evidence_point_witness << 57)
                )
                if sample.event:
                    evidence_meta = evidence_meta | (1 << 56)
                slacks: [i64; 2] = [2147483647, 2147483647]
                if sample.hit and not sample.event:
                    if sample.proof_margin <= 0:
                        return __wrela_pixels_p7_worker_error(12, tile)
                    slacks = [
                        sample.proof_margin.to[i64](),
                        sample.proof_margin.to[i64](),
                    ]
                if telemetry_enabled:
                    if not __wrela_pixels_p7_workspace_store_certified_run(
                        job.renderer_index,
                        job.worker_index,
                        record,
                        [
                            row.starts[index.to[usize]()].to[i64](),
                            row.ends[index.to[usize]()].to[i64](),
                            sample.object.to[i64](),
                            sample.identity.to[i64](),
                            sample.q_lo.to[i64](),
                            sample.q_hi.to[i64](),
                            evidence_aux_lo,
                            evidence_aux_hi,
                        ],
                        model,
                        normal_bounds,
                        slacks,
                        evidence_meta,
                    ):
                        return __wrela_pixels_p7_worker_error(12, tile)
                    _ = __wrela_pixels_p7_charge_run_telemetry(
                        job.renderer_index,
                        job.worker_index,
                        sample,
                        end - x,
                    )
                if sample.event:
                    corridor_record = corridor_record + 1
                else:
                    run_record = run_record + 1
                @budget(bound=16)
                while x < end:
                    r: u8 = 0
                    g: u8 = 0
                    b: u8 = 0
                    a: u8 = 0
                    if sample.hit:
                        r = (sample.object & 255).to[u8]()
                        g = (sample.identity & 255).to[u8]()
                        b = ((sample.identity >> 8) & 255).to[u8]()
                        width_class = sample.q_hi.to[i64]() - sample.q_lo.to[i64]()
                        if width_class < 0:
                            return __wrela_pixels_p7_worker_error(13, tile)
                        if width_class > 126:
                            width_class = 126
                        a = (129 + width_class).to[u8]()
                        if sample.event:
                            a = sample.coverage
                    pixel = y * width + x
                    if not __wrela_pixels_p7_framebuffer_write(
                        job.renderer_index,
                        pixel,
                        r,
                        g,
                        b,
                        a,
                    ):
                        return __wrela_pixels_p7_worker_error(13, tile)
                    slot: usize = 2
                    if sample.event:
                        slot = 3
                    if not __wrela_pixels_p7_workspace_charge(
                        job.renderer_index,
                        job.worker_index,
                        slot,
                        1,
                    ):
                        return __wrela_pixels_p7_worker_error(13, tile)
                    written = written +% 1
                    if written == 18446744073709551615:
                        return __wrela_pixels_p7_worker_error(13, tile)
                    x = x + 1
                coverage_x = x
                index = index + 1
            if coverage_x != x1:
                return __wrela_pixels_p7_worker_error(14, tile)
            if run_record != row.run_count.to[u32]() or corridor_record != row.corridor_count.to[u32]():
                return __wrela_pixels_p7_worker_error(14, tile)
            previous_candidates = structural_candidates
            previous_row = row
            y = y + 1
        tile = tile + 1
    return written

pub fn __wrela_pixels_p7_debug_probe(
    renderer: usize,
    tile: u32,
    x: u32,
    y: u32,
    read params: [f32; 16],
    read camera: [f32; 12],
) -> [i64; 15]:
    snapshot = FrameInputSnapshot.from_packed(
        params,
        __wrela_pixels_p7_numeric_config(renderer)[6].to[u16](),
        camera,
        0,
    )
    candidates = __wrela_pixels_p7_row_candidates(renderer, tile, y, snapshot)
    roots = __wrela_pixels_p7_collect_roots(renderer, 0, x, y, candidates, snapshot)
    config = __wrela_pixels_p7_numeric_config(renderer)
    width = config[1].to[u32]()
    height = config[2].to[u32]()
    u = (((x.to[f32]() + 0.5) / width.to[f32]()) * 2.0 - 1.0) * width.to[f32]() / height.to[f32]()
    v = 1.0 - ((y.to[f32]() + 0.5) / height.to[f32]()) * 2.0
    sample = __wrela_pixels_p7_select_visibility(renderer, roots)
    values = sample.debug_values()
    normal: [f32; 4] = [0.0; 4]
    if values[1] == 1 and values[2] == 0:
        normal = __wrela_pixels_p7_feature_normal(
            renderer,
            values[8].to[u32](),
            u,
            v,
            __wrela_pixels_p7_raw_to_f32(
                (values[5] + (values[6] - values[5]) / 2).to[i32](),
                __wrela_pixels_p7_numeric_config(renderer)[3].to[i32](),
            ),
            params,
            camera,
        )
    return [
        values[0],
        values[1],
        values[2],
        values[3],
        values[4],
        values[5],
        values[6],
        roots.debug_count().to[i64](),
        candidates.debug_count().to[i64](),
        values[9],
        normal[0].to[i64](),
        (normal[1] * 1000000.0).to[i64](),
        (normal[2] * 1000000.0).to[i64](),
        (normal[3] * 1000000.0).to[i64](),
        values[10],
    ]

pub fn __wrela_pixels_p7_debug_probe_at_u(
    renderer: usize,
    worker: u32,
    tile: u32,
    x: u32,
    y: u32,
    u: f32,
    read params: [f32; 16],
    read camera: [f32; 12],
) -> [i64; 10]:
    if not __wrela_pixels_p7_frame_snapshot_store(
        renderer,
        params,
        __wrela_pixels_p7_numeric_config(renderer)[6].to[u16](),
        camera,
        [0; 8],
        [0.0; 120],
        [0.0; 4],
        0,
    ):
        return [0; 10]
    snapshot = FrameInputSnapshot.from_packed(
        params,
        __wrela_pixels_p7_numeric_config(renderer)[6].to[u16](),
        camera,
        0,
    )
    candidates = __wrela_pixels_p7_row_candidates(renderer, tile, y, snapshot)
    roots = __wrela_pixels_p7_collect_roots_box(
        renderer,
        worker,
        x,
        x + 1,
        y,
        [
            u,
            1.0 - ((y.to[f32]() + 0.5) / __wrela_pixels_p7_numeric_config(renderer)[2].to[f32]()) * 2.0,
            0.0,
            0.0,
        ],
        candidates,
        snapshot,
    )
    sample = __wrela_pixels_p7_select_visibility(renderer, roots)
    values = sample.debug_values()
    return [
        values[0],
        values[1],
        0,
        values[3],
        values[4],
        values[5],
        values[6],
        roots.debug_count().to[i64](),
        candidates.debug_count().to[i64](),
        values[9],
    ]

pub fn __wrela_pixels_p7_debug_probe_cell(
    renderer: usize,
    tile: u32,
    x: u32,
    y: u32,
    read filter: [f32; 4],
    index: u32,
    read params: [f32; 16],
    read camera: [f32; 12],
) -> [i64; 12]:
    if not __wrela_pixels_p7_frame_snapshot_store(
        renderer,
        params,
        __wrela_pixels_p7_numeric_config(renderer)[6].to[u16](),
        camera,
        [0; 8],
        [0.0; 120],
        [0.0; 4],
        0,
    ):
        return [0; 12]
    snapshot = FrameInputSnapshot.from_packed(
        params,
        __wrela_pixels_p7_numeric_config(renderer)[6].to[u16](),
        camera,
        0,
    )
    candidates = __wrela_pixels_p7_row_candidates(renderer, tile, y, snapshot)
    roots = __wrela_pixels_p7_collect_roots_box(
        renderer,
        0,
        x,
        x + 1,
        y,
        filter,
        candidates,
        snapshot,
    )
    if index < roots.count:
        record = __wrela_pixels_p7_load_root(roots, index)
        crossing_flag: i64 = 0
        if record.crossing:
            crossing_flag = 1
        record_ok: i64 = 0
        if record.ok:
            record_ok = 1
        return [
            2,
            record.lo.to[i64](),
            record.hi.to[i64](),
            record.object.to[i64](),
            record.identity.to[i64](),
            record.feature.to[i64](),
            crossing_flag,
            record.method.to[i64](),
            record.margin.to[i64](),
            record_ok,
            0,
            0,
        ]
    sample = __wrela_pixels_p7_select_visibility(renderer, roots)
    sample_flags: i64 = 0
    if sample.ok:
        sample_flags = sample_flags | 1
    if sample.hit:
        sample_flags = sample_flags | 2
    if sample.event:
        sample_flags = sample_flags | 4
    roots_ok: i64 = 0
    if roots.ok:
        roots_ok = 1
    return [
        1,
        roots.count.to[i64](),
        roots_ok | (roots.error.to[i64]() << 8),
        sample_flags,
        sample.error.to[i64](),
        sample.q_lo.to[i64](),
        sample.q_hi.to[i64](),
        sample.identity.to[i64](),
        sample.object.to[i64](),
        sample.coverage.to[i64](),
        sample.proof_margin.to[i64](),
        (candidates.debug_count().to[i64]() << 8) | roots.count.to[i64](),
    ]

pub fn __wrela_pixels_p7_debug_probe_coverage(
    renderer: usize,
    tile: u32,
    x: u32,
    y: u32,
    read params: [f32; 16],
    read camera: [f32; 12],
) -> [i64; 12]:
    if not __wrela_pixels_p7_frame_snapshot_store(
        renderer,
        params,
        __wrela_pixels_p7_numeric_config(renderer)[6].to[u16](),
        camera,
        [0; 8],
        [0.0; 120],
        [0.0; 4],
        0,
    ):
        return [0; 12]
    snapshot = FrameInputSnapshot.from_packed(
        params,
        __wrela_pixels_p7_numeric_config(renderer)[6].to[u16](),
        camera,
        0,
    )
    candidates = __wrela_pixels_p7_row_candidates(renderer, tile, y, snapshot)
    config = __wrela_pixels_p7_numeric_config(renderer)
    width = config[1].to[f32]()
    height = config[2].to[f32]()
    point_filter: [f32; 4] = [
        (((x.to[f32]() + 0.5) / width) * 2.0 - 1.0) * width / height,
        1.0 - ((y.to[f32]() + 0.5) / height) * 2.0,
        0.0,
        0.0,
    ]
    side = __wrela_pixels_p7_pixel_visibility_from_candidates(
        renderer=renderer,
        worker=0,
        tile=tile,
        span=x | ((x + 1) << 16),
        y=y,
        filter=point_filter,
        candidates=candidates,
        snapshot=snapshot,
    )
    curve = __wrela_pixels_p7_silhouette_coverage(
        renderer, 0, tile, x, y, candidates, side, snapshot,
    )
    count = __wrela_pixels_tile_event_count(renderer, tile)
    event_id: i64 = -1
    event_kind: i64 = -1
    event_x0: i64 = -1
    event_x1: i64 = -1
    event_version: i64 = -1
    if count > 0 and count != 4294967295:
        event = __wrela_pixels_tile_event(renderer, tile, 0)
        if event[0] == 1:
            event_id = event[1].to[i64]()
            record = __wrela_pixels_program_record(renderer, 7, event[1].to[u32]())
            event_version = record[2].to[i64]()
            kind = __wrela_pixels_program_operand(renderer, 7, event[1].to[u32](), 0)
            x0 = __wrela_pixels_program_operand(renderer, 7, event[1].to[u32](), 3)
            x1 = __wrela_pixels_program_operand(renderer, 7, event[1].to[u32](), 4)
            if kind[0] == 1:
                event_kind = kind[1].to[i64]()
            if x0[0] == 1:
                event_x0 = x0[1].to[i64]()
            if x1[0] == 1:
                event_x1 = x1[1].to[i64]()
    side_flags: i64 = 0
    if side.ok:
        side_flags = side_flags | 1
    if side.hit:
        side_flags = side_flags | 2
    if side.event:
        side_flags = side_flags | 4
    # Histogram of event kinds covering pixel (x, y): kind k (0..15) counts
    # in nibble k, saturating at 15.
    kind_histogram: i64 = 0
    if count > 0 and count != 4294967295 and count <= 256:
        ordinal: u32 = 0
        @budget(bound=256)
        while ordinal < count:
            event = __wrela_pixels_tile_event(renderer, tile, ordinal)
            if event[0] == 1 and event[1] <= 4294967295:
                identifier = event[1].to[u32]()
                kind = __wrela_pixels_program_operand(renderer, 7, identifier, 0)
                x0 = __wrela_pixels_program_operand(renderer, 7, identifier, 3)
                x1 = __wrela_pixels_program_operand(renderer, 7, identifier, 4)
                y0 = __wrela_pixels_program_operand(renderer, 7, identifier, 5)
                y1 = __wrela_pixels_program_operand(renderer, 7, identifier, 6)
                if (
                    kind[0] == 1 and kind[1] < 16
                    and x0[0] == 1 and x1[0] == 1 and y0[0] == 1 and y1[0] == 1
                    and x.to[u64]() >= x0[1] and x.to[u64]() < x1[1]
                    and y.to[u64]() >= y0[1] and y.to[u64]() < y1[1]
                ):
                    shift = (kind[1] * 4).to[u32]()
                    slot = (kind_histogram >> shift.to[i64]()) & 15
                    if slot < 15:
                        kind_histogram = kind_histogram + (1.to[i64]() << shift.to[i64]())
            ordinal = ordinal + 1
    return [
        1,
        curve[0],
        curve[1],
        curve[2],
        kind_histogram,
        count.to[i64](),
        event_id,
        event_kind,
        event_x0,
        event_x1,
        event_version,
        side_flags | (side.error.to[i64]() << 8),
    ]

pub fn __wrela_pixels_p7_debug_probe_silhouette(
    renderer: usize,
    tile: u32,
    x: u32,
    y: u32,
    which: u32,
    read params: [f32; 16],
    read camera: [f32; 12],
) -> [i64; 12]:
    config = __wrela_pixels_p7_numeric_config(renderer)
    count = __wrela_pixels_tile_event_count(renderer, tile)
    if config[0] != 1 or count == 4294967295 or count > 256:
        return [0; 12]
    width = config[1].to[f32]()
    height = config[2].to[f32]()
    aspect = width / height
    u0 = ((x.to[f32]() / width) * 2.0 - 1.0) * aspect
    u1 = (((x + 1).to[f32]() / width) * 2.0 - 1.0) * aspect
    v0 = 1.0 - (y.to[f32]() / height) * 2.0
    v1 = 1.0 - ((y + 1).to[f32]() / height) * 2.0
    matched: u32 = 0
    ordinal: u32 = 0
    @budget(bound=256)
    while ordinal < count:
        event = __wrela_pixels_tile_event(renderer, tile, ordinal)
        ordinal = ordinal + 1
        if event[0] != 1 or event[1] > 4294967295:
            continue
        event_id = event[1].to[u32]()
        record = __wrela_pixels_program_record(renderer, 7, event_id)
        kind = __wrela_pixels_program_operand(renderer, 7, event_id, 0)
        x0 = __wrela_pixels_program_operand(renderer, 7, event_id, 3)
        x1 = __wrela_pixels_program_operand(renderer, 7, event_id, 4)
        y0 = __wrela_pixels_program_operand(renderer, 7, event_id, 5)
        y1 = __wrela_pixels_program_operand(renderer, 7, event_id, 6)
        if record[0] != 1 or kind[0] != 1 or kind[1] != 3:
            continue
        if x0[0] != 1 or x1[0] != 1 or y0[0] != 1 or y1[0] != 1:
            continue
        if x.to[u64]() < x0[1] or x.to[u64]() >= x1[1] or y.to[u64]() < y0[1] or y.to[u64]() >= y1[1]:
            continue
        if matched != which:
            matched = matched + 1
            continue
        p00 = __wrela_pixels_p7_event_polynomial(
            renderer, event_id, u0, v0, params, camera,
        )
        p10 = __wrela_pixels_p7_event_polynomial(
            renderer, event_id, u1, v0, params, camera,
        )
        p01 = __wrela_pixels_p7_event_polynomial(
            renderer, event_id, u0, v1, params, camera,
        )
        f00 = __wrela_pixels_p7_event_polynomial_at_q(p00, 1.0)
        f10 = __wrela_pixels_p7_event_polynomial_at_q(p10, 1.0)
        f01 = __wrela_pixels_p7_event_polynomial_at_q(p01, 1.0)
        return [
            1,
            event_id.to[i64](),
            record[2].to[i64](),
            __wrela_pixels_f32_to_bits(p00[0]).to[i64](),
            __wrela_pixels_f32_to_bits(p00[1]).to[i64](),
            __wrela_pixels_f32_to_bits(f00[1]).to[i64](),
            __wrela_pixels_f32_to_bits(f10[1]).to[i64](),
            __wrela_pixels_f32_to_bits(f01[1]).to[i64](),
            __wrela_pixels_f32_to_bits(f00[0]).to[i64](),
            x0[1].to[i64](),
            x1[1].to[i64](),
            kind[1].to[i64](),
        ]
    return [0; 12]

pub fn __wrela_pixels_p7_debug_probe_clip(
    renderer: usize,
    x: u32,
    y: u32,
    feature: u32,
    q: f32,
    read params: [f32; 16],
    read camera: [f32; 12],
) -> [i64; 12]:
    # A clip boundary is the level set of the feature's ray polynomial at the
    # sealed clip q. This reports that level set at the pixel's corners so the
    # crossing can be located without running the sweep.
    config = __wrela_pixels_p7_numeric_config(renderer)
    if config[0] != 1:
        return [0; 12]
    width = config[1].to[f32]()
    height = config[2].to[f32]()
    aspect = width / height
    u0 = ((x.to[f32]() / width) * 2.0 - 1.0) * aspect
    u1 = (((x + 1).to[f32]() / width) * 2.0 - 1.0) * aspect
    v0 = 1.0 - (y.to[f32]() / height) * 2.0
    v1 = 1.0 - ((y + 1).to[f32]() / height) * 2.0
    p00 = __wrela_pixels_p7_feature_polynomial(renderer, feature, u0, v0, params, camera)
    p10 = __wrela_pixels_p7_feature_polynomial(renderer, feature, u1, v0, params, camera)
    p01 = __wrela_pixels_p7_feature_polynomial(renderer, feature, u0, v1, params, camera)
    f00 = __wrela_pixels_p7_event_polynomial_at_q(p00, q)
    f10 = __wrela_pixels_p7_event_polynomial_at_q(p10, q)
    f01 = __wrela_pixels_p7_event_polynomial_at_q(p01, q)
    return [
        1,
        __wrela_pixels_f32_to_bits(p00[0]).to[i64](),
        __wrela_pixels_f32_to_bits(p00[1]).to[i64](),
        __wrela_pixels_f32_to_bits(f00[1]).to[i64](),
        __wrela_pixels_f32_to_bits(f10[1]).to[i64](),
        __wrela_pixels_f32_to_bits(f01[1]).to[i64](),
        __wrela_pixels_f32_to_bits(f00[0]).to[i64](),
        __wrela_pixels_f32_to_bits(p00[2]).to[i64](),
        __wrela_pixels_f32_to_bits(p00[3]).to[i64](),
        0,
        0,
        0,
    ]

pub fn __wrela_pixels_p7_debug_probe_row(
    renderer: usize,
    tile: u32,
    x: u32,
    y: u32,
    read params: [f32; 16],
    read camera: [f32; 12],
) -> [i64; 8]:
    if not __wrela_pixels_p7_frame_snapshot_store(
        renderer,
        params,
        __wrela_pixels_p7_numeric_config(renderer)[6].to[u16](),
        camera,
        [0; 8],
        [0.0; 120],
        [0.0; 4],
        0,
    ):
        return [0; 8]
    snapshot = FrameInputSnapshot.from_packed(
        params,
        __wrela_pixels_p7_numeric_config(renderer)[6].to[u16](),
        camera,
        0,
    )
    candidates = __wrela_pixels_p7_row_candidates(renderer, tile, y, snapshot)
    row = __wrela_pixels_p7_certify_pixel_row(
        renderer,
        0,
        tile,
        y,
        x,
        x + 1,
        candidates,
        snapshot,
    )
    row_ok: i64 = 0
    if row.ok:
        row_ok = 1
    sample = row.samples[0]
    sample_flags: i64 = 0
    if sample.ok:
        sample_flags = sample_flags | 1
    if sample.hit:
        sample_flags = sample_flags | 2
    if sample.event:
        sample_flags = sample_flags | 4
    if not row.ok:
        return [
            1,
            row_ok,
            row.error.to[i64](),
            row.model[0].to[i64](),
            row.model[1].to[i64](),
            row.model[3].to[i64](),
            row.model[4].to[i64](),
            row.model[5].to[i64](),
        ]
    return [
        1,
        row_ok,
        row.error.to[i64](),
        row.count.to[i64](),
        sample_flags,
        sample.coverage.to[i64](),
        sample.identity.to[i64](),
        sample.proof_margin.to[i64](),
    ]

pub fn __wrela_pixels_p7_debug_probe_validity(
    renderer: usize,
    feature: u32,
    read filter: [f32; 4],
    read q: [i32; 2],
    read params: [f32; 16],
    read camera: [f32; 12],
) -> [i64; 2]:
    if not __wrela_pixels_p7_frame_snapshot_store(
        renderer,
        params,
        __wrela_pixels_p7_numeric_config(renderer)[6].to[u16](),
        camera,
        [0; 8],
        [0.0; 120],
        [0.0; 4],
        0,
    ):
        return [-1, -1]
    return __wrela_pixels_p7_feature_valid_filter(
        renderer,
        feature,
        filter,
        q,
        __wrela_pixels_p7_numeric_config(renderer)[3].to[i32](),
        params,
        camera,
    )

pub fn __wrela_pixels_p7_debug_frame_digest(renderer: usize) -> [u64; 5]:
    return __wrela_pixels_p7_framebuffer_digest(renderer)

pub fn __wrela_pixels_p7_debug_alpha_samples(renderer: usize) -> u64:
    return __wrela_pixels_p7_framebuffer_alpha_samples(renderer)

pub fn __wrela_pixels_p7_debug_certified_run_word(
    renderer: usize,
    worker: u32,
    record: u32,
    word: usize,
) -> [u64; 2]:
    return __wrela_pixels_p7_workspace_load_certified_run_word(
        renderer,
        worker,
        record,
        word,
    )

# Instrumented-run frame dump for host conformance. Word 0 is the payload
# length; words 1..6 pack the validated snapshot camera and 7..14 the packed
# parameters (so the host oracle scores against the exact frame inputs, never
# a guessed camera); word 15 is the framebuffer word count and the rest the
# complete debug framebuffer as packed little-endian words. Readable only
# when certificate telemetry is enabled, so golden transcripts never change;
# the fixture traces the words through its own runtime binding because
# core.render cannot import core.runtime.
pub fn __wrela_pixels_p7_debug_frame_dump_word(renderer: usize, index: u64) -> [u64; 2]:
    if __wrela_pixels_p7_telemetry_counter(renderer, 0, 0)[0] != 1:
        return [0; 2]
    config = __wrela_pixels_p7_numeric_config(renderer)
    if config[0] != 1 or config[1] <= 0 or config[2] <= 0:
        return [0; 2]
    frame_bytes = config[1].to[u64]() * config[2].to[u64]() * 4
    frame_words = (frame_bytes + 7) / 8
    total = frame_words + 15
    if total > 65550:
        return [0; 2]
    if index == 0:
        return [1, total]
    if index >= 1 and index <= 6:
        camera = __wrela_pixels_p7_frame_snapshot_camera(renderer)
        camera_slot = (index - 1).to[usize]()
        low = __wrela_pixels_f32_to_bits(camera[camera_slot * 2]).to[u64]()
        high = __wrela_pixels_f32_to_bits(camera[camera_slot * 2 + 1]).to[u64]()
        return [1, low | (high << 32)]
    if index >= 7 and index <= 14:
        params = __wrela_pixels_p7_frame_snapshot_params(renderer)
        param_slot = (index - 7).to[usize]()
        low = __wrela_pixels_f32_to_bits(params[param_slot * 2]).to[u64]()
        high = __wrela_pixels_f32_to_bits(params[param_slot * 2 + 1]).to[u64]()
        return [1, low | (high << 32)]
    if index == 15:
        return [1, frame_words]
    word = index - 16
    if word >= frame_words:
        return [0; 2]
    value: u64 = 0
    octet: u64 = 0
    @budget(bound=8)
    while octet < 8:
        byte_index = word * 8 + octet
        if byte_index < frame_bytes:
            loaded = __wrela_pixels_p7_framebuffer_byte(renderer, byte_index.to[usize]())
            if loaded[0] != 1:
                return [0; 2]
            value = value | (loaded[1] << (octet * 8))
        octet = octet + 1
    return [1, value]

fn __wrela_pixels_p7_job_value(take result: Result[u64, CallError[never]]) -> u64:
    match result:
        case .Ok(value):
            return value
        case .Err(call_error):
            match call_error:
                case .Cancelled:
                    return __wrela_pixels_p7_worker_error(8, 0)
                case .DeadlineExceeded:
                    return __wrela_pixels_p7_worker_error(9, 0)
                case .NotAdmitted(_, _):
                    return __wrela_pixels_p7_worker_error(10, 0)
                case .Op(_):
                    return __wrela_pixels_p7_worker_error(12, 0)

async fn pixels_p7_worker_job_4_0(worker: Actor[RendererWorker0], word: u64) -> u64:
    result = await worker.run_job(word=word)
    return __wrela_pixels_p7_job_value(take result)

async fn pixels_p7_worker_job_4_1(worker: Actor[RendererWorker1], word: u64) -> u64:
    result = await worker.run_job(word=word)
    return __wrela_pixels_p7_job_value(take result)

async fn pixels_p7_worker_job_4_2(worker: Actor[RendererWorker2], word: u64) -> u64:
    result = await worker.run_job(word=word)
    return __wrela_pixels_p7_job_value(take result)

async fn pixels_p7_worker_job_4_3(worker: Actor[RendererWorker3], word: u64) -> u64:
    result = await worker.run_job(word=word)
    return __wrela_pixels_p7_job_value(take result)

pub struct RendererWorkers:
    worker_0: Actor[RendererWorker0]
    worker_1: Actor[RendererWorker1]
    worker_2: Actor[RendererWorker2]
    worker_3: Actor[RendererWorker3]

pub struct RendererPlacementState:
    frameprog_base: usize
    state_base: usize
    state_bytes: usize
    worker_assignment_0: RendererWorkerAssignment
    worker_assignment_1: RendererWorkerAssignment
    worker_assignment_2: RendererWorkerAssignment
    worker_assignment_3: RendererWorkerAssignment

pub struct RendererDigestState:
    pub ok: bool
    pub digest: u64
    pub error: u8
    pub tile: u32

pub fn __wrela_pixels_p7_digest_result(state: RendererDigestState, take result: Result[u64, CallError[never]]) -> RendererDigestState:
    @discard(reason="worker call failure becomes an explicit failed digest state")
    match result:
        case .Ok(value):
            error = __wrela_pixels_p7_worker_error_code(value)
            if not state.ok:
                return state
            if error != 0:
                return RendererDigestState(
                    ok=false,
                    digest=0,
                    error=error,
                    tile=__wrela_pixels_p7_worker_error_tile(value),
                )
            if value == 0:
                return state
            return RendererDigestState(
                ok=true,
                digest=state.digest +% value,
                error=0,
                tile=0,
            )
        case .Err(call_error):
            match call_error:
                case .Cancelled:
                    return RendererDigestState(ok=false, digest=0, error=8, tile=0)
                case .DeadlineExceeded:
                    return RendererDigestState(ok=false, digest=0, error=9, tile=0)
                case .NotAdmitted(_, _):
                    return RendererDigestState(ok=false, digest=0, error=10, tile=0)
                case .Op(_):
                    return RendererDigestState(ok=false, digest=0, error=12, tile=0)

pub struct RendererFrameBounds:
    exposure_min: f32
    exposure_max: f32
    environment_min_r: f32
    environment_min_g: f32
    environment_min_b: f32
    environment_max_r: f32
    environment_max_g: f32
    environment_max_b: f32
    camera_eye_x_min: f32
    camera_eye_x_max: f32
    camera_eye_y_min: f32
    camera_eye_y_max: f32
    camera_eye_z_min: f32
    camera_eye_z_max: f32
    camera_forward_x_min: f32
    camera_forward_x_max: f32
    camera_forward_y_min: f32
    camera_forward_y_max: f32
    camera_forward_z_min: f32
    camera_forward_z_max: f32
    camera_right_x_min: f32
    camera_right_x_max: f32
    camera_right_y_min: f32
    camera_right_y_max: f32
    camera_right_z_min: f32
    camera_right_z_max: f32
    camera_up_x_min: f32
    camera_up_x_max: f32
    camera_up_y_min: f32
    camera_up_y_max: f32
    camera_up_z_min: f32
    camera_up_z_max: f32
    light_capacity: usize
    light_kind_0: usize
    light_kind_1: usize
    light_kind_2: usize
    light_kind_3: usize
    light_kind_4: usize
    light_kind_5: usize
    light_kind_6: usize
    light_kind_7: usize

    pub fn __wrela_p5_accepts_camera(read self, read camera: Camera) -> bool:
        return (
            camera.eye.x >= self.camera_eye_x_min
            and camera.eye.x <= self.camera_eye_x_max
            and camera.eye.y >= self.camera_eye_y_min
            and camera.eye.y <= self.camera_eye_y_max
            and camera.eye.z >= self.camera_eye_z_min
            and camera.eye.z <= self.camera_eye_z_max
            and camera.forward.x >= self.camera_forward_x_min
            and camera.forward.x <= self.camera_forward_x_max
            and camera.forward.y >= self.camera_forward_y_min
            and camera.forward.y <= self.camera_forward_y_max
            and camera.forward.z >= self.camera_forward_z_min
            and camera.forward.z <= self.camera_forward_z_max
            and camera.right.x >= self.camera_right_x_min
            and camera.right.x <= self.camera_right_x_max
            and camera.right.y >= self.camera_right_y_min
            and camera.right.y <= self.camera_right_y_max
            and camera.right.z >= self.camera_right_z_min
            and camera.right.z <= self.camera_right_z_max
            and camera.up.x >= self.camera_up_x_min
            and camera.up.x <= self.camera_up_x_max
            and camera.up.y >= self.camera_up_y_min
            and camera.up.y <= self.camera_up_y_max
            and camera.up.z >= self.camera_up_z_min
            and camera.up.z <= self.camera_up_z_max
        )

@actor
pub struct Renderer[P]:
    workers: RendererWorkers
    worker_count: u32
    display: usize
    renderer_index: u32
    frameprog_base: usize
    state_base: usize
    state_bytes: usize
    worker_assignment_0: RendererWorkerAssignment
    worker_assignment_1: RendererWorkerAssignment
    worker_assignment_2: RendererWorkerAssignment
    worker_assignment_3: RendererWorkerAssignment
    bounds: RendererFrameBounds
    program_valid: bool

    init(
        mut self,
        workers: RendererWorkers,
        worker_count: u32,
        display: usize,
        renderer_index: u32,
        placement: RendererPlacementState,
        bounds: RendererFrameBounds,
    ):
        self.workers = workers
        self.worker_count = worker_count
        self.display = display
        self.renderer_index = renderer_index
        self.frameprog_base = placement.frameprog_base
        self.state_base = placement.state_base
        self.state_bytes = placement.state_bytes
        self.worker_assignment_0 = placement.worker_assignment_0
        self.worker_assignment_1 = placement.worker_assignment_1
        self.worker_assignment_2 = placement.worker_assignment_2
        self.worker_assignment_3 = placement.worker_assignment_3
        self.bounds = bounds
        # Header, directory, digest, revision, flags, and reserved fields are
        # checked once at actor initialization. Per-frame turns only use the
        # checked, compiler-generated accessors.
        self.program_valid = __wrela_pixels_program_validate(renderer_index.to[usize]())

    fn __validate_fixed_frame(read self, read frame: RenderFrame[P])
        -> Result[unit, RenderError]:
        if not __wrela_pixels_p5_finite(frame.exposure):
            return Err(RenderError.NonFiniteInput(RenderPath(component=2)))
        if frame.exposure < self.bounds.exposure_min or frame.exposure > self.bounds.exposure_max:
            return Err(RenderError.ParameterOutOfRange(RenderPath(component=2)))
        if (
            not __wrela_pixels_p5_finite(frame.environment.r)
            or not __wrela_pixels_p5_finite(frame.environment.g)
            or not __wrela_pixels_p5_finite(frame.environment.b)
        ):
            return Err(RenderError.NonFiniteInput(RenderPath(component=3)))
        if (
            frame.environment.r < self.bounds.environment_min_r
            or frame.environment.r > self.bounds.environment_max_r
            or frame.environment.g < self.bounds.environment_min_g
            or frame.environment.g > self.bounds.environment_max_g
            or frame.environment.b < self.bounds.environment_min_b
            or frame.environment.b > self.bounds.environment_max_b
        ):
            return Err(RenderError.ParameterOutOfRange(RenderPath(component=3)))
        if not frame.camera.__wrela_p5_finite():
            return Err(RenderError.NonFiniteInput(RenderPath(component=4)))
        if not self.bounds.__wrela_p5_accepts_camera(frame.camera):
            return Err(RenderError.FrameContractMismatch(RenderPath(component=4)))
        index: usize = 0
        @budget(bound=8)
        while index < 8:
            light = frame.lights.lights[index]
            if not light.__wrela_p5_finite():
                return Err(RenderError.NonFiniteInput(RenderPath(component=5)))
            expected_kind: usize = 0
            if index == 0:
                expected_kind = self.bounds.light_kind_0
            if index == 1:
                expected_kind = self.bounds.light_kind_1
            if index == 2:
                expected_kind = self.bounds.light_kind_2
            if index == 3:
                expected_kind = self.bounds.light_kind_3
            if index == 4:
                expected_kind = self.bounds.light_kind_4
            if index == 5:
                expected_kind = self.bounds.light_kind_5
            if index == 6:
                expected_kind = self.bounds.light_kind_6
            if index == 7:
                expected_kind = self.bounds.light_kind_7
            if index >= self.bounds.light_capacity:
                expected_kind = 0
            if not light.__wrela_p5_matches_kind(expected_kind):
                return Err(RenderError.FrameContractMismatch(RenderPath(component=5)))
            index = index + 1
        return Ok(unit)

    fn __validate_frame(read self, frame: RenderFrame[P]) -> Result[unit, RenderError]:
        fixed = self.__validate_fixed_frame(frame)
        match fixed:
            case .Err(error):
                return Err(take error)
            case .Ok(_):
                pass
        # A renderer may pin its camera to one exact pose (`camera_pose=` on
        # the declaration). Enforcing it here is what converts the analytic
        # coverage tiers' pose precondition from a per-frame runtime test into
        # a compile-time fact: a pinned renderer either renders at the sealed
        # pose or refuses the frame, so the tier is never silently unavailable.
        pinned = __wrela_pixels_p7_pinned_camera(self.renderer_index.to[usize]())
        if pinned[0] == 1.0:
            if (
                frame.camera.eye.x != pinned[1] or frame.camera.eye.y != pinned[2]
                or frame.camera.eye.z != pinned[3]
                or frame.camera.forward.x != pinned[4]
                or frame.camera.forward.y != pinned[5]
                or frame.camera.forward.z != pinned[6]
                or frame.camera.right.x != pinned[7]
                or frame.camera.right.y != pinned[8]
                or frame.camera.right.z != pinned[9]
                or frame.camera.up.x != pinned[10]
                or frame.camera.up.y != pinned[11]
                or frame.camera.up.z != pinned[12]
            ):
                return Err(RenderError.ParameterOutOfRange(RenderPath(component=6)))
        return Ok(unit)

    fn __snapshot_frame(read self, read frame: RenderFrame[P]) -> FrameInputSnapshot:
        values: [f32; 16] = [0.0; 16]
        return FrameInputSnapshot.make(
            params=values,
            param_count=0,
            camera=frame.camera,
            frame_index=frame.frame_index,
        )

    fn __construct_debug_frame(
        read self,
        take frame: RenderFrame[P],
        worker_digest: u64,
        renderer_index_value: u32,
    )
        -> Result[RenderedFrame[P], RenderFailure[P]]:
        renderer_index = renderer_index_value.to[usize]()
        config = __wrela_pixels_p7_numeric_config(renderer_index)
        if config[0] != 1:
            return self.__internal_error(take frame, 4099)
        expected_pixels = config[1].to[u64]() *% config[2].to[u64]()
        if worker_digest != expected_pixels:
            return self.__worker_error(take frame, 4, 0)
        exact = __wrela_pixels_p7_debug_frame_digest(renderer_index)
        if exact[0] != 1:
            return self.__internal_error(take frame, 4100)
        digest: [u8; 32] = [0; 32]
        word: usize = 0
        @budget(bound=4)
        while word < 4:
            value = exact[word + 1]
            octet: usize = 0
            @budget(bound=8)
            while octet < 8:
                digest[word * 8 + octet] = ((value >> (octet * 8).to[u64]()) & 255).to[u8]()
                octet = octet + 1
            word = word + 1
        certificate_runs: u64 = 0
        event_corridors: u64 = 0
        revalidated_proposals: u64 = 0
        worker: u32 = 0
        @budget(bound=4)
        while worker < self.worker_count:
            runs = __wrela_pixels_p7_workspace_counter(renderer_index, worker, 4)
            proposals = __wrela_pixels_p7_workspace_counter(renderer_index, worker, 5)
            corridors = __wrela_pixels_p7_workspace_counter(renderer_index, worker, 6)
            if runs[0] != 1 or proposals[0] != 1 or corridors[0] != 1:
                return self.__internal_error(take frame, 4101)
            next_runs = certificate_runs +% runs[1]
            next_proposals = revalidated_proposals +% proposals[1]
            next_corridors = event_corridors +% corridors[1]
            if next_runs < certificate_runs or next_proposals < revalidated_proposals or next_corridors < event_corridors:
                return self.__internal_error(take frame, 4102)
            certificate_runs = next_runs
            revalidated_proposals = next_proposals
            event_corridors = next_corridors
            worker = worker + 1
        telemetry_digest: [u64; 4] = [
            1469598103934665603,
            1099511628211,
            7809847782465536322,
            1609587929392839161,
        ]
        telemetry_present = __wrela_pixels_p7_telemetry_counter(
            renderer_index,
            0,
            0,
        )[0] == 1
        counter: usize = 0
        @budget(bound=142)
        while telemetry_present and counter < 142:
            merged: u64 = 0
            worker = 0
            @budget(bound=4)
            while worker < self.worker_count:
                value = __wrela_pixels_p7_telemetry_counter(
                    renderer_index,
                    worker,
                    counter,
                )
                if value[0] != 1:
                    return self.__internal_error(take frame, 4104)
                next = merged +% value[1]
                if next < merged:
                    return self.__internal_error(take frame, 4105)
                merged = next
                worker = worker + 1
            telemetry_digest[0] = (telemetry_digest[0] ^ merged) *% 1099511628211
            telemetry_digest[1] = (telemetry_digest[1] +% merged +% counter.to[u64]()) *% 14029467366897019727
            telemetry_digest[2] = (telemetry_digest[2] ^ (merged << (counter % 8).to[u64]())) *% 11400714785074694791
            telemetry_digest[3] = (telemetry_digest[3] +% (merged ^ counter.to[u64]())) *% 9650029242287828579
            counter = counter + 1
        if not telemetry_present:
            telemetry_digest = [0; 4]
        frame_index = frame.frame_index
        rendered = RenderedFrame[P](
            params=take frame.params,
            frame_index=frame_index,
            displayed_digest=digest,
            rebuilt_tiles=0,
            reused_tiles=0,
            certificate_runs=certificate_runs,
            event_corridors=event_corridors,
            revalidated_proposals=revalidated_proposals,
            certificate_telemetry_digest=telemetry_digest,
        )
        return Ok(take rendered)

    fn __render_error(
        read self,
        take frame: RenderFrame[P],
        take error: RenderError,
    ) -> Result[RenderedFrame[P], RenderFailure[P]]:
        return Err(RenderFailure[P](params=take frame.params, error=take error))

    fn __internal_error(
        read self,
        take frame: RenderFrame[P],
        kind: u32,
    ) -> Result[RenderedFrame[P], RenderFailure[P]]:
        return Err(RenderFailure[P](
            params=take frame.params,
            error=RenderError.InternalInvariant(RenderInvariant(kind=kind)),
        ))

    fn __worker_error(
        read self,
        take frame: RenderFrame[P],
        error: u8,
        tile: u32,
    ) -> Result[RenderedFrame[P], RenderFailure[P]]:
        # The code-to-class mapping is generated from the single-source
        # worker error table (`pixels::worker_errors` in the compiler); the
        # classifier is regenerated with the image, so this dispatch cannot
        # drift from the table. §2.6: bounded refinement running out of
        # budget is an *expected* fail-closed outcome and carries its own
        # variant; `InternalInvariant` is reserved for corrupt
        # compiler-generated state, and any unregistered code lands there.
        error_class = __wrela_pixels_p7_worker_error_class(error)
        if error_class == 1:
            # Capacity charges are proven ceilings, not corrupt state; the
            # kind equals the worker error code so traces stay
            # self-describing.
            return Err(RenderFailure[P](
                params=take frame.params,
                error=RenderError.CapacityExceeded(RenderCapacity(kind=error.to[u32]())),
            ))
        if error_class == 2:
            return Err(RenderFailure[P](
                params=take frame.params,
                error=RenderError.EventIsolationExhausted(TileId(value=tile)),
            ))
        if error_class == 3:
            # CertificateExhausted reports the worker sub-code in the high
            # half of its tile word, so red traces name their cause.
            return Err(RenderFailure[P](
                params=take frame.params,
                error=RenderError.CertificateExhausted(TileId(
                    value=(tile & 65535) | (error.to[u32]() << 16),
                )),
            ))
        if error_class == 4:
            return Err(RenderFailure[P](
                params=take frame.params,
                error=RenderError.RootIsolationExhausted(TileId(value=tile)),
            ))
        if error_class == 5:
            return Err(RenderFailure[P](
                params=take frame.params,
                error=RenderError.FixedPointRangeExceeded(TileId(value=tile)),
            ))
        return self.__internal_error(
            take frame,
            2147483648 | (error.to[u32]() << 24) | (tile & 16777215),
        )

    pub async fn render(mut self, take frame: RenderFrame[P])
        -> Result[RenderedFrame[P], RenderFailure[P]]:
        # P7 always validates and constructs the debug visibility result from
        # the sealed program and current owned frame. No kinetic state is read.
        validated = self.__validate_frame(frame)
        match validated:
            case .Err(error):
                return self.__render_error(take frame, take error)
            case .Ok(_):
                pass
        snapshot = self.__snapshot_frame(frame)
        worker_count = self.worker_count
        renderer_index = self.renderer_index
        program_valid = self.program_valid
        if program_valid == false:
            return self.__internal_error(take frame, 4096)
        if worker_count == 0:
            return self.__internal_error(take frame, 4098)
        if worker_count > 4:
            return self.__internal_error(take frame, 4098)
        config = __wrela_pixels_p7_numeric_config(renderer_index.to[usize]())
        if config[0] != 1:
            return self.__internal_error(take frame, 4106)
        if config[6] < 0:
            return self.__internal_error(take frame, 4106)
        if config[6] > 16:
            return self.__internal_error(take frame, 4106)
        if snapshot.param_count.to[i64]() != config[6]:
            return self.__internal_error(take frame, 4106)
        snapshot_stored = __wrela_pixels_p7_frame_snapshot_store(
            renderer_index.to[usize](),
            snapshot.params,
            snapshot.param_count,
            snapshot.camera,
            snapshot.lights.snapshot_kinds(),
            snapshot.lights.snapshot_scalars(),
            snapshot.post_values(),
            snapshot.frame_index,
        )
        if snapshot_stored == false:
            return self.__internal_error(take frame, 4096)
        framebuffer_reset = __wrela_pixels_p7_framebuffer_reset(renderer_index.to[usize]())
        if framebuffer_reset == false:
            return self.__internal_error(take frame, 4096)
        worker_0 = self.workers.worker_0
        worker_1 = self.workers.worker_1
        worker_2 = self.workers.worker_2
        worker_3 = self.workers.worker_3
        assignment_0 = self.worker_assignment_0
        assignment_1 = self.worker_assignment_1
        assignment_2 = self.worker_assignment_2
        assignment_3 = self.worker_assignment_3
        renderer_usize = renderer_index.to[usize]()
        worker_state = RendererDigestState(ok=true, digest=0, error=0, tile=0)
        with group(capacity=4) as workers:
            workers.start(pixels_p7_worker_job_4_0, worker=worker_0, word=assignment_0.word)
            if worker_count > 1:
                workers.start(pixels_p7_worker_job_4_1, worker=worker_1, word=assignment_1.word)
            if worker_count > 2:
                workers.start(pixels_p7_worker_job_4_2, worker=worker_2, word=assignment_2.word)
            if worker_count > 3:
                workers.start(pixels_p7_worker_job_4_3, worker=worker_3, word=assignment_3.word)
            results = await workers.join_all()
            for result in results:
                worker_state = __wrela_pixels_p7_digest_result(worker_state, take result)
        if worker_state.ok == false:
            return self.__worker_error(
                take frame,
                worker_state.error,
                worker_state.tile,
            )
        return self.__construct_debug_frame(take frame, worker_state.digest, renderer_index)

pub fn __wrela_pixels_bootstrap_dispatch(table: u32, tag: u32) -> Result[u32, RenderError]:
    if table == 1 and tag >= 1 and tag <= 32:
        return Ok(tag)
    if table == 2 and tag >= 1 and tag <= 8:
        return Ok(tag)
    if table == 2 and tag >= 20 and tag <= 30:
        return Ok(tag)
    if table == 3 and tag == 1:
        return Ok(tag)
    if table == 4 and tag >= 1 and tag <= 3:
        return Ok(tag)
    if table == 5 and tag >= 1 and tag <= 3:
        return Ok(tag)
    if table == 6 and tag == 1:
        return Ok(tag)
    if table == 7 and tag >= 1 and tag <= 14:
        return Ok(tag)
    if table == 8 and tag >= 1 and tag <= 6:
        return Ok(tag)
    if table == 9 and tag >= 1 and tag <= 4:
        return Ok(tag)
    if table == 9 and tag >= 10 and tag <= 17:
        return Ok(tag)
    if table == 9 and tag >= 20 and tag <= 28:
        return Ok(tag)
    if table == 9 and tag >= 30 and tag <= 35:
        return Ok(tag)
    if table == 11 and tag == 1:
        return Ok(tag)
    return Err(RenderError.InternalInvariant(RenderInvariant(kind=tag)))

pub fn __wrela_pixels_bootstrap_scalar(tag: u32) -> Result[u32, RenderError]:
    return __wrela_pixels_bootstrap_dispatch(1, tag)

pub fn __wrela_pixels_bootstrap_field(tag: u32) -> Result[u32, RenderError]:
    return __wrela_pixels_bootstrap_dispatch(2, tag)

pub fn __wrela_pixels_bootstrap_object(tag: u32) -> Result[u32, RenderError]:
    return __wrela_pixels_bootstrap_dispatch(3, tag)

pub fn __wrela_pixels_bootstrap_feature(tag: u32) -> Result[u32, RenderError]:
    return __wrela_pixels_bootstrap_dispatch(4, tag)

pub fn __wrela_pixels_bootstrap_material(tag: u32) -> Result[u32, RenderError]:
    return __wrela_pixels_bootstrap_dispatch(5, tag)

pub fn __wrela_pixels_bootstrap_parameter(tag: u32) -> Result[u32, RenderError]:
    return __wrela_pixels_bootstrap_dispatch(6, tag)

pub fn __wrela_pixels_bootstrap_event(tag: u32) -> Result[u32, RenderError]:
    return __wrela_pixels_bootstrap_dispatch(7, tag)

