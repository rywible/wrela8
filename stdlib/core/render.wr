module render

from core.field import Rgb, Vec3, Vec4, cross3, dot3, length3, sqrt_scalar

pub fn __wrela_pixels_p5_finite(value: f32) -> bool:
    max_finite: f32 = 340282346638528859811704183484516925440.0
    return value == value and value <= max_finite and value >= -max_finite

pub struct RenderPath:
    pub component: u32

    pub fn renderer_unavailable() -> RenderPath:
        return RenderPath(component=1)

    pub fn is_renderer_unavailable(read self) -> bool:
        return self.component == 1

pub struct TileId:
    pub value: u32

pub struct RenderCapacity:
    pub kind: u32

pub struct RenderInvariant:
    pub kind: u32

pub struct DisplayError:
    pub code: u32

pub enum CameraError:
    DegenerateForward
    DegenerateUp
    DegenerateQuaternion
    InvalidBasis

pub struct Camera:
    eye: Vec3
    forward: Vec3
    right: Vec3
    up: Vec3

    # Authored forms are closed constructors. Successful construction always
    # produces the same canonical eye/right/up/forward representation.
    pub fn canonical(eye: Vec3) -> Camera:
        return Camera(
            eye=eye,
            forward=Vec3(x=0.0, y=0.0, z=1.0),
            right=Vec3(x=1.0, y=0.0, z=0.0),
            up=Vec3(x=0.0, y=1.0, z=0.0),
        )

    pub fn look_at(eye: Vec3, target: Vec3, authored_up: Vec3) -> Result[Camera, CameraError]:
        forward_seed = target.subtract(eye)
        forward_length = length3(forward_seed)
        if not forward_length > 0.0:
            return Err(CameraError.DegenerateForward)
        forward = Vec3(
            x=forward_seed.x / forward_length,
            y=forward_seed.y / forward_length,
            z=forward_seed.z / forward_length,
        )
        right_seed = cross3(authored_up, forward)
        right_length = length3(right_seed)
        if not right_length > 0.0:
            return Err(CameraError.DegenerateUp)
        right = Vec3(
            x=right_seed.x / right_length,
            y=right_seed.y / right_length,
            z=right_seed.z / right_length,
        )
        up = cross3(forward, right)
        return Ok(Camera(eye=eye, forward=forward, right=right, up=up))

    pub fn quaternion(eye: Vec3, rotation: Vec4) -> Result[Camera, CameraError]:
        ax = rotation.x
        if ax < 0.0:
            ax = -ax
        ay = rotation.y
        if ay < 0.0:
            ay = -ay
        az = rotation.z
        if az < 0.0:
            az = -az
        aw = rotation.w
        if aw < 0.0:
            aw = -aw
        max_finite: f32 = 340282346638528859811704183484516925440.0
        if not ax <= max_finite or not ay <= max_finite or not az <= max_finite or not aw <= max_finite:
            return Err(CameraError.DegenerateQuaternion)
        scale = ax
        if ay > scale:
            scale = ay
        if az > scale:
            scale = az
        if aw > scale:
            scale = aw
        if not scale > 0.0:
            return Err(CameraError.DegenerateQuaternion)
        scaled_x = rotation.x / scale
        scaled_y = rotation.y / scale
        scaled_z = rotation.z / scale
        scaled_w = rotation.w / scale
        norm_squared = scaled_x * scaled_x + scaled_y * scaled_y + scaled_z * scaled_z + scaled_w * scaled_w
        if not norm_squared > 0.0:
            return Err(CameraError.DegenerateQuaternion)
        inverse_norm = 1.0 / sqrt_scalar(norm_squared)
        x = scaled_x * inverse_norm
        y = scaled_y * inverse_norm
        z = scaled_z * inverse_norm
        w = scaled_w * inverse_norm
        right = Vec3(
            x=1.0 - 2.0 * (y * y + z * z),
            y=2.0 * (x * y + w * z),
            z=2.0 * (x * z - w * y),
        )
        up = Vec3(
            x=2.0 * (x * y - w * z),
            y=1.0 - 2.0 * (x * x + z * z),
            z=2.0 * (y * z + w * x),
        )
        forward = Vec3(
            x=2.0 * (x * z + w * y),
            y=2.0 * (y * z - w * x),
            z=1.0 - 2.0 * (x * x + y * y),
        )
        return Ok(Camera(eye=eye, forward=forward, right=right, up=up))

    pub fn explicit(eye: Vec3, authored_forward: Vec3, authored_right: Vec3, authored_up: Vec3) -> Result[Camera, CameraError]:
        forward_length = length3(authored_forward)
        if not forward_length > 0.0:
            return Err(CameraError.DegenerateForward)
        forward = Vec3(
            x=authored_forward.x / forward_length,
            y=authored_forward.y / forward_length,
            z=authored_forward.z / forward_length,
        )
        projection = dot3(authored_right, forward)
        right_seed = Vec3(
            x=authored_right.x - projection * forward.x,
            y=authored_right.y - projection * forward.y,
            z=authored_right.z - projection * forward.z,
        )
        right_length = length3(right_seed)
        if not right_length > 0.0:
            return Err(CameraError.InvalidBasis)
        right = Vec3(
            x=right_seed.x / right_length,
            y=right_seed.y / right_length,
            z=right_seed.z / right_length,
        )
        up = cross3(forward, right)
        authored_up_length = length3(authored_up)
        if not authored_up_length > 0.0:
            return Err(CameraError.DegenerateUp)
        authored_up_direction = Vec3(
            x=authored_up.x / authored_up_length,
            y=authored_up.y / authored_up_length,
            z=authored_up.z / authored_up_length,
        )
        if not dot3(up, authored_up_direction) > 0.0:
            return Err(CameraError.InvalidBasis)
        return Ok(Camera(eye=eye, forward=forward, right=right, up=up))

    fn __wrela_p5_finite(read self) -> bool:
        return (
            __wrela_pixels_p5_finite(self.eye.x)
            and __wrela_pixels_p5_finite(self.eye.y)
            and __wrela_pixels_p5_finite(self.eye.z)
            and __wrela_pixels_p5_finite(self.forward.x)
            and __wrela_pixels_p5_finite(self.forward.y)
            and __wrela_pixels_p5_finite(self.forward.z)
            and __wrela_pixels_p5_finite(self.right.x)
            and __wrela_pixels_p5_finite(self.right.y)
            and __wrela_pixels_p5_finite(self.right.z)
            and __wrela_pixels_p5_finite(self.up.x)
            and __wrela_pixels_p5_finite(self.up.y)
            and __wrela_pixels_p5_finite(self.up.z)
        )

pub enum LightKind:
    Disabled
    Point
    Directional
    Rectangle
    Disk

pub struct Light:
    kind: usize
    position: Vec3
    direction: Vec3
    axis_u: Vec3
    axis_v: Vec3
    radiance: Rgb

    pub fn zero() -> Light:
        zero = Vec3(x=0.0, y=0.0, z=0.0)
        black = Rgb(r=0.0, g=0.0, b=0.0)
        return Light(
            kind=0,
            position=zero,
            direction=zero,
            axis_u=zero,
            axis_v=zero,
            radiance=black,
        )

    pub fn point(position: Vec3, radiance: Rgb) -> Light:
        zero = Vec3(x=0.0, y=0.0, z=0.0)
        return Light(
            kind=1,
            position=position,
            direction=zero,
            axis_u=zero,
            axis_v=zero,
            radiance=radiance,
        )

    pub fn directional(direction: Vec3, radiance: Rgb) -> Light:
        zero = Vec3(x=0.0, y=0.0, z=0.0)
        return Light(
            kind=2,
            position=zero,
            direction=direction,
            axis_u=zero,
            axis_v=zero,
            radiance=radiance,
        )

    pub fn rectangle(center: Vec3, axis_u: Vec3, axis_v: Vec3, radiance: Rgb) -> Light:
        zero = Vec3(x=0.0, y=0.0, z=0.0)
        return Light(
            kind=3,
            position=center,
            direction=zero,
            axis_u=axis_u,
            axis_v=axis_v,
            radiance=radiance,
        )

    pub fn disk(center: Vec3, axis_u: Vec3, axis_v: Vec3, radiance: Rgb) -> Light:
        zero = Vec3(x=0.0, y=0.0, z=0.0)
        return Light(
            kind=4,
            position=center,
            direction=zero,
            axis_u=axis_u,
            axis_v=axis_v,
            radiance=radiance,
        )

    pub fn __wrela_p5_matches_kind(read self, expected: usize) -> bool:
        return self.kind == expected

    pub fn __wrela_p5_finite(read self) -> bool:
        return (
            __wrela_pixels_p5_finite(self.position.x)
            and __wrela_pixels_p5_finite(self.position.y)
            and __wrela_pixels_p5_finite(self.position.z)
            and __wrela_pixels_p5_finite(self.direction.x)
            and __wrela_pixels_p5_finite(self.direction.y)
            and __wrela_pixels_p5_finite(self.direction.z)
            and __wrela_pixels_p5_finite(self.axis_u.x)
            and __wrela_pixels_p5_finite(self.axis_u.y)
            and __wrela_pixels_p5_finite(self.axis_u.z)
            and __wrela_pixels_p5_finite(self.axis_v.x)
            and __wrela_pixels_p5_finite(self.axis_v.y)
            and __wrela_pixels_p5_finite(self.axis_v.z)
            and __wrela_pixels_p5_finite(self.radiance.r)
            and __wrela_pixels_p5_finite(self.radiance.g)
            and __wrela_pixels_p5_finite(self.radiance.b)
        )

pub struct LightFrame:
    lights: [Light; 8]

    pub fn empty() -> LightFrame:
        return LightFrame(lights=[
            Light.zero(),
            Light.zero(),
            Light.zero(),
            Light.zero(),
            Light.zero(),
            Light.zero(),
            Light.zero(),
            Light.zero(),
        ])

    pub fn fixed(lights: [Light; 8]) -> LightFrame:
        return LightFrame(lights=lights)

pub struct ScalarRange:
    pub min: f32
    pub max: f32

pub struct RgbRange:
    pub min: Rgb
    pub max: Rgb

    pub fn black_to_hdr_white() -> RgbRange:
        return RgbRange(
            min=Rgb(r=0.0, g=0.0, b=0.0),
            max=Rgb(r=16.0, g=16.0, b=16.0),
        )

pub struct CameraBounds:
    # Version 1 seals a world-relative pose box. The renderer declaration
    # centers eye x/y on the world AABB, places eye z behind its minimum-z
    # face, bounds basis-component displacement from the canonical
    # forward-facing pose, and uses a 90-degree vertical field of view.
    max_motion: f32

    # max_motion is the absolute eye/basis component radius about the
    # canonical pose and the maximum accepted inter-frame component change.
    # A camera authored with look_at/quaternion/explicit must fit this box;
    # turns up to a component delta of 1 require bounded(1.0).
    pub fn bounded(max_motion: f32) -> CameraBounds:
        return CameraBounds(max_motion=max_motion)

    pub fn gameplay_default() -> CameraBounds:
        return CameraBounds(max_motion=0.25)

pub struct LightConfig:
    capacity: u32
    kinds: [LightKind; 8]

    pub fn fixed(capacity: u32) -> LightConfig:
        return LightConfig(
            capacity=capacity,
            kinds=[
                LightKind.Point,
                LightKind.Point,
                LightKind.Point,
                LightKind.Point,
                LightKind.Point,
                LightKind.Point,
                LightKind.Point,
                LightKind.Point,
            ],
        )

    pub fn declared(capacity: u32, kinds: [LightKind; 8]) -> LightConfig:
        return LightConfig(capacity=capacity, kinds=kinds)

    pub fn gameplay_default() -> LightConfig:
        return LightConfig.fixed(capacity=8)

pub struct AoConfig:
    enabled: bool

    pub fn fixed(enabled: bool) -> AoConfig:
        return AoConfig(enabled=enabled)

    pub fn deterministic_v1() -> AoConfig:
        return AoConfig(enabled=true)

pub struct ProbeConfig:
    enabled: bool
    initialization_worst_case_ms: u32

    pub fn fixed(enabled: bool) -> ProbeConfig:
        if enabled:
            return ProbeConfig(enabled=true, initialization_worst_case_ms=250)
        return ProbeConfig(enabled=false, initialization_worst_case_ms=0)

    pub fn disabled() -> ProbeConfig:
        return ProbeConfig(enabled=false, initialization_worst_case_ms=0)

pub enum RenderProfile:
    AaaByteExact

pub enum ToneCurve:
    Linear
    FilmicV1

pub enum RenderError:
    ParameterOutOfRange(RenderPath)
    NonFiniteInput(RenderPath)
    FrameContractMismatch(RenderPath)
    RootIsolationExhausted(TileId)
    EventIsolationExhausted(TileId)
    CertificateExhausted(TileId)
    CapacityExceeded(RenderCapacity)
    FixedPointRangeExceeded(TileId)
    Display(DisplayError)
    InternalInvariant(RenderInvariant)

pub struct SurfaceContext[M]:
    pub material: M
    pub position: Vec3
    pub normal: Vec3

pub enum TextureFilter:
    Nearest
    Bilinear

pub struct MaterialSample:
    color: Rgb
    roughness: f32

    pub fn standard(color: Rgb, roughness: f32) -> MaterialSample:
        max_finite: f32 = 340282346638528859811704183484516925440.0
        safe_r = color.r
        safe_g = color.g
        safe_b = color.b
        if safe_r != safe_r:
            safe_r = 0.0
        if safe_g != safe_g:
            safe_g = 0.0
        if safe_b != safe_b:
            safe_b = 0.0
        if safe_r > max_finite:
            safe_r = max_finite
        if safe_r < -max_finite:
            safe_r = -max_finite
        if safe_g > max_finite:
            safe_g = max_finite
        if safe_g < -max_finite:
            safe_g = -max_finite
        if safe_b > max_finite:
            safe_b = max_finite
        if safe_b < -max_finite:
            safe_b = -max_finite
        clamped = roughness
        if clamped != clamped:
            clamped = 0.0
        if clamped < 0.0:
            clamped = 0.0
        if clamped > 1.0:
            clamped = 1.0
        safe_color = Rgb(r=safe_r, g=safe_g, b=safe_b)
        return MaterialSample(color=safe_color, roughness=clamped)

    pub fn clay(color: Rgb, roughness: f32) -> MaterialSample:
        return MaterialSample.standard(color=color, roughness=roughness)

    pub fn porcelain(color: Rgb, roughness: f32) -> MaterialSample:
        return MaterialSample.standard(color=color, roughness=roughness)

    pub fn textured(
        color: Rgb,
        roughness: f32,
        texture_id: u32,
        width: u32,
        height: u32,
        filter: TextureFilter,
    ) -> MaterialSample:
        # The Pixels compiler intercepts this closed constructor and records
        # the immutable texture descriptor. P9 supplies filtered sampling.
        return MaterialSample.standard(color=color, roughness=roughness)

    pub fn sample_color(read self) -> Rgb:
        return self.color

    pub fn sample_roughness(read self) -> f32:
        return self.roughness

pub struct RenderFrame[P]:
    pub params: P
    pub camera: Camera
    pub lights: LightFrame
    pub exposure: f32
    pub environment: Rgb
    pub frame_index: u64

pub struct RenderedFrame[P]:
    pub params: P
    pub frame_index: u64
    pub displayed_digest: [u8; 32]
    pub rebuilt_tiles: u32
    pub reused_tiles: u32

@actor
pub struct RendererWorker:
    renderer_index: u32
    frameprog_base: usize
    workspace_base: usize
    workspace_bytes: usize
    tiles_start: u32
    tiles_end: u32

    init(
        mut self,
        renderer_index: u32,
        frameprog_base: usize,
        workspace_base: usize,
        workspace_bytes: usize,
        tiles_start: u32,
        tiles_end: u32,
    ):
        self.renderer_index = renderer_index
        self.frameprog_base = frameprog_base
        self.workspace_base = workspace_base
        self.workspace_bytes = workspace_bytes
        self.tiles_start = tiles_start
        self.tiles_end = tiles_end

    pub async fn run_job(mut self, job: u64) -> u64:
        return job

pub struct RendererWorkers:
    worker_0: Actor[RendererWorker]
    worker_1: Actor[RendererWorker]
    worker_2: Actor[RendererWorker]
    worker_3: Actor[RendererWorker]
    worker_4: Actor[RendererWorker]
    worker_5: Actor[RendererWorker]
    worker_6: Actor[RendererWorker]
    worker_7: Actor[RendererWorker]
    worker_8: Actor[RendererWorker]
    worker_9: Actor[RendererWorker]
    worker_10: Actor[RendererWorker]
    worker_11: Actor[RendererWorker]
    worker_12: Actor[RendererWorker]
    worker_13: Actor[RendererWorker]
    worker_14: Actor[RendererWorker]
    worker_15: Actor[RendererWorker]
    worker_16: Actor[RendererWorker]
    worker_17: Actor[RendererWorker]
    worker_18: Actor[RendererWorker]
    worker_19: Actor[RendererWorker]
    worker_20: Actor[RendererWorker]
    worker_21: Actor[RendererWorker]
    worker_22: Actor[RendererWorker]
    worker_23: Actor[RendererWorker]
    worker_24: Actor[RendererWorker]
    worker_25: Actor[RendererWorker]
    worker_26: Actor[RendererWorker]
    worker_27: Actor[RendererWorker]
    worker_28: Actor[RendererWorker]
    worker_29: Actor[RendererWorker]
    worker_30: Actor[RendererWorker]
    worker_31: Actor[RendererWorker]

pub struct RendererFrameBounds:
    exposure_min: f32
    exposure_max: f32
    environment_min_r: f32
    environment_min_g: f32
    environment_min_b: f32
    environment_max_r: f32
    environment_max_g: f32
    environment_max_b: f32
    camera_eye_x_min: f32
    camera_eye_x_max: f32
    camera_eye_y_min: f32
    camera_eye_y_max: f32
    camera_eye_z_min: f32
    camera_eye_z_max: f32
    camera_forward_x_min: f32
    camera_forward_x_max: f32
    camera_forward_y_min: f32
    camera_forward_y_max: f32
    camera_forward_z_min: f32
    camera_forward_z_max: f32
    camera_right_x_min: f32
    camera_right_x_max: f32
    camera_right_y_min: f32
    camera_right_y_max: f32
    camera_right_z_min: f32
    camera_right_z_max: f32
    camera_up_x_min: f32
    camera_up_x_max: f32
    camera_up_y_min: f32
    camera_up_y_max: f32
    camera_up_z_min: f32
    camera_up_z_max: f32
    light_capacity: usize
    light_kind_0: usize
    light_kind_1: usize
    light_kind_2: usize
    light_kind_3: usize
    light_kind_4: usize
    light_kind_5: usize
    light_kind_6: usize
    light_kind_7: usize

    pub fn __wrela_p5_accepts_camera(read self, read camera: Camera) -> bool:
        return (
            camera.eye.x >= self.camera_eye_x_min
            and camera.eye.x <= self.camera_eye_x_max
            and camera.eye.y >= self.camera_eye_y_min
            and camera.eye.y <= self.camera_eye_y_max
            and camera.eye.z >= self.camera_eye_z_min
            and camera.eye.z <= self.camera_eye_z_max
            and camera.forward.x >= self.camera_forward_x_min
            and camera.forward.x <= self.camera_forward_x_max
            and camera.forward.y >= self.camera_forward_y_min
            and camera.forward.y <= self.camera_forward_y_max
            and camera.forward.z >= self.camera_forward_z_min
            and camera.forward.z <= self.camera_forward_z_max
            and camera.right.x >= self.camera_right_x_min
            and camera.right.x <= self.camera_right_x_max
            and camera.right.y >= self.camera_right_y_min
            and camera.right.y <= self.camera_right_y_max
            and camera.right.z >= self.camera_right_z_min
            and camera.right.z <= self.camera_right_z_max
            and camera.up.x >= self.camera_up_x_min
            and camera.up.x <= self.camera_up_x_max
            and camera.up.y >= self.camera_up_y_min
            and camera.up.y <= self.camera_up_y_max
            and camera.up.z >= self.camera_up_z_min
            and camera.up.z <= self.camera_up_z_max
        )

@actor
pub struct Renderer[P]:
    workers: RendererWorkers
    worker_count: u32
    display: usize
    renderer_index: u32
    frameprog_base: usize
    state_base: usize
    state_bytes: usize
    bounds: RendererFrameBounds

    init(
        mut self,
        workers: RendererWorkers,
        worker_count: u32,
        display: usize,
        renderer_index: u32,
        frameprog_base: usize,
        state_base: usize,
        state_bytes: usize,
        bounds: RendererFrameBounds,
    ):
        self.workers = workers
        self.worker_count = worker_count
        self.display = display
        self.renderer_index = renderer_index
        self.frameprog_base = frameprog_base
        self.state_base = state_base
        self.state_bytes = state_bytes
        self.bounds = bounds

    fn __validate_fixed_frame(read self, read frame: RenderFrame[P])
        -> Result[unit, RenderError]:
        if not __wrela_pixels_p5_finite(frame.exposure):
            return Err(RenderError.NonFiniteInput(RenderPath(component=2)))
        if frame.exposure < self.bounds.exposure_min or frame.exposure > self.bounds.exposure_max:
            return Err(RenderError.ParameterOutOfRange(RenderPath(component=2)))
        if (
            not __wrela_pixels_p5_finite(frame.environment.r)
            or not __wrela_pixels_p5_finite(frame.environment.g)
            or not __wrela_pixels_p5_finite(frame.environment.b)
        ):
            return Err(RenderError.NonFiniteInput(RenderPath(component=3)))
        if (
            frame.environment.r < self.bounds.environment_min_r
            or frame.environment.r > self.bounds.environment_max_r
            or frame.environment.g < self.bounds.environment_min_g
            or frame.environment.g > self.bounds.environment_max_g
            or frame.environment.b < self.bounds.environment_min_b
            or frame.environment.b > self.bounds.environment_max_b
        ):
            return Err(RenderError.ParameterOutOfRange(RenderPath(component=3)))
        if not frame.camera.__wrela_p5_finite():
            return Err(RenderError.NonFiniteInput(RenderPath(component=4)))
        if not self.bounds.__wrela_p5_accepts_camera(frame.camera):
            return Err(RenderError.FrameContractMismatch(RenderPath(component=4)))
        index: usize = 0
        @budget(bound=8)
        while index < 8:
            light = frame.lights.lights[index]
            if not light.__wrela_p5_finite():
                return Err(RenderError.NonFiniteInput(RenderPath(component=5)))
            expected_kind: usize = 0
            if index == 0:
                expected_kind = self.bounds.light_kind_0
            if index == 1:
                expected_kind = self.bounds.light_kind_1
            if index == 2:
                expected_kind = self.bounds.light_kind_2
            if index == 3:
                expected_kind = self.bounds.light_kind_3
            if index == 4:
                expected_kind = self.bounds.light_kind_4
            if index == 5:
                expected_kind = self.bounds.light_kind_5
            if index == 6:
                expected_kind = self.bounds.light_kind_6
            if index == 7:
                expected_kind = self.bounds.light_kind_7
            if index >= self.bounds.light_capacity:
                expected_kind = 0
            if not light.__wrela_p5_matches_kind(expected_kind):
                return Err(RenderError.FrameContractMismatch(RenderPath(component=5)))
            index = index + 1
        return Ok(unit)

    fn __validate_and_unavailable(read self, take frame: RenderFrame[P])
        -> Result[RenderedFrame[P], RenderError]:
        fixed = self.__validate_fixed_frame(frame)
        match fixed:
            case .Err(error):
                return Err(take error)
            case .Ok(_):
                pass
        return self.__unavailable(take frame)

    fn __unavailable(read self, take frame: RenderFrame[P])
        -> Result[RenderedFrame[P], RenderError]:
        return Err(RenderError.FrameContractMismatch(RenderPath.renderer_unavailable()))

    async fn __bootstrap_worker_path_0(mut self) -> Result[u64, CallError[never]]:
        return await self.workers.worker_0.run_job(job=0)

