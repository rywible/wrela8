                    # distinct real roots of this member's ray polynomial for
                    # every ray in the cell. The composite is a pure union
                    # (`projected_union_mode`), and union occupancy is
                    # monotone in its members, so one member being hit
                    # throughout the cell fills the cell whatever the other
                    # members do — this conclusion is about *this* member and
                    # is not weakened by another member's boundary crossing
                    # here, which is what separates it from the sample path.
                    any_inside = true
                elif not fixed_negative:
                    all_outside = false
                    ambiguous_count = ambiguous_count + 1
                    magnitude = (
                        __wrela_pixels_p7_abs(f00)
                        + __wrela_pixels_p7_abs(a_value)
                        + __wrela_pixels_p7_abs(b_value)
                        + residual
