                            # curve, not just the largest by magnitude: for a
                            # torus the two sides have to be resolved
                            # independently (see the accumulation below).
                            highest = f00
                            lowest = f00
                            line_positive_u = cu0
                            line_positive_v = cv0
                            line_negative_u = cu0
                            line_negative_v = cv0
                            if f10 > highest:
                                highest = f10
                                line_positive_u = cu1
                                line_positive_v = cv0
                            if f01 > highest:
                                highest = f01
                                line_positive_u = cu0
                                line_positive_v = cv1
                            if f11 > highest:
                                highest = f11
                                line_positive_u = cu1
                                line_positive_v = cv1
                            if f10 < lowest:
                                lowest = f10
                                line_negative_u = cu1
                                line_negative_v = cv0
                            if f01 < lowest:
                                lowest = f01
                                line_negative_u = cu0
                                line_negative_v = cv1
                            if f11 < lowest:
                                lowest = f11
                                line_negative_u = cu1
                                line_negative_v = cv1
