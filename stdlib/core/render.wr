pub fn __wrela_pixels_p5_finite(value: f32) -> bool:
    max_finite: f32 = 340282346638528859811704183484516925440.0
    return value == value and value <= max_finite and value >= -max_finite

pub fn __wrela_pixels_p7_program_validate(renderer: usize) -> bool:
    return __wrela_pixels_program_validate(renderer)

pub fn __wrela_pixels_p7_program_digest_byte(renderer: usize, byte: usize) -> u8:
    return __wrela_pixels_program_digest_byte(renderer, byte)

