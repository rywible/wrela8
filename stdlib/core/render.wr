                    p10 = __wrela_pixels_p7_event_polynomial(
                        renderer, event_id, cu1, cv0,
                        snapshot.params, snapshot.camera,
                    )
                    p01 = __wrela_pixels_p7_event_polynomial(
                        renderer, event_id, cu0, cv1,
                        snapshot.params, snapshot.camera,
                    )
                    p11 = __wrela_pixels_p7_event_polynomial(
                        renderer, event_id, cu1, cv1,
                        snapshot.params, snapshot.camera,
