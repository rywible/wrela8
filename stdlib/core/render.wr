        root_cu1 = cell_u[0] + cell_ru[0]
        root_cv0 = cell_v[0] - cell_rv[0]
        root_cv1 = cell_v[0] + cell_rv[0]
        root_p00 = __wrela_pixels_p7_standard_torus_value(
            standard_torus_coefficients, root_cu0, root_cv0,
