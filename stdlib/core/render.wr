                    p10: [f32; 11] = [0.0; 11]
                    p01: [f32; 11] = [0.0; 11]
                    p11: [f32; 11] = [0.0; 11]
                    p00 = __wrela_pixels_p7_event_polynomial(
                        renderer, event_id, cu0, cv0,
                        snapshot.params, snapshot.camera,
