    cell_u: [f32; 40] = [0.0; 40]
    cell_v: [f32; 40] = [0.0; 40]
    cell_ru: [f32; 40] = [0.0; 40]
    cell_rv: [f32; 40] = [0.0; 40]
    cell_depth: [u8; 40] = [0; 40]
    # 0 = unknown, 1 = the D > 0 side misses, 2 = the D > 0 side hits.
    # A box-wide P/Q proof is hereditary, so children reuse their parent's
    # classification without repeating the interval invariant evaluation.
