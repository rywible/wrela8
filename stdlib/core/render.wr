fn __wrela_pixels_p9_light_rate_valid(
    current: f32,
    previous: f32,
    max_delta: f32,
    frame_steps: u64,
) -> bool:
    if max_delta < 0.0 or frame_steps > 65535:
        return false
    delta = current - previous
    if delta < 0.0:
        delta = 0.0 - delta
    return delta <= max_delta * frame_steps.to[f32]()

fn __wrela_pixels_p9_point_radius_valid(radius: f32, maximum: f32) -> bool:
    # 2^-12 keeps radius^2 at or above 2^-24, so the sealed attenuation clamp
    # cannot underflow to the singular zero denominator.
    return radius >= 0.000244140625 and radius <= maximum

@test
fn p9_light_rate_boundary_is_closed_and_excess_fails():
    assert __wrela_pixels_p9_light_rate_valid(1.125, 1.0, 0.125, 1), "declared light rate includes its exact boundary"
    assert not __wrela_pixels_p9_light_rate_valid(1.1251, 1.0, 0.125, 1), "light motion beyond the sealed per-frame rate fails"
    assert __wrela_pixels_p9_point_radius_valid(0.000244140625, 1.0), "point radius includes the sealed nonsingular boundary"
    assert not __wrela_pixels_p9_point_radius_valid(0.0001220703125, 1.0), "point radius rejects a clamp whose square can approach underflow"

