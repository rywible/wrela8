module render_probe

from core.__image_pixels import __wrela_pixels_f32_to_bits, __wrela_pixels_p7_event_polynomial, __wrela_pixels_p7_feature_polynomial, __wrela_pixels_p7_feature_valid_filter, __wrela_pixels_p7_frame_snapshot_camera, __wrela_pixels_p7_frame_snapshot_params, __wrela_pixels_p7_frame_snapshot_store, __wrela_pixels_p7_numeric_config, __wrela_pixels_p7_telemetry_counter, __wrela_pixels_p8_visible_word, __wrela_pixels_program_operand, __wrela_pixels_program_record, __wrela_pixels_tile_event, __wrela_pixels_tile_event_count
from core.render import FrameInputSnapshot, RenderError
from core.render_arrangement import __wrela_pixels_p7_event_polynomial_at_q, __wrela_pixels_p7_pixel_visibility_from_candidates, __wrela_pixels_p7_silhouette_coverage
from core.render_certify import __wrela_pixels_p7_certify_pixel_row
from core.render_isolation import __wrela_pixels_p7_collect_roots_box, __wrela_pixels_p7_load_root, __wrela_pixels_p7_row_candidates, __wrela_pixels_p7_select_visibility

pub fn __wrela_pixels_p7_debug_probe_cell(
    renderer: usize,
    tile: u32,
    x: u32,
    y: u32,
    read filter: [f32; 4],
    index: u32,
    read params: [f32; 16],
    read camera: [f32; 12],
) -> [i64; 12]:
    if not __wrela_pixels_p7_frame_snapshot_store(
        renderer,
        params,
        __wrela_pixels_p7_numeric_config(renderer)[6].to[u16](),
        camera,
        [0; 8],
        [0.0; 120],
        [0.0; 4],
        0,
    ):
        return [0; 12]
    snapshot = FrameInputSnapshot.from_packed(
        params,
        __wrela_pixels_p7_numeric_config(renderer)[6].to[u16](),
        camera,
    )
    candidates = __wrela_pixels_p7_row_candidates(renderer, tile, y, snapshot)
    roots = __wrela_pixels_p7_collect_roots_box(
        renderer,
        0,
        x,
        x + 1,
        y,
        filter,
        candidates,
        snapshot,
    )
    if index < roots.count:
        record = __wrela_pixels_p7_load_root(roots, index)
        crossing_flag: i64 = 0
        if record.crossing:
            crossing_flag = 1
        record_ok: i64 = 0
        if record.ok:
            record_ok = 1
        return [
            2,
            record.lo.to[i64](),
            record.hi.to[i64](),
            record.object.to[i64](),
            record.identity.to[i64](),
            record.feature.to[i64](),
            crossing_flag,
            record.method.to[i64](),
            record.margin.to[i64](),
            record_ok,
            0,
            0,
        ]
    sample = __wrela_pixels_p7_select_visibility(renderer, roots)
    sample_flags: i64 = 0
    if sample.ok:
        sample_flags = sample_flags | 1
    if sample.hit:
        sample_flags = sample_flags | 2
    if sample.event:
        sample_flags = sample_flags | 4
    roots_ok: i64 = 0
    if roots.ok:
        roots_ok = 1
    return [
        1,
        roots.count.to[i64](),
        roots_ok | (roots.error.to[i64]() << 8),
        sample_flags,
        sample.error.to[i64](),
        sample.q_lo.to[i64](),
        sample.q_hi.to[i64](),
        sample.identity.to[i64](),
        sample.object.to[i64](),
        sample.coverage.to[i64](),
        sample.proof_margin.to[i64](),
        (candidates.debug_count().to[i64]() << 8) | roots.count.to[i64](),
    ]

pub fn __wrela_pixels_p7_debug_probe_coverage(
    renderer: usize,
    tile: u32,
    x: u32,
    y: u32,
    read params: [f32; 16],
    read camera: [f32; 12],
) -> [i64; 12]:
    if not __wrela_pixels_p7_frame_snapshot_store(
        renderer,
        params,
        __wrela_pixels_p7_numeric_config(renderer)[6].to[u16](),
        camera,
        [0; 8],
        [0.0; 120],
        [0.0; 4],
        0,
    ):
        return [0; 12]
    snapshot = FrameInputSnapshot.from_packed(
        params,
        __wrela_pixels_p7_numeric_config(renderer)[6].to[u16](),
        camera,
    )
    candidates = __wrela_pixels_p7_row_candidates(renderer, tile, y, snapshot)
    config = __wrela_pixels_p7_numeric_config(renderer)
    width = config[1].to[f32]()
    height = config[2].to[f32]()
    point_filter: [f32; 4] = [
        (((x.to[f32]() + 0.5) / width) * 2.0 - 1.0) * width / height,
        1.0 - ((y.to[f32]() + 0.5) / height) * 2.0,
        0.0,
        0.0,
    ]
    side = __wrela_pixels_p7_pixel_visibility_from_candidates(
        renderer=renderer,
        worker=0,
        tile=tile,
        span=x | ((x + 1) << 16),
        y=y,
        filter=point_filter,
        candidates=candidates,
        snapshot=snapshot,
    )
    curve = __wrela_pixels_p7_silhouette_coverage(
        renderer, 0, tile, x, y, candidates, side, snapshot,
    )
    count = __wrela_pixels_tile_event_count(renderer, tile)
    event_id: i64 = -1
    event_kind: i64 = -1
    event_x0: i64 = -1
    event_x1: i64 = -1
    event_version: i64 = -1
    if count > 0 and count != 4294967295:
        event = __wrela_pixels_tile_event(renderer, tile, 0)
        if event[0] == 1:
            event_id = event[1].to[i64]()
            record = __wrela_pixels_program_record(renderer, 7, event[1].to[u32]())
            event_version = record[2].to[i64]()
            kind = __wrela_pixels_program_operand(renderer, 7, event[1].to[u32](), 0)
            x0 = __wrela_pixels_program_operand(renderer, 7, event[1].to[u32](), 3)
            x1 = __wrela_pixels_program_operand(renderer, 7, event[1].to[u32](), 4)
            if kind[0] == 1:
                event_kind = kind[1].to[i64]()
            if x0[0] == 1:
                event_x0 = x0[1].to[i64]()
            if x1[0] == 1:
                event_x1 = x1[1].to[i64]()
    side_flags: i64 = 0
    if side.ok:
        side_flags = side_flags | 1
    if side.hit:
        side_flags = side_flags | 2
    if side.event:
        side_flags = side_flags | 4
    # Histogram of event kinds covering pixel (x, y): kind k (0..15) counts
    # in nibble k, saturating at 15.
    kind_histogram: i64 = 0
    if count > 0 and count != 4294967295 and count <= 256:
        ordinal: u32 = 0
        @budget(bound=256)
        while ordinal < count:
            event = __wrela_pixels_tile_event(renderer, tile, ordinal)
            if event[0] == 1 and event[1] <= 4294967295:
                identifier = event[1].to[u32]()
                kind = __wrela_pixels_program_operand(renderer, 7, identifier, 0)
                x0 = __wrela_pixels_program_operand(renderer, 7, identifier, 3)
                x1 = __wrela_pixels_program_operand(renderer, 7, identifier, 4)
                y0 = __wrela_pixels_program_operand(renderer, 7, identifier, 5)
                y1 = __wrela_pixels_program_operand(renderer, 7, identifier, 6)
                if (
                    kind[0] == 1 and kind[1] < 16
                    and x0[0] == 1 and x1[0] == 1 and y0[0] == 1 and y1[0] == 1
                    and x.to[u64]() >= x0[1] and x.to[u64]() < x1[1]
                    and y.to[u64]() >= y0[1] and y.to[u64]() < y1[1]
                ):
                    shift = (kind[1] * 4).to[u32]()
                    slot = (kind_histogram >> shift.to[i64]()) & 15
                    if slot < 15:
                        kind_histogram = kind_histogram + (1.to[i64]() << shift.to[i64]())
            ordinal = ordinal + 1
    return [
        1,
        curve[0],
        curve[1],
        curve[2],
        kind_histogram,
        count.to[i64](),
        event_id,
        event_kind,
        event_x0,
        event_x1,
        event_version,
        side_flags | (side.error.to[i64]() << 8),
    ]

pub fn __wrela_pixels_p7_debug_probe_silhouette(
    renderer: usize,
    tile: u32,
    x: u32,
    y: u32,
    which: u32,
    read params: [f32; 16],
    read camera: [f32; 12],
) -> [i64; 12]:
    config = __wrela_pixels_p7_numeric_config(renderer)
    count = __wrela_pixels_tile_event_count(renderer, tile)
    if config[0] != 1 or count == 4294967295 or count > 256:
        return [0; 12]
    width = config[1].to[f32]()
    height = config[2].to[f32]()
    aspect = width / height
    u0 = ((x.to[f32]() / width) * 2.0 - 1.0) * aspect
    u1 = (((x + 1).to[f32]() / width) * 2.0 - 1.0) * aspect
    v0 = 1.0 - (y.to[f32]() / height) * 2.0
    v1 = 1.0 - ((y + 1).to[f32]() / height) * 2.0
    matched: u32 = 0
    ordinal: u32 = 0
    @budget(bound=256)
    while ordinal < count:
        event = __wrela_pixels_tile_event(renderer, tile, ordinal)
        ordinal = ordinal + 1
        if event[0] != 1 or event[1] > 4294967295:
            continue
        event_id = event[1].to[u32]()
        record = __wrela_pixels_program_record(renderer, 7, event_id)
        kind = __wrela_pixels_program_operand(renderer, 7, event_id, 0)
        x0 = __wrela_pixels_program_operand(renderer, 7, event_id, 3)
        x1 = __wrela_pixels_program_operand(renderer, 7, event_id, 4)
        y0 = __wrela_pixels_program_operand(renderer, 7, event_id, 5)
        y1 = __wrela_pixels_program_operand(renderer, 7, event_id, 6)
        if record[0] != 1 or kind[0] != 1 or kind[1] != 3:
            continue
        if x0[0] != 1 or x1[0] != 1 or y0[0] != 1 or y1[0] != 1:
            continue
        if x.to[u64]() < x0[1] or x.to[u64]() >= x1[1] or y.to[u64]() < y0[1] or y.to[u64]() >= y1[1]:
            continue
        if matched != which:
            matched = matched + 1
            continue
        p00 = __wrela_pixels_p7_event_polynomial(
            renderer, event_id, u0, v0, params, camera,
        )
        p10 = __wrela_pixels_p7_event_polynomial(
            renderer, event_id, u1, v0, params, camera,
        )
        p01 = __wrela_pixels_p7_event_polynomial(
            renderer, event_id, u0, v1, params, camera,
        )
        f00 = __wrela_pixels_p7_event_polynomial_at_q(p00, 1.0)
        f10 = __wrela_pixels_p7_event_polynomial_at_q(p10, 1.0)
        f01 = __wrela_pixels_p7_event_polynomial_at_q(p01, 1.0)
        return [
            1,
            event_id.to[i64](),
            record[2].to[i64](),
            __wrela_pixels_f32_to_bits(p00[0]).to[i64](),
            __wrela_pixels_f32_to_bits(p00[1]).to[i64](),
            __wrela_pixels_f32_to_bits(f00[1]).to[i64](),
            __wrela_pixels_f32_to_bits(f10[1]).to[i64](),
            __wrela_pixels_f32_to_bits(f01[1]).to[i64](),
            __wrela_pixels_f32_to_bits(f00[0]).to[i64](),
            x0[1].to[i64](),
            x1[1].to[i64](),
            kind[1].to[i64](),
        ]
    return [0; 12]

pub fn __wrela_pixels_p7_debug_probe_clip(
    renderer: usize,
    x: u32,
    y: u32,
    feature: u32,
    q: f32,
    read params: [f32; 16],
    read camera: [f32; 12],
) -> [i64; 12]:
    # A clip boundary is the level set of the feature's ray polynomial at the
    # sealed clip q. This reports that level set at the pixel's corners so the
    # crossing can be located without running the sweep.
    config = __wrela_pixels_p7_numeric_config(renderer)
    if config[0] != 1:
        return [0; 12]
    width = config[1].to[f32]()
    height = config[2].to[f32]()
    aspect = width / height
    u0 = ((x.to[f32]() / width) * 2.0 - 1.0) * aspect
    u1 = (((x + 1).to[f32]() / width) * 2.0 - 1.0) * aspect
    v0 = 1.0 - (y.to[f32]() / height) * 2.0
    v1 = 1.0 - ((y + 1).to[f32]() / height) * 2.0
    p00 = __wrela_pixels_p7_feature_polynomial(renderer, feature, u0, v0, params, camera)
    p10 = __wrela_pixels_p7_feature_polynomial(renderer, feature, u1, v0, params, camera)
    p01 = __wrela_pixels_p7_feature_polynomial(renderer, feature, u0, v1, params, camera)
    f00 = __wrela_pixels_p7_event_polynomial_at_q(p00, q)
    f10 = __wrela_pixels_p7_event_polynomial_at_q(p10, q)
    f01 = __wrela_pixels_p7_event_polynomial_at_q(p01, q)
    return [
        1,
        __wrela_pixels_f32_to_bits(p00[0]).to[i64](),
        __wrela_pixels_f32_to_bits(p00[1]).to[i64](),
        __wrela_pixels_f32_to_bits(f00[1]).to[i64](),
        __wrela_pixels_f32_to_bits(f10[1]).to[i64](),
        __wrela_pixels_f32_to_bits(f01[1]).to[i64](),
        __wrela_pixels_f32_to_bits(f00[0]).to[i64](),
        __wrela_pixels_f32_to_bits(p00[2]).to[i64](),
        __wrela_pixels_f32_to_bits(p00[3]).to[i64](),
        0,
        0,
        0,
    ]

pub fn __wrela_pixels_p7_debug_probe_row(
    renderer: usize,
    tile: u32,
    x: u32,
    y: u32,
    read params: [f32; 16],
    read camera: [f32; 12],
) -> [i64; 8]:
    if not __wrela_pixels_p7_frame_snapshot_store(
        renderer,
        params,
        __wrela_pixels_p7_numeric_config(renderer)[6].to[u16](),
        camera,
        [0; 8],
        [0.0; 120],
        [0.0; 4],
        0,
    ):
        return [0; 8]
    snapshot = FrameInputSnapshot.from_packed(
        params,
        __wrela_pixels_p7_numeric_config(renderer)[6].to[u16](),
        camera,
    )
    candidates = __wrela_pixels_p7_row_candidates(renderer, tile, y, snapshot)
    row = __wrela_pixels_p7_certify_pixel_row(
        renderer,
        0,
        tile,
        y,
        x,
        x + 1,
        candidates,
        snapshot,
    )
    row_ok: i64 = 0
    if row.ok:
        row_ok = 1
    sample = row.samples[0]
    sample_flags: i64 = 0
    if sample.ok:
        sample_flags = sample_flags | 1
    if sample.hit:
        sample_flags = sample_flags | 2
    if sample.event:
        sample_flags = sample_flags | 4
    if not row.ok:
        return [
            1,
            row_ok,
            row.error.to[i64](),
            row.model[0].to[i64](),
            row.model[1].to[i64](),
            row.model[3].to[i64](),
            row.model[4].to[i64](),
            row.model[5].to[i64](),
        ]
    return [
        1,
        row_ok,
        row.error.to[i64](),
        row.count.to[i64](),
        sample_flags,
        sample.coverage.to[i64](),
        sample.identity.to[i64](),
        sample.proof_margin.to[i64](),
    ]

pub fn __wrela_pixels_p7_debug_probe_validity(
    renderer: usize,
    feature: u32,
    read filter: [f32; 4],
    read q: [i32; 2],
    read params: [f32; 16],
    read camera: [f32; 12],
) -> [i64; 2]:
    if not __wrela_pixels_p7_frame_snapshot_store(
        renderer,
        params,
        __wrela_pixels_p7_numeric_config(renderer)[6].to[u16](),
        camera,
        [0; 8],
        [0.0; 120],
        [0.0; 4],
        0,
    ):
        return [-1, -1]
    return __wrela_pixels_p7_feature_valid_filter(
        renderer,
        feature,
        filter,
        q,
        __wrela_pixels_p7_numeric_config(renderer)[3].to[i32](),
        params,
        camera,
    )

# Instrumented-run frame dump for host conformance. Word 0 is the payload
# length; words 1..6 pack the validated snapshot camera and 7..14 the packed
# parameters (so the host oracle scores against the exact frame inputs, never
# a guessed camera); word 15 packs framebuffer/telemetry word counts, followed
# by the complete debug framebuffer and CertificateTelemetry section. The VMM
# captures fixed-q evidence directly from instrumented renderer state. Readable only
# when certificate telemetry is enabled, so golden transcripts never change;
# the fixture traces the words through its own runtime binding because
# core.render cannot import core.runtime.
pub fn __wrela_pixels_p7_debug_frame_dump_word(renderer: usize, index: u64) -> [u64; 2]:
    if __wrela_pixels_p7_telemetry_counter(renderer, 0, 0)[0] != 1:
        return [0; 2]
    config = __wrela_pixels_p7_numeric_config(renderer)
    if config[0] != 1 or config[1] <= 0 or config[2] <= 0:
        return [0; 2]
    frame_bytes = config[1].to[u64]() * config[2].to[u64]() * 4
    frame_words = (frame_bytes + 7) / 8
    # One schema word plus four workers times 162 counters.
    telemetry_words: u64 = 649
    total = frame_words + 15 + telemetry_words
    if total > 65550:
        return [0; 2]
    if index == 0:
        return [1, total]
    if index >= 1 and index <= 6:
        camera = __wrela_pixels_p7_frame_snapshot_camera(renderer)
        camera_slot = (index - 1).to[usize]()
        low = __wrela_pixels_f32_to_bits(camera[camera_slot * 2]).to[u64]()
        high = __wrela_pixels_f32_to_bits(camera[camera_slot * 2 + 1]).to[u64]()
        return [1, low | (high << 32)]
    if index >= 7 and index <= 14:
        params = __wrela_pixels_p7_frame_snapshot_params(renderer)
        param_slot = (index - 7).to[usize]()
        low = __wrela_pixels_f32_to_bits(params[param_slot * 2]).to[u64]()
        high = __wrela_pixels_f32_to_bits(params[param_slot * 2 + 1]).to[u64]()
        return [1, low | (high << 32)]
    if index == 15:
        return [1, frame_words | (telemetry_words << 32)]
    word = index - 16
    if word < frame_words:
        return __wrela_pixels_p8_visible_word(renderer, word.to[usize]())
    telemetry_index = word - frame_words
    if telemetry_index == 0:
        return [1, 3.to[u64]() | (162.to[u64]() << 16)]
    if telemetry_index >= telemetry_words:
        return [0; 2]
    flat = telemetry_index - 1
    worker = (flat / 162).to[u32]()
    counter = __wrela_pixels_p7_telemetry_counter(
        renderer,
        worker,
        (flat % 162).to[usize](),
    )
    if counter[0] == 1:
        return counter
    if worker == 0:
        return [0; 2]
    return [1, 0]

pub fn __wrela_pixels_debug_visibility_ready() -> Result[unit, RenderError]:
    return Ok(unit)
