module render_raster

from core.render_interval import FixedDomain, Iv32, NumericOutcome, interval_ceil_div, interval_floor_div, interval_narrow
from core.field import Vec3, rsqrt_scalar, sqrt_scalar

# Compiler-recognized representation copies used only inside this sealed
# module. Their ordinary bodies keep source checking total; lowering and
# comptime evaluation preserve the exact f32 bits.
pub fn pixels_f32_to_bits(value: f32) -> u32:
    return value.to[u32]()

pub fn pixels_f32_from_bits(bits: u32) -> f32:
    return bits.to[f32]()

pub struct IdentitySetId:
    pub value: u32

pub struct MaterialSummaryId:
    pub value: u32

pub struct LightSummaryId:
    pub value: u32

pub struct RunId:
    pub value: u16

pub struct EventId:
    pub value: u16

# A compact reference into the generated event arena. `T` is nominal: the
# same offset cannot be passed between unrelated ID domains.
pub struct IdSlice[T]:
    pub first: u16
    pub count: u16

pub struct AffineRunSetup:
    pub value: i32
    pub delta: i32
    pub error_radius: i32

pub struct OutputProofCode:
    pub bits: u8

pub struct RasterRun:
    pub x0: u16
    pub x1: u16
    pub q: QRunScalar
    pub q_u: AffineRunSetup
    pub q_v: AffineRunSetup
    pub identity: IdentitySetId
    pub material_summary: MaterialSummaryId
    pub light_summary: LightSummaryId
    pub proof_code: OutputProofCode

pub struct EventPixel:
    pub x: u16
    pub coverage: Iv32
    pub front_run: RunId
    pub back_run: RunId
    pub event_ids: IdSlice[EventId]

# Source-level nominal wrapper for the existing array type. The private
# intrinsic below is the only ASIMD seam; named accessors keep lane order
# explicit in Wrela source and preserve the scalar semantics used by eval.
pub struct I32x4:
    # Two ordinary i64 slots form one packed 128-bit backend value. This
    # keeps the nominal type inside the existing Wrela type system while
    # giving the ASIMD seam four contiguous little-endian i32 lanes.
    words: [i64; 2]

    pub fn from_lanes(lanes: [i32; 4]) -> I32x4:
        return I32x4(words=[
            (lanes[0].to[i64]() & 4294967295) | (lanes[1].to[i64]() *% 4294967296),
            (lanes[2].to[i64]() & 4294967295) | (lanes[3].to[i64]() *% 4294967296),
        ])

    pub fn lane(read self, index: usize) -> i32:
        assert index < 4
        word = self.words[index / 2]
        if index % 2 == 0:
            return (word *% 4294967296 >> 32).to[i32]()
        return (word >> 32).to[i32]()

# Sealed 16-byte carrier for the internal f32x4 substrate. Machine-v1 scalar
# slots are eight bytes, so the carrier stores two packed lane pairs instead
# of an ordinary [f32; 4]. The generated bit helpers are representation copies.
pub struct F32x4:
    words: [i64; 2]

    pub fn from_bits(lanes: [u32; 4]) -> F32x4:
        return F32x4(words=[
            lanes[0].to[i64]() | (lanes[1].to[i64]() *% 4294967296),
            lanes[2].to[i64]() | (lanes[3].to[i64]() *% 4294967296),
        ])

    pub fn from_lanes(lanes: [f32; 4]) -> F32x4:
        return F32x4(words=[
            pixels_f32_to_bits(lanes[0]).to[i64]() | (pixels_f32_to_bits(lanes[1]).to[i64]() *% 4294967296),
            pixels_f32_to_bits(lanes[2]).to[i64]() | (pixels_f32_to_bits(lanes[3]).to[i64]() *% 4294967296),
        ])

    pub fn lane(read self, index: usize) -> f32:
        assert index < 4
        word = self.words[index / 2]
        if index % 2 == 0:
            return pixels_f32_from_bits((word & 4294967295).to[u32]())
        return pixels_f32_from_bits((word >> 32 & 4294967295).to[u32]())

    pub fn lane_bits(read self, index: usize) -> u32:
        assert index < 4
        word = self.words[index / 2]
        if index % 2 == 0:
            return (word & 4294967295).to[u32]()
        return (word >> 32 & 4294967295).to[u32]()

pub fn pixels_f32_min_scalar(lhs: f32, rhs: f32) -> f32:
    lhs_bits = pixels_f32_to_bits(lhs)
    rhs_bits = pixels_f32_to_bits(rhs)
    if lhs_bits & 2139095040 == 2139095040 and lhs_bits & 8388607 != 0:
        return pixels_f32_from_bits(2143289344)
    if rhs_bits & 2139095040 == 2139095040 and rhs_bits & 8388607 != 0:
        return pixels_f32_from_bits(2143289344)
    if lhs == 0.0 and rhs == 0.0:
        return pixels_f32_from_bits(lhs_bits | rhs_bits)
    if lhs < rhs:
        return lhs
    return rhs

pub fn pixels_f32_max_scalar(lhs: f32, rhs: f32) -> f32:
    lhs_bits = pixels_f32_to_bits(lhs)
    rhs_bits = pixels_f32_to_bits(rhs)
    if lhs_bits & 2139095040 == 2139095040 and lhs_bits & 8388607 != 0:
        return pixels_f32_from_bits(2143289344)
    if rhs_bits & 2139095040 == 2139095040 and rhs_bits & 8388607 != 0:
        return pixels_f32_from_bits(2143289344)
    if lhs == 0.0 and rhs == 0.0:
        return pixels_f32_from_bits(lhs_bits & rhs_bits)
    if lhs > rhs:
        return lhs
    return rhs

pub fn pixels_i32_select_gt_scalar(lhs: i32, rhs: i32, when_true: i32, when_false: i32) -> i32:
    if lhs > rhs:
        return when_true
    return when_false

pub fn pixels_f32_select_ge_scalar(lhs: f32, rhs: f32, when_true: f32, when_false: f32) -> f32:
    if lhs >= rhs:
        return when_true
    return when_false

pub fn pixels_f32_select_gt_scalar(lhs: f32, rhs: f32, when_true: f32, when_false: f32) -> f32:
    if lhs > rhs:
        return when_true
    return when_false

pub fn pixels_i32x4_backend_splat(value: i32) -> I32x4:
    return I32x4.from_lanes([value; 4])

# Hot-path census region ids. These are the sealed vocabulary the compiler's
# `pixels::hot_census` module knows by the same numbers; a marker naming an id
# outside it fails the census lane closed.
pub const PIXELS_REGION_RASTER_SCALAR_PREFIX: u32 = 1
pub const PIXELS_REGION_RASTER_PACKET_LOOP: u32 = 2
pub const PIXELS_REGION_RASTER_SCALAR_SUFFIX: u32 = 3
pub const PIXELS_REGION_RASTER_CHARGE: u32 = 4
pub const PIXELS_REGION_COVERAGE_ENTRY: u32 = 5
pub const PIXELS_REGION_COVERAGE_CELL_WALK: u32 = 6

# Open a hot-path census region. The compiler replaces every call with a
# non-emitting MachineWir `RegionMarker`, so the emitted code is byte-identical
# with the markers present and stripped; the scalar body below is what any
# non-renderer evaluation of this symbol sees, and it does nothing.
#
# Block labels were rejected as the region mechanism because they are not
# stable across optimization, and helper functions because their call overhead
# is exactly the thing being measured.
pub fn pixels_census_region(region: u32) -> unit:
    return

pub fn pixels_i32x4_backend_add(read lhs: I32x4, read rhs: I32x4) -> I32x4:
    return I32x4.from_lanes([
        lhs.lane(0) +% rhs.lane(0),
        lhs.lane(1) +% rhs.lane(1),
        lhs.lane(2) +% rhs.lane(2),
        lhs.lane(3) +% rhs.lane(3),
    ])

pub fn pixels_i32x4_backend_sub(read lhs: I32x4, read rhs: I32x4) -> I32x4:
    return I32x4.from_lanes([
        lhs.lane(0) -% rhs.lane(0), lhs.lane(1) -% rhs.lane(1),
        lhs.lane(2) -% rhs.lane(2), lhs.lane(3) -% rhs.lane(3),
    ])

pub fn pixels_i32x4_backend_shr_arith_imm(read value: I32x4, immediate: u8) -> I32x4:
    assert immediate > 0 and immediate <= 31
    return I32x4.from_lanes([
        value.lane(0) >> immediate.to[i32](), value.lane(1) >> immediate.to[i32](),
        value.lane(2) >> immediate.to[i32](), value.lane(3) >> immediate.to[i32](),
    ])

pub fn pixels_i32x4_backend_and(read lhs: I32x4, read rhs: I32x4) -> I32x4:
    return I32x4.from_lanes([
        lhs.lane(0) & rhs.lane(0), lhs.lane(1) & rhs.lane(1),
        lhs.lane(2) & rhs.lane(2), lhs.lane(3) & rhs.lane(3),
    ])

pub fn pixels_i32x4_backend_or(read lhs: I32x4, read rhs: I32x4) -> I32x4:
    return I32x4.from_lanes([
        lhs.lane(0) | rhs.lane(0), lhs.lane(1) | rhs.lane(1),
        lhs.lane(2) | rhs.lane(2), lhs.lane(3) | rhs.lane(3),
    ])

pub fn pixels_i32x4_backend_select_gt(read lhs: I32x4, read rhs: I32x4, read when_true: I32x4, read when_false: I32x4) -> I32x4:
    return I32x4.from_lanes([
        pixels_i32_select_gt_scalar(lhs.lane(0), rhs.lane(0), when_true.lane(0), when_false.lane(0)),
        pixels_i32_select_gt_scalar(lhs.lane(1), rhs.lane(1), when_true.lane(1), when_false.lane(1)),
        pixels_i32_select_gt_scalar(lhs.lane(2), rhs.lane(2), when_true.lane(2), when_false.lane(2)),
        pixels_i32_select_gt_scalar(lhs.lane(3), rhs.lane(3), when_true.lane(3), when_false.lane(3)),
    ])

pub fn pixels_i32x4_backend_to_f32x4(read value: I32x4) -> F32x4:
    return F32x4.from_lanes([
        value.lane(0).to[f32](), value.lane(1).to[f32](),
        value.lane(2).to[f32](), value.lane(3).to[f32](),
    ])

pub fn pixels_f32x4_backend_splat(value: f32) -> F32x4:
    return F32x4.from_lanes([value; 4])

pub fn pixels_f32x4_backend_add(read lhs: F32x4, read rhs: F32x4) -> F32x4:
    return F32x4.from_lanes([
        lhs.lane(0) + rhs.lane(0), lhs.lane(1) + rhs.lane(1),
        lhs.lane(2) + rhs.lane(2), lhs.lane(3) + rhs.lane(3),
    ])

pub fn pixels_f32x4_backend_sub(read lhs: F32x4, read rhs: F32x4) -> F32x4:
    return F32x4.from_lanes([
        lhs.lane(0) - rhs.lane(0), lhs.lane(1) - rhs.lane(1),
        lhs.lane(2) - rhs.lane(2), lhs.lane(3) - rhs.lane(3),
    ])

pub fn pixels_f32x4_backend_mul(read lhs: F32x4, read rhs: F32x4) -> F32x4:
    return F32x4.from_lanes([
        lhs.lane(0) * rhs.lane(0), lhs.lane(1) * rhs.lane(1),
        lhs.lane(2) * rhs.lane(2), lhs.lane(3) * rhs.lane(3),
    ])

pub fn pixels_f32x4_backend_min(read lhs: F32x4, read rhs: F32x4) -> F32x4:
    return F32x4.from_lanes([
        pixels_f32_min_scalar(lhs.lane(0), rhs.lane(0)), pixels_f32_min_scalar(lhs.lane(1), rhs.lane(1)),
        pixels_f32_min_scalar(lhs.lane(2), rhs.lane(2)), pixels_f32_min_scalar(lhs.lane(3), rhs.lane(3)),
    ])

pub fn pixels_f32x4_backend_max(read lhs: F32x4, read rhs: F32x4) -> F32x4:
    return F32x4.from_lanes([
        pixels_f32_max_scalar(lhs.lane(0), rhs.lane(0)), pixels_f32_max_scalar(lhs.lane(1), rhs.lane(1)),
        pixels_f32_max_scalar(lhs.lane(2), rhs.lane(2)), pixels_f32_max_scalar(lhs.lane(3), rhs.lane(3)),
    ])

pub fn pixels_f32x4_backend_select_ge(read lhs: F32x4, read rhs: F32x4, read when_true: F32x4, read when_false: F32x4) -> F32x4:
    return F32x4.from_lanes([
        pixels_f32_select_ge_scalar(lhs.lane(0), rhs.lane(0), when_true.lane(0), when_false.lane(0)),
        pixels_f32_select_ge_scalar(lhs.lane(1), rhs.lane(1), when_true.lane(1), when_false.lane(1)),
        pixels_f32_select_ge_scalar(lhs.lane(2), rhs.lane(2), when_true.lane(2), when_false.lane(2)),
        pixels_f32_select_ge_scalar(lhs.lane(3), rhs.lane(3), when_true.lane(3), when_false.lane(3)),
    ])

pub fn pixels_f32x4_backend_select_gt(read lhs: F32x4, read rhs: F32x4, read when_true: F32x4, read when_false: F32x4) -> F32x4:
    return F32x4.from_lanes([
        pixels_f32_select_gt_scalar(lhs.lane(0), rhs.lane(0), when_true.lane(0), when_false.lane(0)),
        pixels_f32_select_gt_scalar(lhs.lane(1), rhs.lane(1), when_true.lane(1), when_false.lane(1)),
        pixels_f32_select_gt_scalar(lhs.lane(2), rhs.lane(2), when_true.lane(2), when_false.lane(2)),
        pixels_f32_select_gt_scalar(lhs.lane(3), rhs.lane(3), when_true.lane(3), when_false.lane(3)),
    ])

# Two-word unsigned arithmetic for the generated fused-reference path. The
# exact product is at most 48 bits; aligning its leading bit at bit 100 leaves
# enough guard bits for one binary32 rounding while fitting the signed sum in
# 128 bits.
pub fn __pixels_u128_zero() -> [u64; 2]:
    return [0, 0]

pub fn __pixels_u128_from_u64(value: u64) -> [u64; 2]:
    return [value, 0]

pub fn __pixels_u128_is_zero(read value: [u64; 2]) -> bool:
    return value[0] == 0 and value[1] == 0

pub fn __pixels_u128_compare(read lhs: [u64; 2], read rhs: [u64; 2]) -> i32:
    if lhs[1] < rhs[1]:
        return -1
    if lhs[1] > rhs[1]:
        return 1
    if lhs[0] < rhs[0]:
        return -1
    if lhs[0] > rhs[0]:
        return 1
    return 0

pub fn __pixels_u128_add(read lhs: [u64; 2], read rhs: [u64; 2]) -> [u64; 2]:
    low = lhs[0] +% rhs[0]
    carry: u64 = 0
    if low < lhs[0]:
        carry = 1
    return [low, lhs[1] +% rhs[1] +% carry]

pub fn __pixels_u128_sub(read lhs: [u64; 2], read rhs: [u64; 2]) -> [u64; 2]:
    borrow: u64 = 0
    if lhs[0] < rhs[0]:
        borrow = 1
    return [lhs[0] -% rhs[0], lhs[1] -% rhs[1] -% borrow]

pub fn __pixels_u128_shift_left(read value: [u64; 2], distance: u32) -> [u64; 2]:
    if distance == 0:
        return value
    if distance >= 128:
        return __pixels_u128_zero()
    if distance >= 64:
        factor = 1.to[u64]() << (distance - 64).to[u64]()
        return [0, value[0] *% factor]
    factor = 1.to[u64]() << distance.to[u64]()
    return [
        value[0] *% factor,
        (value[1] *% factor) | (value[0] >> (64 - distance).to[u64]()),
    ]

pub fn __pixels_u128_shift_right(read value: [u64; 2], distance: u32) -> [u64; 2]:
    if distance == 0:
        return value
    if distance >= 128:
        return __pixels_u128_zero()
    if distance >= 64:
        return [value[1] >> (distance - 64).to[u64](), 0]
    carry_factor = 1.to[u64]() << (64 - distance).to[u64]()
    return [
        (value[0] >> distance.to[u64]()) | (value[1] *% carry_factor),
        value[1] >> distance.to[u64](),
    ]

pub fn __pixels_u128_lower_bits_nonzero(read value: [u64; 2], count: u32) -> bool:
    if count == 0:
        return false
    if count >= 128:
        return not __pixels_u128_is_zero(value)
    if count > 64:
        high_count = count - 64
        high_mask = (1.to[u64]() << high_count.to[u64]()) - 1
        return value[0] != 0 or value[1] & high_mask != 0
    if count == 64:
        return value[0] != 0
    mask = (1.to[u64]() << count.to[u64]()) - 1
    return value[0] & mask != 0

pub fn __pixels_u128_bit(read value: [u64; 2], index: u32) -> bool:
    if index >= 128:
        return false
    if index >= 64:
        return value[1] & (1.to[u64]() << (index - 64).to[u64]()) != 0
    return value[0] & (1.to[u64]() << index.to[u64]()) != 0

pub fn __pixels_u128_shift_right_jam(read value: [u64; 2], distance: u32) -> [u64; 2]:
    shifted = __pixels_u128_shift_right(value, distance)
    if __pixels_u128_lower_bits_nonzero(value, distance):
        shifted[0] = shifted[0] | 1
    return shifted

pub fn __pixels_u128_top_bit(read value: [u64; 2]) -> i32:
    word = value[1]
    offset: i32 = 64
    if word == 0:
        word = value[0]
        offset = 0
    top: i32 = 0
    @budget(bound=64)
    while word > 1:
        word = word >> 1
        top = top + 1
    return offset + top

pub fn __pixels_u128_scale_to(value: u64, exponent: i32, target: i32) -> [u64; 2]:
    wide = __pixels_u128_from_u64(value)
    distance = exponent - target
    if distance >= 0:
        return __pixels_u128_shift_left(wide, distance.to[u32]())
    return __pixels_u128_shift_right_jam(wide, (0 - distance).to[u32]())

pub fn __pixels_u128_round_shift_even(read value: [u64; 2], distance: u32) -> u64:
    if distance == 0:
        return value[0]
    if distance > 128:
        return 0
    kept = __pixels_u128_shift_right(value, distance)[0]
    round_bit = __pixels_u128_bit(value, distance - 1)
    sticky = __pixels_u128_lower_bits_nonzero(value, distance - 1)
    if round_bit and (sticky or kept & 1 == 1):
        return kept + 1
    return kept

pub fn __pixels_f32_mantissa(bits: u32) -> u64:
    exponent_bits = (bits >> 23) & 255
    fraction = (bits & 8388607).to[u64]()
    if exponent_bits == 0:
        return fraction
    return 8388608 + fraction

pub fn __pixels_f32_exponent(bits: u32) -> i32:
    exponent_bits = (bits >> 23) & 255
    if exponent_bits == 0:
        return -149
    return exponent_bits.to[i32]() - 150

pub fn pixels_f32_fma_bits_fallback(lhs_bits: u32, rhs_bits: u32, addend_bits: u32) -> u32:
    lhs_abs = lhs_bits & 2147483647
    rhs_abs = rhs_bits & 2147483647
    addend_abs = addend_bits & 2147483647
    lhs_nan = lhs_abs > 2139095040
    rhs_nan = rhs_abs > 2139095040
    addend_nan = addend_abs > 2139095040
    if lhs_nan or rhs_nan or addend_nan:
        return 2143289344

    lhs_inf = lhs_abs == 2139095040
    rhs_inf = rhs_abs == 2139095040
    addend_inf = addend_abs == 2139095040
    lhs_zero = lhs_abs == 0
    rhs_zero = rhs_abs == 0
    product_negative = (lhs_bits ^ rhs_bits) & 2147483648 != 0
    addend_negative = addend_bits & 2147483648 != 0
    if lhs_inf or rhs_inf:
        if (lhs_inf and rhs_zero) or (rhs_inf and lhs_zero):
            return 2143289344
        if addend_inf and addend_negative != product_negative:
            return 2143289344
        if product_negative:
            return 4286578688
        return 2139095040
    if addend_inf:
        return addend_bits

    lhs_mantissa = __pixels_f32_mantissa(lhs_bits)
    rhs_mantissa = __pixels_f32_mantissa(rhs_bits)
    addend_mantissa = __pixels_f32_mantissa(addend_bits)
    product_mantissa = lhs_mantissa * rhs_mantissa
    product_exponent = __pixels_f32_exponent(lhs_bits) + __pixels_f32_exponent(rhs_bits)
    addend_exponent = __pixels_f32_exponent(addend_bits)
    if product_mantissa == 0 and addend_mantissa == 0:
        if product_negative and addend_negative:
            return 2147483648
        return 0

    product_top: i32 = -1000
    if product_mantissa != 0:
        product_top = product_exponent + __pixels_u128_top_bit(
            __pixels_u128_from_u64(product_mantissa),
        )
    addend_top: i32 = -1000
    if addend_mantissa != 0:
        addend_top = addend_exponent + __pixels_u128_top_bit(
            __pixels_u128_from_u64(addend_mantissa),
        )
    top = product_top
    if addend_top > top:
        top = addend_top
    target = top - 100
    product_scaled = __pixels_u128_scale_to(product_mantissa, product_exponent, target)
    addend_scaled = __pixels_u128_scale_to(addend_mantissa, addend_exponent, target)
    negative = false
    magnitude = __pixels_u128_zero()
    comparison = __pixels_u128_compare(product_scaled, addend_scaled)
    if product_negative == addend_negative:
        negative = product_negative
        magnitude = __pixels_u128_add(product_scaled, addend_scaled)
    elif comparison > 0:
        negative = product_negative
        magnitude = __pixels_u128_sub(product_scaled, addend_scaled)
    elif comparison < 0:
        negative = addend_negative
        magnitude = __pixels_u128_sub(addend_scaled, product_scaled)
    if __pixels_u128_is_zero(magnitude):
        return 0

    leading = __pixels_u128_top_bit(magnitude)
    unbiased = target + leading
    sign: u32 = 0
    if negative:
        sign = 2147483648
    if unbiased > 127:
        return sign | 2139095040
    if unbiased >= -126:
        rounded = __pixels_u128_round_shift_even(magnitude, (leading - 23).to[u32]())
        if rounded == 16777216:
            rounded = rounded >> 1
            unbiased = unbiased + 1
            if unbiased > 127:
                return sign | 2139095040
        exponent = (unbiased + 127).to[u32]()
        return sign | (exponent << 23) | (rounded.to[u32]() & 8388607)

    distance: i32 = -149
    distance = distance - target
    rounded: u64 = 0
    if distance <= 0:
        shifted = __pixels_u128_shift_left(magnitude, (0 - distance).to[u32]())
        rounded = shifted[0]
    else:
        rounded = __pixels_u128_round_shift_even(magnitude, distance.to[u32]())
    if rounded >= 8388608:
        return sign | 8388608
    return sign | rounded.to[u32]()

# The compiler lowers this explicit packet operation to FMLA. Scalar and
# evaluator execution use the integer-mantissa fallback above, so no `a*b+c`
# expression or f64 double-rounding path can masquerade as a fused reference.
pub fn pixels_f32_fma_scalar(lhs: f32, rhs: f32, addend: f32) -> f32:
    return pixels_f32_from_bits(pixels_f32_fma_bits_fallback(
        pixels_f32_to_bits(lhs), pixels_f32_to_bits(rhs), pixels_f32_to_bits(addend),
    ))

@test
fn generated_f32_fma_fallback_is_fused_and_bit_exact():
    assert pixels_f32_fma_bits_fallback(1065353217, 1065353215, 3212836864) == 864026622
    assert pixels_f32_fma_bits_fallback(8388608, 1056964608, 1) == 4194305
    assert pixels_f32_fma_bits_fallback(2139095039, 1065353217, 4286578687) == 1946157055
    assert pixels_f32_fma_bits_fallback(2147483648, 1065353216, 2147483648) == 2147483648
    assert pixels_f32_fma_bits_fallback(0, 2139095040, 0) == 2143289344
    assert pixels_f32_fma_bits_fallback(2139095040, 1065353216, 4286578688) == 2143289344

pub fn pixels_f32x4_backend_fma(read lhs: F32x4, read rhs: F32x4, read addend: F32x4) -> F32x4:
    return F32x4.from_lanes([
        pixels_f32_fma_scalar(lhs.lane(0), rhs.lane(0), addend.lane(0)),
        pixels_f32_fma_scalar(lhs.lane(1), rhs.lane(1), addend.lane(1)),
        pixels_f32_fma_scalar(lhs.lane(2), rhs.lane(2), addend.lane(2)),
        pixels_f32_fma_scalar(lhs.lane(3), rhs.lane(3), addend.lane(3)),
    ])

pub fn pixels_f32_to_i32_scalar(value: f32) -> i32:
    bits = pixels_f32_to_bits(value)
    if bits & 2139095040 == 2139095040 and bits & 8388607 != 0:
        return 0
    if value >= 2147483648.0:
        return 2147483647
    if value <= -2147483648.0:
        return -2147483648
    return value.to[i32]()

pub fn pixels_f32x4_backend_to_i32x4(read value: F32x4) -> I32x4:
    return I32x4.from_lanes([
        pixels_f32_to_i32_scalar(value.lane(0)), pixels_f32_to_i32_scalar(value.lane(1)),
        pixels_f32_to_i32_scalar(value.lane(2)), pixels_f32_to_i32_scalar(value.lane(3)),
    ])

pub enum I32x4Outcome:
    Value(I32x4)
    Error

pub struct ScalarRasterValues:
    values: [i32; 64]
    count: u8

    pub fn length(read self) -> u8:
        return self.count

    pub fn value(read self, index: usize) -> i32:
        assert index < self.count.to[usize]()
        return self.values[index]

pub enum ScalarRasterOutcome:
    Value(ScalarRasterValues)
    Error

# Permanent scalar oracle for one certified microtile. The caller owns debug
# color evaluation and the single BGRA write; this routine owns the exact
# q/dq/ddq recurrence and final-index check.
pub fn raster_run_scalar(q: i32, dq: i32, ddq: i32, width: u8) -> ScalarRasterOutcome:
    if width == 0 or width > 64:
        return .Error
    values: [i32; 64] = [0; 64]
    current_q = q
    current_dq = dq
    index: u8 = 0
    @budget(bound=64)
    while index < width:
        values[index.to[usize]()] = current_q
        index = index + 1
        if index < width:
            next_q = current_q.to[i64]() + current_dq.to[i64]()
            next_dq = current_dq.to[i64]() + ddq.to[i64]()
            if next_q < -2147483648 or next_q > 2147483647 or next_dq < -2147483648 or next_dq > 2147483647:
                return .Error
            current_q = next_q.to[i32]()
            current_dq = next_dq.to[i32]()
    assert index == width
    return .Value(ScalarRasterValues(values=values, count=width))

pub fn i32x4_add_checked(read lhs: I32x4, read rhs: I32x4) -> I32x4Outcome:
    lane: usize = 0
    @budget(bound=4)
    while lane < 4:
        value = lhs.lane(lane).to[i64]() + rhs.lane(lane).to[i64]()
        if value < -2147483648 or value > 2147483647:
            return .Error
        lane = lane + 1
    return .Value(pixels_i32x4_backend_add(lhs, rhs))

# Four consecutive second-order recurrence samples. Checked construction is
# outside the intrinsic, so the ASIMD add has exactly the already-proved
# ordinary-add semantics.
pub fn raster_run4(q: i32, dq: i32, ddq: i32) -> I32x4Outcome:
    q64 = q.to[i64]()
    dq64 = dq.to[i64]()
    ddq64 = ddq.to[i64]()
    offsets: [i64; 4] = [0, dq64, 2 * dq64 + ddq64, 3 * dq64 + 3 * ddq64]
    lane: usize = 0
    @budget(bound=4)
    while lane < 4:
        value = q64 + offsets[lane]
        if value < -2147483648 or value > 2147483647:
            return .Error
        lane = lane + 1
    return i32x4_add_checked(
        I32x4.from_lanes([q; 4]),
        I32x4.from_lanes([
            offsets[0].to[i32](), offsets[1].to[i32](),
            offsets[2].to[i32](), offsets[3].to[i32](),
        ]),
    )

# Normative P8 reciprocal-square-root refinement. `rsqrt_scalar` supplies the
# sealed source seed; two explicitly ordered Newton steps make the packet
# normal contract independent of optimizer reassociation.
pub fn raster_rsqrt(value: f32) -> f32:
    if value <= 0.0:
        return 0.0
    estimate = rsqrt_scalar(value)
    estimate = estimate * (1.5 - 0.5 * value * estimate * estimate)
    estimate = estimate * (1.5 - 0.5 * value * estimate * estimate)
    return estimate

pub fn reconstruct_packet_normal(q: f32, q_u: f32, q_v: f32, u: f32, v: f32, direction_required: bool) -> Vec3:
    normal = Vec3(x=q_u, y=q_v, z=q - u * q_u - v * q_v)
    if not direction_required:
        return normal
    norm_squared = normal.x * normal.x + normal.y * normal.y + normal.z * normal.z
    assert norm_squared > 0.0
    inverse_norm = raster_rsqrt(norm_squared)
    return Vec3(
        x=normal.x * inverse_norm,
        y=normal.y * inverse_norm,
        z=normal.z * inverse_norm,
    )

pub fn reconstruct_packet_world_normal(q: f32, q_u: f32, q_v: f32, u: f32, v: f32, read right: Vec3, read up: Vec3, read forward: Vec3, direction_required: bool) -> Vec3:
    camera_normal = reconstruct_packet_normal(q, q_u, q_v, u, v, false)
    world = Vec3(
        x=right.x * camera_normal.x + up.x * camera_normal.y + forward.x * camera_normal.z,
        y=right.y * camera_normal.x + up.y * camera_normal.y + forward.y * camera_normal.z,
        z=right.z * camera_normal.x + up.z * camera_normal.y + forward.z * camera_normal.z,
    )
    if not direction_required:
        return world
    norm_squared = world.x * world.x + world.y * world.y + world.z * world.z
    assert norm_squared > 0.0
    inverse_norm = raster_rsqrt(norm_squared)
    return Vec3(x=world.x * inverse_norm, y=world.y * inverse_norm, z=world.z * inverse_norm)

# World position is deliberately separate from normal reconstruction. The
# generated dependency summaries call this only when a material or light
# consumes position, keeping the P8 debug-identity loop reciprocal-free.
pub fn reconstruct_packet_world_position(q: f32, u: f32, v: f32, read eye: Vec3, read right: Vec3, read up: Vec3, read forward: Vec3) -> Vec3:
    assert q != 0.0
    reciprocal_q = 1.0 / q
    return Vec3(
        x=eye.x + (forward.x + u * right.x + v * up.x) * reciprocal_q,
        y=eye.y + (forward.y + u * right.y + v * up.y) * reciprocal_q,
        z=eye.z + (forward.z + u * right.z + v * up.z) * reciprocal_q,
    )

pub struct RasterGeometryLane:
    pub q_raw: i32
    pub q_error: i32
    pub q_u_raw: i32
    pub q_u_error: i32
    pub q_v_raw: i32
    pub q_v_error: i32
    pub q: f32
    pub q_u: f32
    pub q_v: f32
    pub u: f32
    pub v: f32

fn raster_i32_enclosure_fits(raw: i32, error: i32) -> bool:
    if error < 0:
        return false
    low = raw.to[i64]() - error.to[i64]()
    high = raw.to[i64]() + error.to[i64]()
    return low >= -2147483648 and high <= 2147483647

pub fn raster_geometry_lane_valid(read lane: RasterGeometryLane, material_dependencies: u32, light_dependencies: u32, read camera: [f32; 12]) -> bool:
    # The values consumed below are the actual scalar/vector raster lanes.
    # Validate every one against the compact run enclosure before any
    # normalization or optional reciprocal. This is also the instrumented
    # conformance boundary: a checked lane is evidence from the production
    # path, not a separately rendered host value.
    if (
        not raster_i32_enclosure_fits(lane.q_raw, lane.q_error)
        or not raster_i32_enclosure_fits(lane.q_u_raw, lane.q_u_error)
        or not raster_i32_enclosure_fits(lane.q_v_raw, lane.q_v_error)
    ):
        return false
    # Construct and transform the geometric normal for every raster lane.
    # A dependency summary may omit normalization, but it may not bypass the
    # q/q_u/q_v recurrence or its camera-basis boundary.
    camera_z = lane.q - lane.u * lane.q_u - lane.v * lane.q_v
    normal_x = camera[6] * lane.q_u + camera[9] * lane.q_v + camera[3] * camera_z
    normal_y = camera[7] * lane.q_u + camera[10] * lane.q_v + camera[4] * camera_z
    normal_z = camera[8] * lane.q_u + camera[11] * lane.q_v + camera[5] * camera_z
    if (
        normal_x * 0.0 != 0.0
        or normal_y * 0.0 != 0.0
        or normal_z * 0.0 != 0.0
    ):
        return false
    dependencies = material_dependencies | light_dependencies
    if dependencies & 2 != 0:
        # P8's debug summary never requests exact direction. Keep unexpected
        # dependency bits fail-closed; `reconstruct_packet_world_normal`
        # supplies the sealed rsqrt/Newton path for the first P9 summary that
        # opts in, without paying for unreachable normalization in P8 images.
        return false
    # P8's debug identity summary does not consume world position. The
    # dependency-gated reciprocal path remains isolated in
    # `reconstruct_packet_world_position` for material lowering; it must not
    # enter this debug raster image before P9 supplies a consuming summary.
    return true

pub struct QRunScalar:
    q: i32
    dq: i32
    ddq: i32
    domain: FixedDomain
    error_radius: i32
    microtile_width: u8
    step: u8

    pub fn make(q: i32, dq: i32, ddq: i32, error_radius: i32) -> QRunScalar:
        return QRunScalar(q=q, dq=dq, ddq=ddq, domain=FixedDomain.full(0), error_radius=error_radius, microtile_width=64, step=0)

    pub fn certified(q: i32, dq: i32, ddq: i32, domain: FixedDomain, error_radius: i32, microtile_width: u8) -> QRunScalar:
        return QRunScalar(q=q, dq=dq, ddq=ddq, domain=domain, error_radius=error_radius, microtile_width=microtile_width, step=0)

    pub fn value(read self) -> i32:
        return self.q

    pub fn delta(read self) -> i32:
        return self.dq

    pub fn second_delta(read self) -> i32:
        return self.ddq

    pub fn error(read self) -> i32:
        return self.error_radius

    pub fn width(read self) -> u8:
        return self.microtile_width

    pub fn exponent(read self) -> i32:
        return self.domain.exponent_value()

pub enum QStep:
    Value(QRunScalar)
    Error

pub enum QSetup:
    Value(QRunScalar)
    Error

pub fn fixed_q_select_integer_domain(maximum_abs: i64) -> i32:
    if maximum_abs < 0:
        return 64
    exponent: i32 = -30
    factor: i64 = 1073741824
    @budget(bound=31)
    while exponent < 0:
        if maximum_abs <= 2147483647 / factor:
            return exponent
        exponent = exponent + 1
        factor = factor / 2
    divisor: i64 = 1
    @budget(bound=64)
    while exponent <= 63:
        if interval_ceil_div(maximum_abs, divisor) <= 2147483647:
            return exponent
        exponent = exponent + 1
        divisor = divisor * 2
    return 64

pub fn fixed_q_quantize_integer(value: i32, exponent: i32) -> NumericOutcome:
    if exponent < 0:
        factor: i64 = 1
        i: i32 = 0
        @budget(bound=30)
        while i < -exponent:
            factor = factor * 2
            i = i + 1
        raw = value.to[i64]() * factor
        return interval_narrow(raw, raw, FixedDomain.full(exponent))
    divisor: i64 = 1
    i: i32 = 0
    @budget(bound=63)
    while i < exponent:
        divisor = divisor * 2
        i = i + 1
    return interval_narrow(interval_floor_div(value.to[i64](), divisor), interval_ceil_div(value.to[i64](), divisor), FixedDomain.full(exponent))

pub fn fixed_q_recurrence_fits(q: Iv32, dq: Iv32, ddq: Iv32, width: u8, domain: FixedDomain) -> bool:
    corner: i32 = 0
    @budget(bound=8)
    while corner < 8:
        q_value = q.lower().to[i64]()
        if corner & 1 != 0:
            q_value = q.upper().to[i64]()
        dq_value = dq.lower().to[i64]()
        if corner & 2 != 0:
            dq_value = dq.upper().to[i64]()
        ddq_value = ddq.lower().to[i64]()
        if corner & 4 != 0:
            ddq_value = ddq.upper().to[i64]()
        step: i32 = 0
        @budget(bound=64)
        while step < width.to[i32]():
            q_value = q_value + dq_value
            dq_value = dq_value + ddq_value
            if q_value < -2147483648 or q_value > 2147483647 or dq_value < -2147483648 or dq_value > 2147483647:
                return false
            if not domain.contains_raw(q_value.to[i32]()) or not domain.contains_raw(dq_value.to[i32]()):
                return false
            step = step + 1
        corner = corner + 1
    return true

pub fn fixed_q_setup(q: i32, dq: i32, ddq: i32, requested_width: u8, model_error_radius: i32) -> QSetup:
    if requested_width == 0 or model_error_radius < 0:
        return .Error
    width64 = requested_width.to[i64]()
    if width64 > 64:
        width64 = 64
    triangular = width64 * (width64 - 1) / 2
    q_abs = q.to[i64]()
    if q_abs < 0:
        q_abs = -q_abs
    dq_abs = dq.to[i64]()
    if dq_abs < 0:
        dq_abs = -dq_abs
    ddq_abs = ddq.to[i64]()
    if ddq_abs < 0:
        ddq_abs = -ddq_abs
    envelope = q_abs + width64 * dq_abs + triangular * ddq_abs
    exponent = fixed_q_select_integer_domain(envelope)
    if exponent > 63:
        return .Error
    match fixed_q_quantize_integer(q, exponent):
        case .Value(q_interval):
            match fixed_q_quantize_integer(dq, exponent):
                case .Value(dq_interval):
                    match fixed_q_quantize_integer(ddq, exponent):
                        case .Value(ddq_interval):
                            width: i32 = 1
                            limit = requested_width.to[i32]()
                            if limit > 32:
                                limit = 32
                            @budget(bound=6)
                            while width * 2 <= limit:
                                width = width * 2
                            @budget(bound=6)
                            while width > 0 and not fixed_q_recurrence_fits(q_interval, dq_interval, ddq_interval, width.to[u8](), FixedDomain.full(exponent)):
                                width = width / 2
                            if width == 0:
                                return .Error
                            q_center = q_interval.lower() + (q_interval.upper() - q_interval.lower()) / 2
                            dq_center = dq_interval.lower() + (dq_interval.upper() - dq_interval.lower()) / 2
                            ddq_center = ddq_interval.lower() + (ddq_interval.upper() - ddq_interval.lower()) / 2
                            q_radius = (q_interval.upper() - q_interval.lower() + 1) / 2
                            dq_radius = (dq_interval.upper() - dq_interval.lower() + 1) / 2
                            ddq_radius = (ddq_interval.upper() - ddq_interval.lower() + 1) / 2
                            error = q_radius + width * dq_radius + width * (width - 1) / 2 * ddq_radius + model_error_radius
                            return .Value(QRunScalar.certified(q_center, dq_center, ddq_center, FixedDomain.full(exponent), error, width.to[u8]()))
                        case _:
                            return .Error
                case _:
                    return .Error
        case _:
            return .Error

pub fn fixed_q_step(run: QRunScalar) -> QStep:
    if run.error_radius < 0 or run.microtile_width == 0 or run.microtile_width > 64 or run.step >= run.microtile_width:
        return .Error
    q64 = run.q.to[i64]() + run.dq.to[i64]()
    dq64 = run.dq.to[i64]() + run.ddq.to[i64]()
    if q64 < -2147483648 or q64 > 2147483647 or dq64 < -2147483648 or dq64 > 2147483647:
        return .Error
    q = q64.to[i32]()
    dq = dq64.to[i32]()
    if not run.domain.contains_raw(q) or not run.domain.contains_raw(dq):
        return .Error
    return .Value(QRunScalar(q=q, dq=dq, ddq=run.ddq, domain=run.domain, error_radius=run.error_radius, microtile_width=run.microtile_width, step=run.step + 1))

pub fn fixed_q_nearer(a_q: i32, a_error: i32, b_q: i32, b_error: i32) -> bool:
    if a_error < 0 or b_error < 0:
        return false
    return a_q.to[i64]() - a_error.to[i64]() > b_q.to[i64]() + b_error.to[i64]()
