pub fn __wrela_xreply_7(turn_and_tag: u64, reply: u64):
    __wrela_rt_xreply(7, turn_and_tag, reply)
    return



const REPLY_TAG_OK: u64 = 0
const CALL_ERROR_TAG_CANCELLED: u64 = 1

pub fn __wrela_rt_enqueue(core: usize, root: usize, method: u64, arg0: u64, arg1: u64, waker_turn: u64, waker_core: u64) -> u64:
    if core >= N_CORES:
        MACHINE_INFO.test_failed = MACHINE_INFO.test_failed +% 1
        return 1
    if root >= N_MAILBOXES:
        return 1
    if root == NO_EDGE:
        return 1
    cap = __wrela_mb_capacity(root)
    count = __wrela_mb_get_count(root)
    if count >= cap:
        return 1
    slot_words = __wrela_mb_slot_words(root)
    tail = __wrela_mb_get_tail(root)
    base = (tail *% slot_words.to[u64]()).to[usize]()
    __wrela_mb_store_word(root, base, method)
    packed = waker_turn | (waker_core << 32)
    __wrela_mb_store_word(root, base +% 1, packed)
    if slot_words >= 3:
        __wrela_mb_store_word(root, base +% 2, arg0)
    if slot_words >= 4:
        __wrela_mb_store_word(root, base +% 3, arg1)
    t = tail +% 1
    if t >= cap:
        t = 0
    __wrela_mb_set_tail(root, t)
    __wrela_mb_set_count(root, count +% 1)
    LANE1.messages[core] = LANE1.messages[core] +% 1
    return 0

pub fn __wrela_try_enqueue(core: usize, handle: usize, method: u64, arg0: u64, arg1: u64, waker_turn: u64, waker_core: u64) -> u64:
    root = __wrela_enqueue_root(handle)
    if root == NO_EDGE:
        return 1
    return __wrela_rt_enqueue(core, root, method, arg0, arg1, waker_turn, waker_core)

pub fn __wrela_enqueue_local(root: usize, method: u64, arg0: u64, arg1: u64, waker_turn: u64, waker_core: u64) -> u64:
    return __wrela_rt_enqueue(__wrela_mb_core(root), root, method, arg0, arg1, waker_turn, waker_core)

