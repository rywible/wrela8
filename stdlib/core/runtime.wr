pub fn __enqueue_27(method: u64, arg0: u64, arg1: u64, waker_turn: u64, waker_core: u64) -> u64:
    return __wrela_enqueue_local(27, method, arg0, arg1, waker_turn, waker_core)
pub fn __enqueue_28(method: u64, arg0: u64, arg1: u64, waker_turn: u64, waker_core: u64) -> u64:
    return __wrela_enqueue_local(28, method, arg0, arg1, waker_turn, waker_core)
pub fn __enqueue_29(method: u64, arg0: u64, arg1: u64, waker_turn: u64, waker_core: u64) -> u64:
    return __wrela_enqueue_local(29, method, arg0, arg1, waker_turn, waker_core)
pub fn __enqueue_30(method: u64, arg0: u64, arg1: u64, waker_turn: u64, waker_core: u64) -> u64:
    return __wrela_enqueue_local(30, method, arg0, arg1, waker_turn, waker_core)
pub fn __enqueue_31(method: u64, arg0: u64, arg1: u64, waker_turn: u64, waker_core: u64) -> u64:
    return __wrela_enqueue_local(31, method, arg0, arg1, waker_turn, waker_core)

# Invoke cross-core reply trampoline by edge index.
pub fn __wrela_invoke_xreply(edge: usize, turn_and_tag: u64, reply: u64):
    match edge:
        case 0:
            __wrela_xreply_0(turn_and_tag, reply)
            return
        case 1:
            __wrela_xreply_1(turn_and_tag, reply)
            return
        case 2:
            __wrela_xreply_2(turn_and_tag, reply)
            return
        case 3:
            __wrela_xreply_3(turn_and_tag, reply)
            return
        case 4:
            __wrela_xreply_4(turn_and_tag, reply)
            return
        case 5:
            __wrela_xreply_5(turn_and_tag, reply)
            return
        case 6:
            __wrela_xreply_6(turn_and_tag, reply)
            return
        case 7:
            __wrela_xreply_7(turn_and_tag, reply)
            return
        case _:
            return

# Deliver reply to waker (local TurnArea or remote xreply ring).
pub fn __wrela_deliver_reply(root: usize, ti: usize, reply: u64, tag: u64):
    wt = RT.turns[ti].waker_turn.to[u64]()
    if wt == 0:
        return
    wc = RT.turns[ti].waker_core.to[u64]()
    if wc != 0:
        actor_core = __wrela_mb_core(root)
        dst = (wc -% 1).to[usize]()
        edge = __wrela_xreply_edge(actor_core, dst)
        turn_and_tag = wt | (tag << 32)
        __wrela_invoke_xreply(edge, turn_and_tag, reply)
        return
    wi: usize = (wt -% 1).to[usize]()
    RT.turns[wi].reply_tag = tag
    RT.turns[wi].reply = reply
    RT.turns[wi].resume_ready = 1
    return

# Select + dispatch one mailbox root. Returns 1 if a turn(-slice) ran.
# `core` is the selecting core, threaded from `__wrela_try_select` for the
# Lane 1 row (plans/lane1-per-core.md item A): only the core that owns `root`'s
# RR slot ever selects it, so that core alone writes `LANE1`'s `core` slot.
pub fn __wrela_rt_select(core: usize, root: usize) -> u64:
    if core >= N_CORES:
        MACHINE_INFO.test_failed = MACHINE_INFO.test_failed +% 1
        return 0
    if root >= N_MAILBOXES:
        return 0
    if root == NO_EDGE:
        return 0
    ti = __wrela_mb_turn_index(root)
    arg0: u64 = 0
    arg1: u64 = 0
    method: u64 = 0
    if RT.turns[ti].busy != 0:
        if RT.turns[ti].suspended == 0:
            return 0
        if RT.turns[ti].resume_ready == 0:
            return 0
        method = RT.turns[ti].cur_method
    else:
        count = __wrela_mb_get_count(root)
        if count == 0:
            return 0
        RT.turns[ti].busy = 1
        slot_words = __wrela_mb_slot_words(root)
        head = __wrela_mb_get_head(root)
        base = (head *% slot_words.to[u64]()).to[usize]()
        method = __wrela_mb_load_word(root, base)
        packed = __wrela_mb_load_word(root, base +% 1)
        wt = packed & 4294967295
        wc = packed >> 32
        RT.turns[ti].cur_method = method
        RT.turns[ti].waker_turn = wt.to[u32]()
        RT.turns[ti].waker_core = wc.to[u32]()
        if __wrela_mb_has_lineage(root) != 0:
            RT.turns[ti].ambient_group = 0
            RT.turns[ti].lineage_deadline = 0
        if slot_words >= 3:
            arg0 = __wrela_mb_load_word(root, base +% 2)
        if slot_words >= 4:
            arg1 = __wrela_mb_load_word(root, base +% 3)
        h = head +% 1
        cap = __wrela_mb_capacity(root)
        if h >= cap:
            h = 0
        __wrela_mb_set_head(root, h)
        c = __wrela_mb_get_count(root)
        __wrela_mb_set_count(root, c -% 1)
        LANE1.turns[core] = LANE1.turns[core] +% 1
    mi: usize = method.to[usize]()
    n_methods = __wrela_mb_method_count(root)
    if n_methods == 0:
        MACHINE_INFO.test_failed = MACHINE_INFO.test_failed +% 1
        return 0
    if mi >= n_methods:
        MACHINE_INFO.test_failed = MACHINE_INFO.test_failed +% 1
        return 0
    stage: u64 = 0
    is_agg = __wrela_method_is_aggregate(root, mi)
    if is_agg != 0:
        wt = RT.turns[ti].waker_turn.to[u64]()
        if wt == 0:
            MACHINE_INFO.test_failed = MACHINE_INFO.test_failed +% 1
            return 0
        waker_ti: usize = (wt -% 1).to[usize]()
        slot_turn = RT.turns[waker_ti].reply_slot_turn.to[u64]()
        slot_off = RT.turns[waker_ti].reply_slot_off.to[u64]()
        turn_base = TURNS_BASE +% ((slot_turn -% 1).to[usize]() *% TURN_STRIDE)
        stage = (turn_base +% slot_off.to[usize]()).to[u64]()
    __wrela_lane1_record_method(core, root, mi)
    status_or_reply = __wrela_call_method(root, mi, arg0, arg1, stage)
    is_async = __wrela_method_suspends(root, mi)
    if is_async != 0:
        if status_or_reply == TURN_STATUS_SUSPENDED:
            return 1
        reply: u64 = 0
        tag: u64 = REPLY_TAG_OK
        if status_or_reply == TURN_STATUS_CANCELLED:
            tag = CALL_ERROR_TAG_CANCELLED
            reply = 0
        else:
            reply = RT.turns[ti].reply
        __wrela_deliver_reply(root, ti, reply, tag)
        RT.turns[ti].busy = 0
        RT.turns[ti].waker_turn = 0
        RT.turns[ti].waker_core = 0
        return 1
    reply2: u64 = 0
    if is_agg == 0:
        reply2 = status_or_reply
    __wrela_deliver_reply(root, ti, reply2, REPLY_TAG_OK)
    RT.turns[ti].busy = 0
    RT.turns[ti].waker_turn = 0
    RT.turns[ti].waker_core = 0
    return 1

# RR slot → select (replaces generated try_select → ImageStatic remap).
pub fn __wrela_try_select(core: usize, slot: usize) -> u64:
    root = __wrela_select_root(core, slot)
    if root == NO_EDGE:
        return 0
    return __wrela_rt_select(core, root)

# ---------------------------------------------------------------------------
# M11 item H: boot_init + secondary_core_entry (decisions 810–815).
# `__wrela_rt_boot_init` zeros actor/driver state via coalesced INIT_SPAN*
# overlays (M12 item E / decisions 883–885; `N_INIT_SLOTS` = span count) then
# Calls `__boot_call_*` stubs (specialized A64 with Relocs, overwritten at
# inject — decision 812). Secondary park/run loop omits sync `@budget`
# (decision 810); floor-cat1 SP install is prepended at inject (decision 811).
# ---------------------------------------------------------------------------

pub fn __wrela_rt_boot_init():
    i: usize = 0
    @budget(bound=BOOT_CALL_POOL_COUNT)
    while i < N_INIT_SLOTS:
        n = __wrela_init_nwords(i)
        j: usize = 0
        @budget(bound=4096)
        while j < n:
            __wrela_init_store_word(i, j, 0)
            j = j +% 1
        i = i +% 1
    k: usize = 0
    @budget(bound=BOOT_CALL_POOL_COUNT)
    while k < N_BOOT_CALLS:
        __wrela_boot_call(k)
        k = k +% 1
    return

# Per-core secondary entry (decision 810): mark + unbounded park/run loop.
# SP install is floor-cat1 words prepended at inject (decision 811 / 636).
# M13 item N / decision 11: loop head BLs per-core checkpoint so every
# head→back-edge path observes (wake doorbell consumed here, not by name).
pub fn __wrela_rt_secondary_entry(core: usize):
    MACHINE_INFO.core_marks[core] = (core +% 1).to[u64]()
    while true:
        # plans/lane1-per-core.md item B: "I am awake and about to look for
        # work" — cleared before the poll, so core 0 can never read a stale 1
        # for a core that is running.
        PENDING.idle[core] = 0
        __wrela_rt_checkpoint(core)
        ran = __wrela_rt_run_one(core)
        if ran == 0:
            # Release, same shape as the ring publish barrier (M15 item H):
            # every Lane 1 store this core made must be visible before the
            # word core 0 reads to conclude this core is finished. The barrier
            # is what makes the dumped totals a total and not a sample.
            @dmb(ishst)
            PENDING.idle[core] = 1
            PARK.word = 0
    return

# Secondary trampolines `__wrela_secondary_entry_k` (k in 1..N_CORES) live in
# generated rtconfig (plans/M15.md item E / decisions 1053–1054) — facts-only
# BL targets remapped onto `__wrela_rt_secondary_entry`; inject prepends SP
# and republishes under `rt_secondary_core_entry <core>`.

# ---------------------------------------------------------------------------
# M11 item I: checkpoint / vector0 (decisions 820–825). Floor-cat2 LR frame
# stays in the checkpoint section (decision 821); algorithms here are
# force-rooted. Vector0 may call deadline_scan only when a group arena
# exists (`comptime if` — decision 784 reinject rule). IRQ/wake use generated
# stubs overwritten at inject (decision 823).
# ---------------------------------------------------------------------------

pub fn __wrela_vector0():
    MACHINE_INFO.vector0_observed = MACHINE_INFO.vector0_observed +% 1
    if GROUP_ARENA_CAPACITY != 0:
        __wrela_deadline_scan()
    return

# M13 item N / decision 11: per-core pending word. Core 0 keeps the
# vector0/IRQ/wake ladders; secondary cores only consume their wake doorbell
# (the clear formerly sole in `__wrela_rt_drain`).
pub fn __wrela_rt_checkpoint(core: usize):
    if core != 0:
        @budget(bound=64)
        while true:
            p = PENDING.words[core]
            if p == 0:
                return
            PENDING.words[core] = 0
        return
    if CHECKPOINT_SIMPLE:
        @budget(bound=64)
        while true:
            p = PENDING.words[0]
            if p == 0:
                return
            __wrela_vector0()
            PENDING.words[0] = 0
        return
    @budget(bound=64)
    while true:
        did: u64 = 0
        p = PENDING.words[0]
        if p != 0:
            serviced: u64 = 0
            if (p & 1) != 0:
                __wrela_vector0()
                serviced = serviced | 1
            i: usize = 0
            @budget(bound=IRQ_CALL_POOL_COUNT)
            while i < N_IRQ_VECTORS:
                bit = __wrela_irq_mask(i)
                if (p & bit) != 0:
                    __wrela_irq_invoke(i)
                    serviced = serviced | bit
                i = i +% 1
            PENDING.words[0] = PENDING.words[0] & ~serviced
            did = 1
        @budget(bound=64)
        while true:
            any: u64 = 0
            wi: usize = 0
            @budget(bound=WAKE_CALL_POOL_COUNT)
            while wi < N_WAKE_DRAINS:
                wp = WAKE.wake_pending[wi]
                if wp != 0:
                    WAKE.wake_pending[wi] = 0
                    __wrela_wake_invoke(wi)
                    any = 1
                    did = 1
                wi = wi +% 1
            if any == 0:
                break
        if did == 0:
            return
    return

# ---------------------------------------------------------------------------
# M11 item K: primary entry / `@test(runtime)` runner (decisions 850–859).
# `__wrela_rt_primary_entry` is the 810 event-loop key: supervised root turns
# over the migrated runtime (run_one / select / enqueue). Floor trampoline
# installs SP, arms OFF_TEST_CONTINUATION at this fn, then BLs boot setup.
# Abort long-jump (floor cat4) stays — stack abandon still needs BR.
# ---------------------------------------------------------------------------

