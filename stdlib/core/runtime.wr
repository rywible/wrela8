pub fn __wrela_invoke_xreply(edge: usize, turn_and_tag: u64, reply: u64):
    match edge:
        case 0:
            __wrela_xreply_0(turn_and_tag, reply)
            return
        case 1:
            __wrela_xreply_1(turn_and_tag, reply)
            return
        case 2:
            __wrela_xreply_2(turn_and_tag, reply)
            return
        case 3:
            __wrela_xreply_3(turn_and_tag, reply)
            return
        case 4:
            __wrela_xreply_4(turn_and_tag, reply)
            return
        case 5:
            __wrela_xreply_5(turn_and_tag, reply)
            return
        case 6:
            __wrela_xreply_6(turn_and_tag, reply)
            return
        case 7:
            __wrela_xreply_7(turn_and_tag, reply)
            return
        case _:
            return

pub fn __wrela_deliver_reply(root: usize, ti: usize, reply: u64, tag: u64):
    wt = RT.turns[ti].waker_turn.to[u64]()
    if wt == 0:
        return
    wc = RT.turns[ti].waker_core.to[u64]()
    if wc != 0:
        actor_core = __wrela_mb_core(root)
        dst = (wc -% 1).to[usize]()
        edge = __wrela_xreply_edge(actor_core, dst)
        turn_and_tag = wt | (tag << 32)
        __wrela_invoke_xreply(edge, turn_and_tag, reply)
        return
    wi: usize = (wt -% 1).to[usize]()
    RT.turns[wi].reply_tag = tag
    RT.turns[wi].reply = reply
    RT.turns[wi].resume_ready = 1
    return

pub fn __wrela_rt_select(core: usize, root: usize) -> u64:
    if core >= N_CORES:
        MACHINE_INFO.test_failed = MACHINE_INFO.test_failed +% 1
        return 0
    if root >= N_MAILBOXES:
        return 0
    if root == NO_EDGE:
        return 0
    ti = __wrela_mb_turn_index(root)
    arg0: u64 = 0
    arg1: u64 = 0
    method: u64 = 0
    if RT.turns[ti].busy != 0:
        if RT.turns[ti].suspended == 0:
            return 0
        if RT.turns[ti].resume_ready == 0:
            return 0
        method = RT.turns[ti].cur_method
    else:
        count = __wrela_mb_get_count(root)
        if count == 0:
            return 0
        RT.turns[ti].busy = 1
        slot_words = __wrela_mb_slot_words(root)
        head = __wrela_mb_get_head(root)
        base = (head *% slot_words.to[u64]()).to[usize]()
        method = __wrela_mb_load_word(root, base)
        packed = __wrela_mb_load_word(root, base +% 1)
        wt = packed & 4294967295
        wc = packed >> 32
        RT.turns[ti].cur_method = method
        RT.turns[ti].waker_turn = wt.to[u32]()
        RT.turns[ti].waker_core = wc.to[u32]()
        if __wrela_mb_has_lineage(root) != 0:
            RT.turns[ti].ambient_group = 0
            RT.turns[ti].lineage_deadline = 0
        if slot_words >= 3:
            arg0 = __wrela_mb_load_word(root, base +% 2)
        if slot_words >= 4:
            arg1 = __wrela_mb_load_word(root, base +% 3)
        h = head +% 1
        cap = __wrela_mb_capacity(root)
        if h >= cap:
            h = 0
        __wrela_mb_set_head(root, h)
        c = __wrela_mb_get_count(root)
        __wrela_mb_set_count(root, c -% 1)
        LANE1.turns[core] = LANE1.turns[core] +% 1
    mi: usize = method.to[usize]()
    n_methods = __wrela_mb_method_count(root)
    if n_methods == 0:
        MACHINE_INFO.test_failed = MACHINE_INFO.test_failed +% 1
        return 0
    if mi >= n_methods:
        MACHINE_INFO.test_failed = MACHINE_INFO.test_failed +% 1
        return 0
    stage: u64 = 0
    is_agg = __wrela_method_is_aggregate(root, mi)
    if is_agg != 0:
        wt = RT.turns[ti].waker_turn.to[u64]()
        if wt == 0:
            MACHINE_INFO.test_failed = MACHINE_INFO.test_failed +% 1
            return 0
        waker_ti: usize = (wt -% 1).to[usize]()
        slot_turn = RT.turns[waker_ti].reply_slot_turn.to[u64]()
        slot_off = RT.turns[waker_ti].reply_slot_off.to[u64]()
        turn_base = TURNS_BASE +% ((slot_turn -% 1).to[usize]() *% TURN_STRIDE)
        stage = (turn_base +% slot_off.to[usize]()).to[u64]()
    __wrela_lane1_record_method(core, root, mi)
    status_or_reply = __wrela_call_method(root, mi, arg0, arg1, stage)
    is_async = __wrela_method_suspends(root, mi)
    if is_async != 0:
        if status_or_reply == TURN_STATUS_SUSPENDED:
            return 1
        reply: u64 = 0
        tag: u64 = REPLY_TAG_OK
        if status_or_reply == TURN_STATUS_CANCELLED:
            tag = CALL_ERROR_TAG_CANCELLED
            reply = 0
        else:
            reply = RT.turns[ti].reply
        __wrela_deliver_reply(root, ti, reply, tag)
        RT.turns[ti].busy = 0
        RT.turns[ti].waker_turn = 0
        RT.turns[ti].waker_core = 0
        return 1
    reply2: u64 = 0
    if is_agg == 0:
        reply2 = status_or_reply
    __wrela_deliver_reply(root, ti, reply2, REPLY_TAG_OK)
    RT.turns[ti].busy = 0
    RT.turns[ti].waker_turn = 0
    RT.turns[ti].waker_core = 0
    return 1

pub fn __wrela_try_select(core: usize, slot: usize) -> u64:
    root = __wrela_select_root(core, slot)
    if root == NO_EDGE:
        return 0
    return __wrela_rt_select(core, root)


pub fn __wrela_rt_boot_init():
    i: usize = 0
    @budget(bound=BOOT_CALL_POOL_COUNT)
    while i < N_INIT_SLOTS:
        n = __wrela_init_nwords(i)
        j: usize = 0
        @budget(bound=4096)
        while j < n:
            __wrela_init_store_word(i, j, 0)
            j = j +% 1
        i = i +% 1
    k: usize = 0
    @budget(bound=BOOT_CALL_POOL_COUNT)
    while k < N_BOOT_CALLS:
        __wrela_boot_call(k)
        k = k +% 1
    return

pub fn __wrela_rt_secondary_entry(core: usize):
    MACHINE_INFO.core_marks[core] = (core +% 1).to[u64]()
    while true:
        PENDING.idle[core] = 0
        __wrela_rt_checkpoint(core)
        ran = __wrela_rt_run_one(core)
        if ran == 0:
            @dmb(ishst)
            PENDING.idle[core] = 1
            PARK.word = 0
    return



pub fn __wrela_vector0():
    MACHINE_INFO.vector0_observed = MACHINE_INFO.vector0_observed +% 1
    if GROUP_ARENA_CAPACITY != 0:
        __wrela_deadline_scan()
    return

pub fn __wrela_rt_checkpoint(core: usize):
    if core != 0:
        @budget(bound=64)
        while true:
            p = PENDING.words[core]
            if p == 0:
                return
            PENDING.words[core] = 0
        return
    if CHECKPOINT_SIMPLE:
        @budget(bound=64)
        while true:
            p = PENDING.words[0]
            if p == 0:
                return
            __wrela_vector0()
            PENDING.words[0] = 0
        return
    @budget(bound=64)
    while true:
        did: u64 = 0
        p = PENDING.words[0]
        if p != 0:
            serviced: u64 = 0
            if (p & 1) != 0:
                __wrela_vector0()
                serviced = serviced | 1
            i: usize = 0
            @budget(bound=IRQ_CALL_POOL_COUNT)
            while i < N_IRQ_VECTORS:
                bit = __wrela_irq_mask(i)
                if (p & bit) != 0:
                    __wrela_irq_invoke(i)
                    serviced = serviced | bit
                i = i +% 1
            PENDING.words[0] = PENDING.words[0] & ~serviced
            did = 1
        @budget(bound=64)
        while true:
            any: u64 = 0
            wi: usize = 0
            @budget(bound=WAKE_CALL_POOL_COUNT)
            while wi < N_WAKE_DRAINS:
                wp = WAKE.wake_pending[wi]
                if wp != 0:
                    WAKE.wake_pending[wi] = 0
                    __wrela_wake_invoke(wi)
                    any = 1
                    did = 1
                wi = wi +% 1
            if any == 0:
                break
        if did == 0:
            return
    return


pub fn __wrela_append_ok_literal() -> u64:
    TEST_LINE_BUF.bytes[0] = 111
    TEST_LINE_BUF.bytes[1] = 107
    TEST_LINE_BUF.bytes[2] = 10
    return __wrela_console_append_line_buf(3)

