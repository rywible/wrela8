# M10 B2: machine pages the console formatter speaks to (decision 593).
# Addresses match wrela-machine::layout / console — bytes live in the VMM's
# pages, not the image blob (decision 588).
# M10 B4: packed CONSOLE_DATA.bytes for append (decisions 594–596);
# M11 B: OFF_TEST_LINE_BUF is packed `[u8; 21]` (decision 740).
# M10 C: abort latch + fail counter (decision 591); long-jump is floor
# category 4 hand-asm (`__wrela_abort_tail`).

const QUEUE_SIZE: u64 = 256
const DESC_WORD_COUNT: usize = 512
# CONSOLE_DATA_BASE imported from core.__image_runtime (wrela-machine).
const DATA_SIZE: usize = 16384

# Soft packing ceiling (rtconfig CORE_SLOTS == wrela_machine::CORE_SLOTS;
# plans/M15.md item E / decisions 1050–1051). Arrays are slot-sized;
# every live loop / release / mark path indexes N_CORES only (1052).

@layout(runtime, endian=little)
struct MachineInfoPage:
    @offset(0x28) next_deadline: u64
    @offset(0x30) exit_code: u64
    @offset(0x40) test_passed: u64
    @offset(0x48) test_failed: u64
    @offset(0x50) ring_data_bump: u64
    @offset(0x58) ring_desc_bump: u64
    @offset(0x60) line_start: u64
    @offset(0x68) core_marks: [u64; CORE_SLOTS]
    @offset(0x200) vector0_observed: u64
    @offset(0x208) abort_latch: u64
    # M11 K: next `@test(runtime)` index; advanced before each invoke so an
    # abort long-jump into `__wrela_rt_primary_entry` skips the failed test.
    # Mirrored as `wrela_machine::machine_info::OFF_TEST_NEXT` — every word
    # of this page needs a const there, or the Rust-side overlap test cannot
    # see the field (0x210 was handed out twice: this counter and the
    # SlotMap id mint, which silently ate later tests).
    @offset(0x210) test_next: u64

@placed(0x40000000)
static MACHINE_INFO: MachineInfoPage

# Monotonic clock MMIO (wrela_machine::mmio::CLOCK_MMIO_ADDR) — same trapping
# load `now()` issues; deadline poll/scan read it as a placed u64.
@layout(runtime, endian=little)
struct ClockMmio:
    now_ns: u64

@placed(0x08000000)
static CLOCK: ClockMmio

# Park MMIO (wrela_machine::mmio::PARK_MMIO_ADDR) — trapping store; VMM wakes.
@layout(runtime, endian=little)
struct ParkMmio:
    word: u64

@placed(0x08002000)
static PARK: ParkMmio

# Exit / release MMIO (wrela_machine::mmio::{EXIT,RELEASE}_MMIO_ADDR).
@placed(0x08001000)
static EXIT: ParkMmio

@placed(0x08003000)
static RELEASE: ParkMmio

# Per-core pending-vector page (pending::BASE). Capacity is CORE_SLOTS;
# algorithms index with N_CORES only (decisions 1051–1052).
# `idle` is the second array in the page (`pending::IDLE_OFF`, that module's
# own doc has the protocol): a released core stores 1 there, behind a store
# barrier, immediately before it parks with nothing to do, and 0 at its loop
# head before it does any work. It is what lets core 0 tell "every other core
# has finished" from "every other core has not started yet" before it dumps
# the Lane 1 totals (plans/lane1-per-core.md item B / decision 1504). Half a
# page apart from `words` so the VMM's doorbell stores and core 0's idle polls
# never share a cache line.
@layout(runtime, endian=little)
struct PendingPage:
    @offset(0x0) words: [u64; CORE_SLOTS]
    @offset(0x800) idle: [u64; CORE_SLOTS]

@placed(0x40007000)
static PENDING: PendingPage

# Descriptor table as 512 u64 words (256 × 16-byte entries). Word 2i is
# desc.addr; word 2i+1 packs virtio len:u32 (low) + flags/next:u32 (high).
@layout(runtime, endian=little)
struct ConsoleRingPage:
    @offset(0x0) desc_words: [u64; DESC_WORD_COUNT]
    @offset(0x1000) avail_flags_idx: u32
    @offset(0x1a08) doorbell: u64

@placed(0x40001000)
static CONSOLE_RING: ConsoleRingPage

# Packed transcript bytes (decision 596). line_commit still materializes
# CONSOLE_DATA_BASE as a const; append indexes `.bytes` densely.
@layout(runtime, endian=little)
struct ConsoleDataPage:
    bytes: [u8; DATA_SIZE]

@placed(0x40003000)
static CONSOLE_DATA: ConsoleDataPage

# Force-root seed (A2d / decision 583). Per-actor mailbox admission
# (`rt_enqueue <Actor>`) is synthesized into CodegenProgram under
# specialized keys (item D / decisions 613–615) — not spelled here,
# because the key contains a space no wrela identifier may carry.
pub fn __wrela_runtime_probe():
    return

# M10 B2: snapshot OFF_RING_DATA_BUMP into OFF_LINE_START.
pub fn __wrela_line_begin():
    MACHINE_INFO.line_start = MACHINE_INFO.ring_data_bump
    return

# M10 B2: scalar status dissolves BRK_LINE_COMMIT_OVERFLOW (decision 592).
# Returns 0 = Ok, 1 = Overflow. A sum type would be an aggregate return
# (x8 pointer) that harness bl_call_key sites do not arm — keep it a
# register-sized value so callers can ignore x0.
pub fn __wrela_line_commit() -> u64:
    desc_bump = MACHINE_INFO.ring_desc_bump
    if desc_bump >= QUEUE_SIZE:
        return 1
    line_start = MACHINE_INFO.line_start
    data_bump = MACHINE_INFO.ring_data_bump
    len = data_bump -% line_start
    data_addr = CONSOLE_DATA_BASE.to[u64]() +% line_start
    wi = (desc_bump *% 2).to[usize]()
    CONSOLE_RING.desc_words[wi] = data_addr
    # flags/next = 0 occupies the high half of this word (little-endian).
    CONSOLE_RING.desc_words[(desc_bump *% 2 +% 1).to[usize]()] = len
    new_idx = desc_bump +% 1
    CONSOLE_RING.avail_flags_idx = (new_idx *% 65536).to[u32]()
    MACHINE_INFO.ring_desc_bump = new_idx
    CONSOLE_RING.doorbell = 1
    return 0

# M11 B: `__wrela_fmt_dec` — dumb digit render into OFF_TEST_LINE_BUF.
# Sole copy after M10 B5 deleted the hand-asm twin. Digit extract, reverse,
# and append copies are ordinary `@budget`-bounded sync loops over a packed
# `[u8; 21]` (decisions 740–742). Sync loops emit trip counters, not
# checkpoints (M11 item A / decision 721), so a back-edge cannot splice
# `__wrela_checkpoint_service` onto console formatting (M10 decision 597
# dissolved). Index bounds still emit `bl __wrela_abort_val`; the abort
# latch (M10 decision 591) keeps a second entry from recursing into print.

const LINE_BUF_SIZE: usize = 21

@layout(runtime, endian=little)
struct TestLineBuf:
    bytes: [u8; LINE_BUF_SIZE]

# MACHINE_INFO_BASE + OFF_TEST_LINE_BUF (0x40000000 + 0x218).
# After test_next @ 0x210 — CORE_SLOTS marks at 0x68 pack through 0x168
# and must not overlap this scratch (plans/M15.md item F layout fix).
@placed(0x40000218)
static TEST_LINE_BUF: TestLineBuf

# ---------------------------------------------------------------------------
# Integrity Phase 2 Item I — Lane 1 scheduler counters.
# Method hits are indexed by the same flat `__method_N` order
# `__wrela_call_method` uses (sum of prior mailboxes' method_count + local mi).
# Dump is a deterministic transcript block.
# ---------------------------------------------------------------------------

# plans/lane1-per-core.md item A (decisions 1500–1502): ONE ROW PER CORE,
# summed at dump. Every update below used to be a non-atomic read-modify-write
# on one shared static, executed by whichever core drains
# (`__wrela_rt_run_one`, `__wrela_rt_select`, `__wrela_rt_enqueue`,
# `__wrela_lane1_record_method`). Since plans/M15.md item I deleted the baton,
# two cores draining different mailboxes run concurrently, so an increment
# COULD BE LOST — and ledger.toml:697 makes Lane 1 a cost-model frequency
# source, so a lost increment biases `sum f(fn) x s(fn)` toward "measuring
# less". A `@dmb` cannot fix it: a barrier orders visibility, not
# read-modify-write atomicity, and this language exposes no atomic add
# (decision 1500 rejects adding one to buy mutual exclusion this design does
# not need). The fix is ownership: each core writes only `cores[core]`, so
# there is no concurrent RMW left to make atomic, and `__wrela_lane1_dump`
# folds the rows in core order (decision 1502). Decision 1501 sizes the stripe
# by the generated `N_CORES`, not `CORE_SLOTS`, so a one-core image keeps
# exactly one row and its previous byte size.
#
# What the three scalars mean, since two of them are read as a cost-model
# frequency vector and one of them used to be a poll count
# (plans/lane1-per-core.md item C):
#   * `turns`     — one per message dequeued into a turn (`__wrela_rt_select`).
#   * `messages`  — one per message admitted to a mailbox (`__wrela_rt_enqueue`).
#   * `run_one_hits` — one unit of work *completed* per `__wrela_rt_run_one`
#     tick that did something: the **number of messages drained** (not the
#     number of drain calls — see `__wrela_rt_drain`), one per turn slice run,
#     one per group-child slice run. An unproductive poll counts nothing, and
#     that includes every spin of item B's quiesce loop, which is what keeps
#     the total independent of how the host happened to schedule the cores.
# Every one of those quantities is fixed by the program, not by an
# interleaving: measured 20/20 identical trailers on `ring-full`,
# `admission-order`, `two-senders`, `boot-cores-2` and `boot-cores-3` after
# items A+B (2026-07-29).
#
# One array per counter, indexed by core — not `[Lane1Counters; N_CORES]`.
# `lower.rs`'s `placed_array_field_index` resolves exactly **one** array-field
# index into a placed static, so `LANE1.cores[core].method_hits[flat]` does not
# lower at all ("an array length expression that is not a literal is not
# implemented yet") and the generic array path is not a placed-memory store.
# Transposing keeps every access single-level, and keeps the byte layout of a
# one-core image identical to the pre-stripe `Lane1Counters`
# (turns@0x0, run_one_hits@0x8, messages@0x10, method_hits@0x18).
const LANE1_METHOD_HITS_LEN: usize = N_CORES * METHOD_CALL_POOL_COUNT

@layout(runtime, endian=little)
struct Lane1Stripe:
    turns: [u64; N_CORES]
    run_one_hits: [u64; N_CORES]
    messages: [u64; N_CORES]
    method_hits: [u64; LANE1_METHOD_HITS_LEN]

# In the reserved device-page growth window (0x40008000..0x40010000);
# DRAM-mapped, zero at boot. Placed **above** the fixed-size LANE2 page on
# purpose: the stripe is `N_CORES` rows wide, so its extent is image-dependent,
# and growing it must not walk into LANE2 — whose base the host pins as a
# constant in `crates/wrela-vmm/src/lane3.rs`. `collect_placed_statics`'s
# device-window verifier refuses an image whose rows would leave the window,
# rather than letting a row overwrite the next static.
#
# plans/M20.md item B / decision 1607 moved this base up from 0x4000b000:
# BLOCK_POOL_COUNT grew 1024 -> 3072, so LANE2 (8 + 8*3072 = 24584 bytes at
# 0x40008800) now ends at 0x4000e808 and the stripe has to start above that.
# The cost is stated in rtconfig.rs's BLOCK_POOL_COUNT comment: the window's
# remaining 5888 bytes hold N_CORES <= 5 rows, where 0x4000b000 held 19.
@placed(0x4000e900)
static LANE1: Lane1Stripe

# Flat method index matching `__wrela_call_method`'s `__method_N` numbering.
pub fn __wrela_lane1_method_flat(root: usize, method: usize) -> usize:
    flat: usize = 0
    r: usize = 0
    @budget(bound=32)
    while r < root:
        if r < N_MAILBOXES:
            flat = flat +% __wrela_mb_method_count(r)
        r = r +% 1
    return flat +% method

# `core` is the core running this turn — threaded from `__wrela_rt_select`,
# never re-derived here (decision 1500: the writer owns its row). Out of range
# is impossible by construction; fail closed loudly rather than default to row
# 0, which would reintroduce the shared read-modify-write.
pub fn __wrela_lane1_record_method(core: usize, root: usize, method: usize):
    if core >= N_CORES:
        MACHINE_INFO.test_failed = MACHINE_INFO.test_failed +% 1
        return
    flat = __wrela_lane1_method_flat(root, method)
    if flat >= METHOD_CALL_POOL_COUNT:
        return
    hi = core *% METHOD_CALL_POOL_COUNT +% flat
    LANE1.method_hits[hi] = LANE1.method_hits[hi] +% 1
    return

pub fn __wrela_lane1_append_u64(value: u64) -> u64:
    digs = __wrela_fmt_dec(value, 0)
    return __wrela_console_append_line_buf(digs.to[usize]())

# Fold the per-core rows, in core order (decision 1502). The emitted text keeps
# its shape — what changed is where a count comes from, not what it means — so
# a single-core image dumps exactly the bytes it dumped before item A.
pub fn __wrela_lane1_sum_turns() -> u64:
    total: u64 = 0
    c: usize = 0
    @budget(bound=CORE_SLOTS)
    while c < N_CORES:
        total = total +% LANE1.turns[c]
        c = c +% 1
    return total

pub fn __wrela_lane1_sum_run_one() -> u64:
    total: u64 = 0
    c: usize = 0
    @budget(bound=CORE_SLOTS)
    while c < N_CORES:
        total = total +% LANE1.run_one_hits[c]
        c = c +% 1
    return total

pub fn __wrela_lane1_sum_messages() -> u64:
    total: u64 = 0
    c: usize = 0
    @budget(bound=CORE_SLOTS)
    while c < N_CORES:
        total = total +% LANE1.messages[c]
        c = c +% 1
    return total

pub fn __wrela_lane1_sum_method_hits(flat: usize) -> u64:
    total: u64 = 0
    c: usize = 0
    @budget(bound=CORE_SLOTS)
    while c < N_CORES:
        total = total +% LANE1.method_hits[c *% METHOD_CALL_POOL_COUNT +% flat]
        c = c +% 1
    return total

# Compact Lane 1 block (two console lines, after the summary):
#   lane1 turns=<t> run_one=<r> messages=<m>
#   lane1 hits=<flat>:<count>,...   (non-zero only, ascending flat)
pub fn __wrela_lane1_dump():
    __wrela_line_begin()
    # "lane1 turns="
    TEST_LINE_BUF.bytes[0] = 108
    TEST_LINE_BUF.bytes[1] = 97
    TEST_LINE_BUF.bytes[2] = 110
    TEST_LINE_BUF.bytes[3] = 101
    TEST_LINE_BUF.bytes[4] = 49
    TEST_LINE_BUF.bytes[5] = 32
    TEST_LINE_BUF.bytes[6] = 116
    TEST_LINE_BUF.bytes[7] = 117
    TEST_LINE_BUF.bytes[8] = 114
    TEST_LINE_BUF.bytes[9] = 110
    TEST_LINE_BUF.bytes[10] = 115
    TEST_LINE_BUF.bytes[11] = 61
    _ = __wrela_console_append_line_buf(12)
    _ = __wrela_lane1_append_u64(__wrela_lane1_sum_turns())
    # " run_one="
    TEST_LINE_BUF.bytes[0] = 32
    TEST_LINE_BUF.bytes[1] = 114
    TEST_LINE_BUF.bytes[2] = 117
    TEST_LINE_BUF.bytes[3] = 110
    TEST_LINE_BUF.bytes[4] = 95
    TEST_LINE_BUF.bytes[5] = 111
    TEST_LINE_BUF.bytes[6] = 110
    TEST_LINE_BUF.bytes[7] = 101
    TEST_LINE_BUF.bytes[8] = 61
    _ = __wrela_console_append_line_buf(9)
    _ = __wrela_lane1_append_u64(__wrela_lane1_sum_run_one())
    # " messages="
    TEST_LINE_BUF.bytes[0] = 32
    TEST_LINE_BUF.bytes[1] = 109
    TEST_LINE_BUF.bytes[2] = 101
    TEST_LINE_BUF.bytes[3] = 115
    TEST_LINE_BUF.bytes[4] = 115
    TEST_LINE_BUF.bytes[5] = 97
    TEST_LINE_BUF.bytes[6] = 103
    TEST_LINE_BUF.bytes[7] = 101
    TEST_LINE_BUF.bytes[8] = 115
    TEST_LINE_BUF.bytes[9] = 61
    _ = __wrela_console_append_line_buf(10)
    _ = __wrela_lane1_append_u64(__wrela_lane1_sum_messages())
    TEST_LINE_BUF.bytes[0] = 10
    _ = __wrela_console_append_line_buf(1)
    _ = __wrela_line_commit()
    # hits line
    __wrela_line_begin()
    TEST_LINE_BUF.bytes[0] = 108
    TEST_LINE_BUF.bytes[1] = 97
    TEST_LINE_BUF.bytes[2] = 110
    TEST_LINE_BUF.bytes[3] = 101
    TEST_LINE_BUF.bytes[4] = 49
    TEST_LINE_BUF.bytes[5] = 32
    TEST_LINE_BUF.bytes[6] = 104
    TEST_LINE_BUF.bytes[7] = 105
    TEST_LINE_BUF.bytes[8] = 116
    TEST_LINE_BUF.bytes[9] = 115
    TEST_LINE_BUF.bytes[10] = 61
    _ = __wrela_console_append_line_buf(11)
    first: u64 = 1
    root: usize = 0
    @budget(bound=32)
    while root < N_MAILBOXES:
        n = __wrela_mb_method_count(root)
        mi: usize = 0
        @budget(bound=128)
        while mi < n:
            flat = __wrela_lane1_method_flat(root, mi)
            if flat < METHOD_CALL_POOL_COUNT:
                c = __wrela_lane1_sum_method_hits(flat)
                if c != 0:
                    if first == 0:
                        TEST_LINE_BUF.bytes[0] = 44
                        _ = __wrela_console_append_line_buf(1)
                    first = 0
                    _ = __wrela_lane1_append_u64(flat.to[u64]())
                    TEST_LINE_BUF.bytes[0] = 58
                    _ = __wrela_console_append_line_buf(1)
                    _ = __wrela_lane1_append_u64(c)
            mi = mi +% 1
        root = root +% 1
    TEST_LINE_BUF.bytes[0] = 10
    _ = __wrela_console_append_line_buf(1)
    _ = __wrela_line_commit()
    return

# ---------------------------------------------------------------------------
# Integrity Phase 2 Item M — Lane 2 in-guest block counters.
# Placed after LANE1 in the device-page growth window. Hits are indexed by
# stable codegen-assigned leader ids (BTreeMap fn order × leaders-in-order).
# Dump is a no-op unless `--block-count` emission set `enabled`.
# ---------------------------------------------------------------------------

@layout(runtime, endian=little)
struct Lane2Counters:
    enabled: u64
    hits: [u64; BLOCK_POOL_COUNT]

@placed(0x40008800)
static LANE2: Lane2Counters

pub fn __wrela_block_hit(id: usize):
    # enabled: 0 = off (no emission this boot yet), 1 = counting,
    # 2 = frozen after `__wrela_lane2_dump` (Item N: dump must match the
    # host DRAM snapshot at halt; refuse post-dump increments).
    if LANE2.enabled == 2:
        return
    if id >= BLOCK_POOL_COUNT:
        return
    LANE2.enabled = 1
    LANE2.hits[id] = LANE2.hits[id] +% 1
    return

# Compact Lane 2 block (one console line after Lane 1, when enabled):
#   lane2 hits=<id>:<count>,... truncated=<N>   (non-zero only, ascending id)
#
# plans/M20.md item C / decision 1610: this line is a **bounded, explicitly
# truncating diagnostic**, not Lane 2's normative sink. At most
# BLOCK_BOUND_PRINT_PAIRS pairs are printed; `truncated=<N>` then names how
# many non-zero blocks were dropped, so a dropped pair is loud and never
# silent. The marker prints unconditionally (N=0 when nothing was dropped) so
# that its absence identifies a pre-1610 transcript rather than a complete
# one. Real boots do truncate: measured non-zero blocks are 372 (boot-actors)
# to 609 (boot-cross-core-mailbox-depth) against 128 printable pairs, and
# console::DATA_SIZE (16 KiB) cannot bound 609 pairs at any honest per-pair
# worst case. The **full** f vector comes from the host DRAM snapshot
# (`wrela-vmm --dump-lane2`), which has no console bound; 04 §5 names the
# snapshot as Lane 2's normative sink and this line as the diagnostic, and
# Lane 3 agreement compares the snapshot against the pairs this line
# actually carries.
pub fn __wrela_lane2_dump():
    if LANE2.enabled == 0:
        return
    # Freeze before printing so post-dump app code cannot move the vector
    # under the dump / Lane 3 host DRAM agreement (Integrity Item N).
    LANE2.enabled = 2
    __wrela_line_begin()
    # "lane2 hits="
    TEST_LINE_BUF.bytes[0] = 108
    TEST_LINE_BUF.bytes[1] = 97
    TEST_LINE_BUF.bytes[2] = 110
    TEST_LINE_BUF.bytes[3] = 101
    TEST_LINE_BUF.bytes[4] = 50
    TEST_LINE_BUF.bytes[5] = 32
    TEST_LINE_BUF.bytes[6] = 104
    TEST_LINE_BUF.bytes[7] = 105
    TEST_LINE_BUF.bytes[8] = 116
    TEST_LINE_BUF.bytes[9] = 115
    TEST_LINE_BUF.bytes[10] = 61
    _ = __wrela_console_append_line_buf(11)
    first: u64 = 1
    i: usize = 0
    printed: usize = 0
    dropped: u64 = 0
    # plans/M20.md item B: BLOCK_POOL_COUNT is 3072.
    @budget(bound=4096)
    while i < BLOCK_POOL_COUNT:
        c = LANE2.hits[i]
        if c != 0:
            if printed < BLOCK_BOUND_PRINT_PAIRS:
                if first == 0:
                    TEST_LINE_BUF.bytes[0] = 44
                    _ = __wrela_console_append_line_buf(1)
                first = 0
                _ = __wrela_lane1_append_u64(i.to[u64]())
                TEST_LINE_BUF.bytes[0] = 58
                _ = __wrela_console_append_line_buf(1)
                _ = __wrela_lane1_append_u64(c)
                printed = printed +% 1
            else:
                dropped = dropped +% 1
        i = i +% 1
    # " truncated=" — always printed, N=0 when nothing was dropped.
    TEST_LINE_BUF.bytes[0] = 32
    TEST_LINE_BUF.bytes[1] = 116
    TEST_LINE_BUF.bytes[2] = 114
    TEST_LINE_BUF.bytes[3] = 117
    TEST_LINE_BUF.bytes[4] = 110
    TEST_LINE_BUF.bytes[5] = 99
    TEST_LINE_BUF.bytes[6] = 97
    TEST_LINE_BUF.bytes[7] = 116
    TEST_LINE_BUF.bytes[8] = 101
    TEST_LINE_BUF.bytes[9] = 100
    TEST_LINE_BUF.bytes[10] = 61
    _ = __wrela_console_append_line_buf(11)
    _ = __wrela_lane1_append_u64(dropped)
    TEST_LINE_BUF.bytes[0] = 10
    _ = __wrela_console_append_line_buf(1)
    _ = __wrela_line_commit()
    return

fn ascii_digit(d: u64) -> u8:
    if d == 0:
        return 48
    if d == 1:
        return 49
    if d == 2:
        return 50
    if d == 3:
        return 51
    if d == 4:
        return 52
    if d == 5:
        return 53
    if d == 6:
        return 54
    if d == 7:
        return 55
    if d == 8:
        return 56
    if d == 9:
        return 57
    return 48

# ABI: x0=value bits, x1=is_signed (nonzero => signed), x0=len. Magnitude
# via wrapping negation (decision 652); never checked. Not Format (598).
pub fn __wrela_fmt_dec(value: u64, is_signed: u64) -> u64:
    mag = value
    neg = false
    if is_signed != 0:
        # MSB set <=> negative as i64. Use `>> 63` (LSR) — ordered
        # compare is always signed in this backend and is wrong for the
        # upper half of u64 (codegen Compare invariant).
        if (value >> 63) != 0:
            neg = true
            mag = 0 -% value
    pos: usize = 0
    if neg:
        TEST_LINE_BUF.bytes[0] = 45
        pos = 1
    digits_start = pos
    if mag == 0:
        TEST_LINE_BUF.bytes[pos] = 48
        return (pos +% 1).to[u64]()
    # u64 has at most 20 decimal digits.
    @budget(bound=20)
    while mag != 0:
        TEST_LINE_BUF.bytes[pos] = ascii_digit(mag % 10)
        mag = mag / 10
        pos = pos +% 1
    lo = digits_start
    hi = pos -% 1
    # At most 10 swaps for 20 digits.
    @budget(bound=10)
    while lo < hi:
        t = TEST_LINE_BUF.bytes[lo]
        TEST_LINE_BUF.bytes[lo] = TEST_LINE_BUF.bytes[hi]
        TEST_LINE_BUF.bytes[hi] = t
        lo = lo +% 1
        hi = hi -% 1
    return pos.to[u64]()

# M11 B: linear copy under a trip-counter bound (decision 741). Callers
# have already status-returned on ring overflow, so `n ≤ LINE_BUF_SIZE`
# / `n ≤ DATA_SIZE` on the green path; a bounds fail still hits the
# abort latch (decision 742).
fn copy_line_buf_range(bump: usize, n: usize):
    i: usize = 0
    @budget(bound=21)
    while i < n:
        CONSOLE_DATA.bytes[bump +% i] = TEST_LINE_BUF.bytes[i]
        i = i +% 1
    return

fn copy_bytes_range(src: Bytes, bump: usize, n: usize):
    i: usize = 0
    @budget(bound=16384)
    while i < n:
        CONSOLE_DATA.bytes[bump +% i] = src[i]
        i = i +% 1
    return

# plans/M17.md item H: guest-importable u64 → one console transcript line
# (`"<decimal>\n"`). Self-contained (no calls to other fns) so an importer
# that pulls only this name does not hit the "private helper not imported"
# wall. Digit / append / commit logic mirrors `__wrela_fmt_dec` +
# append_line_buf + line_commit — keep in lockstep if those change.
pub fn __wrela_trace_u64(value: u64):
    mag = value
    pos: usize = 0
    if mag == 0:
        TEST_LINE_BUF.bytes[0] = 48
        pos = 1
    else:
        @budget(bound=20)
        while mag != 0:
            d = mag % 10
            TEST_LINE_BUF.bytes[pos] = (48 +% d).to[u8]()
            mag = mag / 10
            pos = pos +% 1
        lo: usize = 0
        hi = pos -% 1
        @budget(bound=10)
        while lo < hi:
            t = TEST_LINE_BUF.bytes[lo]
            TEST_LINE_BUF.bytes[lo] = TEST_LINE_BUF.bytes[hi]
            TEST_LINE_BUF.bytes[hi] = t
            lo = lo +% 1
            hi = hi -% 1
    # Trailing newline so the test harness's next "ok" starts a fresh line.
    TEST_LINE_BUF.bytes[pos] = 10
    pos = pos +% 1
    # line_begin
    MACHINE_INFO.line_start = MACHINE_INFO.ring_data_bump
    bump: usize = MACHINE_INFO.ring_data_bump.to[usize]()
    end: usize = bump +% pos
    if end < bump:
        return
    if end > DATA_SIZE:
        return
    i: usize = 0
    @budget(bound=21)
    while i < pos:
        CONSOLE_DATA.bytes[bump +% i] = TEST_LINE_BUF.bytes[i]
        i = i +% 1
    MACHINE_INFO.ring_data_bump = end.to[u64]()
    # line_commit
    desc_bump = MACHINE_INFO.ring_desc_bump
    if desc_bump >= QUEUE_SIZE:
        return
    line_start = MACHINE_INFO.line_start
    data_bump = MACHINE_INFO.ring_data_bump
    len = data_bump -% line_start
    data_addr = CONSOLE_DATA_BASE.to[u64]() +% line_start
    wi = (desc_bump *% 2).to[usize]()
    CONSOLE_RING.desc_words[wi] = data_addr
    CONSOLE_RING.desc_words[(desc_bump *% 2 +% 1).to[usize]()] = len
    new_idx = desc_bump +% 1
    CONSOLE_RING.avail_flags_idx = (new_idx *% 65536).to[u32]()
    MACHINE_INFO.ring_desc_bump = new_idx
    CONSOLE_RING.doorbell = 1
    return

# M10 B4: append from OFF_TEST_LINE_BUF. No pointer — the buffer address
# is a placed-static fact. Returns 0 on success, 1 on overflow
# (decision 592: status, not BRK / abort).
pub fn __wrela_console_append_line_buf(len: usize) -> u64:
    # Layout field is u64 (decision 563); index wants usize. Same width
    # on this machine — `.to` abort is unreachable for a bump that
    # passed the ring-capacity check below (decision 591).
    bump: usize = MACHINE_INFO.ring_data_bump.to[usize]()
    end: usize = bump +% len
    if end < bump:
        return 1
    if end > DATA_SIZE:
        return 1
    copy_line_buf_range(bump, len)
    MACHINE_INFO.ring_data_bump = end.to[u64]()
    return 0

# M10 B4: append `len` packed bytes from an unbounded Bytes handle
# (base, capacity). `len` must be ≤ handle capacity; longer / ring
# overflow returns 1 (decision 592).
pub fn __wrela_console_append_bytes(src: Bytes, len: usize) -> u64:
    bump: usize = MACHINE_INFO.ring_data_bump.to[usize]()
    if len > src.len:
        return 1
    end: usize = bump +% len
    if end < bump:
        return 1
    if end > DATA_SIZE:
        return 1
    copy_bytes_range(src, bump, len)
    MACHINE_INFO.ring_data_bump = end.to[u64]()
    return 0

# M10 C: floor category 4 long-jump (decision 650). Body is overwritten
# by layout with hand-asm `LDR`+`BR` against OFF_TEST_CONTINUATION — the
# `return` here is only so the call graph type-checks; it must never
# remain in a test image.
fn __wrela_abort_tail():
    return

# Shared landing-pad bookkeeping (decision 591): clear latch, count a
# fail, then the computed long-jump. Both first-entry and re-entry end
# here so a bounds failure inside the print path cannot recurse.
fn finish_abort():
    MACHINE_INFO.abort_latch = 0
    MACHINE_INFO.test_failed = MACHINE_INFO.test_failed +% 1
    __wrela_abort_tail()
    return

# "FAILED " via line-buf stores — Static[Bytes[N]] still cannot coerce
# to an unbounded Bytes parameter (decision 595), and abort must not
# depend on harness-interned rodata.
fn append_failed_literal() -> u64:
    TEST_LINE_BUF.bytes[0] = 70
    TEST_LINE_BUF.bytes[1] = 65
    TEST_LINE_BUF.bytes[2] = 73
    TEST_LINE_BUF.bytes[3] = 76
    TEST_LINE_BUF.bytes[4] = 69
    TEST_LINE_BUF.bytes[5] = 68
    TEST_LINE_BUF.bytes[6] = 32
    return __wrela_console_append_line_buf(7)

fn append_newline_literal() -> u64:
    TEST_LINE_BUF.bytes[0] = 10
    return __wrela_console_append_line_buf(1)

# M10 C: `__wrela_abort(msg: Bytes)` — Bytes is by-pointer (one ABI rule
# with every other non-scalar); Reloc::AbortFixed callers pass `x0 =`
# address of a stack `(base, len)` slot (capacity equals length).
# Re-entrancy latch at OFF_ABORT_LATCH (decision 591); overflow from
# append/commit is status (decision 592); wrapping arith (decision 652);
# console helpers use `@budget`-bounded sync loops (M11 decisions 740–742).
pub fn __wrela_abort(msg: Bytes):
    if MACHINE_INFO.abort_latch != 0:
        finish_abort()
        return
    MACHINE_INFO.abort_latch = 1
    _ = append_failed_literal()
    _ = __wrela_console_append_bytes(msg, msg.len)
    _ = append_newline_literal()
    _ = __wrela_line_commit()
    finish_abort()

# M10 C: `__wrela_abort_val` — by-pointer Bytes for prefix/suffix plus
# value / value_signed scalars (`x0=*prefix, x1=value, x2=signed,
# x3=*suffix`), matching Reloc::AbortVal callers.
pub fn __wrela_abort_val(prefix: Bytes, value: u64, value_signed: u64, suffix: Bytes):
    if MACHINE_INFO.abort_latch != 0:
        finish_abort()
        return
    MACHINE_INFO.abort_latch = 1
    _ = append_failed_literal()
    _ = __wrela_console_append_bytes(prefix, prefix.len)
    digs = __wrela_fmt_dec(value, value_signed)
    _ = __wrela_console_append_line_buf(digs.to[usize]())
    _ = __wrela_console_append_bytes(suffix, suffix.len)
    _ = append_newline_literal()
    _ = __wrela_line_commit()
    finish_abort()

# ---------------------------------------------------------------------------
# M11 item E: deadline poll + scan (decisions 782–783). Generic @budget
# loops over RT.turns / GROUPS.slots; force-rooted into `code`. The old
# ImageStatic emitters (`emit_deadline_poll` / `emit_deadline_scan_and_
# delivery`) are deleted — checkpoint vector0 and the entry driver BL here.
# ---------------------------------------------------------------------------

# Minimum live deadline → MACHINE_INFO.next_deadline; if already due, raise
# pending bits on every live core (N_CORES — decision 709).
pub fn __wrela_deadline_poll():
    min_dl: u64 = 0
    i: usize = 0
    @budget(bound=256)
    while i < GROUP_ARENA_CAPACITY:
        if GROUPS.slots[i].in_use != 0:
            if GROUPS.slots[i].cancelled == 0:
                dl = GROUPS.slots[i].deadline_ns
                if dl != 0:
                    if min_dl == 0:
                        min_dl = dl
                    else:
                        if dl < min_dl:
                            min_dl = dl
        i = i +% 1
    MACHINE_INFO.next_deadline = min_dl
    if min_dl != 0:
        if CLOCK.now_ns >= min_dl:
            c: usize = 0
            @budget(bound=64)
            while c < N_CORES:
                PENDING.words[c] = 1
                c = c +% 1
    return

# Vector-0 body: mark expired groups cancelled, then force-resume parked
# non-owner turns whose ambient group was just cancelled.
pub fn __wrela_deadline_scan():
    now = CLOCK.now_ns
    i: usize = 0
    @budget(bound=256)
    while i < GROUP_ARENA_CAPACITY:
        if GROUPS.slots[i].in_use != 0:
            if GROUPS.slots[i].cancelled == 0:
                dl = GROUPS.slots[i].deadline_ns
                if dl != 0:
                    if now >= dl:
                        GROUPS.slots[i].cancelled = 1
        i = i +% 1
    t: usize = 0
    @budget(bound=256)
    while t < N_TURNS:
        if RT.turns[t].busy != 0:
            if RT.turns[t].suspended != 0:
                ag = RT.turns[t].ambient_group
                if ag != 0:
                    gi: usize = (ag -% 1).to[usize]()
                    if GROUPS.slots[gi].cancelled != 0:
                        tid: u32 = (t +% 1).to[u32]()
                        if GROUPS.slots[gi].owner_turn != tid:
                            RT.turns[t].resume_ready = 1
        t = t +% 1
    return

# ---------------------------------------------------------------------------
# M11 item F: rt_run_one + rt_child_poll (decisions 790–794). Generic
# @budget loops over RT.sched / generated select+child ladders. Call sites
# BL `__wrela_rt_run_one(core)`; child harvest reads `TurnArea.reply`
# (async epilogue stores the completing scalar there — decision 793).
# ---------------------------------------------------------------------------

const TURN_STATUS_COMPLETED: u64 = 0
const TURN_STATUS_SUSPENDED: u64 = 1
const TURN_STATUS_CANCELLED: u64 = 2

# Per-core scheduler tick. ABI: x0 = core on entry; returns 1 if work ran.
# `core` indexes `SCHED.cores` and every `LANE1` counter array, all `N_CORES`
# wide, so an
# out-of-range core aborts on the index rather than defaulting to row 0.
pub fn __wrela_rt_run_one(core: usize) -> u64:
    drained = __wrela_try_drain(core)
    if drained != 0:
        # Add the message count, not 1: one drain call empties the ring, so
        # counting calls makes this tick count depend on how the producer's
        # publishes happened to interleave with this consumer's polls (see
        # `__wrela_rt_drain`). Counting messages is interleaving-invariant.
        LANE1.run_one_hits[core] = LANE1.run_one_hits[core] +% drained
        return 1
    n = __wrela_select_count(core)
    rr_pass: usize = 0
    @budget(bound=2)
    while rr_pass < 2:
        i: usize = 0
        @budget(bound=256)
        while i < n:
            cursor = SCHED.cores[core].rr_cursor.to[usize]()
            should_try = 0
            if rr_pass == 0:
                if cursor <= i:
                    should_try = 1
            else:
                if cursor > i:
                    should_try = 1
            if should_try != 0:
                ran = __wrela_try_select(core, i)
                if ran != 0:
                    nxt = i +% 1
                    if nxt >= n:
                        nxt = 0
                    SCHED.cores[core].rr_cursor = nxt.to[u64]()
                    LANE1.run_one_hits[core] = LANE1.run_one_hits[core] +% 1
                    return 1
            i = i +% 1
        rr_pass = rr_pass +% 1
    if core == 0:
        s: usize = 0
        @budget(bound=256)
        while s < N_CHILD_SITES:
            if __wrela_child_poll(s) != 0:
                LANE1.run_one_hits[core] = LANE1.run_one_hits[core] +% 1
                return 1
            s = s +% 1
    return 0

# Poll one static g.start site. Returns 1 if a slice ran / completed.
pub fn __wrela_child_poll(site: usize) -> u64:
    ti = __wrela_child_turn_index(site)
    if RT.turns[ti].busy == 0:
        return 0
    if RT.turns[ti].suspended == 0:
        return 0
    if RT.turns[ti].resume_ready == 0:
        return 0
    status = __wrela_resume_child(site)
    if status == TURN_STATUS_SUSPENDED:
        return 1
    payload = RT.turns[ti].reply
    tag: u64 = 0
    if status == TURN_STATUS_CANCELLED:
        tag = 1
    ag = RT.turns[ti].ambient_group
    gi: usize = (ag -% 1).to[usize]()
    slot = __wrela_child_slot(site)
    # plans/M12.md item F: fail closed above the image GROUP_MAX_CHILDREN fact
    # (store ladder covers 0..N-1 and also returns 0 for slot >= N).
    if slot >= GROUP_MAX_CHILDREN:
        return 0
    if __wrela_child_store_result(gi, slot, tag, payload) == 0:
        return 0
    active = GROUPS.slots[gi].active_children -% 1
    GROUPS.slots[gi].active_children = active
    RT.turns[ti].busy = 0
    if active == 0:
        waiter = GROUPS.slots[gi].join_waiter
        if waiter != 0:
            wi: usize = (waiter.to[u64]() -% 1).to[usize]()
            RT.turns[wi].resume_ready = 1
    return 1

# ---------------------------------------------------------------------------
# M11 item G: rt_xsend / rt_xreply / rt_drain (decisions 800–805). Generic
# @budget algorithms over ring accessors + handle-identity ladders. Call
# sites BL fixed trampolines `__wrela_xsend_N` / `__wrela_xreply_N`; run_one
# drains via `__wrela_try_drain` → `__wrela_rt_drain`. Helpers are inlined
# so force-root reachability does not need a second closure pass.
# ---------------------------------------------------------------------------

# Cross-core request publish. ABI matches former emit_rt_xsend / rt_enqueue.
# M12 item C: index RINGS_CTL / RINGS_DATA directly (data ladders deleted).
pub fn __wrela_rt_xsend(edge: usize, method: u64, arg0: u64, arg1: u64, waker_turn: u64, waker_core: u64) -> u64:
    if edge >= N_RINGS:
        return 1
    if edge == NO_EDGE:
        return 1
    cap = __wrela_ring_capacity(edge)
    count = RINGS_CTL.edges[edge].count
    if count >= cap:
        return 1
    src = __wrela_ring_src_core(edge)
    wc = waker_core
    if waker_turn != 0:
        wc = (src +% 1).to[u64]()
    slot_words = __wrela_ring_slot_words(edge)
    tail = RINGS_CTL.edges[edge].tail
    base = (tail *% slot_words.to[u64]()).to[usize]()
    row = edge *% RING_STRIDE_WORDS
    RINGS_DATA.words[row +% base] = method
    packed = waker_turn | (wc << 32)
    RINGS_DATA.words[row +% base +% 1] = packed
    if slot_words >= 3:
        RINGS_DATA.words[row +% base +% 2] = arg0
    if slot_words >= 4:
        RINGS_DATA.words[row +% base +% 3] = arg1
    t = tail +% 1
    if t >= cap:
        t = 0
    RINGS_CTL.edges[edge].tail = t
    RINGS_CTL.edges[edge].count = count +% 1
    # plans/M15.md item H: publish barrier before pending raise.
    @dmb(ishst)
    dst = __wrela_ring_dst_core(edge)
    PENDING.words[dst] = PENDING.words[dst] | 1
    return 0

# Cross-core reply publish. Leaf ABI: x0=turn_and_tag, x1=reply.
pub fn __wrela_rt_xreply(edge: usize, turn_and_tag: u64, reply: u64):
    if edge >= N_RINGS:
        return
    if edge == NO_EDGE:
        return
    cap = __wrela_ring_capacity(edge)
    count = RINGS_CTL.edges[edge].count
    if count >= cap:
        # Unreachable by construction (reply_ring_capacity); fail closed.
        MACHINE_INFO.test_failed = MACHINE_INFO.test_failed +% 1
        return
    # Reply slots are always 2 u64 words (decision 665).
    tail = RINGS_CTL.edges[edge].tail
    base = (tail *% 2).to[usize]()
    row = edge *% RING_STRIDE_WORDS
    RINGS_DATA.words[row +% base] = turn_and_tag
    RINGS_DATA.words[row +% base +% 1] = reply
    t = tail +% 1
    if t >= cap:
        t = 0
    RINGS_CTL.edges[edge].tail = t
    RINGS_CTL.edges[edge].count = count +% 1
    # plans/M15.md item H: publish barrier before pending raise.
    @dmb(ishst)
    dst = __wrela_ring_dst_core(edge)
    PENDING.words[dst] = PENDING.words[dst] | 1
    return

# Inbound drain for one core: reply lanes first, then request → enqueue.
# M13 item N: secondary wake-doorbell clear also lives in
# `__wrela_rt_checkpoint(core)` (loop-head BL). Dual-clear kept here —
# level-triggered, idempotent — so a park-vs-loop-head reorder or a raise
# whose consumer never runs (e.g. ring-full reject) cannot strand the word
# for the VMM baton (plans/M13.md risk note).
# Returns the **number of messages drained**, not a 0/1 flag. Callers only
# ever test it against zero, but the count is what makes `LANE1.run_one_hits`
# deterministic: this fn drains a ring to empty in one call, so a flag would
# make "one tick" mean one message when a producer publishes slowly and two
# when it publishes in a burst. That difference is pure host interleaving
# under concurrent record (plans/M15.md item I), and it is what made
# `golden/boot-cross-core-admission-order` flake by exactly one between
# runs (12 vs 13, ~1 run in 4). Messages drained is batching-invariant:
# however the publishes interleave, the total is the same (adversarial
# audit, 2026-07-29).
#
# It did **not**, on its own, fix `golden/boot-cross-core-ring-full`, whose
# Lane 1 trailer varied in every field (`turns` 0/1, `run_one` 0/1/2,
# `messages` 0/1, `hits` empty or `0:1`) — that case is racy for a different
# and deeper reason: it asserts a *rejection*, so it deliberately halts with
# one admitted-but-unprocessed message outstanding, and whether core 1 had
# drained and run that turn before core 0 reached
# `__wrela_rt_summary_and_halt` was pure host timing. No counter definition
# can settle that. plans/lane1-per-core.md item B did, with the
# quiesce-before-halt step this note asked for
# (`__wrela_quiesce_before_halt`); the case pins its trailer again, and
# `xtask repro`'s `repro_lane1_trailer_repeats` re-boots it on every check.
pub fn __wrela_rt_drain(core: usize) -> u64:
    moved: u64 = 0
    if core != 0:
        PENDING.words[core] = 0
    n_rep = __wrela_drain_reply_count(core)
    ri: usize = 0
    @budget(bound=RING_POOL_COUNT)
    while ri < n_rep:
        edge = __wrela_drain_reply_edge(core, ri)
        @budget(bound=256)
        while RINGS_CTL.edges[edge].count != 0:
            # plans/M15.md item H: acquire barrier before payload loads.
            @dmb(ishld)
            head = RINGS_CTL.edges[edge].head
            base = (head *% 2).to[usize]()
            row = edge *% RING_STRIDE_WORDS
            turn_and_tag = RINGS_DATA.words[row +% base]
            reply = RINGS_DATA.words[row +% base +% 1]
            tag = turn_and_tag >> 32
            tid = turn_and_tag & 4294967295
            ti: usize = (tid -% 1).to[usize]()
            RT.turns[ti].reply_tag = tag
            RT.turns[ti].reply = reply
            RT.turns[ti].resume_ready = 1
            h = head +% 1
            cap = __wrela_ring_capacity(edge)
            if h >= cap:
                h = 0
            RINGS_CTL.edges[edge].head = h
            c = RINGS_CTL.edges[edge].count
            RINGS_CTL.edges[edge].count = c -% 1
            moved = moved +% 1
        ri = ri +% 1
    n_req = __wrela_drain_request_count(core)
    qi: usize = 0
    @budget(bound=RING_POOL_COUNT)
    while qi < n_req:
        edge = __wrela_drain_request_edge(core, qi)
        @budget(bound=256)
        while RINGS_CTL.edges[edge].count != 0:
            # plans/M15.md item H: acquire barrier before payload loads.
            @dmb(ishld)
            slot_words = __wrela_ring_slot_words(edge)
            head = RINGS_CTL.edges[edge].head
            base = (head *% slot_words.to[u64]()).to[usize]()
            row = edge *% RING_STRIDE_WORDS
            method = RINGS_DATA.words[row +% base]
            packed = RINGS_DATA.words[row +% base +% 1]
            wt = packed & 4294967295
            wc = packed >> 32
            arg0: u64 = 0
            arg1: u64 = 0
            if slot_words >= 3:
                arg0 = RINGS_DATA.words[row +% base +% 2]
            if slot_words >= 4:
                arg1 = RINGS_DATA.words[row +% base +% 3]
            handle = __wrela_ring_target_handle(edge)
            rejected = __wrela_try_enqueue(core, handle, method, arg0, arg1, wt, wc)
            if rejected != 0:
                # Mailbox full — leave the ring slot; try again next tick.
                return moved
            h = head +% 1
            cap = __wrela_ring_capacity(edge)
            if h >= cap:
                h = 0
            RINGS_CTL.edges[edge].head = h
            c = RINGS_CTL.edges[edge].count
            RINGS_CTL.edges[edge].count = c -% 1
            moved = moved +% 1
        qi = qi +% 1
    return moved

# run_one entry: skip the ImageStatic drain body (deleted — decision 805).
pub fn __wrela_try_drain(core: usize) -> u64:
    n = __wrela_drain_reply_count(core) +% __wrela_drain_request_count(core)
    if n == 0:
        return 0
    return __wrela_rt_drain(core)

# Fixed trampoline pools (decision 802): layout remaps `rt_xsend` /
# `rt_xreply` Call keys onto these; each bakes its edge index.
pub fn __wrela_xsend_0(method: u64, arg0: u64, arg1: u64, waker_turn: u64, waker_core: u64) -> u64:
    return __wrela_rt_xsend(0, method, arg0, arg1, waker_turn, waker_core)
pub fn __wrela_xsend_1(method: u64, arg0: u64, arg1: u64, waker_turn: u64, waker_core: u64) -> u64:
    return __wrela_rt_xsend(1, method, arg0, arg1, waker_turn, waker_core)
