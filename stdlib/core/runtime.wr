# plans/M10.md item A2d / B2 / B3 / B4 / C / D
# Always-loaded runtime module. Names are not auto-visible (decision 584);
# harness reaches helpers via force-rooted CalleeKeys + Asm::bl_call_key.
module runtime

# plans/M11.md item D / decision 765: import the generated facts module.
# Batch-1 loads strip this import (module text does not exist on disk);
# batch-2 re-sema with the generator's output. Unused until E–J migrate
# algorithms onto N_CORES / RT — keep the seam narrow.
from core.__image_runtime import N_CORES

# M10 B2: machine pages the console formatter speaks to (decision 593).
# Addresses match wrela-machine::layout / console — bytes live in the VMM's
# pages, not the image blob (decision 588).
# M10 B4: packed CONSOLE_DATA.bytes for append (decisions 594–596);
# OFF_TEST_LINE_BUF stays B3's TEST_LINE_BUF (named fields).
# M10 C: abort latch + fail counter (decision 591); long-jump is floor
# category 4 hand-asm (`__wrela_abort_tail`).

const QUEUE_SIZE: u64 = 256
const DESC_WORD_COUNT: usize = 512
const CONSOLE_DATA_BASE: u64 = 0x40003000
const DATA_SIZE: usize = 16384

@layout(runtime, endian=little)
struct MachineInfoPage:
    @offset(0x48) test_failed: u64
    @offset(0x50) ring_data_bump: u64
    @offset(0x58) ring_desc_bump: u64
    @offset(0x60) line_start: u64
    @offset(0x208) abort_latch: u64

@placed(0x40000000)
static MACHINE_INFO: MachineInfoPage

# Descriptor table as 512 u64 words (256 × 16-byte entries). Word 2i is
# desc.addr; word 2i+1 packs virtio len:u32 (low) + flags/next:u32 (high).
@layout(runtime, endian=little)
struct ConsoleRingPage:
    @offset(0x0) desc_words: [u64; DESC_WORD_COUNT]
    @offset(0x1000) avail_flags_idx: u32
    @offset(0x1a08) doorbell: u64

@placed(0x40001000)
static CONSOLE_RING: ConsoleRingPage

# Packed transcript bytes (decision 596). line_commit still materializes
# CONSOLE_DATA_BASE as a const; append indexes `.bytes` densely.
@layout(runtime, endian=little)
struct ConsoleDataPage:
    bytes: [u8; DATA_SIZE]

@placed(0x40003000)
static CONSOLE_DATA: ConsoleDataPage

# Force-root seed (A2d / decision 583). Per-actor mailbox admission
# (`rt_enqueue <Actor>`) is synthesized into CodegenProgram under
# specialized keys (item D / decisions 613–615) — not spelled here,
# because the key contains a space no wrela identifier may carry.
pub fn __wrela_runtime_probe():
    return

# M10 B2: snapshot OFF_RING_DATA_BUMP into OFF_LINE_START.
pub fn __wrela_line_begin():
    MACHINE_INFO.line_start = MACHINE_INFO.ring_data_bump
    return

# M10 B2: scalar status dissolves BRK_LINE_COMMIT_OVERFLOW (decision 592).
# Returns 0 = Ok, 1 = Overflow. A sum type would be an aggregate return
# (x8 pointer) that harness bl_call_key sites do not arm — keep it a
# register-sized value so callers can ignore x0.
pub fn __wrela_line_commit() -> u64:
    desc_bump = MACHINE_INFO.ring_desc_bump
    if desc_bump >= QUEUE_SIZE:
        return 1
    line_start = MACHINE_INFO.line_start
    data_bump = MACHINE_INFO.ring_data_bump
    len = data_bump -% line_start
    data_addr = CONSOLE_DATA_BASE +% line_start
    wi = (desc_bump *% 2).to[usize]()
    CONSOLE_RING.desc_words[wi] = data_addr
    # flags/next = 0 occupies the high half of this word (little-endian).
    CONSOLE_RING.desc_words[(desc_bump *% 2 +% 1).to[usize]()] = len
    new_idx = desc_bump +% 1
    CONSOLE_RING.avail_flags_idx = (new_idx *% 65536).to[u32]()
    MACHINE_INFO.ring_desc_bump = new_idx
    CONSOLE_RING.doorbell = 1
    return 0

# M10 B3: `__wrela_fmt_dec` — dumb digit render into OFF_TEST_LINE_BUF.
# Sole copy after B5 deleted the hand-asm twin. Digit extract and reverse
# are fully unrolled call sequences (decision 597): a `while` back-edge
# would splice `__wrela_checkpoint_service` onto console formatting.
# Named u8 fields avoid index bounds-check aborts; helpers keep the
# div/mod cold paths from being cloned twenty times.

@layout(runtime, endian=little)
struct TestLineBuf:
    @offset(0) b0: u8
    @offset(1) b1: u8
    @offset(2) b2: u8
    @offset(3) b3: u8
    @offset(4) b4: u8
    @offset(5) b5: u8
    @offset(6) b6: u8
    @offset(7) b7: u8
    @offset(8) b8: u8
    @offset(9) b9: u8
    @offset(10) b10: u8
    @offset(11) b11: u8
    @offset(12) b12: u8
    @offset(13) b13: u8
    @offset(14) b14: u8
    @offset(15) b15: u8
    @offset(16) b16: u8
    @offset(17) b17: u8
    @offset(18) b18: u8
    @offset(19) b19: u8
    @offset(20) b20: u8

# MACHINE_INFO_BASE + OFF_TEST_LINE_BUF (0x40000000 + 0x100).
@placed(0x40000100)
static TEST_LINE_BUF: TestLineBuf

fn ascii_digit(d: u64) -> u8:
    if d == 0:
        return 48
    if d == 1:
        return 49
    if d == 2:
        return 50
    if d == 3:
        return 51
    if d == 4:
        return 52
    if d == 5:
        return 53
    if d == 6:
        return 54
    if d == 7:
        return 55
    if d == 8:
        return 56
    if d == 9:
        return 57
    return 48

fn store_at(pos: usize, ch: u8):
    if pos == 0:
        TEST_LINE_BUF.b0 = ch
        return
    if pos == 1:
        TEST_LINE_BUF.b1 = ch
        return
    if pos == 2:
        TEST_LINE_BUF.b2 = ch
        return
    if pos == 3:
        TEST_LINE_BUF.b3 = ch
        return
    if pos == 4:
        TEST_LINE_BUF.b4 = ch
        return
    if pos == 5:
        TEST_LINE_BUF.b5 = ch
        return
    if pos == 6:
        TEST_LINE_BUF.b6 = ch
        return
    if pos == 7:
        TEST_LINE_BUF.b7 = ch
        return
    if pos == 8:
        TEST_LINE_BUF.b8 = ch
        return
    if pos == 9:
        TEST_LINE_BUF.b9 = ch
        return
    if pos == 10:
        TEST_LINE_BUF.b10 = ch
        return
    if pos == 11:
        TEST_LINE_BUF.b11 = ch
        return
    if pos == 12:
        TEST_LINE_BUF.b12 = ch
        return
    if pos == 13:
        TEST_LINE_BUF.b13 = ch
        return
    if pos == 14:
        TEST_LINE_BUF.b14 = ch
        return
    if pos == 15:
        TEST_LINE_BUF.b15 = ch
        return
    if pos == 16:
        TEST_LINE_BUF.b16 = ch
        return
    if pos == 17:
        TEST_LINE_BUF.b17 = ch
        return
    if pos == 18:
        TEST_LINE_BUF.b18 = ch
        return
    if pos == 19:
        TEST_LINE_BUF.b19 = ch
        return
    if pos == 20:
        TEST_LINE_BUF.b20 = ch
        return
    return

fn load_at(pos: usize) -> u8:
    if pos == 0:
        return TEST_LINE_BUF.b0
    if pos == 1:
        return TEST_LINE_BUF.b1
    if pos == 2:
        return TEST_LINE_BUF.b2
    if pos == 3:
        return TEST_LINE_BUF.b3
    if pos == 4:
        return TEST_LINE_BUF.b4
    if pos == 5:
        return TEST_LINE_BUF.b5
    if pos == 6:
        return TEST_LINE_BUF.b6
    if pos == 7:
        return TEST_LINE_BUF.b7
    if pos == 8:
        return TEST_LINE_BUF.b8
    if pos == 9:
        return TEST_LINE_BUF.b9
    if pos == 10:
        return TEST_LINE_BUF.b10
    if pos == 11:
        return TEST_LINE_BUF.b11
    if pos == 12:
        return TEST_LINE_BUF.b12
    if pos == 13:
        return TEST_LINE_BUF.b13
    if pos == 14:
        return TEST_LINE_BUF.b14
    if pos == 15:
        return TEST_LINE_BUF.b15
    if pos == 16:
        return TEST_LINE_BUF.b16
    if pos == 17:
        return TEST_LINE_BUF.b17
    if pos == 18:
        return TEST_LINE_BUF.b18
    if pos == 19:
        return TEST_LINE_BUF.b19
    if pos == 20:
        return TEST_LINE_BUF.b20
    return 48

# One LSD extract step. If mag is already 0, no-op.
fn extract_one(mut mag: u64, mut pos: usize):
    if mag == 0:
        return
    store_at(pos, ascii_digit(mag % 10))
    mag = mag / 10
    pos = pos +% 1
    return

# One reverse-swap step. If lo >= hi, no-op.
fn reverse_one(mut lo: usize, mut hi: usize):
    if lo < hi:
        t = load_at(lo)
        store_at(lo, load_at(hi))
        store_at(hi, t)
        lo = lo +% 1
        hi = hi -% 1
    return

# ABI: x0=value bits, x1=is_signed (nonzero => signed), x0=len. Magnitude
# via wrapping negation (decision 652); never checked. Not Format (598).
pub fn __wrela_fmt_dec(value: u64, is_signed: u64) -> u64:
    mag = value
    neg = false
    if is_signed != 0:
        # MSB set <=> negative as i64. Use `>> 63` (LSR) — ordered
        # compare is always signed in this backend and is wrong for the
        # upper half of u64 (codegen Compare invariant).
        if (value >> 63) != 0:
            neg = true
            mag = 0 -% value
    pos: usize = 0
    if neg:
        store_at(0, 45)
        pos = 1
    digits_start = pos
    if mag == 0:
        store_at(pos, 48)
        return (pos +% 1).to[u64]()
    extract_one(mut mag, mut pos)
    extract_one(mut mag, mut pos)
    extract_one(mut mag, mut pos)
    extract_one(mut mag, mut pos)
    extract_one(mut mag, mut pos)
    extract_one(mut mag, mut pos)
    extract_one(mut mag, mut pos)
    extract_one(mut mag, mut pos)
    extract_one(mut mag, mut pos)
    extract_one(mut mag, mut pos)
    extract_one(mut mag, mut pos)
    extract_one(mut mag, mut pos)
    extract_one(mut mag, mut pos)
    extract_one(mut mag, mut pos)
    extract_one(mut mag, mut pos)
    extract_one(mut mag, mut pos)
    extract_one(mut mag, mut pos)
    extract_one(mut mag, mut pos)
    extract_one(mut mag, mut pos)
    extract_one(mut mag, mut pos)
    lo = digits_start
    hi = pos -% 1
    reverse_one(mut lo, mut hi)
    reverse_one(mut lo, mut hi)
    reverse_one(mut lo, mut hi)
    reverse_one(mut lo, mut hi)
    reverse_one(mut lo, mut hi)
    reverse_one(mut lo, mut hi)
    reverse_one(mut lo, mut hi)
    reverse_one(mut lo, mut hi)
    reverse_one(mut lo, mut hi)
    reverse_one(mut lo, mut hi)
    return pos.to[u64]()

# M10 B4: binary-split packed copy — no `while`/`for` back-edge, so no
# checkpoint mid-line (decision 597). Recursion depth is log2(n); Call is
# not a loop Jump, so FnCtx::checkpoint never fires here. Line-buf source
# is B3's TEST_LINE_BUF via `load_at` (named fields; decision 597).
fn copy_line_buf_range(bump: usize, start: usize, n: usize):
    if n == 0:
        return
    if n == 1:
        CONSOLE_DATA.bytes[bump +% start] = load_at(start)
        return
    half: usize = n >> 1
    copy_line_buf_range(bump, start, half)
    copy_line_buf_range(bump, start +% half, n -% half)

fn copy_bytes_range(src: Bytes, bump: usize, start: usize, n: usize):
    if n == 0:
        return
    if n == 1:
        CONSOLE_DATA.bytes[bump +% start] = src[start]
        return
    half: usize = n >> 1
    copy_bytes_range(src, bump, start, half)
    copy_bytes_range(src, bump, start +% half, n -% half)

# M10 B4: append from OFF_TEST_LINE_BUF. No pointer — the buffer address
# is a placed-static fact. Returns 0 on success, 1 on overflow
# (decision 592: status, not BRK / abort).
pub fn __wrela_console_append_line_buf(len: usize) -> u64:
    # Layout field is u64 (decision 563); index wants usize. Same width
    # on this machine — `.to` abort is unreachable for a bump that
    # passed the ring-capacity check below (decision 591).
    bump: usize = MACHINE_INFO.ring_data_bump.to[usize]()
    end: usize = bump +% len
    if end < bump:
        return 1
    if end > DATA_SIZE:
        return 1
    copy_line_buf_range(bump, 0, len)
    MACHINE_INFO.ring_data_bump = end.to[u64]()
    return 0

# M10 B4: append `len` packed bytes from an unbounded Bytes handle
# (base, capacity). `len` must be ≤ handle capacity; longer / ring
# overflow returns 1 (decision 592).
pub fn __wrela_console_append_bytes(src: Bytes, len: usize) -> u64:
    bump: usize = MACHINE_INFO.ring_data_bump.to[usize]()
    if len > src.len:
        return 1
    end: usize = bump +% len
    if end < bump:
        return 1
    if end > DATA_SIZE:
        return 1
    copy_bytes_range(src, bump, 0, len)
    MACHINE_INFO.ring_data_bump = end.to[u64]()
    return 0

# M10 C: floor category 4 long-jump (decision 650). Body is overwritten
# by layout with hand-asm `LDR`+`BR` against OFF_TEST_CONTINUATION — the
# `return` here is only so the call graph type-checks; it must never
# remain in a test image.
fn __wrela_abort_tail():
    return

# Shared landing-pad bookkeeping (decision 591): clear latch, count a
# fail, then the computed long-jump. Both first-entry and re-entry end
# here so a bounds failure inside the print path cannot recurse.
fn finish_abort():
    MACHINE_INFO.abort_latch = 0
    MACHINE_INFO.test_failed = MACHINE_INFO.test_failed +% 1
    __wrela_abort_tail()
    return

# "FAILED " via named line-buf stores — Static[Bytes[N]] still cannot
# coerce to an unbounded Bytes parameter (decision 595), and abort must
# not depend on harness-interned rodata.
fn append_failed_literal() -> u64:
    store_at(0, 70)
    store_at(1, 65)
    store_at(2, 73)
    store_at(3, 76)
    store_at(4, 69)
    store_at(5, 68)
    store_at(6, 32)
    return __wrela_console_append_line_buf(7)

fn append_newline_literal() -> u64:
    store_at(0, 10)
    return __wrela_console_append_line_buf(1)

# M10 C: `__wrela_abort(msg: Bytes)` — ABI x0/x1 = (ptr, len), matching
# today's Reloc::AbortFixed callers (capacity equals length). Re-entrancy
# latch at OFF_ABORT_LATCH (decision 591); overflow from append/commit is
# status (decision 592); wrapping arith (decision 652); no loop back-edge
# (decision 597 — reuses console helpers).
pub fn __wrela_abort(msg: Bytes):
    if MACHINE_INFO.abort_latch != 0:
        finish_abort()
        return
    MACHINE_INFO.abort_latch = 1
    _ = append_failed_literal()
    _ = __wrela_console_append_bytes(msg, msg.len)
    _ = append_newline_literal()
    _ = __wrela_line_commit()
    finish_abort()

# M10 C: `__wrela_abort_val` — six-register ABI (prefix Bytes, value,
# value_signed, suffix Bytes) matching Reloc::AbortVal callers.
pub fn __wrela_abort_val(prefix: Bytes, value: u64, value_signed: u64, suffix: Bytes):
    if MACHINE_INFO.abort_latch != 0:
        finish_abort()
        return
    MACHINE_INFO.abort_latch = 1
    _ = append_failed_literal()
    _ = __wrela_console_append_bytes(prefix, prefix.len)
    digs = __wrela_fmt_dec(value, value_signed)
    _ = __wrela_console_append_line_buf(digs.to[usize]())
    _ = __wrela_console_append_bytes(suffix, suffix.len)
    _ = append_newline_literal()
    _ = __wrela_line_commit()
    finish_abort()
