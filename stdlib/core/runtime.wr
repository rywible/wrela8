# ---------------------------------------------------------------------------
# M11 item J: rt_enqueue + rt_select_and_run (decisions 830–835). Generic
# @budget algorithms over mailbox overlays + generated method dispatch.
# Send sites alias `rt_enqueue <Actor>` onto `__enqueue_N` trampolines;
# run_one Calls `__wrela_try_select` → `__wrela_rt_select`.
# ---------------------------------------------------------------------------

const REPLY_TAG_OK: u64 = 0
const CALL_ERROR_TAG_CANCELLED: u64 = 1

# Admission: bounded ring insert. ABI matches former emit_rt_enqueue, plus the
# leading `core` plans/lane1-per-core.md item A threads for the Lane 1 row: the
# admitting core owns `LANE1`'s `core` slot, and it is always the core that owns
# `root` (`layout.rs::resolve_cross_core_edge` keeps a direct
# `__rt_enqueue_<Actor>` Call only for a same-core edge; every cross-core send
# rides a ring and is admitted by the destination core's own drain). Passed in
# rather than re-derived here so the caller that *knows* which core is running
# says so (decision 1500), and refused rather than defaulted below.
pub fn __wrela_rt_enqueue(core: usize, root: usize, method: u64, arg0: u64, arg1: u64, waker_turn: u64, waker_core: u64) -> u64:
    if core >= N_CORES:
        MACHINE_INFO.test_failed = MACHINE_INFO.test_failed +% 1
        return 1
    if root >= N_MAILBOXES:
        return 1
    if root == NO_EDGE:
        return 1
    cap = __wrela_mb_capacity(root)
    count = __wrela_mb_get_count(root)
    if count >= cap:
        return 1
    slot_words = __wrela_mb_slot_words(root)
    tail = __wrela_mb_get_tail(root)
    base = (tail *% slot_words.to[u64]()).to[usize]()
    __wrela_mb_store_word(root, base, method)
    packed = waker_turn | (waker_core << 32)
    __wrela_mb_store_word(root, base +% 1, packed)
    if slot_words >= 3:
        __wrela_mb_store_word(root, base +% 2, arg0)
    if slot_words >= 4:
        __wrela_mb_store_word(root, base +% 3, arg1)
    t = tail +% 1
    if t >= cap:
        t = 0
    __wrela_mb_set_tail(root, t)
    __wrela_mb_set_count(root, count +% 1)
    LANE1.messages[core] = LANE1.messages[core] +% 1
    return 0

# Handle-identity → enqueue (drain request lane). `core` is the draining core
# (`__wrela_rt_drain`'s own argument), which owns every mailbox its request
# rings target.
pub fn __wrela_try_enqueue(core: usize, handle: usize, method: u64, arg0: u64, arg1: u64, waker_turn: u64, waker_core: u64) -> u64:
    root = __wrela_enqueue_root(handle)
    if root == NO_EDGE:
        return 1
    return __wrela_rt_enqueue(core, root, method, arg0, arg1, waker_turn, waker_core)

# Fixed trampolines so layout can alias `rt_enqueue <Actor>` → `__enqueue_N`.
# The Call ABI is codegen's (method, arg0, arg1, waker_turn, waker_core) and
# carries no core, so this one helper supplies the baked root's owning core —
# which *is* the core executing the trampoline, by `resolve_cross_core_edge`'s
# same-core rule (see `__wrela_rt_enqueue`). One shared derivation site rather
# than thirty-two copies of the same ladder call.
pub fn __wrela_enqueue_local(root: usize, method: u64, arg0: u64, arg1: u64, waker_turn: u64, waker_core: u64) -> u64:
    return __wrela_rt_enqueue(__wrela_mb_core(root), root, method, arg0, arg1, waker_turn, waker_core)

pub fn __enqueue_0(method: u64, arg0: u64, arg1: u64, waker_turn: u64, waker_core: u64) -> u64:
    return __wrela_enqueue_local(0, method, arg0, arg1, waker_turn, waker_core)
pub fn __enqueue_1(method: u64, arg0: u64, arg1: u64, waker_turn: u64, waker_core: u64) -> u64:
    return __wrela_enqueue_local(1, method, arg0, arg1, waker_turn, waker_core)
