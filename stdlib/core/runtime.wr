    TEST_LINE_BUF.bytes[4] = 108
    TEST_LINE_BUF.bytes[5] = 101
    TEST_LINE_BUF.bytes[6] = 100
    TEST_LINE_BUF.bytes[7] = 10
    return __wrela_console_append_line_buf(8)

