pub fn __wrela_abort_deadlock():
    if MACHINE_INFO.abort_latch != 0:
        finish_abort()
        return
    MACHINE_INFO.abort_latch = 1
    _ = append_failed_literal()
    _ = __wrela_append_deadlock_literal()
    _ = append_newline_literal()
    _ = __wrela_line_commit()
    finish_abort()

# ---------------------------------------------------------------------------
# plans/lane1-per-core.md item B — bounded quiesce before the halt dump
# (decision 1504). What it buys: `turns` / `messages` / `method_hits` are
# totals over work the program does, which is fixed; only the *instant* core 0
# sampled them was racy, because a released core can still be draining when
# core 0 reaches `__wrela_rt_summary_and_halt`. That is the whole reason
# `boot-cross-core-ring-full` could not pin its trailer: it asserts a
# rejection, so it deliberately halts with one admitted-but-unprocessed
# message outstanding.
#
# Bounded, and it halts anyway when the bound runs out (decision 1504): an
# unbounded wait would turn a scheduling bug into a hang. A timeout is
# *printed*, in one fixed spelling, so it can never be mistaken for a clean
# quiesce in a golden.
# ---------------------------------------------------------------------------

# Raised 4096 -> 262144 on 2026-07-30, measured, not guessed. The bound is
# a race against the *host* scheduler, not against guest work: core 0 burns
# its spins while the host has descheduled the secondary vCPU threads, so on
# an oversubscribed machine core 0 can exhaust the bound before a secondary
# ever runs. Measured over the 35 boot goldens, 8 concurrent boots on a
# 10-core host (4 performance cores), transcripts compared to their pins:
#
#   bound = 4096     2, 3, 1 mismatches over three rounds
#   bound = 262144   0, 0, 0, 1, 0 over five rounds (and 0 at 12 concurrent)
#
# All 993 golden expectations are byte-identical either way, so nothing
# prices this constant.
#
# It is a mitigation, not a fix, and the residual is real: no spin bound can
# be correct against an arbitrarily oversubscribed host. The actual fix is a
# yield hint inside the loop so the host can schedule the cores this one is
# waiting for — a machine-contract change, and a decision, not a constant.
# Until then `xtask golden` keeps its boot lane at or below the performance-
# core count (`--boot-jobs`, default 4), where the corpus measures clean.
const QUIESCE_POLL_BOUND: usize = 262144

# Every released core parked (`PENDING.idle`) with nothing pending for it.
# Both halves matter: a core that has just been woken has a pending word and
# will clear its own idle flag at its loop head, so checking the flag alone
# could read "finished" for a core that is about to run.
pub fn __wrela_secondaries_idle() -> u64:
    c: usize = 1
    @budget(bound=CORE_SLOTS)
    while c < N_CORES:
        if PENDING.idle[c] == 0:
            return 0
        if PENDING.words[c] != 0:
            return 0
        c = c +% 1
    return 1

# Returns 1 if the machine quiesced, 0 if the poll bound ran out first.
pub fn __wrela_quiesce_before_halt() -> u64:
    if N_CORES <= 1:
        return 1
    spins: usize = 0
    @budget(bound=QUIESCE_POLL_BOUND)
    while spins < QUIESCE_POLL_BOUND:
        # Core 0's own inbound lane first: an admission or reply this core
        # still owes can be exactly what another core is waiting for. Same
        # call the entry driver's own loop makes, so no new behavior class —
        # and any work it finds is work the program had left to do.
        __wrela_rt_checkpoint(0)
        _ = __wrela_rt_run_one(0)
        if __wrela_secondaries_idle() != 0:
            # Acquire, pairing with the secondary's release store before its
            # park: every counter store it made is visible from here on.
            @dmb(ishld)
            return 1
        spins = spins +% 1
    return 0

# "lane1 quiesce=timeout" — the one spelling a timed-out quiesce prints, so a
# golden shows it instead of silently pinning a sampled-mid-flight total.
pub fn __wrela_lane1_quiesce_timeout_line():
    __wrela_line_begin()
    TEST_LINE_BUF.bytes[0] = 108
    TEST_LINE_BUF.bytes[1] = 97
    TEST_LINE_BUF.bytes[2] = 110
    TEST_LINE_BUF.bytes[3] = 101
    TEST_LINE_BUF.bytes[4] = 49
    TEST_LINE_BUF.bytes[5] = 32
    TEST_LINE_BUF.bytes[6] = 113
    TEST_LINE_BUF.bytes[7] = 117
    TEST_LINE_BUF.bytes[8] = 105
    TEST_LINE_BUF.bytes[9] = 101
    TEST_LINE_BUF.bytes[10] = 115
    TEST_LINE_BUF.bytes[11] = 99
    TEST_LINE_BUF.bytes[12] = 101
    TEST_LINE_BUF.bytes[13] = 61
    TEST_LINE_BUF.bytes[14] = 116
    TEST_LINE_BUF.bytes[15] = 105
    TEST_LINE_BUF.bytes[16] = 109
    TEST_LINE_BUF.bytes[17] = 101
    TEST_LINE_BUF.bytes[18] = 111
    TEST_LINE_BUF.bytes[19] = 117
    TEST_LINE_BUF.bytes[20] = 116
    _ = __wrela_console_append_line_buf(21)
    TEST_LINE_BUF.bytes[0] = 10
    _ = __wrela_console_append_line_buf(1)
    _ = __wrela_line_commit()
    return

pub fn __wrela_rt_summary_and_halt():
    # Before the summary, not after: the counters the Lane 1 block dumps are
    # only a total once every released core has finished (item B).
    quiesced = __wrela_quiesce_before_halt()
    __wrela_line_begin()
    digs = __wrela_fmt_dec(MACHINE_INFO.test_passed, 0)
    _ = __wrela_console_append_line_buf(digs.to[usize]())
    _ = __wrela_append_passed_comma_literal()
    digs2 = __wrela_fmt_dec(MACHINE_INFO.test_failed, 0)
    _ = __wrela_console_append_line_buf(digs2.to[usize]())
    _ = __wrela_append_failed_tail_literal()
    _ = __wrela_line_commit()
    if quiesced == 0:
        __wrela_lane1_quiesce_timeout_line()
    # Lane 1 counter block trails the summary (well-formedness allows it).
    __wrela_lane1_dump()
    # Lane 2 block-hit vector (no-op unless `--block-count` enabled emission).
    __wrela_lane2_dump()
    code: u64 = 0
    if MACHINE_INFO.test_failed != 0:
        code = 1
    MACHINE_INFO.exit_code = code
    EXIT.word = code
    return

# Boot setup for the test image (not 810). Floor trampoline arms
# continuation at `__wrela_rt_primary_entry` then BLs here.
pub fn __wrela_rt_primary_boot():
    MACHINE_INFO.test_passed = 0
    MACHINE_INFO.test_failed = 0
    MACHINE_INFO.ring_data_bump = 0
    MACHINE_INFO.ring_desc_bump = 0
    MACHINE_INFO.line_start = 0
    MACHINE_INFO.abort_latch = 0
    MACHINE_INFO.test_next = 0
    # Every row, not just row 0 (plans/lane1-per-core.md item A) — and before
    # `RELEASE.word` below hands the secondaries their rows.
    zc: usize = 0
    @budget(bound=CORE_SLOTS)
    while zc < N_CORES:
        LANE1.turns[zc] = 0
        LANE1.run_one_hits[zc] = 0
        LANE1.messages[zc] = 0
        zc = zc +% 1
    zi: usize = 0
    @budget(bound=4096)
    while zi < LANE1_METHOD_HITS_LEN:
        LANE1.method_hits[zi] = 0
        zi = zi +% 1
    LANE2.enabled = 0
    zj: usize = 0
    # plans/M20.md item B: BLOCK_POOL_COUNT is 3072.
    @budget(bound=4096)
    while zj < BLOCK_POOL_COUNT:
        LANE2.hits[zj] = 0
        zj = zj +% 1
    if N_CORES > 1:
        MACHINE_INFO.core_marks[0] = 1
        # "not idle yet" for every core, before release: a released core that
        # the host has not scheduled yet must read as unfinished, not as
        # finished (item B).
        zq: usize = 0
        @budget(bound=CORE_SLOTS)
        while zq < N_CORES:
            PENDING.idle[zq] = 0
            zq = zq +% 1
        RELEASE.word = N_CORES.to[u64]()
    if HAS_BOOT_INIT:
        __wrela_line_begin()
        __wrela_rt_boot_init()
    __wrela_rt_primary_entry()
    return

# Decision 810 primary event-loop entry: one supervised root turn per
# `@test(runtime)`, driving async roots through run_one / park / checkpoint.
# Boot-init abort long-jumps here with `test_next == 0` and `test_failed > 0`
# — skip straight to summary (old driver armed continuation at the summary).
pub fn __wrela_rt_primary_entry():
    # M13 item N: observation discharge (not a name allowlist). Outer
    # back-edge observes via the trailing checkpoint; abort long-jumps to
    # the fn head must still see `test_failed` before any service work.
    # Inner park/run loop observes at its head.
    while true:
        if MACHINE_INFO.test_failed != 0:
            if MACHINE_INFO.test_next == 0:
                __wrela_rt_summary_and_halt()
                return
        i: usize = MACHINE_INFO.test_next.to[usize]()
        if i >= N_TESTS:
            __wrela_rt_summary_and_halt()
            return
        MACHINE_INFO.test_next = (i +% 1).to[u64]()
        __wrela_line_begin()
        __wrela_test_append_prefix(i)
        status = __wrela_test_call(i)
        if __wrela_test_suspends(i) != 0:
            while status == TURN_STATUS_SUSPENDED:
                __wrela_rt_checkpoint(0)
                if GROUP_ARENA_CAPACITY != 0:
                    __wrela_deadline_poll()
                ti = __wrela_test_turn_index(i)
                if RT.turns[ti].resume_ready != 0:
                    status = __wrela_test_call(i)
                else:
                    ran = __wrela_rt_run_one(0)
                    if ran == 0:
                        if N_CORES > 1:
                            PARK.word = 0
                            __wrela_rt_checkpoint(0)
                        else:
                            dl = MACHINE_INFO.next_deadline
                            if dl != 0:
                                PARK.word = dl
                                __wrela_rt_checkpoint(0)
                            else:
                                __wrela_abort_deadlock()
        _ = __wrela_append_ok_literal()
        _ = __wrela_line_commit()
        MACHINE_INFO.test_passed = MACHINE_INFO.test_passed +% 1
        __wrela_rt_checkpoint(0)
    return
