module blk

@layout(mmio, endian=little)
pub struct VirtioIrqMmio:
    @offset(0x060) interrupt_status: ReadOnly[u32]
    @offset(0x064) interrupt_ack: WriteOnly[u32]

@layout(dma, endian=little)
pub struct BlkReqHeader:
    kind: u32
    reserved: u32
    sector: u64

@layout(dma, endian=little)
pub struct BlkReqStatus:
    status: u8

@layout(dma, endian=little)
pub struct DmaBlock:
    @offset(0) word: u64
    @offset(504) pad_end: u64

pub struct VirtioBlock:
    id: u32

pub enum Feature:
    Flush

pub const QDEPTH: usize = 8
pub const SECTOR: usize = 512
pub const BLK_T_IN: u32 = 0
pub const BLK_T_OUT: u32 = 1
pub const MAGIC: u64 = 0xC0FFEE00BEEF42A1
pub const PHASE_WRITE: u32 = 1
pub const PHASE_READ: u32 = 2
pub const PHASE_DONE: u32 = 3

pool BlockControl
pool BlockPayloads

@driver
pub struct BlkDriver:
    irq_regs: Mmio[VirtioIrqMmio]
    device: RunningDevice[VirtioBlock]
    queue: VirtQueue[..8]
    capacity_sectors: u64
    pending: InterruptCell[u32]
    irq: IrqCap[u32]
    buffer: Option[own[BlockPayloads] DmaBlock]
    inflight: Option[Receipt[own[BlockPayloads] DmaBlock]]
    phase: u32
    seen: u32

    init(mut self,
         take cap: DeviceCap[VirtioBlock],
         take control_pool: DmaPool[BlockControl, 512],
         take buffer: own[BlockPayloads] DmaBlock)
        -> Result[unit, BootError]:
        claimed = VirtioBlock.claim(cap=take cap)
        self.irq_regs = claimed.map_partition(VirtioIrqMmio)
        self.pending = InterruptCell(0)
        self.phase = 0
        self.seen = 0
        self.buffer = None
        negotiated = claimed.negotiate(
            required=[Feature.Flush],
            optional=[Feature.Flush],
        )?
        self.queue = VirtQueue.configure(
            pool=take control_pool,
            device=mut negotiated,
            index=0,
            depth=QDEPTH,
        )?
        self.capacity_sectors = 16
        irq = negotiated.take_irq()
        irq.bind(self.on_queue_irq)
        irq.unmask()
        self.irq = take irq
        self.device = negotiated.start()
        b = take buffer
        b.word = MAGIC
        permit = self.queue.reserve(descriptors=3)
        op = self.queue.prepare_block(
            permit=take permit,
            header=BlkReqHeader(kind=BLK_T_OUT, reserved=0, sector=0),
            payload=take b,
            device_writes_payload=false,
            status=BlkReqStatus(status=0xff),
            idempotent=false,
        )
        receipt = self.queue.publish(operation=take op)
        self.inflight = Some(take receipt)
        self.phase = PHASE_WRITE
        return Ok(unit)

    fn on_queue_irq(self):
        status = self.irq_regs.interrupt_status.read()
        handled = status & 1
        if handled != 0:
            self.pending.fetch_or_release(handled)
            self.irq_regs.interrupt_ack.write(handled)
            wake(BlkDriver.drain)

    @task
    fn drain(mut self):
        status = self.pending.swap_acquire(0)
        if status == 0:
            return unit
        slot = take self.inflight
        match slot:
            case .None:
                self.inflight = None
                return unit
            case .Some(r):
                self.queue.drain(max=QDEPTH)
                c = self.queue.claim(receipt=take r)
                if self.phase == PHASE_WRITE:
                    match c.status:
                        case .Ok(_):
                            pass
                        case .Err(_):
                            assert false, "write completion status Ok"
                    n = c.written_len
                    match n.checked_le(SECTOR):
                        case .Ok(v):
                            assert v == 0, "write written_len buffer-facing is 0"
                        case .Err(_):
                            assert false, "write checked_le(512) must succeed for 0"
                    b = take c.payload
                    b.word = 0
                    permit = self.queue.reserve(descriptors=3)
                    op = self.queue.prepare_block(
                        permit=take permit,
                        header=BlkReqHeader(kind=BLK_T_IN, reserved=0, sector=0),
                        payload=take b,
                        device_writes_payload=true,
                        status=BlkReqStatus(status=0xff),
                        idempotent=true,
                    )
                    receipt = self.queue.publish(operation=take op)
                    self.inflight = Some(take receipt)
                    self.phase = PHASE_READ
                else:
                    if self.phase == PHASE_READ:
                        match c.status:
                            case .Ok(_):
                                pass
                            case .Err(_):
                                assert false, "read completion status Ok"
                        reported = c.written_len
                        match reported.checked_le(SECTOR):
                            case .Ok(v):
                                assert v == 512, "checked_le(512) yields buffer-facing 512"
                            case .Err(_):
                                assert false, "checked_le(512) must succeed for a 512-byte read"
                        match reported.checked_le(511):
                            case .Ok(_):
                                assert false, "checked_le(511) must fail: 512 > 511"
                            case .Err(_):
                                pass
                        b = take c.payload
                        w = b.word
                        assert w == 0xC0FFEE00BEEF42A1, "read-back sees the hand-computed sector word"
                        empty = take self.buffer
                        match empty:
                            case .None:
                                pass
                            case .Some(_):
                                assert false, "buffer still held at read completion"
                        self.buffer = Some(take b)
                        self.inflight = None
                        self.phase = PHASE_DONE
                        self.seen = 1
                    else:
                        self.inflight = None
                        assert false, "drain in unexpected phase"
        return unit
