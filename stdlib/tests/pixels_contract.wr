module pixels_contract

# @wrela-compiler-internal: pins compiler-owned Pixels bootstrap dispatch.

from core.field import Rgb, Vec3, Vec4, cross3, dot3, length3, sqrt_scalar
from core.render import Camera, Light, LightConfig, LightFrame, LightKind, MaterialSample
from core.render import __wrela_pixels_bootstrap_camera_light_post, __wrela_pixels_bootstrap_csg
from core.render import __wrela_pixels_bootstrap_dispatch, __wrela_pixels_bootstrap_event
from core.render import __wrela_pixels_bootstrap_feature, __wrela_pixels_bootstrap_field
from core.render import __wrela_pixels_bootstrap_fixed_domain, __wrela_pixels_bootstrap_material
from core.render import __wrela_pixels_bootstrap_object, __wrela_pixels_bootstrap_parameter
from core.render import __wrela_pixels_bootstrap_scalar

@test
fn bootstrap_dispatch_covers_every_p5_record_family_and_fails_closed():
    match __wrela_pixels_bootstrap_scalar(32):
        case .Ok(value):
            assert value == 32, "scalar tag ceiling"
        case .Err(_):
            assert false, "scalar tag ceiling must dispatch"
    match __wrela_pixels_bootstrap_field(30):
        case .Ok(value):
            assert value == 30, "field tag ceiling"
        case .Err(_):
            assert false, "field tag ceiling must dispatch"
    match __wrela_pixels_bootstrap_object(1):
        case .Ok(_):
            pass
        case .Err(_):
            assert false, "object record must dispatch"
    match __wrela_pixels_bootstrap_feature(3):
        case .Ok(_):
            pass
        case .Err(_):
            assert false, "feature tag ceiling must dispatch"
    match __wrela_pixels_bootstrap_material(3):
        case .Ok(_):
            pass
        case .Err(_):
            assert false, "material tag ceiling must dispatch"
    match __wrela_pixels_bootstrap_parameter(1):
        case .Ok(_):
            pass
        case .Err(_):
            assert false, "parameter record must dispatch"
    match __wrela_pixels_bootstrap_event(14):
        case .Ok(_):
            pass
        case .Err(_):
            assert false, "event tag ceiling must dispatch"
    match __wrela_pixels_bootstrap_csg(6):
        case .Ok(_):
            pass
        case .Err(_):
            assert false, "CSG tag ceiling must dispatch"
    match __wrela_pixels_bootstrap_fixed_domain(35):
        case .Ok(_):
            pass
        case .Err(_):
            assert false, "fixed-domain tag ceiling must dispatch"
    match __wrela_pixels_bootstrap_camera_light_post(1):
        case .Ok(_):
            pass
        case .Err(_):
            assert false, "camera/light/post record must dispatch"
    match __wrela_pixels_bootstrap_dispatch(2, 9):
        case .Err(.InternalInvariant(_)):
            pass
        case _:
            assert false, "a gap in the field tag namespace must fail closed"

@test
fn dyadic_fixture_coordinates_are_exact():
    p = Vec3(x=0.5, y=0.25, z=0.125)
    assert p.x * 2.0 == 1.0, "one half is exact"
    assert p.y * 4.0 == 1.0, "one quarter is exact"
    assert p.z * 8.0 == 1.0, "one eighth is exact"

@test
fn canonical_scene_vector_subtraction_typechecks():
    p = Vec3(x=2.0, y=4.0, z=8.0)
    fighter_offset = Vec3(x=0.5, y=1.0, z=2.0)
    q = p - fighter_offset
    assert q.x == 1.5, "canonical scene expression subtracts x"
    assert q.y == 3.0, "canonical scene expression subtracts y"
    assert q.z == 6.0, "canonical scene expression subtracts z"

@test
fn camera_authored_forms_validate_before_producing_a_frame_camera():
    zero = Vec3(x=0.0, y=0.0, z=0.0)
    target = Vec3(x=0.0, y=0.0, z=1.0)
    up = Vec3(x=0.0, y=1.0, z=0.0)
    match Camera.look_at(eye=zero, target=target, authored_up=up):
        case .Ok(_):
            pass
        case .Err(_):
            assert false, "canonical look-at camera must build"
    match Camera.look_at(eye=zero, target=target, authored_up=zero):
        case .Err(.DegenerateUp):
            pass
        case _:
            assert false, "zero look-at up must be rejected"
    match Camera.quaternion(
        eye=zero,
        rotation=Vec4(x=0.0, y=0.0, z=0.0, w=1.0),
    ):
        case .Ok(_):
            pass
        case .Err(_):
            assert false, "identity quaternion must build"
    max_finite: f32 = 340282346638528859811704183484516925440.0
    match Camera.quaternion(
        eye=zero,
        rotation=Vec4(x=max_finite, y=max_finite, z=max_finite, w=max_finite),
    ):
        case .Ok(_):
            pass
        case .Err(_):
            assert false, "largest finite quaternion components normalize without overflow"
    match Camera.quaternion(
        eye=zero,
        rotation=Vec4(x=0.0, y=0.0, z=0.0, w=0.0),
    ):
        case .Err(.DegenerateQuaternion):
            pass
        case _:
            assert false, "zero quaternion must be rejected"
    match Camera.explicit(
        eye=zero,
        authored_forward=target,
        authored_right=Vec3(x=1.0, y=0.0, z=0.0),
        authored_up=Vec3(x=0.0, y=-1.0, z=0.0),
    ):
        case .Err(.InvalidBasis):
            pass
        case _:
            assert false, "left-handed explicit basis must be rejected"

@test
fn nonempty_fixed_capacity_light_frame_typechecks():
    origin = Vec3(x=0.0, y=2.0, z=0.0)
    white = Rgb(r=1.0, g=1.0, b=1.0)
    point = Light.point(position=origin, radiance=white)
    frame = LightFrame.fixed(lights=[
        point,
        Light.zero(),
        Light.zero(),
        Light.zero(),
        Light.zero(),
        Light.zero(),
        Light.zero(),
        Light.zero(),
    ])
    config = LightConfig.declared(
        capacity=1,
        kinds=[
            LightKind.Rectangle,
            LightKind.Disabled,
            LightKind.Disabled,
            LightKind.Disabled,
            LightKind.Disabled,
            LightKind.Disabled,
            LightKind.Disabled,
            LightKind.Disabled,
        ],
    )
    assert true, "a sealed light frame can carry a nonempty numeric payload"

@test
fn light_kind_validation_does_not_alias_payload_coordinates():
    zero = Vec3(x=0.0, y=0.0, z=0.0)
    white = Rgb(r=1.0, g=1.0, b=1.0)
    plus_x = Light.directional(
        direction=Vec3(x=1.0, y=0.0, z=0.0),
        radiance=white,
    )
    point_at_two = Light.point(
        position=Vec3(x=2.0, y=0.0, z=0.0),
        radiance=white,
    )
    assert plus_x.__wrela_p5_matches_kind(2), "directional kind is explicit"
    assert not plus_x.__wrela_p5_matches_kind(1), "direction payload cannot spoof point"
    assert point_at_two.__wrela_p5_matches_kind(1), "point kind is explicit"
    assert not point_at_two.__wrela_p5_matches_kind(2), "position payload cannot spoof directional"
    assert Light.zero().__wrela_p5_matches_kind(0), "disabled kind is explicit"

@test
fn material_sample_sanitizes_nonfinite_color_and_clamps_roughness():
    zero: f32 = 0.0
    nan = zero / zero
    infinity: f32 = 1.0 / zero
    sanitized = MaterialSample.standard(
        color=Rgb(r=nan, g=infinity, b=-infinity),
        roughness=nan,
    )
    color = sanitized.sample_color()
    assert color.r == 0.0, "NaN color becomes zero"
    assert color.g < infinity, "positive infinity becomes finite"
    assert color.b > -infinity, "negative infinity becomes finite"
    assert sanitized.sample_roughness() == 0.0, "NaN roughness becomes zero"

    high = MaterialSample.clay(
        color=Rgb(r=0.0, g=0.0, b=0.0),
        roughness=2.0,
    )
    low = MaterialSample.porcelain(
        color=Rgb(r=0.0, g=0.0, b=0.0),
        roughness=-1.0,
    )
    assert high.sample_roughness() == 1.0, "roughness clamps high"
    assert low.sample_roughness() == 0.0, "roughness clamps low"

@test
fn premultiplied_transfer_identity_is_associative_for_opaque_suffix():
    front_c: f32 = 0.25
    front_t: f32 = 0.5
    middle_c: f32 = 0.5
    middle_t: f32 = 0.0
    back_c: f32 = 1.0
    back_t: f32 = 0.0
    left = front_c + front_t * (middle_c + middle_t * back_c)
    right = (front_c + front_t * middle_c) + (front_t * middle_t) * back_c
    assert left == right, "transfer composition association"
