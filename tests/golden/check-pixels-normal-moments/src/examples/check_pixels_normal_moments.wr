module examples.check_pixels_normal_moments

from core.field import (
    Field,
    Rgb,
    Vec3,
    box,
    mark,
    round_box,
    sinusoidal_displace,
)
from core.render import (
    AoConfig,
    CameraBounds,
    LightConfig,
    MaterialSample,
    NormalDetail,
    ProbeConfig,
    RenderProfile,
    RgbRange,
    ScalarRange,
    SurfaceContext,
    TextureFilter,
    ToneCurve,
    UvSource,
)
from drivers.display import Display, DisplayDevice

const FIXTURE_ID: u32 = 20

fn fixture_id() -> u32:
    return FIXTURE_ID

const SLOPE_X_RAW: i32 = 1
const SLOPE_Y_RAW: i32 = -1
const SLOPE_FRAC_BITS: u8 = 4

struct SceneParams:
    @range(min=-2.0, max=2.0)
    @rate(max_delta=0.25, max_second_delta=0.0625)
    phase: f32

enum MaterialId:
    Ground

@field
fn world(p: Vec3, read params: SceneParams) -> Field:
    round = round_box(p, Vec3(x=0.75, y=0.75, z=0.75), radius=0.125)
    detail = sinusoidal_displace(round, p, amplitude=0.0625, frequency=4.0, phase=0.0)
    return mark(detail, object=MaterialId.Ground, material=MaterialId.Ground)

@material
fn shade(surface: SurfaceContext[MaterialId], read params: SceneParams) -> MaterialSample:
    return MaterialSample.standard(
        color=Rgb(r=0.25, g=0.5, b=0.75),
        roughness=0.5,
        metallic=0.125,
        specular=0.75,
        emissive=Rgb(r=0.0, g=0.0, b=0.0),
        opacity=1.0,
        normal_detail=NormalDetail.TextureSlopeUv(
            texture_id=21,
            width=2,
            height=2,
            filter=TextureFilter.Anisotropic4,
            uv_source=UvSource.RoundBoxFeature,
        ),
    )

@test(runtime)
fn pinned_scene_contract():
    assert FIXTURE_ID == 20, "fixture id must remain pinned"
    assert SLOPE_X_RAW == 1, "adversarial scene value must remain pinned"

@image
pub fn build() -> Image:
    img = Image(name="check-pixels-normal-moments", target=Target.wrela_machine_v1)
    display_device = img.device[DisplayDevice](transport=0x6000)
    display = img.driver(Display, device=display_device, width=64, height=32, refresh_hz=60)
    renderer = img.renderer[SceneParams](
        field=world,
        material=shade,
        display=display,
        width=64,
        height=32,
        refresh_hz=60,
        shade_hz=60,
        profile=RenderProfile.AaaByteExact,
        tone_curve=ToneCurve.Linear,
        near=0.1,
        far=128.0,
        world_min=Vec3(x=-4.0, y=-4.0, z=-4.0),
        world_max=Vec3(x=4.0, y=4.0, z=4.0),
        camera_bounds=CameraBounds.bounded(max_motion=0.25),
        light_config=LightConfig.fixed(capacity=0),
        exposure_range=ScalarRange(min=-1.0, max=1.0),
        environment_range=RgbRange(
            min=Rgb(r=0.0, g=0.0, b=0.0),
            max=Rgb(r=1.0, g=1.0, b=1.0),
        ),
        ao=AoConfig.fixed(enabled=false),
        probes=ProbeConfig.fixed(enabled=false),
        initialization_deadline_ms=10,
    )
    img.on_failure(policy=Failure.Halt)
    return img.seal()
