module app.main

from lib.sealed import Sealed

# plans/M13.md item G1: pin the field-visibility census shape.
# Construct / read / write of non-`pub` `hidden` across the module
# boundary; `visible` is `pub` and must not appear in the census.
# Pattern-bind is a column with no revision-0.1 surface (no struct
# field patterns) — patterns=0 is the pin.

fn probe() -> u32:
    s = Sealed(hidden=1, visible=2)
    s.hidden = 3
    return s.hidden + s.visible

const SETTLED: u32 = probe()

@test
pub fn t_settled():
    assert SETTLED == 5, "census fixture settled"
