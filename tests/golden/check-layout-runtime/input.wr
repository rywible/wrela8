module examples.layout_runtime


@layout(runtime, endian=little)
struct TurnArea:
    state: u32
    waiter: u32


@layout(runtime, endian=little)
struct TurnTable:
    rr_cursor: u64
    turns: [TurnArea; 4]


@layout(runtime, endian=little)
struct GroupSlot:
    parent: TurnArea
    children: [TurnArea; 4]
