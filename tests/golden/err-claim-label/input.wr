module examples.err_claim_label

# plans/M7.md item H1 self-audit — `claim` with a label that is not `cap=`
#
# What this case would catch: a claim whose argument is labelled something other than §9's own `cap=` spelling.

@layout(mmio, endian=little)
struct VirtioIrqMmio:
    @offset(0x060) interrupt_status: ReadOnly[u32]

struct VirtioBlock:
    id: u32

@driver
pub struct BlkDriver:
    regs: Mmio[VirtioIrqMmio]

    init(mut self, take cap: DeviceCap[VirtioBlock]):
        claimed = VirtioBlock.claim(device=take cap)
        self.regs = claimed.map_partition(VirtioIrqMmio)
