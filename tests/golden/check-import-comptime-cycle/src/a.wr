module a

from b import Bee, bee_weight

pub struct Ay:
    pub n: u32

    pub fn scaled(read self) -> u32:
        return self.n * 2

const DEPTH: u32 = bee_weight(Bee(m=3))

@actor
pub struct Store:
    depth: u32
    count: u32

    init(mut self, depth: u32):
        self.depth = depth
        self.count = 0

@image
pub fn build() -> Image:
    img = Image(name="import-comptime-cycle", target=Target.wrela_machine_v1)
    storage = img.actor(Store, depth=DEPTH, mailbox=4)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
