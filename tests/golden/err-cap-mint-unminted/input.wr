module examples.err_cap_mint_unminted


@layout(mmio, endian=little)
struct VirtioIrqMmio:
    @offset(0x060) interrupt_status: ReadOnly[u32]
    @offset(0x064) interrupt_ack: WriteOnly[u32]

struct BlockHw:
    id: u32

@driver
pub struct BlkDriver:
    held: Mmio[VirtioIrqMmio]
    sectors: u64

    init(mut self, take regs: Mmio[VirtioIrqMmio], sectors: u64):
        self.held = take regs
        self.sectors = sectors

    pub fn capacity(read self) -> u64:
        return self.sectors

@image
pub fn build() -> Image:
    img = Image(name="cap-mint", target=Target.wrela_machine_v1)
    blk_device = img.device[BlockHw](transport=0x2000)
    disk = img.driver(BlkDriver, device=blk_device, sectors=131072)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
