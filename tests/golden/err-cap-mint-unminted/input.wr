module examples.err_cap_mint_unminted

# plans/M7.md item A: exactly one of 03-hardware.md §1's four capabilities
# is minted by this item — `DeviceCap[D]`, from the `device=` binding §1
# names. The other three need machinery that does not exist yet and fail
# closed naming the item that builds it: `Mmio[L]` needs a claim to
# partition (item C), `IrqCap[V]` needs a vector bound from the image
# graph (item G), `DmaPool[P, N]` needs a real pool (item D — and
# `img.dma_pool` itself still fails the whole build closed, gap
# `image.graph.dma-pools`).
#
# 03 §1's own worked-example driver takes both a `DeviceCap` and a
# `DmaPool`, so this is the exact shape M7 is walking toward; this golden
# is the honest floor it walks from.

@layout(mmio, endian=little)
struct VirtioIrqMmio:
    @offset(0x060) interrupt_status: ReadOnly[u32]
    @offset(0x064) interrupt_ack: WriteOnly[u32]

struct BlockHw:
    id: u32

@driver
pub struct BlkDriver:
    held: Mmio[VirtioIrqMmio]
    sectors: u64

    init(mut self, take regs: Mmio[VirtioIrqMmio], sectors: u64):
        self.held = take regs
        self.sectors = sectors

    pub fn capacity(read self) -> u64:
        return self.sectors

@image
pub fn build() -> Image:
    img = Image(name="cap-mint", target=Target.wrela_machine_v1)
    blk_device = img.device[BlockHw](transport=0x2000)
    disk = img.driver(BlkDriver, device=blk_device, sectors=131072)
    img.supervise(
        children=[disk],
        strategy=Restart.OneForOne,
        intensity=RestartIntensity(max=3, within=seconds(10)),
    )
    return img.seal()
