module examples.boot_handle_index_distinct

# plans/M8.md item H attack 6: `resolve_runtime_test_args` (and the twin
# `boot_init_arg_word` path that materialises `decl.handle()` into an
# init argument) used to give `actor#i` and `driver#i` the *same* handle
# word — their own kind-local construction-order index. Item D's decision
# 22 recorded that as "harmless only while nothing reads a handle word";
# the guest *does* read them, through the `u32` `decl.handle()` spelling
# `boot-init-args` already pins.
#
# Witness: `Marker` is `actor#0` and `Stub` is `driver#0`. `Tags` stores
# both identities as `u32` via `.handle()`. Before the shared index space,
# both words were 0 and `distinct` returned 0 — a silent wrong answer
# about identity. After the fix, actors occupy `0..n_actors` and drivers
# occupy `n_actors..`, so the two words differ and `distinct` returns 1.
# A one-line revert of `actor_driver_handle_word`'s driver arm makes this
# boot fail its assertion.
#
# Dispatch itself is still static-by-type today (codegen never loads the
# handle word to pick a mailbox), so this is an identity hole, not a
# live mis-delivery — but identity is what a handle *is*, and the day
# handles become dynamic the colliding space would deliver to the wrong
# root.

struct Hw:
    id: u32

enum Feature:
    Flush

@driver
pub struct Stub:
    n: u64

    init(mut self, n: u64):
        self.n = n

    pub fn get(read self) -> u64:
        return self.n

@actor
pub struct Marker:
    n: u64

    init(mut self, n: u64):
        self.n = n

    pub fn get(read self) -> u64:
        return self.n

@actor
pub struct Tags:
    actor_id: u32
    driver_id: u32

    init(mut self, actor_id: u32, driver_id: u32):
        self.actor_id = actor_id
        self.driver_id = driver_id

    pub fn distinct(read self) -> u64:
        if self.actor_id != self.driver_id:
            return 1
        return 0

    pub fn actor_word(read self) -> u32:
        return self.actor_id

    pub fn driver_word(read self) -> u32:
        return self.driver_id

@test(runtime)
async fn handle_words_are_distinct(t: Actor[Tags]):
    v = await t.distinct()
    match v:
        case .Ok(n):
            assert n == 1, "actor#0 and driver#0 must not share a handle word"
        case .Err(_):
            assert false, "distinct rejected"
    # Concrete values: Marker is actor#0 → word 0; Tags is actor#1; Stub
    # is driver#0 → word 2 (= n_actors). A kind-local scheme would give
    # Stub word 0 and fail the first assert; a wrong shift fails these.
    a = await t.actor_word()
    match a:
        case .Ok(n):
            assert n == 0, "Marker is actor#0"
        case .Err(_):
            assert false, "actor_word rejected"
    d = await t.driver_word()
    match d:
        case .Ok(n):
            assert n == 2, "Stub is driver#0 after two actors"
        case .Err(_):
            assert false, "driver_word rejected"

@image
pub fn build() -> Image:
    img = Image(name="handle-index-distinct", target=Target.wrela_machine_v1)
    hw = img.device[Hw](transport=0x1000, required_features=[Feature.Flush])
    marker = img.actor(Marker, mailbox=4, n=7)
    stub = img.driver(Stub, device=hw, n=9)
    tags = img.actor(Tags, mailbox=4, actor_id=marker.handle(), driver_id=stub.handle())
    img.supervise(
        children=[marker, stub, tags],
        strategy=Restart.OneForOne,
        intensity=RestartIntensity(max=3, within=seconds(10)),
    )
    return img.seal()
