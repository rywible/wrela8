module examples.err_task_budget_removed

# plans/M13.md item C cut 7: `@task(budget=)` is an unimplemented scheduling
# promise the FIFO+RR scheduler cannot honor — cut with `@task(priority=)`.
# Twin of `err-task-priority-removed` (cut 6).

@layout(mmio, endian=little)
struct VirtioIrqMmio:
    @offset(0x060) interrupt_status: ReadOnly[u32]
    @offset(0x064) interrupt_ack: WriteOnly[u32]

struct VirtioBlock:
    id: u32

@driver
pub struct BlkDriver:
    regs: Mmio[VirtioIrqMmio]

    init(mut self, take cap: DeviceCap[VirtioBlock]):
        claimed = VirtioBlock.claim(cap=take cap)
        self.regs = claimed.map_partition(VirtioIrqMmio)

    @task(budget=us(200))
    fn drain(mut self):
        pass

@image
pub fn build() -> Image:
    img = Image(name="err-task-budget-removed", target=Target.wrela_machine_v1)
    blk = img.device[VirtioBlock](transport=0x2000)
    disk = img.driver(BlkDriver, device=blk)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
