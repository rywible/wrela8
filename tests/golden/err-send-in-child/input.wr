module examples.err_send_in_child


@actor
pub struct Logger:
    total: u64

    pub fn record(mut self, code: u64) -> unit:
        self.total = self.total + code
        return unit

async fn child(lg: Actor[Logger]) -> u64:
    send lg.record(code=1)
    return 1

@test(runtime)
async fn in_child(lg: Actor[Logger]):
    with group(capacity=1) as g:
        g.start(child, lg=lg)
        results = await g.join_all()
        for r in results:
            @discard(reason="migrated: deliberate Err discard (M13 item L)")
            match r:
                case .Ok(_):
                    pass
                case .Err(_):
                    pass

@image
pub fn build() -> Image:
    img = Image(name="err-send-in-child", target=Target.wrela_machine_v1)
    lg = img.actor(Logger, mailbox=64)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
