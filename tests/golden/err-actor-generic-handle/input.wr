module examples.err_actor_generic_handle


@actor
pub struct Box[T]:
    value: T
    tag: u64

    pub async fn tag_of(read self) -> u64:
        return self.tag

@actor
pub struct Caller:
    b: Actor[Box[u64]]

    pub async fn run(mut self) -> u64:
        v = await self.b.tag_of()
        match v:
            case .Ok(n):
                return n
            case .Err(_):
                return 0
