module examples.err_boot_irq_isr_runs

# plans/M7.md item G's **vacuity control** for the ISR HVF oracle.
#
# `golden/boot-irq-isr` is this same image. Its drain asserts
# `status == 1` (the masked level signal). That assertion alone would
# also be skipped — and the test would still report `ok` — on a boot
# that never delivered the vector (no checkpoint dispatch, no ISR, no
# wake). An all-zeros assertion set that never runs the ISR path passes
# on a boot that never raised anything; that is the class
# `err-boot-driver-init-runs` taught for init, and this file is the
# same lesson for the ISR → bottom-half edge.
#
# So this file inverts exactly one assertion — the drain's level-signal
# check — and pins the abort. A green `boot-irq-isr` plus this file's
# own `FAILED assertion failed: ...` line together say: the VMM really
# raised the vector, the checkpoint really called the ISR, the ISR
# really woke the bottom half, and the value drain compared is the
# published level signal.

@layout(mmio, endian=little)
struct VirtioIrqMmio:
    @offset(0x060) interrupt_status: ReadOnly[u32]
    @offset(0x064) interrupt_ack: WriteOnly[u32]

struct VirtioBlock:
    id: u32

@driver
pub struct BlkDriver:
    regs: Mmio[VirtioIrqMmio]
    irq: IrqCap[u32]
    pending: InterruptCell[u32]
    seen: u32

    init(mut self, take cap: DeviceCap[VirtioBlock]):
        claimed = VirtioBlock.claim(cap=take cap)
        self.regs = claimed.map_partition(VirtioIrqMmio)
        self.pending = InterruptCell(0)
        self.seen = 0
        s0 = self.regs.interrupt_status.read()
        assert s0 == 42241, "init saw host-written interrupt_status (0xA501)"
        irq = claimed.take_irq()
        irq.bind(self.on_queue_irq)
        irq.unmask()
        self.irq = take irq

    fn on_queue_irq(self):
        status = self.regs.interrupt_status.read()
        handled = status & 1
        if handled != 0:
            self.pending.fetch_or_release(handled)
            self.regs.interrupt_ack.write(handled)
            wake(BlkDriver.drain)

    @task
    fn drain(mut self):
        status = self.pending.swap_acquire(0)
        assert status == 0, "INVERTED ON PURPOSE: this is the vacuity control"
        self.seen = status

@actor
pub struct Ledger:
    marks: u64

    pub fn mark(mut self, n: u64) -> unit:
        self.marks = self.marks * 10 + n
        return unit

    pub fn read_marks(read self) -> u64:
        return self.marks

@test(runtime)
async fn irq_delivered(led: Actor[Ledger]):
    a = await led.mark(n=4)
    match a:
        case .Ok(_):
            pass
        case .Err(_):
            assert false, "mark rejected"
    b = await led.mark(n=2)
    match b:
        case .Ok(_):
            pass
        case .Err(_):
            assert false, "mark rejected"
    m = await led.read_marks()
    match m:
        case .Ok(v):
            assert v == 42, "two marks after ISR"
        case .Err(_):
            assert false, "read_marks rejected"

@image
pub fn build() -> Image:
    img = Image(name="err-boot-irq-isr-runs", target=Target.wrela_machine_v1)
    blk = img.device[VirtioBlock](transport=0x2000, vector=1)
    disk = img.driver(BlkDriver, device=blk)
    led = img.actor(Ledger, mailbox=8)
    img.supervise(children=[disk, led], strategy=Restart.OneForOne,
                  intensity=RestartIntensity(max=3, within=seconds(10)))
    return img.seal()
