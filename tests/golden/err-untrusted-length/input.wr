module examples.err_untrusted_length

# plans/M7.md item H2a, 03-hardware.md §8: an `Untrusted[T]` used as a
# length argument is a rejection naming `.checked_le(bound)`.

fn take_length(length: usize) -> usize:
    return length

fn bad(reported: Untrusted[usize]) -> usize:
    return take_length(reported)
