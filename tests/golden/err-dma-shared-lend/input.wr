module examples.err_dma_shared_lend


@layout(dma, endian=little)
struct RingControl:
    flags: u16
    idx: u16

struct BlockHw:
    id: u32

pool BlockControl

@driver
pub struct BlkDriver:
    sectors: u64

    fn peek_ring(read self, read ring: DmaShared[BlockControl, RingControl]) -> unit:
        return unit
