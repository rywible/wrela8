module examples.check_pixels_source_abi

from core.field import Field, Rgb, Vec3, mark, plane, translate
from core.render import (
    AoConfig,
    CameraBounds,
    LightConfig,
    MaterialSample,
    ProbeConfig,
    Renderer,
    RenderProfile,
    RgbRange,
    ScalarRange,
    SurfaceContext,
    ToneCurve,
)
from drivers.display import Display, DisplayDevice, Feature

pub struct SceneParams:
    @range(min=-2.0, max=2.0)
    pub height: f32

    @range(min=0, max=255)
    pub tint: u8

pub enum ObjectId:
    Ground

pub enum MaterialId:
    Ground

@actor
pub struct Consumer:
    renderer: Actor[Renderer[SceneParams]]

    init(mut self, renderer: Actor[Renderer[SceneParams]]):
        self.renderer = renderer

@image
pub fn build() -> Image:
    img = Image(name="pixels-source-abi", target=Target.wrela_machine_v1)
    display_device = img.device[DisplayDevice](
        transport=0x6000,
    )
    display = img.driver(Display, device=display_device, width=64, height=32, refresh_hz=60)
    renderer = img.renderer[SceneParams](
        field=world,
        material=shade,
        display=display,
        width=64,
        height=32,
        refresh_hz=60,
        shade_hz=60,
        profile=RenderProfile.AaaByteExact,
        tone_curve=ToneCurve.Linear,
        near=0.1,
        far=10.0,
        world_min=Vec3(x=-2.0, y=-2.0, z=-2.0),
        world_max=Vec3(x=2.0, y=2.0, z=2.0),
        camera_bounds=CameraBounds.bounded(max_motion=0.25),
        light_config=LightConfig.fixed(capacity=0),
        exposure_range=ScalarRange(min=-1.0, max=1.0),
        environment_range=RgbRange(
            min=Rgb(r=0.0, g=0.0, b=0.0),
            max=Rgb(r=1.0, g=1.0, b=1.0),
        ),
        ao=AoConfig.fixed(enabled=false),
        probes=ProbeConfig.fixed(enabled=false),
        initialization_deadline_ms=10,
    )
    handle: Actor[Renderer[SceneParams]] = renderer.handle()
    consumer = img.actor(Consumer, renderer=handle, mailbox=1)
    img.on_failure(policy=Failure.Halt)
    return img.seal()

@field
fn world(p: Vec3, read params: SceneParams) -> Field:
    shifted = translate(p, Vec3(x=0.0, y=params.height, z=0.0))
    return mark(
        plane(shifted, Vec3(x=0.0, y=1.0, z=0.0), offset=0.0),
        object=ObjectId.Ground,
        material=MaterialId.Ground,
    )

@material
fn shade(surface: SurfaceContext[MaterialId], read params: SceneParams) -> MaterialSample:
    return MaterialSample.standard(
        color=Rgb(r=0.25, g=0.5, b=0.75),
        roughness=0.03125.to[f32]() + params.tint.to[f32]() * 0.00375.to[f32](),
    )
