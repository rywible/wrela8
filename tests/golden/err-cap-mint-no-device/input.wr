module examples.err_cap_mint_no_device

# plans/M7.md item A, 03-hardware.md §1: "The device itself is named once,
# at the image binding (`img.driver(BlkDriver, device=blk_device)`), the
# single source of truth."
#
# `golden/check-cap-mint` is this file with `device=blk_device` restored.
# Without it there is no source of truth to mint from — and before item A
# this was *accepted*: plans/M4.md decision 7's substitution rule
# recognized a capability parameter by type name and called it "satisfied
# by the declaration's own device wiring" whether or not any wiring
# existed. This is the same rule, checked against the wiring it names.

struct BlockHw:
    id: u32

@driver
pub struct BlkDriver:
    sectors: u64

    init(mut self, take cap: DeviceCap[BlockHw], sectors: u64):
        self.sectors = sectors

    pub fn capacity(read self) -> u64:
        return self.sectors

@image
pub fn build() -> Image:
    img = Image(name="cap-mint", target=Target.wrela_machine_v1)
    blk_device = img.device[BlockHw](transport=0x2000)
    disk = img.driver(BlkDriver, sectors=131072)
    img.supervise(
        children=[disk],
        strategy=Restart.OneForOne,
        intensity=RestartIntensity(max=3, within=seconds(10)),
    )
    return img.seal()
