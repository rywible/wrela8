module examples.boot_actor_reply_result

# plans/M7.md item Z2 (decision 9c), the flip witness — and the direct
# replacement for `golden/err-actor-reply-aggregate`, which pinned the
# fail-closed rejection of exactly this program.
#
# WHAT M6-H1 FOUND, in this program's own words. A `pub` actor method
# declaring `Result[T, E]` is 02-language.md §9.4's own composition case
# (`declared Result[T, E] -> Result[T, CallError[E]]`). It compiled
# clean, and then BOTH paths arrived as `.Ok`: the turn record carried
# one scalar reply word, an aggregate return travels by pointer under
# this machine's calling convention, and the caller's composition
# re-labelled that pointer as `Ok(<guest address>)`. A declared
# `Err(FsError.Bad(107))` was observed as a success carrying an address —
# a wrong answer, the worst class this repo recognizes. The comptime
# evaluator ran the identical source correctly, so the two tiers
# genuinely disagreed, and no oracle spanned them: every test cited on
# `actors.calls.callerror-composition` was a `check-*` dump proving the
# *typing* and never once the runtime value.
#
# M6 fixed it by failing closed at the declaration. Item Z1 built the
# transport (a caller-owned staging slot published in the awaiting turn's
# own record, handed to the callee in `x8`), and this item finishes the
# job: it is now FIXED rather than REJECTED, and the assertions below are
# the value-level oracle that clause never had.
#
# WHY `Result` needed its own item. §9.4's composition is a **re-tagging,
# not a copy**:
#
#     staged Ok(v)   ->  composed Ok(v)
#     staged Err(e)  ->  composed Err(CallError.Op(e))
#
# so the delivered value and the caller's composed value genuinely have
# different shapes. They also have different *sizes*, in the direction
# that bites: the staged declared value is `8 + max(size(T), size(E))`
# and the composed temp's payload area is only
# `max(size(T), 8 + max(size(E), 8))`. `Store.wide` below is exactly the
# shape where the first exceeds the second — `Triple` is 24 bytes and
# `FsError` is 16, so 32 staged bytes would have to fit a 24-byte payload
# area — which is why the resume stub recomposes field-wise and never
# bulk-copies. (`codegen::emit_copy_staged_reply`'s bounds check turns
# getting that wrong into a loud build failure; routing this method
# through it reports "a staged reply of 32 byte(s) does not fit the
# composed result's own 24-byte payload area".)
#
# BOTH DISPATCH ARMS return a declared `Result`, so both are exercised:
#   - `Store.load` is **sync** — its return IS its turn's completion, and
#     it spills `x8` in the ordinary sync prologue.
#   - `Store.wide` is **async**: it parks on its own inner `await` and
#     only then returns its `Result`, so the staging pointer has to
#     survive the suspension in the persistent frame.
# `Probe.run`'s five await sites share ONE staging slot (decision 9b —
# one per fn, not one per site), sized to the widest declared reply over
# them (32 bytes, `Result[Triple, FsError]`); the narrower
# `Result[u64, FsError]` and the plain scalar `prime`/`stamp` replies
# ride the same frame area, so a recomposition that read past a narrow
# staged value would pick up the previous await's bytes.
#
# HAND-COMPUTED VALUES, pairwise distinct, none of them 0 (so a zeroed or
# stale slot cannot pass as a plausible answer), and no permutation of
# the `Triple` fields survives:
#   - `Store.load(key=1)` -> `Ok(42)`
#   - `Store.load(key=7)` -> `Err(FsError.Bad(7 + 100        = 107))`
#   - `Store.prime()` sets, from `n = 1000`:
#       good = `Ok(Triple(a = n + 1     = 1001,
#                         b = n * 2 + 2 = 2002,
#                         c = n * 3 + 3 = 3003))`
#       bad  = `Err(FsError.Bad(n * 4 + 4 = 4004))`
#   - `Clerk.stamp()` -> 700 + 7 = 707, the scalar reply `Store.wide`
#     parks on — asserted too, because it proves the M6 scalar path is
#     untouched inside the very image that exercises the wide one.
# The two `Err` payloads (107, 4004) are read out from INSIDE the
# `CallError.Op` payload, not merely observed to be `Err`: an `Err` that
# arrives as an `Err` carrying a guest address would still have passed
# the weaker check, which is precisely the bug M6-H1 found.
#
# SHAPES THE LANGUAGE PUSHES BACK ON, worked with rather than fought:
#   - 02-language.md §9.2's cross-await rule rejects every non-`self`-
#     rooted field access after an `await` in the same fn, and an awaiting
#     fn has one by construction. So `Probe.run` stores whole replies into
#     `self` (a self-rooted assignment, which the rule permits) and the
#     assertions read the fields back through plain sync methods — which
#     proves the stronger fact anyway: the bytes are correct where the
#     *caller* can see them, not merely where the callee wrote them.
#   - `flowwir_lower` lowers neither a struct construction nor an
#     `Ok(..)`/`Err(..)` construction inside an async body, so
#     `Store.wide` cannot build its own reply. It returns one of two
#     `Result[Triple, FsError]` fields a *sync* method (`Store.prime`)
#     built earlier — which is why `prime` exists at all. `Store` also
#     cannot carry an `init`, because its `clerk` field is image-bound.

pub enum FsError deriving(From):
    Bad(u64)

pub struct Triple:
    a: u64
    b: u64
    c: u64

    init(mut self, a: u64, b: u64, c: u64):
        self.a = a
        self.b = b
        self.c = c

@actor
pub struct Clerk:
    n: u64

    init(mut self):
        self.n = 700

    pub fn stamp(read self) -> u64:
        return self.n + 7

@actor
pub struct Store:
    clerk: Actor[Clerk]
    good: Result[Triple, FsError]
    bad: Result[Triple, FsError]
    seen: u64

    # Sync, and the only place the two wide replies can be built at all
    # (see the header's last note).
    pub fn prime(mut self) -> u64:
        n: u64 = 1000
        self.good = Ok(Triple(a=n + 1, b=n * 2 + 2, c=n * 3 + 3))
        self.bad = Err(FsError.Bad(n * 4 + 4))
        return n

    # M6-H1's own program, verbatim: the method that used to deliver both
    # arms as `.Ok`, and that `golden/err-actor-reply-aggregate` pinned as
    # rejected-at-declaration until this item.
    pub fn load(read self, key: u64) -> Result[u64, FsError]:
        if key == 1:
            return Ok(42)
        return Err(FsError.Bad(key + 100))

    # The async dispatch arm, and the wide-`T` case: `Triple` (24 bytes)
    # is wider than `FsError` (16), so the staged declared value is wider
    # than the composed temp's whole payload area.
    pub async fn wide(mut self, key: u64) -> Result[Triple, FsError]:
        s = await self.clerk.stamp()
        match s:
            case .Ok(v):
                self.seen = v
            case .Err(_):
                pass
        if key == 1:
            return self.good
        return self.bad

    pub fn seen(read self) -> u64:
        return self.seen

@actor
pub struct Probe:
    store: Actor[Store]
    narrow_ok: u64
    narrow_err: u64
    trip: Triple
    wide_err: u64

    pub async fn run(mut self) -> unit:
        p = await self.store.prime()
        match p:
            case .Ok(_):
                pass
            case .Err(_):
                pass
        a = await self.store.load(key=1)
        match a:
            case .Ok(v):
                self.narrow_ok = v
            case .Err(_):
                pass
        b = await self.store.load(key=7)
        match b:
            case .Ok(_):
                pass
            case .Err(e):
                match e:
                    case .Op(fe):
                        match fe:
                            case .Bad(code):
                                self.narrow_err = code
                    case _:
                        pass
        c = await self.store.wide(key=1)
        match c:
            case .Ok(t):
                self.trip = t
            case .Err(_):
                pass
        d = await self.store.wide(key=7)
        match d:
            case .Ok(_):
                pass
            case .Err(e2):
                match e2:
                    case .Op(fe2):
                        match fe2:
                            case .Bad(code2):
                                self.wide_err = code2
                    case _:
                        pass
        return unit

    pub fn narrow_ok(read self) -> u64:
        return self.narrow_ok

    pub fn narrow_err(read self) -> u64:
        return self.narrow_err

    pub fn trip_a(read self) -> u64:
        return self.trip.a

    pub fn trip_b(read self) -> u64:
        return self.trip.b

    pub fn trip_c(read self) -> u64:
        return self.trip.c

    pub fn wide_err(read self) -> u64:
        return self.wide_err

@test(runtime)
async fn result_replies(pr: Actor[Probe], st: Actor[Store]):
    f = await pr.run()
    match f:
        case .Ok(_):
            pass
        case .Err(_):
            assert false, "run rejected"
    v1 = await pr.narrow_ok()
    match v1:
        case .Ok(v):
            assert v == 42, "sync Result reply, Ok arm: Ok(42)"
        case .Err(_):
            assert false, "narrow_ok rejected"
    v2 = await pr.narrow_err()
    match v2:
        case .Ok(v):
            assert v == 107, "sync Result reply, Err arm: CallError.Op(FsError.Bad(key + 100))"
        case .Err(_):
            assert false, "narrow_err rejected"
    v3 = await pr.trip_a()
    match v3:
        case .Ok(v):
            assert v == 1001, "async wide Result reply, Ok arm: a is n + 1"
        case .Err(_):
            assert false, "trip_a rejected"
    v4 = await pr.trip_b()
    match v4:
        case .Ok(v):
            assert v == 2002, "async wide Result reply, Ok arm: b is n * 2 + 2"
        case .Err(_):
            assert false, "trip_b rejected"
    v5 = await pr.trip_c()
    match v5:
        case .Ok(v):
            assert v == 3003, "async wide Result reply, Ok arm: c is n * 3 + 3"
        case .Err(_):
            assert false, "trip_c rejected"
    v6 = await pr.wide_err()
    match v6:
        case .Ok(v):
            assert v == 4004, "async wide Result reply, Err arm: CallError.Op(FsError.Bad(n * 4 + 4))"
        case .Err(_):
            assert false, "wide_err rejected"
    v7 = await st.seen()
    match v7:
        case .Ok(v):
            assert v == 707, "the M6 scalar reply path is untouched: stamp() is n + 7"
        case .Err(_):
            assert false, "seen rejected"

@image
pub fn build() -> Image:
    img = Image(name="boot-actor-reply-result", target=Target.wrela_machine_v1)
    ck = img.actor(Clerk, mailbox=4)
    st = img.actor(Store, mailbox=4, clerk=ck)
    pr = img.actor(Probe, mailbox=4, store=st)
    img.supervise(children=[ck, st, pr], strategy=Restart.OneForOne,
                  intensity=RestartIntensity(max=3, within=seconds(10)))
    return img.seal()
