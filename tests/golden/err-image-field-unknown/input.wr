module examples.err_image_field_unknown


@actor
pub struct Store:
    value: u64

    pub fn get(read self) -> u64:
        return self.value

@test(runtime)
async fn smoke(store: Actor[Store]):
    v = await store.get()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match v:
        case .Ok(n):
            assert n == 0, "a zero-initialized Store reads 0"
        case .Err(_):
            assert false, "call rejected"

@image
pub fn build() -> Image:
    img = Image(name="field-unknown", target=Target.wrela_machine_v1)
    store = img.actor(Store, mailbox=4, queue_depth=8)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
