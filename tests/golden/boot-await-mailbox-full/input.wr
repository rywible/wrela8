module examples.boot_await_mailbox_full

# plans/M10.md item J — `CallError::NotAdmitted` is a real deliverable.
#
# 02-language.md §9.4 names this outcome by name: `NotAdmitted(Admission)
# # never ran: mailbox full`. Until item J the turn record had one scalar
# reply word and no tag, so a rejected `await` enqueue had nothing honest
# to deliver and aborted (M6 item H3's legible abort). The reply tag makes
# `Ok` / `Cancelled` / `NotAdmitted` three values on the same channel;
# filling a two-slot mailbox then `await`ing resolves `Err(NotAdmitted)`
# and the test continues.

@actor
pub struct Logger:
    total: u64

    pub fn record(mut self, code: u64) -> unit:
        self.total = self.total + code
        return unit

    pub fn read_total(read self) -> u64:
        return self.total

@test(runtime)
async fn await_into_full_mailbox(lg: Actor[Logger]):
    filled: u64 = 0
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match send lg.record(code=1):
        case .Ok(_):
            filled = filled + 1
        case .Err(_):
            pass
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match send lg.record(code=2):
        case .Ok(_):
            filled = filled + 1
        case .Err(_):
            pass
    assert filled == 2, "the two-slot mailbox is now full"
    t = await lg.read_total()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match t:
        case .Ok(_):
            assert false, "await into a full mailbox must be NotAdmitted"
        case .Err(_):
            pass

@image
pub fn build() -> Image:
    img = Image(name="boot-await-mailbox-full", target=Target.wrela_machine_v1)
    lg = img.actor(Logger, mailbox=2)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
