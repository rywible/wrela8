module examples.err_mut_param_defaulted_writeback

# plans/M9.md item CC1, decision 69. A `mut` parameter with a default,
# called with the argument elided, has no call-site place to mirror
# into. Before this item the mutation was silently discarded; now the
# evaluator fails closed by name rather than inventing a place or
# dropping the write-back.

fn bump(mut x: u32 = 0):
    x = 5

fn drive() -> u32:
    bump()
    return 1

const V: u32 = drive()

@actor
pub struct Sink:
    v: u32

    init(mut self, v: u32):
        self.v = v

@image
pub fn build() -> Image:
    img = Image(name="mut-default", target=Target.wrela_machine_v1)
    s = img.actor(Sink, v=V, mailbox=4)
    img.supervise(children=[s], strategy=Restart.OneForOne,
                  intensity=RestartIntensity(max=3, within=seconds(10)))
    return img.seal()
