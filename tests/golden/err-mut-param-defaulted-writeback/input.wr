module examples.err_mut_param_defaulted_writeback


fn bump(mut x: u32 = 0):
    x = 5

fn drive() -> u32:
    bump()
    return 1

const V: u32 = drive()

@actor
pub struct Sink:
    v: u32

    init(mut self, v: u32):
        self.v = v

@image
pub fn build() -> Image:
    img = Image(name="mut-default", target=Target.wrela_machine_v1)
    s = img.actor(Sink, v=V, mailbox=4)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
