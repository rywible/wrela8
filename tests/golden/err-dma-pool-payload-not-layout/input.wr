module examples.err_dma_pool_payload_not_layout


struct Payload:
    id: u32

struct BlockHw:
    id: u32

pool Payloads

@image
pub fn build() -> Image:
    img = Image(name="x", target=Target.wrela_machine_v1)
    blk = img.device[BlockHw](transport=0x2000)
    buffers = img.dma_pool[Payload](name=Payloads, device=blk, count=4)
    return img.seal()
