module lib


pub fn fallible(x: u32) -> Result[u32, u32]:
    if x == 0:
        return Err(11)
    return Ok(x * 2)

pub fn propagates(x: u32) -> Result[u32, u32]:
    v = fallible(x)?
    return Ok(v + 1)

pub fn opt(x: u32) -> Option[u32]:
    if x == 0:
        return None
    return Some(x)

pub fn opt_propagates(x: u32) -> Option[u32]:
    v = opt(x)?
    return Some(v + 100)
