module examples.cost_arith_w


pub fn wrap_mul_u32(a: u32, b: u32) -> u32:
    m0: u32 = a *% b
    m1: u32 = a *% b
    m2: u32 = a *% b
    m3: u32 = a *% b
    m4: u32 = a *% b
    m5: u32 = a *% b
    return m0 +% m1 +% m2 +% m3 +% m4 +% m5

pub fn wrap_mul_u16(a: u16, b: u16) -> u16:
    m0: u16 = a *% b
    m1: u16 = a *% b
    return m0 +% m1

pub fn wrap_mul_i16(a: i16, b: i16) -> i16:
    m0: i16 = a *% b
    m1: i16 = a *% b
    return m0 +% m1

pub fn wrap_mul_u64(a: u64, b: u64) -> u64:
    m0: u64 = a *% b
    m1: u64 = a *% b
    return m0 +% m1

pub fn checked_mul_u32(a: u32, b: u32) -> u32:
    return a * b
