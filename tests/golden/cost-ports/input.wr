module examples.cost_ports


pub fn alu_wide(a: u64, b: u64, c: u64) -> u64:
    p0: u64 = a +% b
    p1: u64 = b +% c
    p2: u64 = c +% a
    p3: u64 = a +% c
    p4: u64 = b +% a
    p5: u64 = c +% b
    p6: u64 = a +% a
    p7: u64 = b +% b
    p8: u64 = c +% c
    p9: u64 = p0 +% p1
    p10: u64 = p2 +% p3
    p11: u64 = p4 +% p5
    q0: u64 = p6 +% p7
    q1: u64 = p8 +% p9
    q2: u64 = p10 +% p11
    return q0 +% q1 +% q2

pub fn store_dense(mut v: [u64; 16]) -> [u64; 16]:
    v[0] = 1
    v[1] = 2
    v[2] = 3
    v[3] = 4
    v[4] = 5
    v[5] = 6
    v[6] = 7
    v[7] = 8
    v[8] = 9
    v[9] = 10
    v[10] = 11
    v[11] = 12
    v[12] = 13
    v[13] = 14
    v[14] = 15
    v[15] = 16
    return v

pub fn load_fan(v: [u64; 12]) -> u64:
    t0: u64 = v[0] +% v[1]
    t1: u64 = v[2] +% v[3]
    t2: u64 = v[4] +% v[5]
    t3: u64 = v[6] +% v[7]
    t4: u64 = v[8] +% v[9]
    t5: u64 = v[10] +% v[11]
    return t0 +% t1 +% t2 +% t3 +% t4 +% t5
