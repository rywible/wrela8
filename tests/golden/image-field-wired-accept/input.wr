module examples.image_field_wired_accept

# `image.graph.init-args-match`, the literal-constructor half: 05-library.md
# §9 says an actor declaration's arguments "must match `A.init` **(or its
# literal constructor)** after generated capabilities and handles are
# substituted". A struct that declares no `init` is constructed by its
# literal constructor — its own declared fields — so a wiring argument may
# name a *field*, not only an `init` parameter.
#
# `Worker` declares no `init` at all and is wired `led=led`, matching its
# own `led: Actor[Ledger]` field. Until 2026-07-24 the graph check handed
# a no-`init` struct an empty parameter list and rejected every such
# argument by name, so an image of exactly this shape could not reach
# `--stage=image`, `--stage=report` or `wrela build` — which is why this
# case pins the *report*, not just the raw graph dump.
#
# `Worker.pending` (and `Ledger.marks`) are deliberately left unwired: a
# declared field is not a missing `init` argument. The boot sequence
# zero-initializes every actor's whole state slot before any turn runs
# (`layout::build_boot_init`), so an unsupplied field already has a
# defined value, and 05 §9's own "a resource `init` argument without one
# recovery source is a build error" names `init` arguments.

@actor
pub struct Ledger:
    marks: u64

    pub fn mark(mut self, n: u64) -> unit:
        self.marks = self.marks + n
        return unit

@actor
pub struct Worker:
    led: Actor[Ledger]
    pending: u64

@image
pub fn build() -> Image:
    img = Image(name="field-wired", target=Target.wrela_machine_v1)
    led = img.actor(Ledger, mailbox=8)
    w = img.actor(Worker, mailbox=8, led=led)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
