module examples.image_field_wired_accept


@actor
pub struct Ledger:
    marks: u64

    pub fn mark(mut self, n: u64) -> unit:
        self.marks = self.marks + n
        return unit

@actor
pub struct Worker:
    led: Actor[Ledger]
    pending: u64

@image
pub fn build() -> Image:
    img = Image(name="field-wired", target=Target.wrela_machine_v1)
    led = img.actor(Ledger, mailbox=8)
    w = img.actor(Worker, mailbox=8, led=led)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
