module app.main

from lib.helpers import used, never_called_a, never_called_b

@actor
pub struct Store:
    n: u32

    init(mut self):
        self.n = 0

    pub fn bump(mut self) -> u32:
        self.n = used(self.n)
        return self.n

@image
pub fn build() -> Image:
    img = Image(name="import-reachable-only", target=Target.wrela_machine_v1)
    a = img.actor(Store, mailbox=8)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
