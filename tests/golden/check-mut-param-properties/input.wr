module examples.check_mut_param_properties

# plans/M9.md item CC, orchestrator review. 02-language.md §5.1: "Non-
# receiver `mut` and `take` are **mirrored at the call site**." Item CC
# built that mirroring; this case pins the *properties* it must have,
# rather than the cases it was built from — `check-mut-param-nested`
# covers the mechanism, this covers the ways a write-back mechanism is
# classically wrong: clobbering a param the callee never wrote, ignoring
# control flow so an early return publishes a later write, losing a
# `defer`'s contribution, crossing two `mut` params, and destroying a
# sibling field that was not assigned.
#
# Every expected value is chosen so no other branch can produce it: a
# missing write-back, an over-eager write-back, and a crossed write-back
# each land on a different number than the correct one.

struct Counter:
    n: u32

struct Pair:
    a: u32
    b: u32

# --- 1. A callee that does NOT write its `mut` param must not clobber it.
fn no_write(mut c: Counter):
    x: u32 = c.n + 1

fn probe_no_write() -> u32:
    c = Counter(n=5)
    no_write(mut c)
    return c.n              # must stay 5, not 0 and not 6

# --- 2. Early return before the write: the write must NOT be visible.
fn early_return(mut c: Counter, bail: bool):
    if bail:
        return
    c.n = 77

fn probe_early_bail() -> u32:
    c = Counter(n=3)
    early_return(mut c, true)
    return c.n              # must stay 3

fn probe_early_through() -> u32:
    c = Counter(n=3)
    early_return(mut c, false)
    return c.n              # must be 77

# --- 3. Write, then early return AFTER the write: must be visible.
fn write_then_return(mut c: Counter):
    c.n = 88
    return

fn probe_write_then_return() -> u32:
    c = Counter(n=0)
    write_then_return(mut c)
    return c.n              # must be 88

# --- 4. Nested frames: a `mut` callee passes its own `mut` param onward.
fn inner(mut c: Counter):
    c.n = c.n * 10

fn outer(mut c: Counter):
    inner(mut c)
    inner(mut c)

fn probe_nested_frames() -> u32:
    c = Counter(n=2)
    outer(mut c)
    return c.n              # 2 -> 20 -> 200

# --- 5. Two distinct `mut` params in one signature must not cross-write.
fn two_muts(mut p: Counter, mut q: Counter):
    p.n = 1
    q.n = 2

fn probe_two_muts() -> u32:
    p = Counter(n=0)
    q = Counter(n=0)
    two_muts(mut p, mut q)
    return p.n * 100 + q.n  # must be 102, not 101 or 202

# --- 6. `mut` alongside `read` and `take` in one signature.
fn mixed(mut m: Counter, r: Counter, take t: Counter) -> u32:
    m.n = r.n + t.n
    return m.n * 2

fn probe_mixed() -> u32:
    m = Counter(n=0)
    r = Counter(n=4)
    t = Counter(n=6)
    ret = mixed(mut m, r, take t)
    return ret * 1000 + m.n # 20 * 1000 + 10 = 20010

# --- 7. Write-back under an active `defer` that also touches the param.
fn deferred(mut c: Counter):
    defer:
        c.n = c.n + 1
    c.n = 30

fn probe_defer() -> u32:
    c = Counter(n=0)
    deferred(mut c)
    return c.n              # 30 then defer -> 31

# --- 8. `mut` param inside a loop in the CALLER, repeated calls.
fn add_one(mut c: Counter):
    c.n = c.n + 1

fn probe_loop() -> u32:
    c = Counter(n=0)
    i: u32 = 0
    @budget(bound=1000000)
    while i < 5:
        add_one(mut c)
        i = i + 1
    return c.n              # must be 5

# --- 9. Aggregate with two fields: only one written, other preserved.
fn touch_a(mut p: Pair):
    p.a = 9

fn probe_partial() -> u32:
    p = Pair(a=0, b=6)
    touch_a(mut p)
    return p.a * 10 + p.b   # must be 96, proving b survived

const P1: u32 = probe_no_write()
const P2: u32 = probe_early_bail()
const P3: u32 = probe_early_through()
const P4: u32 = probe_write_then_return()
const P5: u32 = probe_nested_frames()
const P6: u32 = probe_two_muts()
const P7: u32 = probe_mixed()
const P8: u32 = probe_defer()
const P9: u32 = probe_loop()
const P10: u32 = probe_partial()

@test
pub fn t_no_write():
    assert P1 == 5, "a callee that never writes its `mut` param leaves it alone"

@test
pub fn t_early_bail():
    assert P2 == 3, "an early return before the write is not visible"

@test
pub fn t_early_through():
    assert P3 == 77, "falling through to the write is visible"

@test
pub fn t_write_then_return():
    assert P4 == 88, "a write before an explicit return is visible"

@test
pub fn t_nested_frames():
    assert P5 == 200, "write-back composes through nested `mut` frames"

@test
pub fn t_two_muts():
    assert P6 == 102, "two `mut` params do not cross-write"

@test
pub fn t_mixed():
    assert P7 == 20010, "`mut` alongside `read` and `take` in one signature"

@test
pub fn t_defer():
    assert P8 == 31, "a `defer` that touches the `mut` param is included"

@test
pub fn t_loop():
    assert P9 == 5, "repeated calls in a caller loop each write back"

@test
pub fn t_partial():
    assert P10 == 96, "an unwritten sibling field survives write-back"
