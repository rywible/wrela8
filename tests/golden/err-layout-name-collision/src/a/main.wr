module a.main


from z.other import helper

@layout(dma, endian=little)
struct Ctl:
    tiny: u8

struct BlockHw:
    id: u32

@driver
pub struct BlkDriver:
    sectors: u64

    init(mut self, sectors: u64):
        self.sectors = sectors

    pub fn capacity(read self) -> u64:
        return self.sectors + helper()

pool Control

@image
pub fn build() -> Image:
    img = Image(name="layout-name-collision", target=Target.wrela_machine_v1)
    blk = img.device[BlockHw](transport=0x2000)
    disk = img.driver(BlkDriver, device=blk, sectors=2048)
    c = img.dma_pool[Ctl](name=Control, device=blk, count=4)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
