module examples.check_driver_mode_poll

# plans/M7.md item G, decision 18: `BlkDriver[DriverMode.Poll]` eliminates
# the ISR and vector (03-hardware.md §7). Same `@task drain` as the IRQ
# twin — callers are identical; the emitted graph is not (no `vector=`,
# no `IrqHostInject`, no `on_queue_irq` in mwir, smaller checkpoint).

@layout(mmio, endian=little)
struct VirtioIrqMmio:
    @offset(0x060) interrupt_status: ReadOnly[u32]
    @offset(0x064) interrupt_ack: WriteOnly[u32]

struct VirtioBlock:
    id: u32

@driver
pub struct BlkDriver[const MODE: DriverMode]:
    regs: Mmio[VirtioIrqMmio]
    pending: InterruptCell[u32]
    claimed_state: DriverClaimedDevice[VirtioBlock]

    init(mut self, take cap: DeviceCap[VirtioBlock]):
        claimed = VirtioBlock.claim(cap=take cap)
        self.regs = claimed.map_partition(VirtioIrqMmio)
        self.pending = InterruptCell(0)
        comptime if MODE == DriverMode.Irq:
            irq = claimed.take_irq()
            irq.bind(self.on_queue_irq)
            irq.unmask()
        comptime else:
            self.claimed_state = take claimed

    comptime if MODE == DriverMode.Irq:
        fn on_queue_irq(self):
            status = self.regs.interrupt_status.read()
            handled = status & 1
            if handled != 0:
                self.pending.fetch_or_release(handled)
                self.regs.interrupt_ack.write(handled)
                wake(BlkDriver.drain)

    @task
    fn drain(mut self):
        status = self.pending.swap_acquire(0)
        if status != 0:
            wake(BlkDriver.drain)

@image
pub fn build() -> Image:
    img = Image(name="check-driver-mode-poll", target=Target.wrela_machine_v1)
    blk = img.device[VirtioBlock](transport=0x2000)
    disk = img.driver(BlkDriver[DriverMode.Poll], device=blk)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
