# Minimized from a fuzz find (M2-H's deep run): a bodyless method — the
# parser's doc-table signature shorthand — panicked access.rs's
# receiver-effect inference. Sema now fails closed on bodyless fns.
module examples.bodyless

pub struct Widget:
    count: u64

    fn helper(self) -> u64

    pub fn poke(mut self):
        self.count = self.helper()
