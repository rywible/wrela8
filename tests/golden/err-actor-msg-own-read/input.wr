module examples.err_actor_msg_own_read


pool Packets

resource struct Packet:
    pub n: u64

@actor
pub struct Sink:
    pub fn ingest(read self, take p: own[Packets] Packet) -> u64:
        return p.n

@actor
pub struct Src:
    pkt: own[Packets] Packet
    sink: Actor[Sink]

    pub async fn go(mut self) -> Result[u64, CallError[never]]:
        r = await self.sink.ingest(self.pkt)?
        return Ok(r + self.pkt.n)
