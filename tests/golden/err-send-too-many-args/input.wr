module examples.err_send_too_many_args

# plans/M10.md item D: the by-value mailbox admission ABI carries x1/x2
# only (decision 610). More than two scalar message args is refused at
# emit_marshal_and_call — the milestone's register-budget guard, which
# had never had a golden.

@actor
pub struct Sink:
    pub fn take3(mut self, a: u64, b: u64, c: u64) -> unit:
        return unit

@test(runtime)
async fn send_three(s: Actor[Sink]):
    send s.take3(a=1, b=2, c=3)

@image
pub fn build() -> Image:
    img = Image(name="err-send-too-many-args", target=Target.wrela_machine_v1)
    s = img.actor(Sink, mailbox=4)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
