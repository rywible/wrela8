module examples.err_cap_drop_wrapped


struct BlockHw:
    id: u32

struct CapBundle:
    cap: DeviceCap[BlockHw]

@driver
pub struct BlkDriver:
    sectors: u64

    init(mut self, take cap: DeviceCap[BlockHw], sectors: u64):
        self.sectors = sectors
        bundle = CapBundle(cap=take cap)
        return

    pub fn capacity(read self) -> u64:
        return self.sectors

@image
pub fn build() -> Image:
    img = Image(name="err-cap-drop-wrapped", target=Target.wrela_machine_v1)
    blk_device = img.device[BlockHw](transport=0x2000)
    disk = img.driver(BlkDriver, device=blk_device, sectors=131072)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
