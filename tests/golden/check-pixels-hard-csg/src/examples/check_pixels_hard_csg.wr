module examples.check_pixels_hard_csg

# @wrela-compiler-internal: this fixture names the compiler-reserved Pixels
# surface in order to pin its contract; see sema::check_reserved_source_names.
from core.runtime import __wrela_trace_p7_u64

from core.field import (
    Field,
    Rgb,
    Vec3,
    box,
    intersection,
    mark,
    sphere,
    subtract,
    translate,
    union,
)
from core.render import (
    AoConfig,
    Camera,
    CameraBounds,
    LightConfig,
    LightFrame,
    MaterialSample,
    ProbeConfig,
    RenderFrame,
    Renderer,
    RenderProfile,
    RgbRange,
    ScalarRange,
    SurfaceContext,
    ToneCurve,
    __wrela_pixels_p7_debug_alpha_samples,
    __wrela_pixels_p7_debug_certified_run_word,
    __wrela_pixels_p7_debug_frame_digest,
)
from drivers.display import Display, DisplayDevice

const FIXTURE_ID: u32 = 2
# P3 partitions these hard operations into explicit occupancy logic.

fn fixture_id() -> u32:
    return FIXTURE_ID

const LEFT_CENTER_X_RAW: i32 = -1
const RIGHT_CENTER_X_RAW: i32 = 1

struct SceneParams:
    @range(min=-2.0, max=2.0)
    @rate(max_delta=0.25, max_second_delta=0.0625)
    phase: f32

enum MaterialId:
    Ground

@field
fn world(p: Vec3, read params: SceneParams) -> Field:
    left = sphere(p, Vec3(x=-1.0, y=0.0, z=0.0), radius=1.0)
    right = box(translate(p, Vec3(x=1.0, y=0.0, z=0.0)), Vec3(x=1.0, y=1.0, z=1.0))
    shell = subtract(union(left, right), intersection(left, right))
    return mark(shell, object=MaterialId.Ground, material=MaterialId.Ground)

@material
fn shade(surface: SurfaceContext[MaterialId], read params: SceneParams) -> MaterialSample:
    return MaterialSample.standard(color=Rgb(r=0.25, g=0.5, b=0.75), roughness=0.5)

@test(runtime)
fn pinned_scene_contract():
    assert FIXTURE_ID == 2, "fixture id must remain pinned"
    assert LEFT_CENTER_X_RAW == -1, "adversarial scene value must remain pinned"

@actor
struct HardCsgSweepProbe:
    renderer: Actor[Renderer[SceneParams]]

    init(mut self, renderer: Actor[Renderer[SceneParams]]):
        self.renderer = renderer

    pub async fn run(mut self) -> u32:
        frame = RenderFrame[SceneParams](
            params=SceneParams(phase=0.0),
            camera=Camera.canonical(eye=Vec3(x=0.0, y=0.0, z=-4.35)),
            lights=LightFrame.empty(),
            exposure=0.0,
            environment=Rgb(r=0.0, g=0.0, b=0.0),
            frame_index=2,
        )
        rendered = await self.renderer.render(frame=take frame)
        @discard(reason="the runtime assertion converts every render error into fixture failure")
        match rendered:
            case .Ok(value):
                __wrela_trace_p7_u64(value.certificate_runs)
                __wrela_trace_p7_u64(value.event_corridors)
                __wrela_trace_p7_u64(value.revalidated_proposals)
                __wrela_trace_p7_u64(5780180186688408645)
                __wrela_trace_p7_u64(__wrela_pixels_p7_debug_alpha_samples(0))
                evidence = __wrela_pixels_p7_debug_certified_run_word(0, 0, 0, 0)
                if evidence[0] == 1:
                    __wrela_trace_p7_u64(4847371096046259761)
                    evidence_word: usize = 0
                    @budget(bound=16)
                    while evidence_word < 16:
                        evidence = __wrela_pixels_p7_debug_certified_run_word(0, 0, 0, evidence_word)
                        assert evidence[0] == 1, "instrumented run evidence is complete"
                        __wrela_trace_p7_u64(evidence[1])
                        evidence_word = evidence_word + 1
                __wrela_trace_p7_u64(4922225244575680596)
                digest = __wrela_pixels_p7_debug_frame_digest(0)
                digest_word: usize = 1
                @budget(bound=4)
                while digest_word < 5:
                    __wrela_trace_p7_u64(digest[digest_word])
                    digest_word = digest_word + 1
                dump_header = __wrela_pixels_p7_debug_frame_dump_word(0, 0)
                if dump_header[0] == 1:
                    __wrela_trace_p7_u64(7599824371187933777)
                    dump_index: u64 = 1
                    @budget(bound=65551)
                    while dump_index <= dump_header[1]:
                        dump_value = __wrela_pixels_p7_debug_frame_dump_word(0, dump_index)
                        assert dump_value[0] == 1, "instrumented frame dump is complete"
                        __wrela_trace_p7_u64(dump_value[1])
                        dump_index = dump_index + 1
                return 0
            case .Err(call_error):
                match call_error:
                    case .Op(failure):
                        match failure.error:
                            case .RootIsolationExhausted(tile):
                                __wrela_trace_p7_u64(4294967296 + tile.value.to[u64]())
                            case .EventIsolationExhausted(tile):
                                __wrela_trace_p7_u64(8589934592 + tile.value.to[u64]())
                            case .CertificateExhausted(tile):
                                __wrela_trace_p7_u64(12884901888 + tile.value.to[u64]())
                            case .CapacityExceeded(capacity):
                                __wrela_trace_p7_u64(17179869184 + capacity.kind.to[u64]())
                            case .FixedPointRangeExceeded(tile):
                                __wrela_trace_p7_u64(21474836480 + tile.value.to[u64]())
                            case .InternalInvariant(invariant):
                                __wrela_trace_p7_u64(invariant.kind.to[u64]())
                            case _:
                                pass
                    case _:
                        pass
                return 1

@test(runtime)
async fn hard_csg_sweeps_composite_occupancy(probe: Actor[HardCsgSweepProbe]):
    rendered = await probe.run()
    @discard(reason="the assertion below converts actor-call failure into fixture failure")
    match rendered:
        case .Ok(status):
            assert status == 0, "hard-CSG visibility renders from scratch"
        case .Err(_):
            assert false, "hard-CSG probe call succeeds"

@image
pub fn build() -> Image:
    img = Image(name="check-pixels-hard-csg", target=Target.wrela_machine_v1)
    display_device = img.device[DisplayDevice](transport=0x6000)
    display = img.driver(Display, device=display_device, width=64, height=32, refresh_hz=60)
    renderer = img.renderer[SceneParams](
        field=world,
        material=shade,
        display=display,
        width=64,
        height=32,
        refresh_hz=60,
        shade_hz=60,
        profile=RenderProfile.AaaByteExact,
        tone_curve=ToneCurve.Linear,
        near=0.1,
        far=128.0,
        world_min=Vec3(x=-4.0, y=-4.0, z=-4.0),
        world_max=Vec3(x=4.0, y=4.0, z=4.0),
        camera_bounds=CameraBounds.bounded(max_motion=0.25),
        light_config=LightConfig.fixed(capacity=0),
        exposure_range=ScalarRange(min=-1.0, max=1.0),
        environment_range=RgbRange(
            min=Rgb(r=0.0, g=0.0, b=0.0),
            max=Rgb(r=1.0, g=1.0, b=1.0),
        ),
        ao=AoConfig.fixed(enabled=false),
        probes=ProbeConfig.fixed(enabled=false),
        initialization_deadline_ms=10,
    )
    probe = img.actor(HardCsgSweepProbe, renderer=renderer, mailbox=1)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
