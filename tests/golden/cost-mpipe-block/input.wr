module examples.cost_mpipe_block

# Cost-stage golden (plans/M20.md item M) — pipe M: the M-unit hold from
# sub-1/cycle throughput, SOG §3.6 note 4's `MADD` stall, note 5's
# `SMULH`/`UMULH` stall, and note 1's divide completion block.
#
# WHAT THIS PINS, PREDICTED FROM THE DOCS BEFORE THE CODE WAS RUN
# (bench/a76-pi5.toml `[latency.mul|mul_high|sdiv|udiv]`, `port_m = "4"`,
# and `score.rs`'s "a rate below 1/cycle **holds the functional unit**
# for ceil(thru_den / thru_num) cycles"):
#
#   * `mul` (X-form `MADD`): lat 4, thru 1/3, `m_pipe_stall = 2` — holds
#     pipe M for ceil(3/1) + 2 = **5** cycles against any other M uop.
#   * `mul_high` (`UMULH`): lat 5, thru 1/4, `m_pipe_stall = 3` — holds
#     pipe M for **7** cycles.
#   * `sdiv`/`udiv`: lat 20 (bracket 5-20, pinned pessimistic), thru
#     1/20, `m_pipe_block = 1` — a later divide cannot issue until this
#     one completes.
#
# The four fns are chosen so each term is reachable at all, which is not
# free: `score_words` runs **per basic block**, so every pipe and unit
# hold resets at a block boundary, and wrela emits an abort branch
# immediately after every checked-arithmetic overflow or divide-by-zero
# check (`compiler.codegen.naive-locked`).
#
#   wrap_mul     six `*%` — no check, no branch, so **six `mul` words in
#                one block**: the only shape in which the M unit is asked
#                to hold across more than one M uop at all. Measured by
#                ablation: the hold is *reachable* (raising
#                `m_pipe_stall` to 20 moves this fn 50 -> 133) but at the
#                pinned occupancy of 5 cycles it is **not binding** —
#                the frame's own load/store traffic already spaces the
#                multiplies more than five cycles apart.
#   checked_mul  six `*` — each emits `MADD` + `UMULH` and then the
#                overflow-check branch, so each block holds exactly one
#                M-uop pair. This is where the pinned stall costs: zeroing
#                `mul`'s `m_pipe_stall` moves this fn 171 -> 159, i.e.
#                exactly 2 cycles x 6 multiplies, SOG §3.6 note 4 to the
#                cycle. `mul_high`'s 3-cycle stall costs **nothing**,
#                because the `UMULH` is its block's last M uop.
#   div_chain    six `/` — the zero-check branch means **no two divides
#                ever share a block**, so `m_pipe_block` and the 20-cycle
#                M-unit hold are both live and unreachable here (zeroing
#                either moves nothing); what is reachable, and what this
#                fn pins, is the divide's own 20-cycle latency.
#   alu_chain    the control: same statement count, no M-pipe word, so
#                its Term list must carry no `mul` / `mul_high` /
#                `sdiv` / `udiv` row at all.
#
# `sdiv_chain` prices the signed row beside the unsigned one; both are
# the same T1 group and both carry `m_pipe_block`.

# Six wrapping multiplies: no overflow check, so no branch, so all six
# `mul` words land in one basic block and the M unit is held between
# them.
pub fn wrap_mul(a: u64, b: u64) -> u64:
    m0: u64 = a *% b
    m1: u64 = a *% b
    m2: u64 = a *% b
    m3: u64 = a *% b
    m4: u64 = a *% b
    m5: u64 = a *% b
    return m0 +% m1 +% m2 +% m3 +% m4 +% m5

# Six checked multiplies: `MADD` + `UMULH` per statement, then the
# overflow branch.
pub fn checked_mul(a: u64, b: u64) -> u64:
    m0: u64 = a * b
    m1: u64 = (a +% 1) * b
    m2: u64 = (a +% 2) * b
    m3: u64 = (a +% 3) * b
    m4: u64 = (a +% 4) * b
    m5: u64 = (a +% 5) * b
    return m0 +% m1 +% m2 +% m3 +% m4 +% m5

# Six unsigned divides, each behind its own zero-check branch.
pub fn div_chain(a: u64, b: u64) -> u64:
    d0: u64 = a / b
    d1: u64 = (a +% 1) / b
    d2: u64 = (a +% 2) / b
    d3: u64 = (a +% 3) / b
    d4: u64 = (a +% 4) / b
    d5: u64 = (a +% 5) / b
    return d0 +% d1 +% d2 +% d3 +% d4 +% d5

# The signed twin, so `sdiv` is priced beside `udiv`.
pub fn sdiv_chain(a: i64, b: i64) -> i64:
    d0: i64 = a / b
    d1: i64 = (a +% 1) / b
    d2: i64 = (a +% 2) / b
    return d0 +% d1 +% d2

# Control: the same six statements with no M-pipe word anywhere.
pub fn alu_chain(a: u64, b: u64) -> u64:
    m0: u64 = a +% b
    m1: u64 = (a +% 1) +% b
    m2: u64 = (a +% 2) +% b
    m3: u64 = (a +% 3) +% b
    m4: u64 = (a +% 4) +% b
    m5: u64 = (a +% 5) +% b
    return m0 +% m1 +% m2 +% m3 +% m4 +% m5
