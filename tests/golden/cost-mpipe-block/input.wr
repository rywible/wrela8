module examples.cost_mpipe_block


pub fn wrap_mul(a: u64, b: u64) -> u64:
    m0: u64 = a *% b
    m1: u64 = a *% b
    m2: u64 = a *% b
    m3: u64 = a *% b
    m4: u64 = a *% b
    m5: u64 = a *% b
    return m0 +% m1 +% m2 +% m3 +% m4 +% m5

pub fn checked_mul(a: u64, b: u64) -> u64:
    m0: u64 = a * b
    m1: u64 = (a +% 1) * b
    m2: u64 = (a +% 2) * b
    m3: u64 = (a +% 3) * b
    m4: u64 = (a +% 4) * b
    m5: u64 = (a +% 5) * b
    return m0 +% m1 +% m2 +% m3 +% m4 +% m5

pub fn div_chain(a: u64, b: u64) -> u64:
    d0: u64 = a / b
    d1: u64 = (a +% 1) / b
    d2: u64 = (a +% 2) / b
    d3: u64 = (a +% 3) / b
    d4: u64 = (a +% 4) / b
    d5: u64 = (a +% 5) / b
    return d0 +% d1 +% d2 +% d3 +% d4 +% d5

pub fn sdiv_chain(a: i64, b: i64) -> i64:
    d0: i64 = a / b
    d1: i64 = (a +% 1) / b
    d2: i64 = (a +% 2) / b
    return d0 +% d1 +% d2

pub fn alu_chain(a: u64, b: u64) -> u64:
    m0: u64 = a +% b
    m1: u64 = (a +% 1) +% b
    m2: u64 = (a +% 2) +% b
    m3: u64 = (a +% 3) +% b
    m4: u64 = (a +% 4) +% b
    m5: u64 = (a +% 5) +% b
    return m0 +% m1 +% m2 +% m3 +% m4 +% m5
