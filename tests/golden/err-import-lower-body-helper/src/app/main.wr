module app.main

from lib.a import outer

@actor
pub struct Store:
    n: u32

    init(mut self):
        self.n = 0

    pub fn run(mut self) -> u32:
        self.n = outer()
        return self.n

@image
pub fn build() -> Image:
    img = Image(name="err-import-lower-body-helper", target=Target.wrela_machine_v1)
    a = img.actor(Store, mailbox=4)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
