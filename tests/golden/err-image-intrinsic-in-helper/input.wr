module examples.err_image_intrinsic_in_helper

@actor
pub struct A:
    n: u32

    init(mut self):
        self.n = 0

fn add_actor(mut img: Image) -> unit:
    img.actor(A, mailbox=4)

@image
pub fn build() -> Image:
    img = Image(name="h", target=Target.wrela_machine_v1)
    add_actor(img)
    return img.seal()
