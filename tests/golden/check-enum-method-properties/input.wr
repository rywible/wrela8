module examples.check_enum_method_properties


enum State:
    Idle
    Running(u32)
    Done(u32)

    pub fn start(mut self, n: u32):
        self = State.Running(n)

    pub fn finish(mut self):
        match self:
            case .Running(n):
                self = State.Done(n * 10)
            case .Idle:
                self = State.Done(1)
            case .Done(n):
                self = State.Done(n)

    pub fn score(read self) -> u32:
        match self:
            case .Idle:
                return 1
            case .Running(n):
                return 200 + n
            case .Done(n):
                return 30000 + n

    pub fn consume(take self) -> u32:
        match self:
            case .Idle:
                return 7
            case .Running(n):
                return n + 70
            case .Done(n):
                return n + 700

    pub fn fresh(n: u32) -> State:
        return State.Running(n)

    pub fn double_score(read self) -> u32:
        return self.score() * 2

fn p_variant_change() -> u32:
    s = State.Idle
    s.start(5)
    return s.score()

fn p_chain() -> u32:
    s = State.Idle
    s.start(5)
    s.finish()
    return s.score()

fn p_no_clobber() -> u32:
    s = State.Done(4)
    s.finish()
    return s.score()

fn p_take() -> u32:
    s = State.Running(9)
    return s.consume()

fn p_assoc() -> u32:
    s = State.fresh(6)
    return s.score()

fn p_sibling() -> u32:
    s = State.Running(1)
    return s.double_score()

fn bump_state(mut s: State):
    s.start(8)

fn p_mut_param() -> u32:
    s = State.Idle
    bump_state(mut s)
    return s.score()

const P1: u32 = p_variant_change()
const P2: u32 = p_chain()
const P3: u32 = p_no_clobber()
const P4: u32 = p_take()
const P5: u32 = p_assoc()
const P6: u32 = p_sibling()
const P7: u32 = p_mut_param()

@test
pub fn t_variant_change():
    assert P1 == 205, "`mut self` on a sum may change the live variant"

@test
pub fn t_chain():
    assert P2 == 30050, "two chained `mut self` calls compose"

@test
pub fn t_no_clobber():
    assert P3 == 30004, "a `mut self` method that keeps the variant keeps the payload"

@test
pub fn t_take():
    assert P4 == 79, "`take self` on a sum"

@test
pub fn t_assoc():
    assert P5 == 206, "an enum associated fn constructs"

@test
pub fn t_sibling():
    assert P6 == 402, "an enum method calls a sibling method"

@test
pub fn t_mut_param():
    assert P7 == 208, "an enum through a non-receiver `mut` param writes back"
