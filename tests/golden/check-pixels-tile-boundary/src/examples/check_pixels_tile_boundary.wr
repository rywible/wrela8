module examples.check_pixels_tile_boundary

# @wrela-compiler-internal: this permanent fixture emits sealed P8 evidence.
from core.runtime import __wrela_trace_p7_u64

from core.field import (
    Field,
    Rgb,
    Vec3,
    box,
    mark,
)
from core.render import (
    AoConfig,
    Camera,
    CameraBounds,
    LightConfig,
    LightFrame,
    MaterialSample,
    ProbeConfig,
    RenderFrame,
    Renderer,
    RenderProfile,
    RgbRange,
    ScalarRange,
    SurfaceContext,
    ToneCurve,
    __wrela_pixels_p7_debug_alpha_samples,
)
from drivers.display import Display, DisplayDevice

const FIXTURE_ID: u32 = 17
# P8 owns the real 64-pixel scanout tile seam.

fn fixture_id() -> u32:
    return FIXTURE_ID

const TILE_WIDTH: u32 = 64
const EDGE_X: u32 = 64

struct SceneParams:
    @range(min=-2.0, max=2.0)
    @rate(max_delta=0.25, max_second_delta=0.0625)
    phase: f32

enum MaterialId:
    Ground

@field
fn world(p: Vec3, read params: SceneParams) -> Field:
    edge = box(p, Vec3(x=3.0, y=0.5, z=1.0))
    return mark(edge, object=MaterialId.Ground, material=MaterialId.Ground)

@material
fn shade(surface: SurfaceContext[MaterialId], read params: SceneParams) -> MaterialSample:
    return MaterialSample.standard(color=Rgb(r=0.25, g=0.5, b=0.75), roughness=0.5)

fn pinned_scene_contract():
    assert FIXTURE_ID == 17, "fixture id must remain pinned"
    assert TILE_WIDTH == 64, "machine-v1 tile width must remain pinned"
    assert EDGE_X == 64, "event must lie on the first real tile boundary"

@test(runtime)
# Keep this runtime name short: every instrumented trace temporarily preserves
# the in-progress test prefix in the bounded console arena.
async fn s(renderer: Actor[Renderer[SceneParams]]):
    pinned_scene_contract()
    frame = RenderFrame[SceneParams](params=SceneParams(phase=0.0), camera=Camera.canonical(eye=Vec3(x=0.0, y=0.0, z=-4.35)), lights=LightFrame.empty(), exposure=0.0, environment=Rgb(r=0.0, g=0.0, b=0.0), frame_index=17)
    result = await renderer.render(frame=take frame)
    @discard(reason="the exact result assertion converts every render failure into test failure")
    match result:
        case .Ok(rendered):
            __wrela_trace_p7_u64(rendered.certificate_runs)
            assert rendered.event_corridors <= 4294967295, "event count fits packed conformance word"
            assert rendered.revalidated_proposals <= 4294967295, "proposal count fits packed conformance word"
            __wrela_trace_p7_u64(
                rendered.event_corridors + rendered.revalidated_proposals * 4294967296
            )
            __wrela_trace_p7_u64(5780180186688408645)
            __wrela_trace_p7_u64(__wrela_pixels_p7_debug_alpha_samples(0))
            # This fixture spends its bounded transcript on the complete
            # 128x31 seam frame. Regular-run records are independently locked
            # by the remaining conformance scenes.
            __wrela_trace_p7_u64(4922225244575680596)
            digest_word: usize = 0
            @budget(bound=4)
            while digest_word < 4:
                packed: u64 = 0
                digest_byte: usize = 8
                @budget(bound=8)
                while digest_byte > 0:
                    digest_byte = digest_byte - 1
                    packed = packed * 256 + rendered.displayed_digest[digest_word * 8 + digest_byte].to[u64]()
                __wrela_trace_p7_u64(packed)
                digest_word = digest_word + 1
            dump_header = __wrela_pixels_p7_debug_frame_dump_word(0, 0)
            if dump_header[0] == 1:
                __wrela_trace_p7_u64(7599824371187933777)
                dump_index: u64 = 1
                @budget(bound=15)
                while dump_index <= 15:
                    dump_value = __wrela_pixels_p7_debug_frame_dump_word(0, dump_index)
                    assert dump_value[0] == 1, "instrumented frame metadata is complete"
                    __wrela_trace_p7_u64(dump_value[1])
                    dump_index = dump_index + 1
                # Full visible bytes and fixed-q evidence come from VMM binary
                # captures. Trace only the complete telemetry tail here.
                dump_index = dump_header[1] - 600
                @budget(bound=601)
                while dump_index <= dump_header[1]:
                    dump_value = __wrela_pixels_p7_debug_frame_dump_word(0, dump_index)
                    assert dump_value[0] == 1, "instrumented telemetry dump is complete"
                    __wrela_trace_p7_u64(dump_value[1])
                    dump_index = dump_index + 1
            assert rendered.frame_index == 0, "first tile-boundary frame is sequence zero"
            assert rendered.event_corridors > 0, "the diagonal crosses the tile seam as an event"
        case .Err(_):
            assert false, "tile-boundary event must render without a gap or double write"

@image
pub fn build() -> Image:
    img = Image(name="check-pixels-tile-boundary", target=Target.wrela_machine_v1)
    display_device = img.device[DisplayDevice](transport=0x6000)
    display = img.driver(Display, device=display_device, width=128, height=31, refresh_hz=60)
    renderer = img.renderer[SceneParams](
        field=world,
        material=shade,
        display=display,
        width=128,
        height=31,
        refresh_hz=60,
        shade_hz=60,
        profile=RenderProfile.AaaByteExact,
        tone_curve=ToneCurve.Linear,
        near=0.1,
        far=128.0,
        world_min=Vec3(x=-4.0, y=-4.0, z=-4.0),
        world_max=Vec3(x=4.0, y=4.0, z=4.0),
        camera_bounds=CameraBounds.bounded(max_motion=0.25),
        light_config=LightConfig.fixed(capacity=0),
        exposure_range=ScalarRange(min=-1.0, max=1.0),
        environment_range=RgbRange(
            min=Rgb(r=0.0, g=0.0, b=0.0),
            max=Rgb(r=1.0, g=1.0, b=1.0),
        ),
        ao=AoConfig.fixed(enabled=false),
        probes=ProbeConfig.fixed(enabled=false),
        initialization_deadline_ms=10,
    )
    img.on_failure(policy=Failure.Halt)
    return img.seal()
