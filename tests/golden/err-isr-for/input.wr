module examples.err_isr_for

# plans/M7.md item G self-audit: `for` shares the ISR "drain unbounded
# work" arm with `while` (golden/err-isr-while). Both are loops.

@layout(mmio, endian=little)
struct VirtioIrqMmio:
    @offset(0x060) interrupt_status: ReadOnly[u32]

struct VirtioBlock:
    id: u32

@driver
pub struct BlkDriver:
    regs: Mmio[VirtioIrqMmio]
    irq: IrqCap[u32]

    init(mut self, take cap: DeviceCap[VirtioBlock]):
        claimed = VirtioBlock.claim(cap=take cap)
        self.regs = claimed.map_partition(VirtioIrqMmio)
        irq = claimed.take_irq()
        irq.bind(self.on_queue_irq)
        self.irq = take irq

    fn on_queue_irq(self):
        for i in 0..1:
            pass

@image
pub fn build() -> Image:
    img = Image(name="err-isr-for", target=Target.wrela_machine_v1)
    blk = img.device[VirtioBlock](transport=0x2000, vector=1)
    disk = img.driver(BlkDriver, device=blk)
    img.supervise(children=[disk], strategy=Restart.OneForOne,
                  intensity=RestartIntensity(max=3, within=seconds(10)))
    return img.seal()
