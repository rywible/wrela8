module examples.err_image_unsupervised

@driver
pub struct Blk:
    id: u32

    init(mut self):
        self.id = 1

@actor
pub struct Store:
    count: u32

    init(mut self):
        self.count = 0

@image
pub fn build() -> Image:
    img = Image(name="unsupervised", target=Target.wrela_machine_v1)
    disk = img.driver(Blk)
    storage = img.actor(Store, mailbox=16)
    img.supervise(children=[disk], strategy=Restart.OneForOne,
                  intensity=RestartIntensity(max=3, within=seconds(10)))
    return img.seal()
