# Representative token slice: keywords, indentation, literals, operators.
module examples.tokens

const LIMIT: u64 = 0x1000_0000

fn clamp(value: u64) -> u64:
    if value >= LIMIT:
        return LIMIT +% 0
    return value

struct Point:
    x: i32
    y: i32

fn label(p: Point) -> String[..32]:
    total = clamp(p.x.to[u64]())
    for i in 0 .. 4:
        total += i
    return f"point {total}"
