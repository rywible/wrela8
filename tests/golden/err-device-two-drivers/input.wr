module examples.err_device_two_drivers


struct VirtioBlock:
    id: u32

@driver
pub struct A:
    held: DeviceCap[VirtioBlock]
    x: u32

    init(mut self, take cap: DeviceCap[VirtioBlock]):
        self.held = take cap
        self.x = 1

@driver
pub struct B:
    held: DeviceCap[VirtioBlock]
    y: u32

    init(mut self, take cap: DeviceCap[VirtioBlock]):
        self.held = take cap
        self.y = 2

@image
pub fn build() -> Image:
    img = Image(name="device-two-drivers", target=Target.wrela_machine_v1)
    blk = img.device[VirtioBlock](transport=0x2000)
    a = img.driver(A, device=blk)
    b = img.driver(B, device=blk)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
