module app.main

from lib.counter import Counter as Cnt

# plans/M9.md item DD: an aliased imported type's methods resolve.
# Before DD, `Cnt(n=1).get()` reported `error[type]: type `Counter` has
# no method `get`` — construction under the alias worked, but the
# synthesized `Type::Named` still carried the exporter's spelling, so
# method lookup keyed on a name the importer's table never held.
#
# Four shapes under one alias, each pinned by value: a missing mut
# write-back yields M=10 (settle 207); a wrong assoc that somehow
# returned a bare zero without constructing still cannot forge 217.

const Z: u32 = Cnt.zero().get()
const R: u32 = Cnt(n=1).get()

fn mut_path() -> u32:
    c = Cnt(n=10)
    c.bump()
    return c.get()

fn take_path() -> u32:
    c = Cnt(n=7)
    return c.into_n()

const M: u32 = mut_path()
const T: u32 = take_path()

# settle = Z*1000 + R*100 + M*10 + T = 0 + 100 + 110 + 7 = 217
const SETTLED: u32 = Z * 1000 + R * 100 + M * 10 + T

@test
pub fn t_assoc():
    assert Z == 0, "aliased associated fn resolves"

@test
pub fn t_read():
    assert R == 1, "aliased read-self method resolves"

@test
pub fn t_mut():
    assert M == 11, "aliased mut-self method resolves"

@test
pub fn t_take():
    assert T == 7, "aliased take-self method resolves"

@test
pub fn t_settled():
    assert SETTLED == 217, "all four under one settle"

@actor
pub struct Store:
    settled: u32

    init(mut self, settled: u32):
        self.settled = settled

@image
pub fn build() -> Image:
    img = Image(name="import-alias-method", target=Target.wrela_machine_v1)
    storage = img.actor(Store, settled=SETTLED, mailbox=4)
    img.supervise(children=[storage], strategy=Restart.OneForOne,
                  intensity=RestartIntensity(max=3, within=seconds(10)))
    return img.seal()
