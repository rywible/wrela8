module app.main

from lib.counter import Counter as Cnt


const Z: u32 = Cnt.zero().get()
const R: u32 = Cnt(n=1).get()

fn mut_path() -> u32:
    c = Cnt(n=10)
    c.bump()
    return c.get()

fn take_path() -> u32:
    c = Cnt(n=7)
    return c.into_n()

const M: u32 = mut_path()
const T: u32 = take_path()

const SETTLED: u32 = Z * 1000 + R * 100 + M * 10 + T

@test
pub fn t_assoc():
    assert Z == 0, "aliased associated fn resolves"

@test
pub fn t_read():
    assert R == 1, "aliased read-self method resolves"

@test
pub fn t_mut():
    assert M == 11, "aliased mut-self method resolves"

@test
pub fn t_take():
    assert T == 7, "aliased take-self method resolves"

@test
pub fn t_settled():
    assert SETTLED == 217, "all four under one settle"


@test(runtime)
pub fn guest_alias_method():
    assert Cnt.zero().get() == 0, "assoc at guest"
    assert Cnt(n=1).get() == 1, "read at guest"
    assert mut_path() == 11, "mut at guest"
    assert take_path() == 7, "take at guest"

@actor
pub struct Store:
    settled: u32

    init(mut self, settled: u32):
        self.settled = settled

@image
pub fn build() -> Image:
    img = Image(name="import-alias-method", target=Target.wrela_machine_v1)
    storage = img.actor(Store, settled=SETTLED, mailbox=4)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
