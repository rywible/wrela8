module app.main

from lib.g import Maker

fn drive() -> u32:
    m = Maker(seed=4)
    b = m.build()
    return b.n + 300

const D: u32 = drive()

@test
pub fn t():
    assert D == 305, "value of non-pub reachable type"


@test(runtime)
pub fn guest_reachable():
    assert drive() == 305, "reachable private at guest"

@actor
pub struct Store:
    settled: u32

    init(mut self, settled: u32):
        self.settled = settled

@image
pub fn build() -> Image:
    img = Image(name="import-reachable-private", target=Target.wrela_machine_v1)
    storage = img.actor(Store, settled=D, mailbox=4)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
