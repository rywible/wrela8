module examples.check_doc_comment_positions


struct First:
    x: u32

@actor
pub struct Counter:
    n: u32

    init(mut self):
        self.n = 0

    pub fn get(read self) -> u32:
        return self.n

const LIMIT: u32 = 7

@test
fn positions_hold():
    assert LIMIT == 7, "the documented const is the one that got compiled"
