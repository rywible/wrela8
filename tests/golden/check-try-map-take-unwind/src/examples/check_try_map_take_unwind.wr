module examples.check_try_map_take_unwind


fn bump(take x: u64) -> Result[u64, u64]:
    if x == 2:
        return Err(x)
    return Ok(x * 10)

fn double(take x: u64) -> u64:
    return x * 2

@test
fn try_map_take_err_payload():
    xs: [u64; 3] = [1, 2, 3]
    match xs.try_map_take(bump):
        case .Err(code):
            assert code == 2, "err is the failing element"
        case .Ok(_):
            assert false, "should err"

@test
fn map_take_ok_after_unwind():
    ys: [u64; 2] = [4, 5]
    zs = ys.map_take(double)
    assert zs[0] == 8, "a"
    assert zs[1] == 10, "b"
