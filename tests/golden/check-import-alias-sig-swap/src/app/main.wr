module app.main


from lib.pk import Src as Inner
from lib.pk import Hand as Grip
from lib.ret import Inner as Src
from lib.ret import Outer as Out

fn param_path() -> u32:
    s = Inner(n=3)
    h = Grip.make(take s)
    return h.inner.n + 400

fn return_path() -> u32:
    o = Out(n=11)
    i: Src = o.peel()
    return i.n + 700

fn settle() -> u32:
    return param_path() * 1000 + return_path()
