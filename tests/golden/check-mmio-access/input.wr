module examples.check_mmio_access


const INT_VRING: u32 = 1
const INT_CONFIG: u32 = 2

@layout(mmio, endian=little)
struct VirtioIrqMmio:
    @offset(0x060) interrupt_status: ReadOnly[u32]
    @offset(0x064) interrupt_ack: WriteOnly[u32]

@layout(mmio, endian=little)
struct VirtioLowAckMmio:
    @offset(0x100) ack_low: WriteOnly[u16]

struct VirtioBlock:
    id: u32

@driver
pub struct BlkDriver:
    irq_regs: Mmio[VirtioIrqMmio]
    low_regs: Mmio[VirtioLowAckMmio]
    handled_bits: u32

    fn on_queue_irq(mut self):
        status = self.irq_regs.interrupt_status.read()
        handled = status & (INT_VRING | INT_CONFIG)
        if handled != 0:
            self.handled_bits = handled
            self.irq_regs.interrupt_ack.write(handled)

    fn ack_low(read self, bits: u16):
        self.low_regs.ack_low.write(bits)

    pub fn last_handled(read self) -> u32:
        return self.handled_bits
