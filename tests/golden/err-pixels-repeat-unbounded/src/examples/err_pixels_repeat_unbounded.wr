module examples.err_pixels_repeat_unbounded

from core.field import (
    Field,
    Rgb,
    Vec3,
    finite_repeat_x,
    mark,
    sphere,
)
from core.render import (
    AoConfig,
    CameraBounds,
    LightConfig,
    MaterialSample,
    ProbeConfig,
    RenderProfile,
    RgbRange,
    ScalarRange,
    SurfaceContext,
    ToneCurve,
)
from drivers.display import Display, DisplayDevice

const FIXTURE_ID: u32 = 27

fn fixture_id() -> u32:
    return FIXTURE_ID

const PERIOD_RAW: i32 = 2
const WORLD_HALF_EXTENT_RAW: i32 = 64

struct SceneParams:
    @range(min=-2.0, max=2.0)
    phase: f32

enum MaterialId:
    Ground

@field
fn world(p: Vec3, read params: SceneParams) -> Field:
    q = finite_repeat_x(p, first=-2, count=4, period=params.phase)
    return mark(
        sphere(q, Vec3(x=0.0, y=0.0, z=0.0), radius=0.5),
        object=MaterialId.Ground,
        material=MaterialId.Ground,
    )

@material
fn shade(surface: SurfaceContext[MaterialId], read params: SceneParams) -> MaterialSample:
    return MaterialSample.standard(color=Rgb(r=0.25, g=0.5, b=0.75), roughness=0.5)

@test(runtime)
fn pinned_scene_contract():
    assert FIXTURE_ID == 27, "fixture id must remain pinned"
    assert PERIOD_RAW == 2, "adversarial scene value must remain pinned"

@image
pub fn build() -> Image:
    img = Image(name="err-pixels-repeat-unbounded", target=Target.wrela_machine_v1)
    display_device = img.device[DisplayDevice](transport=0x6000)
    display = img.driver(Display, device=display_device, width=64, height=32, refresh_hz=60)
    renderer = img.renderer[SceneParams](
        field=world,
        material=shade,
        display=display,
        width=64,
        height=32,
        refresh_hz=60,
        shade_hz=60,
        profile=RenderProfile.AaaByteExact,
        tone_curve=ToneCurve.Linear,
        near=0.1,
        far=128.0,
        world_min=Vec3(x=-64.0, y=-64.0, z=-64.0),
        world_max=Vec3(x=64.0, y=64.0, z=64.0),
        camera_bounds=CameraBounds.bounded(max_motion=0.25),
        light_config=LightConfig.fixed(capacity=0),
        exposure_range=ScalarRange(min=-1.0, max=1.0),
        environment_range=RgbRange(
            min=Rgb(r=0.0, g=0.0, b=0.0),
            max=Rgb(r=1.0, g=1.0, b=1.0),
        ),
        ao=AoConfig.fixed(enabled=false),
        probes=ProbeConfig.fixed(enabled=false),
        initialization_deadline_ms=10,
    )
    img.on_failure(policy=Failure.Halt)
    return img.seal()
