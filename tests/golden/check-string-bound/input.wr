module examples.check_string_bound


const S: String[..8] = "hi"

fn occupied(s: String[..8]) -> u64:
    return s.len.to[u64]()

fn byte0(s: String[..8]) -> u64:
    return s[0].to[u64]()

fn byte1(s: String[..8]) -> u64:
    return s[1].to[u64]()

fn probe(s: String[..8]) -> u64:
    return occupied(s)

const L: u64 = occupied(S)
const B0: u64 = byte0(S)
const B1: u64 = byte1(S)
const SETTLED: u64 = L * 1000000 + B0 * 1000 + B1

@test
pub fn t_value():
    assert L == 2, "occupied length of \"hi\""
    assert B0 == 104, "byte0 is 'h'"
    assert B1 == 105, "byte1 is 'i'"
    assert SETTLED == 2104105, "length and bytes under one settle"


@test(runtime)
pub fn guest_string():
    assert occupied(S) == 2, "len at guest"
    assert byte0(S) == 104, "byte0 at guest"
    assert byte1(S) == 105, "byte1 at guest"
    assert probe(S) == 2, "probe at guest"

@actor
pub struct Store:
    settled: u64

    init(mut self, settled: u64):
        self.settled = settled

@image
pub fn build() -> Image:
    img = Image(name="check-string-bound", target=Target.wrela_machine_v1)
    storage = img.actor(Store, settled=SETTLED, mailbox=4)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
