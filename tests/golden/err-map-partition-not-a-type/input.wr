module examples.err_map_partition_not_a_type

# plans/M7.md item H1 self-audit — `map_partition(1)` — argument is not a type name
#
# What this case would catch: a partition whose argument is a value expression rather than an `@layout(mmio)` type name.

@layout(mmio, endian=little)
struct VirtioIrqMmio:
    @offset(0x060) interrupt_status: ReadOnly[u32]

struct VirtioBlock:
    id: u32

@driver
pub struct BlkDriver:
    regs: Mmio[VirtioIrqMmio]

    init(mut self, take cap: DeviceCap[VirtioBlock]):
        claimed = VirtioBlock.claim(cap=take cap)
        self.regs = claimed.map_partition(1)
