module examples.check_layout_assert_budget

# plans/M9.md item H2: a code-budget `@layout_assert` true of the
# program's real guest code. Before the fix, declaring this fn grew
# `code` 128 -> 656 and the assert failed; after, code stays guest-only
# (plans/M10.md item A2d adds the force-rooted probe, 128 -> 156;
# item B2 force-roots `__wrela_line_begin`/`__wrela_line_commit` → 1340).
# Pins that `@layout_assert` bodies are host-only.
from core.image_report import ImageReport

@actor
pub struct Store:
    n: u32

    init(mut self):
        self.n = 0

    pub fn get(read self) -> u32:
        return self.n

@layout_assert
fn budget(report: ImageReport):
    assert report.code_size < 1500, "code budget is 1500 bytes"

@image
pub fn build() -> Image:
    img = Image(name="layout-assert-budget", target=Target.wrela_machine_v1)
    a = img.actor(Store, mailbox=8)
    img.check_layout(budget)
    img.supervise(children=[a], strategy=Restart.OneForOne,
                  intensity=RestartIntensity(max=1, within=seconds(1)))
    return img.seal()
