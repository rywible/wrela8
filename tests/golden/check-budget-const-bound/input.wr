module examples.check_budget_const_bound

# plans/M12.md item B / decisions 871–874: `@budget(bound=NAME)` accepts a
# module-level `const` of integer type with comptime value ≥ 1, resolved by
# the same rule as `@layout(runtime)` array lengths (03 §3.1 wording). The
# typed dump shows the resolved trip-counter N (not the name).

const BOUND: u64 = 64


pub fn sum_to(n: u64) -> u64:
    total: u64 = 0
    i: u64 = 0
    @budget(bound=BOUND)
    while i < n:
        total = total + i
        i = i + 1
    return total
