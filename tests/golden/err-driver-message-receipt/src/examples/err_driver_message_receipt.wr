module examples.err_driver_message_receipt

from core.io_error import IoError

# **Retargeted by plans/M8.md item E (decision 33).** Item D pinned this
# name on a build-time refusal of `Receipt[P]` in *either* direction
# across a driver mailbox, and its diagnostic named this item as the lift.
# Item E landed: a `Receipt[P]` **reply** from 03-hardware.md §5's handoff
# signature is the blessed convention and now boots
# (`golden/boot-receipt-handoff`), so that arm of
# `layout::check_driver_message_surface` is gone.
#
# What this case pins now is the direction that survives — a receipt as a
# message **parameter** (05-library.md §2) — and, deliberately, *where* it
# is refused. Item D expected the mailbox check to catch it; working item
# E found that `sema::types::validate_fn_capability_types` already refuses
# it one pass earlier, for every `pub` method of every `@actor`/`@driver`,
# messageable or not. The `Receipt` whitelist there was only ever for the
# **reply** position. So the layout-tier parameter arm is unreachable for
# a receipt, and this golden pins the diagnostic that really fires.
#
# The two shapes sit in one file, one method apart: `submit_read` is the
# accepted handoff (one `take p: P`, result `Receipt[P]`) on a driver
# declared `mailbox=4`, and `abandon` posts a receipt back *into* the
# driver. 03 §5 gives a receipt one owner and one resolution — the caller
# holds and `await`s it, the driver's own bottom half resolves it.

@layout(mmio, endian=little)
struct VirtioIrqMmio:
    @offset(0x060) interrupt_status: ReadOnly[u32]

@layout(dma, endian=little)
struct BlkReqHeader:
    kind: u32
    reserved: u32
    sector: u64

@layout(dma, endian=little)
struct BlkReqStatus:
    status: u8

@layout(dma, endian=little)
struct DmaBlock:
    # 512-byte sector payload (virtio-blk SECTOR_SIZE). Frame ABI stays
    # two u64 slots; the @layout size is what prepare publishes as the
    # descriptor length (plans/M7.md item E4).
    @offset(0) word: u64
    @offset(504) pad_end: u64

struct VirtioBlock:
    id: u32

enum Feature:
    Flush

const QDEPTH: usize = 8

pool BlockControl
pool BlockPayloads

@driver
pub struct BlkDriver:
    irq_regs: Mmio[VirtioIrqMmio]
    device: RunningDevice[VirtioBlock]
    queue: VirtQueue[..8]
    capacity_sectors: u64

    init(mut self,
         take cap: DeviceCap[VirtioBlock],
         take control_pool: DmaPool[BlockControl, 512])
        -> Result[unit, BootError]:
        claimed = VirtioBlock.claim(cap=take cap)
        self.irq_regs = claimed.map_partition(VirtioIrqMmio)
        negotiated = claimed.negotiate(
            required=[Feature.Flush],
            optional=[Feature.Flush],
        )?
        self.queue = VirtQueue.configure(
            pool=take control_pool,
            device=mut negotiated,
            index=0,
            depth=QDEPTH,
        )?
        # Literal capacity — avoids `read_capacity_sectors` so `--stage=mwir`
        # can lower this driver without an image-eval capacity fill (E1's
        # ConstInt path). The handoff/publish surface is what this golden pins.
        self.capacity_sectors = 16
        self.device = negotiated.start()
        return Ok(unit)

    # Signature-determined handoff (03 §5): one take P, result Receipt[P].
    pub fn submit_read(mut self, lba: u64,
                       take buffer: own[BlockPayloads] DmaBlock)
        -> Receipt[own[BlockPayloads] DmaBlock]:
        if lba >= self.capacity_sectors:
            return self.queue.reject(
                payload=take buffer,
                error=IoError.OutOfRange,
            )
        permit = self.queue.reserve(descriptors=3)
        operation = self.queue.prepare_block(
            permit=take permit,
            header=BlkReqHeader(kind=0, reserved=0, sector=lba),
            payload=take buffer,
            device_writes_payload=true,
            status=BlkReqStatus(status=0xff),
            # Item G (decision 18) made `idempotent=` required. A block
            # *read* of a fixed sector is idempotent by inspection — this
            # case is about the `Receipt` reply, not the retry rule, and
            # `true` is the honest answer for a read rather than the one
            # that dodges a second diagnostic.
            idempotent=true,
        )
        return self.queue.publish(operation=take operation)

    # The refused direction: a receipt as an admitted message parameter.
    pub fn abandon(mut self, take receipt: Receipt[own[BlockPayloads] DmaBlock]) -> u64:
        outcome = self.queue.recover(receipt=take receipt)
        match outcome:
            case .Completed:
                return 1
            case .NotCompleted:
                return 2
            case .Unknown:
                return 3

@image
pub fn build() -> Image:
    img = Image(name="err-driver-message-receipt", target=Target.wrela_machine_v1)
    blk = img.device[VirtioBlock](
        transport=0x2000,
        capacity_sectors=16,
        required_features=[Feature.Flush],
    )
    control = img.dma_pool[BlkReqHeader](name=BlockControl, device=blk, count=32)
    _payloads = img.dma_pool[DmaBlock](name=BlockPayloads, device=blk, count=4)
    disk = img.driver(BlkDriver, device=blk, mailbox=4)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
