module examples.err_actor_handle_reply

# 02-language.md §9.1: a public actor method's own return type is the
# reply shape — handing an `Actor[T]` handle back through a reply is the
# identical violation as taking one in, rejected at declaration.
@actor
pub struct Registry:
    id: u64

@actor
pub struct Directory:
    pub async fn lookup(read self) -> Actor[Registry]:
        return unit
