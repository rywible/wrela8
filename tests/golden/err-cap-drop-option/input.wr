module examples.err_cap_drop_option

# plans/M7.md item I: protocol-consumption must reach through Option.
# Wrapping a taken DeviceCap in Some(...) and dropping the Option used to
# compile — the predicate only matched a root Named leaf.

struct BlockHw:
    id: u32

@driver
pub struct BlkDriver:
    sectors: u64

    init(mut self, take cap: DeviceCap[BlockHw], sectors: u64):
        self.sectors = sectors
        held = Some(take cap)
        return

    pub fn capacity(read self) -> u64:
        return self.sectors

@image
pub fn build() -> Image:
    img = Image(name="err-cap-drop-option", target=Target.wrela_machine_v1)
    blk_device = img.device[BlockHw](transport=0x2000)
    disk = img.driver(BlkDriver, device=blk_device, sectors=131072)
    img.supervise(
        children=[disk],
        strategy=Restart.OneForOne,
        intensity=RestartIntensity(max=3, within=seconds(10)),
    )
    return img.seal()
