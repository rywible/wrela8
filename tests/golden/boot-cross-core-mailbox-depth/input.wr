module examples.boot_cross_core_mailbox_depth

# plans/M8.md item H Target C — mailbox depth under three cores, and the
# back-pressure decision 29 named: a full mailbox holds the ring message
# rather than dropping it.
#
# `Sink` is declared `mailbox=1` on core 1. Two producers — `Near` on core 0
# and `Far` on core 2 — each publish one cross-core message into it.
#
# **plans/M15.md item I retarget.** Under the baton both messages sat in
# their request rings before core 1 drained; the drain walked `src=0` then
# `src=2`, admitted Near's into the one mailbox slot, and **held** Far's in
# its ring when `__rt_enqueue_Sink` rejected (mailbox full). Under
# overlapping `hv_vcpu_run`, Sink may admit Far first (Near then sees `11`)
# — the "Near returns 1" baton assumption is gone. What still falsifies
# missing back-pressure: after both have run, `Sink.total` is `11` (Far's
# `+10` was not dropped). Invert the drain's rejection test (pop on reject)
# and total stays `1`.
#
# Far uses a bare `send` (decision 31 refuses an await/checkpoint on a
# secondary core). Ring capacity equals mailbox capacity (decision 29), so
# a forged "mailbox shallower than its feeding ring" cannot be built from
# source — that shape is a report-forgery concern, not a boot golden.

@actor
pub struct Sink:
    n: u64

    init(mut self):
        self.n = 0

    pub fn add(mut self, by: u64) -> u64:
        self.n = self.n + by
        return self.n

    pub fn bump(mut self, by: u64) -> unit:
        self.n = self.n + by
        return unit

    pub fn total(read self) -> u64:
        return self.n

@actor
pub struct Near:
    sink: Actor[Sink]

    pub async fn go(read self) -> u64:
        v = await self.sink.add(by=1)
        @discard(reason="migrated: deliberate Err discard (M13 item L)")
        match v:
            case .Ok(n):
                return n
            case .Err(_):
                return 0

@actor
pub struct Far:
    sink: Actor[Sink]

    pub async fn kick(read self) -> u64:
        @discard(reason="migrated: deliberate Err discard (M13 item L)")
        match send self.sink.bump(by=10):
            case .Ok(_):
                return 7
            case .Err(_):
                return 0

@test(runtime)
async fn mailbox_depth_backpressures_under_three_cores(
    near: Actor[Near], far: Actor[Far], sink: Actor[Sink]
):
    k = await far.kick()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match k:
        case .Ok(n):
            assert n == 7, "Far ran its turn on core 2"
        case .Err(_):
            assert false, "Far rejected"
    x = await near.go()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match x:
        case .Ok(n):
            # 1 = Near first (both pending, drain order); 11 = Far first (overlap).
            ok: u64 = 0
            if n == 1:
                ok = 1
            if n == 11:
                ok = 1
            assert ok == 1, "Near's +1 was admitted (alone or after Far's +10)"
        case .Err(_):
            assert false, "Near rejected"
    # Far's +10 must have been admitted eventually — otherwise it was
    # dropped and total stays 1 (or Near-only).
    t = await sink.total()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match t:
        case .Ok(n):
            assert n == 11, "Far's +10 was admitted later (or first), not dropped"
        case .Err(_):
            assert false, "Sink.total rejected"

@image
pub fn build() -> Image:
    img = Image(name="cross-core-mailbox-depth", target=Target.wrela_machine_v1, cores=3)
    sink = img.actor(Sink, mailbox=1, core=1)
    near = img.actor(Near, mailbox=4, core=0, sink=sink)
    far = img.actor(Far, mailbox=4, core=2, sink=sink)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
