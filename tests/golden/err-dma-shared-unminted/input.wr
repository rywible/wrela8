module examples.err_dma_shared_unminted

# plans/M7.md item D, 03-hardware.md §3: shared control memory is not
# minted at the image binding at all. In §3's own worked example a
# `DmaShared` is what `VirtQueue.configure(pool=take control_pool, ...)`
# makes *out of* a pool — so the pool is the image-bound thing, and the
# shared control memory is the queue's, which is plans/M7.md item E.
#
# This is deliberately a different rejection from `Mmio`'s and `IrqCap`'s
# (`golden/err-cap-mint-unminted`): those say "nothing mints one *yet*"
# about a capability the image binding will eventually produce. This one
# says the image binding is the wrong place to look.

@layout(dma, endian=little)
struct RingControl:
    flags: u16
    idx: u16

@layout(dma, endian=little)
struct BlkReqHeader:
    kind: u32
    reserved: u32
    sector: u64

struct BlockHw:
    id: u32

pool BlockControl

@driver
pub struct BlkDriver:
    sectors: u64

    init(mut self, take ring: DmaShared[BlockControl, RingControl]):
        self.sectors = 0

    pub fn capacity(read self) -> u64:
        return self.sectors

@image
pub fn build() -> Image:
    img = Image(name="x", target=Target.wrela_machine_v1)
    blk = img.device[BlockHw](transport=0x2000)
    disk = img.driver(BlkDriver, device=blk)
    control = img.dma_pool[BlkReqHeader](name=BlockControl, device=blk, count=4)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
