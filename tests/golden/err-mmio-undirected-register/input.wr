module examples.err_mmio_undirected_register

# plans/M7.md item H2a (replaces item C's "undirected has neither op"):
# an undirected `@layout(mmio)` register now admits `.read()` / `.write(v)`,
# and `.read()` returns `Untrusted[T]` — a device control value under
# 03-hardware.md §8. Returning that marked value as a plain `u32` is a
# rejection naming `.checked_le(bound)`, which is the point of this
# golden: the producer is real and the use is still gated.

@layout(mmio, endian=little)
struct VirtioIrqMmio:
    @offset(0x060) interrupt_status: u32

@driver
pub struct BlkDriver:
    irq_regs: Mmio[VirtioIrqMmio]

    fn poll(read self) -> u32:
        return self.irq_regs.interrupt_status.read()
