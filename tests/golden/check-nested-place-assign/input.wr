module examples.check_nested_place_assign


struct Holder:
    data: [u64; 4]

    pub fn set(mut self, i: usize, v: u64):
        self.data[i] = v

    pub fn get(read self, i: usize) -> u64:
        return self.data[i]

@actor
pub struct Store:
    h: Holder

    init(mut self):
        self.h = Holder(data=[0, 0, 0, 0])

    pub fn poke(mut self) -> u64:
        self.h.set(1, 9)
        return self.h.get(1)

@test(runtime)
async fn guest_nested(store: Actor[Store]):
    v = await store.poke()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match v:
        case .Ok(n):
            assert n == 9, "nested assign wrote"
        case .Err(_):
            assert false, "call rejected"

@image
pub fn build() -> Image:
    img = Image(name="check-nested-place-assign", target=Target.wrela_machine_v1)
    s = img.actor(Store, mailbox=8)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
