module examples.err_image_no_failure_policy

@driver
pub struct Blk:
    id: u32

    init(mut self):
        self.id = 1

@actor
pub struct Store:
    count: u32

    init(mut self):
        self.count = 0

@image
pub fn build() -> Image:
    img = Image(name="no-failure-policy", target=Target.wrela_machine_v1)
    disk = img.driver(Blk)
    storage = img.actor(Store, mailbox=16)
    return img.seal()
