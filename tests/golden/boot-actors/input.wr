module examples.boot_actors


@actor
pub struct Ledger:
    marks: u64

    pub fn mark(mut self, n: u64) -> unit:
        self.marks = self.marks * 10 + n
        return unit

    pub fn read_marks(read self) -> u64:
        return self.marks

@actor
pub struct Worker:
    led: Actor[Ledger]

    pub async fn slow(mut self) -> unit:
        m1 = await self.led.mark(n=1)
        @discard(reason="migrated: deliberate Err discard (M13 item L)")
        match m1:
            case .Ok(_):
                pass
            case .Err(_):
                pass
        m2 = await self.led.mark(n=2)
        @discard(reason="migrated: deliberate Err discard (M13 item L)")
        match m2:
            case .Ok(_):
                pass
            case .Err(_):
                pass
        return unit

    pub async fn quick(mut self) -> unit:
        m3 = await self.led.mark(n=3)
        @discard(reason="migrated: deliberate Err discard (M13 item L)")
        match m3:
            case .Ok(_):
                pass
            case .Err(_):
                pass
        return unit

    pub async fn report(read self) -> u64:
        r = await self.led.read_marks()
        @discard(reason="migrated: deliberate Err discard (M13 item L)")
        match r:
            case .Ok(v):
                return v
            case .Err(_):
                return 0

@test(runtime)
async fn turns(w: Actor[Worker]):
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match send w.slow():
        case .Ok(_):
            pass
        case .Err(_):
            assert false, "slow was not admitted"
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match send w.quick():
        case .Ok(_):
            pass
        case .Err(_):
            assert false, "quick was not admitted"
    r = await w.report()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match r:
        case .Ok(t):
            assert t == 123, "non-reentrancy: marks are 123, never 132"
        case .Err(_):
            assert false, "report rejected"

@image
pub fn build() -> Image:
    img = Image(name="boot-actors", target=Target.wrela_machine_v1)
    led = img.actor(Ledger, mailbox=8)
    w = img.actor(Worker, mailbox=8, led=led)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
