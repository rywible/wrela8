module app.main

from lib.color import Color as Hue

# plans/M9.md item DD: regression lock for the already-working aliased
# pattern half of A1b finding 2. Two shapes, both must stay green:
#
# 1. Annotated scrutinee (`c: Hue` then `case Hue.Red:`) — worked once
#    A1's decision 9 made type annotations resolve to the local name.
# 2. Construction-as-scrutinee (`match Hue.Red: case Hue.Red:`) — needed
#    DD's construction spelling fix; before DD it reported
#    `expected a `Color` pattern, found `Hue``.
#
# Exhaustiveness is analysed for real: dropping Blue would report
# `match is not exhaustive: missing .Blue`. The settle pins that both
# arms are reachable and correctly distinguished.

fn pick_annotated(c: Hue) -> u32:
    match c:
        case Hue.Red:
            return 1
        case Hue.Blue:
            return 2

fn pick_constructed() -> u32:
    match Hue.Red:
        case Hue.Red:
            return 10
        case Hue.Blue:
            return 20

const A: u32 = pick_annotated(Hue.Blue)
const C: u32 = pick_constructed()
# settle = A*100 + C = 2*100 + 10 = 210
const SETTLED: u32 = A * 100 + C

@test
pub fn t_annotated():
    assert A == 2, "aliased pattern against an annotated scrutinee"

@test
pub fn t_constructed():
    assert C == 10, "aliased pattern against a constructed scrutinee"

@test
pub fn t_settled():
    assert SETTLED == 210, "both pattern shapes under one settle"

@actor
pub struct Store:
    settled: u32

    init(mut self, settled: u32):
        self.settled = settled

@image
pub fn build() -> Image:
    img = Image(name="import-alias-pattern", target=Target.wrela_machine_v1)
    storage = img.actor(Store, settled=SETTLED, mailbox=4)
    img.supervise(children=[storage], strategy=Restart.OneForOne,
                  intensity=RestartIntensity(max=3, within=seconds(10)))
    return img.seal()
