module examples.boot_device_bringup

# plans/M7.md item E1's **real-boot oracle** (the A–H note): a Hypervisor.framework
# boot in which the sealed bring-up chain walks all the way to `Running`, and
# the VMM constructs its `BlkDevice` from the report lines this image emits.
#
# The driver's `init` is 03-hardware.md §1's own worked constructor shape and
# §9's consuming chain: claim -> map_partition -> negotiate -> VirtQueue.configure
# -> read_capacity_sectors -> start. IRQ arming is plans/M7.md item G and is
# not here. Publishing an operation is E2/E3 and must fail closed by name.
#
# **What a green transcript proves, precisely:**
#
#   1. Boot calls a fallible `@driver` `init` returning `Result[unit, BootError]`
#      and the Ok path continues into the runtime test.
#   2. `negotiate` / `configure` / `read_capacity_sectors` / `start` are real
#      authority transitions (decision 14: negotiate is a build-time fact;
#      capacity is the image-declared constant).
#   3. The VMM parsed `BlkDevice`/`BlkQueue`/`BlkPool` from *this* image's
#      report (otherwise `BlkDevice::new` would refuse the boot).
#   4. Capacity lands in the guest as 16 — the same number the report carries.
#
# **The vacuity control is its own golden**: `err-boot-device-bringup` returns
# `Err(BootError.Failed)` from `init`, and its expected output is the guest
# abort. Without it, every assertion here would also pass on a boot that never
# called `init` at all.

@layout(mmio, endian=little)
struct VirtioIrqMmio:
    @offset(0x060) interrupt_status: ReadOnly[u32]
    @offset(0x064) interrupt_ack: WriteOnly[u32]

@layout(dma, endian=little)
struct BlkReqHeader:
    kind: u32
    reserved: u32
    sector: u64

struct VirtioBlock:
    id: u32

enum Feature:
    Flush
    RingReset

const QDEPTH: usize = 8

pool BlockControl

@driver
pub struct BlkDriver:
    irq_regs: Mmio[VirtioIrqMmio]
    device: RunningDevice[VirtioBlock]
    queue: VirtQueue[..8]
    capacity_sectors: u64

    init(mut self,
         take cap: DeviceCap[VirtioBlock],
         take control_pool: DmaPool[BlockControl, 512])
        -> Result[unit, BootError]:
        claimed = VirtioBlock.claim(cap=take cap)
        self.irq_regs = claimed.map_partition(VirtioIrqMmio)
        negotiated = claimed.negotiate(
            required=[Feature.Flush],
            optional=[Feature.RingReset],
        )?
        self.queue = VirtQueue.configure(
            pool=take control_pool,
            device=mut negotiated,
            index=0,
            depth=QDEPTH,
        )?
        self.capacity_sectors = negotiated.read_capacity_sectors()?
        self.device = negotiated.start()
        assert self.capacity_sectors == 16, "capacity is the image-declared build constant"
        return Ok(unit)

@actor
pub struct Ledger:
    marks: u64

    pub fn mark(mut self, n: u64) -> unit:
        self.marks = self.marks * 10 + n
        return unit

    pub fn read_marks(read self) -> u64:
        return self.marks

@test(runtime)
async fn bringup_reached_running(led: Actor[Ledger]):
    # The driver's own `init` already ran (06 §3 step 3). Its assertions are
    # the oracle; this conversation exists so the image has a runtime test
    # to report at all.
    a = await led.mark(n=4)
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match a:
        case .Ok(_):
            pass
        case .Err(_):
            assert false, "mark rejected"
    b = await led.mark(n=2)
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match b:
        case .Ok(_):
            pass
        case .Err(_):
            assert false, "mark rejected"
    m = await led.read_marks()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match m:
        case .Ok(v):
            assert v == 42, "two marks over an image whose driver reached Running"
        case .Err(_):
            assert false, "read_marks rejected"

@image
pub fn build() -> Image:
    img = Image(name="boot-device-bringup", target=Target.wrela_machine_v1)
    blk = img.device[VirtioBlock](
        transport=0x2000,
        capacity_sectors=16,
        required_features=[Feature.Flush],
    )
    control = img.dma_pool[BlkReqHeader](name=BlockControl, device=blk, count=32)
    disk = img.driver(BlkDriver, device=blk)
    led = img.actor(Ledger, mailbox=8)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
