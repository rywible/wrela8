module examples.err_image_init_arg_aggregate


enum Mode:
    Fast
    Slow

@actor
pub struct Sink:
    mode: Mode
    depth: u32

    init(mut self, mode: Mode, depth: u32):
        self.mode = mode
        self.depth = depth

    pub fn read_depth(read self) -> u32:
        return self.depth

@test(runtime)
async fn boots(s: Actor[Sink]):
    d = await s.read_depth()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match d:
        case .Ok(v):
            assert v == 7, "unreachable: this image never lays out"
        case .Err(_):
            assert false, "read_depth rejected"

@image
pub fn build() -> Image:
    img = Image(name="err-image-init-arg-aggregate", target=Target.wrela_machine_v1)
    s = img.actor(Sink, mailbox=4, mode=Mode.Fast, depth=7)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
