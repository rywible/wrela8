module examples.boot_dma_pool

# plans/M7.md item D's **real-boot oracle** (the A–H note: "a real HVF boot
# as the behavioral oracle wherever the item produces guest-visible
# behavior ... M5/M6 both proved that dump review alone misses
# register-level bugs").
#
# Item D's guest-visible product is a `pooldata` section: 05-library.md
# §9's "reserve exact backing", emitted as zeroed image bytes and placed
# after `rtdata`, exactly like the actor runtime tables. That is not a
# report fact — it changes the emitted blob's length, the memory map, and
# (before `rtdata` learned to advance the placement cursor) it silently
# overlapped the actor state area. `--stage=report` review would not have
# caught that; a boot does, immediately and loudly, because every actor's
# state, mailbox and turn record lives in the section the pool now sits
# after.
#
# So this image declares both pool forms — a device-reachable
# `img.dma_pool` and a plain `img.pool`, 384 bytes of backing between them
# — and then runs an ordinary actor conversation over it. The assertions
# are about the actors, deliberately: nothing here reads pool memory (no
# source construct produces an `own[P] T` yet — `hardware.dma.ownership-transfer`),
# so what a green transcript proves is that reserving and placing the
# backing left every runtime table exactly where it was. The identical
# assertions with the two pool declarations deleted are the control, and
# `golden/boot-actors` is effectively that control already.
#
# What this does **not** prove, stated rather than implied: the VMM never
# sees a window here. `wrela test`'s own runtime report is hand-built
# (`Machine revision=`/`Input`/`Section`/`Entry`) and does not carry the
# `BlkPool name= base= size=` lines `render_layout_section` emits, so no
# device model is configured and nothing maps this pool. That chain closes
# at plans/M7.md item E, which emits the `BlkDevice`/`BlkQueue` lines a
# `BlkPool` needs to bind to.

@layout(dma, endian=little)
struct BlkReqHeader:
    kind: u32
    reserved: u32
    sector: u64

struct BlockHw:
    id: u32

pool BlockControl
pool Scratch

@actor
pub struct Ledger:
    marks: u64

    pub fn mark(mut self, n: u64) -> unit:
        self.marks = self.marks * 10 + n
        return unit

    pub fn read_marks(read self) -> u64:
        return self.marks

@actor
pub struct Worker:
    led: Actor[Ledger]
    seen: u64

    init(mut self, led: Actor[Ledger]):
        self.led = led
        self.seen = 0

    pub async fn run(mut self) -> unit:
        m1 = await self.led.mark(n=4)
        match m1:
            case .Ok(_):
                pass
            case .Err(_):
                pass
        m2 = await self.led.mark(n=2)
        match m2:
            case .Ok(_):
                pass
            case .Err(_):
                pass
        self.seen = 1
        return unit

    pub fn seen(read self) -> u64:
        return self.seen

@test(runtime)
async fn pool_backed_image(w: Actor[Worker], led: Actor[Ledger]):
    r = await w.run()
    match r:
        case .Ok(_):
            pass
        case .Err(_):
            assert false, "run rejected"
    m = await led.read_marks()
    match m:
        case .Ok(v):
            assert v == 42, "two marks in admission order, over an image carrying 384 bytes of pool backing"
        case .Err(_):
            assert false, "read_marks rejected"
    s = await w.seen()
    match s:
        case .Ok(v):
            assert v == 1, "the worker's own state survived the pooldata reservation placed after it"
        case .Err(_):
            assert false, "seen rejected"

@image
pub fn build() -> Image:
    img = Image(name="boot-dma-pool", target=Target.wrela_machine_v1)
    blk = img.device[BlockHw](transport=0x2000)
    control = img.dma_pool[BlkReqHeader](name=BlockControl, device=blk, count=8)
    scratch = img.pool[u32](name=Scratch, slots=4, max_payload=64)
    led = img.actor(Ledger, mailbox=8)
    w = img.actor(Worker, mailbox=8, led=led)
    img.supervise(children=[led, w], strategy=Restart.OneForOne,
                  intensity=RestartIntensity(max=3, within=seconds(10)))
    return img.seal()
