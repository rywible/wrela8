module examples.boot_dma_pool


@layout(dma, endian=little)
struct BlkReqHeader:
    kind: u32
    reserved: u32
    sector: u64

struct BlockHw:
    id: u32

pool BlockControl
pool Scratch

@actor
pub struct Ledger:
    marks: u64

    pub fn mark(mut self, n: u64) -> unit:
        self.marks = self.marks * 10 + n
        return unit

    pub fn read_marks(read self) -> u64:
        return self.marks

@actor
pub struct Worker:
    led: Actor[Ledger]
    seen: u64

    init(mut self, led: Actor[Ledger]):
        self.led = led
        self.seen = 0

    pub async fn run(mut self) -> unit:
        m1 = await self.led.mark(n=4)
        @discard(reason="migrated: deliberate Err discard (M13 item L)")
        match m1:
            case .Ok(_):
                pass
            case .Err(_):
                pass
        m2 = await self.led.mark(n=2)
        @discard(reason="migrated: deliberate Err discard (M13 item L)")
        match m2:
            case .Ok(_):
                pass
            case .Err(_):
                pass
        self.seen = 1
        return unit

    pub fn seen(read self) -> u64:
        return self.seen

@test(runtime)
async fn pool_backed_image(w: Actor[Worker], led: Actor[Ledger]):
    r = await w.run()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match r:
        case .Ok(_):
            pass
        case .Err(_):
            assert false, "run rejected"
    m = await led.read_marks()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match m:
        case .Ok(v):
            assert v == 42, "two marks in admission order, over an image carrying 384 bytes of pool backing"
        case .Err(_):
            assert false, "read_marks rejected"
    s = await w.seen()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match s:
        case .Ok(v):
            assert v == 1, "the worker's own state survived the pooldata reservation placed after it"
        case .Err(_):
            assert false, "seen rejected"

@image
pub fn build() -> Image:
    img = Image(name="boot-dma-pool", target=Target.wrela_machine_v1)
    blk = img.device[BlockHw](transport=0x2000)
    control = img.dma_pool[BlkReqHeader](name=BlockControl, device=blk, count=8)
    scratch = img.pool[u32](name=Scratch, slots=4, max_payload=64)
    led = img.actor(Ledger, mailbox=8)
    w = img.actor(Worker, mailbox=8, led=led)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
