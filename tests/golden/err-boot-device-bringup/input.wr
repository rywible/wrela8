module examples.err_boot_device_bringup

# plans/M7.md item E1 vacuity control for `boot-device-bringup`: the same
# driver with `init` returning `Err(BootError.Failed)`. Expected output is
# the guest's own abort line through `__wrela_abort` (same path as an
# `assert` failure inside `init`) — without it, every assertion in the
# accept golden would also pass on a boot that never called `init` at all.

@layout(mmio, endian=little)
struct VirtioIrqMmio:
    @offset(0x060) interrupt_status: ReadOnly[u32]

@layout(dma, endian=little)
struct BlkReqHeader:
    kind: u32
    reserved: u32
    sector: u64

struct VirtioBlock:
    id: u32

enum Feature:
    Flush

const QDEPTH: usize = 8

pool BlockControl

@driver
pub struct BlkDriver:
    irq_regs: Mmio[VirtioIrqMmio]
    device: RunningDevice[VirtioBlock]
    queue: VirtQueue[..8]
    capacity_sectors: u64

    init(mut self,
         take cap: DeviceCap[VirtioBlock],
         take control_pool: DmaPool[BlockControl, 512])
        -> Result[unit, BootError]:
        claimed = VirtioBlock.claim(cap=take cap)
        self.irq_regs = claimed.map_partition(VirtioIrqMmio)
        negotiated = claimed.negotiate(
            required=[Feature.Flush],
            optional=[Feature.Flush],
        )?
        self.queue = VirtQueue.configure(
            pool=take control_pool,
            device=mut negotiated,
            index=0,
            depth=QDEPTH,
        )?
        self.capacity_sectors = negotiated.read_capacity_sectors()?
        self.device = negotiated.start()
        return Err(BootError.Failed)

@actor
pub struct Ledger:
    marks: u64

    pub fn mark(mut self, n: u64) -> unit:
        self.marks = self.marks * 10 + n
        return unit

@test(runtime)
async fn never_runs(led: Actor[Ledger]):
    a = await led.mark(n=1)
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match a:
        case .Ok(_):
            assert false, "unreachable: init returned Err"
        case .Err(_):
            assert false, "unreachable: init returned Err"

@image
pub fn build() -> Image:
    img = Image(name="err-boot-device-bringup", target=Target.wrela_machine_v1)
    blk = img.device[VirtioBlock](
        transport=0x2000,
        capacity_sectors=16,
        required_features=[Feature.Flush],
    )
    control = img.dma_pool[BlkReqHeader](name=BlockControl, device=blk, count=32)
    disk = img.driver(BlkDriver, device=blk)
    led = img.actor(Ledger, mailbox=8)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
