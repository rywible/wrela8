module examples.boot_untrusted_narrowing

# plans/M7.md item H2a's **real-boot oracle** (the A–H note: "a real HVF
# boot as the behavioral oracle wherever the item produces guest-visible
# behavior"). A narrowing emits a compare and a branch, so dump review
# alone is not enough — this transcript pins both a succeeding and a
# failing `checked_le` with hand-computed values.
#
# **Producer, and why it is not a second mechanism.** 03-hardware.md §8's
# worked producer is `completion.written_len` (item E4, fail-closed). The
# same section's rule is about device **control** values; an undirected
# `@layout(mmio)` register is one, reached through typed MMIO. Writing a
# known value and reading it back as `Untrusted[T]` is the same marking
# rule, not a source-visible `Untrusted.mark` constructor (rejected
# alternative, recorded in plans/M7.md). The window is guest DRAM
# (decision 11 / H1), so the guest's own store is what the subsequent
# load observes — no host-side device writer required (that is item G).
#
# Hand-computed:
#   write 7, read Untrusted(7)
#   checked_le(10) → Ok(7)   (7 <= 10)
#   checked_le(3)  → Err     (7 <= 3 is false)
#
# The vacuity control is `err-boot-untrusted-narrowing`: this same image
# with the success assertion inverted.

@layout(mmio, endian=little)
struct CtrlMmio:
    @offset(0x000) control: u32

struct VirtioBlock:
    id: u32

@driver
pub struct BlkDriver:
    regs: Mmio[CtrlMmio]
    seen_ok: u32
    seen_err: u32

    init(mut self, take cap: DeviceCap[VirtioBlock]):
        claimed = VirtioBlock.claim(cap=take cap)
        self.regs = claimed.map_partition(CtrlMmio)
        self.seen_ok = 0
        self.seen_err = 0

        self.regs.control.write(7)
        reported = self.regs.control.read()

        match reported.checked_le(10):
            case .Ok(v):
                assert v == 7, "checked_le(10) must yield the unmarked payload 7"
                self.seen_ok = v
            case .Err(_):
                assert false, "checked_le(10) must succeed for Untrusted(7)"

        match reported.checked_le(3):
            case .Ok(_):
                assert false, "checked_le(3) must fail for Untrusted(7)"
            case .Err(_):
                self.seen_err = 1

        assert self.seen_ok == 7, "success path recorded the narrowed value"
        assert self.seen_err == 1, "failure path recorded the Err arm"

@actor
pub struct Ledger:
    marks: u64

    pub fn mark(mut self, n: u64) -> unit:
        self.marks = self.marks * 10 + n
        return unit

    pub fn read_marks(read self) -> u64:
        return self.marks

@test(runtime)
async fn narrowing_ran(led: Actor[Ledger]):
    a = await led.mark(n=4)
    match a:
        case .Ok(_):
            pass
        case .Err(_):
            assert false, "mark rejected"
    b = await led.mark(n=2)
    match b:
        case .Ok(_):
            pass
        case .Err(_):
            assert false, "mark rejected"
    m = await led.read_marks()
    match m:
        case .Ok(v):
            assert v == 42, "two marks over an image whose driver narrowed Untrusted"
        case .Err(_):
            assert false, "read_marks rejected"

@image
pub fn build() -> Image:
    img = Image(name="boot-untrusted-narrowing", target=Target.wrela_machine_v1)
    blk = img.device[VirtioBlock](transport=0x2000)
    disk = img.driver(BlkDriver, device=blk)
    led = img.actor(Ledger, mailbox=8)
    img.supervise(children=[disk, led], strategy=Restart.OneForOne,
                  intensity=RestartIntensity(max=3, within=seconds(10)))
    return img.seal()
