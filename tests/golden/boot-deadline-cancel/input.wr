module examples.boot_deadline_cancel

# plans/M6.md item F flagship, decision 7's own flip witness for
# `machine.interrupts.checkpoint-injection` (06-machine.md §4: "the guest
# observes vectors only at checkpoints and parks"; 02-language.md §9.5:
# "Cancellation becomes observable at `await` and checkpoints, never
# between arbitrary instructions").
#
# The group's deadline is `now() + ms(0)` — a zero-budget bounded
# operation, already expired the moment it is armed. `worker` is a group
# child with a bounded 8-iteration loop; each iteration awaits `Counter`,
# so the scheduler regains control between iterations and the deadline
# service (`__wrela_deadline_poll`) runs. The service raises vector 0 into
# this core's pending word; the *next checkpoint any turn executes* — here
# `worker`'s own await-resume checkpoint — services it, the scan marks the
# group cancelled, and the cancellation test that is part of that same
# checkpoint terminates the child's activation.
#
# `Counter.n` is the deterministic iteration counter: exactly one `bump`
# turn completed before the cancellation landed, and the loop's own bound
# of 8 was never reached. Both halves are asserted, and both are
# load-bearing (asserting 2 instead of 1 fails; the child completing at
# all fails).

@actor
pub struct Counter:
    n: u64

    pub fn bump(mut self) -> u64:
        self.n = self.n + 1
        return self.n

    pub fn total(read self) -> u64:
        return self.n

async fn worker(c: Actor[Counter]) -> u64:
    i: u64 = 0
    while i < 8:
        r = await c.bump()
        match r:
            case .Ok(_):
                pass
            case .Err(_):
                pass
        i = i + 1
    return i

@test(runtime)
async fn deadline_cancels(c: Actor[Counter]):
    with group(capacity=1, deadline=now() + ms(0)) as g:
        g.start(worker, c=c)
        results = await g.join_all()
        for r in results:
            match r:
                case .Ok(_):
                    assert false, "the child must not complete: its group expired"
                case .Err(_):
                    pass
    n = await c.total()
    match n:
        case .Ok(v):
            assert v == 1, "cancellation landed at the child's first checkpoint past the deadline"
        case .Err(_):
            assert false, "total rejected"

@image
pub fn build() -> Image:
    img = Image(name="boot-deadline-cancel", target=Target.wrela_machine_v1)
    c = img.actor(Counter, mailbox=8)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
