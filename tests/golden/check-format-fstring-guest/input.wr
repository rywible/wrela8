module examples.check_format_fstring_guest


pub struct Pt deriving(Format):
    x: u32
    y: u32

@actor
pub struct Store:
    n: usize

    init(mut self):
        self.n = 0

    pub fn fmt_len(mut self) -> usize:
        s = f"pt={Pt(x=3, y=7)} n={self.n}"
        return s.len

@test(runtime)
async fn guest_fmt(store: Actor[Store]):
    v = await store.fmt_len()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match v:
        case .Ok(n):
            assert n == 19, "pt=Pt(x=3, y=7) n=0 is 19 bytes"
        case .Err(_):
            assert false, "call rejected"

@image
pub fn build() -> Image:
    img = Image(name="check-format-fstring-guest", target=Target.wrela_machine_v1)
    a = img.actor(Store, mailbox=4)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
