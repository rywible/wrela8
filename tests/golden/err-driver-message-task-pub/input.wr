module examples.err_driver_message_task_pub


@layout(mmio, endian=little)
struct VirtioIrqMmio:
    @offset(0x060) interrupt_status: ReadOnly[u32]
    @offset(0x064) interrupt_ack: WriteOnly[u32]

struct VirtioBlock:
    id: u32

@driver
pub struct BlkDriver:
    irq_regs: Mmio[VirtioIrqMmio]
    device: RunningDevice[VirtioBlock]
    pending: InterruptCell[u32]
    drains: u64

    @task
    pub fn drain(mut self) -> unit:
        status = self.pending.swap_acquire(0)
        if status == 0:
            return unit
        self.drains = self.drains + 1
        return unit

@image
pub fn build() -> Image:
    img = Image(name="driver-message-task-pub", target=Target.wrela_machine_v1)
    blk = img.device[VirtioBlock](transport=0x2000, capacity_sectors=16)
    d = img.driver(BlkDriver, device=blk, mailbox=4)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
