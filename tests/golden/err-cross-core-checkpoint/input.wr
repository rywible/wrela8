module examples.err_cross_core_checkpoint


@actor
pub struct Cell:
    n: u64

    init(mut self):
        self.n = 1

    pub fn get(read self) -> u64:
        return self.n

@actor
pub struct Spinner:
    n: u64
    cell: Actor[Cell]

    init(mut self, cell: Actor[Cell]):
        self.n = 0
        self.cell = cell

    pub async fn tick(mut self) -> u64:
        i: u64 = 0
        while i < 3:
            outcome = await self.cell.get()
            @discard(reason="migrated: deliberate Err discard (M13 item L)")
            match outcome:
                case .Ok(v):
                    self.n = self.n + v
                case .Err(_):
                    pass
            i = i + 1
        return self.n

@test(runtime)
async fn spins_off_core(s: Actor[Spinner]):
    v = await s.tick()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match v:
        case .Ok(n):
            assert n == 3, "unreachable: this image must not build"
        case .Err(_):
            assert false, "unreachable: this image must not build"

@image
pub fn build() -> Image:
    img = Image(name="cross-core-checkpoint", target=Target.wrela_machine_v1, cores=2)
    c = img.actor(Cell, mailbox=4, core=1)
    s = img.actor(Spinner, mailbox=4, core=1, cell=c)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
