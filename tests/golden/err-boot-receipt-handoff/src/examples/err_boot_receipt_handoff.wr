module examples.err_boot_receipt_handoff

from core.io_error import IoError


@layout(mmio, endian=little)
struct VirtioIrqMmio:
    @offset(0x060) interrupt_status: ReadOnly[u32]
    @offset(0x064) interrupt_ack: WriteOnly[u32]

@layout(dma, endian=little)
struct BlkReqHeader:
    kind: u32
    reserved: u32
    sector: u64

@layout(dma, endian=little)
struct BlkReqStatus:
    status: u8

@layout(dma, endian=little)
struct DmaBlock:
    @offset(0) word: u64
    @offset(504) pad_end: u64

struct VirtioBlock:
    id: u32

enum Feature:
    Flush

const QDEPTH: usize = 8
const BLK_T_IN: u32 = 0
const BLK_T_OUT: u32 = 1
const MAGIC: u64 = 0xD15EA5E0C0FFEE11

pool BlockControl
pool BlockPayloads

@driver
pub struct BlkDriver:
    irq_regs: Mmio[VirtioIrqMmio]
    device: RunningDevice[VirtioBlock]
    queue: VirtQueue[..8]
    capacity_sectors: u64
    pending: InterruptCell[u32]
    irq: IrqCap[u32]
    drains: u64

    init(mut self,
         take cap: DeviceCap[VirtioBlock],
         take control_pool: DmaPool[BlockControl, 512])
        -> Result[unit, BootError]:
        claimed = VirtioBlock.claim(cap=take cap)
        self.irq_regs = claimed.map_partition(VirtioIrqMmio)
        self.pending = InterruptCell(0)
        self.drains = 0
        negotiated = claimed.negotiate(
            required=[Feature.Flush],
            optional=[Feature.Flush],
        )?
        self.queue = VirtQueue.configure(
            pool=take control_pool,
            device=mut negotiated,
            index=0,
            depth=QDEPTH,
        )?
        self.capacity_sectors = 16
        irq = negotiated.take_irq()
        irq.bind(self.on_queue_irq)
        irq.unmask()
        self.irq = take irq
        self.device = negotiated.start()
        return Ok(unit)

    fn on_queue_irq(self):
        status = self.irq_regs.interrupt_status.read()
        handled = status & 1
        if handled != 0:
            self.pending.fetch_or_release(handled)
            self.irq_regs.interrupt_ack.write(handled)
            wake(BlkDriver.drain)

    @task
    fn drain(mut self):
        status = self.pending.swap_acquire(0)
        if status == 0:
            return unit
        self.drains = self.drains + 1
        self.queue.drain(max=QDEPTH)
        return unit

    pub fn submit_write(mut self, lba: u64,
                        take buffer: own[BlockPayloads] DmaBlock)
        -> Receipt[own[BlockPayloads] DmaBlock]:
        if lba >= self.capacity_sectors:
            return self.queue.reject(
                payload=take buffer,
                error=IoError.OutOfRange,
            )
        permit = self.queue.reserve(descriptors=3)
        operation = self.queue.prepare_block(
            permit=take permit,
            header=BlkReqHeader(kind=BLK_T_OUT, reserved=0, sector=lba),
            payload=take buffer,
            device_writes_payload=false,
            status=BlkReqStatus(status=0xff),
            idempotent=false,
        )
        return self.queue.publish(operation=take operation)

    pub fn submit_read(mut self, lba: u64,
                       take buffer: own[BlockPayloads] DmaBlock)
        -> Receipt[own[BlockPayloads] DmaBlock]:
        if lba >= self.capacity_sectors:
            return self.queue.reject(
                payload=take buffer,
                error=IoError.OutOfRange,
            )
        permit = self.queue.reserve(descriptors=3)
        operation = self.queue.prepare_block(
            permit=take permit,
            header=BlkReqHeader(kind=BLK_T_IN, reserved=0, sector=lba),
            payload=take buffer,
            device_writes_payload=true,
            status=BlkReqStatus(status=0xff),
            idempotent=true,
        )
        return self.queue.publish(operation=take operation)

    pub fn drain_count(read self) -> u64:
        return self.drains

@actor
pub struct Ledger:
    marks: u64

    pub fn mark(mut self, n: u64) -> u64:
        self.marks = self.marks * 10 + n
        return self.marks

    pub fn read_marks(read self) -> u64:
        return self.marks

@actor
pub struct Client:
    disk: Actor[BlkDriver]
    led: Actor[Ledger]
    block: Option[own[BlockPayloads] DmaBlock]
    seen: u64
    witness: u64

    init(mut self, disk: Actor[BlkDriver], led: Actor[Ledger],
         take block: own[BlockPayloads] DmaBlock):
        self.disk = disk
        self.led = led
        self.block = Some(take block)
        self.seen = 0
        self.witness = 0

    fn take_block(mut self) -> own[BlockPayloads] DmaBlock:
        held = take self.block
        self.block = None
        match held:
            case .Some(b):
                return take b
            case .None:
                panic("client has no payload slot")

    fn stash_and_clear(mut self,
                       take completion: IoCompletion[own[BlockPayloads] DmaBlock]) -> u64:
        empty = take self.block
        match empty:
            case .None:
                pass
            case .Some(_):
                assert false, "the payload slot is still held at completion"
        b = take completion.payload
        w = b.word
        b.word = 0
        self.block = Some(take b)
        return w

    fn stash(mut self,
             take completion: IoCompletion[own[BlockPayloads] DmaBlock]) -> u64:
        empty = take self.block
        match empty:
            case .None:
                pass
            case .Some(_):
                assert false, "the payload slot is still held at completion"
        b = take completion.payload
        w = b.word
        self.seen = w
        self.block = Some(take b)
        return w

    pub fn read_seen(read self) -> u64:
        return self.seen

    pub fn read_witness(read self) -> u64:
        return self.witness

    pub async fn round_trip(mut self) -> u64:
        buf = self.take_block()
        buf.word = MAGIC
        r1 = await self.disk.submit_write(lba=0, buffer=take buf)
        c1 = await r1
        cleared = self.stash_and_clear(completion=take c1)
        assert cleared == MAGIC, "the write completion returns the payload the caller lent"
        m = await self.led.mark(n=7)
        @discard(reason="migrated: deliberate Err discard (M13 item L)")
        match m:
            case .Ok(v):
                self.witness = v
            case .Err(_):
                assert false, "ledger mark rejected"
        buf2 = self.take_block()
        r2 = await self.disk.submit_read(lba=0, buffer=take buf2)
        c2 = await r2
        return self.stash(completion=take c2)

@test(runtime)
async fn a_caller_owned_receipt_resolves_with_the_device_word(cl: Actor[Client]):
    v = await cl.round_trip()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match v:
        case .Ok(n):
            assert n == 0xD15EA5E0C0FFEE1F, "vacuity twin: the disk holds ...EE11, so this must fail"
        case .Err(_):
            assert false, "round_trip rejected"

@test(runtime)
async fn the_parked_turn_really_left_and_re_entered(cl: Actor[Client]):
    w = await cl.read_witness()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match w:
        case .Ok(n):
            assert n == 7, "a Ledger turn ran between the two halves of one parked caller turn"
        case .Err(_):
            assert false, "read_witness rejected"

@test(runtime)
async fn the_bottom_half_is_what_resolved_them(disk: Actor[BlkDriver]):
    d = await disk.drain_count()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match d:
        case .Ok(n):
            assert n == 3, "the bottom half woke for every handoff"
        case .Err(_):
            assert false, "drain_count rejected"

@image
pub fn build() -> Image:
    img = Image(name="err-boot-receipt-handoff", target=Target.wrela_machine_v1)
    blk = img.device[VirtioBlock](
        transport=0x2000,
        capacity_sectors=16,
        required_features=[Feature.Flush],
        vector=1,
    )
    control = img.dma_pool[BlkReqHeader](name=BlockControl, device=blk, count=32)
    payloads = img.dma_pool[DmaBlock](name=BlockPayloads, device=blk, count=1)
    disk = img.driver(BlkDriver, device=blk, mailbox=4)
    led = img.actor(Ledger, mailbox=4)
    cl = img.actor(Client, mailbox=4, disk=disk, led=led, block=take payloads)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
