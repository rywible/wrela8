module examples.check_pixels_field_ops

from core.field import (
    Field,
    Rgb,
    Vec2,
    Vec3,
    box,
    capsule,
    cos_scalar,
    cross3,
    dot3,
    finite_cone,
    finite_cylinder,
    finite_repeat_x,
    finite_repeat_y,
    finite_repeat_z,
    intersection,
    length2,
    length3,
    mark,
    normalize3,
    plane,
    rigid_transform,
    rsqrt_scalar,
    rotate,
    round_box,
    sinusoidal_displace,
    sin_scalar,
    smooth_intersection,
    smooth_subtract,
    smooth_union,
    sphere,
    sqrt_scalar,
    subtract,
    torus,
    translate,
    uniform_scale,
    union,
)
from core.render import (
    AoConfig,
    CameraBounds,
    LightConfig,
    MaterialSample,
    ProbeConfig,
    RenderProfile,
    RgbRange,
    ScalarRange,
    SurfaceContext,
    ToneCurve,
)
from drivers.display import Display, DisplayDevice

enum ObjectId:
    Scene

enum MaterialId:
    Surface

struct SceneParams:
    marker: bool
    @range(min=-0.125, max=0.125)
    offset: f32
    @range(min=-1.0, max=1.0)
    capsule_a: Vec3
    @range(min=-1.0, max=1.0)
    capsule_b: Vec3

struct RadiusSpec:
    base: f32
    extra: f32 = 0.125

fn identity[T](value: T) -> T:
    return value

fn default_radius(value: f32 = 0.125) -> f32:
    return value

@field
fn world(p: Vec3, read params: SceneParams) -> Field:
    row_x = Vec3(x=1.0, y=0.0, z=0.0)
    row_y = Vec3(x=0.0, y=1.0, z=0.0)
    row_z = Vec3(x=0.0, y=0.0, z=1.0)
    translated = translate(p, Vec3(x=1.0, y=0.0, z=0.0))
    rotated = rotate(
        translated,
        Vec3(x=0.70710678, y=-0.70710678, z=0.0),
        Vec3(x=0.70710678, y=0.70710678, z=0.0),
        Vec3(x=0.0, y=0.0, z=1.0),
    )
    rigid = rigid_transform(
        rotated,
        Vec3(x=0.0, y=1.0, z=0.0),
        Vec3(x=1.0, y=0.0, z=0.0),
        Vec3(x=0.0, y=1.0, z=0.0),
        Vec3(x=0.0, y=0.0, z=1.0),
    )
    # This exhaustive intrinsic fixture needs each finite-repeat lowering, not
    # their 3³ Cartesian expansion; check-pixels-repeat pins multi-instance
    # boundaries and capacity behavior without creating a quadratic pair dump.
    repeated_x = finite_repeat_x(rigid, first=0, count=1, period=2.0)
    repeated_y = finite_repeat_y(repeated_x, first=0, count=1, period=2.0)
    repeated = finite_repeat_z(repeated_y, first=0, count=1, period=2.0)
    zero: f32 = 0.0
    dynamic_axis = Vec3(x=params.offset, y=1.0, z=0.0)
    derived_normal = normalize3(cross3(row_z, dynamic_axis))
    a = plane(rigid, derived_normal, offset=identity(zero))
    b = sphere(repeated, Vec3(x=0.0, y=0.0, z=0.0), radius=1.0)
    c = box(repeated, Vec3(x=1.0, y=1.0, z=1.0))
    d = round_box(repeated, Vec3(x=1.0, y=1.0, z=1.0), radius=0.1)
    separated_b = params.capsule_b.add(Vec3(x=3.0, y=0.0, z=0.0))
    e = capsule(repeated, params.capsule_a, separated_b, radius=0.2)
    f = finite_cylinder(repeated, radius=1.0, half_height=1.0)
    g = finite_cone(repeated, radius=1.0, half_height=1.0)
    h = torus(repeated, major_radius=1.0, minor_radius=0.2)
    rotated_only = rotate(
        p,
        Vec3(x=0.0, y=-1.0, z=0.0),
        Vec3(x=1.0, y=0.0, z=0.0),
        Vec3(x=0.0, y=0.0, z=1.0),
    )
    j = sphere(rotated_only, Vec3(x=0.0, y=0.0, z=0.0), radius=0.375)
    added = p.add(Vec3(x=0.25, y=0.0, z=0.0))
    scalar_mix = (
        sqrt_scalar(params.offset * params.offset + 0.015625)
        + rsqrt_scalar(params.offset * params.offset + 1.0)
        + sin_scalar(params.offset)
        + cos_scalar(params.offset)
        + dot3(row_x, dynamic_axis)
        + length2(Vec2(x=params.offset, y=0.125))
        + length3(dynamic_axis)
    )
    radius = RadiusSpec(base=default_radius())
    i = sphere(
        added,
        Vec3(x=0.0, y=0.0, z=0.0),
        radius=radius.base + radius.extra + scalar_mix,
    )
    degenerate = capsule(
        p,
        Vec3(x=0.5, y=0.5, z=0.5),
        Vec3(x=0.5, y=0.5, z=0.5),
        radius=0.1,
    )
    hard = subtract(
        intersection(union(a, b), union(c, d)),
        union(union(e, f), union(union(i, degenerate), j)),
    )
    smooth = smooth_subtract(smooth_intersection(smooth_union(g, h, k=0.1), g, k=0.1), h, k=0.1)
    scaled = uniform_scale(smooth, scale=2.0)
    displaced = sinusoidal_displace(scaled, rigid, amplitude=0.1, frequency=0.25, phase=0.0)
    return mark(union(hard, displaced), object=ObjectId.Scene, material=MaterialId.Surface)

@material
fn shade(surface: SurfaceContext[MaterialId], read params: SceneParams) -> MaterialSample:
    color = Rgb(r=0.25, g=0.5, b=0.75)
    if surface.position.x < 0.0:
        color = Rgb(r=0.125, g=0.25, b=0.5)
    else:
        color = Rgb(r=0.75, g=0.5, b=0.25)
    roughness = 0.5 + params.offset * surface.normal.x
    return MaterialSample.standard(color=color, roughness=roughness)

@image
fn build() -> Image:
    img = Image(name="check-pixels-field-ops", target=Target.wrela_machine_v1)
    device = img.device[DisplayDevice](transport=0x6000)
    display = img.driver(Display, device=device, width=64, height=32, refresh_hz=60)
    renderer = img.renderer[SceneParams](
        field=world,
        material=shade,
        display=display,
        width=64,
        height=32,
        refresh_hz=60,
        shade_hz=60,
        profile=RenderProfile.AaaByteExact,
        tone_curve=ToneCurve.Linear,
        near=0.1,
        far=128.0,
        world_min=Vec3(x=-4.0, y=-4.0, z=-4.0),
        world_max=Vec3(x=4.0, y=4.0, z=4.0),
        camera_bounds=CameraBounds.bounded(max_motion=0.25),
        light_config=LightConfig.fixed(capacity=0),
        exposure_range=ScalarRange(min=-1.0, max=1.0),
        environment_range=RgbRange(
            min=Rgb(r=0.0, g=0.0, b=0.0),
            max=Rgb(r=1.0, g=1.0, b=1.0),
        ),
        ao=AoConfig.fixed(enabled=false),
        probes=ProbeConfig.fixed(enabled=false),
        initialization_deadline_ms=10,
    )
    img.on_failure(policy=Failure.Halt)
    return img.seal()
