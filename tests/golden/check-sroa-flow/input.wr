module examples.check_sroa_flow

struct Pair:
    left: u64
    right: u64

@actor
pub struct Counter:
    value: u64

    pub fn get(read self) -> u64:
        return self.value

@actor
pub struct Coordinator:
    counter: Actor[Counter]

    pub async fn run(mut self) -> u64:
        result = await self.counter.get()
        @discard(reason="deliberate error-path collapse")
        match result:
            case .Ok(value):
                pair = Pair(left=10, right=20)
                return pair.left + pair.right + value
            case .Err(_):
                return 0
