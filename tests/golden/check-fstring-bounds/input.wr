module examples.check_fstring_bounds

# plans/M9.md item D / D2. f-strings sum Format bounds into String[..N]
# (02 §1.1 / 05 §6). Value pins (bytes + length), not mere compilation.
# Guest-tier lowering is pinned by check-format-fstring-guest (item D3);
# after H3 this fixture's mwir is only Store.init (comptime-only callees).
#
# Item D2: the most obvious spellings first — `f"{42}"`, inferred
# `a = 42; f"a={a}"` — not only annotated consts/params (which hid the
# access-pass literal-defaulting hole).

fn dig20(s: String[..20]) -> u64:
    return s.len.to[u64]() * 1000000 + s[0].to[u64]() * 1000 + s[1].to[u64]()

fn dig22(s: String[..22]) -> u64:
    return s.len.to[u64]() * 1000000 + s[0].to[u64]() * 1000 + s[1].to[u64]()

# Literal interpolation (defaults to i64 → String[..20]): value "42".
fn fstr_lit() -> u64:
    return dig20(f"{42}")

const LIT: u64 = fstr_lit()

# Inferred local interpolation: value "a=42".
fn fstr_inf() -> u64:
    a = 42
    return dig22(f"a={a}")

const INF: u64 = fstr_inf()

const X: u32 = 42
const Y: bool = false

# f"n={X} ok={Y}" bound = 2+10+4+5 = 21; value "n=42 ok=false" (13 bytes).
fn dig21(s: String[..21]) -> u64:
    return s.len.to[u64]() * 1000000 + s[0].to[u64]() * 1000 + s[1].to[u64]()

const MIXED: u64 = dig21(f"n={X} ok={Y}")

# f"{{literal}}" → "{literal}" bound 9.
fn dig9(s: String[..9]) -> u64:
    return s.len.to[u64]() * 1000000 + s[0].to[u64]() * 1000 + s[1].to[u64]()

const BRACES: u64 = dig9(f"{{literal}}")

# Guest-reachable f-string: lowered fn body (not comptime-only).
fn label(n: u32) -> String[..13]:
    return f"id={n}"

fn dig13(s: String[..13]) -> u64:
    return s.len.to[u64]() * 1000000 + s[0].to[u64]() * 1000 + s[1].to[u64]()

const LABEL: u64 = dig13(label(7))

fn bound_of(s: String[..21]) -> u64:
    return 21

const BOUND: u64 = bound_of(f"n={X} ok={Y}")

@test
pub fn t_lit():
    assert LIT == 2052050, "f\"{42}\" is \"42\""

@test
pub fn t_inf():
    assert INF == 4097061, "f\"a={a}\" with a=42 inferred"

@test
pub fn t_mixed():
    assert MIXED == 13110061, "n=42 ok=false"

@test
pub fn t_braces():
    assert BRACES == 9123108, "{literal}"

@test
pub fn t_label():
    assert LABEL == 4105100, "id=7"

@test
pub fn t_bound():
    assert BOUND == 21, "summed Format bounds"

@actor
pub struct Store:
    lit: u64
    inf: u64
    mixed: u64
    braces: u64
    label: u64
    bound: u64

    init(mut self, lit: u64, inf: u64, mixed: u64, braces: u64, label: u64, bound: u64):
        self.lit = lit
        self.inf = inf
        self.mixed = mixed
        self.braces = braces
        self.label = label
        self.bound = bound

@image
pub fn build() -> Image:
    img = Image(name="check-fstring-bounds", target=Target.wrela_machine_v1)
    storage = img.actor(Store, lit=LIT, inf=INF, mixed=MIXED, braces=BRACES,
                        label=LABEL, bound=BOUND, mailbox=4)
    img.supervise(children=[storage], strategy=Restart.OneForOne,
                  intensity=RestartIntensity(max=3, within=seconds(10)))
    return img.seal()
