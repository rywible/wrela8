module examples.err_try_from_underived

# plans/M9.md item BB, decision 61. 02-language.md §7.4 desugars
# `Err(e)?` needing conversion to `TargetError.from(take e)`, and §7.5
# says `deriving(From)` generates that method. Nothing in this compiler
# generates it yet (item B owns that), and `from` is a reserved word so
# no user can declare one either — so *every* `?` that needs a
# conversion reaches the evaluator with no body to call.
#
# It used to say `internal error: `from` conversion `WrapError.from` not
# found`, and an `internal error:` is a bug by house rule (CLAUDE.md).
# It is a named, fail-closed gap instead, matching what the backend
# already reports for the same shape ("a `?` conversion (`From`) in a
# synchronous body is not implemented yet"). When item B lands, this case
# stops being an `err-` case — that is the intended signal.

pub enum LoadError deriving(From):
    Bad(u32)

pub enum WrapError deriving(From):
    Inner(LoadError)

pub fn parse(raw: u32) -> Result[u32, LoadError]:
    if raw == 0:
        return Err(LoadError.Bad(raw))
    return Ok(raw)

pub fn convert_wrapped(raw: u32) -> Result[u32, WrapError]:
    value = parse(raw)?
    return Ok(value)

fn settle(r: Result[u32, WrapError]) -> u32:
    match r:
        case .Ok(v):
            return v
        case .Err(e):
            return 1

const CONVERTED: u32 = settle(convert_wrapped(0))
