module examples.boot_cross_core_driver_mailbox


struct Hw:
    id: u32

enum Feature:
    Flush

@driver
pub struct Stub:
    n: u64

    init(mut self):
        self.n = 0

    pub fn note(mut self) -> unit:
        self.n = self.n + 1
        return unit

    pub fn count(read self) -> u64:
        return self.n

@actor
pub struct Probe:
    disk: Actor[Stub]

    init(mut self, disk: Actor[Stub]):
        self.disk = disk

    pub async fn fire(read self) -> unit:
        r = send self.disk.note()
        @discard(reason="migrated: deliberate Err discard (M13 item L)")
        match r:
            case .Ok(_):
                return unit
            case .Err(_):
                return unit

@test(runtime)
async fn cross_core_send_into_driver_mailbox(p: Actor[Probe], d: Actor[Stub]):
    r = await p.fire()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match r:
        case .Ok(_):
            pass
        case .Err(_):
            assert false, "Probe.fire rejected"
    v = await d.count()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match v:
        case .Ok(n):
            assert n == 1, "Stub.note must have run on core 0 after Probe's cross-core send"
        case .Err(_):
            assert false, "Stub.count rejected"

@image
pub fn build() -> Image:
    img = Image(name="cross-core-driver-mailbox", target=Target.wrela_machine_v1, cores=3)
    hw = img.device[Hw](transport=0x1000, required_features=[Feature.Flush])
    stub = img.driver(Stub, device=hw, mailbox=4)
    probe = img.actor(Probe, mailbox=4, core=1, disk=stub)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
