module examples.boot_pixels_walking_skeleton

from core.field import Field, Rgb, Vec3, mark, plane, translate
from core.render import (
    AoConfig,
    CameraBounds,
    LightConfig,
    MaterialSample,
    ProbeConfig,
    RenderProfile,
    RgbRange,
    ScalarRange,
    SurfaceContext,
    ToneCurve,
)
from core.render_program import FrameProgramView, ProgramViewError, TileId
from drivers.display import Display, DisplayDevice

struct SceneParams:
    @range(min=-2.0, max=2.0)
    height: f32

enum ObjectId:
    Ground

enum MaterialId:
    Ground

@field
fn world(p: Vec3, read params: SceneParams) -> Field:
    shifted = translate(p, Vec3(x=0.0, y=params.height, z=0.0))
    return mark(
        plane(shifted, Vec3(x=0.0, y=1.0, z=0.0), offset=0.0),
        object=ObjectId.Ground,
        material=MaterialId.Ground,
    )

@material
fn shade(surface: SurfaceContext[MaterialId], read params: SceneParams) -> MaterialSample:
    return MaterialSample.standard(
        color=Rgb(r=0.25, g=0.5, b=0.75),
        roughness=0.5,
    )

@test(runtime)
fn frame_program_view_reads_sealed_records():
    opened = FrameProgramView.initialize(renderer=0)
    match opened:
        case .Err(_):
            assert false, "generated frame program header must validate"
        case .Ok(view):
            header = view.header()
            assert header.renderer_index == 0, "sealed renderer index"
            assert header.table_count == 17, "sealed table count"
            feature = view.feature(id=0)
            match feature:
                case .Err(_):
                    assert false, "feature zero is present"
                case .Ok(record):
                    assert record.stable_id == 0, "stable feature id"
            features = view.tile_features(tile=TileId(value=0))
            match features:
                case .Err(_):
                    assert false, "first tile is present"
                case .Ok(slice):
                    assert slice.length() == 1, "plane overlaps the first tile"
                    first = slice.get(ordinal=0)
                    match first:
                        case .Err(_):
                            assert false, "first tile feature is present"
                        case .Ok(feature_id):
                            assert feature_id.value == 0, "first tile feature id"
                    past_end = slice.get(ordinal=1)
                    match past_end:
                        case .Err(error):
                            match error:
                                case .ProgramIndex:
                                    pass
                                case _:
                                    assert false, "out-of-range access has the exact invariant"
                        case .Ok(_):
                            assert false, "out-of-range tile feature cannot be read"
            invalid_tile = view.tile_features(tile=TileId(value=4294967295))
            match invalid_tile:
                case .Err(error):
                    match error:
                        case .ProgramIndex:
                            pass
                        case _:
                            assert false, "invalid tile uses the exact invariant"
                case .Ok(_):
                    assert false, "invalid tile cannot become an empty slice"

@image
pub fn build() -> Image:
    img = Image(name="boot-pixels-walking-skeleton", target=Target.wrela_machine_v1)
    display_device = img.device[DisplayDevice](transport=0x6000)
    display = img.driver(Display, device=display_device, width=64, height=32, refresh_hz=60)
    renderer = img.renderer[SceneParams](
        field=world,
        material=shade,
        display=display,
        width=64,
        height=32,
        refresh_hz=60,
        shade_hz=60,
        profile=RenderProfile.AaaByteExact,
        tone_curve=ToneCurve.Linear,
        near=0.1,
        far=10.0,
        world_min=Vec3(x=-2.0, y=-2.0, z=-2.0),
        world_max=Vec3(x=2.0, y=2.0, z=2.0),
        camera_bounds=CameraBounds.bounded(max_motion=0.25),
        light_config=LightConfig.fixed(capacity=0),
        exposure_range=ScalarRange(min=-1.0, max=1.0),
        environment_range=RgbRange(
            min=Rgb(r=0.0, g=0.0, b=0.0),
            max=Rgb(r=1.0, g=1.0, b=1.0),
        ),
        ao=AoConfig.fixed(enabled=false),
        probes=ProbeConfig.fixed(enabled=false),
        initialization_deadline_ms=10,
    )
    img.on_failure(policy=Failure.Halt)
    return img.seal()
