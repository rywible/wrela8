module examples.err_image_two_parents

@driver
pub struct Blk:
    id: u32

    init(mut self):
        self.id = 1

@image
pub fn build() -> Image:
    img = Image(name="two-parents", target=Target.wrela_machine_v1)
    disk = img.driver(Blk)
    img.supervise(children=[disk], strategy=Restart.OneForOne,
                  intensity=RestartIntensity(max=3, within=seconds(10)))
    img.supervise(children=[disk], strategy=Restart.OneForOne,
                  intensity=RestartIntensity(max=3, within=seconds(10)))
    return img.seal()
