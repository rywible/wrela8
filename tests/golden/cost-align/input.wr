module examples.cost_align


pub fn widths(a: u8, b: u16, c: u32, d: u64) -> u64:
    w0: u8 = a +% a
    w1: u16 = b +% b
    w2: u32 = c +% c
    w3: u64 = d +% d
    x0: u64 = w0.to[u64]()
    x1: u64 = w1.to[u64]()
    x2: u64 = w2.to[u64]()
    return x0 +% x1 +% x2 +% w3

pub fn byte_lane(v: [u8; 16]) -> u64:
    s0: u8 = v[0] +% v[1]
    s1: u8 = v[2] +% v[3]
    s2: u8 = v[4] +% v[5]
    s3: u8 = v[6] +% v[7]
    s4: u8 = v[8] +% v[9]
    s5: u8 = v[10] +% v[11]
    s6: u8 = v[12] +% v[13]
    s7: u8 = v[14] +% v[15]
    t0: u8 = s0 +% s1 +% s2 +% s3
    t1: u8 = s4 +% s5 +% s6 +% s7
    return (t0 +% t1).to[u64]()

struct Packed:
    a: u8
    b: u16
    c: u32
    d: u64
    e: u8

pub fn packed_fields(p: Packed) -> u64:
    q: Packed = p
    q.a = p.a +% 1
    q.b = p.b +% 1
    q.c = p.c +% 1
    q.d = p.d +% 1
    q.e = p.e +% 1
    return q.a.to[u64]() +% q.b.to[u64]() +% q.c.to[u64]() +% q.d +% q.e.to[u64]()
