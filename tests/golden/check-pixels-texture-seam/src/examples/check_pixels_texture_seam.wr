module examples.check_pixels_texture_seam

from core.field import (
    Field,
    Rgb,
    Vec3,
    mark,
    sphere,
)
from core.render import (
    AoConfig,
    CameraBounds,
    LightConfig,
    MaterialSample,
    ProbeConfig,
    RenderProfile,
    RgbRange,
    ScalarRange,
    SurfaceContext,
    TextureFilter,
    ToneCurve,
    UvSource,
)
from drivers.display import Display, DisplayDevice

const FIXTURE_ID: u32 = 19
# P3 records the immutable texture contract; P9 implements filtered sampling.

fn fixture_id() -> u32:
    return FIXTURE_ID

const U_LEFT_RAW: i32 = 255
const U_RIGHT_RAW: i32 = 0
const UV_FRAC_BITS: u8 = 8

struct SceneParams:
    @range(min=-2.0, max=2.0)
    @rate(max_delta=0.25, max_second_delta=0.0625)
    phase: f32

enum MaterialId:
    Ground

@field
fn world(p: Vec3, read params: SceneParams) -> Field:
    seam = sphere(p, Vec3(x=0.0, y=0.0, z=0.0), radius=1.0)
    return mark(seam, object=MaterialId.Ground, material=MaterialId.Ground)

@material
fn shade(surface: SurfaceContext[MaterialId], read params: SceneParams) -> MaterialSample:
    return MaterialSample.textured(
        color=Rgb(r=0.25, g=0.5, b=0.75),
        roughness=0.5,
        texture_id=19,
        width=2,
        height=2,
        filter=TextureFilter.Anisotropic4,
        uv_source=UvSource.Sphere,
    )

@test(runtime)
fn pinned_scene_contract():
    assert FIXTURE_ID == 19, "fixture id must remain pinned"
    assert U_LEFT_RAW == 255, "adversarial scene value must remain pinned"

@image
pub fn build() -> Image:
    img = Image(name="check-pixels-texture-seam", target=Target.wrela_machine_v1)
    display_device = img.device[DisplayDevice](transport=0x6000)
    display = img.driver(Display, device=display_device, width=64, height=32, refresh_hz=60)
    renderer = img.renderer[SceneParams](
        field=world,
        material=shade,
        display=display,
        width=64,
        height=32,
        refresh_hz=60,
        shade_hz=60,
        profile=RenderProfile.AaaByteExact,
        tone_curve=ToneCurve.Linear,
        near=0.1,
        far=128.0,
        world_min=Vec3(x=-4.0, y=-4.0, z=-4.0),
        world_max=Vec3(x=4.0, y=4.0, z=4.0),
        camera_bounds=CameraBounds.bounded(max_motion=0.25),
        light_config=LightConfig.fixed(capacity=0),
        exposure_range=ScalarRange(min=-1.0, max=1.0),
        environment_range=RgbRange(
            min=Rgb(r=0.0, g=0.0, b=0.0),
            max=Rgb(r=1.0, g=1.0, b=1.0),
        ),
        ao=AoConfig.fixed(enabled=false),
        probes=ProbeConfig.fixed(enabled=false),
        initialization_deadline_ms=10,
    )
    img.on_failure(policy=Failure.Halt)
    return img.seal()
