module examples.check_tests_checked_narrow

# plans/codegen-pareto.md item C2's differential oracle.
#
# WHY THIS CASE EXISTS. `cargo xtask diff-eval` runs every golden case's
# comptime `@test` fns in the evaluator and on the real backend under the
# VMM and requires them to agree. Item C2 replaces the narrow
# checked-arithmetic range check — two constant materializations, two
# compares and two abort sequences — with a single masked test, and that
# is the highest-risk change in the item: an overflow check that is subtly
# wrong is a correctness bug, not a perf regression.
#
# Before this case the corpus could not see it. `check-tests-arith`
# exercises **wrapping** arithmetic (`+%`, `-%`), which never emits a range
# check at all; nothing anywhere ran a *checked* narrow `+ - *` or a
# narrowing `.to[T]()` through the differential. So the new path had an
# oracle that never reached it, which freeze 1714 says is not an oracle.
#
# WHAT IT PINS. Every assertion below lands **exactly on a boundary of the
# declared type's range** — the last legal value, or the first. That is
# where the substitution can go wrong and nowhere else:
#
#   * Unsigned, the check is `v & !(2^bits - 1) == 0`. A mask one bit too
#     wide rejects the type's own maximum; a mask one bit too narrow
#     accepts a value the type cannot hold, and the wrong value then shows
#     up in the comparison. Both are visible at `max` and at `0`.
#   * Signed, the check is `sbfx(v, 0, bits) == v`. A field one bit too
#     narrow rejects `max`; one bit too wide accepts an out-of-range
#     value. Both are visible at `max` and at `min`.
#
# Subtraction to exactly `0` matters separately for the unsigned case: a
# checked `-` on two canonical unsigned operands can produce a *negative*
# 64-bit intermediate, and the masked form has to reject that through bit
# 63 rather than through a comparison against zero.
#
# Grouped one `@test` per declared type rather than one per assertion:
# `rtconfig`'s runtime test pool holds 16 and this case would otherwise
# want 17. The assertions, and the paths they reach, are the same either
# way.

# --- unsigned: each width reaches its own boundary by each checked op ---

@test
pub fn test_u8_checked_ops_reach_the_boundary():
    a: u8 = 254
    b: u8 = 1
    assert a + b == 255, "u8 254 + 1 is the last legal u8"
    c: u8 = 7
    assert c - c == 0, "u8 7 - 7 is the first legal u8"
    d: u8 = 15
    e: u8 = 17
    assert d * e == 255, "u8 15 * 17 is exactly u8::MAX"

@test
pub fn test_u16_checked_ops_reach_the_boundary():
    a: u16 = 65534
    b: u16 = 1
    assert a + b == 65535, "u16 65534 + 1 is the last legal u16"
    c: u16 = 255
    d: u16 = 257
    assert c * d == 65535, "u16 255 * 257 is exactly u16::MAX"
    assert a - a == 0, "u16 subtraction reaching exactly zero stays legal"

@test
pub fn test_u32_checked_ops_reach_the_boundary():
    a: u32 = 4294967294
    b: u32 = 1
    assert a + b == 4294967295, "u32 max-1 + 1 is the last legal u32"
    c: u32 = 65535
    d: u32 = 65537
    assert c * d == 4294967295, "u32 65535 * 65537 is exactly u32::MAX"
    assert a - a == 0, "u32 subtraction reaching exactly zero stays legal"

# --- signed: both ends, where the sign-extension test is decided -------

@test
pub fn test_i8_checked_ops_reach_both_ends():
    a: i8 = 126
    b: i8 = 1
    assert a + b == 127, "i8 126 + 1 is the last legal i8"
    c: i8 = -127
    assert c - b == -128, "i8 -127 - 1 is the first legal i8"
    d: i8 = -64
    e: i8 = 2
    assert d * e == -128, "i8 -64 * 2 is exactly i8::MIN"

@test
pub fn test_i16_checked_ops_reach_both_ends():
    a: i16 = 32766
    b: i16 = 1
    assert a + b == 32767, "i16 32766 + 1 is the last legal i16"
    c: i16 = -32767
    assert c - b == -32768, "i16 -32767 - 1 is the first legal i16"

@test
pub fn test_i32_checked_ops_reach_both_ends():
    a: i32 = 2147483646
    b: i32 = 1
    assert a + b == 2147483647, "i32 max-1 + 1 is the last legal i32"
    c: i32 = -2147483647
    assert c - b == -2147483648, "i32 min+1 - 1 is the first legal i32"

# --- the sign boundary itself, in both directions ----------------------
#
# `-1` and `0` are the two values that differ in *every* bit above the
# type's width, so they are what separates a correct sign-extension test
# from one that only happens to work on small positives.

@test
pub fn test_signed_checked_ops_cross_zero():
    a: i8 = 0
    b: i8 = 1
    assert a - b == -1, "i8 0 - 1 is -1, not an overflow"
    assert a + b == 1, "i8 0 + 1 is 1"
    c: i32 = -1
    d: i32 = 1
    assert c * d == -1, "i32 -1 * 1 stays -1 through the range check"
    assert c - d == -2, "i32 -1 - 1 is -2"

# --- the other caller of the same check: narrowing conversions ---------

@test
pub fn test_narrowing_conversion_at_the_boundary():
    wide: u64 = 255
    assert wide.to[u8]() == 255, "u64 255 narrows to the last legal u8"
    zero: u64 = 0
    assert zero.to[u8]() == 0, "u64 0 narrows to the first legal u8"
    mid: u64 = 65535
    assert mid.to[u32]() == 65535, "u64 65535 narrows into u32 unchanged"
