module examples.check_flow_multi_suspend

pub enum AppErr:
    Busy

    pub fn from(take e: CallError[never]) -> AppErr:
        match e:
            case .Cancelled:
                return AppErr.Busy
            case .DeadlineExceeded:
                return AppErr.Busy
            case .NotAdmitted(_, _):
                return AppErr.Busy
            case .Op(_):
                return AppErr.Busy

fn combine(a: u64, b: u64, c: u64) -> Result[u64, AppErr]:
    return Ok(a + b + c)

@actor
pub struct Counter:
    value: u64

    pub fn get(read self) -> u64:
        return self.value

@actor
pub struct Coordinator:
    counter: Actor[Counter]

    pub async fn run(mut self) -> Result[u64, AppErr]:
        durable: u64 = 10
        first = await self.counter.get()?
        second = await self.counter.get()?
        return combine(durable, first, second)
