module examples.check_placement_pinned_blk


struct VirtioBlock:
    id: u32

@driver
pub struct BlkDriver:
    held: DeviceCap[VirtioBlock]

    init(mut self, take cap: DeviceCap[VirtioBlock]):
        self.held = take cap

@actor
pub struct Probe:
    n: u32

    init(mut self):
        self.n = 0

@image
pub fn build() -> Image:
    img = Image(name="placement-pinned-blk", target=Target.wrela_machine_v1)
    blk_device = img.device[VirtioBlock](transport=0x2000)
    disk = img.driver(BlkDriver, device=blk_device)
    probe = img.actor(Probe, mailbox=4)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
