@actor
pub struct Small:
    n: u64

    pub fn poke(mut self, x: u64) -> u64:
        self.n = x +% 1
        return self.n

@image
pub fn build() -> Image:
    img = Image(name="cost-itlb-span", target=Target.wrela_machine_v1, cores=2)
    big = img.actor(Big, mailbox=2, core=0)
    small = img.actor(Small, mailbox=2, core=1)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
