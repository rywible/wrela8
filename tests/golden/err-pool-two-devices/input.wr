module examples.err_pool_two_devices

# plans/M7.md item I (the adversarial sweep), decision 5's security
# property: "the VMM maps exactly the declared pools and nothing else ...
# the device model can reach declared pool pages and no other guest
# memory, enforced by what the VMM maps."
#
# That property is per-**device**, and the artifact could not express it.
# `render_layout_section` emits one `BlkPool name= base= size=` line per
# device-reachable pool — with **no device field** — and `wrela-vmm`'s own
# `parse_report` collects every one of them into a single `Vec<PoolWindow>`
# handed to its one `BlkDevice`. This image, before the guard, rendered
# both windows happily: `ControlB` is declared reachable from `other`
# alone, and the blk device model would have reached it.
#
# Reachable at a boot? Not today, and only because a *second* thing is
# missing: `parse_report` refuses a `BlkPool` line with no
# `BlkDevice`/`BlkQueue` to bind it to, and those are plans/M7.md item E's
# to emit. So the fail-open was latent — which is exactly the kind this
# sweep exists to find, since item E would have landed on top of it.
#
# The real fix is a report-format change (a device on the mapping line,
# and a VMM that binds windows per device), and it belongs to whoever
# emits `BlkDevice`/`BlkQueue` anyway. Until then this fails closed and
# names them, rather than shipping a report whose security property holds
# only by accident of what has not landed yet.
#
# The accepting sibling is `golden/check-dma-pool`: two pools, one device
# — one of them not device-reachable at all, which is the case that has
# always been fine and still is.

@layout(dma, endian=little)
struct Ctl:
    sector: u64

struct BlockHw:
    id: u32

struct OtherHw:
    id: u32

@driver
pub struct BlkDriver:
    sectors: u64

    init(mut self, sectors: u64):
        self.sectors = sectors

    pub fn capacity(read self) -> u64:
        return self.sectors

pool ControlA
pool ControlB

@image
pub fn build() -> Image:
    img = Image(name="pool-two-devices", target=Target.wrela_machine_v1)
    blk = img.device[BlockHw](transport=0x2000)
    other = img.device[OtherHw](transport=0x3000)
    disk = img.driver(BlkDriver, device=blk, sectors=2048)
    a = img.dma_pool[Ctl](name=ControlA, device=blk, count=2)
    b = img.dma_pool[Ctl](name=ControlB, device=other, count=2)
    img.supervise(children=[disk], strategy=Restart.OneForOne,
                  intensity=RestartIntensity(max=3, within=seconds(10)))
    return img.seal()
