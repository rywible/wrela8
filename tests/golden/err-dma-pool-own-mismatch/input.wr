module examples.err_dma_pool_own_mismatch

# plans/M7.md item D — `hardware.dma.ownership-transfer`'s own first half.
#
# 02-language.md §4: "`own[Name] T` is a movable, uniquely owned handle to
# a `T` allocated from that pool." 03-hardware.md §3 says the same thing
# about the DMA form specifically: "**Transfer payloads** are `own[P] T`
# where `P` is a device-bound DMA pool and `T` is `@layout(dma)`."
#
# `BlockControl` is bound with `BlkReqHeader` slots, so an
# `own[BlockControl] BlkReqStatus` handle claims to own a 1-byte payload
# in a 16-byte slot of a different type. Nothing constructs an `own[P] T`
# in this language, so the declaration surface is where the disagreement
# has to be caught — and it is a whole-*image* fact (which pool a name is
# bound to is decided by the `@image` fn), which is why this check lives
# with the graph checks rather than in per-module typing.

@layout(dma, endian=little)
struct BlkReqHeader:
    kind: u32
    reserved: u32
    sector: u64

@layout(dma, endian=little)
struct BlkReqStatus:
    status: u8

struct BlockHw:
    id: u32

pool BlockControl

pub fn retire(take payload: own[BlockControl] BlkReqStatus) -> unit:
    return unit

@image
pub fn build() -> Image:
    img = Image(name="x", target=Target.wrela_machine_v1)
    blk = img.device[BlockHw](transport=0x2000)
    control = img.dma_pool[BlkReqHeader](name=BlockControl, device=blk, count=4)
    return img.seal()
