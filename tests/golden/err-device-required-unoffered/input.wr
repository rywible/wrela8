module examples.err_device_required_unoffered

# plans/M7.md item E1 / decision 12: an unofferable `required_features=`
# entry fails the *build*, naming the feature and both sides' sets —
# never at runtime, and never silently narrowed. `RingReset` is a real
# enum variant (and item H2's eventual surface) that `DEVICE_FEATURES`
# does not offer.

enum Feature:
    Flush
    RingReset

struct VirtioBlock:
    id: u32

@driver
pub struct BlkDriver:
    id: u32

    init(mut self):
        self.id = 1

@image
pub fn build() -> Image:
    img = Image(name="required-unoffered", target=Target.wrela_machine_v1)
    blk = img.device[VirtioBlock](
        transport=0x2000,
        required_features=[Feature.RingReset],
    )
    disk = img.driver(BlkDriver, device=blk)
    img.supervise(children=[disk], strategy=Restart.OneForOne,
                  intensity=RestartIntensity(max=3, within=seconds(10)))
    return img.seal()
