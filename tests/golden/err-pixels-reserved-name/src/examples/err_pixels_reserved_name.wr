module examples.err_pixels_reserved_name

# A project module may neither define nor reference the compiler-reserved
# Pixels surface (`__wrela_*`, `RendererWorker*`). The fence runs on source
# tokens before specialization, so *referencing* a generated intrinsic is
# rejected exactly like defining one would be — that is the direction that
# could otherwise hijack a generated lowering by spelling alone.
#
# The scene below is a complete, otherwise-valid renderer: the rejection has
# to come from the reserved reference, not from a malformed declaration.

from core.field import Field, Rgb, Vec3, mark, plane
from core.render import (
    AoConfig, CameraBounds, LightConfig, MaterialSample, ProbeConfig,
    RenderProfile, RgbRange, ScalarRange, SurfaceContext, ToneCurve,
)

const FIXTURE_ID: u32 = 44

struct SceneParams:
    marker: bool

enum ObjectId:
    Scene

enum MaterialId:
    Surface

@driver
struct Display:
    marker: u32

@field
fn world(p: Vec3, read params: SceneParams) -> Field:
    return mark(
        plane(p, Vec3(x=0.0, y=1.0, z=0.0), offset=0.0),
        object=ObjectId.Scene,
        material=MaterialId.Surface,
    )

fn borrowed_intrinsic() -> u32:
    return __wrela_pixels_f32_to_bits(1.0)

@material
fn shade(surface: SurfaceContext[MaterialId], read params: SceneParams) -> MaterialSample:
    return MaterialSample.standard(color=Rgb(r=0.0, g=0.0, b=0.0), roughness=0.5)

@test(runtime)
fn pinned_scene_contract():
    assert FIXTURE_ID == 44, "fixture id must remain pinned"

@image
fn build() -> Image:
    img = Image(name="err-pixels-reserved-name", target=Target.wrela_machine_v1)
    display = img.driver(Display)
    renderer = img.renderer[SceneParams](
        field=world, material=shade, display=display,
        width=64, height=32, refresh_hz=60, shade_hz=60,
        profile=RenderProfile.AaaByteExact, tone_curve=ToneCurve.Linear,
        near=0.1, far=10.0,
        world_min=Vec3(x=-1.0, y=-1.0, z=-1.0),
        world_max=Vec3(x=1.0, y=1.0, z=1.0),
        camera_bounds=CameraBounds.bounded(max_motion=0.0),
        light_config=LightConfig.fixed(capacity=0),
        exposure_range=ScalarRange(min=0.0, max=1.0),
        environment_range=RgbRange(
            min=Rgb(r=0.0, g=0.0, b=0.0),
            max=Rgb(r=1.0, g=1.0, b=1.0),
        ),
        ao=AoConfig.fixed(enabled=false),
        probes=ProbeConfig.fixed(enabled=false),
        initialization_deadline_ms=1,
    )
    img.on_failure(policy=Failure.Halt)
    return img.seal()
