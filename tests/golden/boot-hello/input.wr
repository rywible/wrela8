module examples.boot_hello

# plans/M5.md item E, decision 15: the flagship boot golden — a real
# `@test(runtime)` image, boots on the wrela VMM (Hypervisor.framework on
# this machine), prints each test's own pinned report line over the
# console ring. Three tests, in declaration order: arithmetic (checked
# `+`), a struct paired with an exhaustive `match` over an enum, and one
# DELIBERATE failure (an `assert` carrying a message) so the landing-pad
# path is exercised and pinned, not just the pass path. No comptime
# `@test` fns here at all — decision 1's own comptime/runtime merge rule
# has its own separate golden coverage (`check-tests-mixed`); this file
# is the "prints over virtio-console on a Mac" ROADMAP sentence, nothing
# more.

pub enum Shape:
    Circle(u64)
    Square(u64)

pub struct Box:
    shape: Shape

    init(mut self, shape: Shape):
        self.shape = shape

    pub fn area(read self) -> u64:
        match self.shape:
            case .Circle(r):
                return r * r
            case .Square(side):
                return side * side

@test(runtime)
pub fn arith_ok():
    a: i64 = 7
    b: i64 = 35
    assert a + b == 42, "7+35 is 42"

@test(runtime)
pub fn struct_match_ok():
    b = Box(shape=.Square(6))
    assert b.area() == 36, "a side-6 square has area 36"

@test(runtime)
pub fn deliberate_fail():
    assert false, "this test is meant to fail — pins the landing-pad path"
