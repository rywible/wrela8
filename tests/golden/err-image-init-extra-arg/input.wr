module examples.err_image_init_extra_arg

@driver
pub struct Blk:
    id: u32

    init(mut self):
        self.id = 1

@image
pub fn build() -> Image:
    img = Image(name="extra-arg", target=Target.wrela_machine_v1)
    disk = img.driver(Blk, queue_depth=8)
    img.supervise(children=[disk], strategy=Restart.OneForOne,
                  intensity=RestartIntensity(max=3, within=seconds(10)))
    return img.seal()
