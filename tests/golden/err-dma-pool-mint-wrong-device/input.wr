module examples.err_dma_pool_mint_wrong_device


@layout(dma, endian=little)
struct BlkReqHeader:
    kind: u32
    reserved: u32
    sector: u64

struct BlockHw:
    id: u32

struct NicHw:
    id: u32

pool BlockControl

@driver
pub struct BlkDriver:
    sectors: u64

    init(mut self, take control: DmaPool[BlockControl, 4096]):
        self.sectors = 0

    pub fn capacity(read self) -> u64:
        return self.sectors

@driver
pub struct NicDriver:
    held: DeviceCap[NicHw]
    x: u32

    init(mut self, take cap: DeviceCap[NicHw]):
        self.held = take cap
        self.x = 0

@image
pub fn build() -> Image:
    img = Image(name="x", target=Target.wrela_machine_v1)
    blk = img.device[BlockHw](transport=0x2000)
    nic = img.device[NicHw](transport=0x3000)
    disk = img.driver(BlkDriver, device=blk)
    net = img.driver(NicDriver, device=nic)
    control = img.dma_pool[BlkReqHeader](name=BlockControl, device=nic, count=4)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
