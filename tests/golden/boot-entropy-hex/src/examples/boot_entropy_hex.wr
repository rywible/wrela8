module examples.boot_entropy_hex


from core.runtime import __wrela_trace_u64

@actor
pub struct EntropyHexProbe:
    pad: u64

    pub fn sample(mut self) -> u64:
        b = entropy[8]()
        v: u64 = b[0].to[u64]()
        v = (v << 8) | b[1].to[u64]()
        v = (v << 8) | b[2].to[u64]()
        v = (v << 8) | b[3].to[u64]()
        v = (v << 8) | b[4].to[u64]()
        v = (v << 8) | b[5].to[u64]()
        v = (v << 8) | b[6].to[u64]()
        v = (v << 8) | b[7].to[u64]()
        __wrela_trace_u64(v)
        return 1

@test(runtime)
async fn entropy_hex(c: Actor[EntropyHexProbe]):
    r = await c.sample()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match r:
        case .Ok(v):
            assert v == 1, "sample returned 1"
        case .Err(_):
            assert false, "sample rejected"

@image
pub fn build() -> Image:
    img = Image(name="boot-entropy-hex", target=Target.wrela_machine_v1)
    c = img.actor(EntropyHexProbe, mailbox=8)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
