module examples.err_boot_epoch_stale

# plans/M7.md item H2b flagship: a completion that was legitimate before a
# full reset arrives after it and is rejected as `CompletionFault::StaleId`
# — distinct from UnknownId / DuplicateId / BadLength (E4's other three).
#
# Sequence: init publishes a write (meta stamped with epoch 0); the device
# completes into the used ring; the IRQ wakes `@task`; the task calls
# `RunningDevice.reset` (epoch 0 → 1) *then* `drain`. Drain compares the
# stamped slot epoch to the live epoch and aborts with StaleId's own
# message.
#
# Vacuity: `golden/boot-blk-roundtrip` is the same publish/IRQ/drain shape
# *without* the reset, and its drain succeeds. Mutation: omit the reset
# call and this image would pass a round-trip assert instead of aborting.

@layout(mmio, endian=little)
struct VirtioIrqMmio:
    @offset(0x060) interrupt_status: ReadOnly[u32]
    @offset(0x064) interrupt_ack: WriteOnly[u32]

@layout(dma, endian=little)
struct BlkReqHeader:
    kind: u32
    reserved: u32
    sector: u64

@layout(dma, endian=little)
struct BlkReqStatus:
    status: u8

@layout(dma, endian=little)
struct DmaBlock:
    @offset(0) word: u64
    @offset(504) pad_end: u64

struct VirtioBlock:
    id: u32

enum Feature:
    Flush

const QDEPTH: usize = 8
const BLK_T_OUT: u32 = 1
const MAGIC: u64 = 0xC0FFEE00BEEF42A1

pool BlockControl
pool BlockPayloads

@driver
pub struct BlkDriver:
    irq_regs: Mmio[VirtioIrqMmio]
    device: RunningDevice[VirtioBlock]
    queue: VirtQueue[..8]
    capacity_sectors: u64
    pending: InterruptCell[u32]
    irq: IrqCap[u32]
    inflight: Option[Receipt[own[BlockPayloads] DmaBlock]]

    init(mut self,
         take cap: DeviceCap[VirtioBlock],
         take control_pool: DmaPool[BlockControl, 512],
         take buffer: own[BlockPayloads] DmaBlock)
        -> Result[unit, BootError]:
        claimed = VirtioBlock.claim(cap=take cap)
        self.irq_regs = claimed.map_partition(VirtioIrqMmio)
        self.pending = InterruptCell(0)
        negotiated = claimed.negotiate(
            required=[Feature.Flush],
            optional=[Feature.Flush],
        )?
        self.queue = VirtQueue.configure(
            pool=take control_pool,
            device=mut negotiated,
            index=0,
            depth=QDEPTH,
        )?
        self.capacity_sectors = 16
        irq = negotiated.take_irq()
        irq.bind(self.on_queue_irq)
        irq.unmask()
        self.irq = take irq
        self.device = negotiated.start()
        b = take buffer
        b.word = MAGIC
        permit = self.queue.reserve_proven(descriptors=3)
        op = self.queue.prepare_block(
            permit=take permit,
            header=BlkReqHeader(kind=BLK_T_OUT, reserved=0, sector=0),
            payload=take b,
            device_writes_payload=false,
            status=BlkReqStatus(status=0xff),
            idempotent=false,
        )
        receipt = self.queue.publish(operation=take op)
        self.inflight = Some(take receipt)
        return Ok(unit)

    fn on_queue_irq(self):
        status = self.irq_regs.interrupt_status.read()
        handled = status & 1
        if handled != 0:
            self.pending.fetch_or_release(handled)
            self.irq_regs.interrupt_ack.write(handled)
            wake(BlkDriver.drain)

    @task
    fn drain(mut self):
        status = self.pending.swap_acquire(0)
        if status == 0:
            return unit
        slot = take self.inflight
        match slot:
            case .None:
                self.inflight = None
                return unit
            case .Some(r):
                # Epoch 0 → 1 while the used-ring entry still names the
                # pre-reset publish. Drain must abort StaleId — not
                # UnknownId / DuplicateId / BadLength.
                self.device = self.device.reset(queue=mut self.queue)
                self.queue.drain(max=QDEPTH)
                # Unreachable when the epoch check holds; restore so
                # protocol-consumption is satisfied on the fallthrough.
                self.inflight = Some(take r)
                assert false, "drain after reset must abort as StaleId"
        return unit

@actor
pub struct Ledger:
    marks: u64

    pub fn mark(mut self, n: u64) -> unit:
        self.marks = self.marks * 10 + n
        return unit

@test(runtime)
async fn epoch_stale_aborts(led: Actor[Ledger]):
    # One checkpoint delivers the write IRQ; the drain task must abort
    # before this mark can complete a second time.
    a = await led.mark(n=1)
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match a:
        case .Ok(_):
            pass
        case .Err(_):
            assert false, "mark rejected"

@image
pub fn build() -> Image:
    img = Image(name="err-boot-epoch-stale", target=Target.wrela_machine_v1)
    blk = img.device[VirtioBlock](
        transport=0x2000,
        capacity_sectors=16,
        required_features=[Feature.Flush],
        vector=1,
    )
    control = img.dma_pool[BlkReqHeader](name=BlockControl, device=blk, count=32)
    payloads = img.dma_pool[DmaBlock](name=BlockPayloads, device=blk, count=1)
    disk = img.driver(BlkDriver, device=blk, buffer=take payloads)
    led = img.actor(Ledger, mailbox=8)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
