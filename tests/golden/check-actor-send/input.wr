module examples.check_actor_send

@actor
pub struct Logger:
    count: u64

    pub fn record(mut self, code: u64):
        self.count = self.count + code

@actor
pub struct Auditor:
    logger: Actor[Logger]

    pub async fn observe(mut self, code: u64) -> u64:
        outcome = send self.logger.record(code=code)
        @discard(reason="migrated: deliberate Err discard (M13 item L)")
        match outcome:
            case .Ok(_):
                pass
            case .Err(_e):
                pass
        return code
