module examples.check_await_loop_post_suspension_local


struct Payload:
    value: u64

@actor
pub struct Upstream:
    value: u64

    pub fn get(read self) -> u64:
        return self.value

@actor
pub struct Store:
    upstream: Actor[Upstream]
    base: Payload

    pub async fn combine(mut self, input: Payload) -> u64:
        total: u64 = 0
        i: u64 = 0
        while i < 2:
            total = total + input.value
            i = i + 1
        while i < 4:
            fetched = await self.upstream.get()
            fresh = Payload(value = 1)
            total = total + fresh.value + self.base.value
            i = i + 1
        return total
