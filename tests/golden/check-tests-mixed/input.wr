module examples.check_tests_mixed


pub fn double(n: u64) -> u64:
    return n * 2

@test
pub fn test_passes():
    assert double(21) == 42, "double(21) is 42"

@test
pub fn test_fails():
    assert double(21) == 41, "wrong on purpose"

@test
pub fn test_quota_exceeded():
    total: u64 = 0
    @budget(bound=1000000)
    while true:
        total = total + 1

@test(runtime)
pub fn test_needs_the_machine():
    assert true
