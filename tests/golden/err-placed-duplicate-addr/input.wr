module examples.err_placed_duplicate_addr

# plans/M10.md item A2c: 03-hardware.md §3.1 allows at most one placed
# static per address.

@layout(runtime, endian=little)
struct PageA:
    word: u64


@layout(runtime, endian=little)
struct PageB:
    word: u64


@placed(0x40000000)
static A: PageA

@placed(0x40000000)
static B: PageB
