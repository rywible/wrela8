module examples.err_cross_core_checkpoint_free_fn

# plans/M10.md pre-migration finding, amended by plans/M11.md decision 740.
#
# Originally the sibling of `err-cross-core-checkpoint`: a loop hoisted into
# a free fn passed the secondary-core guard (unattributed key fell back to
# "core 0"), then hung at boot by clearing core 0's pending word from core 1.
#
# Decision 740 retires checkpoints on sync `@budget` loops (trip counters
# only). A free sync fn with a bounded loop therefore carries no
# `Reloc::CheckpointService`, cannot eat a cross-core wake, and is legal on
# a secondary core. This golden is now the positive witness of that close:
# `spin` stays a free sync helper; `Slow` on core 1 calls it; the boot is
# green.
#
# The async half of the refusal remains `err-cross-core-checkpoint` (an
# async method loop on core 1 still fails closed).

pub fn spin(n: u64) -> u64:
    i: u64 = 0
    acc: u64 = 0
    @budget(bound=1000000)
    while i < n:
        acc = acc + i
        i = i + 1
    return acc

@actor
pub struct Quick:
    n: u64

    init(mut self):
        self.n = 5

    pub fn get(read self) -> u64:
        return self.n

@actor
pub struct Slow:
    n: u64

    init(mut self):
        self.n = 0

    pub fn churn(mut self):
        self.n = spin(64)

@test(runtime)
async fn lost_wake(q: Actor[Quick], s: Actor[Slow]):
    send s.churn()
    v = await q.get()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match v:
        case .Ok(n):
            assert n == 5, "expected 5 from Quick"
        case .Err(_):
            assert false, "call rejected"

@image
pub fn build() -> Image:
    img = Image(name="err-cross-core-checkpoint-free-fn", target=Target.wrela_machine_v1)
    q = img.actor(Quick, mailbox=4, core=1)
    s = img.actor(Slow, mailbox=4, core=1)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
