module app.main

from lib.wrap import Wrap as Box, Src


fn direct() -> u32:
    s = Src(n=4)
    w = Box.from(take s)
    return w.inner.n + 500

const DIRECT: u32 = direct()

@test
pub fn t_alias_from():
    assert DIRECT == 504, "aliased generated from must be callable"


@test(runtime)
pub fn guest_alias_from():
    assert direct() == 504, "aliased from at guest"

@actor
pub struct Store:
    direct: u32

    init(mut self, direct: u32):
        self.direct = direct

@image
pub fn build() -> Image:
    img = Image(name="import-alias-deriving-from", target=Target.wrela_machine_v1)
    storage = img.actor(Store, direct=DIRECT, mailbox=4)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
