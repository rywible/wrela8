module examples.err_untrusted_bound

# plans/M7.md item H2a, 03-hardware.md §8: an `Untrusted[T]` used as a
# range bound is a rejection naming `.checked_le(bound)`.

fn bad(reported: Untrusted[usize]) -> usize:
    n = 0
    @budget(bound=1000000)
    for i in 0..reported:
        n = n + i
    return n
