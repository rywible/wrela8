module examples.check_deriving_from

# plans/M9.md item B / B3. 02-language.md §7.4 / §7.5 and 05-library.md §8:
# `deriving(From)` on a one-variant/one-field shape generates the `from`
# that `?` consumes — a real associated fn, callable directly. `settle`
# maps a converted `Err` into a range `Ok` cannot reach, so a wrong
# conversion (or a missing one that somehow type-checked) cannot produce
# the pinned image values.
#
# Retired `err-try-from-underived` (BB decision 61): that case stops being
# an `err-` case when B lands — this is that signal. B3 adds DIRECT.

pub enum LoadError deriving(From):
    Bad(u32)

pub enum WrapError deriving(From):
    Inner(LoadError)

pub fn parse(raw: u32) -> Result[u32, LoadError]:
    if raw == 0:
        return Err(LoadError.Bad(raw))
    return Ok(raw)

pub fn convert_wrapped(raw: u32) -> Result[u32, WrapError]:
    value = parse(raw)?
    return Ok(value)

fn settle(r: Result[u32, WrapError]) -> u32:
    match r:
        case .Ok(v):
            return v
        case .Err(e):
            match e:
                case .Inner(inner):
                    match inner:
                        case .Bad(n):
                            return n + 1000

# Err(LoadError.Bad(0)) converted through WrapError.from -> 1000.
# An unconverted payload of 0, or an Ok of 0, cannot produce 1000.
const CONVERTED: u32 = settle(convert_wrapped(0))
const OK: u32 = settle(convert_wrapped(7))

# Direct call of the generated from (item B3): Bad(5) -> 2505.
fn direct_call() -> u32:
    e = LoadError.Bad(5)
    w = WrapError.from(take e)
    match w:
        case .Inner(inner):
            match inner:
                case .Bad(n):
                    return n + 2500

const DIRECT: u32 = direct_call()

@test
pub fn test_deriving_from_converts():
    assert CONVERTED == 1000, "`?` must apply WrapError.from to LoadError.Bad(0)"

@test
pub fn test_ok_path_unchanged():
    assert OK == 7, "Ok path must not convert"

@test
pub fn test_generated_from_callable():
    assert DIRECT == 2505, "generated enum from must be callable directly"


# Guest-reachable path (plans/M9.md item KK): H3 dropped from/settling helpers
# from mwir; `@test(runtime)` seeds generated from + `?`.
@test(runtime)
pub fn guest_from():
    assert settle(convert_wrapped(0)) == 1000, "`?` from at guest"
    assert settle(convert_wrapped(7)) == 7, "Ok path at guest"
    assert direct_call() == 2505, "generated from at guest"

@actor
pub struct Store:
    converted: u32
    ok: u32
    direct: u32

    init(mut self, converted: u32, ok: u32, direct: u32):
        self.converted = converted
        self.ok = ok
        self.direct = direct

@image
pub fn build() -> Image:
    img = Image(name="check-deriving-from", target=Target.wrela_machine_v1)
    storage = img.actor(Store, converted=CONVERTED, ok=OK, direct=DIRECT, mailbox=4)
    img.supervise(children=[storage], strategy=Restart.OneForOne,
                  intensity=RestartIntensity(max=3, within=seconds(10)))
    return img.seal()
