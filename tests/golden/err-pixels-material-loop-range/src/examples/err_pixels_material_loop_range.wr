module examples.err_pixels_material_loop_range

from core.field import Field, Rgb, Vec3, mark, sphere
from core.render import (
    AoConfig,
    CameraBounds,
    LightConfig,
    MaterialSample,
    ProbeConfig,
    RenderProfile,
    RgbRange,
    ScalarRange,
    SurfaceContext,
    ToneCurve,
)
from drivers.display import Display, DisplayDevice

struct MaterialState:
    unbounded_roughness: f32

struct SceneParams:
    states: [MaterialState; 2]

enum MaterialId:
    Surface

enum ObjectId:
    Surface

@field
fn world(p: Vec3, read params: SceneParams) -> Field:
    surface = sphere(p, Vec3(x=0.0, y=0.0, z=0.0), radius=1.0)
    return mark(surface, object=ObjectId.Surface, material=MaterialId.Surface)

@material
fn shade(surface: SurfaceContext[MaterialId], read params: SceneParams) -> MaterialSample:
    roughness: f32 = 0.5
    @budget(bound=2)
    for state in params.states:
        roughness = state.unbounded_roughness
    return MaterialSample.standard(
        color=Rgb(r=0.25, g=0.5, b=0.75),
        roughness=roughness,
    )

@image
pub fn build() -> Image:
    img = Image(name="err-pixels-material-loop-range", target=Target.wrela_machine_v1)
    display_device = img.device[DisplayDevice](transport=0x6000)
    display = img.driver(Display, device=display_device, width=64, height=32, refresh_hz=60)
    renderer = img.renderer[SceneParams](
        field=world,
        material=shade,
        display=display,
        width=64,
        height=32,
        refresh_hz=60,
        shade_hz=60,
        profile=RenderProfile.AaaByteExact,
        tone_curve=ToneCurve.Linear,
        near=0.1,
        far=128.0,
        world_min=Vec3(x=-4.0, y=-4.0, z=-4.0),
        world_max=Vec3(x=4.0, y=4.0, z=4.0),
        camera_bounds=CameraBounds.bounded(max_motion=0.25),
        light_config=LightConfig.fixed(capacity=0),
        exposure_range=ScalarRange(min=-1.0, max=1.0),
        environment_range=RgbRange(
            min=Rgb(r=0.0, g=0.0, b=0.0),
            max=Rgb(r=1.0, g=1.0, b=1.0),
        ),
        ao=AoConfig.fixed(enabled=false),
        probes=ProbeConfig.fixed(enabled=false),
        initialization_deadline_ms=10,
    )
    img.on_failure(policy=Failure.Halt)
    return img.seal()
