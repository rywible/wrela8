module examples.err_pool_bound_twice_forms


@layout(dma, endian=little)
struct BlkReqStatus:
    status: u8

struct BlockHw:
    id: u32

pool Shared

@image
pub fn build() -> Image:
    img = Image(name="x", target=Target.wrela_machine_v1)
    blk = img.device[BlockHw](transport=0x2000)
    a = img.pool[u32](name=Shared, slots=2, max_payload=32)
    b = img.dma_pool[BlkReqStatus](name=Shared, device=blk, count=4)
    return img.seal()
