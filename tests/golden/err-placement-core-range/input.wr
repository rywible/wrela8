module examples.err_placement_core_range


@actor
pub struct Store:
    count: u32

    init(mut self):
        self.count = 0

@image
pub fn build() -> Image:
    img = Image(name="bad-core", target=Target.wrela_machine_v1)
    store = img.actor(Store, mailbox=4, core=3)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
