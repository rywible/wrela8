module examples.err_placement_core_range

# plans/M15.md item C: `core=N` outside 0..Image.cores fails closed by name
# (default cores=1 ⇒ domain 0..1; core=3 is refused).

@actor
pub struct Store:
    count: u32

    init(mut self):
        self.count = 0

@image
pub fn build() -> Image:
    img = Image(name="bad-core", target=Target.wrela_machine_v1)
    store = img.actor(Store, mailbox=4, core=3)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
