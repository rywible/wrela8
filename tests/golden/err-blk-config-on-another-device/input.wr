module examples.err_blk_config_on_another_device

# plans/M8.md item P, decision 25 — what *remains* refused once two
# devices are a legal shape (`golden/check-pool-two-devices`).
#
# `BlkDevice` now names its device: the one whose pool hosts the ring the
# single `VirtQueue.configure` site consumes. Everything on that line must
# then be *that* device's own configuration. But `blk_capacity_sectors` /
# `blk_accepted_features` are the one derivation of each fact and scan the
# device list in declaration order — the lowerer reads them through
# `TypedProgram::blk_capacity_sectors`, where no configure site is in scope
# to disambiguate with. With one device those questions have one answer;
# with two they do not.
#
# Rather than grow a second, device-scoped derivation and let the two
# disagree, `derive_blk_report` refuses the only shape in which they could:
# blk configuration declared on a device that is not the blk device.
# 06-machine.md §6's device set is closed and machine v1 has exactly one
# `blk`.
#
# Two-line twin of `golden/boot-blk-two-devices`: `capacity_sectors=`
# moves from `blk` (device#0, whose pool hosts the ring) to `aux_dev`
# (device#1). Verified by mutation: with the check disabled this builds and
# renders `BlkDevice device=device#0 capacity_sectors=64` — device#0's line
# carrying device#1's number.

@layout(mmio, endian=little)
struct VirtioIrqMmio:
    @offset(0x060) interrupt_status: ReadOnly[u32]
    @offset(0x064) interrupt_ack: WriteOnly[u32]

@layout(dma, endian=little)
struct BlkReqHeader:
    kind: u32
    reserved: u32
    sector: u64

@layout(dma, endian=little)
struct BlkReqStatus:
    status: u8

@layout(dma, endian=little)
struct DmaBlock:
    @offset(0) word: u64
    @offset(504) pad_end: u64

struct VirtioBlock:
    id: u32

enum Feature:
    Flush

const QDEPTH: usize = 8
const SECTOR: usize = 512
const BLK_T_IN: u32 = 0
const BLK_T_OUT: u32 = 1
const MAGIC: u64 = 0xC0FFEE00BEEF42A1
# phase: 1 = write in flight; 2 = read in flight; 3 = done
const PHASE_WRITE: u32 = 1
const PHASE_READ: u32 = 2
const PHASE_DONE: u32 = 3

struct AuxHw:
    id: u32

pool BlockControl
pool BlockPayloads
pool AuxBuffers

@driver
pub struct BlkDriver:
    irq_regs: Mmio[VirtioIrqMmio]
    device: RunningDevice[VirtioBlock]
    queue: VirtQueue[..8]
    capacity_sectors: u64
    pending: InterruptCell[u32]
    irq: IrqCap[u32]
    buffer: Option[own[BlockPayloads] DmaBlock]
    inflight: Option[Receipt[own[BlockPayloads] DmaBlock]]
    phase: u32
    seen: u32

    init(mut self,
         take cap: DeviceCap[VirtioBlock],
         take control_pool: DmaPool[BlockControl, 512],
         take buffer: own[BlockPayloads] DmaBlock)
        -> Result[unit, BootError]:
        claimed = VirtioBlock.claim(cap=take cap)
        self.irq_regs = claimed.map_partition(VirtioIrqMmio)
        self.pending = InterruptCell(0)
        self.phase = 0
        self.seen = 0
        self.buffer = None
        negotiated = claimed.negotiate(
            required=[Feature.Flush],
            optional=[Feature.Flush],
        )?
        self.queue = VirtQueue.configure(
            pool=take control_pool,
            device=mut negotiated,
            index=0,
            depth=QDEPTH,
        )?
        self.capacity_sectors = 16
        irq = negotiated.take_irq()
        irq.bind(self.on_queue_irq)
        irq.unmask()
        self.irq = take irq
        self.device = negotiated.start()
        # Stamp MAGIC and publish the write before returning so the first
        # checkpoint delivers a real used-ring IRQ (boot-irq-isr shape).
        b = take buffer
        b.word = MAGIC
        permit = self.queue.reserve_proven(descriptors=3)
        op = self.queue.prepare_block(
            permit=take permit,
            header=BlkReqHeader(kind=BLK_T_OUT, reserved=0, sector=0),
            payload=take b,
            device_writes_payload=false,
            status=BlkReqStatus(status=0xff),
            # Item G (decision 18) made `idempotent=` required. A write is
            # not idempotent by inspection — this case is about per-device pool
            # reachability, not the retry rule, so it declares the honest value
            # rather than the one that would let a retry through.
            idempotent=false,
        )
        receipt = self.queue.publish(operation=take op)
        self.inflight = Some(take receipt)
        self.phase = PHASE_WRITE
        return Ok(unit)

    fn on_queue_irq(self):
        status = self.irq_regs.interrupt_status.read()
        handled = status & 1
        if handled != 0:
            self.pending.fetch_or_release(handled)
            self.irq_regs.interrupt_ack.write(handled)
            wake(BlkDriver.drain)

    @task
    fn drain(mut self):
        status = self.pending.swap_acquire(0)
        if status == 0:
            return unit
        # Take first: a quiet wake after the round trip (extra completion
        # or inject bit) must not park inside `queue.drain` with nothing
        # to claim. `await receipt` is not used here — see decision 22.
        slot = take self.inflight
        match slot:
            case .None:
                self.inflight = None
                return unit
            case .Some(r):
                self.queue.drain(max=QDEPTH)
                c = self.queue.claim(receipt=take r)
                if self.phase == PHASE_WRITE:
                    match c.status:
                        case .Ok(_):
                            pass
                        case .Err(_):
                            assert false, "write completion status Ok"
                    # Write buffer-facing length is 0.
                    n = c.written_len
                    match n.checked_le(SECTOR):
                        case .Ok(v):
                            assert v == 0, "write written_len buffer-facing is 0"
                        case .Err(_):
                            assert false, "write checked_le(512) must succeed for 0"
                    b = take c.payload
                    b.word = 0
                    permit = self.queue.reserve_proven(descriptors=3)
                    op = self.queue.prepare_block(
                        permit=take permit,
                        header=BlkReqHeader(kind=BLK_T_IN, reserved=0, sector=0),
                        payload=take b,
                        device_writes_payload=true,
                        status=BlkReqStatus(status=0xff),
                        # A read of a fixed sector is idempotent by
                        # inspection (item G, decision 18).
                        idempotent=true,
                    )
                    receipt = self.queue.publish(operation=take op)
                    # Restore taken field in one step (Option[Receipt] is a
                    # resource — no None-then-Some overwrite).
                    self.inflight = Some(take receipt)
                    self.phase = PHASE_READ
                else:
                    if self.phase == PHASE_READ:
                        match c.status:
                            case .Ok(_):
                                pass
                            case .Err(_):
                                assert false, "read completion status Ok"
                        reported = c.written_len
                        match reported.checked_le(SECTOR):
                            case .Ok(v):
                                assert v == 512, "checked_le(512) yields buffer-facing 512"
                            case .Err(_):
                                assert false, "checked_le(512) must succeed for a 512-byte read"
                        match reported.checked_le(511):
                            case .Ok(_):
                                assert false, "checked_le(511) must fail: 512 > 511"
                            case .Err(_):
                                pass
                        b = take c.payload
                        w = b.word
                        assert w == 0xC0FFEE00BEEF42A1, "read-back sees the hand-computed sector word"
                        # Take the empty Option before restoring (Option[own]
                        # is a resource — cannot overwrite a live None).
                        empty = take self.buffer
                        match empty:
                            case .None:
                                pass
                            case .Some(_):
                                assert false, "buffer still held at read completion"
                        self.buffer = Some(take b)
                        self.inflight = None
                        self.phase = PHASE_DONE
                        self.seen = 1
                    else:
                        self.inflight = None
                        assert false, "drain in unexpected phase"
        return unit

# device#1's own driver, so this image is two devices each with a driver
# and a pool. It touches nothing: its only job is to make device#1 a real
# bound device rather than a declaration.
@driver
pub struct AuxDriver:
    tag: u32

    init(mut self, tag: u32):
        self.tag = tag

    pub fn tag(read self) -> u32:
        return self.tag

@actor
pub struct Ledger:
    marks: u64

    pub fn mark(mut self, n: u64) -> unit:
        self.marks = self.marks * 10 + n
        return unit

    pub fn read_marks(read self) -> u64:
        return self.marks

@test(runtime)
async fn blk_write_read_roundtrip(led: Actor[Ledger]):
    # Two checkpoints: write IRQ+drain then read IRQ+drain. Surviving
    # with marks 42 means every assert in both drain phases held.
    a = await led.mark(n=4)
    match a:
        case .Ok(_):
            pass
        case .Err(_):
            assert false, "mark rejected"
    b = await led.mark(n=2)
    match b:
        case .Ok(_):
            pass
        case .Err(_):
            assert false, "mark rejected"
    m = await led.read_marks()
    match m:
        case .Ok(v):
            assert v == 42, "two marks after write-drain and read-drain checkpoints"
        case .Err(_):
            assert false, "read_marks rejected"

@image
pub fn build() -> Image:
    img = Image(name="err-blk-config-on-another-device", target=Target.wrela_machine_v1)
    blk = img.device[VirtioBlock](
        transport=0x2000,
        required_features=[Feature.Flush],
        vector=1,
    )
    # The blk device is device#0 (its pool hosts the ring). device#1
    # declares the block capacity — so the *only* `capacity_sectors=` in
    # this image belongs to a device that is not the block device, and the
    # graph-wide scan would put 64 on a `BlkDevice device=device#0` line.
    aux_dev = img.device[AuxHw](transport=0x3000, capacity_sectors=64)
    control = img.dma_pool[BlkReqHeader](name=BlockControl, device=blk, count=32)
    payloads = img.dma_pool[DmaBlock](name=BlockPayloads, device=blk, count=1)
    auxbuf = img.dma_pool[DmaBlock](name=AuxBuffers, device=aux_dev, count=1)
    disk = img.driver(BlkDriver, device=blk, buffer=take payloads)
    aux = img.driver(AuxDriver, device=aux_dev, tag=7)
    led = img.actor(Ledger, mailbox=8)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
