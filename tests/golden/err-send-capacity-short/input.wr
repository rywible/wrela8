module examples.err_send_capacity_short

# plans/M6.md item G, decision 5's first conjunct: "the target mailbox's
# declared capacity >= the whole-image count of static send/call sites
# targeting it". `Logger` is targeted by three static message sites (two
# bare `send`s and one `await` — an awaited call occupies a mailbox slot
# exactly like a one-way send does) but is declared `mailbox=2`, so the
# third message could be rejected and the bare statements must consume
# their `Result` (02-language.md §9.4).

@actor
pub struct Logger:
    total: u64

    pub fn record(mut self, code: u64) -> unit:
        self.total = self.total + code
        return unit

    pub fn read_total(read self) -> u64:
        return self.total

@test(runtime)
async fn too_many(lg: Actor[Logger]):
    send lg.record(code=1)
    send lg.record(code=2)
    t = await lg.read_total()
    match t:
        case .Ok(v):
            assert v == 3, "delivered"
        case .Err(_):
            assert false, "rejected"

@image
pub fn build() -> Image:
    img = Image(name="err-send-capacity-short", target=Target.wrela_machine_v1)
    lg = img.actor(Logger, mailbox=2)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
