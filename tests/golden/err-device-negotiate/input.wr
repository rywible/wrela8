module examples.err_device_negotiate

# plans/M7.md item E1 — `negotiate` call-site shape (`required=`/`optional=` must be feature lists).
#
# What this case would catch: the `DriverClaimed -> FeaturesAccepted` transition. The accepted set is decided before the guest runs; nothing carries it into a guest window.

@layout(mmio, endian=little)
struct VirtioIrqMmio:
    @offset(0x060) interrupt_status: ReadOnly[u32]

struct VirtioBlock:
    id: u32

@driver
pub struct BlkDriver:
    regs: Mmio[VirtioIrqMmio]

    init(mut self, take cap: DeviceCap[VirtioBlock]):
        claimed = VirtioBlock.claim(cap=take cap)
        _ = claimed.negotiate(required=0, optional=0)
        self.regs = claimed.map_partition(VirtioIrqMmio)
