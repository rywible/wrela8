module examples.boot_cross_core


@actor
pub struct Store:
    value: u64

    init(mut self):
        self.value = 7

    pub fn get(read self) -> u64:
        return self.value

@actor
pub struct Idle:
    ticks: u32

    init(mut self):
        self.ticks = 0

    pub fn poke(read self) -> u32:
        return self.ticks

@test(runtime)
async fn cross_core(store: Actor[Store]):
    v = await store.get()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match v:
        case .Ok(n):
            assert n == 7, "expected 7 from Store on core 0"
        case .Err(_):
            assert false, "call rejected"

@image
pub fn build() -> Image:
    img = Image(name="boot-cross-core", target=Target.wrela_machine_v1, cores=3)
    store = img.actor(Store, mailbox=4, core=0)
    idle = img.actor(Idle, mailbox=2, core=1)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
