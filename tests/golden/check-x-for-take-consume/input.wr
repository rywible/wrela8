module examples.check_x_for_take_consume

resource struct Packet:
    size: u64

    init(mut self, size: u64):
        self.size = size

pub fn consume(take p: Packet) -> u64:
    return p.size

pub fn peek_all(arr: [Packet; 2]) -> u64:
    total: u64 = 0
    @budget(bound=1000000)
    for p in arr:
        total += p.size
    return total

pub fn consume_all(take arr: [Packet; 2]) -> u64:
    total: u64 = 0
    @budget(bound=1000000)
    for take p in take arr:
        total += consume(take p)
    return total
