module examples.check_pixels_two_renderers

from core.__image_pixels import N_RENDERERS
from core.field import Rgb, Vec3
from core.render import (
    AoConfig, CameraBounds, LightConfig, ProbeConfig, RenderProfile,
    RgbRange, ScalarRange, ToneCurve,
)
from drivers.display import Display, DisplayDevice
from examples.two_renderer_scene import Params, shade, world

fn generated_renderer_count() -> usize:
    return N_RENDERERS

@image
fn build() -> Image:
    img = Image(name="check-pixels-two-renderers", target=Target.wrela_machine_v1, cores=2)
    device_a = img.device[DisplayDevice](transport=0x6000)
    display_a = img.driver(
        Display, device=device_a, width=64, height=32, refresh_hz=60, core=0,
    )
    device_b = img.device[DisplayDevice](transport=0x7000)
    display_b = img.driver(
        Display, device=device_b, width=64, height=32, refresh_hz=60, core=0,
    )
    renderer_a = img.renderer[Params](
        field=world, material=shade, display=display_a,
        width=64, height=32, refresh_hz=60, shade_hz=60,
        profile=RenderProfile.AaaByteExact, tone_curve=ToneCurve.Linear,
        near=0.1, far=10.0,
        world_min=Vec3(x=-1.0, y=-1.0, z=-1.0),
        world_max=Vec3(x=1.0, y=1.0, z=1.0),
        camera_bounds=CameraBounds.bounded(max_motion=0.0),
        light_config=LightConfig.fixed(capacity=0),
        exposure_range=ScalarRange(min=0.0, max=1.0),
        environment_range=RgbRange(
            min=Rgb(r=0.0, g=0.0, b=0.0),
            max=Rgb(r=1.0, g=1.0, b=1.0),
        ),
        ao=AoConfig.fixed(enabled=false),
        probes=ProbeConfig.fixed(enabled=false),
        initialization_deadline_ms=1,
    )
    renderer_b = img.renderer[Params](
        field=world, material=shade, display=display_b,
        width=64, height=32, refresh_hz=60, shade_hz=30,
        profile=RenderProfile.AaaByteExact, tone_curve=ToneCurve.FilmicV1,
        near=0.2, far=20.0,
        world_min=Vec3(x=-2.0, y=-2.0, z=-2.0),
        world_max=Vec3(x=2.0, y=2.0, z=2.0),
        camera_bounds=CameraBounds.bounded(max_motion=0.25),
        light_config=LightConfig.fixed(capacity=1),
        exposure_range=ScalarRange(min=-1.0, max=1.0),
        environment_range=RgbRange(
            min=Rgb(r=0.0, g=0.0, b=0.0),
            max=Rgb(r=2.0, g=2.0, b=2.0),
        ),
        ao=AoConfig.fixed(enabled=true),
        probes=ProbeConfig.fixed(enabled=false),
        initialization_deadline_ms=2,
    )
    img.on_failure(policy=Failure.Halt)
    return img.seal()
