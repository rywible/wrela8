module examples.err_now_default_in_isr

# plans/M9.md item K1: `now()` via a parameter default must not reach an
# ISR. Direct `now()` in the handler is refused (err-now-in-isr); routing
# through an omitted default was not scanned by `check_isr_effects`
# because Call args store `None` for defaulted slots and the intrinsic
# lives on `TypedParam::default`, not in either body.

@layout(mmio, endian=little)
struct VirtioIrqMmio:
    @offset(0x060) interrupt_status: ReadOnly[u32]
    @offset(0x064) interrupt_ack: WriteOnly[u32]

struct VirtioBlock:
    id: u32

fn stamp(t: Instant = now()) -> Instant:
    return t

@driver
pub struct BlkDriver:
    regs: Mmio[VirtioIrqMmio]
    irq: IrqCap[u32]

    init(mut self, take cap: DeviceCap[VirtioBlock]):
        claimed = VirtioBlock.claim(cap=take cap)
        self.regs = claimed.map_partition(VirtioIrqMmio)
        irq = claimed.take_irq()
        irq.bind(self.on_queue_irq)
        self.irq = take irq

    fn on_queue_irq(self):
        _ = stamp()
        self.regs.interrupt_ack.write(1)

@image
pub fn build() -> Image:
    img = Image(name="err-now-default-in-isr", target=Target.wrela_machine_v1)
    blk = img.device[VirtioBlock](transport=0x2000, vector=1)
    disk = img.driver(BlkDriver, device=blk)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
