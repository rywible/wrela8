module examples.cost_assoc_conflict


pub fn conflict5(
    a: [u64; 24],
    b: [u64; 24],
    c: [u64; 24],
    d: [u64; 24],
    e: [u64; 24],
) -> u64:
    s: u64 = a[0] +% b[0]
    s = s +% c[0] +% d[0] +% e[0]
    s = s +% a[0]
    s = s +% a[8]
    s = s +% a[16]
    return s

pub fn capacity3(a: [u64; 24], b: [u64; 24], c: [u64; 24]) -> u64:
    s: u64 = a[0] +% b[0]
    s = s +% c[0]
    s = s +% a[0]
    s = s +% a[8]
    s = s +% a[16]
    return s
