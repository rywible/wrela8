module examples.check_pixels_cross_module

from core.field import Rgb, Vec3 as Point
from core.render import (
    AoConfig, CameraBounds, LightConfig, ProbeConfig,
    RenderProfile, RgbRange, ScalarRange, ToneCurve,
)
from drivers.display import Display as Screen, DisplayDevice as ScreenDevice
from lib.pixels_scene import (
    Params as SceneParams,
    shade as scene_shade,
    world as scene_world,
)
from lib.unrelated_display_types import unrelated_display_value
from lib.unrelated_pixels_params import unrelated_fixture_value
from lib.unrelated_root_names import unrelated_root_value

@image
fn build() -> Image:
    img = Image(name="check-pixels-cross-module", target=Target.wrela_machine_v1)
    device = img.device[ScreenDevice](transport=0x6000)
    display = img.driver(Screen, device=device, width=64, height=32, refresh_hz=60)
    renderer = img.renderer[SceneParams](
        field=scene_world, material=scene_shade, display=display,
        width=64, height=32, refresh_hz=60, shade_hz=60,
        profile=RenderProfile.AaaByteExact, tone_curve=ToneCurve.Linear,
        near=0.1, far=10.0,
        world_min=Point(x=-2.0, y=-2.0, z=-2.0),
        world_max=Point(x=2.0, y=2.0, z=2.0),
        camera_bounds=CameraBounds.bounded(max_motion=0.0),
        light_config=LightConfig.fixed(capacity=0),
        exposure_range=ScalarRange(min=0.0, max=1.0),
        environment_range=RgbRange(
            min=Rgb(r=0.0, g=0.0, b=0.0),
            max=Rgb(r=1.0, g=1.0, b=1.0),
        ),
        ao=AoConfig.fixed(enabled=false),
        probes=ProbeConfig.fixed(enabled=false),
        initialization_deadline_ms=1,
    )
    img.on_failure(policy=Failure.Halt)
    return img.seal()
