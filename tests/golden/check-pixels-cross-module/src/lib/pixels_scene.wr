module lib.pixels_scene

from core.field import Field as F, Rgb, Vec3 as Point, mark as tag, sphere as ball
from core.render import MaterialSample as Sample, SurfaceContext as Surface

pub struct Params:
    @range(min=0.5, max=2.0)
    pub radius: f32
    @range(min=-2.0, max=2.0)
    pub offset: Point
    pub debug_value: f32

pub enum ObjectId:
    Scene

pub enum MaterialId:
    Surface

@field
pub fn world(p: Point, read params: Params) -> F:
    unused = params.debug_value
    return tag(
        ball(p, params.offset, radius=params.radius),
        object=ObjectId.Scene,
        material=MaterialId.Surface,
    )

@material
pub fn shade(surface: Surface[MaterialId], read params: Params) -> Sample:
    return Sample.standard(color=Rgb(r=0.2, g=0.3, b=0.4), roughness=0.5)
