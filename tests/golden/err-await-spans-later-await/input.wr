# plans/M9.md item J2d: the post-await exemption is per-suspension.
# `completion` is bound from the first await, so it does not span *that*
# await (check-await-result-path pins the legal single-await shape) — but
# it is read after a *second* await, which it does span, and it is not
# self-rooted. 02-language.md §9.2 refuses that. Without clearing the
# exemption set at each suspension the name stays permanently allowed and
# this program typechecks, which is the hole this case exists to pin.
module examples.err_await_spans_later_await

struct Payload:
    value: u64

@actor
pub struct Upstream:
    value: u64

    pub fn get(read self) -> Payload:
        return Payload(value=self.value)

@actor
pub struct Store:
    upstream: Actor[Upstream]

    pub async fn spans_second(mut self) -> u64:
        first = await self.upstream.get()
        @discard(reason="migrated: deliberate Err discard (M13 item L)")
        match first:
            case .Ok(completion):
                second = await self.upstream.get()
                return completion.value
            case .Err(_):
                return 0
