module examples.err_map_partition_not_a_driver

# plans/M7.md item H1 self-audit — `map_partition` from a plain struct's method
#
# What this case would catch: a partition whose enclosing `self` is not a `@driver` — only a driver's declared fields are its partition.

@layout(mmio, endian=little)
struct VirtioIrqMmio:
    @offset(0x060) interrupt_status: ReadOnly[u32]

struct VirtioBlock:
    id: u32

pub struct NotDriver:
    regs: Mmio[VirtioIrqMmio]

    fn steal(mut self, take claimed: DriverClaimedDevice[VirtioBlock]):
        self.regs = claimed.map_partition(VirtioIrqMmio)

@driver
pub struct BlkDriver:
    regs: Mmio[VirtioIrqMmio]

    init(mut self, take cap: DeviceCap[VirtioBlock]):
        claimed = VirtioBlock.claim(cap=take cap)
        self.regs = claimed.map_partition(VirtioIrqMmio)
