module examples.boot_actor_reply_struct


pub struct Pair:
    lo: u64
    hi: u64

    init(mut self, lo: u64, hi: u64):
        self.lo = lo
        self.hi = hi

@actor
pub struct Ledger:
    n: u64

    init(mut self):
        self.n = 500

    pub fn origin(read self) -> Pair:
        return Pair(lo=self.n + 7, hi=self.n * 2 + 7)

@actor
pub struct Store:
    led: Actor[Ledger]
    fallback: Pair

    pub fn snapshot(read self, key: u64) -> Pair:
        return Pair(lo=key + 1, hi=key * 100 + 3)

    pub async fn tally(read self) -> Pair:
        t = await self.led.origin()
        @discard(reason="migrated: deliberate Err discard (M13 item L)")
        match t:
            case .Ok(p):
                return p
            case .Err(_):
                return self.fallback

@actor
pub struct Probe:
    store: Actor[Store]
    from_sync: Pair
    from_async: Pair

    init(mut self, store: Actor[Store]):
        self.store = store
        self.from_sync = Pair(lo=0, hi=0)
        self.from_async = Pair(lo=0, hi=0)

    pub async fn fetch(mut self) -> unit:
        a = await self.store.snapshot(key=41)
        @discard(reason="migrated: deliberate Err discard (M13 item L)")
        match a:
            case .Ok(p):
                self.from_sync = p
            case .Err(_):
                pass
        b = await self.store.tally()
        @discard(reason="migrated: deliberate Err discard (M13 item L)")
        match b:
            case .Ok(q):
                self.from_async = q
            case .Err(_):
                pass
        return unit

    pub fn sync_lo(read self) -> u64:
        return self.from_sync.lo

    pub fn sync_hi(read self) -> u64:
        return self.from_sync.hi

    pub fn async_lo(read self) -> u64:
        return self.from_async.lo

    pub fn async_hi(read self) -> u64:
        return self.from_async.hi

@test(runtime)
async fn struct_replies(pr: Actor[Probe]):
    f = await pr.fetch()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match f:
        case .Ok(_):
            pass
        case .Err(_):
            assert false, "fetch rejected"
    a_lo = await pr.sync_lo()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match a_lo:
        case .Ok(v):
            assert v == 42, "sync struct reply: lo is key + 1"
        case .Err(_):
            assert false, "sync_lo rejected"
    a_hi = await pr.sync_hi()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match a_hi:
        case .Ok(v):
            assert v == 4103, "sync struct reply: hi is key * 100 + 3"
        case .Err(_):
            assert false, "sync_hi rejected"
    b_lo = await pr.async_lo()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match b_lo:
        case .Ok(v):
            assert v == 507, "async struct reply: lo is n + 7, relayed"
        case .Err(_):
            assert false, "async_lo rejected"
    b_hi = await pr.async_hi()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match b_hi:
        case .Ok(v):
            assert v == 1007, "async struct reply: hi is n * 2 + 7, relayed"
        case .Err(_):
            assert false, "async_hi rejected"

@image
pub fn build() -> Image:
    img = Image(name="boot-actor-reply-struct", target=Target.wrela_machine_v1)
    led = img.actor(Ledger, mailbox=4)
    store = img.actor(Store, mailbox=4, led=led)
    probe = img.actor(Probe, mailbox=4, store=store)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
