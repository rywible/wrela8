module examples.check_tests_exhaustive

enum Mode:
    Off
    Low
    High

@test(exhaustive)
fn wrap_round_trip(x: u8):
    assert (x +% 1) -% 1 == x, "increment then decrement round-trips"

@test(exhaustive)
fn negate_twice_is_identity(x: i8):
    assert 0 -% (0 -% x) == x, "wrapping double negation"

@test(exhaustive)
fn mode_and_flag_stay_in_range(m: Mode, flag: bool):
    v: u64 = 0
    match m:
        case .Off:
            v = 0
        case .Low:
            v = 1
        case .High:
            v = 2
    if flag:
        v = v + 10
    assert v < 13, "always in range"
