module examples.check_placement


@actor
pub struct Store:
    count: u32

    init(mut self):
        self.count = 0

    pub fn get(read self) -> u32:
        return self.count

@actor
pub struct Probe:
    flag: u32

    init(mut self):
        self.flag = 1

    pub fn ready(read self) -> u32:
        return self.flag

@image
pub fn build() -> Image:
    img = Image(name="placement-basic", target=Target.wrela_machine_v1)
    store = img.actor(Store, mailbox=8)
    probe = img.actor(Probe, mailbox=4, core=0)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
