module examples.err_test_image_driver_wake_no_image

# Sibling of `err-test-image-driver-irq-no-image`: a `@driver` with
# `wake(...)` and `@test(runtime)`, no `@image`. No runtime tables means
# nowhere to patch the wake-pending word.

@driver
pub struct BlkDriver:
    pending: InterruptCell[u32]

    init(mut self):
        self.pending = InterruptCell(0)

    @task
    fn drain(mut self):
        wake(BlkDriver.drain)
        return unit

@test(runtime)
pub fn test_needs_the_machine():
    assert true
