module examples.err_driver_message_capability


@layout(mmio, endian=little)
struct VirtioIrqMmio:
    @offset(0x060) interrupt_status: ReadOnly[u32]
    @offset(0x064) interrupt_ack: WriteOnly[u32]

struct VirtioBlock:
    id: u32

struct Escape:
    regs: Mmio[VirtioIrqMmio]

@driver
pub struct BlkDriver:
    irq_regs: Mmio[VirtioIrqMmio]
    device: RunningDevice[VirtioBlock]

    pub fn hand_out_registers(read self) -> Escape:
        return Escape(regs=self.irq_regs)

async fn ask(d: Actor[BlkDriver]) -> u64:
    v = await d.hand_out_registers()
    match v:
        case .Ok(_):
            return 1
        case .Err(_):
            return 0

@image
pub fn build() -> Image:
    img = Image(name="driver-message-capability", target=Target.wrela_machine_v1)
    blk = img.device[VirtioBlock](transport=0x2000, capacity_sectors=16)
    d = img.driver(BlkDriver, device=blk, mailbox=4)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
