module examples.err_map_partition_mode

# plans/M7.md item H1 self-audit — `map_partition(take L)` — L is a type, not a value
#
# What this case would catch: an access mode on a type argument. `map_partition`'s argument names a type.

@layout(mmio, endian=little)
struct VirtioIrqMmio:
    @offset(0x060) interrupt_status: ReadOnly[u32]

struct VirtioBlock:
    id: u32

@driver
pub struct BlkDriver:
    regs: Mmio[VirtioIrqMmio]

    init(mut self, take cap: DeviceCap[VirtioBlock]):
        claimed = VirtioBlock.claim(cap=take cap)
        self.regs = claimed.map_partition(take VirtioIrqMmio)
