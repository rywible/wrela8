module examples.err_placement_cross_core_send

# plans/M8.md item C1, the hole this item closed (found by the orchestrator's
# own probe of master at 81e52ac, before C1): this exact image — an actor
# declared `core=1`, awaited from a root turn on core 0 — used to *pass*.
# The report said `Placement id=actor#0 ... core=1`, the transcript said
# `1 passed, 0 failed`, and every one of that actor's turns had in fact run
# on core 0. Two truths (plans/M8.md shape decision 2 forbids exactly this),
# and the silent-wrong-answer class ROADMAP ranks worst.
#
# 04-compiler.md §3 says what a cross-core edge must become — "lowered to
# compiler-generated bounded SPSC rings in guest memory" — and plans/M8.md
# item C2 is where that lowering lands. Until then the edge fails closed,
# naming both cores and the item that lifts it, because CLAUDE.md's rule is
# that an unimplemented path errors loudly and never approximates.
#
# Vacuity control: change `core=1` to `core=0` and this image builds and
# passes (that is `boot-cross-core`'s `Store`). The refusal is about the
# *edge crossing a core boundary*, not about `core=` existing.

@actor
pub struct Off:
    n: u32

    init(mut self):
        self.n = 77

    pub fn get(read self) -> u32:
        return self.n

@test(runtime)
async fn runs_off_core(o: Actor[Off]):
    v = await o.get()
    match v:
        case .Ok(n):
            assert n == 77, "expected 77"
        case .Err(_):
            assert false, "call rejected"

@image
pub fn build() -> Image:
    img = Image(name="cross-core-send", target=Target.wrela_machine_v1)
    off = img.actor(Off, mailbox=4, core=1)
    img.supervise(
        children=[off],
        strategy=Restart.OneForOne,
        intensity=RestartIntensity(max=3, within=seconds(10)),
    )
    return img.seal()
