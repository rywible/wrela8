module app.main

from lib.pk import Hand as Grip
from lib.pk import Src as Item


fn drive() -> u32:
    s = Item(n=5)
    h = Grip.make(take s)
    return h.inner.n + 300

const PARAM: u32 = drive()

@test
pub fn t_param():
    assert PARAM == 305, "peer-aliased param on hand-written assoc fn"


@test(runtime)
pub fn guest_sig_param():
    assert drive() == 305, "sig-param at guest"

@actor
pub struct Store:
    param: u32

    init(mut self, param: u32):
        self.param = param

@image
pub fn build() -> Image:
    img = Image(name="import-alias-sig-param", target=Target.wrela_machine_v1)
    storage = img.actor(Store, param=PARAM, mailbox=4)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
