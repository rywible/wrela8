module examples.cost_calls

# Cost-stage golden (plans/M18.md item F) — nested calls so bl.call
# appears; checked add surfaces abort path terms.

pub fn add_one(x: u64) -> u64:
    return x + 1

pub fn double(x: u64) -> u64:
    return x * 2

pub fn combo(x: u64) -> u64:
    return double(add_one(x))
