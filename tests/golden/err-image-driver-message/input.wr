module examples.err_image_driver_message

# **Retargeted by plans/M8.md item D.** Until M8 this golden pinned the
# whole M6-D floor: nothing could message a `@driver` at all. Item D lifts
# that floor — a driver declared `img.driver(D, mailbox=n)` owns a mailbox
# and runs admitted messages as ordinary turns (`boot-driver-message` is
# the boot that does it).
#
# What survives, and is what this golden now pins: messageability is
# **opt-in on the declaration** (05-library.md §9). A `@driver` declared
# with no `mailbox=` still has no ring, no admission routine and no turn
# area, so an `await`/`send` through its `Actor[T]` handle is still a build
# error — and the diagnostic now names the one label that fixes it instead
# of naming a floor that no longer exists.
#
# The sibling `err-image-actor-undeclared` still holds the other half (an
# `Actor[T]` handle whose `T` this image never declares at all).

@driver
pub struct Blk:
    pub fn depth(read self) -> u64:
        return 8

async fn ask(b: Actor[Blk]) -> u64:
    v = await b.depth()
    match v:
        case .Ok(x):
            return x
        case .Err(_):
            return 0

@image
pub fn build() -> Image:
    img = Image(name="driver-message", target=Target.wrela_machine_v1)
    b = img.driver(Blk)
    img.supervise(children=[b], strategy=Restart.OneForOne,
                  intensity=RestartIntensity(max=3, within=seconds(10)))
    return img.seal()
