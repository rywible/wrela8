module examples.err_image_driver_message


@driver
pub struct Blk:
    pub fn depth(read self) -> u64:
        return 8

async fn ask(b: Actor[Blk]) -> u64:
    v = await b.depth()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match v:
        case .Ok(x):
            return x
        case .Err(_):
            return 0

@image
pub fn build() -> Image:
    img = Image(name="driver-message", target=Target.wrela_machine_v1)
    b = img.driver(Blk)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
