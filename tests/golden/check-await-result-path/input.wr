module examples.check_await_result_path

struct Payload:
    value: u64

@actor
pub struct Upstream:
    value: u64

    pub fn get(read self) -> Payload:
        return Payload(value=self.value)

@actor
pub struct Store:
    upstream: Actor[Upstream]

    pub async fn from_await(mut self) -> u64:
        fetched = await self.upstream.get()
        @discard(reason="migrated: deliberate Err discard (M13 item L)")
        match fetched:
            case .Ok(completion):
                return completion.value
            case .Err(_):
                return 0
