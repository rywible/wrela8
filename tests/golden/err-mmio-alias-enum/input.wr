module examples.err_mmio_alias_enum


@layout(mmio, endian=little)
struct VirtioIrqMmio:
    @offset(0x060) interrupt_status: ReadOnly[u32]
    @offset(0x064) interrupt_ack: WriteOnly[u32]

@layout(mmio, endian=little)
struct VirtioTransportMmio:
    @offset(0x060) device_status: WriteOnly[u32]

enum Holder:
    Mapped(Mmio[VirtioIrqMmio])
    Unmapped(u32)

@driver
pub struct BlkDriver:
    held: Holder
    transport_regs: Mmio[VirtioTransportMmio]
    handled_bits: u32
