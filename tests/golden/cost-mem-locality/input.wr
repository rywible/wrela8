module examples.cost_mem_locality


pub fn reuse_stack(x: u64, y: u64) -> u64:
    a: u64 = x
    b: u64 = y
    s0: u64 = a +% b
    s1: u64 = a +% b
    s2: u64 = a +% b
    s3: u64 = a +% b
    s4: u64 = a +% b
    s5: u64 = a +% b
    s6: u64 = a +% b
    s7: u64 = a +% b
    t0: u64 = s0 +% s1
    t1: u64 = s2 +% s3
    t2: u64 = s4 +% s5
    t3: u64 = s6 +% s7
    u0: u64 = t0 +% t1
    u1: u64 = t2 +% t3
    return u0 +% u1

pub fn scatter_slots(a: [u64; 8]) -> u64:
    s0: u64 = a[0] +% a[1]
    s1: u64 = a[2] +% a[3]
    s2: u64 = a[4] +% a[5]
    s3: u64 = a[6] +% a[7]
    t0: u64 = s0 +% s1
    t1: u64 = s2 +% s3
    return t0 +% t1
