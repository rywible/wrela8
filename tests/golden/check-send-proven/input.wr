module examples.check_send_proven

# plans/M6.md item G, decision 5 / 02-language.md §9.4: "When mailbox
# analysis proves admission cannot fail ... `send` stands as a bare
# statement; otherwise the result must be consumed."
#
# `Logger` is targeted by exactly three static message sites — two bare
# `send`s and one `await` — every one of them in the `@test(runtime)`
# root's own body, outside every loop and every `g.start` child, so each
# executes at most once per root turn. The declared `mailbox=4` is ≥ 3, so
# admission provably cannot fail and both bare statements are legal.
#
# The consumed-`Result` form is unaffected and still legal everywhere
# (`golden/check-actor-send` pins it on its own).

@actor
pub struct Logger:
    total: u64

    pub fn record(mut self, code: u64) -> unit:
        self.total = self.total + code
        return unit

    pub fn read_total(read self) -> u64:
        return self.total

@test(runtime)
async fn proven_sends(lg: Actor[Logger]):
    send lg.record(code=7)
    send lg.record(code=5)
    t = await lg.read_total()
    match t:
        case .Ok(v):
            assert v == 12, "both proven sends were delivered"
        case .Err(_):
            assert false, "read_total rejected"

@image
pub fn build() -> Image:
    img = Image(name="check-send-proven", target=Target.wrela_machine_v1)
    lg = img.actor(Logger, mailbox=4)
    img.supervise(children=[lg], strategy=Restart.OneForOne,
                  intensity=RestartIntensity(max=3, within=seconds(10)))
    return img.seal()
