module examples.check_send_proven


@actor
pub struct Logger:
    total: u64

    pub fn record(mut self, code: u64) -> unit:
        self.total = self.total + code
        return unit

    pub fn read_total(read self) -> u64:
        return self.total

@test(runtime)
async fn proven_sends(lg: Actor[Logger]):
    send lg.record(code=7)
    send lg.record(code=5)
    t = await lg.read_total()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match t:
        case .Ok(v):
            assert v == 12, "both proven sends were delivered"
        case .Err(_):
            assert false, "read_total rejected"

@image
pub fn build() -> Image:
    img = Image(name="check-send-proven", target=Target.wrela_machine_v1)
    lg = img.actor(Logger, mailbox=4)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
