module driver

# The block-storage driver: an ordinary `@driver` actor with a real
# `init` signature (a single plain arg, alongside `img.driver`'s own
# reserved `device=`) and one synchronous method — no `await`/`send`,
# per plans/M4.md's own non-goal (actor body typing is M6).
@driver
pub struct StorageDriver:
    id: u32
    sector_count: u32

    init(mut self, sector_count: u32):
        self.id = 1
        self.sector_count = sector_count

    pub fn capacity(read self) -> u32:
        return self.sector_count
