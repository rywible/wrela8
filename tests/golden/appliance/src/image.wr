module image


from driver import StorageDriver
from cache import CacheActor
from stats import StatsActor

enum Feature:
    Flush
    RingReset

struct BlockHw:
    id: u32

pool CacheBuffers

@image
pub fn build() -> Image:
    img = Image(name="storage-appliance", target=Target.wrela_machine_v1)

    block_device = img.device[BlockHw](
        transport=0x2000,
        required_features=[Feature.Flush],
    )

    disk = img.driver(StorageDriver, device=block_device, sector_count=131072)

    buffers = img.pool[u32](name=CacheBuffers, slots=8, max_payload=4096)

    cache = img.actor(CacheActor, disk=disk.handle(), capacity=64, mailbox=8)

    stats = img.actor(StatsActor, cache=cache.handle(), window=16, mailbox=4)

    img.on_failure(policy=Failure.Halt)

    return img.seal()
