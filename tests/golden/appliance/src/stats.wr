module stats

# The stats actor: wired to the cache actor by a `cache=cache.handle()`
# argument in the image below — the appliance's second logical actor
# edge, `Edge from=actor#1 to=actor#0` in the report. `cache`'s own
# declared type is the same honest `u32` placeholder as `cache.wr`'s own
# `disk` field, for the identical reason.
@actor
pub struct StatsActor:
    cache: u32
    window: u32
    total: u32

    init(mut self, cache: u32, window: u32):
        self.cache = cache
        self.window = window
        self.total = 0

    pub fn record(mut self, n: u32) -> u32:
        self.total = self.total +% n
        return self.total
