module stats

@actor
pub struct StatsActor:
    cache: u32
    window: u32
    total: u32

    init(mut self, cache: u32, window: u32):
        self.cache = cache
        self.window = window
        self.total = 0

    pub fn record(mut self, n: u32) -> u32:
        self.total = self.total +% n
        return self.total
