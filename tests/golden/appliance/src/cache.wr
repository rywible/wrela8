module cache

@actor
pub struct CacheActor:
    disk: u32
    capacity: u32
    hits: u32

    init(mut self, disk: u32, capacity: u32):
        self.disk = disk
        self.capacity = capacity
        self.hits = 0

    pub fn touch(mut self) -> u32:
        self.hits = self.hits +% 1
        return self.hits
