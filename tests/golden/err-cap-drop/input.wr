module examples.err_cap_drop

# 02-language.md §3.1 / values.resource.protocol-consumption: a taken
# DeviceCap whose only consumer is claim must be consumed, returned, or
# transferred — dropping it is a compile error naming the path.

struct BlockHw:
    id: u32

@driver
pub struct BlkDriver:
    sectors: u64

    init(mut self, take cap: DeviceCap[BlockHw], sectors: u64):
        self.sectors = sectors

    pub fn capacity(read self) -> u64:
        return self.sectors

@image
pub fn build() -> Image:
    img = Image(name="err-cap-drop", target=Target.wrela_machine_v1)
    blk_device = img.device[BlockHw](transport=0x2000)
    disk = img.driver(BlkDriver, device=blk_device, sectors=131072)
    img.supervise(
        children=[disk],
        strategy=Restart.OneForOne,
        intensity=RestartIntensity(max=3, within=seconds(10)),
    )
    return img.seal()
