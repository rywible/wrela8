module examples.check_placement_cross


@actor
pub struct Light:
    n: u32

    init(mut self):
        self.n = 0

    pub fn get(read self) -> u32:
        return self.n

@actor
pub struct Heavy:
    n: u32

    init(mut self):
        self.n = 0

    pub fn get(read self) -> u32:
        return self.n

    pub fn bump(read self, a: u64, b: u64, c: u64, d: u64) -> u64:
        return a

@image
pub fn build() -> Image:
    img = Image(name="placement-cross", target=Target.wrela_machine_v1, cores=3)
    light = img.actor(Light, mailbox=2, core=1)
    heavy = img.actor(Heavy, mailbox=32)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
