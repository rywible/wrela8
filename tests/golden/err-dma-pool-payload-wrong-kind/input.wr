module examples.err_dma_pool_payload_wrong_kind


@layout(wire, endian=big)
struct Record:
    magic: u32
    len: u32

struct BlockHw:
    id: u32

pool Records

@image
pub fn build() -> Image:
    img = Image(name="x", target=Target.wrela_machine_v1)
    blk = img.device[BlockHw](transport=0x2000)
    buffers = img.dma_pool[Record](name=Records, device=blk, count=4)
    return img.seal()
