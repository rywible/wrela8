module examples.err_dma_pool_payload_wrong_kind

# plans/M7.md item D, 03-hardware.md §3: the three `@layout` kinds are not
# interchangeable — `dma` is device-visible memory checked against the
# target ABI, `mmio` is a register map, `wire` is "persistent/network
# bytes — exact encoding independent of any target".
#
# `Record` has exact bytes, so `golden/err-dma-pool-payload-not-layout`'s
# rejection does not apply; it is still the wrong *kind* for a device to
# read out of a pool slot, and saying so by name is the difference between
# checking the rule and checking the easy half of it.

@layout(wire, endian=big)
struct Record:
    magic: u32
    len: u32

struct BlockHw:
    id: u32

pool Records

@image
pub fn build() -> Image:
    img = Image(name="x", target=Target.wrela_machine_v1)
    blk = img.device[BlockHw](transport=0x2000)
    buffers = img.dma_pool[Record](name=Records, device=blk, count=4)
    return img.seal()
