module examples.err_pool_backing_too_large


@layout(dma, endian=little)
struct BlkReqHeader:
    kind: u32
    reserved: u32
    sector: u64

struct BlockHw:
    id: u32

pool BlockControl

@image
pub fn build() -> Image:
    img = Image(name="x", target=Target.wrela_machine_v1)
    blk = img.device[BlockHw](transport=0x2000)
    control = img.dma_pool[BlkReqHeader](name=BlockControl, device=blk, count=4194304)
    return img.seal()
