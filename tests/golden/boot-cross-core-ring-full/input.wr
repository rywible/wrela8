module examples.boot_cross_core_ring_full


@actor
pub struct Tally:
    n: u64

    init(mut self):
        self.n = 0

    pub fn note(mut self, v: u64) -> unit:
        self.n = self.n + v
        return unit

@test(runtime)
async fn ring_full_rejects(t: Actor[Tally]):
    admitted: u64 = 0
    rejected: u64 = 0
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match send t.note(v=1):
        case .Ok(_):
            admitted = admitted + 1
        case .Err(_):
            rejected = rejected + 1
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match send t.note(v=2):
        case .Ok(_):
            admitted = admitted + 1
        case .Err(_):
            rejected = rejected + 1
    assert admitted == 1, "the one-slot cross-core ring admitted exactly one"
    assert rejected == 1, "the second send was rejected, not dropped"

@image
pub fn build() -> Image:
    img = Image(name="cross-core-ring-full", target=Target.wrela_machine_v1, cores=3)
    t = img.actor(Tally, mailbox=1, core=1)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
