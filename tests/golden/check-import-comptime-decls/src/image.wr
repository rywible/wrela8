module image

from decls import BASE, triple, Mode, weight

@actor
pub struct Store:
    base: u32
    scaled: u32
    weighted: u32
    count: u32

    init(mut self, base: u32, scaled: u32, weighted: u32):
        self.base = base
        self.scaled = scaled
        self.weighted = weighted
        self.count = 0

const SCALED: u32 = triple(BASE)
const WEIGHTED: u32 = weight(Mode.High)

@image
pub fn build() -> Image:
    img = Image(name="import-comptime-decls", target=Target.wrela_machine_v1)
    storage = img.actor(
        Store,
        base=BASE,
        scaled=SCALED,
        weighted=WEIGHTED,
        mailbox=4,
    )
    img.on_failure(policy=Failure.Halt)
    return img.seal()
