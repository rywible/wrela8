module decls

pub const BASE: u32 = 5

pub fn triple(x: u32) -> u32:
    return x * 3

pub enum Mode:
    Off
    Low
    High

pub fn weight(m: Mode) -> u32:
    match m:
        case Mode.Off:
            return 0
        case Mode.Low:
            return 1
        case Mode.High:
            return 7
