module examples.err_mmio_read_writeonly

# plans/M7.md item C, 03-hardware.md §2: a register's declared direction
# governs its access. `interrupt_ack` is declared `WriteOnly[u32]` — the
# acknowledge register of 03 §2's own worked example — so reading it does
# not exist. The accept is `golden/check-mmio-access`, where the very
# next line writes this same register.

@layout(mmio, endian=little)
struct VirtioIrqMmio:
    @offset(0x060) interrupt_status: ReadOnly[u32]
    @offset(0x064) interrupt_ack: WriteOnly[u32]

@driver
pub struct BlkDriver:
    irq_regs: Mmio[VirtioIrqMmio]

    fn peek_ack(read self) -> u32:
        return self.irq_regs.interrupt_ack.read()
