module app.main

# plans/M9.md item HH: aliasing applies only to names the importer wrote.
# `Maker as Builder` re-keys the owner; reachable Box keeps exporter
# spelling — there is no alias binding for Box to apply.
from lib.g import Maker as Builder

fn drive() -> u32:
    m = Builder(seed=4)
    b = m.build()
    return b.n + 300

const D: u32 = drive()

@test
pub fn t():
    assert D == 305, "reachable Box under aliased Maker"

@actor
pub struct Store:
    settled: u32

    init(mut self, settled: u32):
        self.settled = settled

@image
pub fn build() -> Image:
    img = Image(name="import-reachable-alias", target=Target.wrela_machine_v1)
    storage = img.actor(Store, settled=D, mailbox=4)
    img.supervise(children=[storage], strategy=Restart.OneForOne,
                  intensity=RestartIntensity(max=3, within=seconds(10)))
    return img.seal()
