module examples.err_dma_shared_lend_wrapped


@layout(dma, endian=little)
struct RingControl:
    flags: u16
    idx: u16

struct BlockHw:
    id: u32

pool BlockControl

struct RingBundle:
    ring: DmaShared[BlockControl, RingControl]

@driver
pub struct BlkDriver:
    sectors: u64

    fn peek_ring(read self, read bundle: RingBundle) -> unit:
        return unit
