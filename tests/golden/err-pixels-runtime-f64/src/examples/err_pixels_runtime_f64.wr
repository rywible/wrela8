module examples.err_pixels_runtime_f64

from core.field import (
    Field,
    Rgb,
    Vec3,
    mark,
    plane,
    union,
)
from core.render import (
    AoConfig,
    CameraBounds,
    LightConfig,
    MaterialSample,
    ProbeConfig,
    RenderProfile,
    RgbRange,
    ScalarRange,
    SurfaceContext,
    ToneCurve,
)
from drivers.display import Display, DisplayDevice

struct SceneParams:
    @range(min=-2.0, max=2.0)
    phase: f64

enum MaterialId:
    Ground
    Accent

@field
fn world(p: Vec3, read params: SceneParams) -> Field:
    left = mark(plane(p, Vec3(x=1.0, y=0.0, z=0.0), offset=0.0), object=MaterialId.Ground, material=MaterialId.Ground)
    right = mark(plane(p, Vec3(x=-1.0, y=0.0, z=0.0), offset=0.0), object=MaterialId.Accent, material=MaterialId.Accent)
    return union(left, right)

@material
fn shade(surface: SurfaceContext[MaterialId], read params: SceneParams) -> MaterialSample:
    if params.phase > 0.0:
        return MaterialSample.standard(color=Rgb(r=1.0, g=0.0, b=0.0), roughness=0.25)
    return MaterialSample.standard(color=Rgb(r=0.0, g=0.0, b=0.0), roughness=0.5)

@image
pub fn build() -> Image:
    img = Image(name="err-pixels-runtime-f64", target=Target.wrela_machine_v1)
    display_device = img.device[DisplayDevice](transport=0x6000)
    display = img.driver(Display, device=display_device, width=64, height=32, refresh_hz=60)
    renderer = img.renderer[SceneParams](
        field=world,
        material=shade,
        display=display,
        width=64,
        height=32,
        refresh_hz=60,
        shade_hz=60,
        profile=RenderProfile.AaaByteExact,
        tone_curve=ToneCurve.Linear,
        near=0.1,
        far=128.0,
        world_min=Vec3(x=-4.0, y=-4.0, z=-4.0),
        world_max=Vec3(x=4.0, y=4.0, z=4.0),
        camera_bounds=CameraBounds.bounded(max_motion=0.25),
        light_config=LightConfig.fixed(capacity=0),
        exposure_range=ScalarRange(min=-1.0, max=1.0),
        environment_range=RgbRange(
            min=Rgb(r=0.0, g=0.0, b=0.0),
            max=Rgb(r=1.0, g=1.0, b=1.0),
        ),
        ao=AoConfig.fixed(enabled=false),
        probes=ProbeConfig.fixed(enabled=false),
        initialization_deadline_ms=10,
    )
    img.on_failure(policy=Failure.Halt)
    return img.seal()
