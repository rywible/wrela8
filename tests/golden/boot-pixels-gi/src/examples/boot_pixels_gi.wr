module examples.boot_pixels_gi

# @wrela-compiler-internal: acceptance fixture for the compiler-reserved trace.
from core.runtime import __wrela_trace_p7_u64
from core.__image_pixels import __wrela_pixels_p10_probe_status

from core.field import (
    Field,
    Rgb,
    Vec3,
    mark,
    plane,
)
from core.render import (
    AoConfig,
    Camera,
    CameraBounds,
    LightConfig,
    LightFrame,
    MaterialSample,
    ProbeConfig,
    RenderFrame,
    Renderer,
    RenderProfile,
    RgbRange,
    ScalarRange,
    SurfaceContext,
    ToneCurve,
    __wrela_pixels_p10_probe_update_all,
    __wrela_pixels_p7_debug_frame_digest,
)
from drivers.display import Display, DisplayDevice

const FIXTURE_ID: u32 = 37

fn fixture_id() -> u32:
    return FIXTURE_ID

const PROBE_LEVELS: u32 = 1
const FLAGSHIP_PROBE_LEVELS: u32 = 3

# Compile the flagship constructor in this acceptance fixture while the boot
# sequence uses the explicit reduced configuration below to keep the complete
# 32-ray guest oracle bounded. Compiler table tests pin its 3x16x8x16 result.
fn flagship_probe_contract() -> ProbeConfig:
    return ProbeConfig.fixed(enabled=true)

struct SceneParams:
    @range(min=-2.0, max=2.0)
    @rate(max_delta=0.25, max_second_delta=0.0625)
    phase: f32

enum MaterialId:
    Ground

@field
fn world(p: Vec3, read params: SceneParams) -> Field:
    room_surface = plane(p, Vec3(x=0.0, y=0.0, z=1.0), offset=0.0)
    return mark(room_surface, object=MaterialId.Ground, material=MaterialId.Ground)

@material
fn shade(surface: SurfaceContext[MaterialId], read params: SceneParams) -> MaterialSample:
    return MaterialSample.standard(color=Rgb(r=0.25, g=0.5, b=0.75), roughness=0.5)

@test(runtime)
fn pinned_scene_contract():
    assert FIXTURE_ID == 37, "fixture id must remain pinned"
    assert PROBE_LEVELS == 1, "boot probe level count must remain pinned"
    assert FLAGSHIP_PROBE_LEVELS == 3, "flagship probe level count must remain pinned"

@test(runtime)
async fn gi_state_precedes_first_present(renderer: Actor[Renderer[SceneParams]]):
    frame = RenderFrame[SceneParams](
        params=SceneParams(phase=0.0),
        camera=Camera.canonical(eye=Vec3(x=0.0, y=0.0, z=-4.35)),
        lights=LightFrame.empty(),
        exposure=0.0,
        environment=Rgb(r=0.25, g=0.25, b=0.25),
        frame_index=0,
    )
    result = await renderer.render(frame=take frame)
    @discard(reason="render failure must fail this P10 acceptance fixture")
    match result:
        case .Ok(rendered):
            probe = __wrela_pixels_p10_probe_status(0)
            assert probe[0] == 1, "all probes are valid before presentation completes"
            assert probe[1] == 8, "fixture clipmap has exactly eight probes"
            assert probe[2] == 256, "initialization completes all 32-ray segments"
            assert __wrela_pixels_p10_probe_update_all(0, 1), "identical dependency snapshot remains valid"
            repeated_probe = __wrela_pixels_p10_probe_status(0)
            assert repeated_probe[3] == 0, "static frame performs zero probe rewrites"
            __wrela_trace_p7_u64(probe[1])
            __wrela_trace_p7_u64(probe[2])
            __wrela_trace_p7_u64(rendered.certificate_runs)
            __wrela_trace_p7_u64(rendered.event_corridors)
            __wrela_trace_p7_u64(rendered.revalidated_proposals)
            __wrela_trace_p7_u64(4922225244575680596)
            digest = __wrela_pixels_p7_debug_frame_digest(0)
            assert digest[0] == 1, "GI frame is complete"
            index: usize = 0
            @budget(bound=4)
            while index < 4:
                __wrela_trace_p7_u64(digest[index + 1])
                index = index + 1
        case .Err(call_error):
            match call_error:
                case .Op(failure):
                    match failure.error:
                        case .RootIsolationExhausted(tile):
                            __wrela_trace_p7_u64(4294967296 + tile.value.to[u64]())
                        case .EventIsolationExhausted(tile):
                            __wrela_trace_p7_u64(8589934592 + tile.value.to[u64]())
                        case .CertificateExhausted(tile):
                            __wrela_trace_p7_u64(12884901888 + tile.value.to[u64]())
                        case .CapacityExceeded(capacity):
                            __wrela_trace_p7_u64(17179869184 + capacity.kind.to[u64]())
                        case .FixedPointRangeExceeded(tile):
                            __wrela_trace_p7_u64(21474836480 + tile.value.to[u64]())
                        case .InternalInvariant(invariant):
                            __wrela_trace_p7_u64(25769803776 + invariant.kind.to[u64]())
                        case .ParameterOutOfRange(_):
                            __wrela_trace_p7_u64(30064771073)
                        case .NonFiniteInput(_):
                            __wrela_trace_p7_u64(30064771074)
                        case .FrameContractMismatch(path):
                            __wrela_trace_p7_u64(30064771072 + path.component.to[u64]())
                        case .Display(_):
                            __wrela_trace_p7_u64(30064771076)
                case _:
                    __wrela_trace_p7_u64(34359738368)
            assert false, "GI frame must render"

@image
pub fn build() -> Image:
    img = Image(name="boot-pixels-gi", target=Target.wrela_machine_v1)
    display_device = img.device[DisplayDevice](transport=0x6000)
    display = img.driver(Display, device=display_device, width=64, height=32, refresh_hz=60)
    renderer = img.renderer[SceneParams](
        field=world,
        material=shade,
        display=display,
        width=64,
        height=32,
        refresh_hz=60,
        shade_hz=4,
        profile=RenderProfile.AaaByteExact,
        tone_curve=ToneCurve.Linear,
        near=0.1,
        far=128.0,
        world_min=Vec3(x=-4.0, y=-4.0, z=-4.0),
        world_max=Vec3(x=4.0, y=4.0, z=4.0),
        camera_bounds=CameraBounds.bounded(max_motion=0.25),
        light_config=LightConfig.fixed(capacity=0),
        exposure_range=ScalarRange(min=-1.0, max=1.0),
        environment_range=RgbRange(
            min=Rgb(r=0.0, g=0.0, b=0.0),
            max=Rgb(r=1.0, g=1.0, b=1.0),
        ),
        ao=AoConfig.fixed(enabled=false),
        probes=ProbeConfig.dynamic_v1(
            base_spacing=1.0,
            levels=1,
            dim_x=2,
            dim_y=2,
            dim_z=2,
            initialization_worst_case_ms=250,
        ),
        initialization_deadline_ms=250,
    )
    img.on_failure(policy=Failure.Halt)
    return img.seal()
