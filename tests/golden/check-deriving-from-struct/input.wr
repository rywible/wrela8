module examples.check_deriving_from_struct


pub struct LoadError:
    code: u32

pub struct WrapError deriving(From):
    inner: LoadError

pub fn parse(raw: u32) -> Result[u32, LoadError]:
    if raw == 0:
        return Err(LoadError(code=raw))
    return Ok(raw)

pub fn convert_wrapped(raw: u32) -> Result[u32, WrapError]:
    value = parse(raw)?
    return Ok(value)

fn settle(r: Result[u32, WrapError]) -> u32:
    match r:
        case .Ok(v):
            return v
        case .Err(e):
            return e.inner.code + 1000

fn direct_call() -> u32:
    s = LoadError(code=5)
    w = WrapError.from(take s)
    return w.inner.code + 2500

const CONVERTED: u32 = settle(convert_wrapped(0))
const OK: u32 = settle(convert_wrapped(7))
const DIRECT: u32 = direct_call()

@test
pub fn test_struct_deriving_converts():
    assert CONVERTED == 1000, "`?` must call WrapError.from on LoadError(code=0)"

@test
pub fn test_ok_path_unchanged():
    assert OK == 7, "Ok path must not convert"

@test
pub fn test_generated_from_callable():
    assert DIRECT == 2505, "generated struct from must be callable directly"


@test(runtime)
pub fn guest_from():
    assert settle(convert_wrapped(0)) == 1000, "`?` struct from at guest"
    assert settle(convert_wrapped(7)) == 7, "Ok path at guest"
    assert direct_call() == 2505, "generated struct from at guest"

@actor
pub struct Store:
    converted: u32
    ok: u32
    direct: u32

    init(mut self, converted: u32, ok: u32, direct: u32):
        self.converted = converted
        self.ok = ok
        self.direct = direct

@image
pub fn build() -> Image:
    img = Image(name="check-deriving-from-struct", target=Target.wrela_machine_v1)
    storage = img.actor(Store, converted=CONVERTED, ok=OK, direct=DIRECT, mailbox=4)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
