module examples.err_driver_message_isr_pub

# plans/M8.md item D, arm 3 of the security surface: a driver mailbox must
# not become a way to run an interrupt handler as an ordinary turn.
#
# 03-hardware.md §6: "An interrupt handler is a plain `fn` bound to a
# vector at image/driver wiring (`irq.bind(self.on_queue_irq)`). The
# binding — not a keyword — makes the compiler restrict the function's
# transitive effects to the ISR set". That handler acknowledges its
# device's interrupt source. Admitting it from a mailbox would run that
# acknowledge — a write to a live device register — at an arbitrary time,
# on behalf of an arbitrary sender, in none of §6's ordering.
#
# This is `boot-driver-message`'s own source with one declaration changed:
# `fn on_queue_irq(self)` becomes `pub fn on_queue_irq(self) -> unit` (a
# `pub` method must spell its result, 02-language.md §5.1). That boot
# passes; this one does not build. The delta is exporting the handler.

@layout(mmio, endian=little)
struct VirtioIrqMmio:
    @offset(0x060) interrupt_status: ReadOnly[u32]
    @offset(0x064) interrupt_ack: WriteOnly[u32]

@layout(dma, endian=little)
struct BlkReqHeader:
    kind: u32
    reserved: u32
    sector: u64

struct VirtioBlock:
    id: u32

enum Feature:
    Flush

const QDEPTH: usize = 8
const SECTOR: u64 = 512

pool BlockControl

@driver
pub struct BlkDriver:
    irq_regs: Mmio[VirtioIrqMmio]
    device: RunningDevice[VirtioBlock]
    queue: VirtQueue[..8]
    capacity_sectors: u64
    pending: InterruptCell[u32]
    irq: IrqCap[u32]
    drains: u64

    init(mut self,
         take cap: DeviceCap[VirtioBlock],
         take control_pool: DmaPool[BlockControl, 512])
        -> Result[unit, BootError]:
        claimed = VirtioBlock.claim(cap=take cap)
        self.irq_regs = claimed.map_partition(VirtioIrqMmio)
        self.pending = InterruptCell(0)
        self.drains = 0
        negotiated = claimed.negotiate(
            required=[Feature.Flush],
            optional=[Feature.Flush],
        )?
        self.queue = VirtQueue.configure(
            pool=take control_pool,
            device=mut negotiated,
            index=0,
            depth=QDEPTH,
        )?
        self.capacity_sectors = negotiated.read_capacity_sectors()?
        irq = negotiated.take_irq()
        irq.bind(self.on_queue_irq)
        irq.unmask()
        self.irq = take irq
        self.device = negotiated.start()
        return Ok(unit)

    # 03 §6's ISR — exported, which is the whole point of this case.
    pub fn on_queue_irq(self) -> unit:
        status = self.irq_regs.interrupt_status.read()
        handled = status & 1
        if handled != 0:
            self.pending.fetch_or_release(handled)
            self.irq_regs.interrupt_ack.write(handled)
            wake(BlkDriver.drain)

    # 03 §6's bottom half: private, woken not admitted.
    @task
    fn drain(mut self):
        status = self.pending.swap_acquire(0)
        if status == 0:
            return unit
        self.drains = self.drains + 1
        return unit

    # The exported surface: plain data in, plain data out. No capability,
    # no sealed queue value, no receipt crosses this boundary.
    pub fn capacity(read self) -> u64:
        return self.capacity_sectors

    pub fn sector_bytes(read self, count: u64) -> u64:
        return count * SECTOR

@actor
pub struct Storage:
    disk: Actor[BlkDriver]

    pub async fn blocks(read self) -> u64:
        c = await self.disk.capacity()
        match c:
            case .Ok(n):
                return n
            case .Err(_):
                return 0

@test(runtime)
async fn actor_relays_a_driver_reply(st: Actor[Storage]):
    v = await st.blocks()
    match v:
        case .Ok(n):
            assert n == 16, "the driver's own capacity, relayed through an actor turn"
        case .Err(_):
            assert false, "relay rejected"

@test(runtime)
async fn root_messages_the_driver_directly(disk: Actor[BlkDriver]):
    v = await disk.sector_bytes(count=3)
    match v:
        case .Ok(n):
            assert n == 1536, "3 * 512 computed inside a driver turn"
        case .Err(_):
            assert false, "driver call rejected"

@image
pub fn build() -> Image:
    img = Image(name="err-driver-message-isr-pub", target=Target.wrela_machine_v1)
    blk = img.device[VirtioBlock](
        transport=0x2000,
        capacity_sectors=16,
        required_features=[Feature.Flush],
        vector=1,
    )
    control = img.dma_pool[BlkReqHeader](name=BlockControl, device=blk, count=32)
    disk = img.driver(BlkDriver, device=blk, mailbox=4)
    st = img.actor(Storage, mailbox=4, disk=disk)
    img.supervise(children=[disk, st], strategy=Restart.OneForOne,
                  intensity=RestartIntensity(max=3, within=seconds(10)))
    return img.seal()
