module examples.err_cap_mint_device_mismatch

# plans/M7.md item A, 03-hardware.md §1: `DeviceCap[D]` is "authority over
# one device instance", minted at a binding that names that device. "The
# single source of truth" is only true if the two agree — a
# `DeviceCap[NicHw]` minted from an `img.device[BlockHw]` binding would be
# authority over a device this image never bound to this driver.

struct BlockHw:
    id: u32

struct NicHw:
    id: u32

@driver
pub struct BlkDriver:
    sectors: u64

    init(mut self, take cap: DeviceCap[NicHw], sectors: u64):
        self.sectors = sectors

    pub fn capacity(read self) -> u64:
        return self.sectors

@image
pub fn build() -> Image:
    img = Image(name="cap-mint", target=Target.wrela_machine_v1)
    blk_device = img.device[BlockHw](transport=0x2000)
    disk = img.driver(BlkDriver, device=blk_device, sectors=131072)
    img.supervise(
        children=[disk],
        strategy=Restart.OneForOne,
        intensity=RestartIntensity(max=3, within=seconds(10)),
    )
    return img.seal()
