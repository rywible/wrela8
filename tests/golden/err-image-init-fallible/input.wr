module examples.err_image_init_fallible


enum SinkError:
    Unavailable

@actor
pub struct Sink:
    depth: u32

    init(mut self, depth: u32) -> Result[unit, SinkError]:
        self.depth = depth
        return .Ok(unit)

    pub fn read_depth(read self) -> u32:
        return self.depth

@test(runtime)
async fn boots(s: Actor[Sink]):
    d = await s.read_depth()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match d:
        case .Ok(v):
            assert v == 7, "unreachable: this image never lays out"
        case .Err(_):
            assert false, "read_depth rejected"

@image
pub fn build() -> Image:
    img = Image(name="err-image-init-fallible", target=Target.wrela_machine_v1)
    s = img.actor(Sink, mailbox=4, depth=7)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
