    s = s * b + a * b + s * a + b * b
    s = s * b + a * b + s * a + b * b
    s = s * b + a * b + s * a + b * b
    s = s * b + a * b + s * a + b * b
    s = s * b + a * b + s * a + b * b
    s = s * b + a * b + s * a + b * b
    s = s * b + a * b + s * a + b * b
    s = s * b + a * b + s * a + b * b
    s = s * b + a * b + s * a + b * b
    s = s * b + a * b + s * a + b * b
    s = s * b + a * b + s * a + b * b
    s = s * b + a * b + s * a + b * b
    s = s * b + a * b + s * a + b * b
    s = s * b + a * b + s * a + b * b
    s = s * b + a * b + s * a + b * b
    s = s * b + a * b + s * a + b * b
    s = s * b + a * b + s * a + b * b
    s = s * b + a * b + s * a + b * b
    s = s * b + a * b + s * a + b * b
    s = s * b + a * b + s * a + b * b
    s = s * b + a * b + s * a + b * b
    s = s * b + a * b + s * a + b * b
    return s

