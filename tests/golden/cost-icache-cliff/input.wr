    s = s * b + a * b + s * a + b * b
    s = s * b + a * b + s * a + b * b
    return s

@actor
pub struct Hot:
    n: u64

    pub fn run(mut self, a: u64, b: u64) -> u64:
        self.n = bulk0(a, b) +% bulk1(a, b) +% bulk2(a, b) +% bulk3(a, b) +% bulk4(a, b)
        return self.n

@image
pub fn build() -> Image:
    img = Image(name="cost-icache-cliff", target=Target.wrela_machine_v1)
    hot = img.actor(Hot, mailbox=2)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
