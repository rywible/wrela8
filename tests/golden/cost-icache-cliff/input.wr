module examples.cost_icache_cliff



pub fn bulk0(a: u64, b: u64) -> u64:
    s: u64 = a
    s = s * b + a * b + s * a + b * b
    s = s * b + a * b + s * a + b * b
    s = s * b + a * b + s * a + b * b
    s = s * b + a * b + s * a + b * b
