pub fn bulk4(a: u64, b: u64) -> u64:
    s: u64 = a
    s = s * b + a * b + s * a + b * b
    s = s * b + a * b + s * a + b * b
    s = s * b + a * b + s * a + b * b
    s = s * b + a * b + s * a + b * b
