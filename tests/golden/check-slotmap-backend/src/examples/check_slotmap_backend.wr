module examples.check_slotmap_backend

# plans/M9.md item MM (was F2 reachability-only): SlotMap mutating methods
# lower in guest code after nested place assignment. Pins check/image plus
# mwir/asm of insert/contains. Comptime key discipline remains
# check-slotmap-key-discipline.

from core.slotmap import SlotMap, Key, SlotMapFull

@actor
pub struct Store:
    map_id: u64

    init(mut self, map_id: u64):
        self.map_id = map_id

    pub fn insert_one(mut self) -> u64:
        m = SlotMap[u64, 2](map_id=self.map_id)
        x: u64 = 10
        match m.insert(take x):
            case .Ok(k):
                if m.contains(k):
                    return 1
                return 0
            case .Err(_):
                return 0

@test(runtime)
async fn guest_slotmap(store: Actor[Store]):
    v = await store.insert_one()
    match v:
        case .Ok(n):
            assert n == 1, "insert+contains"
        case .Err(_):
            assert false, "call rejected"

@image
pub fn build() -> Image:
    img = Image(name="check-slotmap-backend", target=Target.wrela_machine_v1)
    a = img.actor(Store, map_id=1, mailbox=4)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
