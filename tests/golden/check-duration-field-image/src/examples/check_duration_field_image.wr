module examples.check_duration_field_image


struct Timing:
    delay: Duration

@actor
pub struct Store:
    t: Timing

    init(mut self):
        self.t = Timing(delay=ms(10))

    pub fn budget_ns(read self) -> u64:
        return 0

@image
pub fn build() -> Image:
    img = Image(name="duration-field-image", target=Target.wrela_machine_v1)
    s = img.actor(Store, mailbox=8)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
