module examples.err_image_field_handle_unmaterialized


@actor
pub struct Tally:
    hits: u64

    pub fn hit(mut self, n: u64) -> unit:
        self.hits = self.hits + n
        return unit

@actor
pub struct Ledger:
    marks: u64

    pub fn mark(mut self, n: u64) -> unit:
        self.marks = self.marks + n
        return unit

@actor
pub struct Worker:
    led: Actor[Ledger]

@image
pub fn build() -> Image:
    img = Image(name="field-handle", target=Target.wrela_machine_v1)
    t = img.actor(Tally, mailbox=8)
    led = img.actor(Ledger, mailbox=8)
    w = img.actor(Worker, mailbox=8, led=led)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
