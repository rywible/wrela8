module check.enum_methods

# plans/M9.md item B2: an enum may declare methods and associated fns.
# Four shapes under one settle, each pinned by value (BB's discipline).

enum Cell:
    Hold(u32)
    Empty

    pub fn empty() -> Cell:
        return Cell.Empty

    pub fn value(read self) -> u32:
        match self:
            case .Hold(n):
                return n
            case .Empty:
                return 0

    pub fn fill(mut self, n: u32):
        self = Cell.Hold(n)

    pub fn into_n(take self) -> u32:
        match self:
            case .Hold(n):
                return n
            case .Empty:
                return 0

const Z: u32 = Cell.empty().value()

fn mut_path() -> u32:
    c = Cell.Empty
    c.fill(11)
    return c.value()

fn take_path() -> u32:
    c = Cell.Hold(7)
    return c.into_n()

const R: u32 = Cell.Hold(1).value()
const M: u32 = mut_path()
const T: u32 = take_path()

# settle = Z*1000 + R*100 + M*10 + T = 0 + 100 + 110 + 7 = 217
const SETTLED: u32 = Z * 1000 + R * 100 + M * 10 + T

@test
pub fn t_assoc():
    assert Z == 0, "associated fn resolves"

@test
pub fn t_read():
    assert R == 1, "read-self method resolves"

@test
pub fn t_mut():
    assert M == 11, "mut-self method resolves"

@test
pub fn t_take():
    assert T == 7, "take-self method resolves"

@test
pub fn t_settled():
    assert SETTLED == 217, "all four under one settle"

@actor
pub struct Store:
    settled: u32

    init(mut self, settled: u32):
        self.settled = settled

@image
pub fn build() -> Image:
    img = Image(name="enum-methods", target=Target.wrela_machine_v1)
    storage = img.actor(Store, settled=SETTLED, mailbox=4)
    img.supervise(children=[storage], strategy=Restart.OneForOne,
                  intensity=RestartIntensity(max=3, within=seconds(10)))
    return img.seal()
