module check.enum_methods


enum Cell:
    Hold(u32)
    Empty

    pub fn empty() -> Cell:
        return Cell.Empty

    pub fn value(read self) -> u32:
        match self:
            case .Hold(n):
                return n
            case .Empty:
                return 0

    pub fn fill(mut self, n: u32):
        self = Cell.Hold(n)

    pub fn into_n(take self) -> u32:
        match self:
            case .Hold(n):
                return n
            case .Empty:
                return 0

const Z: u32 = Cell.empty().value()

fn mut_path() -> u32:
    c = Cell.Empty
    c.fill(11)
    return c.value()

fn take_path() -> u32:
    c = Cell.Hold(7)
    return c.into_n()

const R: u32 = Cell.Hold(1).value()
const M: u32 = mut_path()
const T: u32 = take_path()

const SETTLED: u32 = Z * 1000 + R * 100 + M * 10 + T

@test
pub fn t_assoc():
    assert Z == 0, "associated fn resolves"

@test
pub fn t_read():
    assert R == 1, "read-self method resolves"

@test
pub fn t_mut():
    assert M == 11, "mut-self method resolves"

@test
pub fn t_take():
    assert T == 7, "take-self method resolves"

@test
pub fn t_settled():
    assert SETTLED == 217, "all four under one settle"


@test(runtime)
pub fn guest_methods():
    assert Cell.empty().value() == 0, "assoc+read at guest"
    assert Cell.Hold(1).value() == 1, "read at guest"
    assert mut_path() == 11, "mut at guest"
    assert take_path() == 7, "take at guest"

@actor
pub struct Store:
    settled: u32

    init(mut self, settled: u32):
        self.settled = settled

@image
pub fn build() -> Image:
    img = Image(name="enum-methods", target=Target.wrela_machine_v1)
    storage = img.actor(Store, settled=SETTLED, mailbox=4)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
