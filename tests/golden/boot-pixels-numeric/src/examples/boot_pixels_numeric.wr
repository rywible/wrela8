module examples.boot_pixels_numeric

from core.render_test_vectors import VECTOR_COUNT, VECTOR_DIGEST, VectorResult, bool_result, fold2, fold4, fold6, fold6_small, fold12, numeric_result, run_all_vectors, run_vector_chunk_0, run_vector_chunk_1, run_vector_chunk_2, run_vector_chunk_3, run_vector_chunk_4, run_vector_chunk_5, run_vector_chunk_6, run_vector_chunk_7, run_vector_chunk_8, run_vector_chunk_9, run_vector_chunk_10, run_vector_chunk_11, run_vector_chunk_12, vector_case_matches, vector_order_roots, vector_q_slack, vector_q_sort, vector_result, vector_result_raw, vector_result_raw_high, vector_result_raw_low, vector_result_raw_mid, vector_root_outcome_field, vector_transfer_balanced, vector_transfer_replace
from core.render_certificate import certify_monotone_root
from core.render_interval import FixedDomain, FixedDomainOutcome, Iv32, NumericOutcome, fixed_domain, interval_abs, interval_add, interval_affine, interval_ceil_div, interval_contains_zero, interval_convert, interval_floor_div, interval_from_f32_bits, interval_hull, interval_intersect, interval_max, interval_min, interval_mul, interval_narrow, interval_negate, interval_scale_pow2, interval_square, interval_strict_negative, interval_strict_positive, interval_sub, interval_valid
from core.render_program import BernsteinOutcome3, BernsteinSplit9Outcome, BernsteinSplitOutcome3, Polynomial9, Polynomial9Outcome, QuadraticRangeOutcome, QuadraticRangeWideOutcome, SparseTerm, bernstein_average, bernstein_compose, bernstein_from_power9, bernstein_lerp_ratio, bernstein_sign, bernstein_subdivide, bernstein_subdivide9, polynomial_compose9, polynomial_derivative9, polynomial_horner9, polynomial_multiply9, polynomial_sparse, polynomial_sparse32, polynomial_taylor, program_binomial, program_ceil_div, program_floor_div, program_gcd, quadratic_range, quadratic_range2, quadratic_range_wide
from core.render_events import RootIsolationConfig, RootOutcome8, RootSet8, root_bracket_step, root_count, root_is_identically_zero, root_isolate8, root_isolate_program8, root_isolate_taylor8
from core.render_sweep import CertificateRequest, CertifiedRunOutcome, CsgBitsOutcome, CsgEvaluateOutcome, CsgInfluenceOutcome, CsgTransitionOutcome, OrderedRoot, OrderedRootSet64, OrderedRootSetOutcome, OrderedSlackOutcome, RootCertificateOutcome, bernstein_certificate, bernstein_certificate_subdivided, bernstein_face_margin3, certify_run, csg_boundary_influences64, csg_evaluate64, csg_first_transition64, csg_oriented_toggle64, csg_transition, kinetic_slack, krawczyk_certificate, monotone_certificate, q_adjacent_slack3, q_adjacent_slack64, q_feature_before, q_order, q_sort3, q_sort64, q_storage_before, run_certificate, strict_margin
from core.render_raster import QRunScalar, QSetup, QStep, fixed_q_nearer, fixed_q_quantize_integer, fixed_q_recurrence_fits, fixed_q_select_integer_domain, fixed_q_setup, fixed_q_step
from core.render_coverage import CoverageOutcome, coverage_color_error, coverage_line_twice_area, coverage_quadratic, coverage_quadratic_graph, coverage_quadratic_split, coverage_quadratic_strip
from core.render_material import CenteredMoments, Iv3Outcome, MaterialPredicateOutcome, MomentOutcome, NormalCone, NormalConeOutcome, NormalRawRange, material_affine, material_affine_moments, material_affine_vector, material_footprint, material_quadratic_moments, material_residual, normal_bound, normal_cone, normal_cone_dot, normal_dot, normal_floor_sqrt, normal_norm_squared, normal_raw_add, normal_raw_dot, normal_raw_norm_squared, normal_raw_product, normal_raw_square, normal_safe, normal_vector
from core.render_transfer import Transfer, TransferOutcome, transfer_balanced2, transfer_balanced64, transfer_channel, transfer_compose, transfer_replace2, transfer_replace64, transparency_tail
from core.render_display import ByteSingletonOutcome, QuantizeOutcome, RgbSingletonOutcome, byte_singleton, color_matrix_channel, exposure_channel, monotone_lut17, quantize_ties_even, rgb_singleton

@test(runtime)
pub fn pixels_numeric_vectors():
    assert VECTOR_COUNT > 0, "generated host vector set"
    assert VECTOR_DIGEST != 0, "host vector digest"
    run_all_vectors()

    domain = FixedDomain.full(-4)
    a = Iv32.point(16)
    b = Iv32.point(8)
    match interval_add(a, b, domain):
        case .Value(value):
            assert value.lower() == 24 and value.upper() == 24, "interval add"
        case _:
            assert false, "interval add must decide"
    match interval_sub(a, b, domain):
        case .Value(value):
            assert value.lower() == 8 and value.upper() == 8, "interval sub"
        case _:
            assert false, "interval sub must decide"
    match interval_mul(a, b, domain):
        case .Value(value):
            assert value.lower() == 8 and value.upper() == 8, "interval mul"
        case _:
            assert false, "interval mul must decide"
    match interval_intersect(a, b, domain):
        case .Empty:
            pass
        case _:
            assert false, "interval intersection"

    match bernstein_compose(1, 2, 1, FixedDomain.full(0)):
        case .Value(composed):
            assert composed[0].lower() == 1 and composed[1].lower() == 2 and composed[1].upper() == 2 and composed[2].upper() == 4, "Bernstein composition"
        case .Error:
            assert false, "Bernstein composition must fit"
    assert bernstein_sign([Iv32.point(1), Iv32.point(2), Iv32.point(3)]) == 1, "Bernstein sign"
    match bernstein_subdivide([Iv32.point(0), Iv32.point(2), Iv32.point(4)], FixedDomain.full(0)):
        case .Value(split):
            assert split[0].lower() == 0 and split[5].upper() == 4, "Bernstein subdivision"
        case .Error:
            assert false, "Bernstein subdivision must fit"
    match quadratic_range(1, -8, 16):
        case .Value(range):
            assert range[0] == 0 and range[1] == 9, "quadratic range"
        case .Error:
            assert false, "quadratic range must fit"
    bracket = root_bracket_step(0, 8, true, false)
    assert bracket.lower() == 0 and bracket.upper() == 4, "root bracket"
    assert root_count(-1, 1, -1) == 2, "root count"

    negative = Iv32.point(-1)
    positive = Iv32.point(1)
    derivative = Iv32.point(2)
    assert run_certificate(negative, positive, derivative), "run certificate"
    assert q_order(Iv32.point(3), Iv32.point(2)), "q order"
    assert csg_transition(false, true), "CSG transition"
    assert kinetic_slack(4, 3), "kinetic slack"

    match fixed_q_step(QRunScalar.make(10, 2, 1, 0)):
        case .Value(value):
            assert value.value() == 12, "fixed-q step"
        case .Error:
            assert false, "fixed-q step must fit"

    match coverage_line_twice_area(1, 1, -1):
        case .Value(line):
            assert line.lower() == 256 and line.upper() == 256, "line coverage"
        case .Error:
            assert false, "line coverage must decide"
    curve = coverage_quadratic(Iv32.point(128), 3)
    assert curve.lower() == 125 and curve.upper() == 131, "quadratic coverage"
    match normal_bound(Iv32.point(16), Iv32.point(0), Iv32.point(0), Iv32.point(0), Iv32.point(0)):
        case .Value(normal):
            assert normal.z_lower() == 16, "normal bound"
        case .Error:
            assert false, "normal bound must fit"
    match material_residual(Iv32.point(2), 1, 3, FixedDomain.full(-8)):
        case .Value(value):
            assert value, "material residual"
        case .Error:
            assert false, "material residual must decide"
    transfer = Transfer.make(Iv32.point(1), Iv32.point(1), Iv32.point(1), Iv32.point(256))
    match transfer_compose(transfer, transfer, 8, 0):
        case .Value(combined):
            assert combined.red_lower() == 2, "transfer composition"
        case .Error:
            assert false, "transfer composition must decide"
    assert transparency_tail(1, 1, 1), "transparency tail"
    match byte_singleton(Iv32.point(8), 2):
        case .Value(code):
            assert code == 2, "display byte singleton"
        case _:
            assert false, "display byte singleton must decide"
