module examples.err_mmio_offset_out_of_reach


@layout(mmio, endian=little)
struct Regs:
    @offset(0x10000) status: ReadOnly[u32]

struct Dev:
    id: u32

@driver
pub struct BlkDriver:
    regs: Mmio[Regs]
    claimed: DriverClaimedDevice[Dev]

    init(mut self, take cap: DeviceCap[Dev]):
        claimed = Dev.claim(cap=take cap)
        self.regs = claimed.map_partition(Regs)
        self.claimed = take claimed
        _ = self.regs.status.read()
