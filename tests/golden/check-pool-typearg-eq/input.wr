module examples.check_pool_typearg_eq

# Item D introduced `TypeArg::Pool` for `DmaShared[P, L]` / `DmaPool[P, N]`.
# `types_eq`'s `type_args_eq` left Pool vs Pool as `false`, so assigning
# `None` to `Option[DmaShared[P, L]]` failed with identical expected/found
# renderings. This golden is the oracle that equality compares Pool by
# name — found while earning E3's protocol-consumption flip; the gap
# dates from item D, not a new E3 rule.

@layout(dma, endian=little)
struct RingControl:
    flags: u16
    idx: u16

struct BlockHw:
    id: u32

pool BlockControl

@driver
pub struct BlkDriver:
    ring: Option[DmaShared[BlockControl, RingControl]]
    sectors: u64

    init(mut self, take control: DmaPool[BlockControl, 4096], sectors: u64):
        self.sectors = sectors
        self.ring = None

    pub fn capacity(read self) -> u64:
        return self.sectors

@image
pub fn build() -> Image:
    img = Image(name="pool-typearg-eq", target=Target.wrela_machine_v1)
    blk = img.device[BlockHw](transport=0x2000)
    disk = img.driver(BlkDriver, device=blk, sectors=2048)
    control = img.dma_pool[RingControl](name=BlockControl, device=blk, count=16)
    img.supervise(children=[disk], strategy=Restart.OneForOne,
                  intensity=RestartIntensity(max=3, within=seconds(10)))
    return img.seal()
