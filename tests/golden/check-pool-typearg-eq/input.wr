module examples.check_pool_typearg_eq


@layout(dma, endian=little)
struct RingControl:
    flags: u16
    idx: u16

struct BlockHw:
    id: u32

pool BlockControl

@driver
pub struct BlkDriver:
    ring: Option[DmaShared[BlockControl, RingControl]]
    sectors: u64

    init(mut self, take control: DmaPool[BlockControl, 4096], sectors: u64):
        self.sectors = sectors
        self.ring = None

    pub fn capacity(read self) -> u64:
        return self.sectors

@image
pub fn build() -> Image:
    img = Image(name="pool-typearg-eq", target=Target.wrela_machine_v1)
    blk = img.device[BlockHw](transport=0x2000)
    disk = img.driver(BlkDriver, device=blk, sectors=2048)
    control = img.dma_pool[RingControl](name=BlockControl, device=blk, count=16)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
