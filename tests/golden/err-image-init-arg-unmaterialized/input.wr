module examples.err_image_init_arg_unmaterialized

# The fail-closed half of `image.graph.init-args-match`, found by probing
# the floor its sibling fix disclosed rather than by reading code.
#
# `eval::image_checks::check_one_decl` accepts `depth=7` — it really does
# name a real `Sink.init` parameter, so the wiring is well-formed. But
# `layout::build_boot_init` can only call a *zero-argument* `init`; an
# `init` that takes parameters is never called at all. Before this case,
# the two facts combined into a silent wrong answer: this exact image
# booted, `read_depth()` returned **0** rather than 7, and every tier
# reported success. Verified by running it, which is how it was found.
#
# CLAUDE.md's "fail closed: an unimplemented path errors loudly; it never
# approximates" governs. A code comment disclosing the floor is not the
# same as failing closed — so the layout pass, which is the component
# that cannot do the job, now says so before emitting anything.
#
# The rule is keyed on the *declared actor's* `init`, never on the wiring
# arguments (an `init` with parameters is uncallable by boot whatever the
# image passes) and never on plain data structs (`Pair.init(lo, hi)` in
# `golden/boot-actor-reply-struct` is ordinary legal code).
#
# What unpins this case: real init-argument materialization, which M7
# needs anyway — 03-hardware.md §1's `@driver` init is
# `init(mut self, take cap: DeviceCap[D], take pool: DmaPool[P, N])`.

@actor
pub struct Sink:
    depth: u32

    init(mut self, depth: u32):
        self.depth = depth

    pub fn read_depth(read self) -> u32:
        return self.depth

@test(runtime)
async fn boots(s: Actor[Sink]):
    d = await s.read_depth()
    match d:
        case .Ok(v):
            assert v == 7, "the wired init argument must reach the actor's state"
        case .Err(_):
            assert false, "read_depth rejected"

@image
pub fn build() -> Image:
    img = Image(name="err-image-init-arg-unmaterialized", target=Target.wrela_machine_v1)
    s = img.actor(Sink, mailbox=4, depth=7)
    img.supervise(children=[s], strategy=Restart.OneForOne,
                  intensity=RestartIntensity(max=3, within=seconds(10)))
    return img.seal()
