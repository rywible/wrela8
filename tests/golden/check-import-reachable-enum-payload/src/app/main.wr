module app.main

# plans/M9.md item JJ: enum variant payload reachability. Import Res
# under an alias and make, but not Payload. The closure must walk
# Good(Payload) so comptime construction inside make and the match
# binding both resolve (HH missed this edge; Option[Inner] already worked).
from lib.g import Res as R
from lib.g import make

fn drive() -> u32:
    match make(n=6):
        case .Good(p):
            return p.n + 400
        case .Bad:
            return 0

const D: u32 = drive()

@test
pub fn t():
    assert D == 406, "aliased enum, unimported payload struct bound in pattern"


# Guest-reachable path (plans/M9.md item KK): H3 dropped drive() from asm;
# `@test(runtime)` seeds the import-reachability claim.
@test(runtime)
pub fn guest_reachable():
    assert drive() == 406, "reachable enum-payload at guest"

@actor
pub struct Store:
    settled: u32

    init(mut self, settled: u32):
        self.settled = settled

@image
pub fn build() -> Image:
    img = Image(name="import-reachable-enum-payload", target=Target.wrela_machine_v1)
    storage = img.actor(Store, settled=D, mailbox=4)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
