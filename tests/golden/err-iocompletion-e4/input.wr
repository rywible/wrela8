module examples.err_iocompletion_e4

# plans/M7.md item H2a: 03-hardware.md §8's worked producer is
# `completion.written_len` on an `IoCompletion[P]`. Completions are item
# E4; naming the type fails closed rather than inventing a stand-in.

struct Packet:
    n: u32

fn bad(c: IoCompletion[Packet]) -> Untrusted[usize]:
    return c.written_len
