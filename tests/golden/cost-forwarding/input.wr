module examples.cost_forwarding


pub fn forwarded(a: u64, b: u64) -> u64:
    x: u64 = a +% b
    y: u64 = x +% x
    z: u64 = y +% y
    w: u64 = z +% z
    return w

pub fn l1_path(v: [u64; 48]) -> u64:
    s0: u64 = v[0]
    s1: u64 = v[1]
    s2: u64 = v[2]
    s3: u64 = v[3]
    s4: u64 = v[4]
    s5: u64 = v[5]
    s6: u64 = v[6]
    s7: u64 = v[7]
    return s0 +% s1 +% s2 +% s3 +% s4 +% s5 +% s6 +% s7

pub fn cross_block(a: u64, b: u64, take_it: bool) -> u64:
    x: u64 = a +% b
    y: u64 = x +% x
    if take_it:
        return x +% y
    return y +% x
