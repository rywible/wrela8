module examples.cost_branch_bias


pub enum Tag:
    A
    B
    C
    D
    E
    F
    G
    H

pub fn ladder(t: Tag) -> u64:
    match t:
        case .A:
            return 0
        case .B:
            return 1
        case .C:
            return 2
        case .D:
            return 3
        case .E:
            return 4
        case .F:
            return 5
        case .G:
            return 6
        case .H:
            return 7

pub fn spin(n: u64) -> u64:
    i: u64 = n
    acc: u64 = 0
    @budget(bound=1000000)
    while i > 0:
        acc = acc +% i
        i = i - 1
    return acc

pub fn nested(x: u64, y: u64) -> u64:
    if x < y:
        if x < 10:
            return 1
        elif x < 20:
            return 2
        else:
            return 3
    elif x > y:
        if y < 10:
            return 4
        elif y < 20:
            return 5
        else:
            return 6
    return 7

pub fn checks(a: u64, b: u64) -> u64:
    s0: u64 = a + b
    s1: u64 = s0 + b
    s2: u64 = s1 + b
    s3: u64 = s2 + b
    s4: u64 = s3 + b
    s5: u64 = s4 + b
    s6: u64 = s5 + b
    s7: u64 = s6 + b
    return s7
