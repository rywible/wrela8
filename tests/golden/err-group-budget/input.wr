module examples.err_group_budget

# plans/M13.md item C cut 4: `group(budget=)` was never implemented and is
# cut at the revision boundary. Sema already refuses unknown group args
# (`capacity=` / `deadline=` only); this golden pins the refusal.

@actor
pub struct C:
    n: u64

    pub fn bump(mut self) -> u64:
        self.n = self.n + 1
        return self.n

@test(runtime)
async fn budget_cut(c: Actor[C]):
    with group(budget=ms(5)):
        _ = await c.bump()

@image
pub fn build() -> Image:
    img = Image(name="err-group-budget", target=Target.wrela_machine_v1)
    c = img.actor(C, mailbox=8)
    img.supervise(children=[c], strategy=Restart.OneForOne,
                  intensity=RestartIntensity(max=3, within=seconds(10)))
    return img.seal()
