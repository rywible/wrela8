module examples.err_group_budget


@actor
pub struct C:
    n: u64

    pub fn bump(mut self) -> u64:
        self.n = self.n + 1
        return self.n

@test(runtime)
async fn budget_cut(c: Actor[C]):
    with group(budget=ms(5)):
        _ = await c.bump()

@image
pub fn build() -> Image:
    img = Image(name="err-group-budget", target=Target.wrela_machine_v1)
    c = img.actor(C, mailbox=8)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
