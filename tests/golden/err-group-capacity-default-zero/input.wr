module examples.err_group_capacity_default_zero


@actor
pub struct C:
    n: u64

    pub fn bump(mut self) -> u64:
        self.n = self.n + 1
        return self.n

async fn child(c: Actor[C]) -> u64:
    r = await c.bump()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match r:
        case .Ok(v):
            return v
        case .Err(_):
            return 0

@test(runtime)
async fn omitted_capacity_is_zero(c: Actor[C]):
    with group() as g:
        g.start(child, c=c)
        rs = await g.join_all()

@image
pub fn build() -> Image:
    img = Image(name="err-group-capacity-default-zero", target=Target.wrela_machine_v1)
    c = img.actor(C, mailbox=8)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
