module examples.err_placement_virtio_blk_core


struct VirtioBlock:
    id: u32

@driver
pub struct BlkDriver:
    held: DeviceCap[VirtioBlock]

    init(mut self, take cap: DeviceCap[VirtioBlock]):
        self.held = take cap

@image
pub fn build() -> Image:
    img = Image(name="blk-off-core", target=Target.wrela_machine_v1, cores=2)
    blk_device = img.device[VirtioBlock](transport=0x2000)
    disk = img.driver(BlkDriver, device=blk_device, core=1)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
