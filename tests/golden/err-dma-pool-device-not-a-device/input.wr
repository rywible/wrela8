module examples.err_dma_pool_device_not_a_device


@layout(dma, endian=little)
struct BlkReqStatus:
    status: u8

@actor
pub struct Store:
    seen: u64

    pub fn note(mut self, n: u64) -> unit:
        self.seen = n
        return unit

pool Statuses

@image
pub fn build() -> Image:
    img = Image(name="x", target=Target.wrela_machine_v1)
    store = img.actor(Store, mailbox=4)
    buffers = img.dma_pool[BlkReqStatus](name=Statuses, device=store, count=4)
    return img.seal()
