module examples.check_layout_assert_budget_helper

from core.image_report import ImageReport

@actor
pub struct Store:
    n: u32

    init(mut self):
        self.n = 0

    pub fn get(read self) -> u32:
        return self.n

fn under_budget(size: u64, cap: u64) -> bool:
    return size < cap

@layout_assert
fn budget(report: ImageReport):
    assert under_budget(size=report.code_size, cap=160000), "code budget is 160000 bytes"

@image
pub fn build() -> Image:
    img = Image(name="layout-assert-budget-helper", target=Target.wrela_machine_v1)
    a = img.actor(Store, mailbox=8)
    img.check_layout(budget)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
