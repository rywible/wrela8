module examples.boot_init_args

# plans/M7.md item W's own flagship: boot calls each declared actor's
# `init` **with its declared arguments**.
#
# This case replaces `golden/err-image-init-arg-unmaterialized`, the
# fail-closed guard that stood here while materialization did not exist.
# That guard was itself a real find rather than a formality: before it,
# `eval::image_checks` accepted `depth=7` (it really does name a real
# `init` parameter), `layout::build_boot_init` could only call a
# *zero-argument* `init` so it never called that one, the actor booted
# with `depth == 0`, and every assertion over it read 0 while all three
# tiers reported success. The floor is gone; this is the oracle that it
# stays gone.
#
# Every value below is hand-computed and distinct, across four scalar
# widths plus a bool and two handle spellings, so that a swapped, dropped
# or truncated argument fails a *named* assertion rather than passing by
# coincidence:
#
#   Meter   scale  u8  = 200                    (a swap with `offset`
#           offset u16 = 40000                   reads 40000 here)
#           span   u64 = 1234567890123456789    (truncating to 32 bits
#                                                reads 2965944177)
#           bias   i32 = -3                     (sign extension: a
#                                                zero-extended -3 is not
#                                                -3 in 64 bits)
#   Relay   meter  Actor[Meter]                 (the honest handle
#                                                spelling, messaged for
#                                                real by `relay_span`)
#           window u16 = 4096
#           tag    u8  = 9
#   Gauge   peer   u32 = relay.handle()         (the `u32` handle
#                                                spelling `golden/appliance`
#                                                already wires — and
#                                                `Relay` is actor#1, so
#                                                the materialized value is
#                                                1, which a zero-
#                                                initialized field cannot
#                                                fake)
#           limit  u16 = 30000
#           armed  bool = true
#
# `Meter` is declared first precisely so the handle arguments below it
# name a *nonzero* index: an actor's handle is its own construction-order
# index, so a handle to actor#0 is the one value plain zero-initialization
# would have produced anyway. `Gauge.peer` reads back 1.

@actor
pub struct Meter:
    scale: u8
    offset: u16
    span: u64
    bias: i32

    init(mut self, scale: u8, offset: u16, span: u64, bias: i32):
        self.scale = scale
        self.offset = offset
        self.span = span
        self.bias = bias

    pub fn read_scale(read self) -> u8:
        return self.scale

    pub fn read_offset(read self) -> u16:
        return self.offset

    pub fn read_span(read self) -> u64:
        return self.span

    # `-3` is spelled in this *sync* body rather than in the async test
    # below on purpose: neither a unary negation nor a module const
    # lowers inside an async body yet — a real, unrelated floor that
    # fails closed with `error[unimplemented]`, never a silent zero. The
    # fact pinned is the same either way, and stronger for being read
    # back as a distinct sentinel: a `bias` that was dropped (0), or
    # zero-extended instead of sign-extended (4294967293 in 64 bits), is
    # not -3 and reads 0 here.
    pub fn bias_is_wired(read self) -> u64:
        if self.bias == -3:
            return 4242
        return 0

@actor
pub struct Relay:
    meter: Actor[Meter]
    window: u16
    tag: u8

    init(mut self, meter: Actor[Meter], window: u16, tag: u8):
        self.meter = meter
        self.window = window
        self.tag = tag

    pub fn read_window(read self) -> u16:
        return self.window

    pub fn read_tag(read self) -> u8:
        return self.tag

    # The `Actor[Meter]` init argument, used for what a handle is for.
    pub async fn relay_span(read self) -> u64:
        s = await self.meter.read_span()
        match s:
            case .Ok(v):
                return v
            case .Err(_):
                return 0

@actor
pub struct Gauge:
    peer: u32
    limit: u16
    armed: bool

    init(mut self, peer: u32, limit: u16, armed: bool):
        self.peer = peer
        self.limit = limit
        self.armed = armed

    pub fn read_peer(read self) -> u32:
        return self.peer

    pub fn read_limit(read self) -> u16:
        return self.limit

    pub fn read_armed(read self) -> bool:
        return self.armed

@test(runtime)
async fn scalar_init_args(m: Actor[Meter]):
    a = await m.read_scale()
    match a:
        case .Ok(v):
            assert v == 200, "Meter.scale is the wired 200"
        case .Err(_):
            assert false, "read_scale rejected"
    b = await m.read_offset()
    match b:
        case .Ok(v):
            assert v == 40000, "Meter.offset is the wired 40000"
        case .Err(_):
            assert false, "read_offset rejected"
    c = await m.read_span()
    match c:
        case .Ok(v):
            assert v == 1234567890123456789, "Meter.span is the wired 1234567890123456789"
        case .Err(_):
            assert false, "read_span rejected"
    d = await m.bias_is_wired()
    match d:
        case .Ok(v):
            assert v == 4242, "Meter.bias is the wired -3, sign-extended"
        case .Err(_):
            assert false, "bias_is_wired rejected"

@test(runtime)
async fn handle_init_args(r: Actor[Relay], g: Actor[Gauge]):
    w = await r.read_window()
    match w:
        case .Ok(v):
            assert v == 4096, "Relay.window is the wired 4096"
        case .Err(_):
            assert false, "read_window rejected"
    t = await r.read_tag()
    match t:
        case .Ok(v):
            assert v == 9, "Relay.tag is the wired 9"
        case .Err(_):
            assert false, "read_tag rejected"
    s = await r.relay_span()
    match s:
        case .Ok(v):
            assert v == 1234567890123456789, "Relay reaches Meter through its wired Actor[Meter]"
        case .Err(_):
            assert false, "relay_span rejected"
    p = await g.read_peer()
    match p:
        case .Ok(v):
            assert v == 1, "Gauge.peer is relay.handle(), actor#1 — not the zero a stale boot left"
        case .Err(_):
            assert false, "read_peer rejected"
    l = await g.read_limit()
    match l:
        case .Ok(v):
            assert v == 30000, "Gauge.limit is the wired 30000"
        case .Err(_):
            assert false, "read_limit rejected"
    k = await g.read_armed()
    match k:
        case .Ok(v):
            assert v, "Gauge.armed is the wired true"
        case .Err(_):
            assert false, "read_armed rejected"

@image
pub fn build() -> Image:
    img = Image(name="boot-init-args", target=Target.wrela_machine_v1)
    meter = img.actor(Meter, mailbox=4, scale=200, offset=40000,
                      span=1234567890123456789, bias=-3)
    relay = img.actor(Relay, mailbox=4, meter=meter, window=4096, tag=9)
    gauge = img.actor(Gauge, mailbox=4, peer=relay.handle(), limit=30000, armed=true)
    img.supervise(children=[meter, relay, gauge], strategy=Restart.OneForOne,
                  intensity=RestartIntensity(max=3, within=seconds(10)))
    return img.seal()
