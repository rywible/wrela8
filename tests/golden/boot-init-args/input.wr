module examples.boot_init_args


@actor
pub struct Meter:
    scale: u8
    offset: u16
    span: u64
    bias: i32

    init(mut self, scale: u8, offset: u16, span: u64, bias: i32):
        self.scale = scale
        self.offset = offset
        self.span = span
        self.bias = bias

    pub fn read_scale(read self) -> u8:
        return self.scale

    pub fn read_offset(read self) -> u16:
        return self.offset

    pub fn read_span(read self) -> u64:
        return self.span

    pub fn bias_is_wired(read self) -> u64:
        if self.bias == -3:
            return 4242
        return 0

@actor
pub struct Relay:
    meter: Actor[Meter]
    window: u16
    tag: u8

    init(mut self, meter: Actor[Meter], window: u16, tag: u8):
        self.meter = meter
        self.window = window
        self.tag = tag

    pub fn read_window(read self) -> u16:
        return self.window

    pub fn read_tag(read self) -> u8:
        return self.tag

    pub async fn relay_span(read self) -> u64:
        s = await self.meter.read_span()
        @discard(reason="migrated: deliberate Err discard (M13 item L)")
        match s:
            case .Ok(v):
                return v
            case .Err(_):
                return 0

@actor
pub struct Gauge:
    peer: u32
    limit: u16
    armed: bool

    init(mut self, peer: u32, limit: u16, armed: bool):
        self.peer = peer
        self.limit = limit
        self.armed = armed

    pub fn read_peer(read self) -> u32:
        return self.peer

    pub fn read_limit(read self) -> u16:
        return self.limit

    pub fn read_armed(read self) -> bool:
        return self.armed

@test(runtime)
async fn scalar_init_args(m: Actor[Meter]):
    a = await m.read_scale()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match a:
        case .Ok(v):
            assert v == 200, "Meter.scale is the wired 200"
        case .Err(_):
            assert false, "read_scale rejected"
    b = await m.read_offset()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match b:
        case .Ok(v):
            assert v == 40000, "Meter.offset is the wired 40000"
        case .Err(_):
            assert false, "read_offset rejected"
    c = await m.read_span()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match c:
        case .Ok(v):
            assert v == 1234567890123456789, "Meter.span is the wired 1234567890123456789"
        case .Err(_):
            assert false, "read_span rejected"
    d = await m.bias_is_wired()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match d:
        case .Ok(v):
            assert v == 4242, "Meter.bias is the wired -3, sign-extended"
        case .Err(_):
            assert false, "bias_is_wired rejected"

@test(runtime)
async fn handle_init_args(r: Actor[Relay], g: Actor[Gauge]):
    w = await r.read_window()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match w:
        case .Ok(v):
            assert v == 4096, "Relay.window is the wired 4096"
        case .Err(_):
            assert false, "read_window rejected"
    t = await r.read_tag()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match t:
        case .Ok(v):
            assert v == 9, "Relay.tag is the wired 9"
        case .Err(_):
            assert false, "read_tag rejected"
    s = await r.relay_span()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match s:
        case .Ok(v):
            assert v == 1234567890123456789, "Relay reaches Meter through its wired Actor[Meter]"
        case .Err(_):
            assert false, "relay_span rejected"
    p = await g.read_peer()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match p:
        case .Ok(v):
            assert v == 1, "Gauge.peer is relay.handle(), actor#1 — not the zero a stale boot left"
        case .Err(_):
            assert false, "read_peer rejected"
    l = await g.read_limit()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match l:
        case .Ok(v):
            assert v == 30000, "Gauge.limit is the wired 30000"
        case .Err(_):
            assert false, "read_limit rejected"
    k = await g.read_armed()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match k:
        case .Ok(v):
            assert v, "Gauge.armed is the wired true"
        case .Err(_):
            assert false, "read_armed rejected"

@image
pub fn build() -> Image:
    img = Image(name="boot-init-args", target=Target.wrela_machine_v1)
    meter = img.actor(Meter, mailbox=4, scale=200, offset=40000,
                      span=1234567890123456789, bias=-3)
    relay = img.actor(Relay, mailbox=4, meter=meter, window=4096, tag=9)
    gauge = img.actor(Gauge, mailbox=4, peer=relay.handle(), limit=30000, armed=true)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
