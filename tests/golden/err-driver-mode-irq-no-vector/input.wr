module examples.err_driver_mode_irq_no_vector

# plans/M7.md item G, decision 18: Irq without vector= is a sealed-graph
# contradiction (03-hardware.md §7: an IRQ build needs a vector to bind).

@layout(mmio, endian=little)
struct VirtioIrqMmio:
    @offset(0x060) interrupt_status: ReadOnly[u32]

struct VirtioBlock:
    id: u32

@driver
pub struct BlkDriver[const MODE: DriverMode]:
    regs: Mmio[VirtioIrqMmio]
    pending: InterruptCell[u32]
    irq: IrqCap[u32]

    init(mut self, take cap: DeviceCap[VirtioBlock]):
        claimed = VirtioBlock.claim(cap=take cap)
        self.regs = claimed.map_partition(VirtioIrqMmio)
        self.pending = InterruptCell(0)
        comptime if MODE == DriverMode.Irq:
            irq = claimed.take_irq()
            irq.bind(self.on_queue_irq)
            irq.unmask()
            self.irq = take irq

    comptime if MODE == DriverMode.Irq:
        fn on_queue_irq(self):
            pass

    @task
    fn drain(mut self):
        pass

@image
pub fn build() -> Image:
    img = Image(name="err-driver-mode-irq-no-vector", target=Target.wrela_machine_v1)
    blk = img.device[VirtioBlock](transport=0x2000)
    disk = img.driver(BlkDriver[DriverMode.Irq], device=blk)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
