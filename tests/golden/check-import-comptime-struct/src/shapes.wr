module shapes

# plans/M9.md item A1b's fixture: an ordinary data struct declared in a
# module the `@image` module only *imports*. Nothing here is special —
# the point is entirely on the other side of the import.
pub struct Pair:
    a: u32
    b: u32

    pub fn sum(read self) -> u32:
        return self.a + self.b
