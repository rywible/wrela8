module image

from shapes import Pair

fn mk() -> u32:
    p = Pair(a=6, b=10)
    return p.sum()

const MAILBOX: u32 = mk()

@actor
pub struct Store:
    count: u32

    init(mut self):
        self.count = 0

@image
pub fn build() -> Image:
    img = Image(name="import-comptime-struct", target=Target.wrela_machine_v1)
    storage = img.actor(Store, mailbox=MAILBOX)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
