module examples.check_pixels_field_dynamic_index

from core.field import Field, Rgb, Vec3, mark, sphere
from core.render import (
    AoConfig, CameraBounds, LightConfig, MaterialSample, ProbeConfig,
    RenderProfile, RgbRange, ScalarRange, SurfaceContext, ToneCurve,
)
from drivers.display import Display, DisplayDevice

struct Value:
    @range(min=0.25, max=2.0)
    radius: f32

struct Center:
    @range(min=-1.0, max=1.0)
    position: Vec3

struct Params:
    values: [Value; 2]
    centers: [Center; 2]
    @range(min=0.0, max=1.0)
    tint: Rgb
    @range(min=0, max=1)
    index: usize

enum ObjectId:
    Scene

enum MaterialId:
    Surface

@field
fn world(p: Vec3, read params: Params) -> Field:
    radius = params.values[params.index].radius
    center = params.centers[params.index].position
    return mark(
        sphere(p, center, radius=radius),
        object=ObjectId.Scene,
        material=MaterialId.Surface,
    )

@material
fn shade(surface: SurfaceContext[MaterialId], read params: Params) -> MaterialSample:
    return MaterialSample.standard(color=params.tint, roughness=0.5)

@image
fn build() -> Image:
    img = Image(name="check-pixels-field-dynamic-index", target=Target.wrela_machine_v1)
    device = img.device[DisplayDevice](transport=0x6000)
    display = img.driver(Display, device=device, width=64, height=32, refresh_hz=60)
    renderer = img.renderer[Params](
        field=world, material=shade, display=display,
        width=64, height=32, refresh_hz=60, shade_hz=60,
        profile=RenderProfile.AaaByteExact, tone_curve=ToneCurve.Linear,
        near=0.1, far=10.0,
        world_min=Vec3(x=-1.0, y=-1.0, z=-1.0),
        world_max=Vec3(x=1.0, y=1.0, z=1.0),
        camera_bounds=CameraBounds.bounded(max_motion=0.0),
        light_config=LightConfig.fixed(capacity=0),
        exposure_range=ScalarRange(min=0.0, max=1.0),
        environment_range=RgbRange(
            min=Rgb(r=0.0, g=0.0, b=0.0),
            max=Rgb(r=1.0, g=1.0, b=1.0),
        ),
        ao=AoConfig.fixed(enabled=false),
        probes=ProbeConfig.fixed(enabled=false),
        initialization_deadline_ms=1,
    )
    img.on_failure(policy=Failure.Halt)
    return img.seal()
