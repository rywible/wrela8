module examples.err_image_cores_unknown_label

# plans/M15.md item B / image.cores.authoring: unknown Image(...) labels
# are a build/comptime error (close the silent-drop hole).

@image
pub fn build() -> Image:
    img = Image(name="cores-unknown", target=Target.wrela_machine_v1, foo=1)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
