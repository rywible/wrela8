module examples.boot_driver_message



@layout(mmio, endian=little)
struct VirtioIrqMmio:
    @offset(0x060) interrupt_status: ReadOnly[u32]
    @offset(0x064) interrupt_ack: WriteOnly[u32]

@layout(dma, endian=little)
struct BlkReqHeader:
    kind: u32
    reserved: u32
    sector: u64

struct VirtioBlock:
    id: u32

enum Feature:
    Flush

const QDEPTH: usize = 8
const SECTOR: u64 = 512

pool BlockControl

@driver
pub struct BlkDriver:
    irq_regs: Mmio[VirtioIrqMmio]
    device: RunningDevice[VirtioBlock]
    queue: VirtQueue[..8]
    capacity_sectors: u64
    pending: InterruptCell[u32]
    irq: IrqCap[u32]
    drains: u64
    bringup_done: u64
    scale: Actor[Scale]

    init(mut self,
         take cap: DeviceCap[VirtioBlock],
         take control_pool: DmaPool[BlockControl, 512],
         scale: Actor[Scale])
        -> Result[unit, BootError]:
        self.scale = scale
        claimed = VirtioBlock.claim(cap=take cap)
        self.irq_regs = claimed.map_partition(VirtioIrqMmio)
        self.pending = InterruptCell(0)
        self.drains = 0
        self.bringup_done = 0
        negotiated = claimed.negotiate(
            required=[Feature.Flush],
            optional=[Feature.Flush],
        )?
        self.queue = VirtQueue.configure(
            pool=take control_pool,
            device=mut negotiated,
            index=0,
            depth=QDEPTH,
        )?
        self.capacity_sectors = negotiated.read_capacity_sectors()?
        irq = negotiated.take_irq()
        irq.bind(self.on_queue_irq)
        irq.unmask()
        self.irq = take irq
        self.device = negotiated.start()
        self.bringup_done = 1
        return Ok(unit)

    fn on_queue_irq(self):
        status = self.irq_regs.interrupt_status.read()
        handled = status & 1
        if handled != 0:
            self.pending.fetch_or_release(handled)
            self.irq_regs.interrupt_ack.write(handled)
            wake(BlkDriver.drain)

    @task
    fn drain(mut self):
        status = self.pending.swap_acquire(0)
        if status == 0:
            return unit
        self.drains = self.drains + 1
        return unit

    pub fn capacity(read self) -> u64:
        return self.capacity_sectors

    pub fn sector_bytes(read self, count: u64) -> u64:
        return count * SECTOR

    pub fn ready(read self) -> u64:
        return self.bringup_done

    pub async fn scaled_capacity(read self) -> u64:
        v = await self.scale.times(n=self.capacity_sectors)
        @discard(reason="migrated: deliberate Err discard (M13 item L)")
        match v:
            case .Ok(n):
                return n
            case .Err(_):
                return 0

@actor
pub struct Scale:
    factor: u64

    init(mut self, factor: u64):
        self.factor = factor

    pub fn times(read self, n: u64) -> u64:
        return n * self.factor

@actor
pub struct Storage:
    disk: Actor[BlkDriver]

    init(mut self, disk: Actor[BlkDriver]):
        self.disk = disk

    pub async fn blocks(read self) -> u64:
        c = await self.disk.capacity()
        @discard(reason="migrated: deliberate Err discard (M13 item L)")
        match c:
            case .Ok(n):
                return n
            case .Err(_):
                return 0

@test(runtime)
async fn actor_relays_a_driver_reply(st: Actor[Storage]):
    v = await st.blocks()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match v:
        case .Ok(n):
            assert n == 16, "the driver's own capacity, relayed through an actor turn"
        case .Err(_):
            assert false, "relay rejected"

@test(runtime)
async fn root_messages_the_driver_directly(disk: Actor[BlkDriver]):
    v = await disk.sector_bytes(count=3)
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match v:
        case .Ok(n):
            assert n == 1536, "3 * 512 computed inside a driver turn"
        case .Err(_):
            assert false, "driver call rejected"

@test(runtime)
async fn a_driver_turn_parks_and_resumes(disk: Actor[BlkDriver]):
    v = await disk.scaled_capacity()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match v:
        case .Ok(n):
            assert n == 160, "16 sectors * factor 10, computed across a parked driver turn"
        case .Err(_):
            assert false, "driver call rejected"

@test(runtime)
async fn root_never_reenters_bring_up(disk: Actor[BlkDriver]):
    v = await disk.ready()
    @discard(reason="migrated: deliberate Err discard (M13 item L)")
    match v:
        case .Ok(n):
            assert n == 1, "no turn is admitted before the driver finished bring-up"
        case .Err(_):
            assert false, "driver call rejected"

@image
pub fn build() -> Image:
    img = Image(name="boot-driver-message", target=Target.wrela_machine_v1)
    blk = img.device[VirtioBlock](
        transport=0x2000,
        capacity_sectors=16,
        required_features=[Feature.Flush],
        vector=1,
    )
    control = img.dma_pool[BlkReqHeader](name=BlockControl, device=blk, count=32)
    scale = img.actor(Scale, mailbox=4, factor=10)
    disk = img.driver(BlkDriver, device=blk, mailbox=4, scale=scale)
    st = img.actor(Storage, mailbox=4, disk=disk)
    img.on_failure(policy=Failure.Halt)
    return img.seal()
